# The app's own process in tests/cellwire.py: the same fixture, drawn into a
# console with no terminal, whose views go to the desktop as cell records.

need console || exit 1
. "$CW_DIR/cellwire.fix.hibr"
[ "$CW_CASE" = place ] && { need img || exit 1; }
connect -U "$CW_SOCK" FD || exit 1
console cells open "$FD" || exit 1
console cells view w1 1 "$CW_H" "$CW_W" || exit 1
case $CW_CASE in close | place) console cells view w3 1 3 20 || exit 1 ;; esac
H=$CW_H W=$CW_W
while read -r -u "$FD" l; do
	case $l in
	go\ *)
		i=${l#go }
		console cells clear w1
		cw_frame "$i" "$H" "$W"
		if [ "$CW_CASE" = close ] || [ "$CW_CASE" = place ]; then
			console cells clear w3
			console pen "$DT_INK" "$DT_FACE"
			console put -p w3 1 1 "frame $i"
		fi
		[ "$CW_CASE" = place ] &&
			img draw "$CW_OUT.pic.ppm" 0 12 2 6 -m half -p w3
		console flush > /dev/null
		;;
	size\ *)
		read -r _ g H W <<< "$l"
		console cells view w1 "$g" "$H" "$W"
		;;
	raw\ *) command cat "${l#raw }" >&"$FD" ;;
	ping) printf 'pong\n' >&"$FD" ;;
	die)
		printf 'w w1 1\nr 0 0 2cbd5e0 2101820 0 0 0 3 ab' >&"$FD"
		kill -9 $$
		;;
	quit) exit 0 ;;
	esac
done
