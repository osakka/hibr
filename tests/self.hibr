#!/usr/bin/env hibr
# The suite hibr runs against itself. Written in hibr on purpose: if the
# language cannot express its own test harness it is not finished.

pass=0
fail=0
failed=()
planned=0

# How many assertions this file intends to make. A suite that silently runs
# fewer has skipped something -- an `is` inside a branch that stopped being
# taken, or a section that failed early -- and a count nobody checks cannot
# tell you that.
fn plan(int n) {
  planned=$n
}

fn ok(str what) {
  pass=$((pass + 1))
  [ -n "$VERBOSE" ] && echo "  ok   $what"
  ret 0
}

fn bad(str what, str got, str want) {
  fail=$((fail + 1))
  arr push failed "$what"
  echo "  FAIL $what"
  echo "       got  [$got]"
  echo "       want [$want]"
  ret 1
}

fn is(str got, str want, str what) {
  if [ "$got" = "$want" ]; then ok "$what"; else bad "$what" "$got" "$want"; fi
}

fn isnt(str got, str nope, str what) {
  if [ "$got" = "$nope" ]; then bad "$what" "$got" "not $nope"; else ok "$what"; fi
}

fn status_is(int got, int want, str what) {
  is "$got" "$want" "$what"
}

fn section(str name) { echo "== $name"; }

plan 91

section "expansion"
x=hello
is "$x" "hello" "scalar"
is "${x:-def}" "hello" "default not taken"
is "${nope:-def}" "def" "default taken"
is "${#x}" "5" "length"
is "${x#he}" "llo" "prefix strip"
is "${x%lo}" "hel" "suffix strip"
is "${x/l/L}" "heLlo" "replace first"
is "${x//l/L}" "heLLo" "replace all"
is "$((3 + 4 * 2))" "11" "arithmetic precedence"
is "$(( (3 + 4) * 2 ))" "14" "arithmetic parens"
is "$(echo nested $(echo deep))" "nested deep" "nested substitution"
vok=no
match "$HIBR_VERSION" "^[0-9]+\.[0-9]+" && vok=yes
is "$vok" "yes" "HIBR_VERSION names a version"
aok=no
match "$HIBR_ABI" "^[0-9]+$" && aok=yes
is "$aok" "yes" "HIBR_ABI names an ABI"

section "maps and arrays"
a=(one two three)
is "${a[1]}" "two" "array index"
is "${#a[@]}" "3" "array count"
a[7]=eight
is "${#a[@]}" "4" "sparse count"
is "${!a[*]}" "0 1 2 7" "sparse keys"
h[x][y][z]=deep
is "${h[x][y][z]}" "deep" "nested autovivify"
is "${!h[x][*]}" "y" "nested keys"
cfg=([host]=srv [port]=80)
is "${cfg[host]}:${cfg[port]}" "srv:80" "map literal"
hd["content-type"]=app/json
is "${!hd[*]}" "content-type" "quoted subscript is literal"
is "${hd["content-type"]}" "app/json" "quoted subscript reads back"
ct=content-type
hv["$ct"]=json
is "${!hv[*]}" "content-type" "expanded quoted subscript"
unset hv["$ct"]
is "${!hv[*]}" "" "unset honours a quoted subscript"
ar=(p q r)
is "${ar[1+1]}" "r" "unquoted subscript stays arithmetic"

section "functions"
fn add(int p, int q) -> int { ret $((p + q)); }
add 2 3
is "$RET" "5" "result slot"
sum := add 40 2
is "$sum" "42" "bind with :="
fn withdef(str who, str greet = "hi") { ret "$greet $who"; }
r := withdef omar
is "$r" "hi omar" "default parameter"
r := withdef omar salaam
is "$r" "salaam omar" "explicit overrides default"
fn rest(str first, ...more) { ret "${#more[@]}"; }
n := rest a b c d
is "$n" "3" "rest parameter"
try add 1 notanumber
status_is "$ERRSTATUS" "2" "type check rejects"
try add 1
status_is "$ERRSTATUS" "2" "missing argument rejected"

section "errors"
fn boom() { fail "exploded"; ret never; }
try boom
is "$ERRMSG" "exploded" "fail message"
status_is "$ERR" "1" "try reports failure"
try true
status_is "$ERR" "0" "try reports success"

section "text"
str upper "abc" u; is "$u" "ABC" "upper"
str trim "  x  " t; is "$t" "x" "trim"
str slice "abcdefgh" 2 3 sl; is "$sl" "cde" "slice"
str replace "a.b.c" "." "-" rp; is "$rp" "a-b-c" "replace"
str split "1,2,3" "," parts; is "${#parts[@]}" "3" "split count"
str join parts "+" j; is "$j" "1+2+3" "join"
str index "hello" "ll" ix; is "$ix" "2" "index"
str index "hello" "zz" ix; is "$ix" "-1" "index miss"
str starts "prefix-x" "prefix"; status_is "$?" "0" "starts"
str ends "x.tar.gz" ".gz"; status_is "$?" "0" "ends"

section "arrays"
nums=(5 3 9 3 1)
arr sort nums -n; is "${nums[*]}" "1 3 3 5 9" "numeric sort"
arr uniq nums; is "${nums[*]}" "1 3 5 9" "uniq"
arr reverse nums; is "${nums[*]}" "9 5 3 1" "reverse"
arr push nums 11; is "${nums[4]}" "11" "push"
arr pop nums top; is "$top" "11" "pop returns"
fn triple(int v) -> int { ret $((v * 3)); }
arr map nums triple; is "${nums[*]}" "27 15 9 3" "map"
fn over10(int v) { [ "$v" -gt 10 ]; }
arr filter nums over10; is "${nums[*]}" "27 15" "filter"

section "regex"
match "2026-09-20" "([0-9]{4})-([0-9]{2})-([0-9]{2})" D
is "${D[1]}" "2026" "capture one"
is "${D[3]}" "20" "capture three"
match "nope" "[0-9]+"
status_is "$?" "1" "no match reports failure"
match -a "a1 b22 c3" "[0-9]+" all
is "${#all[@]}" "3" "match all"
rsub -g "x.y.z" "\." "/" out
is "$out" "x/y/z" "global substitution"
rsub "john smith" "([a-z]+) ([a-z]+)" "\2 \1" sw
is "$sw" "smith john" "backreferences"

section "json"
json parse d '{"a":1,"b":[10,20],"c":{"d":true},"e":null,"f":"str"}'
is "$(json get d .a)" "1" "number"
is "$(json get d .b[1])" "20" "array index"
is "$(json get d .c.d)" "true" "nested bool"
is "$(json type d .e)" "null" "null type"
is "$(json type d .f)" "string" "string type"
is "${d[b][0]}" "10" "subscript reaches json"
json set d .a 99
is "$(json get d .a)" "99" "set"
is "$(json emit d)" '{"a":99,"b":[10,20],"c":{"d":true},"e":null,"f":"str"}' "round trip"
json parse rt "$(json emit d)"
is "$(json get rt .c.d)" "true" "reparse of our own output"

section "control flow"
out=""
for i in 1 2 3; do out="$out$i"; done
is "$out" "123" "for loop"
i=0; out=""
while [ $i -lt 3 ]; do out="$out$i"; i=$((i + 1)); done
is "$out" "012" "while loop"
out=""
for i in 1 2 3 4 5; do
  [ $i -eq 2 ] && continue
  [ $i -eq 4 ] && break
  out="$out$i"
done
is "$out" "13" "break and continue"
case "hello" in h*) cr=prefix ;; *) cr=other ;; esac
is "$cr" "prefix" "case glob"
case "5" in [0-9]) cr=digit ;; *) cr=other ;; esac
is "$cr" "digit" "case class"

section "arithmetic and conditionals"
n=5
((n++)); is "$n" "6" "((n++)) statement"
is "$((n > 3 ? 1 : 0))" "1" "ternary"
is "$((2**10))" "1024" "power"
out=""; for ((q=0; q<3; q++)); do out="$out$q"; done
is "$out" "012" "for (( ))"
acc=ab; acc+=cd; is "$acc" "abcd" "string +="
lst=(1); lst+=(2 3); is "${#lst[@]}" "3" "array +="
[[ $acc == ab* && -n $acc ]]; status_is "$?" "0" "[[ ]] with && and a glob"
[[ "k=v" =~ ^([a-z])=(.*)$ ]]; is "${M[2]}" "v" "[[ =~ ]] fills M"
let "w = 6 * 7"; is "$w" "42" "let"

section "limits"
deep=""
i=0
while [ $i -lt 40 ]; do deep="$deep[k$i]"; i=$((i + 1)); done
eval "big$deep=bottom"
eval "probe=\${big$deep}"
is "$probe" "bottom" "40 levels of nesting"

big=()
i=0
while [ $i -lt 2000 ]; do big[$i]=$i; i=$((i + 1)); done
is "${#big[@]}" "2000" "2000 element array"
arr sort big -n
is "${big[0]}" "0" "sorting 2000 elements"

str repeat "x" 20000 long
str len "$long" ll
is "$ll" "20000" "20k character string"
str replace "$long" "x" "y" long2
str len "$long2" ll2
is "$ll2" "20000" "replace across 20k"

fn descend(int n) -> int {
  if [ "$n" -le 0 ]; then ret 0; fi
  sub := descend $((n - 1))
  ret $((sub + 1))
}
d200 := descend 200
is "$d200" "200" "200 deep recursion"

jbig='{"list":['
i=0
while [ $i -lt 300 ]; do
  [ $i -gt 0 ] && jbig="$jbig,"
  jbig="$jbig{\"i\":$i}"
  i=$((i + 1))
done
jbig="$jbig]}"
json parse jb "$jbig"
is "$(json len jb .list)" "300" "300 element json document"
is "$(json get jb .list[299].i)" "299" "last element of big document"

cat > /tmp/hibr-self-here.txt <<'HEREDOC_END'
first
second
HEREDOC_END
is "$(cat /tmp/hibr-self-here.txt | wc -l)" "2" "heredoc"
rm -f /tmp/hibr-self-here.txt

hd=""
i=0
while [ $i -lt 5000 ]; do hd="$hd line $i"; i=$((i + 1)); done
str len "$hd" hdl
isnt "$hdl" "0" "40k of generated text"

echo ""
echo "$pass passed, $fail failed"
run=$((pass + fail))
if [ "$planned" -gt 0 ] && [ "$run" -ne "$planned" ]; then
  echo "planned $planned assertions, ran $run"
  exit 1
fi
if [ "$fail" -gt 0 ]; then
  echo "failed: ${failed[@]}"
  exit 1
fi
exit 0
