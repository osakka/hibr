// Written by hibr-access for Control Panel > Administrative Access.
// Changed only through it: each change writes this file whole.
polkit.addRule(function(action, subject) {
	if (action.id == "org.test.one")
		return polkit.Result.AUTH_SELF_KEEP;
	if (action.id == "org.test.two" && subject.isInGroup("GROUP"))
		return polkit.Result.YES;
	return polkit.Result.NOT_HANDLED;
});
