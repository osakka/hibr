# Maintainer: osakka <osakka@gmail.com>
#
# Built with gcc, not hibr's default tcc: base-devel has gcc and not tcc,
# and gcc's -O2 build is both smaller and faster. libssl and libpng are
# opened on first use, never linked, so they are optional.

pkgname=hibr
pkgver=0.99.122
pkgrel=1
pkgdesc="Small, fast bash-flavoured shell with nested maps, JSON, and native networking"
arch=('x86_64' 'aarch64')
url="https://github.com/osakka/hibr"
license=('MIT')
depends=('glibc')
optdepends=('openssl: TLS -- /dev/tls and https'
            'libpng: PNG pictures in the img module and desktop wallpapers'
            'libjpeg-turbo: JPEG pictures in the img module and desktop wallpapers')
install=hibr.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/osakka/hibr/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c8f0f220cc55a96cc2839f1bc571e83b94bd062de4e9f8af10c2b68c9205704b')

build() {
	cd "$pkgname-$pkgver"
	make CC=gcc OPT=-O2 PREFIX=/usr
}

check() {
	cd "$pkgname-$pkgver"
	./build/hibr tests/self.hibr
}

package() {
	cd "$pkgname-$pkgver"
	make CC=gcc OPT=-O2 PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
