#!/usr/bin/env hibr
#
# catalogue -- hibr's catalogue of applications, themes, languages and
# modules, wherever it was installed. Called `apps` until 0.99.195: the
# window has been Catalogue since 0.99.192 and one thing with two names
# is the parallel this release exists to remove.
# @SHAREDIR@ is filled in at install time (see the Makefile's own install
# target); this file is a template, not run directly.

# Where hibr's own copy of the catalogue's signing key was installed. The
# manager pins the fingerprint and this only says where to look, so a
# wrong path means "cannot verify" rather than "verified by the wrong
# key" -- see ADR 0044.
HIBR_APPS_KEYRING=${HIBR_APPS_KEYRING:-@SHAREDIR@/keyring.gpg}
export HIBR_APPS_KEYRING

exec hibr "@SHAREDIR@/catalogue.hibr" "$@"
