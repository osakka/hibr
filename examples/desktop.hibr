#!/usr/bin/env hibr
#
# desktop -- a window manager, written in hibr.
#
# This is the middle of the three layers in docs/adr/0020: the console module
# is the display server, this is the window manager, and the file you write
# yourself is the session.  Source this, call dt_open, make some windows and
# call dt_run:
#
#     . desktop.hibr
#     dt_open
#     dt_new "A window" 10 40 4 8
#     dt_run
#
# Nothing here is C.  Everything below draws with `console put` and reads
# `console key`, and it redraws every window from the bottom of the stack
# upwards every frame, because the console only sends the cells that changed.

need display || { echo "desktop: no display available" >&2; exit 1; }

DT_NEXT=1
DT_FOCUS=
DT_DRAG=
DT_DR=0
DT_DC=0
DT_QUIT=0
DT_SIZE=
DT_GRAB=
DT_MOUSE=
DT_CLIP=
DT_NOTE=
DT_ROWS=24
DT_COLS=80
declare -A DT

DT_WALL="${DT_WALL-#0d1b2a}"
DT_DOT="${DT_DOT-#16324a}"
DT_BAR="${DT_BAR-#1b3a5c}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_IDLE="${DT_IDLE-#4a5568}"
DT_FACE="${DT_FACE-#101820}"
DT_INK="${DT_INK-#cbd5e0}"
DT_GLYPH="${DT_GLYPH-·}"

# Settings are a script of the user's own, written by the desktop whenever
# one changes and read back at the next start: plain assignments, so it can
# be edited by hand and needs no format of its own.  An app that wants a
# variable of its own kept names it with dt_keep.
DT_CONF="${DT_CONF-${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desktop.hibr}"
DT_KEEP=(DT_WALL DT_DOT DT_BAR DT_ACTIVE DT_IDLE DT_FACE DT_INK DT_GLYPH
	DT_TICK)

# Where the desktop's stderr goes while it holds the screen, so an app's
# error message cannot scribble over the display, and the reason for a
# failure is still there to read after it.
DT_LOG="${DT_LOG-${XDG_STATE_HOME:-$HOME/.local/state}/hibr/desktop.log}"
DT_ERR=

# Keep these variables in the settings file too.
dt_keep() {
	DT_KEEP+=("$@")
}

# Read the settings file, if there is one.  It runs after the session file
# has set its defaults, so what was chosen last time wins.
dt_load() {
	[ -r "$DT_CONF" ] && . "$DT_CONF"
	return 0
}

# Write every kept variable back, through a temporary file and a rename,
# so a crash halfway through never leaves half a settings file.
dt_save() {
	local v tmp=$DT_CONF.$$

	mkdir -p "${DT_CONF%/*}" 2> /dev/null || return 1
	{
		echo "# The desktop's settings, written whenever one changes and"
		echo "# read at the next start.  A script like any other."
		for v in "${DT_KEEP[@]}"; do
			[ -n "${!v+set}" ] && printf '%s=%q\n' "$v" "${!v}"
		done
	} > "$tmp" && mv -f "$tmp" "$DT_CONF"
}

# Open the display, take the mouse, and note how big the screen is.
#
# ctrl-c, ctrl-\ and ctrl-z become keys rather than signals: the desktop is
# left by Quit, never by a stray interrupt, and the key goes to the focused
# window -- which is how a program in a terminal window gets its ctrl-c.
dt_open() {
	dt_load
	console open || return 1
	console signals off
	console mouse drag
	console cursor 0 0 0
	if mkdir -p "${DT_LOG%/*}" 2> /dev/null; then
		exec {DT_ERR}>&2 2>> "$DT_LOG"
	fi
	dt_size
}

# Re-read the screen size after a resize.
dt_size() {
	local sz
	sz := console size
	DT_ROWS=${sz% *}
	DT_COLS=${sz#* }
}

# Give the terminal back.
dt_close() {
	if [ -n "$DT_ERR" ]; then
		exec 2>&$DT_ERR {DT_ERR}>&-
		DT_ERR=
	fi
	console mouse off
	console signals on
	console close
}

# Which of an app's five functions actually exist, asked once.
dt_has() {
	command -v "$1" > /dev/null
}

# Make a window and put it on top.  Its id lands in $RET.
#
# The app argument is a prefix, not a command: an app called clock provides
# any of clock_draw, clock_key, clock_click, clock_open and clock_close, and
# the ones it does not write are never called.  That is the whole reason it
# is a prefix -- an app with no clock_key cannot swallow a key by accident,
# which a single function answering a verb in a case statement does, because
# a case that matches nothing succeeds.
dt_new() {
	local id=$DT_NEXT ap=${6-} f

	DT[$id]["title"]="$1"
	DT[$id]["h"]="$2"
	DT[$id]["w"]="$3"
	DT[$id]["row"]="$4"
	DT[$id]["col"]="$5"
	DT[$id]["app"]="$ap"
	DT[$id]["min"]=0
	for f in draw key click mouse wheel open close copy paste; do
		if [ -n "$ap" ] && dt_has "${ap}_$f"; then
			DT[$id]["$f"]="${ap}_$f"
		else
			DT[$id]["$f"]=
		fi
	done
	DT_NEXT=$((DT_NEXT + 1))
	console pane "w$id" "$4" "$5" "$2" "$3"
	DT_FOCUS=$id
	[ -n "${DT[$id]["open"]}" ] && ${DT[$id]["open"]} "$id" "$7"
	ret "$id"
}

# Close a window and forget it.
dt_del() {
	local id=$1

	[ -n "${DT[$id]["close"]}" ] && ${DT[$id]["close"]} "$id"
	console pane drop "w$id"
	unset "DT[$id]"
	if [ "$DT_FOCUS" = "$id" ]; then
		local l
		l := console pane list
		l=${l##* }
		DT_FOCUS=${l#w}
	fi
}

# Show or hide a window without destroying it.  A minimised window has no
# pane, so nothing draws it and nothing can hit it; its only remaining handle
# is the label dt_wall puts on the bar, which is why that label exists.
dt_min() {
	local id=$1 l

	if [ "${DT[$id]["min"]}" = 1 ]; then
		DT[$id]["min"]=0
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}"
		console pane raise "w$id"
		DT_FOCUS=$id
	else
		DT[$id]["min"]=1
		console pane drop "w$id"
		if [ "$DT_FOCUS" = "$id" ]; then
			l := console pane list
			l=${l##* }
			DT_FOCUS=${l#w}
		fi
	fi
}

# --- what an app may call -------------------------------------------------
#
# An app draws with `console put -p "w$id"` and otherwise minds its own
# business. The few that manage *other* windows -- a control panel, a task
# switcher -- go through these rather than reading DT, which is the window
# manager's own table and not an interface.

# Every window, hidden ones included, in the order they were opened.
#
# Not in stacking order: a list that reshuffles every time something is
# raised is unusable as a list, and raising things is exactly what a window
# list is for. Anything that wants the stack can ask console pane list.
dt_ids() {
	local id out=

	for id in "${!DT[@]}"; do out="$out $id"; done
	ret "${out# }"
}

# What a window is called.
dt_title() {
	ret "${DT[$1]["title"]}"
}

# Is it minimised?
dt_hidden() {
	[ "${DT[$1]["min"]}" = 1 ]
}

# Put a window on top and give it the keyboard.
dt_raise() {
	dt_hidden "$1" && { dt_min "$1"; return 0; }
	console pane raise "w$1"
	DT_FOCUS=$1
}

# --------------------------------------------------------------------------

# Draw inside a window, in its own coordinates, with the frame allowed for.
dt_put() {
	console put -p "w$1" $(($2 + 1)) $(($3 + 1)) "$4"
}

# Repeat a string n times.  One builtin call, not a loop with ${#} in it.
# The result goes through a variable and then ret: := binds for a builtin,
# not for a function, so a bare `str repeat` here would print to the screen.
dt_rep() {
	local o

	str repeat "$2" "$1" o
	ret "$o"
}

# Paint the wallpaper.  The bar is drawn afterwards, over the windows, so a
# drop-down menu covers them.
dt_wall() {
	console pen "$DT_DOT" "$DT_WALL"
	console fill 0 0 "$DT_ROWS" "$DT_COLS" "$DT_GLYPH"
}

# Draw one window: its face, then its app, then its frame over the top.
dt_win() {
	local id=$1
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}

	[ "$DT_FOCUS" = "$id" ] && on=$DT_ACTIVE
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
	console pen "$on" "$DT_FACE"
	local bar edge
	bar := dt_rep $((w - 2)) "─"
	console put -p "w$id" 0 0 "┌$bar┐"
	console put -p "w$id" $((h - 1)) 0 "└$bar┘"
	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" $((h - 1)) $((w - 1)) "◢"
	local r=1
	while [ "$r" -lt $((h - 1)) ]; do
		console put -p "w$id" "$r" 0 "│"
		console put -p "w$id" "$r" $((w - 1)) "│"
		r=$((r + 1))
	done
	local t=${DT[$id]["title"]}
	local room=$((w - 12))
	[ ${#t} -gt "$room" ] && t="${t:0:$room}"
	console pen "$on" "$DT_FACE" bold
	console put -p "w$id" 0 2 "┤ $t ├"
	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" 0 $((w - 8)) "┤_ □ x├"
	console pen "#f56565" "$DT_FACE" bold
	console put -p "w$id" 0 $((w - 3)) "x"
}

# One full frame, bottom of the stack upwards.
dt_draw() {
	local l id

	DT_WANT=
	dt_wall
	l := console pane list
	for id in $l; do dt_win "${id#w}"; done
	dt_menus
	dt_bar
	dt_drop
	dt_note_draw
	console flush
}

# Which title-bar button is at this column, if any.
dt_btn() {
	local w=$1 c=$2
	case $((w - c)) in
	7) ret min ;;
	5) ret max ;;
	3) ret close ;;
	*) ret "" ;;
	esac
}

# Handle one mouse report.
#
# An app is told a click in *pane* coordinates -- the same ones it draws in,
# where row 0 is the top border -- and not in some separate body coordinate
# system. Two systems is one too many: an app that draws at row 4 and is told
# a click at row 3 has to hold both in its head, and the first two apps each
# got the conversion wrong. The window manager handles row 0 itself, so an
# app only ever sees a click at row 1 or below.
#
# A report is `<action> <button> <row> <col>` for a press, a release or a
# drag, and `<action> <row> <col>` for the wheel, which has no button -- so
# the position cannot be read from a fixed argument. The action may carry a
# modifier, `ctrl-press`, which is stripped: a modified click is still a
# click here.
#
# Window fields are read into locals first: a subscript is only literal when
# it is quoted, and arithmetic never sees the quotes, so DT[$id][col] inside
# $(( )) would mean DT[$id][5] here.
dt_mouse() {
	local act=${1##*-} mr mc mods
	local id b wr wc wh ww ap mo

	mods=${1%"$act"}
	mods=${mods%-}
	shift
	case $act in
	wheelup | wheeldown) mr=$1; mc=$2 ;;
	*) mr=$2; mc=$3 ;;
	esac

	case $act in
	press)
		DT_NOTE=
		if [ "$mr" = 0 ]; then
			b := dt_mhit "$mc" || { dt_mclose; return 0; }
			if [ "$b" = "$MB_OPEN" ]; then
				dt_mclose
			else
				dt_mopen "$b"
			fi
			return 0
		fi
		if [ "$MB_OPEN" != -1 ]; then
			if dt_mpick "$mr" "$mc"; then
				dt_mdo
			else
				dt_mclose
			fi
			return 0
		fi
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			DT_FOCUS=
			return 0
		fi
		id=${id#w}
		console pane raise "w$id"
		DT_FOCUS=$id
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		ww=${DT[$id]["w"]}
		wh=${DT[$id]["h"]}
		ap=${DT[$id]["click"]}
		if [ "$mr" = $((wr + wh - 1)) ] &&
		   [ "$mc" = $((wc + ww - 1)) ]; then
			DT_SIZE=$id
			return 0
		fi
		if [ "$mr" -ne "$wr" ]; then
			mo=${DT[$id]["mouse"]}
			if [ -n "$mo" ]; then
				DT_MOUSE=$id
				$mo "$id" press "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
				return 0
			fi
			[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wc)) "$1"
			return 0
		fi
		b := dt_btn "$ww" $((mc - wc))
		case $b in
		close) dt_del "$id" ;;
		min) dt_min "$id" ;;
		max) dt_zoom "$id" ;;
		*)
			DT_DRAG=$id
			DT_DR=$((mr - wr))
			DT_DC=$((mc - wc))
			;;
		esac
		;;
	drag | release)
		# A window that took the press with _mouse is told the rest of it,
		# wherever the pointer goes, until the button comes up.
		if [ -n "$DT_MOUSE" ]; then
			id=$DT_MOUSE
			mo=${DT[$id]["mouse"]}
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			[ "$act" = release ] && DT_MOUSE=
			[ -n "$mo" ] &&
				$mo "$id" "$act" "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
			return 0
		fi
		;;
	esac

	case $act in
	drag)
		if [ -n "$DT_SIZE" ]; then
			id=$DT_SIZE
			dt_resize "$id" $((mr - DT[$id]["row"] + 1)) \
				$((mc - DT[$id]["col"] + 1))
			return 0
		fi
		[ -z "$DT_DRAG" ] && return 0
		dt_move "$DT_DRAG" $((mr - DT_DR)) $((mc - DT_DC))
		;;
	release)
		DT_DRAG=
		DT_SIZE=
		;;
	wheelup | wheeldown)
		id := console hit "$mr" "$mc"
		[ -z "$id" ] && return 0
		id=${id#w}
		ap=${DT[$id]["wheel"]}
		[ -z "$ap" ] && return 0
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		$ap "$id" "${act#wheel}" $((mr - wr)) $((mc - wc))
		;;
	esac
}

# The smallest a window can be and still have a usable title bar: the
# buttons alone take eight columns, and a body with no rows is not a window.
DT_MINW=16
DT_MINH=4

# Put a window at a size, clamped to what is sensible and what fits.
dt_resize() {
	local id=$1 h=$2 w=$3 r c

	[ "$h" -lt "$DT_MINH" ] && h=$DT_MINH
	[ "$w" -lt "$DT_MINW" ] && w=$DT_MINW
	r=${DT[$id]["row"]}
	c=${DT[$id]["col"]}
	[ $((r + h)) -gt "$DT_ROWS" ] && h=$((DT_ROWS - r))
	[ $((c + w)) -gt "$DT_COLS" ] && w=$((DT_COLS - c))
	[ "$h" -lt "$DT_MINH" ] && return 1
	[ "$w" -lt "$DT_MINW" ] && return 1
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	DT[$id]["oh"]=
	console pane "w$id" "$r" "$c" "$h" "$w"
}

# Move a window, clamped to the screen below the menu bar.
dt_move() {
	local id=$1 r=$2 c=$3

	[ "$r" -lt 1 ] && r=1
	[ "$c" -lt 0 ] && c=0
	[ $((r + DT[$id]["h"])) -gt "$DT_ROWS" ] &&
		r=$((DT_ROWS - DT[$id]["h"]))
	[ $((c + DT[$id]["w"])) -gt "$DT_COLS" ] &&
		c=$((DT_COLS - DT[$id]["w"]))
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	console pane "w$id" "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Fill the screen, or go back to where the window was.
dt_zoom() {
	local id=$1

	if [ -n "${DT[$id]["oh"]}" ]; then
		DT[$id]["row"]=${DT[$id]["or"]}
		DT[$id]["col"]=${DT[$id]["oc"]}
		DT[$id]["h"]=${DT[$id]["oh"]}
		DT[$id]["w"]=${DT[$id]["ow"]}
		DT[$id]["oh"]=
	else
		DT[$id]["or"]=${DT[$id]["row"]}
		DT[$id]["oc"]=${DT[$id]["col"]}
		DT[$id]["oh"]=${DT[$id]["h"]}
		DT[$id]["ow"]=${DT[$id]["w"]}
		DT[$id]["row"]=1
		DT[$id]["col"]=0
		DT[$id]["h"]=$((DT_ROWS - 1))
		DT[$id]["w"]=$DT_COLS
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Handle one decoded key or mouse line.
#
# The wheel goes to the window under the pointer rather than to the focused
# one, which is what every other desktop does and what anyone expects when
# they scroll a list they have not clicked on yet.
dt_event() {
	local k="$1"

	case $k in
	"mouse "*)
		set -- $k
		shift
		dt_mouse "$@"
		return 0
		;;
	esac
	if [ -n "$DT_GRAB" ]; then
		dt_gkey "$k" && return 0
		return 0
	fi
	DT_NOTE=
	if [ "$MB_OPEN" != -1 ]; then
		dt_mkey "$k" && return 0
		return 0
	fi
	# Copy and paste belong to the desktop, the same keys in every window,
	# and so does a paste arriving from the terminal the desktop runs on:
	# it goes to the app's _paste when it has one.
	case $k in
	alt-c) dt_edit copy; return 0 ;;
	alt-v) dt_edit paste; return 0 ;;
	"paste "*)
		if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["paste"]}" ]; then
			${DT[$DT_FOCUS]["paste"]} "$DT_FOCUS" "${k#paste }"
			return 0
		fi
		;;
	esac
	# f10 is the one key an app cannot have, because it is the only way
	# back to the menu bar from a window that wants everything else --
	# a terminal running vi wants escape, and must be allowed it.
	if [ "$k" != f10 ] && [ -n "$DT_FOCUS" ] &&
	   [ -n "${DT[$DT_FOCUS]["key"]}" ]; then
		if ${DT[$DT_FOCUS]["key"]} "$DT_FOCUS" "$k"; then
			return 0
		fi
	fi
	case $k in
	f10 | escape)
		dt_mopen 0
		return 0
		;;
	esac
	case $k in
	q) DT_QUIT=1 ;;
	tab) dt_cycle ;;
	esac
}

# Ask for the next frame within ms, from inside an app's _draw.
#
# The request lasts one frame: a game that is paused, hidden or not focused
# simply stops asking, and the desktop goes back to DT_TICK.  An idle desktop
# must not pay for an animation nobody is watching.  A request slower than
# DT_TICK is ignored, so it can never slow the desktop down.
dt_want() {
	[ "$1" -ge "${DT_TICK-200}" ] && return 0
	if [ -z "$DT_WANT" ] || [ "$1" -lt "$DT_WANT" ]; then
		DT_WANT=$1
	fi
}

# The event loop.  Draw, wait, dispatch, repeat.
dt_run() {
	local k
	while [ "$DT_QUIT" = 0 ]; do
		dt_draw
		k := console key "${DT_WANT:-${DT_TICK-200}}"
		if console resized; then
			dt_size
			continue
		fi
		[ -n "$k" ] && dt_event "$k"
	done
}

# --- the menu bar ---------------------------------------------------------
#
# System 7's, as closely as a text console allows: the hibr menu on the left
# where the apple went, then the active application's own menus, then the
# clock and the application menu on the right.  The menus belong to whatever
# has focus, so they change when you click a different window, and when
# nothing has focus they are the desktop's own.
#
# An app declares them by providing <app>_menus, which calls dt_menu, dt_item
# and dt_sep -- the same shape as `opt` declaring a command line, and the
# same prefix contract as _draw and _key: an app with no _menus simply has
# none, and the bar shows the desktop's.
#
# F10 or escape opens the bar; then the arrows move, a letter picks the item
# beside it, enter chooses and escape closes.  Nothing is reserved while the
# bar is shut, which is what keeps ctrl-c free for whatever runs in a window.

declare -A MB
declare -A MI
declare -A DT_APPS
MB_N=0
MB_OPEN=-1
MB_SEL=0
MB_APP=
MB_CUR=
MB_STACK=
MB_PAR=
MB_IN=0

# Start a menu.  Called from an app's <app>_menus.
dt_menu() {
	MB[$MB_N]["title"]="$1"
	MB[$MB_N]["n"]=0
	MB[$MB_N]["w"]=0
	MB[$MB_N]["bar"]=1
	MB_CUR=$MB_N
	MB_N=$((MB_N + 1))
}

# Add an item to the menu being declared: label, key, then the command.
# An empty key means the item has no letter and is reached with the arrows.
dt_item() {
	dt_row "" 0 "$@"
}

# The same, with a tick beside it when the third argument is not 0.
dt_mark() {
	local lb=$1 k=$2 on=$3

	shift 3
	if [ "$on" = 0 ] || [ -z "$on" ]; then
		dt_row " " 0 "$lb" "$k" "$@"
	else
		dt_row "✓" 0 "$lb" "$k" "$@"
	fi
}

# An item that is there but cannot be chosen, which is how a menu says a
# thing exists and is not available now -- quieter than hiding it, and it
# keeps the menu the same shape from one moment to the next.
dt_dim() {
	dt_row "" 1 "$1" "" :
}

# Start a submenu.  Items until dt_end belong to it.
#
# The parent is MB_CUR -- the menu being declared -- and not the last menu
# created, which after one dt_end is the submenu that just closed. Getting
# that wrong hangs the second submenu off the first, and it looks almost
# right until you notice a menu item has gone missing.
dt_sub() {
	local p=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$p]["n"]}
	dt_menu "$1"
	MB[$((MB_N - 1))]["bar"]=0
	MI[$p][$n]["label"]="$1"
	MI[$p][$n]["key"]=""
	MI[$p][$n]["cmd"]=""
	MI[$p][$n]["sep"]=0
	MI[$p][$n]["dim"]=0
	MI[$p][$n]["tick"]=""
	MI[$p][$n]["sub"]=$((MB_N - 1))
	MB[$p]["n"]=$((n + 1))
	dt_wide "$p" $((${#1} + 8))
	MB_STACK="$p $MB_STACK"
}

# Finish a submenu and go back to the menu that owns it.
dt_end() {
	MB_CUR=${MB_STACK%% *}
	MB_STACK=${MB_STACK#* }
}

# Remember the widest label a menu has to fit.
dt_wide() {
	[ "$2" -gt "${MB[$1]["w"]}" ] && MB[$1]["w"]=$2
}

# One row of a menu.  Everything above goes through here.
dt_row() {
	local tick=$1 dim=$2 lb=$3 k=$4 m n

	shift 4
	m=${MB_CUR:-$((MB_N - 1))}
	n=${MB[$m]["n"]}
	MI[$m][$n]["label"]="$lb"
	MI[$m][$n]["key"]="$k"
	MI[$m][$n]["cmd"]="$*"
	MI[$m][$n]["sep"]=0
	MI[$m][$n]["dim"]="$dim"
	MI[$m][$n]["tick"]="$tick"
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
	dt_wide "$m" $((${#lb} + 8))
}

# Add a dividing line.
dt_sep() {
	local m=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$m]["n"]}
	MI[$m][$n]["sep"]=1
	MI[$m][$n]["label"]=
	MI[$m][$n]["key"]=
	MI[$m][$n]["cmd"]=
	MI[$m][$n]["dim"]=0
	MI[$m][$n]["tick"]=""
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
}

# Register an app the hibr menu can open: name, title, height, width.
dt_app() {
	DT_APPS[$1]["title"]="$2"
	DT_APPS[$1]["h"]="$3"
	DT_APPS[$1]["w"]="$4"
	DT_APPS[$1]["once"]=
	[ "$5" = once ] && DT_APPS[$1]["once"]=1
	DT_APPS[$1]["icon"]="${6:-◆}"
}

# Where apps are found: every .hibr in each of these, in this order.  The
# user's own folder comes first, so a file there replaces a bundled app of
# the same name; a session adds its own folders after.
DT_APPDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps")
declare -gA DT_SRC

# Load every app in the folders.  Each file declares itself with dt_app, so
# the folder is the whole configuration: drop a script in, and it is on the
# menu at the next start.  A file whose name was already loaded from an
# earlier folder is skipped.
dt_apps() {
	local d f b

	for d in "${DT_APPDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC[$b]}" ] && continue
			DT_SRC[$b]=$f
			. "$f"
		done
	done
}

# The registered apps, sorted by title without regard to case, as names.
dt_appsorted() {
	local n l out=
	local -a all

	for n in "${!DT_APPS[@]}"; do
		l := str lower "${DT_APPS[$n]["title"]}"
		all+=("$l	$n")
	done
	arr sort all
	for l in "${all[@]}"; do out="$out ${l#*	}"; done
	ret "${out# }"
}

# The window already showing an app, if there is one.
dt_appwin() {
	local id

	for id in "${!DT[@]}"; do
		if [ "${DT[$id]["app"]}" = "$1" ]; then
			ret "$id"
			return 0
		fi
	done
	return 1
}

# Open a registered app in a fresh window, stepped down and across so a
# second one does not land exactly on the first.  An app declared `once`
# has one window at most: launching it again brings that one forward,
# shown if it was hidden.  Anything after the name goes to its _open.
dt_launch() {
	local n=$1 r c id

	[ -z "${DT_APPS[$n]["title"]}" ] && return 1
	if [ -n "${DT_APPS[$n]["once"]}" ] && id := dt_appwin "$n"; then
		dt_raise "$id"
		ret "$id"
		return 0
	fi
	r=$((2 + (DT_NEXT * 2) % 6))
	c=$((4 + (DT_NEXT * 4) % 16))
	dt_new "${DT_APPS[$n]["title"]}" "${DT_APPS[$n]["h"]}" \
		"${DT_APPS[$n]["w"]}" "$r" "$c" "$n" "$2"
}

# Rebuild the bar for whatever has focus.  Cheap enough to do every frame:
# it is a handful of assignments, and it has to follow the focus anyway.
dt_menus() {
	local who=${DT_FOCUS:-} ap= n k used

	[ -n "$who" ] && ap=${DT[$who]["app"]}
	MB_N=0

	dt_menu "hibr"
	dt_item "About hibr" a dt_about
	dt_sep
	used=aqd
	n := dt_appsorted
	for n in $n; do
		k := dt_akey "${DT_APPS[$n]["title"]}" "$used"
		used="$used$k"
		dt_item "${DT_APPS[$n]["title"]}" "$k" dt_launch "$n"
	done
	dt_sep
	if [ -n "$HIBR_HOLD" ]; then
		dt_item "Detach" d dt_detach
	else
		dt_dim "Detach"
	fi
	dt_item "Quit" q dt_quit

	MB_APP=
	if [ -n "$ap" ] && dt_has "${ap}_menus"; then
		MB_APP=$ap
		${ap}_menus
	fi

	# Edit is the desktop's, like Window: the same two items everywhere,
	# dimmed where the focused app cannot do them, so it never changes shape.
	dt_menu "Edit"
	if [ -n "$who" ] && [ -n "${DT[$who]["copy"]}" ]; then
		dt_item "Copy       alt-c" c dt_edit copy
	else
		dt_dim "Copy       alt-c"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["paste"]}" ] &&
	   [ -n "$DT_CLIP" ]; then
		dt_item "Paste      alt-v" v dt_edit paste
	else
		dt_dim "Paste      alt-v"
	fi

	# Always last, and always there: an app that has its own menus must
	# not be able to hide the only way to move or close its window.
	dt_menu "Window"
	if [ -z "$DT_FOCUS" ]; then
		dt_dim "Move"
		dt_dim "Resize"
		dt_dim "Zoom"
		dt_dim "Hide"
		dt_sep
		dt_dim "Close"
	else
		dt_item "Move" m dt_grab move
		dt_item "Resize" r dt_grab size
		dt_item "Zoom" z dt_zoom_focused
		dt_item "Hide" h dt_hide_focused
		dt_sep
		dt_item "Close" w dt_close_focused
	fi
	dt_sep
	dt_item "Cycle" c dt_cycle
	dt_layout
}

# Pick an accelerator for a label that nothing else in the menu has taken.
# Calculator and Clock both start with a C, and a menu where two items
# answer to the same letter is a menu where one of them cannot be reached.
dt_akey() {
	local t=$1 used=$2 i=0 c

	while [ "$i" -lt ${#t} ]; do
		c=${t:$i:1}
		c := str lower "$c"
		case $c in
		[a-z])
			case $used in
			*"$c"*) ;;
			*) ret "$c"; return 0 ;;
			esac
			;;
		esac
		i=$((i + 1))
	done
	for c in 1 2 3 4 5 6 7 8 9; do
		case $used in
		*"$c"*) ;;
		*) ret "$c"; return 0 ;;
		esac
	done
	ret ""
}

# Work out where each title sits on the bar.
dt_layout() {
	local i=0 c=1 t

	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			MB[$i]["x"]=0
			MB[$i]["tw"]=0
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		MB[$i]["x"]=$c
		MB[$i]["tw"]=$((${#t} + 2))
		c=$((c + ${#t} + 2))
		i=$((i + 1))
	done
	MB_AX=$((DT_COLS - 14))
}

dt_quit() { DT_QUIT=1; }

# Copy from the focused window or paste into it.
#
# An app offers <app>_copy, which hands back what is selected with ret and
# fails when nothing is, and <app>_paste, which is given the text.  The
# desktop keeps one clipboard for every window, and also sends a copy to the
# clipboard of the terminal it runs on, where that terminal allows it -- so
# what is copied here pastes into anything else on the machine.
dt_edit() {
	local cb t

	[ -n "$DT_FOCUS" ] || return 0
	cb=${DT[$DT_FOCUS]["$1"]}
	if [ -z "$cb" ]; then
		dt_note "${DT[$DT_FOCUS]["title"]} cannot $1"
		return 0
	fi
	if [ "$1" = paste ]; then
		[ -n "$DT_CLIP" ] && $cb "$DT_FOCUS" "$DT_CLIP"
		return 0
	fi
	if ! t := $cb "$DT_FOCUS" || [ -z "$t" ]; then
		dt_note "Nothing is selected"
		return 0
	fi
	DT_CLIP=$t
	console clip "$t"
	dt_note "Copied ${#t} characters"
}

# Leave the desktop running and give the terminal back.  Only a desktop
# started with `hold new` can, which is why the item is dimmed otherwise.
dt_detach() {
	need hold && hold detach
}
dt_about() { dt_note "hibr $HIBR_VERSION — a desktop written in the shell it runs on"; }
dt_close_focused() { [ -n "$DT_FOCUS" ] && dt_del "$DT_FOCUS"; }
dt_hide_focused() { [ -n "$DT_FOCUS" ] && dt_min "$DT_FOCUS"; }
dt_zoom_focused() { [ -n "$DT_FOCUS" ] && dt_zoom "$DT_FOCUS"; }

# Bring the bottom window to the top.
dt_cycle() {
	local l
	l := console pane list
	l=${l%% *}
	[ -n "$l" ] && dt_raise "${l#w}"
}

# Draw the bar itself.
dt_bar() {
	local i=0 t line now

	console pen "$DT_INK" "$DT_BAR"
	line := dt_rep "$DT_COLS" " "
	console put 0 0 "$line"

	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		if [ "$i" = "$MB_OPEN" ] || [ "$i" = "$MB_PAR" ]; then
			console pen "$DT_BAR" "$DT_ACTIVE" bold
		elif [ "$i" = 0 ]; then
			console pen "$DT_ACTIVE" "$DT_BAR" bold
		else
			console pen "$DT_INK" "$DT_BAR"
		fi
		console put 0 "${MB[$i]["x"]}" " $t "
		i=$((i + 1))
	done

	printf -v now "%(%H:%M)T" -1
	console pen "$DT_INK" "$DT_BAR"
	console put 0 $((DT_COLS - 19)) "$now"
	if [ "$MB_OPEN" = app ]; then
		console pen "$DT_BAR" "$DT_ACTIVE" bold
	else
		console pen "$DT_INK" "$DT_BAR"
	fi
	t := dt_appname
	console put 0 "$MB_AX" " ${t:0:11} ▾"
}

# What to call the active application on the right of the bar.
dt_appname() {
	if [ -z "$MB_APP" ]; then
		ret "Desktop"
	elif [ -n "${DT_APPS[$MB_APP]["title"]}" ]; then
		ret "${DT_APPS[$MB_APP]["title"]}"
	else
		ret "$MB_APP"
	fi
}

# Draw the open menu over everything else.
dt_drop() {
	local m=$MB_OPEN

	[ "$m" = -1 ] && return 0
	if [ "$m" = app ]; then
		dt_drop_apps
		return 0
	fi
	if [ -n "$MB_PAR" ]; then
		dt_menu_draw "$MB_PAR" "" 1
		dt_menu_draw "$m" "${MB[$m]["px"]}" 0
	else
		dt_menu_draw "$m" "" 0
	fi
}

# Draw one menu at its own place.  A submenu is given the column its parent
# occupies so it can sit beside it rather than on top of it.
dt_menu_draw() {
	local m=$1 px=$2 parent=$3
	local i=0 r=1 x w n lb k t sub

	x=${MB[$m]["x"]}
	w=${MB[$m]["w"]}
	n=${MB[$m]["n"]}
	[ "$w" -lt 14 ] && w=14
	[ -n "$px" ] && x=$px
	[ "$x" -lt 0 ] && x=0
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	MB[$m]["dx"]=$x
	MB[$m]["dw"]=$w
	while [ "$i" -lt "$n" ]; do
		if [ "${MI[$m][$i]["sep"]}" = 1 ]; then
			console pen "$DT_IDLE" "$DT_FACE"
			lb := dt_rep "$w" "─"
			console put "$r" "$x" "$lb"
			r=$((r + 1))
			i=$((i + 1))
			continue
		fi
		if [ "$parent" != 1 ] && [ "$i" = "$MB_SEL" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		elif [ "${MI[$m][$i]["dim"]}" = 1 ]; then
			console pen "$DT_IDLE" "$DT_FACE"
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		lb=${MI[$m][$i]["label"]}
		k=${MI[$m][$i]["key"]}
		t=${MI[$m][$i]["tick"]}
		sub=${MI[$m][$i]["sub"]}
		[ -n "$sub" ] && k="▸"
		[ -z "$t" ] && t=" "
		lb := str pad "$t $lb" $((w - 3))
		console put "$r" "$x" "$lb $k "
		r=$((r + 1))
		i=$((i + 1))
	done
	console pen "$DT_IDLE" "$DT_FACE"
	lb := dt_rep "$w" "─"
	console put "$r" "$x" "$lb"
}

# The application menu: every window, the hidden ones marked.
dt_drop_apps() {
	local ids id i=0 r=1 x w=18 t mark

	ids := dt_ids
	x=$((MB_AX - 4))
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	for id in $ids; do
		if [ "$i" = "$MB_SEL" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		mark=" "
		[ "$id" = "$DT_FOCUS" ] && mark="•"
		dt_hidden "$id" && mark="·"
		t := dt_title "$id"
		t := str pad "$mark ${t}" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
		i=$((i + 1))
	done
	if [ "$i" = 0 ]; then
		console pen "$DT_IDLE" "$DT_FACE"
		t := str pad " no windows" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
	fi
	console pen "$DT_IDLE" "$DT_FACE"
	t := dt_rep "$w" "─"
	console put "$r" "$x" "$t"
	MB_AN=$i
}

# How many rows the open menu occupies, and how many items it holds.
dt_mrows() {
	if [ "$MB_OPEN" = app ]; then
		ret "${MB_AN:-0}"
	else
		ret "${MB[$MB_OPEN]["n"]}"
	fi
}

# Move the highlight, stepping over separators.
dt_mmove() {
	local d=$1 n i=$MB_SEL k=0

	n := dt_mrows
	[ "$n" = 0 ] && return 0
	while [ "$k" -lt "$n" ]; do
		i=$(((i + d + n) % n))
		[ "$MB_OPEN" = app ] && break
		[ "${MI[$MB_OPEN][$i]["sep"]}" = 1 ] && { k=$((k + 1)); continue; }
		[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] && { k=$((k + 1)); continue; }
		break
	done
	MB_SEL=$i
}

# Open a menu, closing whatever was open.
dt_mopen() {
	MB_OPEN=$1
	MB_PAR=
	MB_SEL=0
	[ "$1" = app ] && return 0
	[ "${MI[$1][0]["sep"]}" = 1 ] || [ "${MI[$1][0]["dim"]}" = 1 ] &&
		dt_mmove 1
}

dt_mclose() {
	MB_OPEN=-1
	MB_PAR=
	MB_SEL=0
}

# Step into the submenu of the highlighted item, if it has one.
dt_mdown() {
	local sub

	[ "$MB_OPEN" = app ] && return 1
	sub=${MI[$MB_OPEN][$MB_SEL]["sub"]}
	[ -z "$sub" ] && return 1
	MB[$sub]["px"]=$((${MB[$MB_OPEN]["dx"]} + ${MB[$MB_OPEN]["dw"]} - 1))
	MB_PAR=$MB_OPEN
	MB_OPEN=$sub
	MB_SEL=0
	return 0
}

# Back out of a submenu to the one that owns it.
dt_mup() {
	local p=$MB_PAR i=0 n

	[ -z "$p" ] && return 1
	n=${MB[$p]["n"]}
	while [ "$i" -lt "$n" ]; do
		[ "${MI[$p][$i]["sub"]}" = "$MB_OPEN" ] && MB_SEL=$i
		i=$((i + 1))
	done
	MB_OPEN=$p
	MB_PAR=
	return 0
}

# Choose the highlighted item.
dt_mdo() {
	local m=$MB_OPEN i=$MB_SEL ids id n=0 cmd

	if [ "$m" != app ] && [ -n "${MI[$m][$i]["sub"]}" ]; then
		dt_mdown
		return 0
	fi
	dt_mclose
	if [ "$m" = app ]; then
		ids := dt_ids
		for id in $ids; do
			[ "$n" = "$i" ] && { dt_raise "$id"; return 0; }
			n=$((n + 1))
		done
		return 0
	fi
	[ "${MI[$m][$i]["sep"]}" = 1 ] && return 0
	[ "${MI[$m][$i]["dim"]}" = 1 ] && return 0
	cmd=${MI[$m][$i]["cmd"]}
	[ -n "$cmd" ] && $cmd
}

# Is a click inside the open menu?  Sets the highlight if it is.
dt_mpick() {
	local r=$1 c=$2 n x w

	n := dt_mrows
	[ "$r" -lt 1 ] || [ "$r" -gt "$n" ] && return 1
	if [ "$MB_OPEN" = app ]; then
		x=$((MB_AX - 4))
		w=18
	else
		x=${MB[$MB_OPEN]["x"]}
		w=${MB[$MB_OPEN]["w"]}
		[ "$w" -lt 12 ] && w=12
	fi
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	[ "$c" -lt "$x" ] || [ "$c" -ge $((x + w)) ] && return 1
	[ "$MB_OPEN" != app ] &&
		[ "${MI[$MB_OPEN][$((r - 1))]["sep"]}" = 1 ] && return 1
	MB_SEL=$((r - 1))
	return 0
}

# Which menu title is under a column on the bar, if any.
dt_mhit() {
	local c=$1 i=0 x w

	[ "$c" -ge "$MB_AX" ] && { ret app; return 0; }
	while [ "$i" -lt "$MB_N" ]; do
		x=${MB[$i]["x"]}
		w=${MB[$i]["tw"]}
		[ "$c" -ge "$x" ] && [ "$c" -lt $((x + w)) ] &&
			{ ret "$i"; return 0; }
		i=$((i + 1))
	done
	ret ""
	return 1
}

# Keys while the bar has the keyboard.  Returns 1 for a key it does not use.
dt_mkey() {
	local k=$1 n i=0 lb

	case $k in
	escape) dt_mup || dt_mclose; return 0 ;;
	left)
		dt_mup && return 0
		if [ "$MB_OPEN" = app ]; then
			dt_mopen $((MB_N - 1))
		elif [ "$MB_OPEN" -gt 0 ]; then
			dt_mopen $((MB_OPEN - 1))
		else
			dt_mopen app
		fi
		return 0
		;;
	right)
		dt_mdown && return 0
		if [ "$MB_OPEN" = app ]; then
			dt_mopen 0
		elif [ $((MB_OPEN + 1)) -lt "$MB_N" ]; then
			dt_mopen $((MB_OPEN + 1))
		else
			dt_mopen app
		fi
		return 0
		;;
	up) dt_mmove -1; return 0 ;;
	down) dt_mmove 1; return 0 ;;
	enter | " ") dt_mdo; return 0 ;;
	esac
	if [ "$MB_OPEN" != app ] && [ ${#k} = 1 ]; then
		n=${MB[$MB_OPEN]["n"]}
		while [ "$i" -lt "$n" ]; do
			[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] &&
				{ i=$((i + 1)); continue; }
			if [ -n "${MI[$MB_OPEN][$i]["key"]}" ] &&
			   [ "${MI[$MB_OPEN][$i]["key"]}" = "$k" ]; then
				MB_SEL=$i
				dt_mdo
				return 0
			fi
			i=$((i + 1))
		done
	fi
	return 1
}

# Take the arrows for moving or resizing the focused window, until enter or
# escape gives them back.  This is the keyboard's answer to dragging a title
# bar, and the only one there is: a desktop that can only be arranged with a
# mouse is a desktop half its users cannot arrange.
dt_grab() {
	[ -z "$DT_FOCUS" ] && return 1
	DT_GRAB=$1
	if [ "$1" = move ]; then
		dt_note "moving — arrows, then enter"
	else
		dt_note "resizing — arrows, then enter"
	fi
}

# One key while the arrows are taken.  Returns 1 for a key it does not want.
dt_gkey() {
	local id=$DT_FOCUS dr=0 dc=0

	case $1 in
	up) dr=-1 ;;
	down) dr=1 ;;
	left) dc=-1 ;;
	right) dc=1 ;;
	enter | escape | " ")
		DT_GRAB=
		DT_NOTE=
		return 0
		;;
	*) return 1 ;;
	esac
	if [ -z "$id" ]; then
		DT_GRAB=
		return 0
	fi
	if [ "$DT_GRAB" = move ]; then
		dt_move "$id" $((DT[$id]["row"] + dr)) \
			$((DT[$id]["col"] + dc))
	else
		dt_resize "$id" $((DT[$id]["h"] + dr)) \
			$((DT[$id]["w"] + dc))
	fi
	return 0
}

# A note in the middle of the screen, until the next key.
dt_note() {
	DT_NOTE="$1"
}

dt_note_draw() {
	local w r c t

	[ -z "$DT_NOTE" ] && return 0
	w=$((${#DT_NOTE} + 4))
	r=$((DT_ROWS / 2 - 1))
	c=$(((DT_COLS - w) / 2))
	console pen "$DT_INK" "$DT_FACE" bold
	t := dt_rep "$w" " "
	console put "$r" "$c" "$t"
	console put $((r + 1)) "$c" "  $DT_NOTE  "
	console put $((r + 2)) "$c" "$t"
}
