#!/usr/bin/env hibr
#
# desktop -- a window manager, written in hibr.
#
# This is the middle of the three layers in docs/adr/0020: the console module
# is the display server, this is the window manager, and the file you write
# yourself is the session.  Source this, call dt_open, make some windows and
# call dt_run:
#
#     . desktop.hibr
#     dt_open
#     dt_new "A window" 10 40 4 8
#     dt_run
#
# Nothing here is C.  Everything below draws with `console put` and reads
# `console key`, and it redraws every window from the bottom of the stack
# upwards every frame, because the console only sends the cells that changed.

need display || { echo "desktop: no display available" >&2; exit 1; }

DT_NEXT=1
DT_FOCUS=
DT_DRAG=
DT_DR=0
DT_DC=0
DT_QUIT=0
DT_TABS=
DT_ROWS=24
DT_COLS=80
declare -A DT

DT_WALL="${DT_WALL-#0d1b2a}"
DT_DOT="${DT_DOT-#16324a}"
DT_BAR="${DT_BAR-#1b3a5c}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_IDLE="${DT_IDLE-#4a5568}"
DT_FACE="${DT_FACE-#101820}"
DT_INK="${DT_INK-#cbd5e0}"

# Open the display, take the mouse, and note how big the screen is.
dt_open() {
	console open || return 1
	console mouse drag
	console cursor 0 0 0
	dt_size
}

# Re-read the screen size after a resize.
dt_size() {
	local sz
	sz := console size
	DT_ROWS=${sz% *}
	DT_COLS=${sz#* }
}

# Give the terminal back.
dt_close() {
	console mouse off
	console close
}

# Which of an app's five functions actually exist, asked once.
dt_has() {
	command -v "$1" > /dev/null
}

# Make a window and put it on top.  Its id lands in $RET.
#
# The app argument is a prefix, not a command: an app called clock provides
# any of clock_draw, clock_key, clock_click, clock_open and clock_close, and
# the ones it does not write are never called.  That is the whole reason it
# is a prefix -- an app with no clock_key cannot swallow a key by accident,
# which a single function answering a verb in a case statement does, because
# a case that matches nothing succeeds.
dt_new() {
	local id=$DT_NEXT ap=${6-} f

	DT[$id]["title"]="$1"
	DT[$id]["h"]="$2"
	DT[$id]["w"]="$3"
	DT[$id]["row"]="$4"
	DT[$id]["col"]="$5"
	DT[$id]["app"]="$ap"
	DT[$id]["min"]=0
	for f in draw key click wheel open close; do
		if [ -n "$ap" ] && dt_has "${ap}_$f"; then
			DT[$id]["$f"]="${ap}_$f"
		else
			DT[$id]["$f"]=
		fi
	done
	DT_NEXT=$((DT_NEXT + 1))
	console pane "w$id" "$4" "$5" "$2" "$3"
	DT_FOCUS=$id
	[ -n "${DT[$id]["open"]}" ] && ${DT[$id]["open"]} "$id"
	ret "$id"
}

# Close a window and forget it.
dt_del() {
	local id=$1

	[ -n "${DT[$id]["close"]}" ] && ${DT[$id]["close"]} "$id"
	console pane drop "w$id"
	unset "DT[$id]"
	if [ "$DT_FOCUS" = "$id" ]; then
		local l
		l := console pane list
		l=${l##* }
		DT_FOCUS=${l#w}
	fi
}

# Show or hide a window without destroying it.  A minimised window has no
# pane, so nothing draws it and nothing can hit it; its only remaining handle
# is the label dt_wall puts on the bar, which is why that label exists.
dt_min() {
	local id=$1 l

	if [ "${DT[$id]["min"]}" = 1 ]; then
		DT[$id]["min"]=0
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}"
		console pane raise "w$id"
		DT_FOCUS=$id
	else
		DT[$id]["min"]=1
		console pane drop "w$id"
		if [ "$DT_FOCUS" = "$id" ]; then
			l := console pane list
			l=${l##* }
			DT_FOCUS=${l#w}
		fi
	fi
}

# Draw inside a window, in its own coordinates, with the frame allowed for.
dt_put() {
	console put -p "w$1" $(($2 + 1)) $(($3 + 1)) "$4"
}

# Repeat a string n times.  One builtin call, not a loop with ${#} in it.
# The result goes through a variable and then ret: := binds for a builtin,
# not for a function, so a bare `str repeat` here would print to the screen.
dt_rep() {
	local o

	str repeat "$2" "$1" o
	ret "$o"
}

# Paint the wallpaper and the bar across the top.
#
# The bar carries a label for every minimised window, and DT_TABS records
# where each one landed so a click can be turned back into a window id.  It
# is the only way back from minimising, since a minimised window has no pane.
dt_wall() {
	local line id open=0 mini=0 c t

	console pen "$DT_DOT" "$DT_WALL"
	console fill 0 0 "$DT_ROWS" "$DT_COLS" "·"
	console pen "$DT_INK" "$DT_BAR"
	line := dt_rep "$DT_COLS" " "
	console put 0 0 "$line"
	console pen "$DT_ACTIVE" "$DT_BAR" bold
	console put 0 1 "hibr"

	DT_TABS=
	c=7
	for id in "${!DT[@]}"; do
		if [ "${DT[$id]["min"]}" != 1 ]; then
			open=$((open + 1))
			continue
		fi
		mini=$((mini + 1))
		t="[${DT[$id]["title"]}]"
		[ $((c + ${#t} + 1)) -gt $((DT_COLS - 30)) ] && continue
		console pen "$DT_INK" "$DT_BAR"
		console put 0 "$c" "$t"
		DT_TABS="$DT_TABS $id:$c:$((c + ${#t} - 1))"
		c=$((c + ${#t} + 1))
	done

	console pen "$DT_INK" "$DT_BAR"
	if [ "$mini" -gt 0 ]; then
		console put 0 $((DT_COLS - 28)) "$open open, $mini hidden"
	else
		console put 0 $((DT_COLS - 28)) "$open open"
	fi
	console put 0 $((DT_COLS - 10)) "q to quit"
}

# Which minimised window's label is under this column, if any.
dt_tab() {
	local e id lo hi

	for e in $DT_TABS; do
		id=${e%%:*}
		lo=${e#*:}
		hi=${lo#*:}
		lo=${lo%%:*}
		if [ "$1" -ge "$lo" ] && [ "$1" -le "$hi" ]; then
			ret "$id"
			return 0
		fi
	done
	ret ""
	return 1
}

# Draw one window: its face, then its app, then its frame over the top.
dt_win() {
	local id=$1
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}

	[ "$DT_FOCUS" = "$id" ] && on=$DT_ACTIVE
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2))
	console pen "$on" "$DT_FACE"
	local bar edge
	bar := dt_rep $((w - 2)) "─"
	console put -p "w$id" 0 0 "┌$bar┐"
	console put -p "w$id" $((h - 1)) 0 "└$bar┘"
	local r=1
	while [ "$r" -lt $((h - 1)) ]; do
		console put -p "w$id" "$r" 0 "│"
		console put -p "w$id" "$r" $((w - 1)) "│"
		r=$((r + 1))
	done
	local t=${DT[$id]["title"]}
	local room=$((w - 12))
	[ ${#t} -gt "$room" ] && t="${t:0:$room}"
	console pen "$on" "$DT_FACE" bold
	console put -p "w$id" 0 2 "┤ $t ├"
	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" 0 $((w - 8)) "┤_ □ x├"
	console pen "#f56565" "$DT_FACE" bold
	console put -p "w$id" 0 $((w - 3)) "x"
}

# One full frame, bottom of the stack upwards.
dt_draw() {
	local l id
	dt_wall
	l := console pane list
	for id in $l; do dt_win "${id#w}"; done
	console flush
}

# Which title-bar button is at this column, if any.
dt_btn() {
	local w=$1 c=$2
	case $((w - c)) in
	7) ret min ;;
	5) ret max ;;
	3) ret close ;;
	*) ret "" ;;
	esac
}

# Handle one mouse report.
#
# An app is told a click in *pane* coordinates -- the same ones it draws in,
# where row 0 is the top border -- and not in some separate body coordinate
# system. Two systems is one too many: an app that draws at row 4 and is told
# a click at row 3 has to hold both in its head, and the first two apps each
# got the conversion wrong. The window manager handles row 0 itself, so an
# app only ever sees a click at row 1 or below.
#
# A report is `<action> <button> <row> <col>` for a press, a release or a
# drag, and `<action> <row> <col>` for the wheel, which has no button -- so
# the position cannot be read from a fixed argument. The action may carry a
# modifier, `ctrl-press`, which is stripped: a modified click is still a
# click here.
#
# Window fields are read into locals first: a subscript is only literal when
# it is quoted, and arithmetic never sees the quotes, so DT[$id][col] inside
# $(( )) would mean DT[$id][5] here.
dt_mouse() {
	local act=${1##*-} mr mc
	local id b wr wc wh ww ap

	shift
	case $act in
	wheelup | wheeldown) mr=$1; mc=$2 ;;
	*) mr=$2; mc=$3 ;;
	esac

	case $act in
	press)
		if [ "$mr" = 0 ]; then
			id := dt_tab "$mc"
			[ -n "$id" ] && dt_min "$id"
			return 0
		fi
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			DT_FOCUS=
			return 0
		fi
		id=${id#w}
		console pane raise "w$id"
		DT_FOCUS=$id
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		ww=${DT[$id]["w"]}
		ap=${DT[$id]["click"]}
		if [ "$mr" -ne "$wr" ]; then
			[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wc))
			return 0
		fi
		b := dt_btn "$ww" $((mc - wc))
		case $b in
		close) dt_del "$id" ;;
		min) dt_min "$id" ;;
		max) dt_zoom "$id" ;;
		*)
			DT_DRAG=$id
			DT_DR=$((mr - wr))
			DT_DC=$((mc - wc))
			;;
		esac
		;;
	drag)
		[ -z "$DT_DRAG" ] && return 0
		id=$DT_DRAG
		wh=${DT[$id]["h"]}
		ww=${DT[$id]["w"]}
		wr=$((mr - DT_DR))
		wc=$((mc - DT_DC))
		[ "$wr" -lt 1 ] && wr=1
		[ "$wc" -lt 0 ] && wc=0
		[ $((wr + wh)) -gt "$DT_ROWS" ] && wr=$((DT_ROWS - wh))
		[ $((wc + ww)) -gt "$DT_COLS" ] && wc=$((DT_COLS - ww))
		DT[$id]["row"]=$wr
		DT[$id]["col"]=$wc
		console pane "w$id" "$wr" "$wc" "$wh" "$ww"
		;;
	release)
		DT_DRAG=
		;;
	wheelup | wheeldown)
		id := console hit "$mr" "$mc"
		[ -z "$id" ] && return 0
		id=${id#w}
		ap=${DT[$id]["wheel"]}
		[ -z "$ap" ] && return 0
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		$ap "$id" "${act#wheel}" $((mr - wr)) $((mc - wc))
		;;
	esac
}

# Fill the screen, or go back to where the window was.
dt_zoom() {
	local id=$1

	if [ -n "${DT[$id]["oh"]}" ]; then
		DT[$id]["row"]=${DT[$id]["or"]}
		DT[$id]["col"]=${DT[$id]["oc"]}
		DT[$id]["h"]=${DT[$id]["oh"]}
		DT[$id]["w"]=${DT[$id]["ow"]}
		DT[$id]["oh"]=
	else
		DT[$id]["or"]=${DT[$id]["row"]}
		DT[$id]["oc"]=${DT[$id]["col"]}
		DT[$id]["oh"]=${DT[$id]["h"]}
		DT[$id]["ow"]=${DT[$id]["w"]}
		DT[$id]["row"]=1
		DT[$id]["col"]=0
		DT[$id]["h"]=$((DT_ROWS - 1))
		DT[$id]["w"]=$DT_COLS
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Handle one decoded key or mouse line.
#
# The wheel goes to the window under the pointer rather than to the focused
# one, which is what every other desktop does and what anyone expects when
# they scroll a list they have not clicked on yet.
dt_event() {
	local k="$1"

	case $k in
	"mouse "*)
		set -- $k
		shift
		dt_mouse "$@"
		return 0
		;;
	esac
	if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["key"]}" ]; then
		if ${DT[$DT_FOCUS]["key"]} "$DT_FOCUS" "$k"; then
			return 0
		fi
	fi
	case $k in
	q) DT_QUIT=1 ;;
	escape)
		local id
		for id in "${!DT[@]}"; do
			[ "${DT[$id]["min"]}" = 1 ] && dt_min "$id" && return 0
		done
		;;
	tab)
		local l
		l := console pane list
		l=${l%% *}
		[ -n "$l" ] && console pane raise "$l" && DT_FOCUS=${l#w}
		;;
	esac
}

# The event loop.  Draw, wait, dispatch, repeat.
dt_run() {
	local k
	while [ "$DT_QUIT" = 0 ]; do
		dt_draw
		k := console key "${DT_TICK-200}"
		if console resized; then
			dt_size
			continue
		fi
		[ -n "$k" ] && dt_event "$k"
	done
}
