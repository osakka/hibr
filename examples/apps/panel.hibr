#!/usr/bin/env hibr
#
# panel -- the window that configures the others.
#
# Appearance and behaviour on top, then a row per window: enter raises it,
# x closes it, - hides it.  The theme is applied by setting the variables the
# window manager already reads every frame, so a change shows on the next
# one, in every window at once, without anything being told about it.
#
# Run on its own it prints the themes and stops, which is not much, but it
# means the file is still a program and not only a fragment.

app panel "Settings, and the window list"

# What the hibr menu shows, how big a new window is, and whether a second
# launch opens another window or brings this one forward.
command -v dt_app > /dev/null && dt_app panel "Settings" 18 34 once "≡"

# The theme and the wallpaper belong to the desktop, so they stay global.
# Where the selection is and what the rows are belong to a window, so they
# do not: two panels would otherwise share one cursor.
declare -gA PW
declare -gA CP
CP_THEME=midnight
command -v dt_keep > /dev/null && dt_keep CP_THEME
CP_THEMES=(midnight slate forest ember paper)
CP_TICKS=(80 120 200 350 600)
CP_GLYPHS=("·" "░" "▒" "⋅" "+")
CP_CURSORS=(block underline bar)

# wall, dot, bar, active, idle, face, ink
cp_theme() {
	local t=$1

	case $t in
	midnight) set -- "#0d1b2a" "#16324a" "#1b3a5c" "#63b3ed" "#4a5568" \
		"#101820" "#cbd5e0" ;;
	slate)    set -- "#1a202c" "#2d3748" "#2d3748" "#90cdf4" "#4a5568" \
		"#171923" "#e2e8f0" ;;
	forest)   set -- "#0b1f16" "#14342a" "#14432f" "#68d391" "#3f5e51" \
		"#0d1f18" "#d7e8de" ;;
	ember)    set -- "#1f1410" "#3a241c" "#4a2c1e" "#f6ad55" "#6b4a3a" \
		"#1a110d" "#ecd9c6" ;;
	paper)    set -- "#e8e4da" "#d3cec1" "#c3bdae" "#2b6cb0" "#8a8578" \
		"#f5f2ea" "#2d3748" ;;
	*) return 1 ;;
	esac
	CP_THEME=$t
	DT_WALL=$1
	DT_DOT=$2
	DT_BAR=$3
	DT_ACTIVE=$4
	DT_IDLE=$5
	DT_FACE=$6
	DT_INK=$7
}

# Step through a list, wrapping at either end.
cp_next() {
	local cur=$1 dir=$2 n=0 i=0 hit=-1 x

	shift 2
	for x in "$@"; do
		[ "$x" = "$cur" ] && hit=$n
		n=$((n + 1))
	done
	[ "$hit" -lt 0 ] && hit=0
	i=$(((hit + dir + n) % n))
	n=0
	for x in "$@"; do
		[ "$n" = "$i" ] && { ret "$x"; return 0; }
		n=$((n + 1))
	done
}

# Build the rows: headings, settings, then one per window.
#
# Rebuilt every frame, because the window list changes underneath it and a
# panel showing windows that closed a second ago is worse than no panel.
cp_rows() {
	local w=$1 n=0 id ids

	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Appearance"; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Theme"
	CP[$w][$n]["val"]="$CP_THEME"; CP[$w][$n]["key"]=theme; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Wallpaper"
	CP[$w][$n]["val"]="$DT_GLYPH"; CP[$w][$n]["key"]=glyph; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]=""; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Behaviour"; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Refresh"
	CP[$w][$n]["val"]="$DT_TICK ms"; CP[$w][$n]["key"]=tick; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Icons"
	CP[$w][$n]["val"]=off; [ "$DT_ICONS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=icons; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Disk Icons"
	CP[$w][$n]["val"]=off; [ "$DT_DISKS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=disks; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Cursor"
	CP[$w][$n]["val"]="$DT_CURSOR"; CP[$w][$n]["key"]=cursor; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Cursor Blink"
	CP[$w][$n]["val"]=off; [ "$DT_CURSOR_BLINK" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=blink; n=$((n + 1))
	CP[$w][$n]["kind"]=set;  CP[$w][$n]["text"]="Window Shadow"
	CP[$w][$n]["val"]=off; [ "$DT_SHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=shadow; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]=""; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Windows"; n=$((n + 1))

	ids := dt_ids
	for id in $ids; do
		CP[$w][$n]["kind"]=win
		CP[$w][$n]["text"] := dt_title "$id"
		if dt_hidden "$id"; then
			CP[$w][$n]["val"]=hidden
		else
			CP[$w][$n]["val"]=open
		fi
		CP[$w][$n]["key"]=$id
		n=$((n + 1))
	done
	PW[$w]["n"]=$n
}

# Move the selection, skipping headings, and keep it on screen.
cp_move() {
	local w=$1 d=$2 i n vis top k=0

	n=${PW[$w]["n"]}
	vis=${PW[$w]["vis"]}
	top=${PW[$w]["top"]}
	i=${PW[$w]["sel"]}
	[ "$n" -lt 1 ] && return 0
	while [ "$k" -lt "$n" ]; do
		i=$(((i + d + n) % n))
		[ "${CP[$w][$i]["kind"]}" != head ] && break
		k=$((k + 1))
	done
	PW[$w]["sel"]=$i
	[ "$i" -lt "$top" ] && top=$i
	[ "$i" -ge $((top + vis)) ] && top=$((i - vis + 1))
	[ "$top" -lt 0 ] && top=0
	PW[$w]["top"]=$top
}

# Change the selected setting, or act on the selected window.
cp_do() {
	local w=$1 dir=$2 sel k v

	sel=${PW[$w]["sel"]}
	k=${CP[$w][$sel]["key"]}
	case ${CP[$w][$sel]["kind"]} in
	set)
		case $k in
		theme) v := cp_next "$CP_THEME" "$dir" "${CP_THEMES[@]}"
		       cp_theme "$v" ;;
		glyph) v := cp_next "$DT_GLYPH" "$dir" "${CP_GLYPHS[@]}"
		       DT_GLYPH=$v ;;
		tick)  v := cp_next "$DT_TICK" "$dir" "${CP_TICKS[@]}"
		       DT_TICK=$v ;;
		icons) cp_icons ;;
		disks) cp_disks ;;
		cursor) v := cp_next "$DT_CURSOR" "$dir" "${CP_CURSORS[@]}"
			DT_CURSOR=$v ;;
		blink) cp_blink ;;
		shadow) cp_shadow ;;
		esac
		cp_save
		;;
	win) dt_raise "$k" ;;
	esac
}

panel_open() {
	local w=$1

	PW[$w]["sel"]=1
	PW[$w]["top"]=0
	PW[$w]["vis"]=1
	PW[$w]["last"]=-1
	cp_rows "$w"
}

panel_draw() {
	local id=$1 h=$2 w=$3
	local i r t v n top sel

	cp_rows "$id"
	PW[$id]["vis"]=$((h - 1))
	n=${PW[$id]["n"]}
	sel=${PW[$id]["sel"]}
	top=${PW[$id]["top"]}
	[ "$sel" -ge "$n" ] && sel=$((n - 1)) && PW[$id]["sel"]=$sel
	i=$top
	r=1
	while [ "$r" -le "$h" ]; do
		t=""
		v=""
		if [ "$i" -lt "$n" ]; then
			t=${CP[$id][$i]["text"]}
			v=${CP[$id][$i]["val"]}
		fi
		if [ "$i" -ge "$n" ]; then
			console pen "$DT_INK" "$DT_FACE"
			t := str repeat " " $((w - 1))
		elif [ "${CP[$id][$i]["kind"]}" = head ]; then
			console pen "#718096" "$DT_FACE" bold
			t := str pad "$t" $((w - 1))
		else
			if [ "$i" = "$sel" ]; then
				console pen "#1a202c" "$DT_ACTIVE" bold
			else
				console pen "$DT_INK" "$DT_FACE"
			fi
			t := str pad "  $t" $((w - 13))
			v := str pad "$v" 12
			t="$t$v"
		fi
		console put -p "w$id" "$r" 1 "$t"
		r=$((r + 1))
		i=$((i + 1))
	done
}

panel_menus() {
	local x on w=$DT_FOCUS

	dt_menu "Settings"
	dt_sub "Theme"
	for x in "${CP_THEMES[@]}"; do
		on=0
		[ "$x" = "$CP_THEME" ] && on=1
		dt_mark "$x" "${x:0:1}" "$on" cp_set_theme "$x"
	done
	dt_end
	dt_sub "Wallpaper"
	for x in "${CP_GLYPHS[@]}"; do
		on=0
		[ "$x" = "$DT_GLYPH" ] && on=1
		dt_mark "$x" "" "$on" cp_set_glyph "$x"
	done
	dt_end
	dt_sub "Refresh"
	for x in "${CP_TICKS[@]}"; do
		on=0
		[ "$x" = "$DT_TICK" ] && on=1
		dt_mark "$x ms" "" "$on" cp_set_tick "$x"
	done
	dt_end
	dt_sub "Cursor"
	for x in "${CP_CURSORS[@]}"; do
		on=0
		[ "$x" = "$DT_CURSOR" ] && on=1
		dt_mark "$x" "" "$on" cp_set_cursor "$x"
	done
	dt_end
	on=0
	[ "$DT_ICONS" = 1 ] && on=1
	dt_mark "Desktop Icons" i "$on" cp_icons
	on=0
	[ "$DT_DISKS" = 1 ] && on=1
	dt_mark "Disk Icons" k "$on" cp_disks
	on=0
	[ "$DT_CURSOR_BLINK" = 1 ] && on=1
	dt_mark "Cursor Blink" b "$on" cp_blink
	on=0
	[ "$DT_SHADOW" = 1 ] && on=1
	dt_mark "Window Shadow" s "$on" cp_shadow
	dt_sep
	dt_item "Change Selected" c cp_do "$w" 1
}

cp_set_theme() { cp_theme "$1" && cp_save; }

# Icons on the desktop, or a bare wallpaper.
cp_icons() {
	if [ "$DT_ICONS" = 1 ]; then
		DT_ICONS=0
	else
		DT_ICONS=1
	fi
	command -v dt_deskscan > /dev/null && dt_deskscan
	cp_save
}

# The mounted disks among those icons, or just Home and the trash.
cp_disks() {
	if [ "$DT_DISKS" = 1 ]; then
		DT_DISKS=0
	else
		DT_DISKS=1
	fi
	command -v dt_deskscan > /dev/null && dt_deskscan
	cp_save
}
cp_set_glyph() { DT_GLYPH=$1; cp_save; }
cp_set_tick() { DT_TICK=$1; cp_save; }
cp_set_cursor() { DT_CURSOR=$1; cp_save; }

# Whether a focused terminal's cursor blinks.
cp_blink() {
	if [ "$DT_CURSOR_BLINK" = 1 ]; then
		DT_CURSOR_BLINK=0
	else
		DT_CURSOR_BLINK=1
	fi
	cp_save
}

# Whether a window casts a shadow on what is under it.
cp_shadow() {
	if [ "$DT_SHADOW" = 1 ]; then
		DT_SHADOW=0
	else
		DT_SHADOW=1
	fi
	cp_save
}

# Every change is kept at once: there is no Save to forget.
cp_save() {
	command -v dt_save > /dev/null && dt_save
	return 0
}

panel_key() {
	local w=$1 sel

	case $2 in
	up) cp_move "$w" -1 ;;
	down) cp_move "$w" 1 ;;
	right | enter | " ") cp_do "$w" 1 ;;
	left) cp_do "$w" -1 ;;
	x)
		sel=${PW[$w]["sel"]}
		[ "${CP[$w][$sel]["kind"]}" = win ] &&
			dt_del "${CP[$w][$sel]["key"]}"
		;;
	-)
		sel=${PW[$w]["sel"]}
		[ "${CP[$w][$sel]["kind"]}" = win ] &&
			dt_min "${CP[$w][$sel]["key"]}"
		;;
	*) return 1 ;;
	esac
}

# A click selects; a second click on the same row does what enter does.
panel_click() {
	local w=$1 r=$2 i n top

	n=${PW[$w]["n"]}
	top=${PW[$w]["top"]}
	i=$((top + r - 1))
	[ "$r" -lt 1 ] || [ "$i" -ge "$n" ] && return 0
	[ "${CP[$w][$i]["kind"]}" = head ] && return 0
	if [ "$i" = "${PW[$w]["sel"]}" ] && [ "$i" = "${PW[$w]["last"]}" ]; then
		cp_do "$w" 1
		return 0
	fi
	PW[$w]["sel"]=$i
	PW[$w]["last"]=$i
}

panel_wheel() {
	local w=$1 top max n vis

	top=${PW[$w]["top"]}
	n=${PW[$w]["n"]}
	vis=${PW[$w]["vis"]}
	max=$((n - vis))
	case $2 in
	up) top=$((top - 2)) ;;
	down) top=$((top + 2)) ;;
	esac
	[ "$top" -gt "$max" ] && top=$max
	[ "$top" -lt 0 ] && top=0
	PW[$w]["top"]=$top
}

if [ -z "$DT_ROWS" ]; then
	echo "themes: ${CP_THEMES[*]}"
	echo "wallpaper: ${CP_GLYPHS[*]}"
	echo "refresh: ${CP_TICKS[*]}"
fi
