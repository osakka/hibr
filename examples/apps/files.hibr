#!/usr/bin/env hibr
#
# files -- a file browser for the desktop, and a lister on its own.
#
#     hibr examples/apps/files.hibr /etc
#
# This is the app that scrolls.  Everything it shows lives inside the window
# and moves under a fixed frame: arrows and page keys move the selection, the
# wheel moves the view without moving the selection, and a click lands on the
# row it was aimed at.  The window manager knows none of that -- it hands over
# a row and a column relative to the window and the app decides what they mean.
#
# There are no sizes or dates in the listing because the shell cannot ask for
# them without forking a stat, and a browser that forks once per row would be
# the slowest thing in the desktop.  Names and what is a directory come from
# globbing and [ -d ], which cost nothing.

app files "A file browser"

# What the hibr menu shows, how big a new window is, and whether a second
# launch opens another window or brings this one forward.
command -v dt_app > /dev/null && dt_app files "Files" 12 34 many "▤"

# Per window, not per app.  Two browsers must be able to be in two different
# directories; a global would put them both in the last one opened.  FB holds
# each window's state and FL holds its listing.
declare -gA FB
declare -gA FL

# Read a directory into FL: name, and whether it is a directory.  Directories
# come first, each group in the order the glob gave, which is sorted.
#
# Entries past ["n"] are left over from a larger directory and never read,
# because everything that walks the list stops there.
fb_scan() {
	local id=$1 f n=0 base d

	d=${FB[$id]["dir"]}
	if [ "$d" != / ]; then
		FL[$id][$n]["name"]=".."
		FL[$id][$n]["dir"]=1
		n=$((n + 1))
	fi
	for f in "$d"/*/ ${FB[$id]["hidden"]:+"$d"/.*/}; do
		f=${f%/}
		base=${f##*/}
		[ -d "$f" ] || continue
		[ "$base" = "." ] || [ "$base" = ".." ] && continue
		FL[$id][$n]["name"]="$base"
		FL[$id][$n]["dir"]=1
		n=$((n + 1))
	done
	for f in "$d"/* ${FB[$id]["hidden"]:+"$d"/.*}; do
		[ -e "$f" ] || continue
		[ -d "$f" ] && continue
		base=${f##*/}
		FL[$id][$n]["name"]="$base"
		FL[$id][$n]["dir"]=0
		n=$((n + 1))
	done
	FB[$id]["n"]=$n
	FB[$id]["top"]=0
	FB[$id]["sel"]=0
	FB[$id]["last"]=-1
}

# Go somewhere, keeping the path absolute and without a trailing slash.
fb_go() {
	local id=$1 d=$2

	case $d in
	/*) ;;
	*) d="${FB[$id]["dir"]}/$d" ;;
	esac
	while [ "$d" != "${d%/.}" ]; do d=${d%/.}; done
	case $d in
	*/..)
		d=${d%/..}
		d=${d%/*}
		[ -z "$d" ] && d=/
		;;
	esac
	[ -d "$d" ] || return 1
	FB[$id]["dir"]=$d
	fb_scan "$id"
}

# Keep the selection on screen after it moves.
fb_show() {
	local id=$1 vis sel n top

	vis=${FB[$id]["vis"]}
	sel=${FB[$id]["sel"]}
	n=${FB[$id]["n"]}
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt 0 ] && sel=0
	FB[$id]["sel"]=$sel
	[ "$sel" -lt "${FB[$id]["top"]}" ] && FB[$id]["top"]=$sel
	top=${FB[$id]["top"]}
	[ "$sel" -ge $((top + vis)) ] && FB[$id]["top"]=$((sel - vis + 1))
	fb_clamp "$id"
}

# Keep the view itself inside the list.
fb_clamp() {
	local id=$1 max n vis

	n=${FB[$id]["n"]}
	vis=${FB[$id]["vis"]}
	max=$((n - vis))
	[ "$max" -lt 0 ] && max=0
	[ "${FB[$id]["top"]}" -gt "$max" ] && FB[$id]["top"]=$max
	[ "${FB[$id]["top"]}" -lt 0 ] && FB[$id]["top"]=0
}

files_open() {
	FB[$1]["dir"]="${FB_DIR:-$PWD}"
	FB[$1]["hidden"]=
	FB[$1]["vis"]=1
	fb_scan "$1"
}

files_draw() {
	local id=$1 h=$2 w=$3
	local vis=$((h - 2)) i r nm t thumb n top sel

	# What _key and _wheel need is how many rows are on screen, and draw
	# is the only thing told.  Keeping it here rather than reading the
	# window manager's table keeps the app out of its host's state, and
	# survives a resize for free: draw runs before every event.
	FB[$id]["vis"]=$vis
	n=${FB[$id]["n"]}
	top=${FB[$id]["top"]}
	sel=${FB[$id]["sel"]}

	console pen "#63b3ed" "$DT_FACE" bold
	t="${FB[$id]["dir"]}"
	[ ${#t} -gt "$w" ] && t="…${t: -$((w - 1))}"
	t := str pad "$t" "$w"
	console put -p "w$id" 1 1 "$t"

	i=$top
	r=2
	while [ "$r" -lt "$h" ]; do
		if [ "$i" -ge "$n" ]; then
			console pen "$DT_INK" "$DT_FACE"
			t := str repeat " " $((w - 1))
			console put -p "w$id" "$r" 1 "$t"
			r=$((r + 1))
			i=$((i + 1))
			continue
		fi
		nm=${FL[$id][$i]["name"]}
		[ "${FL[$id][$i]["dir"]}" = 1 ] && nm="$nm/"
		t := str pad " $nm" $((w - 1))
		if [ "$i" = "$sel" ]; then
			console pen "#1a202c" "#63b3ed" bold
		elif [ "${FL[$id][$i]["dir"]}" = 1 ]; then
			console pen "#f6ad55" "$DT_FACE"
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" 1 "$t"
		r=$((r + 1))
		i=$((i + 1))
	done

	if [ "$n" -gt "$vis" ]; then
		thumb=$((2 + (top * (vis - 1)) / (n - vis)))
		r=2
		while [ "$r" -lt "$h" ]; do
			if [ "$r" = "$thumb" ]; then
				console pen "#63b3ed" "$DT_FACE"
				console put -p "w$id" "$r" "$w" "█"
			else
				console pen "#2d3748" "$DT_FACE"
				console put -p "w$id" "$r" "$w" "│"
			fi
			r=$((r + 1))
		done
	fi

	console pen "#718096" "$DT_FACE"
	t := str pad "$((sel + 1)) of $n" "$w"
	console put -p "w$id" "$h" 1 "$t"
}

files_key() {
	local id=$1 vis sel n

	vis=${FB[$id]["vis"]}
	sel=${FB[$id]["sel"]}
	n=${FB[$id]["n"]}
	case $2 in
	up) FB[$id]["sel"]=$((sel - 1)) ;;
	down) FB[$id]["sel"]=$((sel + 1)) ;;
	pageup) FB[$id]["sel"]=$((sel - vis)) ;;
	pagedown) FB[$id]["sel"]=$((sel + vis)) ;;
	home) FB[$id]["sel"]=0 ;;
	end) FB[$id]["sel"]=$((n - 1)) ;;
	enter | right) fb_open "$id" ;;
	backspace | left) fb_go "$id" .. ;;
	h) files_hidden "$id" ;;
	*) return 1 ;;
	esac
	fb_show "$id"
}

# Enter the selected directory.  A file is selected and nothing more: there
# is no viewer here, and pretending otherwise would be the wrong kind of
# clever.
fb_open() {
	local id=$1 sel

	sel=${FB[$id]["sel"]}
	[ "${FB[$id]["n"]}" = 0 ] && return 0
	[ "${FL[$id][$sel]["dir"]}" = 1 ] &&
		fb_go "$id" "${FL[$id][$sel]["name"]}"
}

files_hidden() {
	if [ -n "${FB[$1]["hidden"]}" ]; then
		FB[$1]["hidden"]=
	else
		FB[$1]["hidden"]=1
	fi
	fb_scan "$1"
}

fb_home() { fb_go "$1" "$HOME"; }
files_top() { FB[$1]["sel"]=0; fb_show "$1"; }
files_end() {
	local n=${FB[$1]["n"]}

	FB[$1]["sel"]=$((n - 1))
	fb_show "$1"
}

files_menus() {
	local id=$DT_FOCUS on=0

	dt_menu "File"
	dt_item "Open" o fb_open "$id"
	dt_item "Go Up" u fb_go "$id" ..
	dt_item "Home" h fb_home "$id"
	dt_sep
	dt_item "Close" w dt_close_focused
	dt_menu "View"
	[ -n "${FB[$id]["hidden"]}" ] && on=1
	dt_mark "Hidden Files" d "$on" files_hidden "$id"
	dt_item "Refresh" r fb_scan "$id"
	dt_sep
	dt_item "First" t files_top "$id"
	dt_item "Last" b files_end "$id"
}

# A click selects the row it landed on, and a second click on the same row
# opens it.
files_click() {
	local id=$1 r=$2 i top

	[ "$r" -lt 2 ] && return 0
	top=${FB[$id]["top"]}
	i=$((top + r - 2))
	[ "$i" -ge "${FB[$id]["n"]}" ] && return 0
	if [ "$i" = "${FB[$id]["sel"]}" ] && [ "$i" = "${FB[$id]["last"]}" ]; then
		fb_open "$id"
		return 0
	fi
	FB[$id]["sel"]=$i
	FB[$id]["last"]=$i
}

# The wheel moves the view and leaves the selection where it is, which is
# what a wheel does everywhere else.
files_wheel() {
	local top=${FB[$1]["top"]}

	case $2 in
	up) FB[$1]["top"]=$((top - 3)) ;;
	down) FB[$1]["top"]=$((top + 3)) ;;
	esac
	fb_clamp "$1"
}

# Run directly: list a directory and stop.
if [ -z "$DT_ROWS" ]; then
	d=${1:-$PWD}
	case $d in /*) ;; *) d="$PWD/$d" ;; esac
	[ -d "$d" ] || { echo "files: $d: not a directory" >&2; exit 1; }
	FB[0]["dir"]=$d
	fb_scan 0
	i=0
	while [ "$i" -lt "${FB[0]["n"]}" ]; do
		if [ "${FL[0][$i]["dir"]}" = 1 ]; then
			echo "${FL[0][$i]["name"]}/"
		else
			echo "${FL[0][$i]["name"]}"
		fi
		i=$((i + 1))
	done
fi
