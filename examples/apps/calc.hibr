#!/usr/bin/env hibr
#
# calc -- a calculator for the desktop, and a program on its own.
#
# Sourced by a session it is an app: the window manager finds calc_draw,
# calc_key and calc_click and calls those.  Run directly it evaluates its
# arguments and prints the answer, so it is useful without a desktop:
#
#     hibr examples/apps/calc.hibr '3 * (4 + 5)'
#
# It does no arithmetic of its own -- the shell has an evaluator and this
# hands the expression to it, which is why a calculator written in hibr is
# fifty lines rather than five hundred.  That also fixes what it can do:
# integers, like the shell and like bash.  There is no decimal point on the
# keypad because there would be nothing behind it.

app calc "A calculator"

# What the hibr menu shows, how big a new window is, and whether a second
# launch opens another window or brings this one forward.
command -v dt_app > /dev/null && dt_app calc "Calculator" 16 24 once "±" fixed

# Per window, not per app: two calculators must be able to hold two
# different sums.  Everything an app remembers goes under the window id it
# was handed, because a global is shared by every window of the same app.
declare -gA CA

# Four columns, five rows.  ^ inserts ** and c clears.
#
# An array, not a string: the keypad holds * and ( and ), and a `for k in
# $CALC_KEYS` would glob them into whatever files are in the current
# directory -- which it did, and the calculator drew a directory listing.
CALC_KEYS=(7 8 9 / 4 5 6 '*' 1 2 3 - 0 '(' ')' + c % '^' '=')
CALC_ROWS=5
CALC_COLS=4

# Evaluate the expression, or say why it will not.
#
# The characters are checked first, so a typed name cannot reach a shell
# variable: $(( PATH )) is a valid expression and not one a calculator should
# answer.  What survives that can still be malformed -- "2 +" is -- so the
# evaluation runs in a group with its diagnostic sent nowhere, and its status
# is what decides.
calc_eval() {
	local id=$1 v in

	in=${CA[$id]["in"]}

	[ -z "$in" ] && return 0
	CA[$id]["err"]=
	if ! match "$in" '^[0-9+*/%()<>|&^~ -]+$' > /dev/null; then
		CA[$id]["err"]="digits and operators"
		return 0
	fi
	if { v=$(( in )); } 2> /dev/null; then
		CA[$id]["out"]=$v
		CA[$id]["in"]=
	else
		CA[$id]["err"]="not an expression"
	fi
}

# Add to the expression, or act on a key that is not part of one.
calc_push() {
	local id=$1 k=$2

	case $k in
	=) calc_eval "$id" ;;
	c) CA[$id]["in"]=; CA[$id]["out"]=0; CA[$id]["err"]= ;;
	"^") CA[$id]["in"]="${CA[$id]["in"]}**"; CA[$id]["err"]= ;;
	backspace)
		CA[$id]["in"]="${CA[$id]["in"]%?}"
		CA[$id]["err"]=
		;;
	*) CA[$id]["in"]="${CA[$id]["in"]}$k"; CA[$id]["err"]= ;;
	esac
}

calc_open() {
	CA[$1]["in"]=
	CA[$1]["out"]=0
	CA[$1]["err"]=
}

# Where a key sits in the window body: five columns wide, two rows apart.
calc_pos() {
	ret "$((4 + ($1 / CALC_COLS) * 2)) $((2 + ($1 % CALC_COLS) * 5))"
}

# Which key is under a point in the body, if any.
calc_at() {
	local r=$(($1 - 4)) c=$(($2 - 2)) i

	[ "$r" -lt 0 ] || [ "$c" -lt 0 ] && return 1
	[ $((r % 2)) = 1 ] && return 1
	[ $((c % 5)) -gt 3 ] && return 1
	r=$((r / 2))
	c=$((c / 5))
	[ "$r" -ge "$CALC_ROWS" ] || [ "$c" -ge "$CALC_COLS" ] && return 1
	ret "${CALC_KEYS[$((r * CALC_COLS + c))]}"
}

calc_draw() {
	local id=$1 w=$3 k p i=0 t

	console pen "#a0aec0" "$DT_FACE"
	t := str pad "${CA[$id]["in"]:-expression}" $((w - 4))
	console put -p "w$id" 1 2 "$t"
	if [ -n "${CA[$id]["err"]}" ]; then
		console pen "#f56565" "$DT_FACE"
		t := str pad "${CA[$id]["err"]}" $((w - 4))
	else
		console pen "#68d391" "$DT_FACE" bold
		t := str pad "${CA[$id]["out"]}" $((w - 4))
	fi
	console put -p "w$id" 2 2 "$t"

	for k in "${CALC_KEYS[@]}"; do
		p := calc_pos "$i"
		case $k in
		=) console pen "#1a202c" "#68d391" bold ;;
		c) console pen "#1a202c" "#f56565" bold ;;
		[0-9]) console pen "$DT_INK" "#2d3748" ;;
		*) console pen "#f6ad55" "#2d3748" ;;
		esac
		console put -p "w$id" ${p% *} ${p#* } " $k  "
		i=$((i + 1))
	done
	console pen "#718096" "$DT_FACE"
	console put -p "w$id" 14 2 "integers only"
}

# The menus the bar shows while a calculator window has focus.
calc_menus() {
	dt_menu "Calc"
	dt_item "Evaluate" e calc_eval "$DT_FOCUS"
	dt_item "Clear" c calc_push "$DT_FOCUS" c
	dt_item "Backspace" b calc_push "$DT_FOCUS" backspace
	dt_sep
	dt_item "Use Answer" u calc_recall "$DT_FOCUS"
	dt_sep
	dt_item "Close" w dt_close_focused
}

# Right-click anywhere on the keypad: the same shortcuts as the Calc menu,
# without reaching for the menu bar first.
calc_context() {
	dt_menu "Calc"
	dt_item "Use Answer" u calc_recall "$1"
	dt_item "Copy" p dt_edit copy
	dt_sep
	dt_item "Clear" c calc_push "$1" c
}

# Put the answer back in the expression, which is what a calculator's memory
# is for and costs nothing to provide.
calc_recall() {
	CA[$1]["in"]="${CA[$1]["out"]}"
	CA[$1]["err"]=
}

# The answer is what a calculator has to copy.
calc_copy() {
	ret "${CA[$1]["out"]}"
}

# A paste keeps only what can be part of an expression.
calc_paste() {
	local t=${2//[^0-9+*\/%()<>|&^~ -]/}

	CA[$1]["in"]="${CA[$1]["in"]}$t"
	CA[$1]["err"]=
}

calc_key() {
	case $2 in
	[0-9] | + | - | "*" | / | % | "(" | ")") calc_push "$1" "$2" ;;
	= | enter) calc_eval "$1" ;;
	c) calc_push "$1" c ;;
	backspace) calc_push "$1" backspace ;;
	*) return 1 ;;
	esac
}

calc_click() {
	local k

	k := calc_at "$2" "$3" || return 0
	[ -n "$k" ] && calc_push "$1" "$k"
}

# Run directly: evaluate the arguments and print the answer.
if [ -z "$DT_ROWS" ] && [ $# -gt 0 ]; then
	CA[0]["in"]="$*"
	calc_eval 0
	if [ -n "${CA[0]["err"]}" ]; then
		echo "calc: ${CA[0]["err"]}" >&2
		exit 1
	fi
	echo "${CA[0]["out"]}"
fi
