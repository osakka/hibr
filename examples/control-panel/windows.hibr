#!/usr/bin/env hibr
#
# windows -- the Control Panel pane listing every open window; enter
# raises it, x closes it, - hides it, the same keys the pane picker's
# host already reserves for a "win" row.

command -v cp_pane > /dev/null && cp_pane windows "Windows" "▣"

windows_rows() {
	local w=$1 n=0 id ids

	ids := dt_ids
	for id in $ids; do
		CP[$w][$n]["kind"]=win
		CP[$w][$n]["text"] := dt_title "$id"
		if dt_hidden "$id"; then
			CP[$w][$n]["val"]=hidden
		else
			CP[$w][$n]["val"]=open
		fi
		CP[$w][$n]["key"]=$id
		n=$((n + 1))
	done
	ret "$n"
}
