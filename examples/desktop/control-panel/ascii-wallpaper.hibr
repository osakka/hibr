#!/usr/bin/env hibr
#
# ascii-wallpaper -- browse for an image, preview it as ASCII art, apply
# it as the desktop's wallpaper. #2's own explicit constraint was to
# reuse the file browser's own tooling for picking the image rather than
# building a new picker from scratch: fb_scan, fb_go and fb_path (all of
# files.hibr's own, keyed by window id so any window can use them, not
# just Files' own) do the actual directory scanning and path-building
# here, unchanged. Only the drawing is new -- files.hibr's own row
# layout is built for a whole bordered window, not a half-width strip
# inside a shared Control Panel body, so there was nothing there to
# reuse for that part.

# The name is "ASCII Art", not "ASCII Wallpaper" -- found the hard way:
# CP_LISTW's own fixed 17 columns fit every existing pane's title (the
# longest, Control Strip, is exactly 13 characters after its own icon
# and spacing), and "ASCII Wallpaper" (15) was the first to run over it,
# truncating to "ASCII Wallpape" in the picker's own list. Widening the
# sidebar for one entry would have meant re-spacing every other pane's
# own title in it; shortening this one instead did not.
command -v cp_pane > /dev/null && cp_pane ascii_wallpaper "ASCII Art" "▤"

declare -gA AW
AW_STARTDIR="${HOME:-/}"

ascii_wallpaper_open() {
	local id=$1

	FB[$id]["dir"]=$AW_STARTDIR
	FB[$id]["hidden"]=
	fb_scan "$id"
	AW[$id]["previewfor"]=
}

# .png only -- mods/img/README.md is direct about JPEG not being decoded
# yet, and showing a picker entry that fails the moment it is reached is
# worse than not offering it.
aw_isimage() {
	case $1 in
	*.[pP][nN][gG]) return 0 ;;
	esac
	return 1
}

# Decode the given file as a grayscale ASCII rendering into AW's own
# line array -- -g's own density ramp is plain text with no colour
# codes at all (it deliberately reads in whatever the terminal's own
# foreground already is), which is exactly what makes capturing it into
# an ordinary array and drawing it with a pen of this pane's own
# choosing possible, unlike img draw's own coloured cells.
aw_preview() {
	local id=$1 path=$2 pw=$3 ph=$4 out line n=0

	AW[$id]["previewfor"]=
	unset "AW[$id]["lines"]"
	dt_has img || need img > /dev/null 2>&1
	dt_has img || return 1
	out=$(img -g -w "$pw" -h "$ph" "$path" 2> /dev/null) || return 1
	while IFS= read -r line; do
		AW[$id]["lines"][$n]=$line
		n=$((n + 1))
	done <<< "$out"
	AW[$id]["linesn"]=$n
	AW[$id]["previewfor"]=$path
	return 0
}

# Reload the preview for whatever is selected now, or clear it -- called
# after anything that can move the selection: a directory change starts
# clear (nothing there yet makes sense to preview), a plain up/down only
# updates it when it actually lands on an image. Reads its own sizing
# from AW[$id], laid out fresh by _draw every frame before this could
# ever run from a key or a click.
aw_refresh() {
	local id=$1 sel path

	sel=${FB[$id]["sel"]}
	if [ "${FL[$id][$sel]["dir"]}" = 1 ]; then
		AW[$id]["previewfor"]=
		return 0
	fi
	path := fb_path "$id" "$sel"
	if aw_isimage "$path"; then
		aw_preview "$id" "$path" "${AW[$id]["prevw"]}" "${AW[$id]["prevh"]}"
	else
		AW[$id]["previewfor"]=
	fi
}

ascii_wallpaper_draw() {
	local id=$1 h=$2 w=$3 bx=$4
	local listw prevw prevx prevh vis applyrow i r n top sel t applyon

	listw=$(((w - 3) * 2 / 5))
	[ "$listw" -lt 16 ] && listw=16
	prevx=$((bx + listw + 2))
	prevw=$((w - listw - 3))
	prevh=$((h - 4))
	vis=$((h - 3))
	applyrow=$((h - 1))
	AW[$id]["listw"]=$listw
	AW[$id]["prevw"]=$prevw
	AW[$id]["prevx"]=$prevx
	AW[$id]["prevh"]=$prevh
	AW[$id]["vis"]=$vis
	AW[$id]["applyrow"]=$applyrow

	if [ -z "${FB[$id]["dir"]}" ]; then
		ascii_wallpaper_open "$id"
		aw_refresh "$id"
	fi

	console pen "$DT_IDLE" "$DT_FACE"
	r=1
	while [ "$r" -le "$h" ]; do
		console put -p "w$id" "$r" $((bx + listw + 1)) "│"
		r=$((r + 1))
	done

	console pen "#63b3ed" "$DT_FACE" bold
	t=${FB[$id]["dir"]}
	[ ${#t} -gt "$listw" ] && t="…${t: -$((listw - 1))}"
	t := str pad "$t" "$listw"
	console put -p "w$id" 1 "$bx" "$t"

	n=${FB[$id]["n"]}
	top=${FB[$id]["top"]}
	sel=${FB[$id]["sel"]}
	i=$top
	r=2
	while [ "$r" -le $((h - 2)) ]; do
		if [ "$i" -lt "$n" ]; then
			t=${FL[$id][$i]["name"]}
			[ "${FL[$id][$i]["dir"]}" = 1 ] && t="$t/"
			[ ${#t} -gt "$listw" ] && t="${t:0:$listw}"
			t := str pad "$t" "$listw"
		else
			t := str pad "" "$listw"
		fi
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			console pen "#1a202c" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" "$bx" "$t"
		i=$((i + 1))
		r=$((r + 1))
	done
	console pen "$DT_IDLE" "$DT_FACE"
	t="$((sel + 1)) of $n"
	t := str pad "$t" "$listw"
	console put -p "w$id" $((h - 1)) "$bx" "$t"

	console pen "$DT_INK" "$DT_FACE"
	if [ -n "${AW[$id]["previewfor"]}" ]; then
		n=${AW[$id]["linesn"]}
		i=0
		r=1
		while [ "$r" -le "$prevh" ]; do
			t=""
			[ "$i" -lt "$n" ] && t=${AW[$id]["lines"][$i]}
			t := str pad "$t" "$prevw"
			console put -p "w$id" "$r" "$prevx" "$t"
			i=$((i + 1))
			r=$((r + 1))
		done
		applyon=1
	else
		r=1
		while [ "$r" -le "$prevh" ]; do
			t := str pad "" "$prevw"
			console put -p "w$id" "$r" "$prevx" "$t"
			r=$((r + 1))
		done
		console pen "$DT_IDLE" "$DT_FACE"
		t="Select a .png"
		[ ${#t} -gt "$prevw" ] && t="${t:0:$prevw}"
		console put -p "w$id" 1 "$prevx" "$t"
		applyon=0
	fi

	if [ "$applyon" = 1 ]; then
		console pen "$DT_FACE" "$DT_ACTIVE" bold
	else
		console pen "$DT_IDLE" "$DT_FACE"
	fi
	console put -p "w$id" "$applyrow" "$prevx" " Apply as Wallpaper "
	console pen "$DT_INK" "$DT_FACE"
}

ascii_wallpaper_key() {
	local id=$1 n vis top sel

	n=${FB[$id]["n"]}
	sel=${FB[$id]["sel"]}
	top=${FB[$id]["top"]}
	case $2 in
	up) sel=$((sel - 1)) ;;
	down) sel=$((sel + 1)) ;;
	backspace)
		fb_go "$id" ..
		aw_refresh "$id"
		return 0
		;;
	enter)
		if [ "${FL[$id][$sel]["dir"]}" = 1 ]; then
			fb_go "$id" "${FL[$id][$sel]["name"]}"
			aw_refresh "$id"
		else
			aw_apply "$id"
		fi
		return 0
		;;
	*) return 1 ;;
	esac
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	FB[$id]["sel"]=$sel
	vis=${AW[$id]["vis"]}
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	FB[$id]["top"]=$top
	aw_refresh "$id"
	return 0
}

# Set the currently previewed file as the wallpaper -- shared by a click
# on the button and enter on an already-previewed file, so there is a
# keyboard way to finish this, not only a mouse one.
aw_apply() {
	local id=$1

	[ -n "${AW[$id]["previewfor"]}" ] || return 0
	DT_WALLIMG=${AW[$id]["previewfor"]}
	DT_WALLASCII=1
	command -v dt_save > /dev/null && dt_save
	command -v dt_note > /dev/null && dt_note "Wallpaper set"
}

ascii_wallpaper_click() {
	local id=$1 r=$2 c=$3
	local listw=${AW[$id]["listw"]} n i

	if [ "$r" = "${AW[$id]["applyrow"]}" ] &&
	   [ "$c" -ge "${AW[$id]["prevx"]}" ]; then
		aw_apply "$id"
		return 0
	fi
	[ "$c" -lt "$listw" ] || return 0
	[ "$r" -lt 2 ] && return 0
	n=${FB[$id]["n"]}
	i=$((FB[$id]["top"] + r - 2))
	[ "$i" -ge "$n" ] && return 0
	FB[$id]["sel"]=$i
	aw_refresh "$id"
}
