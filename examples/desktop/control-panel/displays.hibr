#!/usr/bin/env hibr
#
# displays -- Control Panel's own picture of a multi-monitor arrangement:
# a dropdown to choose which display is primary, and every attached
# display drawn to scale below it from hold clients, dragged to
# reposition (hold move on release) or switched off with the x in its
# own top-right corner (hold drop). The primary display is the picture's
# own anchor -- every rectangle is positioned relative to it, so
# switching which one is primary, or dragging a *different* display,
# never moves where the primary itself draws -- but its own rectangle is
# not otherwise interactive: the dropdown is the one reliable way to
# change it, since a mouse click precise enough to land on a specific
# terminal cell with *no* movement at all is not something to depend on,
# over ssh least of all. Nothing else is kept that a fresh read of hold
# clients cannot recompute -- the same as every other pane's row list is
# rebuilt every frame -- except the drag itself, which is this window's
# own gesture in progress and belongs nowhere else, and is frozen against
# hold clients while it is happening: re-reading mid-drag would have the
# dragged rectangle's own base position shift under the live preview the
# moment the release this same drag ends in reaches the server.
command -v cp_pane > /dev/null && cp_pane displays "Displays" "▦"

declare -gA DPY

# This session's own name, or empty when there is none to show a picture
# of -- not held, or held but the hold module is not to be had.
displays_sess() {
	[ -n "$HIBR_HOLD" ] && need hold && dt_holdsess
}

# One scale, in percent, applied to both axes: since a real display and
# this pane's own canvas are both measured in the same unit -- terminal
# cells -- a single uniform scale keeps a display's own proportions,
# where a separate row-scale and column-scale would stretch it. Rounding
# down and flooring at 1% keeps every display at least a sliver rather
# than vanishing at zero width.
displays_scale() {
	local h=$1 w=$2 urows=$3 ucols=$4 s sc

	s=$((h * 100 / urows))
	sc=$((w * 100 / ucols))
	[ "$sc" -lt "$s" ] && s=$sc
	[ "$s" -lt 1 ] && s=1
	ret "$s"
}

# The dropdown's own callback: choosing a name makes it primary.
displays_setprimary() {
	local id=$1 value=$2 sess

	sess := displays_sess
	[ -n "$sess" ] && hold primary "$sess" "$value"
}

displays_draw() {
	local id=$1 h=$2 w=$3 bx=$4
	local sess lst nm row col rows cols pri i n s dropw pname
	local br bc bh bw namew t r mr mc dragi prow pcol
	local rr rc minr minc urows ucols

	dt_wclear "$id"
	sess := displays_sess
	if [ -z "$sess" ]; then
		console pen "$DT_IDLE" "$DT_FACE"
		t="Not held -- nothing to arrange"
		[ "${#t}" -gt "$w" ] && t=${t:0:$w}
		console put -p "w$id" 1 "$bx" "$t"
		DPY[$id]["n"]=0
		return 0
	fi

	console pen "$DT_INK" "$DT_FACE"
	r=1
	while [ "$r" -le "$h" ]; do
		t := str repeat " " "$w"
		console put -p "w$id" "$r" "$bx" "$t"
		r=$((r + 1))
	done

	dragi=${DPY[$id]["drag"]}
	if [ -z "$dragi" ]; then
		# Not mid-drag: read fresh, same as every other pane's row list
		# is rebuilt every frame. Mid-drag, deliberately not -- see the
		# header.
		lst := hold clients "$sess"
		i=0
		while IFS=' ' read -r nm row col rows cols pri; do
			[ -z "$nm" ] && continue
			DPY[$id][$i]["name"]=$nm
			DPY[$id][$i]["row"]=$row
			DPY[$id][$i]["col"]=$col
			DPY[$id][$i]["rows"]=$rows
			DPY[$id][$i]["cols"]=$cols
			DPY[$id][$i]["primary"]=$pri
			i=$((i + 1))
		done <<< "$lst"
		DPY[$id]["n"]=$i
	fi
	n=${DPY[$id]["n"]:-0}
	[ "$n" -lt 1 ] && return 0

	# The primary's own real row/col and name -- everything else draws
	# relative to it -- read from whatever is currently stored, a fresh
	# read just above or, mid-drag, exactly what the last one before
	# this drag started left there.
	prow=0
	pcol=0
	pname=
	i=0
	while [ "$i" -lt "$n" ]; do
		if [ "${DPY[$id][$i]["primary"]}" = 1 ]; then
			prow=${DPY[$id][$i]["row"]}
			pcol=${DPY[$id][$i]["col"]}
			pname=${DPY[$id][$i]["name"]}
		fi
		i=$((i + 1))
	done

	dropw=$((w - 4))
	[ "$dropw" -lt 12 ] && dropw=12
	console pen "$DT_INK" "$DT_FACE"
	t="Primary:"
	console put -p "w$id" 1 "$bx" "$t"
	dt_wdrop "$id" 2 "$bx" "$dropw" "$pname" primary

	# Every display's own row/col relative to the primary's, which can
	# be negative (a display positioned "before" the primary in hold's
	# own absolute coordinates -- exactly what happens the moment the
	# primary picked is not the leftmost one). minr/minc, never above 0,
	# so the primary itself is always included in the box, shift the
	# whole picture just enough that nothing draws to the left of or
	# above this canvas's own top-left corner -- into the pane list, or
	# under the dropdown just drawn -- rather than clamping each display
	# to the same corner independently, which would draw two of them on
	# top of each other instead.
	urows=0
	ucols=0
	minr=0
	minc=0
	i=0
	while [ "$i" -lt "$n" ]; do
		rr=$((${DPY[$id][$i]["row"]} - prow))
		rc=$((${DPY[$id][$i]["col"]} - pcol))
		DPY[$id][$i]["rr"]=$rr
		DPY[$id][$i]["rc"]=$rc
		[ "$rr" -lt "$minr" ] && minr=$rr
		[ "$rc" -lt "$minc" ] && minc=$rc
		i=$((i + 1))
	done
	i=0
	while [ "$i" -lt "$n" ]; do
		rr=$((${DPY[$id][$i]["rr"]} - minr))
		rc=$((${DPY[$id][$i]["rc"]} - minc))
		rows=${DPY[$id][$i]["rows"]}
		cols=${DPY[$id][$i]["cols"]}
		[ $((rr + rows)) -gt "$urows" ] && urows=$((rr + rows))
		[ $((rc + cols)) -gt "$ucols" ] && ucols=$((rc + cols))
		i=$((i + 1))
	done
	[ "$urows" -lt 1 ] && urows=1
	[ "$ucols" -lt 1 ] && ucols=1
	s := displays_scale $((h - 2)) "$w" "$urows" "$ucols"
	DPY[$id]["s"]=$s

	i=0
	while [ "$i" -lt "$n" ]; do
		rr=$((${DPY[$id][$i]["rr"]} - minr))
		rc=$((${DPY[$id][$i]["rc"]} - minc))
		rows=${DPY[$id][$i]["rows"]}
		cols=${DPY[$id][$i]["cols"]}
		nm=${DPY[$id][$i]["name"]}
		pri=${DPY[$id][$i]["primary"]}
		br=$((rr * s / 100 + 3))
		bc=$((rc * s / 100 + bx))
		# One cell shaved off each box's own scaled size, a gap between
		# two adjacent displays rather than their borders sharing (and
		# fighting over) the same cell: real displays touch exactly at
		# hold clients's own coordinates -- 0,0 and 0,80 for two 80-wide
		# screens side by side -- and the uniform scale preserves that
		# exactly, so without this a display's own right border is drawn
		# over by its neighbour's left one, whichever is drawn second.
		bh=$((rows * s / 100 - 1))
		bw=$((cols * s / 100 - 1))
		[ "$bh" -lt 2 ] && bh=2
		[ "$bw" -lt 4 ] && bw=4
		if [ "$i" = "$dragi" ]; then
			mr=${DPY[$id]["mr"]:-0}
			mc=${DPY[$id]["mc"]:-0}
			br=$((br + mr))
			bc=$((bc + mc))
		fi
		DPY[$id][$i]["br"]=$br
		DPY[$id][$i]["bc"]=$bc
		DPY[$id][$i]["bh"]=$bh
		DPY[$id][$i]["bw"]=$bw
		DPY[$id][$i]["xr"]=$br
		DPY[$id][$i]["xc"]=$((bc + bw - 1))

		if [ "$pri" = 1 ]; then
			console pen "$DT_ACTIVE" "$DT_FACE" bold
		else
			console pen "$DT_IDLE" "$DT_FACE"
		fi
		t := dt_rep $((bw - 1)) "─"
		console put -p "w$id" "$br" "$bc" "┌${t}x"
		r=1
		while [ "$r" -lt $((bh - 1)) ]; do
			console put -p "w$id" $((br + r)) "$bc" "│"
			console put -p "w$id" $((br + r)) $((bc + bw - 1)) "│"
			r=$((r + 1))
		done
		t := dt_rep $((bw - 2)) "─"
		console put -p "w$id" $((br + bh - 1)) "$bc" "└${t}┘"
		namew=$((bw - 2))
		[ "$namew" -lt 1 ] && namew=1
		t=$nm
		[ "${#t}" -gt "$namew" ] && t=${t:0:$namew}
		console pen "$DT_INK" "$DT_FACE"
		console put -p "w$id" $((br + bh / 2)) $((bc + 1)) "$t"
		i=$((i + 1))
	done
}

# Press: on the dropdown, open its own popup of every attached display's
# name; on the x in a rectangle's own corner (its own cell, plus its
# left neighbour -- one cell alone is not a reachable target for a real
# pointer), switch that display off on the spot; inside a rectangle that
# is not the primary one, otherwise start dragging it. The primary's own
# rectangle is not draggable -- it is the picture's own fixed anchor,
# and the dropdown above is the one way to change which display that is.
# Neither hit declines the press (returns 1) so panel_mouse still offers
# panel_click a plain row-list click elsewhere in the pane.
displays_mouse() {
	local id=$1 act=$2 button=$3 r=$4 c=$5
	local n i sess nm mr mc s row col nrow ncol xc amr amc tag wc vals

	n=${DPY[$id]["n"]:-0}
	if [ "$act" = press ]; then
		tag := dt_hit "$id" "$r" "$c"
		if [ "$tag" = primary ]; then
			wc := dt_wcol "$id" "$r" primary
			vals=()
			i=0
			while [ "$i" -lt "$n" ]; do
				vals+=("${DPY[$id][$i]["name"]}")
				i=$((i + 1))
			done
			dt_droplist "$id" "$r" "$wc" displays_setprimary "${vals[@]}"
			return 0
		fi
		i=0
		while [ "$i" -lt "$n" ]; do
			xc=${DPY[$id][$i]["xc"]}
			if [ "$r" = "${DPY[$id][$i]["xr"]}" ] &&
			   [ "$c" -ge $((xc - 1)) ] && [ "$c" -le "$xc" ]; then
				sess := displays_sess
				hold drop "$sess" "${DPY[$id][$i]["name"]}"
				return 0
			fi
			i=$((i + 1))
		done
		i=0
		while [ "$i" -lt "$n" ]; do
			if [ "${DPY[$id][$i]["primary"]}" != 1 ] &&
			   [ "$r" -ge "${DPY[$id][$i]["br"]}" ] &&
			   [ "$r" -lt $((${DPY[$id][$i]["br"]} + ${DPY[$id][$i]["bh"]})) ] &&
			   [ "$c" -ge "${DPY[$id][$i]["bc"]}" ] &&
			   [ "$c" -lt $((${DPY[$id][$i]["bc"]} + ${DPY[$id][$i]["bw"]})) ]; then
				DPY[$id]["drag"]=$i
				DPY[$id]["pr"]=$r
				DPY[$id]["pc"]=$c
				DPY[$id]["mr"]=0
				DPY[$id]["mc"]=0
				return 0
			fi
			i=$((i + 1))
		done
		return 1
	fi

	i=${DPY[$id]["drag"]}
	[ -z "$i" ] && return 1
	mr=$((r - ${DPY[$id]["pr"]}))
	mc=$((c - ${DPY[$id]["pc"]}))
	DPY[$id]["mr"]=$mr
	DPY[$id]["mc"]=$mc
	if [ "$act" = release ]; then
		amr=$mr; [ "$amr" -lt 0 ] && amr=$((0 - amr))
		amc=$mc; [ "$amc" -lt 0 ] && amc=$((0 - amc))
		if [ "$amr" -gt 1 ] || [ "$amc" -gt 1 ]; then
			# A one-cell jitter under a real mouse, over ssh especially,
			# is not a real intent to move it -- anything past that is.
			sess := displays_sess
			nm=${DPY[$id][$i]["name"]}
			s=${DPY[$id]["s"]}
			row=${DPY[$id][$i]["row"]}
			col=${DPY[$id][$i]["col"]}
			nrow=$((row + mr * 100 / s))
			ncol=$((col + mc * 100 / s))
			[ "$nrow" -lt 0 ] && nrow=0
			[ "$ncol" -lt 0 ] && ncol=0
			hold move "$sess" "$nm" "$nrow" "$ncol"
		fi
		DPY[$id]["drag"]=
		DPY[$id]["mr"]=0
		DPY[$id]["mc"]=0
	fi
	return 0
}
