#!/usr/bin/env hibr
#
# appearance -- the Control Panel pane for how the desktop looks: the
# theme, the wallpaper (a glyph, or an image chosen in a picker of its own),
# the menu bar's spacing and notification icon, and the four shadows. The
# theme sets the variables the window manager already reads every frame, so
# a change shows on the next one, in every window at once.

command -v cp_pane > /dev/null && cp_pane appearance "Appearance" "◐"

CP_THEME=midnight
command -v dt_keep > /dev/null && dt_keep CP_THEME
CP_THEMES=(midnight slate forest ember paper dracula black neon phosphor amber)
CP_GLYPHS=("·" "░" "▒" "⋅" "+")

# wall, dot, bar, active, idle, face, ink, shadow -- shadow is console
# darken's own pct: how much of a shadow's own colour survives once it is
# darkened. 55 (its builtin default) is a soft, barely-there shadow against
# a dark face, since scaling an already-low RGB value down by 45% is a
# small absolute change; every theme here but paper has a dark face and
# keeps it. Paper's face is close to white, where the same 45% cut lands
# on a flat medium grey -- a hard block, not a shadow -- so it gets a much
# smaller cut instead, chosen by rendering a menu at a few candidates and
# comparing them to how subtle midnight's own shadow reads, not by eye
# against paper alone. Black's shadows cannot show at all -- nothing
# darkens black -- which is the look it is for; phosphor and amber are one
# hue throughout, as the monitors were.
fn cp_theme(t) {
	case $t in
	midnight) set -- "#0d1b2a" "#16324a" "#1b3a5c" "#63b3ed" "#4a5568" \
		"#101820" "#cbd5e0" 55 ;;
	slate)    set -- "#1a202c" "#2d3748" "#2d3748" "#90cdf4" "#4a5568" \
		"#171923" "#e2e8f0" 55 ;;
	forest)   set -- "#0b1f16" "#14342a" "#14432f" "#68d391" "#3f5e51" \
		"#0d1f18" "#d7e8de" 55 ;;
	ember)    set -- "#1f1410" "#3a241c" "#4a2c1e" "#f6ad55" "#6b4a3a" \
		"#1a110d" "#ecd9c6" 55 ;;
	paper)    set -- "#e8e4da" "#d3cec1" "#c3bdae" "#2b6cb0" "#8a8578" \
		"#f5f2ea" "#2d3748" 90 ;;
	dracula)  set -- "#282a36" "#383a4c" "#44475a" "#bd93f9" "#6272a4" \
		"#21222c" "#f8f8f2" 55 ;;
	black)    set -- "#000000" "#121212" "#0a0a0a" "#7aa2f7" "#3a3a3a" \
		"#0a0a0a" "#c8c8c8" 55 ;;
	neon)     set -- "#0d0221" "#2a0a4a" "#1a0533" "#ff2bd6" "#3d2a6b" \
		"#120428" "#2de2e6" 55 ;;
	phosphor) set -- "#000a00" "#002a08" "#001a04" "#66ff66" "#0f4d1a" \
		"#000f02" "#33ff33" 55 ;;
	amber)    set -- "#0a0600" "#2a1a00" "#1a0f00" "#ffcc33" "#5a3d00" \
		"#0f0900" "#ffb000" 55 ;;
	*) return 1 ;;
	esac
	CP_THEME=$t
	DT_WALL=$1
	DT_DOT=$2
	DT_BAR=$3
	DT_ACTIVE=$4
	DT_IDLE=$5
	DT_FACE=$6
	DT_INK=$7
	DT_SHADOW_PCT=$8
	command -v console > /dev/null && console darkdefault "$DT_INK" "$DT_FACE"
}

# Picking a glyph is choosing the plain wallpaper over a real image, the
# same as picking one theme is choosing it over another -- so it clears
# DT_WALLIMG rather than leaving it set underneath a glyph that would never
# actually show while an image wins in dt_wall.
fn cp_set_theme(id, value) { cp_theme "$value" && cp_save; }
fn cp_set_glyph(id = "", value = "") { DT_GLYPH=$value; DT_WALLIMG=; cp_save; }

fn appearance_rows(w) {
	local n=0 g

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Theme"
	CP[$w][$n]["val"]="$CP_THEME"; CP[$w][$n]["key"]=theme; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Wallpaper"
	if [ -n "$DT_WALLIMG" ]; then
		CP[$w][$n]["val"]="(image)"
	else
		CP[$w][$n]["val"]="$DT_GLYPH"
	fi
	CP[$w][$n]["key"]=glyph; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Wallpaper Image…"
	CP[$w][$n]["val"]="${DT_WALLIMG##*/}"; CP[$w][$n]["key"]=wallimg
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Wallpaper Mode"
	CP[$w][$n]["val"]="$DT_WALLMODE"; CP[$w][$n]["key"]=wallmode
	n=$((n + 1))
	CP[$w][$n]["kind"]=set
	CP[$w][$n]["text"]="Menu Bar Spacing (${DT_BARGAP:-2})"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=${DT_BARGAP:-2}; CP[$w][$n]["min"]=1; CP[$w][$n]["max"]=4
	CP[$w][$n]["key"]=bargap; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Notification Icon"
	g := dt_bellglyph "$DT_BELLICON"
	CP[$w][$n]["val"]="$g $DT_BELLICON"; CP[$w][$n]["key"]=bellicon
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Shadows"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Windows"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_SHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menus"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_MSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_MSHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_BARSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_BARSHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Buttons"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_BTNSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_BTNSHADOW; n=$((n + 1))
	ret "$n"
}

fn appearance_do(w, k, dir) {
	local v

	case $k in
	theme) v := cp_next "$CP_THEME" "$dir" "${CP_THEMES[@]}"
	       cp_theme "$v" ;;
	glyph) v := cp_next "$DT_GLYPH" "$dir" "${CP_GLYPHS[@]}"
	       DT_GLYPH=$v; DT_WALLIMG= ;;
	bellicon)
		v := cp_next "$DT_BELLICON" "$dir" "${DT_BELLICONS[@]}"
		DT_BELLICON=$v
		;;
	bargap)
		v=$((${DT_BARGAP:-2} + dir))
		[ "$v" -lt 1 ] && v=1
		[ "$v" -gt 4 ] && v=4
		DT_BARGAP=$v
		;;
	wallimg) wp_dialog; return 0 ;;
	wallmode) v := cp_next "$DT_WALLMODE" "$dir" "${WP_MODES[@]}"
		DT_WALLMODE=$v ;;
	DT_SHADOW | DT_MSHADOW | DT_BARSHADOW | DT_BTNSHADOW) cp_toggle "$k" ;;
	esac
	cp_save
}

fn appearance_drop(w, r, c, k) {
	case $k in
	theme) dt_droplist "$w" "$r" "$c" cp_set_theme "${CP_THEMES[@]}" ;;
	glyph) dt_droplist "$w" "$r" "$c" cp_set_glyph "${CP_GLYPHS[@]}" ;;
	wallmode) dt_droplist "$w" "$r" "$c" wp_setmode "${WP_MODES[@]}" ;;
	bellicon)
		local -a vals
		local nm g
		for nm in "${DT_BELLICONS[@]}"; do
			g := dt_bellglyph "$nm"
			vals+=("$g $nm")
		done
		dt_droplist "$w" "$r" "$c" cp_set_bellicon "${vals[@]}"
		;;
	esac
}

# A choice from the icon list, shown as "glyph name": the name is kept.
fn cp_set_bellicon(id = "", value = "") { DT_BELLICON=${value##* }; cp_save; }
