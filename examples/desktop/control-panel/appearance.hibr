#!/usr/bin/env hibr
#
# appearance -- the Control Panel pane for how the desktop looks: the
# theme, the wallpaper (a glyph, or an image chosen in a picker of its own),
# the menu bar's spacing and notification icon, the shadows, and how dialog
# buttons look. The
# theme sets the variables the window manager already reads every frame, so
# a change shows on the next one, in every window at once.

strict

command -v cp_pane > /dev/null && cp_pane appearance "Appearance" "◐"

CP_THEME=midnight
command -v dt_keep > /dev/null && dt_keep CP_THEME
CP_GLYPHS=("·" "░" "▒" "⋅" "+")

# A theme is a JSON file, one to a theme, named for it: seven colours --
# wall, dot, bar, active, idle, face, ink -- seven optional roles -- dim,
# selink, good, warn, bad, info, well, each defaulting to the value the
# dark themes share (CP_THDEF) -- and shadow, console darken's
# own pct, how much of a colour survives once it is darkened. 55 is a soft
# shadow on a dark face; a light face needs much less of a cut, which is
# why paper's is 90. JSON and not a script, because a theme is only data
# and is the thing people pass around: a file someone else wrote can set
# colours and nothing else (docs/adr/0028). The person's own folder is
# searched first, so a file there replaces the bundled one of that name.
CP_THEMEDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/themes"
	"${BASH_SOURCE%/*}/../themes")
CP_THEMES=()
declare -gA CP_TH
CP_THKEYS=(wall dot bar active idle face ink)
CP_THROLES=(dim selink good warn bad info well)
declare -gA CP_THDEF
CP_THDEF["dim"]="#718096"; CP_THDEF["selink"]="#1a202c"
CP_THDEF["good"]="#68d391"; CP_THDEF["warn"]="#f6ad55"
CP_THDEF["bad"]="#f56565"; CP_THDEF["info"]="#4fd1c5"
CP_THDEF["well"]="#2d3748"

# Read one theme file into CP_TH[name], or refuse it whole: every colour
# must be #rrggbb and the shadow a number from 1 to 100, so a broken file
# is left out of the list rather than half applied.
fn cp_themeread(n, f) {
	local j k v

	json parse j < "$f" 2> /dev/null || return 1
	for k in "${CP_THKEYS[@]}"; do
		v=${j["$k"]}
		v=${v#\#}
		[ "${j["$k"]}" = "#$v" ] && [ ${#v} -eq 6 ] &&
			[ -z "${v//[0-9a-fA-F]/}" ] || return 1
	done
	for k in "${CP_THROLES[@]}"; do
		[ -n "${j["$k"]+x}" ] || continue
		v=${j["$k"]}
		v=${v#\#}
		[ "${j["$k"]}" = "#$v" ] && [ ${#v} -eq 6 ] &&
			[ -z "${v//[0-9a-fA-F]/}" ] || return 1
	done
	v=${j["shadow"]-55}
	case $v in '' | *[!0-9]*) return 1 ;; esac
	[ ${#v} -le 3 ] && [ "$v" -ge 1 ] && [ "$v" -le 100 ] || return 1
	for k in "${CP_THKEYS[@]}"; do
		CP_TH["$n"]["$k"]=${j["$k"]}
	done
	for k in "${CP_THROLES[@]}"; do
		CP_TH["$n"]["$k"]=${j["$k"]-${CP_THDEF["$k"]}}
	done
	CP_TH["$n"]["shadow"]=$v
}

# Every theme in CP_THEMEDIRS, the first of each name winning, sorted.
fn cp_themes() {
	local d f n

	CP_THEMES=()
	for d in "${CP_THEMEDIRS[@]}"; do
		for f in "$d"/*.json; do
			[ -r "$f" ] || continue
			n=${f##*/}
			n=${n%.json}
			[ -n "${CP_TH["$n"]["wall"]+x}" ] && continue
			cp_themeread "$n" "$f" && CP_THEMES+=("$n")
		done
	done
	arr sort CP_THEMES
}
cp_themes

fn cp_theme(t) {
	[ -n "${CP_TH["$t"]["wall"]+x}" ] || return 1
	CP_THEME=$t
	DT_WALL=${CP_TH["$t"]["wall"]}
	DT_DOT=${CP_TH["$t"]["dot"]}
	DT_BAR=${CP_TH["$t"]["bar"]}
	DT_ACTIVE=${CP_TH["$t"]["active"]}
	DT_IDLE=${CP_TH["$t"]["idle"]}
	DT_FACE=${CP_TH["$t"]["face"]}
	DT_INK=${CP_TH["$t"]["ink"]}
	DT_SHADOW_PCT=${CP_TH["$t"]["shadow"]}
	DT_DIM=${CP_TH["$t"]["dim"]}
	DT_SELINK=${CP_TH["$t"]["selink"]}
	DT_GOOD=${CP_TH["$t"]["good"]}
	DT_WARN=${CP_TH["$t"]["warn"]}
	DT_BAD=${CP_TH["$t"]["bad"]}
	DT_INFO=${CP_TH["$t"]["info"]}
	DT_WELL=${CP_TH["$t"]["well"]}
	command -v console > /dev/null && console darkdefault "$DT_INK" "$DT_FACE"
}

# Picking a glyph is choosing the plain wallpaper over a real image, the
# same as picking one theme is choosing it over another -- so it clears
# DT_WALLIMG rather than leaving it set underneath a glyph that would never
# actually show while an image wins in dt_wall.
fn cp_set_theme(int id, value) { cp_theme "$value" && cp_save; }
fn cp_set_glyph(int? id = "", value = "") { DT_GLYPH=$value; DT_WALLIMG=; cp_save; }

fn appearance_rows(int w) {
	local n=0 g

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Theme"
	CP[$w][$n]["val"]="$CP_THEME"; CP[$w][$n]["key"]=theme; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Wallpaper"
	if [ -n "$DT_WALLIMG" ]; then
		CP[$w][$n]["val"]="(image)"
	else
		CP[$w][$n]["val"]="$DT_GLYPH"
	fi
	CP[$w][$n]["key"]=glyph; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Wallpaper Image…"
	CP[$w][$n]["val"]="${DT_WALLIMG##*/}"; CP[$w][$n]["key"]=wallimg
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Wallpaper Mode"
	CP[$w][$n]["val"]="$DT_WALLMODE"; CP[$w][$n]["key"]=wallmode
	n=$((n + 1))
	CP[$w][$n]["kind"]=set
	CP[$w][$n]["text"]="Menu Bar Spacing (${DT_BARGAP:-2})"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=${DT_BARGAP:-2}; CP[$w][$n]["min"]=1; CP[$w][$n]["max"]=4
	CP[$w][$n]["key"]=bargap; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Notification Icon"
	g := dt_bellglyph "$DT_BELLICON"
	CP[$w][$n]["val"]="$g $DT_BELLICON"; CP[$w][$n]["key"]=bellicon
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Glyphs"
	CP[$w][$n]["val"]="$DT_GLYPHSET"; CP[$w][$n]["key"]=glyphset
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Shadows"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Windows"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_SHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menus"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_MSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_MSHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_BARSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_BARSHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Dialog Buttons"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Style"
	CP[$w][$n]["val"]="$DT_DLGBTN"; CP[$w][$n]["key"]=dlgbtn; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shadow"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_BTNSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_BTNSHADOW; n=$((n + 1))
	ret "$n"
}

fn appearance_do(int w, k, int dir) {
	local v

	case $k in
	theme) v := cp_next "$CP_THEME" "$dir" "${CP_THEMES[@]}"
	       cp_theme "$v" ;;
	glyph) v := cp_next "$DT_GLYPH" "$dir" "${CP_GLYPHS[@]}"
	       DT_GLYPH=$v; DT_WALLIMG= ;;
	bellicon)
		v := cp_next "$DT_BELLICON" "$dir" "${DT_BELLICONS[@]}"
		DT_BELLICON=$v
		;;
	bargap)
		v=$((${DT_BARGAP:-2} + dir))
		[ "$v" -lt 1 ] && v=1
		[ "$v" -gt 4 ] && v=4
		DT_BARGAP=$v
		;;
	wallimg) wp_dialog; return 0 ;;
	wallmode) v := cp_next "$DT_WALLMODE" "$dir" "${WP_MODES[@]}"
		DT_WALLMODE=$v ;;
	glyphset) v := cp_next "$DT_GLYPHSET" "$dir" "${DT_GLYPHSETS[@]}"
		cp_set_glyphset "" "$v"; return 0 ;;
	dlgbtn) v := cp_next "$DT_DLGBTN" "$dir" "${DT_DLGBTNS[@]}"
		DT_DLGBTN=$v ;;
	DT_SHADOW | DT_MSHADOW | DT_BARSHADOW | DT_BTNSHADOW) cp_toggle "$k" ;;
	esac
	cp_save
}

fn appearance_drop(int w, int r, int c, k) {
	case $k in
	theme) dt_droplist "$w" "$r" "$c" cp_set_theme "${CP_THEMES[@]}" ;;
	glyph) dt_droplist "$w" "$r" "$c" cp_set_glyph "${CP_GLYPHS[@]}" ;;
	wallmode) dt_droplist "$w" "$r" "$c" wp_setmode "${WP_MODES[@]}" ;;
	glyphset) dt_droplist "$w" "$r" "$c" cp_set_glyphset "${DT_GLYPHSETS[@]}" ;;
	dlgbtn) dt_droplist "$w" "$r" "$c" cp_set_dlgbtn "${DT_DLGBTNS[@]}" ;;
	bellicon)
		local -a vals
		local nm g
		for nm in "${DT_BELLICONS[@]}"; do
			g := dt_bellglyph "$nm"
			vals+=("$g $nm")
		done
		dt_droplist "$w" "$r" "$c" cp_set_bellicon "${vals[@]}"
		;;
	esac
}

fn cp_set_dlgbtn(int? id = "", value = "") { DT_DLGBTN=$value; cp_save; }
# The glyph set takes effect at once: every name in GL, and the frames.
fn cp_set_glyphset(int? id = "", value = "") {
	DT_GLYPHSET=$value
	dt_glyphs "$value"
	cp_save
}

# A choice from the icon list, shown as "glyph name": the name is kept.
fn cp_set_bellicon(int? id = "", value = "") { DT_BELLICON=${value##* }; cp_save; }
