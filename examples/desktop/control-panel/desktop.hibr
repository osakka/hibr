#!/usr/bin/env hibr
#
# desktop -- the Control Panel pane for the bare desktop: which icons sit
# on it, how many workspaces it has, whether Cycle goes through this one's
# windows or every one's, and how often a busy screen is redrawn.

strict

command -v cp_pane > /dev/null && cp_pane desktop "Desktop" "▣"

DK_CYCLES=(workspace all)

fn cp_set_cycle(int? id = "", value = "") { DT_CYCLE=$value; cp_save; }

fn desktop_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icons"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_ICONS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_ICONS; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Disk Icons"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_DISKS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_DISKS; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Workspaces ($DT_WSN)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$DT_WSN; CP[$w][$n]["min"]=1; CP[$w][$n]["max"]=9
	CP[$w][$n]["key"]=wsn; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Cycle Windows On"
	CP[$w][$n]["val"]="$DT_CYCLE"; CP[$w][$n]["key"]=cycle
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Redraw Skip ($DT_DRAWSKIP)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$DT_DRAWSKIP; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=9
	CP[$w][$n]["key"]=drawskip; n=$((n + 1))
	ret "$n"
}

fn desktop_do(int w, k, int dir) {
	local v

	case $k in
	DT_ICONS | DT_DISKS)
		cp_toggle "$k"
		command -v dt_deskscan > /dev/null && dt_deskscan
		;;
	wsn) dt_wsset $((DT_WSN + dir)) ;;
	cycle) v := cp_next "$DT_CYCLE" "$dir" "${DK_CYCLES[@]}"
		DT_CYCLE=$v ;;
	drawskip)
		v=$((DT_DRAWSKIP + dir))
		[ "$v" -lt 0 ] && v=0
		[ "$v" -gt 9 ] && v=9
		DT_DRAWSKIP=$v
		;;
	esac
	cp_save
}

fn desktop_drop(int w, int r, int c, k) {
	case $k in
	cycle) dt_droplist "$w" "$r" "$c" cp_set_cycle "${DK_CYCLES[@]}" ;;
	esac
}
