#!/usr/bin/env hibr
#
# notifications -- the Control Panel pane for the corner-stacked notes
# dt_note/dt_notify draw, and the read-only history behind them.
#
# The pane's own id is "notify", not "notifications" -- the hidden app
# that opens the history window (apps/notifications.hibr) is already
# "notifications", and dt_new looks up its lifecycle hooks purely by
# name (<id>_draw, <id>_open, <id>_drop...); sharing one id between a
# pane and a window would make this pane's own dropdown handler,
# <id>_drop, answer to dt_new's drag-and-drop hook for that window
# instead -- same trap as ft_open once was, from the other direction.
# wallpaper.hibr's own pane id (wallpick, not wallpaper) is this same
# choice made before.

command -v cp_pane > /dev/null && cp_pane notify "Notifications" "◉"

CP_NOTEPOS=(top-right top-left bottom-right bottom-left)
CP_NOTETICKS=(1000 1500 2500 4000 6000 10000)

cp_set_notepos() { DT_NOTEPOS=$2; cp_save; }
cp_set_notems() { DT_NOTEMS=$2; cp_save; }

# Empties the in-memory-only history log -- what is currently stacked and
# showing is untouched, since that lives in DT_NOTEQ, a separate array.
cp_clearhist() {
	local hid

	dt_note "History cleared"
	for hid in "${DT_NOTEHIST_ORDER[@]}"; do
		unset "DT_NOTEHIST[$hid]"
	done
	DT_NOTEHIST_ORDER=()
	DT_NOTEUNSEEN=0
}

notify_rows() {
	local w=$1 n=0

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Position"
	CP[$w][$n]["val"]="$DT_NOTEPOS"; CP[$w][$n]["key"]=notepos
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Timeout"
	CP[$w][$n]["val"]="$DT_NOTEMS ms"; CP[$w][$n]["key"]=notems
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="View History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=history
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Clear History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=clearhist
	n=$((n + 1))
	ret "$n"
}

notify_do() {
	local w=$1 k=$2 dir=$3 v

	case $k in
	notepos) v := cp_next "$DT_NOTEPOS" "$dir" "${CP_NOTEPOS[@]}"
	         DT_NOTEPOS=$v ;;
	notems) v := cp_next "$DT_NOTEMS" "$dir" "${CP_NOTETICKS[@]}"
	        DT_NOTEMS=$v ;;
	history) dt_has notifications_draw && dt_launch notifications ;;
	clearhist) cp_clearhist ;;
	esac
	cp_save
}

notify_drop() {
	local w=$1 r=$2 c=$3 k=$4

	case $k in
	notepos) dt_droplist "$w" "$r" "$c" cp_set_notepos "${CP_NOTEPOS[@]}" ;;
	notems) dt_droplist "$w" "$r" "$c" cp_set_notems "${CP_NOTETICKS[@]}" ;;
	esac
}
