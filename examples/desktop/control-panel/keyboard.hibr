#!/usr/bin/env hibr
#
# keyboard -- the Control Panel pane for the keyboard itself: whether a
# terminal window gives the desktop its chord shortcuts back, and the keys
# the desktop always keeps, so they are written down somewhere a person
# looks. The shortcuts themselves are the Shortcuts pane's.

strict

command -v cp_pane > /dev/null && cp_pane keyboard "Keyboard" "⌨" hardware

fn keyboard_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Desktop Shortcuts Win"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TERMKEEP" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TERMKEEP; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Always the desktop's"
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="  F10, escape: the menu bar"
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="  alt-c, alt-x, alt-v: copy, cut, paste"
	n=$((n + 1))
	ret "$n"
}

fn keyboard_do(int w, k, int dir) {
	case $k in
	DT_TERMKEEP) cp_toggle "$k" ;;
	esac
	cp_save
}
