#!/usr/bin/env hibr
#
# keyboard -- the Control Panel pane for how keys reach a terminal window:
# whether the desktop's shortcuts work while a terminal has focus, and
# whether ctrl with a letter always goes to the program inside. Which key
# does what is the Shortcuts pane's, where every one can be changed.

strict

command -v cp_pane > /dev/null && cp_pane keyboard "Keyboard" "⌨" hardware

fn keyboard_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shortcuts in Terminals"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TERMKEEP" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TERMKEEP; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Terminals Keep Ctrl+A-Z"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TERMCTRL" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TERMCTRL; n=$((n + 1))
	ret "$n"
}

fn keyboard_do(int w, k, int dir) {
	case $k in
	DT_TERMKEEP | DT_TERMCTRL) cp_toggle "$k" ;;
	esac
	cp_save
}
