#!/usr/bin/env hibr
#
# tube -- the Control Panel pane for the YouTube app: how the picture is
# drawn, the quality YouTube's player is asked to fetch, and how many
# frames a second the window draws and how finely, both of which decide
# how much a terminal is sent; whether the next video plays by itself, and
# forgetting what was watched. Named tube, not youtube, because the app
# owns the youtube_ prefix.

strict

command -v cp_pane > /dev/null && cp_pane tube "YouTube" "▶" app

# follow is Control Panel > Pictures, which is the one setting meant to
# reach every picture the desktop draws; the rest say outright.
TB_MODES=(follow half ascii mono pixels)
TB_QUALITY=(tiny small medium large)
TB_FPS=(10 15 24 30)
TB_DETAIL=(0 1 2 3)

fn cp_set_ytmode(int? id = "", value = "") { YT_MODE=$value; cp_save; }

# Settings version 7 moved this default from half to follow, so the one
# Pictures setting reaches the player as it already reaches the viewer, the
# wallpaper and the browser. Only a file still holding the old default is
# moved: someone who chose half keeps it.
fn cp_setver7() {
	[ "$YT_MODE" = half ] && YT_MODE=follow
	return 0
}
fn cp_set_ytquality(int? id = "", value = "") { YT_QUALITY=$value; cp_save; }
fn cp_set_ytfps(int? id = "", int? value = "") { YT_FPS=$value; cp_save; }
fn cp_set_ytdetail(int? id = "", int? value = "") { YT_DETAIL=$value; cp_save; }

fn tube_rows(int w) {
	local n=0 md

	dt_has youtube_draw || { cp_absent "$w" YouTube; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Picture"
	CP[$w][$n]["val"]="$YT_MODE"; CP[$w][$n]["key"]=mode
	n=$((n + 1))
	if [ "$YT_MODE" = follow ]; then
		md := yt_drawmode
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Drawn Now"
		CP[$w][$n]["val"]=$md; n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Quality Fetched"
	CP[$w][$n]["val"]="$YT_QUALITY"; CP[$w][$n]["key"]=quality
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Frames a Second"
	CP[$w][$n]["val"]="$YT_FPS"; CP[$w][$n]["key"]=fps
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Colour Detail"
	CP[$w][$n]["val"]="$YT_DETAIL"; CP[$w][$n]["key"]=detail
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Play Next Automatically"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$YT_AUTONEXT" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_AUTONEXT; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Clear History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=histclear
	n=$((n + 1))
	ret "$n"
}

fn tube_do(int? w = "", k = "", int? dir = "") {
	local v

	case $k in
	mode) v := cp_next "$YT_MODE" "$dir" "${TB_MODES[@]}"; YT_MODE=$v ;;
	quality) v := cp_next "$YT_QUALITY" "$dir" "${TB_QUALITY[@]}"; YT_QUALITY=$v ;;
	fps) v := cp_next "$YT_FPS" "$dir" "${TB_FPS[@]}"; YT_FPS=$v ;;
	detail) v := cp_next "$YT_DETAIL" "$dir" "${TB_DETAIL[@]}"; YT_DETAIL=$v ;;
	YT_AUTONEXT) cp_toggle "$k" ;;
	histclear) yt_histclear ;;
	esac
	cp_save
}

fn tube_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	mode) dt_droplist "$w" "$r" "$c" cp_set_ytmode "${TB_MODES[@]}" ;;
	quality) dt_droplist "$w" "$r" "$c" cp_set_ytquality "${TB_QUALITY[@]}" ;;
	fps) dt_droplist "$w" "$r" "$c" cp_set_ytfps "${TB_FPS[@]}" ;;
	detail) dt_droplist "$w" "$r" "$c" cp_set_ytdetail "${TB_DETAIL[@]}" ;;
	esac
}
