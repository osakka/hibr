#!/usr/bin/env hibr
#
# abouthibr -- the Control Panel pane for About hibr: how often its CPU and
# memory figures are read again. Named abouthibr, not about, because the
# app's own about_draw would otherwise be taken for this pane's body.

strict

command -v cp_pane > /dev/null && cp_pane abouthibr "About hibr" "ⓘ" app

CP_ABTICKS=(1000 2000 3000 5000 10000)
fn cp_set_about(int? id = "", int? value = "") { AB_SLOWMS=$value; cp_save; }

fn abouthibr_rows(int w) {
	[ -n "$AB_SLOWMS" ] || { cp_absent "$w" "About hibr Desktop"; ret 1; }
	CP[$w][0]["kind"]=set; CP[$w][0]["text"]="Refresh"
	CP[$w][0]["val"]="$AB_SLOWMS ms"; CP[$w][0]["key"]=about
	ret 1
}

fn abouthibr_do(int w, k, int dir) {
	local v

	case $k in
	about) v := cp_next "$AB_SLOWMS" "$dir" "${CP_ABTICKS[@]}"
	       AB_SLOWMS=$v ;;
	esac
	cp_save
}

fn abouthibr_drop(int w, int r, int c, k) {
	case $k in
	about) dt_droplist "$w" "$r" "$c" cp_set_about "${CP_ABTICKS[@]}" ;;
	esac
}
