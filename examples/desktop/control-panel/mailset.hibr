#!/usr/bin/env hibr
#
# mailset -- the Control Panel pane for Mail (apps/Internet/mail.hibr):
# the accounts -- each opening a dialog to change it, and one to add
# another -- how much is kept offline, how often mail is checked for,
# whether attached pictures are drawn, and a signature. Accounts are the
# email module's own list, readable only by you; this pane never shows a
# password.

strict

command -v cp_pane > /dev/null && cp_pane mailset "Mail" "✉" app
command -v dt_app > /dev/null && dt_app mlad "Mail Account" 20 66 "" "" fixed hidden

# The app's settings, declared here as well, so the pane can change them
# when the app has not been loaded.
DT_MAILMAX="${DT_MAILMAX-1000}"
DT_MAILBODIES="${DT_MAILBODIES-500}"
DT_MAILEVERY="${DT_MAILEVERY-5}"
DT_MAILIMAGES="${DT_MAILIMAGES-attached}"
DT_MAILSIG="${DT_MAILSIG-}"
DT_MAILDRAFT="${DT_MAILDRAFT-30}"
command -v dt_keep > /dev/null && dt_keep DT_MAILMAX DT_MAILBODIES DT_MAILEVERY DT_MAILIMAGES DT_MAILSIG DT_MAILDRAFT

MS_KEEPS=(250 500 1000 2000)
# Seconds a message being written may go unsaved. 0 is the one value that
# is a word rather than a number, because "every 0 seconds" says nothing.
MS_DRAFTL=(0 15 30 60 120)
MS_BODIESL=(100 500 2000 all)
MS_EVERYL=(1 2 5 15 30)
MS_IMAGESL=(never attached)
declare -gA MLAD
# `user` is the login, and it sits next to the address because it defaults
# from it: the module stores the address as the user when none is given
# (conf.c), so an empty field here means "the same as the address" and
# nothing a person has already typed changes meaning. Without the field a
# server whose login is a bare username could not be used from the desktop
# at all, though `email account set -u` has always taken one (Gitea #157).
# `detect` sits with the buttons rather than beside the server fields it
# fills, and the reason is a trap this dialog has sprung twice: every suite
# that types its way through here walks this list, so a row inserted in the
# middle silently shifts what each tab lands on and checks that have
# nothing to do with the new field start failing (Gitea #157 cost seven of
# them). Last costs nothing to anything already written.
MLAD_ORDER=(name email alias user full pass kind host port sec shost sport ssec ok del cancel detect)

# Where lib/mailtest.hibr lives, and what one run of it is doing: the
# account it was asked about, the file it is writing, and whether it is
# still going. A test talks to two servers over a network that may be
# wedged, so it is a job and never a wait inside a frame -- what it has
# said so far is read as the pane draws, which is also what makes the
# ladder appear a rung at a time rather than all at once at the end
# (Gitea #188).
MS_LIB=${BASH_SOURCE%/*}/../lib
declare -gA MS_TEST
MS_TEST["acct"]=
MS_TEST["file"]=

# Where one account's ladder is written. Named after the account rather
# than being one file called `out`, because MS_TEST is a single slot: two
# dialogs testing two accounts had the second overwrite the first, and a
# window opened on the first would then have drawn the second's ladder
# under its own title. The window keeps this path under its own id, so a
# later test of another account cannot move it.
fn ms_testfile(acct) {
	local d=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hibr-mailtest-$UID

	mkdir -p "$d" 2> /dev/null
	chmod 700 "$d" 2> /dev/null
	ret "$d/out-${acct//[!A-Za-z0-9._-]/_}"
}

# Start one, replacing whatever was shown before.
fn ms_test(acct) {
	local f

	f := ms_testfile "$acct"
	MS_TEST["acct"]=$acct
	MS_TEST["file"]=$f
	: > "$f"
	rm -f "$f.st"
	(
		"$HIBR" "$MS_LIB/mailtest.hibr" "$acct" > "$f" 2>&1
		printf '%s\n' "$?" > "$f.st"
	) &
	dt_want 200
	return 0
}

# Probe this dialog's host for the ports that mean something, and take the
# pairing that answers (Gitea #189). Typed settings rather than saved ones,
# because this is where they are being typed -- and the host alone is
# enough to ask, so it works before anything has been saved at all. A job,
# like the Test: probing several ports on a server that may be wedged is
# exactly the wait a frame must not take.
declare -gA MS_DET
MS_DET["win"]=
MS_DET["file"]=
fn ms_detect(int id) {
	local host=${MLAD[$id]["host"]} d=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hibr-mailtest-$UID
	local shost=${MLAD[$id]["shost"]} t

	# No host typed: the address's own domain is the only other thing
	# that could be meant, and it is what a provider's settings are
	# looked up by anyway.
	[ -n "$host" ] || host=${MLAD[$id]["email"]#*@}
	[ -n "$shost" ] || shost=$host
	if [ -z "$host" ]; then
		dt_notify "type a server or an address first"
		return 0
	fi
	mkdir -p "$d" 2> /dev/null
	chmod 700 "$d" 2> /dev/null
	MS_DET["win"]=$id
	MS_DET["file"]=$d/detect
	t := dt_tr "asking %s" "$host"
	t="$t${GL[ellipsis]}"
	dt_notify "$t"
	: > "${MS_DET["file"]}"
	rm -f "${MS_DET["file"]}.st"
	(
		"$HIBR" "$MS_LIB/mailtest.hibr" --detect "$host" "${MLAD[$id]["kind"]}" "$shost" \
			> "${MS_DET["file"]}" 2>&1
		printf '%s\n' "$?" > "${MS_DET["file"]}.st"
	) &
	dt_want 200
	return 0
}

# Read what the probe has said and put it in the fields. Called as the
# dialog draws, so the answer lands whenever it arrives without the dialog
# waiting for it.
fn ms_detread(int id) {
	local f=${MS_DET["file"]} line warn= t a
	local -a part

	[ "${MS_DET["win"]}" = "$id" ] || return 0
	[ -n "$f" ] && [ -s "$f.st" ] || { [ -n "$f" ] && dt_want 300; return 0; }
	MS_DET["win"]=
	while IFS= read -r line; do
		read -ra part <<< "$line"
		[ "${#part[@]}" -ge 3 ] || continue
		case "${part[0]} ${part[1]}" in
		"in pick")
			[ "${part[2]}" = none ] && continue
			MLAD[$id]["port"]=${part[2]}
			MLAD[$id]["sec"]=${part[3]}
			;;
		"out pick")
			[ "${part[2]}" = none ] && continue
			MLAD[$id]["sport"]=${part[2]}
			MLAD[$id]["ssec"]=${part[3]}
			;;
		*" note") warn="${warn:+$warn; }${line#* note warn }" ;;
		esac
	done < "$f"
	# Two answers, not one, and they want different lifetimes. What it
	# picked is already in the fields above, so that note is only
	# confirmation and a plain one will do. A warning is the opposite:
	# it is the reason not to trust what was just filled in, it is a
	# sentence rather than a word, and what it asks for is a Test -- so
	# it goes at a priority with the Test window as its action, which
	# makes the note the way to the thing it is telling you to do.
	if [ -n "${MLAD[$id]["port"]}" ]; then
		t := dt_tr "found %s for incoming and %s for outgoing" \
			"${MLAD[$id]["port"]}/${MLAD[$id]["sec"]}" \
			"${MLAD[$id]["sport"]:-?}/${MLAD[$id]["ssec"]}"
	else
		t := dt_tr "nothing answered on the usual ports"
	fi
	dt_notify "$t"
	if [ -n "$warn" ]; then
		a=${MLAD[$id]["name"]}
		[ -n "$a" ] || a=${MLAD[$id]["email"]}
		dt_notifyp warn "$warn" ms_testshow "$a"
	fi
	dt_want 50
	return 0
}

# --- the Test window ------------------------------------------------------
#
# The ladder in a window of its own (Gitea #207). The pane held it as rows
# with the detail in the value column, which is a word wide -- and the
# answer to "why will this account not log in" is a sentence from the
# server: `imap.home.arpa refused the login for osakka: NO
# [AUTHENTICATIONFAILED] Authentication failed.` is the whole diagnosis and
# none of it fits. A window with no `dt_app` of its own, the same
# dt_new-with-no-registration the Control Panel's small dialogs use, so
# dt_menus gives it File > Close and it is on nobody's menu.
declare -gA MST
# The rows as drawn, built by ms_testlines for the window being drawn: one
# per rung plus its detail wrapped, each entry prefixed `h` for a rung's
# own line and `d` for a continuation, since the two are drawn in different
# pens. A single array rather than one per window because only the window
# being drawn ever holds it.
declare -ga MST_L

# Open one on an account, starting the job if it is not already going.
fn ms_testshow(acct = "") {
	local h=18 w=70 r c id f t a

	[ -n "$acct" ] || acct=${MS_TEST["acct"]}
	if [ -z "$acct" ] && r := email accounts 2> /dev/null; then
		for a in "${!r[@]}"; do acct=$a; break; done
	fi
	if [ -z "$acct" ]; then
		dt_note "there is no account to test yet"
		return 0
	fi
	ms_test "$acct"
	[ "$h" -gt $((DT_ROWS - 4)) ] && h=$((DT_ROWS - 4))
	[ "$w" -gt $((DT_COLS - 4)) ] && w=$((DT_COLS - 4))
	[ "$h" -lt 6 ] && h=6
	[ "$w" -lt 24 ] && w=24
	r=$((DT_ROWS / 2 - h / 2))
	c=$(((DT_COLS - w) / 2))
	[ "$r" -lt 1 ] && r=1
	[ "$c" -lt 0 ] && c=0
	t := dt_wintitle "Mail Test" "$acct"
	id := dt_new "$t" "$h" "$w" "$r" "$c" mst
	f := ms_testfile "$acct"
	MST[$id]["acct"]=$acct
	MST[$id]["file"]=$f
	MST[$id]["top"]=0
	MST[$id]["n"]=0
	MST[$id]["vis"]=1
	dt_want 50
	return 0
}

# The file as rows at this width, and how many rungs failed.
#
# Measured with `str width` and not `${#s}`: the marks are glyphs wider
# than a cell, and so is a translated "incoming" in a script that has no
# narrow forms -- counting characters would drift the right edge a column
# for every row carrying one. A cut that landed inside a word keeps the
# whole word, so the remainder starts where the text did and no character
# is eaten by assuming a space was there.
fn ms_testlines(int id, int w) {
	local f=${MST[$id]["file"]} line d st how what pre k n bad=0 room
	local -a part

	MST_L=()
	room=$((w - 4))
	[ "$room" -lt 8 ] && room=8
	MST[$id]["bad"]=0
	[ -n "$f" ] && [ -r "$f" ] || return 0
	while IFS= read -r line; do
		read -ra part <<< "$line"
		[ -n "$line" ] || continue
		# Only `in` and `out` lines are rungs. The job's standard
		# error lands in the same file, deliberately -- a shell
		# error there is often the answer -- and one of those has
		# four fields too, so a count of them is not the test:
		# `hibr: connect 127.0.0.1:9: Connection refused` was drawn
		# as a rung called "hibr: connect", marked with the dot that
		# means a skip, and counted as neither passed nor failed.
		# It is shown as what it is instead, where it happened.
		case "${part[0]} ${#part[@]}" in
		"in "[3-9]* | "out "[3-9]* | "in "[1-9][0-9]* | "out "[1-9][0-9]*) ;;
		*)
			MST_L+=("o$line")
			continue
			;;
		esac
		d=${part[0]}
		st=${part[1]}
		how := ms_mark "${part[2]}"
		what=${line#"$d $st ${part[2]} "}
		[ "${part[2]}" = fail ] && bad=$((bad + 1))
		case $d in
		in) d := dt_tr "incoming" ;;
		out) d := dt_tr "outgoing" ;;
		esac
		MST_L+=("h$how $d $st")
		while [ -n "$what" ]; do
			n := str width "$what"
			if [ "$n" -le "$room" ]; then
				MST_L+=("d$what")
				break
			fi
			k=$room
			while [ "$k" -gt 1 ]; do
				pre=${what:0:$k}
				n := str width "$pre"
				[ "$n" -le "$room" ] && break
				k=$((k - 1))
			done
			pre=${what:0:$k}
			case $pre in
			*" "*) pre=${pre% *} ;;
			esac
			[ -n "$pre" ] || break
			MST_L+=("d$pre")
			if [ "$pre" = "${what:0:$k}" ]; then
				what=${what:${#pre}}
			else
				what=${what:$((${#pre} + 1))}
			fi
		done
	done < "$f"
	MST[$id]["bad"]=$bad
	return 0
}

fn mst_draw(int id, int h, int w, int row, int col) {
	local f=${MST[$id]["file"]} top=${MST[$id]["top"]} vis n i r t
	local kind text live=

	dt_wclear "$id"
	ms_testlines "$id" "$w"
	n=${#MST_L[@]}
	# The frame owns row 0 and column 0 of a window's pane, so content
	# runs from row 1 and column 1 -- and h and w already exclude both
	# borders. Row h is the footer's, leaving h-1 for the ladder. Drawn
	# from 0,0 instead, every row came out one up and two left with its
	# own first columns clipped away: each rung lost its mark, each
	# detail its indent, and the footer the number it opens with, which
	# reads as three separate bugs in composing the text.
	vis=$((h - 1))
	[ "$vis" -lt 1 ] && vis=1
	top := dt_scrollfit "$top" "$n" "$vis"
	MST[$id]["top"]=$top
	MST[$id]["n"]=$n
	MST[$id]["vis"]=$vis
	r=1
	i=$top
	while [ "$r" -le "$vis" ] && [ "$i" -lt "$n" ]; do
		text=${MST_L[$i]}
		kind=${text:0:1}
		text=${text:1}
		if [ "$kind" = h ]; then
			console pen "$DT_INK" "$DT_FACE"
			console put -p "w$id" "$r" 1 "$text"
		elif [ "$kind" = o ]; then
			console pen "$DT_WARN" "$DT_FACE"
			console put -p "w$id" "$r" 1 "${text:0:$((w - 1))}"
		else
			console pen "$DT_DIM" "$DT_FACE"
			console put -p "w$id" "$r" 3 "$text"
		fi
		r=$((r + 1))
		i=$((i + 1))
	done
	[ "$n" -gt "$vis" ] && dt_scrollbar "$id" 1 "$w" "$vis" "$n" "$vis" "$top"
	# Live while the job has not written its status file: asked of this
	# window's own file, so one window finishing says nothing about
	# another's. A finished ladder asks for no more frames, which is
	# what dt_want's one-frame contract wants of anything calling it.
	[ -n "$f" ] && [ ! -s "$f.st" ] && live=1
	if [ -n "$live" ]; then
		console pen "$DT_INFO" "$DT_FACE"
		t := dt_tr "asking the servers"
		t="$t${GL[ellipsis]}"
		dt_want 300
	elif [ "${MST[$id]["bad"]}" -gt 0 ]; then
		console pen "$DT_BAD" "$DT_FACE"
		t := dt_trn "${MST[$id]["bad"]}" "%d step failed -- r tests again" "%d steps failed -- r tests again" "${MST[$id]["bad"]}"
	elif [ "$n" -gt 0 ]; then
		console pen "$DT_GOOD" "$DT_FACE"
		t := dt_tr "every step passed -- r tests again"
	else
		console pen "$DT_DIM" "$DT_FACE"
		t := dt_tr "nothing came back -- r tests again"
	fi
	console put -p "w$id" "$h" 1 "$t"
	return 0
}

fn mst_key(int id, key) {
	local t

	case $key in
	r|R)
		ms_test "${MST[$id]["acct"]}"
		MST[$id]["top"]=0
		dt_want 50
		return 0
		;;
	esac
	t := dt_scrollmove "$key" "${MST[$id]["top"]}" "${MST[$id]["n"]}" \
		"${MST[$id]["vis"]}" || return 1
	MST[$id]["top"]=$t
	dt_want 20
	return 0
}

fn mst_wheel(int id, dir, int r = 0, int c = 0) {
	local t

	t := dt_scrollmove "$dir" "${MST[$id]["top"]}" "${MST[$id]["n"]}" \
		"${MST[$id]["vis"]}" "$DT_SCROLLWHEEL" || return 1
	MST[$id]["top"]=$t
	dt_want 20
	return 0
}

fn mst_close(int id) {
	unset MST["$id"]
	return 0
}

# The mark for a step, in the theme's own roles rather than a colour.
fn ms_mark(how) {
	case $how in
	ok) ret "${GL[tick]:-+}" ;;
	fail) ret "${GL[cross]:-x}" ;;
	*) ret "${GL[dot]:-.}" ;;
	esac
}

fn cp_set_mailmax(int? id = "", value = "") { DT_MAILMAX=$value; cp_save; }
fn cp_set_mailbodies(int? id = "", value = "") {
	[ "$value" = all ] && value=1000000
	DT_MAILBODIES=$value
	cp_save
}
fn cp_set_mailevery(int? id = "", value = "") { DT_MAILEVERY=$value; cp_save; }
fn cp_set_maildraft(int? id = "", value = "") { DT_MAILDRAFT=$value; cp_save; }
fn cp_set_mailimages(int? id = "", value = "") { DT_MAILIMAGES=$value; cp_save; }

fn mailset_rows(int w) {
	local n=0 r a v

	if ! need email 2> /dev/null; then
		cp_absent "$w" "the email module"
		ret 1
	fi
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Accounts"; n=$((n + 1))
	if r := email accounts 2> /dev/null; then
		for a in "${!r[@]}"; do
			CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="$a"
			CP[$w][$n]["val"]="${r["$a"]["email"]}"; CP[$w][$n]["key"]="acct:$a"
			n=$((n + 1))
		done
	fi
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Add Account${GL[ellipsis]}"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=add; n=$((n + 1))
	n := ms_testrows "$w" "$n"
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Offline"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Keep Messages"
	CP[$w][$n]["val"]="${DT_MAILMAX:-1000}"; CP[$w][$n]["key"]=max; n=$((n + 1))
	v=${DT_MAILBODIES:-500}
	[ "$v" -ge 1000000 ] 2> /dev/null && v=all
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Download Whole Messages"
	CP[$w][$n]["val"]="$v"; CP[$w][$n]["key"]=bodies; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Check Every (minutes)"
	CP[$w][$n]["val"]="${DT_MAILEVERY:-5}"; CP[$w][$n]["key"]=every; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Save Drafts Every (seconds)"
	CP[$w][$n]["val"]="${DT_MAILDRAFT:-30}"; CP[$w][$n]["key"]=draft
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Show Pictures"
	CP[$w][$n]["val"]="${DT_MAILIMAGES:-attached}"; CP[$w][$n]["key"]=images; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Signature${GL[ellipsis]}"
	CP[$w][$n]["val"]="${DT_MAILSIG:0:20}"; CP[$w][$n]["key"]=sig; n=$((n + 1))
	ret "$n"
}

# How the last test went, in a few words, for the pane's own row. The
# rungs themselves are the Test window's (Gitea #207): the pane's value
# column is a word wide, and what a failing rung has to say is a sentence
# from the server.
fn ms_testverdict(f) {
	local line bad=0 seen=0 t
	local -a part

	[ -n "$f" ] && [ -r "$f" ] || { ret ""; return 0; }
	while IFS= read -r line; do
		read -ra part <<< "$line"
		[ "${#part[@]}" -ge 3 ] || continue
		seen=1
		[ "${part[2]}" = fail ] && bad=$((bad + 1))
	done < "$f"
	if [ "$seen" = 0 ]; then
		t := dt_tr "nothing came back"
	elif [ "$bad" -gt 0 ]; then
		t := dt_trn "$bad" "%d step failed" "%d steps failed" "$bad"
	else
		t := dt_tr "every step passed"
	fi
	ret "$t"
}

# The Test's own row: the button, and what the last one said. Opening the
# window is what the button does now.
fn ms_testrows(int w, int n) {
	local f=${MS_TEST["file"]} a=${MS_TEST["acct"]} v

	CP[$w][$n]["kind"]=action
	CP[$w][$n]["text"]="Test Connection${GL[ellipsis]}"
	CP[$w][$n]["val"]=""
	if [ -n "$a" ]; then
		if [ -n "$f" ] && [ ! -s "$f.st" ]; then
			v := dt_tr "asking"
			dt_want 300
		else
			v := ms_testverdict "$f"
		fi
		CP[$w][$n]["val"]="$a: $v"
	fi
	CP[$w][$n]["key"]=test
	ret $((n + 1))
}

fn mailset_do(int? w = "", k = "", int? dir = "") {
	local v cur

	case $k in
	test) ms_testshow ;;
	acct:*) mlad_show "${k#acct:}" ;;
	add) mlad_show ;;
	max) v := cp_next "${DT_MAILMAX:-1000}" "$dir" "${MS_KEEPS[@]}"; DT_MAILMAX=$v ;;
	bodies)
		cur=${DT_MAILBODIES:-500}
		[ "$cur" -ge 1000000 ] 2> /dev/null && cur=all
		v := cp_next "$cur" "$dir" "${MS_BODIESL[@]}"
		[ "$v" = all ] && v=1000000
		DT_MAILBODIES=$v
		;;
	every) v := cp_next "${DT_MAILEVERY:-5}" "$dir" "${MS_EVERYL[@]}"; DT_MAILEVERY=$v ;;
	draft) v := cp_next "${DT_MAILDRAFT:-30}" "$dir" "${MS_DRAFTL[@]}"; DT_MAILDRAFT=$v ;;
	images) v := cp_next "${DT_MAILIMAGES:-attached}" "$dir" "${MS_IMAGESL[@]}"; DT_MAILIMAGES=$v ;;
	sig) mlad_show "" sig ;;
	esac
	cp_save
}

fn mailset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	max) dt_droplist "$w" "$r" "$c" cp_set_mailmax "${MS_KEEPS[@]}" ;;
	bodies) dt_droplist "$w" "$r" "$c" cp_set_mailbodies "${MS_BODIESL[@]}" ;;
	every) dt_droplist "$w" "$r" "$c" cp_set_mailevery "${MS_EVERYL[@]}" ;;
	draft) dt_droplist "$w" "$r" "$c" cp_set_maildraft "${MS_DRAFTL[@]}" ;;
	images) dt_droplist "$w" "$r" "$c" cp_set_mailimages "${MS_IMAGESL[@]}" ;;
	esac
}

# --- the account dialog ---------------------------------------------------

# Open the dialog on an account by name, or empty for a new one; or, with
# "sig", the signature.
fn mlad_show(name = "", what = "") {
	local id h=22 w=66 r k i

	[ "$w" -gt $((DT_COLS - 2)) ] && w=$((DT_COLS - 2))
	if [ "$what" = sig ]; then
		id := dt_new "Signature" 8 "$w" $(((DT_ROWS - 8) / 2)) $(((DT_COLS - w) / 2)) mlad
		MLAD[$id]["sig"]=1
		MLAD[$id]["full"]=$DT_MAILSIG
		MLAD[$id]["fullcur"]=${#DT_MAILSIG}
		MLAD[$id]["focus"]=full
		return 0
	fi
	if [ -n "$name" ]; then
		id := dt_new "Mail Account" "$h" "$w" $(((DT_ROWS - h) / 2)) $(((DT_COLS - w) / 2)) mlad
	else
		id := dt_new "Add a Mail Account" "$h" "$w" $(((DT_ROWS - h) / 2)) $(((DT_COLS - w) / 2)) mlad
	fi
	MLAD[$id]["orig"]=$name
	for k in name email alias user full pass host port shost sport; do MLAD[$id]["$k"]=; done
	MLAD[$id]["name"]=$name
	MLAD[$id]["kind"]=imap
	MLAD[$id]["sec"]=tls
	MLAD[$id]["ssec"]=tls
	MLAD[$id]["haspass"]=
	if [ -n "$name" ] && r := email accounts 2> /dev/null; then
		MLAD[$id]["email"]=${r["$name"]["email"]}
		# The module resolves an empty login to the address when the
		# account is written, so an account that never had one reads
		# back with user == email. Showing that as an empty field with
		# its hint is the honest rendering: it says the login follows
		# the address rather than that somebody typed it.
		MLAD[$id]["user"]=${r["$name"]["user"]}
		[ "${MLAD[$id]["user"]}" = "${MLAD[$id]["email"]}" ] && MLAD[$id]["user"]=
		# The addresses past the first: the first is the Email address
		# row above, and the module keeps the rest as it was given them.
		i=1
		while [ -n "${r["$name"]["addresses"][$i]+x}" ]; do
			MLAD[$id]["alias"]+="${MLAD[$id]["alias"]:+, }${r["$name"]["addresses"][$i]}"
			i=$((i + 1))
		done
		MLAD[$id]["full"]=${r["$name"]["name"]}
		MLAD[$id]["host"]=${r["$name"]["host"]}
		MLAD[$id]["port"]=${r["$name"]["port"]}
		MLAD[$id]["shost"]=${r["$name"]["smtphost"]}
		MLAD[$id]["sport"]=${r["$name"]["smtpport"]}
		MLAD[$id]["kind"]=${r["$name"]["kind"]}
		MLAD[$id]["sec"]=${r["$name"]["security"]}
		MLAD[$id]["ssec"]=${r["$name"]["smtpsecurity"]}
		MLAD[$id]["haspass"]=${r["$name"]["haspass"]}
	fi
	for k in name email alias user full pass host port shost sport; do MLAD[$id]["${k}cur"]=${#MLAD[$id]["$k"]}; done
	MLAD[$id]["focus"]=name
	[ -n "$name" ] && MLAD[$id]["focus"]=email
	MLAD[$id]["status"]=
	return 0
}

fn mlad_draw(int id, int h, int w, int row, int col) {
	local f=${MLAD[$id]["focus"]} r=1 k on fw=$((w - 22)) t
	local -A labs=([name]="Account name:" [email]="Email address:" [alias]="Other addresses:" \
		[user]="Login:" [full]="Your name:" \
		[pass]="Password:" [host]="Incoming server:" [port]="Port:" [shost]="Outgoing server:" \
		[sport]="Port:" [kind]="Kind:" [sec]="Security:" [ssec]="Security:")

	dt_wclear "$id"
	if [ "${MLAD[$id]["sig"]}" = 1 ]; then
		console pen "$DT_INK" "$DT_FACE"
		dt_tput "$id" 1 2 "Signature, put under every message you write:"
		dt_textdraw "$id" 3 2 $((w - 4)) "${MLAD[$id]["full"]}" "${MLAD[$id]["fullcur"]}" 1
		dt_dlgbtns "$id" "$h" "$w" "$f" ok Save cancel Cancel
		return 0
	fi
	for k in name email alias user full pass kind host port sec shost sport ssec; do
		console pen "$DT_INK" "$DT_FACE"
		console put -p "w$id" "$r" 2 "${labs[$k]}"
		on=0
		[ "$f" = "$k" ] && on=1
		case $k in
		kind | sec | ssec)
			t=${MLAD[$id]["$k"]}
			[ "$k" = kind ] && t=${t^^}
			if [ "$on" = 1 ]; then console pen "$DT_SELINK" "$DT_ACTIVE"; else console pen "$DT_INK" "$DT_WELL"; fi
			console put -p "w$id" "$r" 20 " $t ${GL[sdown]} "
			dt_wreg "$id" "$r" 20 $(( ${#t} + 4 )) "$k"
			;;
		*)
			t=${MLAD[$id]["$k"]}
			[ "$k" = pass ] && t := str repeat "*" "${#t}"
			dt_textdraw "$id" "$r" 20 "$fw" "$t" "${MLAD[$id]["${k}cur"]}" "$on"
			if [ "$k" = pass ] && [ -z "${MLAD[$id]["pass"]}" ] && [ "${MLAD[$id]["haspass"]}" = 1 ] && [ "$on" = 0 ]; then
				console pen "$DT_DIM" "$DT_FACE"
				dt_tput "$id" "$r" 20 "(unchanged)"
			fi
			if [ -z "${MLAD[$id]["$k"]}" ] && [ "$on" = 0 ] && { [ "$k" = host ] || [ "$k" = shost ] || [ "$k" = port ] || [ "$k" = sport ] || [ "$k" = user ]; }; then
				console pen "$DT_DIM" "$DT_FACE"
				dt_tput "$id" "$r" 20 "(from the address)"
			fi
			dt_wreg "$id" "$r" 20 "$fw" "$k"
			;;
		esac
		r=$((r + 1))
	done
	r=$((r + 1))
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" "$r" 2 "Gmail wants an app password, made in your Google account"
	console put -p "w$id" $((r + 1)) 2 "at myaccount.google.com/apppasswords"
	r=$((r + 2))
	if [ -n "${MLAD[$id]["status"]}" ]; then
		console pen "$DT_BAD" "$DT_FACE"
		t=${MLAD[$id]["status"]}
		k=$((w - 4))
		if [ "${#t}" -gt "$k" ]; then
			on=${t:0:$k}
			on=${on% *}
			console put -p "w$id" "$r" 2 "$on"
			t=${t:$((${#on} + 1))}
			r=$((r + 1))
		fi
		console put -p "w$id" "$r" 2 "${t:0:$k}"
	fi
	ms_detread "$id"
	if [ -n "${MLAD[$id]["orig"]}" ]; then
		dt_dlgbtns "$id" "$h" "$w" "$f" ok Save del Remove cancel Cancel detect Detect
	else
		dt_dlgbtns "$id" "$h" "$w" "$f" ok Save cancel Cancel detect Detect
	fi
}

fn mlad_key(int id, key) {
	local f=${MLAD[$id]["focus"]} d onb=1 res
	local -a order

	if [ "${MLAD[$id]["sig"]}" = 1 ]; then
		order=(full ok cancel)
	elif [ -n "${MLAD[$id]["orig"]}" ]; then
		order=("${MLAD_ORDER[@]}")
	else
		order=(name email alias user full pass kind host port sec shost sport ssec ok cancel detect)
	fi
	case $f in name | email | alias | user | full | pass | host | port | shost | sport) onb=0 ;; esac
	if d := dt_focuskey "$key" "$onb"; then
		MLAD[$id]["focus"] := dt_focus "$f" "$d" "${order[@]}"
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter | " ")
		case $f in
		kind | sec | ssec) mlad_do "$id" "$f"; return 0 ;;
		name | email | alias | user | full | pass | host | port | shost | sport)
			[ "$key" = enter ] && { MLAD[$id]["focus"] := dt_focus "$f" 1 "${order[@]}"; return 0; }
			;;
		*) mlad_do "$id" "$f"; return 0 ;;
		esac
		;;
	esac
	case $f in name | email | alias | user | full | pass | host | port | shost | sport) ;; *) return 1 ;; esac
	res := dt_textkey "${MLAD[$id]["$f"]}" "${MLAD[$id]["${f}cur"]}" "$key" || return 1
	MLAD[$id]["$f"]=${res% *}
	MLAD[$id]["${f}cur"]=${res##* }
	return 0
}

fn mlad_click(int? id = "", int? r = "", int? c = "", btn = "") {
	local tag cur

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in
	name | email | full | pass | host | port | shost | sport)
		MLAD[$id]["focus"]=$tag
		cur=$((c - 20))
		[ "$cur" -gt "${#MLAD[$id]["$tag"]}" ] && cur=${#MLAD[$id]["$tag"]}
		[ "$cur" -lt 0 ] && cur=0
		MLAD[$id]["${tag}cur"]=$cur
		;;
	*) MLAD[$id]["focus"]=$tag; mlad_do "$id" "$tag" ;;
	esac
}

fn mlad_close(int id) { unset MLAD["$id"]; return 0; }

# What enter, a click or space does to what has focus.
fn mlad_do(int id, what) {
	local -a args
	local k

	case $what in
	kind) [ "${MLAD[$id]["kind"]}" = imap ] && MLAD[$id]["kind"]=pop || MLAD[$id]["kind"]=imap ;;
	sec | ssec)
		case ${MLAD[$id]["$what"]} in
		tls) MLAD[$id]["$what"]=starttls ;;
		starttls) MLAD[$id]["$what"]=plain ;;
		*) MLAD[$id]["$what"]=tls ;;
		esac
		;;
	detect) ms_detect "$id" ;;
	cancel) dt_del "$id" ;;
	del)
		MLAD_RM=$id
		DT_T := dt_tr "Remove the account %s? Its offline mail is kept." "${MLAD[$id]["orig"]}"
		dt_confirm "$DT_T" mlad_remove
		;;
	ok)
		if [ "${MLAD[$id]["sig"]}" = 1 ]; then
			DT_MAILSIG=${MLAD[$id]["full"]}
			cp_save
			dt_del "$id"
			return 0
		fi
		if [ -z "${MLAD[$id]["name"]}" ] || [[ ${MLAD[$id]["name"]} == */* ]]; then
			MLAD[$id]["status"]="Give the account a name, without a /"
			return 0
		fi
		if [[ ${MLAD[$id]["email"]} != *@* ]]; then
			MLAD[$id]["status"]="Put in the account's email address"
			return 0
		fi
		# -u is passed whatever the field holds, empty included: an
		# empty one is how the module is told to follow the address,
		# so clearing the field has to clear the login rather than
		# leave yesterday's behind.
		args=(-k "${MLAD[$id]["kind"]}" -e "${MLAD[$id]["email"]}" -n "${MLAD[$id]["full"]}"
			-u "${MLAD[$id]["user"]}" -a "${MLAD[$id]["alias"]}"
			-S "${MLAD[$id]["sec"]}" -T "${MLAD[$id]["ssec"]}")
		[ -n "${MLAD[$id]["pass"]}" ] && args+=(-w "${MLAD[$id]["pass"]}")
		for k in host:-h port:-p shost:-o sport:-q; do
			[ -n "${MLAD[$id]["${k%%:*}"]}" ] && args+=("${k#*:}" "${MLAD[$id]["${k%%:*}"]}")
		done
		if [ -n "${MLAD[$id]["orig"]}" ] && [ "${MLAD[$id]["orig"]}" != "${MLAD[$id]["name"]}" ]; then
			if ! email account mv "${MLAD[$id]["orig"]}" "${MLAD[$id]["name"]}" 2> "${DT_LOG%/*}/mlad.err"; then
				local l=
				read -r l < "${DT_LOG%/*}/mlad.err"
				MLAD[$id]["status"]=${l#hibr: email: }
				return 0
			fi
			MLAD[$id]["orig"]=${MLAD[$id]["name"]}
		fi
		# Mail's own menu bar grows an Accounts menu at the second
		# account, so the shut bar's titles change here: the one place
		# in the desktop where that is true of anything but focus.
		DT_MENUIN=
		if ! email account set "${MLAD[$id]["name"]}" "${args[@]}" 2> "${DT_LOG%/*}/mlad.err"; then
			local l=
			read -r l < "${DT_LOG%/*}/mlad.err"
			MLAD[$id]["status"]=${l#hibr: email: }
			return 0
		fi
		local nm=${MLAD[$id]["name"]}
		dt_notep low "Account %s saved" "$nm"
		dt_del "$id"
		command -v ml_accounts > /dev/null && mlad_refresh "$nm"
		;;
	esac
}
MLAD_RM=
mlad_remove() {
	# Mail's bar grows an Accounts menu at the second account, so losing
	# one can change what a shut menu bar shows -- the one thing in the
	# desktop other than focus that does (wm/draw.hibr's own gate).
	DT_MENUIN=
	[ -n "$MLAD_RM" ] &&
		email account rm "${MLAD[$MLAD_RM]["orig"]}" 2> /dev/null && dt_del "$MLAD_RM"
	MLAD_RM=
}

# After an account is saved: every Mail window that had none takes it up.
fn mlad_refresh(acct) {
	local id

	for id in "${!MW[@]}"; do
		[[ $id == [0-9]* ]] || continue
		if [ -n "${MW[$id]["err"]}" ]; then
			MW[$id]["err"]=
			ml_accounts && ml_use "$id" "$acct"
		fi
	done
}
