#!/usr/bin/env hibr
#
# filesview -- the Control Panel pane for Files: the view a folder opens in
# until it is given one of its own, and forgetting every folder's. Named
# filesview, not files, because the app already owns the files_ prefix.

strict

command -v cp_pane > /dev/null && cp_pane filesview "Files" "◫" app

fn cp_set_fileview(int? id = "", value = "") { FB_DEFAULTVIEW=$value; cp_save; }

fn filesview_rows(int w) {
	local n=0

	[ "${#FILES_VIEWS[@]}" -gt 0 ] || { cp_absent "$w" Files; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Default View"
	CP[$w][$n]["val"]="${FB_DEFAULTVIEW:-list}"; CP[$w][$n]["key"]=fileview
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Reset All Views"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=resetviews
	n=$((n + 1))
	ret "$n"
}

fn filesview_do(int w, k, int dir) {
	local v

	case $k in
	fileview) v := cp_next "${FB_DEFAULTVIEW:-list}" "$dir" "${FILES_VIEWS[@]}"
		FB_DEFAULTVIEW=$v ;;
	resetviews) fb_reset_views ;;
	esac
	cp_save
}

fn filesview_drop(int w, int r, int c, k) {
	case $k in
	fileview) dt_droplist "$w" "$r" "$c" cp_set_fileview "${FILES_VIEWS[@]}" ;;
	esac
}
