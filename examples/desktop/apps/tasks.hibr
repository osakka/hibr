#!/usr/bin/env hibr
#
# tasks -- what is running, and a way to end one of them.
#
# On Linux, reads /proc directly, the same technique mods/mon and the about
# window both use: no forking, and no dependency on anything but the kernel
# giving a truthful /proc. Elsewhere, one ps -axo per scan, since there is
# no /proc to read there at all -- ps already computes %CPU itself, so
# there is no delta of its own to keep between scans, unlike the Linux path.
# Sorted by CPU or memory, x or Task > End Task sends the selected one
# SIGTERM, shift-x sends SIGKILL.

app tasks "What is running, and a way to end one"

command -v dt_app > /dev/null && dt_app tasks "Task Manager" 16 50 once "▤"

declare -gA TK
declare -gA TK_PREV
declare -gA TK_UIDNAME
TK_OS=

# uid -> name, from /etc/passwd directly -- no fork, matching how the
# rest of a Linux scan already avoids one. Reloaded every scan: reading
# a few dozen lines once a second costs nothing worth caching further,
# and a user added since the window opened still resolves.
tasks_loadusers() {
	local name uid _

	TK_UIDNAME=()
	while IFS=: read -r name _ uid _; do
		TK_UIDNAME["$uid"]=$name
	done < /etc/passwd
}

# A uid as the name it resolves to, or itself when nothing does -- a
# user removed after their process started, most often.
tasks_ownername() {
	ret "${TK_UIDNAME["$1"]:-$1}"
}

# The two sparklines at the bottom -- one label row, one glyph row, each
# glyph one of eight block heights, most recent sample on the right, the
# same look tmux's own graphs use. History is kept independent of the
# window's current width (samples are trimmed to fit at draw time, not
# at collection time), so a resize never throws a real sample away.
TK_HISTMAX=120
TK_SPARK=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# Append one value, shifting the oldest out once TK_HISTMAX is reached.
# Once a second (TK_SCANMS), never once a frame, so an O(n) shift over
# at most 120 entries costs nothing worth avoiding.
tasks_pushhist() {
	local id=$1 key=$2 val=$3 n i

	n=${TK[$id]["${key}n"]:-0}
	if [ "$n" -ge "$TK_HISTMAX" ]; then
		i=0
		while [ "$i" -lt $((n - 1)) ]; do
			TK[$id]["$key"][$i]=${TK[$id]["$key"][$((i + 1))]}
			i=$((i + 1))
		done
		n=$((n - 1))
	fi
	TK[$id]["$key"][$n]=$val
	TK[$id]["${key}n"]=$((n + 1))
}

# The last w samples of a history, as glyphs, oldest first -- padded with
# blanks on the left so a history shorter than the graph still sits
# against the right edge, where "now" belongs.
tasks_spark() {
	local id=$1 key=$2 w=$3 n i v lvl out=

	n=${TK[$id]["${key}n"]:-0}
	i=$((n - w))
	[ "$i" -lt 0 ] && i=0
	while [ "$i" -lt "$n" ]; do
		v=${TK[$id]["$key"][$i]}
		lvl=$((v * 8 / 101))
		[ "$lvl" -gt 7 ] && lvl=7
		[ "$lvl" -lt 0 ] && lvl=0
		out="$out${TK_SPARK[$lvl]}"
		i=$((i + 1))
	done
	while [ "${#out}" -lt "$w" ]; do out=" $out"; done
	ret "$out"
}

# Overall CPU% and memory% used, from /proc directly -- Linux only, the
# same split tasks_scan already makes for the per-process list. Elsewhere
# the graphs stay flat at 0 rather than reading something platform
# doesn't offer; ps -axo's own %CPU is per process, not a system total,
# and there is no single ps column this could sum into one honestly.
#
# CPU: /proc/stat's own first line is every core already summed by the
# kernel; delta of idle over delta of the whole line since the last scan
# is exactly what top's own headline percentage is. Memory: MemAvailable
# already accounts for reclaimable cache the way a plain MemFree does
# not, which is the same number free(1) reports as "available".
tasks_sysstat() {
	local id=$1 line rest v total=0 idle du_total du_idle
	local k mtotal= mavail=

	[ "$TK_OS" = Linux ] || return 0
	read -r line < /proc/stat 2> /dev/null
	rest=${line#cpu }
	set -- $rest
	idle=${4:-0}
	for v in "$@"; do total=$((total + v)); done
	if [ -n "${TK_PREV[$id]["cput"]}" ]; then
		du_total=$((total - TK_PREV[$id]["cput"]))
		du_idle=$((idle - TK_PREV[$id]["cpui"]))
		[ "$du_total" -gt 0 ] &&
			TK[$id]["syscpu"]=$(((du_total - du_idle) * 100 / du_total))
	fi
	TK_PREV[$id]["cput"]=$total
	TK_PREV[$id]["cpui"]=$idle
	while read -r k v _; do
		case $k in
		MemTotal:) mtotal=$v ;;
		MemAvailable:) mavail=$v ;;
		esac
	done < /proc/meminfo
	[ -n "$mtotal" ] && [ "$mtotal" -gt 0 ] &&
		TK[$id]["sysmem"]=$(((mtotal - ${mavail:-0}) * 100 / mtotal))
	tasks_pushhist "$id" cpuh "${TK[$id]["syscpu"]:-0}"
	tasks_pushhist "$id" memh "${TK[$id]["sysmem"]:-0}"
}

# CLK_TCK is 100 on every Linux this was run on; getconf forks, and the
# kernel does not expose it any other way worth reading for this.
TK_HZ=100

# A full scan opens two files per process. Scanning on every redraw cost 40%
# of a core on this machine's real process count, measured at the DT_TICK=60
# the test suite uses to run fast, which is not the default: at the real
# 200ms default, redrawing without rescanning is what makes an open window
# cost 5.8% instead, rescanning once a second (what top and htop default to
# as well) 7.6%. Only the visible rows are formatted on a redraw that finds
# nothing new to scan.
TK_SCANMS="${TK_SCANMS-1000}"
command -v dt_keep > /dev/null && dt_keep TK_SCANMS

# The state, then the ten fields before utime and stime, then those two --
# /proc/[pid]/stat's own gotcha, since the command name is in parens and may
# itself contain both parens and spaces. Found from the last ")" in the
# line, never the first.
tasks_times() {
	local pid=$1 line rest state a b c d e f g h j k u s

	read -r line < "/proc/$pid/stat" 2> /dev/null || return 1
	rest=${line##*)}
	read -r state a b c d e f g h j k u s _ <<< "$rest"
	ret "$u $s"
}

# One pass: every pid under /proc, its name and memory from status (no
# bracket or position traps there), CPU from the delta against the last
# scan. The first scan has nothing to compare against, so it reads 0.
# Every process from ps -axo, one line each: pid, RSS in the same
# kilobytes /proc/[pid]/status uses, %CPU already computed by the kernel,
# user (ps resolves it itself here, unlike the Linux path's own uid), and
# comm last so a path with a space in it -- an app bundle's, typically --
# still reads whole, in read's own last-variable-takes-the-rest rule.
tasks_scan_ps() {
	local id=$1 pid rss pcpu user comm line n=0

	while IFS= read -r line; do
		read -r pid rss pcpu user comm <<< "$line"
		case $pid in '' | *[!0-9]*) continue ;; esac
		TK[$id][$n]["pid"]=$pid
		TK[$id][$n]["name"]=${comm##*/}
		TK[$id][$n]["owner"]=$user
		TK[$id][$n]["cpu"]=${pcpu%.*}
		TK[$id][$n]["mem"]=${rss:-0}
		n=$((n + 1))
	done < <(command ps -axo pid=,rss=,pcpu=,user=,comm= 2> /dev/null)
	TK[$id]["n"]=$n
}

tasks_scan() {
	local id=$1 pid name rss uid owner times u s now elapsed du ds pct n=0
	local prevt=${TK_PREV[$id]["t"]}

	# uname is a program, not a builtin -- := does nothing for one of
	# those and its output goes straight to the real terminal, so this
	# has to be a real command substitution, not :=.
	[ -z "$TK_OS" ] && TK_OS=$(command uname)
	if [ "$TK_OS" != Linux ]; then
		tasks_scan_ps "$id"
		return 0
	fi
	tasks_loadusers
	now := dt_ms
	for pid in /proc/[0-9]*; do
		pid=${pid#/proc/}
		[ -r "/proc/$pid/status" ] || continue
		name= rss= uid=
		while read -r k v _; do
			case $k in
			Name:) name=$v ;;
			VmRSS:) rss=$v ;;
			Uid:) uid=$v ;;
			esac
		done < "/proc/$pid/status"
		[ -z "$name" ] && continue
		times := tasks_times "$pid" || continue
		u=${times% *}
		s=${times#* }
		pct=0
		if [ -n "$prevt" ] && [ -n "${TK_PREV[$id]["$pid.u"]}" ]; then
			du=$((u - TK_PREV[$id]["$pid.u"]))
			ds=$((s - TK_PREV[$id]["$pid.s"]))
			elapsed=$((now - prevt))
			[ "$elapsed" -gt 0 ] &&
				pct=$(((du + ds) * 100000 / TK_HZ / elapsed))
		fi
		TK_PREV[$id]["$pid.u"]=$u
		TK_PREV[$id]["$pid.s"]=$s
		owner := tasks_ownername "$uid"
		TK[$id][$n]["pid"]=$pid
		TK[$id][$n]["name"]=$name
		TK[$id][$n]["owner"]=$owner
		TK[$id][$n]["cpu"]=$pct
		TK[$id][$n]["mem"]=${rss:-0}
		n=$((n + 1))
	done
	TK_PREV[$id]["t"]=$now
	TK[$id]["n"]=$n
}

# Insertion sort on whichever column, descending: n is at most a few
# hundred, and the list is nearly sorted from one scan to the next, which is
# exactly what this does least work on.
tasks_sort() {
	local id=$1 by=$2 n i j pid name owner cpu mem key

	n=${TK[$id]["n"]}
	i=1
	while [ "$i" -lt "$n" ]; do
		pid=${TK[$id][$i]["pid"]}
		name=${TK[$id][$i]["name"]}
		owner=${TK[$id][$i]["owner"]}
		cpu=${TK[$id][$i]["cpu"]}
		mem=${TK[$id][$i]["mem"]}
		key=${TK[$id][$i]["$by"]}
		j=$((i - 1))
		while [ "$j" -ge 0 ] && [ "${TK[$id][$j]["$by"]}" -lt "$key" ]; do
			TK[$id][$((j + 1))]["pid"]=${TK[$id][$j]["pid"]}
			TK[$id][$((j + 1))]["name"]=${TK[$id][$j]["name"]}
			TK[$id][$((j + 1))]["owner"]=${TK[$id][$j]["owner"]}
			TK[$id][$((j + 1))]["cpu"]=${TK[$id][$j]["cpu"]}
			TK[$id][$((j + 1))]["mem"]=${TK[$id][$j]["mem"]}
			j=$((j - 1))
		done
		TK[$id][$((j + 1))]["pid"]=$pid
		TK[$id][$((j + 1))]["name"]=$name
		TK[$id][$((j + 1))]["owner"]=$owner
		TK[$id][$((j + 1))]["cpu"]=$cpu
		TK[$id][$((j + 1))]["mem"]=$mem
		i=$((i + 1))
	done
}

# A value right-justified in a field w wide, never narrower than the value
# itself -- str pad only pads on the right, so a numeric column that wants
# its digits lined up on the right needs its own spaces put in front.
tasks_rjust() {
	local v=$1 w=$2 n sp

	n=$((w - ${#v}))

	[ "$n" -lt 0 ] && n=0
	sp := dt_rep "$n" " "
	ret "$sp$v"
}

# A byte count as people read one.
tasks_human() {
	local kb=$1
	if [ "$kb" -ge 1048576 ]; then
		ret "$((kb / 1048576)).$(((kb % 1048576) * 10 / 1048576))G"
	elif [ "$kb" -ge 1024 ]; then
		ret "$((kb / 1024)).$(((kb % 1024) * 10 / 1024))M"
	else
		ret "${kb}K"
	fi
}

tasks_open() {
	local id=$1
	TK[$id]["sel"]=0
	TK[$id]["top"]=0
	TK[$id]["by"]=cpu
	TK[$id]["full"]=0
}

# A process's whole command line, arguments and all, joined with plain
# spaces -- /proc/[pid]/cmdline is NUL-separated, and a hibr string ends
# at the first NUL like any C string, so it is read one field at a time
# instead of into one variable, which never has to hold the NULs at all.
# Linux only, and only for the rows actually on screen: forking to get
# this on every platform for every process, every scan, would cost far
# more than a handful of reads twice a second.
tasks_cmdline() {
	local pid=$1 out= part first=1

	[ "$TK_OS" = Linux ] || return 1
	while IFS= read -r -d '' part; do
		[ "$first" = 1 ] && first=0 || out="$out "
		out="$out$part"
	done < "/proc/$pid/cmdline" 2> /dev/null
	[ -z "$out" ] && return 1
	ret "$out"
}

# Columns: PID, Name, Owner, CPU%, Mem -- Name takes whatever is left
# once the other four fixed widths and the spaces between them are
# accounted for. Row 0 is the top border and row h-1 the bottom one,
# both dt_win's, so the list lives in rows 2..h-2 under a header at row 1.
tasks_draw() {
	local id=$1 h=$2 w=$3 i r t n vis top sel by now full
	local pidw=6 ownerw=8 owner pidtxt
	local namew=$((w - 2 - pidw - 1 - ownerw - 1 - 6 - 1 - 7 - 1)) cpu mem line
	local showgraph=1 graphh=2 leftw rightw lbl spark

	now := dt_ms
	by=${TK[$id]["by"]}
	if [ -z "${TK[$id]["scant"]}" ] ||
	   [ $((now - TK[$id]["scant"])) -ge "$TK_SCANMS" ]; then
		tasks_scan "$id"
		tasks_sort "$id" "$by"
		tasks_sysstat "$id"
		TK[$id]["scant"]=$now
		TK[$id]["sortby"]=$by
	elif [ "${TK[$id]["sortby"]}" != "$by" ]; then
		# A sort key change between scans still shows at once: sorting the
		# cached list is cheap, unlike the /proc scan that fills it.
		tasks_sort "$id" "$by"
		TK[$id]["sortby"]=$by
	fi
	n=${TK[$id]["n"]}
	vis=$((h - 3 - graphh))
	[ "$vis" -lt 1 ] && { vis=$((h - 3)); showgraph=0; }
	TK[$id]["vis"]=$vis
	top=${TK[$id]["top"]}
	sel=${TK[$id]["sel"]}
	[ "$sel" -ge "$n" ] && sel=$((n - 1)) && TK[$id]["sel"]=$sel
	[ "$sel" -lt 0 ] && sel=0

	full=${TK[$id]["full"]:-0}
	console pen "$DT_INK" "$DT_FACE" bold
	pidtxt := tasks_rjust PID "$pidw"
	t := str pad Name "$namew"
	owner := str pad Owner "$ownerw"
	cpu := tasks_rjust "CPU%" 6
	mem := tasks_rjust Mem 7
	console put -p "w$id" 1 1 "$pidtxt $t $owner $cpu $mem"

	i=$top
	r=2
	while [ "$r" -le $((vis + 1)) ]; do
		if [ "$i" -lt "$n" ]; then
			pidtxt := tasks_rjust "${TK[$id][$i]["pid"]}" "$pidw"
			t=
			[ "$full" = 1 ] && t := tasks_cmdline "${TK[$id][$i]["pid"]}"
			[ -z "$t" ] && t=${TK[$id][$i]["name"]}
			[ ${#t} -gt "$namew" ] && t="${t:0:$namew}"
			t := str pad "$t" "$namew"
			owner=${TK[$id][$i]["owner"]}
			[ ${#owner} -gt "$ownerw" ] && owner="${owner:0:$ownerw}"
			owner := str pad "$owner" "$ownerw"
			cpu="${TK[$id][$i]["cpu"]}%"
			cpu := tasks_rjust "$cpu" 6
			mem := tasks_human "${TK[$id][$i]["mem"]}"
			mem := tasks_rjust "$mem" 7
			line="$pidtxt $t $owner $cpu $mem"
		else
			line := str pad "" $((pidw + namew + ownerw + 17))
		fi
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			console pen "#1a202c" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" 1 "$line"
		i=$((i + 1))
		r=$((r + 1))
	done
	if [ "$showgraph" = 1 ]; then
		leftw=$(((w - 2 - 1) / 2))
		rightw=$((w - 2 - 1 - leftw))
		r=$((vis + 2))
		console pen "$DT_INK" "$DT_FACE"
		lbl := tasks_rjust "${TK[$id]["syscpu"]:-0}%" 4
		lbl := str pad "CPU $lbl" "$leftw"
		console put -p "w$id" "$r" 1 "$lbl"
		lbl := tasks_rjust "${TK[$id]["sysmem"]:-0}%" 4
		lbl := str pad "Mem $lbl" "$rightw"
		console put -p "w$id" "$r" $((leftw + 2)) "$lbl"
		spark := tasks_spark "$id" cpuh "$leftw"
		console put -p "w$id" $((r + 1)) 1 "$spark"
		spark := tasks_spark "$id" memh "$rightw"
		console put -p "w$id" $((r + 1)) $((leftw + 2)) "$spark"
	fi
	dt_want 500
}

tasks_end() {
	local id=$1 sig=$2 sel pid

	sel=${TK[$id]["sel"]}
	pid=${TK[$id][$sel]["pid"]}
	[ -n "$pid" ] && kill "-$sig" "$pid" 2> /dev/null
	return 0
}

tasks_key() {
	local id=$1 n vis

	n=${TK[$id]["n"]}
	vis=${TK[$id]["vis"]}
	local sel=${TK[$id]["sel"]} top=${TK[$id]["top"]}

	case $2 in
	up) sel=$((sel - 1)) ;;
	down) sel=$((sel + 1)) ;;
	x) tasks_end "$id" TERM; return 0 ;;
	shift-x) tasks_end "$id" KILL; return 0 ;;
	c) TK[$id]["by"]=cpu; return 0 ;;
	m) TK[$id]["by"]=mem; return 0 ;;
	n) TK[$id]["full"]=$((1 - ${TK[$id]["full"]:-0})); return 0 ;;
	*) return 1 ;;
	esac
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	TK[$id]["sel"]=$sel
	TK[$id]["top"]=$top
	return 0
}

tasks_click() {
	local id=$1 r=$2 top n i

	top=${TK[$id]["top"]}
	n=${TK[$id]["n"]}
	[ "$r" -lt 1 ] && return 0
	i=$((top + r - 1))
	[ "$i" -ge "$n" ] && return 0
	TK[$id]["sel"]=$i
}

# Set directly rather than through tasks_key: a menu item is not a key, and
# routing it through the key handler only worked here because "x" the key
# and "x" the argument happen to be the same string.
tasks_sortby() { TK[$1]["by"]=$2; }
tasks_fulltoggle() { TK[$1]["full"]=$((1 - ${TK[$1]["full"]:-0})); }

tasks_menus() {
	local full=${TK[$DT_FOCUS]["full"]:-0}

	dt_menu "Task"
	dt_item "Sort by CPU" c tasks_sortby "$DT_FOCUS" cpu
	dt_item "Sort by Memory" m tasks_sortby "$DT_FOCUS" mem
	dt_mark "Full Command Line" n "$full" tasks_fulltoggle "$DT_FOCUS"
	dt_sep
	dt_item "End Task" x tasks_end "$DT_FOCUS" TERM
	dt_item "End Task (force)" f tasks_end "$DT_FOCUS" KILL
}

if [ -z "$DT_ROWS" ]; then
	echo "tasks: this is a desktop app; open it from the hibr menu"
fi
