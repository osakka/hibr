#!/usr/bin/env hibr
#
# term -- a shell in a window, which is the last step of decision 0020.
#
# The window manager hands this app a rectangle and some keys; the term
# module runs a program on a pseudo terminal, keeps a picture of its screen
# and paints that picture into the rectangle. What runs inside is a real
# program with a real terminal: it edits its own line, draws its own colours
# and does not know it is in a window.
#
# Run on its own it just says what it would run, since there is no window to
# put it in.

strict

app term "A shell in a window"

# What the hibr menu shows, how big a new window is, and whether a second
# launch opens another window or brings this one forward.
command -v dt_app > /dev/null && dt_app term "Terminal" 14 52 many ">_"

need pty || { echo "term: no pty module" >&2; exit 1; }
need terminal || { echo "term: no terminal module" >&2; exit 1; }

# State is per window, not per app.
#
# Every callback is handed the window id, and everything an app remembers
# belongs under it. A global would be shared by every window of the same
# app -- which for a terminal means two windows showing one shell, mirroring
# each other keystroke for keystroke, and for a file browser means two
# windows that cannot be in different directories.
declare -gA TW
command -v dt_keepstate > /dev/null && dt_keepstate term TW
# What each window runs, as words rather than a string, so a command with
# quoted arguments survives: a test sets it to a /bin/sh with a known prompt.
[ -n "${TW_CMD[*]}" ] || TW_CMD=(hibr)

# What a window opened on a file runs: hibr's own editor, handed the path.
[ -n "${TW_EDIT[*]}" ] || TW_EDIT=(hibr -c 'mod load hvi && hvi "$1"' hvi)

# Named here only so `strict vars` and tests/strictvars.py can see it: every
# use below is an assignment *prefix* on the one command that forks, which
# is temporary and never becomes a global at all -- but a prefix and a plain
# assignment look the same to a reader of the source, and the checker is
# right to refuse what it cannot tell apart. Empty here, and hibr ignores an
# empty one.
HIBR_PROCTITLE=
# And the short name beside it, for the same reason: `ps` reads the one
# above and `top`, `pgrep` and `killall` read this, which the kernel keeps
# 15 usable bytes of (Gitea #168).
HIBR_PROCNAME=

# Whether a scrollbar is drawn down the right edge, showing how far back
# the view has scrolled through what term keeps -- and a real column of
# the pty spent on it, the same as an xterm's own gutter takes one. On by
# default, so scrollback shows as something there is; switched off, the
# program gets that column back, and $COLUMNS one wider.
DT_TERMBAR="${DT_TERMBAR-1}"
command -v dt_keep > /dev/null && dt_keep DT_TERMBAR

# Whether the window's title follows whatever the program inside reports
# through its own OSC 0/1/2 escape -- a shell's PS1 can set one with
# '\[\e]0;...\a\]', so "settable based on variables" is already the prompt's
# own escapes (\w for the working directory, \h for the host, and so on;
# see docs/interactive.md), not something new here. Shown as
# "Terminal [$reported]", not the bare report alone -- the window stays
# identifiable as a terminal no matter how the program names itself. On by
# default: once a program reports a title, it is more useful than the fixed
# one the menu opened the window with. A window opened on a file (term_open's
# own dt_retitle) is untouched by this as long as what runs there reports
# nothing, which is why closing a program-named window still shows the
# file's name in tests/apps.py's "opening a file opens a terminal window
# called by its name".
DT_TERMTITLE="${DT_TERMTITLE-1}"
command -v dt_keep > /dev/null && dt_keep DT_TERMTITLE

# How many rows and columns a new terminal window gives its program -- the
# classic 24 by 80 unless changed in the Terminal pane, shrunk to fit a
# smaller screen when it opens.
DT_TERMROWS="${DT_TERMROWS-24}"
DT_TERMCOLS="${DT_TERMCOLS-80}"
command -v dt_keep > /dev/null && dt_keep DT_TERMROWS
command -v dt_keep > /dev/null && dt_keep DT_TERMCOLS

# The window a new terminal needs for that: a border on every side, and the
# scrollbar's column when it is shown.
term_size() {
	local w=$((DT_TERMCOLS + 2))

	[ "$DT_TERMBAR" = 1 ] && w=$((w + 1))
	ret "$((DT_TERMROWS + 2)) $w"
}

# Whether a program inside a terminal window may set the clipboard with
# OSC 52 -- vim's yank to the + register, tmux's set-clipboard -- making it
# the desktop's clipboard and sending it on to the real terminal, and so to
# every machine attached. On by default, as tmux's own is; any program in a
# window can then overwrite the clipboard, which is what the switch is for.
# A program asking to read the clipboard is never answered.
DT_TERMCLIP="${DT_TERMCLIP-1}"
command -v dt_keep > /dev/null && dt_keep DT_TERMCLIP

# Copy on Select: releasing a mouse selection copies it, as in xterm, and
# leaves it lit to show what went; the next key only puts the highlight
# out, and is not sent to the program -- so the enter that follows a copy
# out of habit does not run a half-typed line. Off by default.
DT_TERMSELCOPY="${DT_TERMSELCOPY-0}"
command -v dt_keep > /dev/null && dt_keep DT_TERMSELCOPY


# Whose colours a terminal window's default text and background are:
# "theme" paints them in the desktop's own ink and face, like every other
# window, and tells a program that asks (OSC 10/11) what they are, so one
# that picks a light or dark scheme for itself picks the right one;
# "terminal" leaves them to the real terminal the desktop runs in, which
# nothing here can see, so such a question goes unanswered.
DT_TERMCOLOURS="${DT_TERMCOLOURS-theme}"
command -v dt_keep > /dev/null && dt_keep DT_TERMCOLOURS

# What a window does when the program in it ends: success closes it when
# the program succeeded (and keeps one double-clicked open, to show what
# it printed), always closes it however it ended, never keeps it open to
# show the status. A shell's window closes whatever this says: ctrl-d and
# exit mean "done".
DT_TERMEND="${DT_TERMEND-success}"
command -v dt_keep > /dev/null && dt_keep DT_TERMEND

# The colours to hand the emulator for the setting above, or "off".
tw_colours() {
	if [ "$DT_TERMCOLOURS" = theme ] &&
	   match "$DT_INK" '^#[0-9a-fA-F]{6}$' &&
	   match "$DT_FACE" '^#[0-9a-fA-F]{6}$'; then
		ret "$DT_INK $DT_FACE"
	else
		ret off
	fi
}

# Start the program the first time there is a window to put it in, and keep
# its size in step with the window afterwards.
fn tw_fit(int id, int h, int w) {
	local n i fd pt pn
	local -a cmd

	[ "$h" -lt 1 ] || [ "$w" -lt 1 ] && return 1
	# What this window's own program is called in ps, for anyone looking
	# for it from outside: the window's title and its id, which is the
	# handle `desktop ctl windows` lists it under. Only a hibr child
	# wears it -- hibr reads HIBR_PROCTITLE at startup and removes it, so
	# a window running vim shows vim, which is what a person wants
	# anyway (Gitea #111). Four shells in four windows all read `hibr`
	# before this.
	pt := dt_title "$id"
	# Two names, because `ps` and `top` read different things and the
	# second one gets 15 bytes (Gitea #168). The long one is the sentence;
	# the short one is role first -- `term:Files:3` -- so a person
	# scanning `top` sees which window each shell belongs to instead of
	# `desktop [Termin` cut mid-word, and `pgrep term:` finds them all.
	#
	# The id goes last and is never dropped: it is the handle
	# `desktop ctl windows` lists the window under, so it is the part that
	# identifies it even when the title has to be cut to fit.
	pn := dt_shortname term "$pt" "$id"
	pt="desktop [$pt $id]"
	if [ -z "${TW[$id]["t"]}" ]; then
		if [ -n "${TW[$id]["argvn"]}" ]; then
			n=${TW[$id]["argvn"]}
			i=0
			while [ "$i" -lt "$n" ]; do
				cmd+=("${TW[$id]["arg$i"]}")
				i=$((i + 1))
			done
			if [ "${TW[$id]["selfrun"]}" = 1 ]; then
				TW[$id]["t"] := HIBR_PROCTITLE="$pt" HIBR_PROCNAME="$pn" term open \
					-r "$h" -c "$w" "${cmd[@]}" || return 1
			else
				TW[$id]["t"] := HIBR_PROCTITLE="$pt" HIBR_PROCNAME="$pn" term open \
					-r "$h" -c "$w" "${cmd[@]}" \
					"${TW[$id]["file"]}" || return 1
			fi
		elif [ -n "${TW[$id]["file"]}" ]; then
			TW[$id]["t"] := HIBR_PROCTITLE="$pt" HIBR_PROCNAME="$pn" term open -r "$h" \
				-c "$w" "${TW_EDIT[@]}" \
				"${TW[$id]["file"]}" || return 1
		else
			TW[$id]["t"] := HIBR_PROCTITLE="$pt" HIBR_PROCNAME="$pn" term open -r "$h" \
				-c "$w" "${TW_CMD[@]}" || return 1
		fi
		[ -n "$DT_CURSOR" ] && term cursor "${TW[$id]["t"]}" "$DT_CURSOR"
		TW[$id]["h"]=$h
		TW[$id]["w"]=$w
		# console key's own wait now watches this pty's master fd
		# alongside real input, so the desktop wakes the instant the
		# program inside writes something -- a key's echo included --
		# rather than only finding out on its next scheduled redraw.
		# This replaced a dt_want 30 fired for 200ms after every key,
		# a guess at how long an echo takes that was either too slow
		# (nothing yet) or wasteful (polling after it had already
		# arrived); unwatched again in term_close.
		fd := term fd "${TW[$id]["t"]}"
		if [ -n "$fd" ] && [ "$fd" -ge 0 ]; then
			TW[$id]["fd"]=$fd
			command -v console > /dev/null && console watch "$fd"
		fi
		return 0
	fi
	if [ "$h" != "${TW[$id]["h"]}" ] || [ "$w" != "${TW[$id]["w"]}" ]; then
		term size "${TW[$id]["t"]}" "$h" "$w"
		TW[$id]["h"]=$h
		TW[$id]["w"]=$w
	fi
	return 0
}

fn term_draw(int id, int h, int w, int row, int col) {
	local t st sb cur=0 ms tw view stored n want rgb c note ttl

	tw=$w
	# A visible scrollbar costs the program inside a real column, not just
	# a drawn one: with DT_TERMBAR on, the pty itself is one narrower, the
	# same way an xterm's own scrollbar takes a fixed gutter rather than
	# only appearing (and only then resizing the program under it) once
	# there is something to scroll back through.
	[ "$DT_TERMBAR" = 1 ] && [ "$tw" -gt 1 ] && tw=$((w - 1))
	tw_fit "$id" "$h" "$tw" || return 0
	t=${TW[$id]["t"]}
	# Only when the setting or the theme has changed since this window
	# last told the emulator: a theme switch reaches every open terminal
	# on its next frame.
	want := tw_colours
	if [ "$want" != "${TW[$id]["rgb"]}" ]; then
		TW[$id]["rgb"]=$want
		read -ra rgb <<< "$want"
		term colors "$t" "${rgb[@]}"
	fi
	term poll "$t" 0
	if ! term alive "$t"; then
		# A master whose program has gone reads as ready for ever, so a
		# window left showing an exit status stops being watched, or the
		# desktop wakes on it continuously and holds a core.
		if [ -n "${TW[$id]["fd"]}" ]; then
			command -v console > /dev/null && console unwatch "${TW[$id]["fd"]}"
			TW[$id]["fd"]=
		fi
		# A shell -- a plain terminal, or Terminal Here -- closes its window
		# however it ended: ctrl-d and exit mean "done", and the status a
		# shell leaves is only its last command's, so one mistyped command
		# would otherwise leave "exited 127" on a window closed on purpose.
		# A program does what DT_TERMEND says: by default it closes on
		# success and stays to show why it failed.
		st := term status "$t"
		if term_isshell "$id" || [ "$DT_TERMEND" = always ] ||
		   { [ "$DT_TERMEND" != never ] && [ "$st" = 0 ] &&
		     [ "${TW[$id]["selfrun"]}" != 1 ]; }; then
			dt_wantclose "$id"
			return 0
		fi
		console pen "$DT_BAD" "$DT_FACE"
		dt_tput "$id" 1 2 "[exited %s — close this window]" "$st"
		return 0
	fi
	if [ "$DT_TERMTITLE" = 1 ]; then
		n := term title "$t"
		if [ -n "$n" ] && [ "$n" != "${TW[$id]["ptitle"]}" ]; then
			TW[$id]["ptitle"]="$n"
			command -v dt_retitle > /dev/null && dt_retitle "$id" "Terminal [$n]"
		fi
	fi
	if c := term clip "$t" && [ "$DT_TERMCLIP" = 1 ]; then
		if command -v dt_clipset > /dev/null; then
			dt_clipset "$c"
		else
			DT_CLIP=$c
			DT_CLIPOP=copy
			DT_CLIPKIND=text
			console clip "$c"
		fi
	fi
	# A bell rings on the real terminal, and marks the window's title
	# with a dot until it has focus; a notification is the desktop's own
	# -- clicking it brings the window up -- and is sent on to the real
	# terminal as well.
	if term bell "$t"; then
		console bell
		if [ "$DT_FOCUS" != "$id" ] && [ "${TW[$id]["rang"]}" != 1 ]; then
			TW[$id]["rang"]=1
			dt_retitle "$id" "${GL[bullet]} ${DT[$id]["title"]}"
		fi
	fi
	if [ "$DT_FOCUS" = "$id" ] && [ "${TW[$id]["rang"]}" = 1 ]; then
		TW[$id]["rang"]=
		dt_retitle "$id" "${DT[$id]["title"]#${GL[bullet]} }"
	fi
	while note := term note "$t"; do
		ttl=${note%%$'\t'*}
		note=${note#*$'\t'}
		[ -n "$ttl" ] || ttl=${DT[$id]["title"]#${GL[bullet]} }
		DT_NOTEFROM=$ttl
		dt_notify "$note" dt_raise "$id"
		console notify "$ttl: $note"
	done
	[ "$DT_FOCUS" = "$id" ] && cur=1
	# A program that asked for focus reports (mode 1004) hears when its
	# window gains or loses the keyboard; the module sends nothing unless
	# it asked, so this only has to notice the change.
	if [ "$cur" != "${TW[$id]["foc"]}" ]; then
		TW[$id]["foc"]=$cur
		term focus "$t" "$cur"
	fi
	if [ "$cur" = 1 ] && [ "$DT_CURSOR_BLINK" = 1 ]; then
		ms := dt_ms
		[ $(((ms / 500) % 2)) = 1 ] && cur=0
		dt_want $((500 - ms % 500 + 5))
	fi
	term draw "$t" 1 1 "$h" "$tw" "$cur" -p "w$id"
	# What this frame drew, for term_dirty to compare next time.
	TW[$id]["gen"] := term gen "$t"
	TW[$id]["drawnfoc"]=0
	[ "$DT_FOCUS" = "$id" ] && TW[$id]["drawnfoc"]=1
	TW[$id]["drawnh"]=${DT[$id]["h"]}
	TW[$id]["drawnw"]=${DT[$id]["w"]}
	sb := term scroll "$t"
	TW[$id]["drawnview"]=$sb
	view=${sb% *}
	stored=${sb#* }
	if [ "$view" != 0 ]; then
		console pen "$DT_FACE" "$DT_WARN" bold
		sb=" ${GL[arrowup]} $view of $stored "
		console put -p "w$id" 1 $((tw + 1 - ${#sb})) "$sb"
	fi
	# tw columns is all the pty was given, so its own content never
	# reaches column w (pane-relative) at all when the two differ -- that
	# is the one column DT_TERMBAR bought back, and the only place the
	# scrollbar draws.
	[ "$DT_TERMBAR" = 1 ] &&
		dt_scrollbar "$id" 1 "$w" "$h" $((stored + h)) "$h" \
			$((stored - view))
	return 0
}

# Everything goes to the program except the window manager's Menu Bar key,
# which it keeps so there is always a way back to the menu bar, and the
# Terminal Page Back and Page On shortcuts (shift with pageup or pagedown
# unless changed), which page through the scrollback as they do in xterm.
# Any other key goes back to the live screen on its way through.
fn term_key(int id, key) {
	local t=${TW[$id]["t"]} h=${TW[$id]["h"]}

	if dt_has dt_keyis; then
		if dt_keyis scrollup "$key"; then
			term scroll "$t" $((h - 1))
			return 0
		fi
		if dt_keyis scrolldown "$key"; then
			term scroll "$t" $((1 - h))
			return 0
		fi
	fi
	if [ "$DT_TERMKEEP" = 1 ] && [ "${TW[$id]["passall"]}" != 1 ] &&
	   dt_has dt_keyassigned && dt_keyassigned "$key"; then
		return 1
	fi
	if [ "${TW[$id]["held"]}" = 1 ]; then
		TW[$id]["held"]=
		term select "$t" none
		return 0
	fi
	term key "$t" "$key"
}

# The mouse belongs to the program when it has asked for it -- vi, htop and
# mc all do -- and the window manager keeps sending a press's drag and
# release here until the button comes up.  The window's body starts at row
# and column 1, the program's screen at 0.
#
# Otherwise the left button selects, as in any terminal: press, drag,
# release, and alt-c or Edit > Copy takes it -- or the release itself, with
# Copy on Select (DT_TERMSELCOPY).  Holding shift selects even
# when the program has the mouse, which is xterm's way out of the same bind.
fn term_mouse(int id, act, btn, int r, int c, mods) {
	local t=${TW[$id]["t"]} mode

	[ -n "$t" ] || return 0
	mode := term mouse "$t"
	if [ "$mode" != off ]; then
		case $mods in
		*shift*) ;;
		*)
			term mouse "$t" "$act" "$btn" $(($r - 1)) $(($c - 1))
			return 0
			;;
		esac
	fi
	# A context menu, not the desktop's generic one: the program has not
	# asked for the mouse, the same condition that lets left selection
	# work below, so this is the one place that can tell right-click from
	# a program wanting it for its own use.
	if [ "$btn" = right ] && [ "$act" = press ]; then
		dt_context_open term "$id" \
			$((${DT[$id]["row"]} + $r)) $((${DT[$id]["col"]} + $c))
		return 0
	fi
	[ "$btn" = left ] || return 0
	case $act in
	press)
		TW[$id]["held"]=
		term select "$t" start $(($r - 1)) $(($c - 1))
		;;
	drag) term select "$t" to $(($r - 1)) $(($c - 1)) ;;
	release)
		term select "$t" to $(($r - 1)) $(($c - 1))
		[ "$DT_TERMSELCOPY" = 1 ] && term_selcopy "$id"
		;;
	esac
	return 0
}

# Copy on Select: what was just selected, copied and kept lit until the
# next key. A click with no drag selects nothing and copies nothing.
fn term_selcopy(int id) {
	local x

	x := term copy "${TW[$id]["t"]}" 2> /dev/null || return 0
	[ -n "$x" ] || return 0
	dt_edit copy
	TW[$id]["held"]=1
}

# The Window menu's tick for one terminal window: pass it every key, the
# desktop's own chords included, whatever DT_TERMKEEP says.
fn term_passall(int id) {
	if [ "${TW[$id]["passall"]}" = 1 ]; then
		TW[$id]["passall"]=
		dt_notep low "This window: desktop shortcuts work again"
	else
		TW[$id]["passall"]=1
		dt_notep low "This window: every key goes to the program"
	fi
}

# Right-click in the terminal's body, when the program has not grabbed the
# mouse for itself. Copy and Paste are dt_edit's, the same as the Edit
# menu's own items: it already puts a copy on the clipboard and shows the
# note that says so.
fn term_context(int? id = "") {
	local t=${TW[$id]["t"]}

	dt_menu "Terminal"
	if [ -n "$t" ]; then
		dt_item "Copy" c dt_edit copy
		dt_item "Paste" v dt_edit paste
		dt_sep
		dt_item "Send Interrupt" i term key "$t" ctrl-c
	else
		dt_dim "Not started"
	fi
}

# What is selected, for the desktop's Copy.
fn term_copy(int id) {
	local t=${TW[$id]["t"]} x

	[ -n "$t" ] || return 1
	x := term copy "$t" || return 1
	ret "$x"
}

# Paste as the terminal's own paste arrives: bracketed, when the program
# asked for that, so a shell does not run each line as it lands.
fn term_paste(int id, text, op) {
	[ -n "${TW[$id]["t"]}" ] && term key "${TW[$id]["t"]}" "paste $text"
	return 0
}

# The wheel goes to a program that asked for the mouse.  Otherwise, on the
# alternate screen it is arrow keys, which is how less and man scroll in
# every terminal that does this; on the main screen it scrolls back.
fn term_wheel(int id, dir, int r, int c) {
	local t=${TW[$id]["t"]} s k

	[ -n "$t" ] || return 0
	term mouse "$t" "wheel$dir" $(($r - 1)) $(($c - 1)) && return 0
	s := term screen "$t"
	if [ "$s" = alt ]; then
		for k in 1 2 3; do term key "$t" "$dir"; done
	elif [ "$dir" = up ]; then
		term scroll "$t" 3
	else
		term scroll "$t" -3
	fi
}

# Whether a window runs an interactive shell rather than a program: one
# opened as a shell (Terminal Here), or a plain terminal -- no file, no
# command given -- whose TW_CMD is a shell on its own; TW_CMD set to
# anything else is a program like any other.
fn term_isshell(int id) {
	local c

	[ "${TW[$id]["shell"]}" = 1 ] && return 0
	[ -z "${TW[$id]["file"]}" ] && [ -z "${TW[$id]["argvn"]}" ] &&
		[ "${TW[$id]["selfrun"]}" != 1 ] || return 1
	[ "${#TW_CMD[@]}" = 1 ] || return 1
	c=${TW_CMD[0]##*/}
	case ${c#-} in
	hibr | bash | zsh | sh | dash | ksh | mksh | fish | tcsh | csh) return 0 ;;
	esac
	return 1
}

# A window opened on a file edits it, and is called what it shows.  Opened
# through a registered handler that wanted a terminal, DT_OPENCMD carries
# what runs instead of hvi -- read once, here, and cleared, so the next
# ordinary terminal or file does not inherit it.
fn term_open(int id, arg) {
	local n i

	TW[$id]["file"]=$arg
	if [ "${#DT_OPENCMD[@]}" -gt 0 ]; then
		n=${#DT_OPENCMD[@]}
		i=0
		while [ "$i" -lt "$n" ]; do
			TW[$id]["arg$i"]="${DT_OPENCMD[$i]}"
			i=$((i + 1))
		done
		TW[$id]["argvn"]=$n
		DT_OPENCMD=()
	fi
	TW[$id]["selfrun"]=$DT_OPENSELF
	TW[$id]["shell"]=$DT_OPENSHELL
	DT_OPENSELF=
	DT_OPENSHELL=
	if [ -n "$arg" ]; then
		command -v dt_retitle > /dev/null &&
			dt_retitle "$id" "Terminal [${arg##*/}]"
	fi
	return 0
}

# Files dropped on a terminal are typed in as their paths, each quoted for a
# shell and followed by a space, ready to be the arguments of something.
fn term_drop(int id, int r, int c, op, ...paths) {
	local t=${TW[$id]["t"]} q p out=

	[ -n "$t" ] || return 0
	for p in "${paths[@]}"; do
		printf -v q '%q' "$p"
		out="$out$q "
	done
	term write "$t" "$out"
}

fn term_close(int id) {
	if [ -n "${TW[$id]["fd"]}" ]; then
		command -v console > /dev/null && console unwatch "${TW[$id]["fd"]}"
	fi
	[ -n "${TW[$id]["t"]}" ] && term close "${TW[$id]["t"]}"
	TW[$id]["t"]=
	TW[$id]["fd"]=
}

# Unseen -- minimised, or on another workspace -- the program's output is
# still read, so the screen is current when the window comes back and the
# pty does not keep waking the desktop. A program that has ended stops
# being watched here too; the window says so when it is next drawn.
# Whether this terminal has any reason to be drawn again. The emulator
# counts what it has been fed (term gen), so the same answer twice running
# means nothing on its screen can have moved. A focused one is always drawn,
# because its cursor blinks in it; one that has just lost focus is drawn
# once more to take the cursor away. A terminal with no program yet has to
# be drawn, since tw_fit is what starts it.
fn term_dirty(int id) {
	local t=${TW[$id]["t"]} g v foc=0

	# No program yet: tw_fit is in _draw and is what starts one.
	[ -n "$t" ] || return 0
	# One that has ended has its exit line to put up.
	term alive "$t" || return 0
	[ "$DT_FOCUS" = "$id" ] && foc=1
	# A blinking cursor's own dt_want is in _draw, so saying clean here
	# would stop it blinking while Control Panel > Terminal went on
	# saying Cursor Blink was on. With it off -- the default -- a focused
	# terminal differs from any other only in where its cursor is, which
	# the count below already notices.
	[ "$foc" = 1 ] && [ "$DT_CURSOR_BLINK" = 1 ] && return 0
	# The cursor goes when focus does, and comes back with it.
	[ "$foc" = "${TW[$id]["drawnfoc"]:-0}" ] || return 0
	[ "${TW[$id]["drawnh"]}" = "${DT[$id]["h"]}" ] || return 0
	[ "${TW[$id]["drawnw"]}" = "${DT[$id]["w"]}" ] || return 0
	g := term gen "$t"
	[ "$g" = "${TW[$id]["gen"]}" ] || return 0
	# Scrolled back: the wheel does that without focus and without the
	# program writing a byte.
	v := term scroll "$t"
	[ "$v" = "${TW[$id]["drawnview"]}" ] || return 0
	return 1
}

fn term_idle(int id) {
	local t=${TW[$id]["t"]}

	[ -n "$t" ] || return 0
	# Both calls, deliberately: term poll fails only when its own read
	# failed, and a program that has exited leaving output buffered polls
	# perfectly well -- so only term alive notices it has gone, and a pty
	# whose program is gone stays ready for ever and spins the desktop.
	# Measured: dropping the second call saved nothing anyway.
	term poll "$t" 0
	term alive "$t" && return 0
	if [ -n "${TW[$id]["fd"]}" ]; then
		command -v console > /dev/null && console unwatch "${TW[$id]["fd"]}"
		TW[$id]["fd"]=
	fi
	return 0
}

# Restart Desktop: the program keeps running, so write down its pty's
# descriptor and pid for the next desktop to adopt, and its screen and
# scrollback to load. A program that has ended is not kept.
fn term_stash(int id, dir) {
	local t=${TW[$id]["t"]} f="$dir/term-$id.save" fd pid

	TW[$id]["rfd"]=
	[ -n "$t" ] && term alive "$t" || return 0
	fd := term fd "$t"
	pid := term pid "$t"
	term save "$t" "$f" || return 0
	TW[$id]["rfd"]=$fd
	TW[$id]["rpid"]=$pid
	TW[$id]["rsave"]=$f
	dt_rscarry "$fd" "$pid"
	dt_rslog "term $id: saved fd=$fd pid=$pid"
}

# Take the program back after a restart, as it was; with nothing to take
# back, the window starts a new one when it is next drawn.
fn term_resume(int id) {
	local fd=${TW[$id]["rfd"]} p t
	local h=${TW[$id]["h"]} w=${TW[$id]["w"]}

	TW[$id]["t"]=
	TW[$id]["fd"]=
	TW[$id]["rfd"]=
	dt_rslog "term $id: restoring fd=$fd pid=${TW[$id]["rpid"]} h=$h w=$w"
	[ -n "$fd" ] || return 0
	p := pty adopt "$fd" "${TW[$id]["rpid"]}" "$h" "$w" || return 0
	if ! t := term adopt -r "$h" -c "$w" "$p" "${TW[$id]["rsave"]}"; then
		pty close "$p"
		return 0
	fi
	TW[$id]["t"]=$t
	TW[$id]["fd"]=$fd
	dt_rsclaim "$fd"
	[ -n "$DT_CURSOR" ] && term cursor "$t" "$DT_CURSOR"
	command -v console > /dev/null && console watch "$fd"
	return 0
}

# The window's title follows whatever the program calls itself.
term_menus() {
	local t n

	t=${TW[$DT_FOCUS]["t"]}
	dt_menu "File"
	dt_item "New Window" n dt_launch term
	dt_sep
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "Shell"
	if [ -n "$t" ]; then
		n := term title "$t"
		if [ -n "$n" ]; then
			dt_dim "${n:0:24}"
			dt_sep
		fi
		dt_item "Send Interrupt" i term key "$t" ctrl-c
		dt_item "Send End Of File" d term key "$t" ctrl-d
		dt_sep
		dt_item "Scroll To Top" t term scroll "$t" top
		dt_item "Scroll To Bottom" b term scroll "$t" bottom
	else
		dt_dim "Not started"
	fi
}

if [ -z "$DT_ROWS" ]; then
	echo "term: would run ${TW_CMD[*]}"
	echo "term: this is a desktop app; open it from the hibr menu"
fi
