# widgets/scrollbar -- a vertical scrollbar.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict functions vars

# A vertical scrollbar: a track of │ over h rows starting at row0, one
# cell shown as the thumb █ at a position proportional to how far through
# total the view already is. shown is how many of total are visible at
# once; nothing is drawn when everything already is, the same as a
# checkbox or a dropdown draws nothing it was not asked for. The shape
# the file browser's own list view and a terminal's scrollback both need,
# so a fix or a restyle is one place, not two.
fn dt_scrollbar(id, row0, col, h, total, shown, pos) {
	local thumb r

	[ "$total" -gt "$shown" ] || return 0
	thumb=$((row0 + pos * (h - 1) / (total - shown)))
	[ "$thumb" -ge $((row0 + h)) ] && thumb=$((row0 + h - 1))
	r=$row0
	while [ "$r" -lt $((row0 + h)) ]; do
		if [ "$r" = "$thumb" ]; then
			console pen "#63b3ed" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "█"
		else
			console pen "#2d3748" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "│"
		fi
		r=$((r + 1))
	done
}
