#!/usr/bin/env hibr
#
# tasks -- what is running, and a way to end one of them.
#
# On Linux, reads /proc directly, the same technique mods/mon and the about
# window both use: no forking, and no dependency on anything but the kernel
# giving a truthful /proc. Elsewhere, one ps -axo per scan, since there is
# no /proc to read there at all -- ps already computes %CPU itself, so
# there is no delta of its own to keep between scans, unlike the Linux path.
# Sorted by CPU or memory, x or Task > End Task sends the selected one
# SIGTERM, shift-x sends SIGKILL.

strict

app tasks "What is running, and a way to end one"

command -v dt_app > /dev/null && dt_app tasks "Task Manager" 16 50 once "▤"

# A small read-only window for one process's own details -- opened
# directly on the row a right-click landed on, the same way Get Info
# opens on a file, and hidden for the same reason theirs is: nothing
# about it makes sense launched with no process to show.
command -v dt_app > /dev/null && dt_app tdetail "Process Details" 11 56 \
	"" "" fixed hidden

declare -gA TK
declare -gA TD
declare -gA TK_PREV
declare -gA TK_UIDNAME
declare -gA TK_KIN
declare -gA TK_PPID
TK_OS=
TK_ME=

# uid -> name, from /etc/passwd directly -- no fork, matching how the
# rest of a Linux scan already avoids one. Reloaded every scan: reading
# a few dozen lines once a second costs nothing worth caching further,
# and a user added since the window opened still resolves.
tasks_loadusers() {
	local name uid _

	TK_UIDNAME=()
	while IFS=: read -r name _ uid _; do
		TK_UIDNAME["$uid"]=$name
	done < /etc/passwd
}

# A uid as the name it resolves to, or itself when nothing does -- a
# user removed after their process started, most often.
fn tasks_ownername(int uid) {
	ret "${TK_UIDNAME["$uid"]:-$uid}"
}

# The two sparklines at the bottom -- one label row, one glyph row, each
# glyph one of eight block heights, most recent sample on the right, the
# same look tmux's own graphs use. History is kept independent of the
# window's current width (samples are trimmed to fit at draw time, not
# at collection time), so a resize never throws a real sample away.
TK_HISTMAX=120
TK_SPARK=("${GL[spark1]}" "${GL[spark2]}" "${GL[spark3]}" "${GL[spark4]}" "${GL[spark5]}" "${GL[spark6]}" "${GL[spark7]}" "${GL[spark8]}")

# Append one value, shifting the oldest out once TK_HISTMAX is reached.
# Once a second (TK_SCANMS), never once a frame, so an O(n) shift over
# at most 120 entries costs nothing worth avoiding.
fn tasks_pushhist(int id, key, int val) {
	local n i

	n=${TK[$id]["${key}n"]:-0}
	if [ "$n" -ge "$TK_HISTMAX" ]; then
		i=0
		while [ "$i" -lt $((n - 1)) ]; do
			TK[$id]["$key"][$i]=${TK[$id]["$key"][$((i + 1))]}
			i=$((i + 1))
		done
		n=$((n - 1))
	fi
	TK[$id]["$key"][$n]=$val
	TK[$id]["${key}n"]=$((n + 1))
}

# The last w samples of a history, as glyphs, oldest first -- padded with
# blanks on the left so a history shorter than the graph still sits
# against the right edge, where "now" belongs.
fn tasks_spark(int id, key, int w) {
	local n i v lvl out=

	n=${TK[$id]["${key}n"]:-0}
	i=$((n - w))
	[ "$i" -lt 0 ] && i=0
	while [ "$i" -lt "$n" ]; do
		v=${TK[$id]["$key"][$i]}
		lvl=$((v * 8 / 101))
		[ "$lvl" -gt 7 ] && lvl=7
		[ "$lvl" -lt 0 ] && lvl=0
		out="$out${TK_SPARK[$lvl]}"
		i=$((i + 1))
	done
	while [ "${#out}" -lt "$w" ]; do out=" $out"; done
	ret "$out"
}

# Overall CPU% and memory% used. ps -axo's own %CPU is per process, not a
# system total, and there is no single ps column this could sum into one
# honestly, so a system-wide reading needs its own source on every
# platform.
#
# Linux: /proc/stat's own first line is every core already summed by the
# kernel; delta of idle over delta of the whole line since the last scan
# is exactly what top's own headline percentage is. Memory: MemAvailable
# already accounts for reclaimable cache the way a plain MemFree does
# not, which is the same number free(1) reports as "available".
#
# macOS: the darwin module's own host_statistics(3) calls, if it loaded --
# the same two CPU counters diffed the same way, and a ready memory
# percentage already computed on free+inactive, about.hibr's own
# equivalent formula. Without it, the graphs stay flat at 0 rather than
# reading something platform doesn't offer.
fn tasks_sysstat(int id) {
	local line rest v total=0 idle du_total du_idle raw f
	local k mtotal= mavail=

	if [ "$TK_OS" = Linux ]; then
		read -r line 2> /dev/null < /proc/stat
		rest=${line#cpu }
		read -ra f <<< "$rest"
		idle=${f[3]:-0}
		for v in "${f[@]}"; do total=$((total + v)); done
		if [ -n "${TK_PREV[$id]["cput"]}" ]; then
			du_total=$((total - TK_PREV[$id]["cput"]))
			du_idle=$((idle - TK_PREV[$id]["cpui"]))
			[ "$du_total" -gt 0 ] &&
				TK[$id]["syscpu"]=$(((du_total - du_idle) * 100 / du_total))
		fi
		TK_PREV[$id]["cput"]=$total
		TK_PREV[$id]["cpui"]=$idle
		while read -r k v _; do
			case $k in
			MemTotal:) mtotal=$v ;;
			MemAvailable:) mavail=$v ;;
			esac
		done < /proc/meminfo
		[ -n "$mtotal" ] && [ "$mtotal" -gt 0 ] &&
			TK[$id]["sysmem"]=$(((mtotal - ${mavail:-0}) * 100 / mtotal))
	elif need darwin; then
		raw := darwin cpu
		read -r total idle <<< "$raw"
		if [ -n "${TK_PREV[$id]["cput"]}" ]; then
			du_total=$((total - TK_PREV[$id]["cput"]))
			du_idle=$((idle - TK_PREV[$id]["cpui"]))
			[ "$du_total" -gt 0 ] &&
				TK[$id]["syscpu"]=$(((du_total - du_idle) * 100 / du_total))
		fi
		TK_PREV[$id]["cput"]=$total
		TK_PREV[$id]["cpui"]=$idle
		TK[$id]["sysmem"] := darwin mem
	fi
	tasks_pushhist "$id" cpuh "${TK[$id]["syscpu"]:-0}"
	tasks_pushhist "$id" memh "${TK[$id]["sysmem"]:-0}"
}

# CLK_TCK is 100 on every Linux this was run on; getconf forks, and the
# kernel does not expose it any other way worth reading for this.
TK_HZ=100

# A full scan opens two files per process. Scanning on every redraw cost 40%
# of a core on this machine's real process count, measured at the DT_TICK=60
# the test suite uses to run fast, which is not the default: at the real
# 200ms default, redrawing without rescanning is what makes an open window
# cost 5.8% instead, rescanning once a second (what top and htop default to
# as well) 7.6%. Only the visible rows are formatted on a redraw that finds
# nothing new to scan.
TK_SCANMS="${TK_SCANMS-1000}"
command -v dt_keep > /dev/null && dt_keep TK_SCANMS

# The order a new window's list starts in -- a column (pid, name, owner,
# cpu, mem) and a direction (asc, desc) -- and whether the list has a
# scrollbar in its right margin. Clicking a column heading changes one
# window's order without changing these.
TK_SORTBY="${TK_SORTBY-cpu}"
TK_SORTDIR="${TK_SORTDIR-desc}"
TK_BAR="${TK_BAR-1}"
TK_COLS=(pid name owner cpu mem)

# Whose processes the list shows: everyone's, only this user's own, or only
# this desktop's -- the desktop process and everything descended from it,
# which is its terminal windows' shells and whatever they are running. The
# apps are not processes of their own and cannot be filtered for as such:
# Files, the Calculator and the rest are functions inside the one desktop,
# which is what makes them cost nothing to have open.
#
# The figures under the graphs stay whole-machine whichever is chosen --
# they say what the machine is doing, not what this list adds up to -- and
# the window's own title says which filter is in force, so a list that is
# short is never mysteriously short.
TK_FILTER="${TK_FILTER-everyone}"
TK_FILTERS=(everyone mine desktop)
if command -v dt_keep > /dev/null; then
	dt_keep TK_SORTBY
	dt_keep TK_SORTDIR
	dt_keep TK_BAR
	dt_keep TK_FILTER
fi

# Name and CPU times, both from the one read of /proc/[pid]/stat -- status
# was being read for the name alongside rss and uid, for a field the stat
# read already had on the same line for free. rss stays out of this: its
# own field here (24) is documented by proc(5) itself as inaccurate ("see
# /proc/[pid]/statm"), and status's VmRSS is the one already trusted
# everywhere else this shows memory, not something to trade for speed
# silently.
#
# The command name is in parens and may itself contain both parens and
# spaces -- found between the first "(" (pid, just above, is always a
# plain number, so nothing before it can be one) and the last ")", never
# the first, the same trap as before. Returned last, in the same
# last-variable-takes-the-rest shape tasks_scan_ps's own comm already
# relies on, so a name with a real space in it is never split across two
# fields the way u/s (never containing one) safely can be -- status's own
# Name: field actually had this bug already, silently truncating at the
# first space; nothing before this depended on a name ever having one.
fn tasks_times(int pid) {
	local line name rest
	local state a b c d e f g h j k u s _

	read -r line 2> /dev/null < "/proc/$pid/stat" || return 1
	name=${line%)*}
	name=${name#*\(}
	rest=${line##*)}
	read -r state a b c d e f g h j k u s _ <<< "$rest"
	ret "$u $s $name"
}

# uid and rss, from status -- breaking out once both are found rather than
# reading to the end of a ~50-line file for two, which is most of what
# this file's own scan still costs (VmRSS is well down the file; Uid is
# not, but the loop cannot stop until the later of the two either way).
fn tasks_uidrss(int pid) {
	local k v uid= rss=

	while read -r k v _; do
		case $k in
		Uid:) uid=$v ;;
		VmRSS:) rss=$v ;;
		esac
		[ -n "$uid" ] && [ -n "$rss" ] && break
	done 2> /dev/null < "/proc/$pid/status"
	ret "$uid ${rss:-0}"
}

# One pass: every pid under /proc, its name and memory from status (no
# bracket or position traps there), CPU from the delta against the last
# scan. The first scan has nothing to compare against, so it reads 0.
# Every process from ps -axo, one line each: pid, RSS in the same
# kilobytes /proc/[pid]/status uses, %CPU already computed by the kernel,
# user (ps resolves it itself here, unlike the Linux path's own uid), and
# comm last so a path with a space in it -- an app bundle's, typically --
# still reads whole, in read's own last-variable-takes-the-rest rule.
# This desktop's own pid and everything descended from it, for the "this
# desktop" filter: its terminal windows' shells and whatever they are
# running. Linux lists a process's children itself, so only the tree is
# read -- a handful of files, not one per process on the machine. Where
# that file is not there (a kernel built without CONFIG_PROC_CHILDREN, or
# no /proc at all) one ps gives every process's parent instead and each
# chain is walked up from its own end, bounded in case a parent ever
# points back into its own chain.
fn tasks_kin() {
	local p c kids line pid ppid d
	local i=0 n=1
	local -a q ks

	TK_KIN=()
	TK_KIN["$$"]=1
	q[0]=$$
	if [ -r "/proc/$$/task/$$/children" ]; then
		while [ "$i" -lt "$n" ]; do
			p=${q[$i]}
			i=$((i + 1))
			# children has no trailing newline, and read fails at
			# end of input even having assigned -- taking its
			# status for "nothing there" found every process's
			# children to be none at all.
			kids=
			read -r kids 2> /dev/null < "/proc/$p/task/$p/children"
			[ -n "$kids" ] || continue
			read -ra ks <<< "$kids"
			for c in "${ks[@]}"; do
				[ -n "$c" ] || continue
				[ -n "${TK_KIN["$c"]+x}" ] && continue
				TK_KIN["$c"]=1
				q[$n]=$c
				n=$((n + 1))
			done
		done
		return 0
	fi
	TK_PPID=()
	while IFS= read -r line; do
		read -r pid ppid _ <<< "$line"
		case $pid in '' | *[!0-9]*) continue ;; esac
		TK_PPID["$pid"]=$ppid
	done < <(command ps -axo pid=,ppid= 2> /dev/null)
	for pid in "${!TK_PPID[@]}"; do
		p=$pid
		d=0
		while [ -n "$p" ] && [ "$p" != 0 ] && [ "$d" -lt 64 ]; do
			if [ -n "${TK_KIN["$p"]+x}" ]; then
				TK_KIN["$pid"]=1
				break
			fi
			p=${TK_PPID["$p"]}
			d=$((d + 1))
		done
	done
	return 0
}

# What a filter is called where a person reads it.
fn tasks_filterlabel(f) {
	case $f in
	mine) ret "Mine" ;;
	desktop) ret "This Desktop" ;;
	*) ret "Everyone" ;;
	esac
}

# The window says which filter is in force, so a short list is never
# mysteriously short; showing everyone's is the plain title.
fn tasks_retitle(int id) {
	local lb

	command -v dt_retitle > /dev/null || return 0
	if [ "$TK_FILTER" = everyone ]; then
		dt_retitle "$id" "Task Manager"
		return 0
	fi
	lb := tasks_filterlabel "$TK_FILTER"
	case $DT_LANG in ?*) lb := dt_tr "$lb" ;; esac
	dt_retitle "$id" "Task Manager [$lb]"
}

# Choose whose processes to show. Every window's scan time is cleared, so
# the frame this returns into reads the process table afresh rather than
# showing the old list until the next scan's turn, and its selection goes
# back to the top of what is now a different list.
fn tasks_filterset(f) {
	local id

	TK_FILTER=$f
	for id in "${!TK[@]}"; do
		case $id in *[!0-9]*) continue ;; esac
		TK[$id]["scant"]=
		TK[$id]["top"]=0
		TK[$id]["sel"]=0
		tasks_retitle "$id"
	done
	command -v dt_save > /dev/null && dt_save
	return 0
}

# The next filter along, for the keyboard: the same list the menu and the
# Control Panel offer, in the same order.
fn tasks_filtercycle(int? id = "") {
	local i=0 n=${#TK_FILTERS[@]} f=${TK_FILTERS[0]}

	while [ "$i" -lt "$n" ]; do
		if [ "${TK_FILTERS[$i]}" = "$TK_FILTER" ]; then
			f=${TK_FILTERS[$(((i + 1) % n))]}
			break
		fi
		i=$((i + 1))
	done
	tasks_filterset "$f"
	return 0
}

fn tasks_scan_ps(int? id = "") {
	local pid rss pcpu user comm line n=0

	[ "$TK_FILTER" = desktop ] && tasks_kin
	[ "$TK_FILTER" = mine ] && [ -z "$TK_ME" ] && TK_ME=$(command id -un)
	while IFS= read -r line; do
		read -r pid rss pcpu user comm <<< "$line"
		case $pid in '' | *[!0-9]*) continue ;; esac
		case $TK_FILTER in
		mine) [ "$user" = "$TK_ME" ] || continue ;;
		desktop) [ -n "${TK_KIN["$pid"]+x}" ] || continue ;;
		esac
		TK[$id][$n]["pid"]=$pid
		TK[$id][$n]["name"]=${comm##*/}
		TK[$id][$n]["owner"]=$user
		TK[$id][$n]["cpu"]=${pcpu%.*}
		TK[$id][$n]["mem"]=${rss:-0}
		n=$((n + 1))
	done < <(command ps -axo pid=,rss=,pcpu=,user=,comm= 2> /dev/null)
	TK[$id]["n"]=$n
}

fn tasks_scan(int id) {
	local pid uidrss uid rss owner times u s name now elapsed du ds pct
	local n=0
	local prevt=${TK_PREV[$id]["t"]}

	# uname is a program, not a builtin -- := does nothing for one of
	# those and its output goes straight to the real terminal, so this
	# has to be a real command substitution, not :=.
	[ -z "$TK_OS" ] && TK_OS=$(command uname)
	if [ "$TK_OS" != Linux ]; then
		tasks_scan_ps "$id"
		return 0
	fi
	tasks_loadusers
	[ "$TK_FILTER" = desktop ] && tasks_kin
	now := dt_ms
	for pid in /proc/[0-9]*; do
		pid=${pid#/proc/}
		times := tasks_times "$pid" || continue
		read -r u s name <<< "$times"
		[ -z "$name" ] && continue
		uidrss := tasks_uidrss "$pid"
		read -r uid rss <<< "$uidrss"
		pct=0
		if [ -n "$prevt" ] && [ -n "${TK_PREV[$id]["$pid.u"]}" ]; then
			du=$((u - TK_PREV[$id]["$pid.u"]))
			ds=$((s - TK_PREV[$id]["$pid.s"]))
			elapsed=$((now - prevt))
			[ "$elapsed" -gt 0 ] &&
				pct=$(((du + ds) * 100000 / TK_HZ / elapsed))
		fi
		TK_PREV[$id]["$pid.u"]=$u
		TK_PREV[$id]["$pid.s"]=$s
		# The times are kept for every process whether or not this
		# filter shows it, so a filter changed between two scans does
		# not read 0% for a second on the rows it brings back.
		case $TK_FILTER in
		mine) [ "$uid" = "$EUID" ] || continue ;;
		desktop) [ -n "${TK_KIN["$pid"]+x}" ] || continue ;;
		esac
		owner := tasks_ownername "$uid"
		TK[$id][$n]["pid"]=$pid
		TK[$id][$n]["name"]=$name
		TK[$id][$n]["owner"]=$owner
		TK[$id][$n]["cpu"]=$pct
		TK[$id][$n]["mem"]=${rss:-0}
		n=$((n + 1))
	done
	TK_PREV[$id]["t"]=$now
	TK[$id]["n"]=$n
}

# Sort by any column, either way. Each row becomes one key -- the column's
# value, zero-padded when it is a number so text order is number order,
# lowered when it is text -- then its pid to keep ties stable, then its
# index; arr sort orders those in C, and the rows are rebuilt in that
# order, or its reverse for descending. An insertion sort in the shell
# did the same work one comparison at a time, fine for a list already
# nearly in order and hopeless the moment a click reverses it.
fn tasks_sort(int id, by, dir = "") {
	local dir=${dir:-desc} n i k v key
	local -a keys apid aname aowner acpu amem

	n=${TK[$id]["n"]:-0}
	[ "$n" -lt 2 ] && return 0
	i=0
	while [ "$i" -lt "$n" ]; do
		v=${TK[$id][$i]["$by"]}
		# A number column turns its own key round for descending, so ties
		# keep their pids in order; only a text column's list is reversed.
		case $by in
		name | owner) key := str lower "$v" ;;
		*)
			v=${v:-0}
			[ "$dir" = desc ] && v=$((999999999999 - v))
			printf -v key '%012d' "$v"
			;;
		esac
		printf -v key '%s\t%012d\t%d' "$key" "${TK[$id][$i]["pid"]:-0}" "$i"
		keys+=("$key")
		i=$((i + 1))
	done
	arr sort keys
	k=0
	while [ "$k" -lt "$n" ]; do
		if [ "$dir" = asc ] || { [ "$by" != name ] && [ "$by" != owner ]; }; then
			key=${keys[$k]}
		else
			key=${keys[$((n - 1 - k))]}
		fi
		i=${key##*	}
		apid+=("${TK[$id][$i]["pid"]}")
		aname+=("${TK[$id][$i]["name"]}")
		aowner+=("${TK[$id][$i]["owner"]}")
		acpu+=("${TK[$id][$i]["cpu"]}")
		amem+=("${TK[$id][$i]["mem"]}")
		k=$((k + 1))
	done
	k=0
	while [ "$k" -lt "$n" ]; do
		TK[$id][$k]["pid"]=${apid[$k]}
		TK[$id][$k]["name"]=${aname[$k]}
		TK[$id][$k]["owner"]=${aowner[$k]}
		TK[$id][$k]["cpu"]=${acpu[$k]}
		TK[$id][$k]["mem"]=${amem[$k]}
		k=$((k + 1))
	done
}

# A heading clicked: sort by that column, or the other way if it already
# was. Numbers start largest first -- the busiest process is the one being
# looked for -- and text starts at A.
fn tasks_headsort(int id, col) {
	if [ "${TK[$id]["by"]}" = "$col" ]; then
		if [ "${TK[$id]["dir"]}" = asc ]; then
			TK[$id]["dir"]=desc
		else
			TK[$id]["dir"]=asc
		fi
	else
		TK[$id]["by"]=$col
		case $col in
		cpu | mem) TK[$id]["dir"]=desc ;;
		*) TK[$id]["dir"]=asc ;;
		esac
	fi
}

# A value right-justified in a field w wide, never narrower than the value
# itself -- str pad only pads on the right, so a numeric column that wants
# its digits lined up on the right needs its own spaces put in front.
fn tasks_rjust(v, int w) {
	local n sp

	n=$((w - ${#v}))

	[ "$n" -lt 0 ] && n=0
	sp := dt_rep "$n" " "
	ret "$sp$v"
}

# A byte count as people read one.
fn tasks_human(int kb) {
	if [ "$kb" -ge 1048576 ]; then
		ret "$((kb / 1048576)).$(((kb % 1048576) * 10 / 1048576))G"
	elif [ "$kb" -ge 1024 ]; then
		ret "$((kb / 1024)).$(((kb % 1024) * 10 / 1024))M"
	else
		ret "${kb}K"
	fi
}

fn tasks_open(int id, arg = "") {
	TK[$id]["sel"]=0
	TK[$id]["top"]=0
	TK[$id]["by"]=${TK_SORTBY:-cpu}
	TK[$id]["dir"]=${TK_SORTDIR:-desc}
	TK[$id]["full"]=0
	tasks_retitle "$id"
}

# A process's whole command line, arguments and all, joined with plain
# spaces -- /proc/[pid]/cmdline is NUL-separated, and a hibr string ends
# at the first NUL like any C string, so it is read one field at a time
# instead of into one variable, which never has to hold the NULs at all.
# Linux only, and only for the rows actually on screen: forking to get
# this on every platform for every process, every scan, would cost far
# more than a handful of reads twice a second.
fn tasks_cmdline(int pid) {
	local out= part first=1

	[ "$TK_OS" = Linux ] || return 1
	while IFS= read -r -d '' part; do
		[ "$first" = 1 ] && first=0 || out="$out "
		out="$out$part"
	done 2> /dev/null < "/proc/$pid/cmdline"
	[ -z "$out" ] && return 1
	ret "$out"
}

# Columns: PID, Name, Owner, CPU%, Mem -- Name takes whatever is left
# once the other four fixed widths and the spaces between them are
# accounted for. dt_win already excludes both its own border rows before
# calling here -- h is dt_win's own h-2, not the window's real outer
# height -- so this only ever needs to subtract its own header row, not
# a second border allowance on top of that; subtracting 3 here instead
# of 1 left two rows of real dead space at the bottom of every window,
# under the graph and above dt_win's own border, reported live.
fn tasks_draw(int id, int h, int w, int row, int col) {
	local i r t n vis top sel by dir now full mk
	local lp ln lo lc lm
	local pidw=6 ownerw=8 owner pidtxt namew cpu mem line pl
	local showgraph=1 graphh=2 leftw rightw lbl spark

	now := dt_ms
	by=${TK[$id]["by"]}
	dir=${TK[$id]["dir"]:-desc}
	if [ -z "${TK[$id]["scant"]}" ] ||
	   [ $((now - TK[$id]["scant"])) -ge "$TK_SCANMS" ]; then
		tasks_scan "$id"
		tasks_sort "$id" "$by" "$dir"
		tasks_sysstat "$id"
		TK[$id]["scant"]=$now
		TK[$id]["sortby"]="$by $dir"
	elif [ "${TK[$id]["sortby"]}" != "$by $dir" ]; then
		# A sort change between scans still shows at once: sorting the
		# cached list is cheap, unlike the /proc scan that fills it.
		tasks_sort "$id" "$by" "$dir"
		TK[$id]["sortby"]="$by $dir"
	fi
	n=${TK[$id]["n"]}
	# 6 digits fits every pid on a default Linux (32768 max) with room to
	# spare, but not every macOS one -- reported live at seven digits,
	# where a fixed width let the pid text overrun its own column and
	# misaligned every column after it. Widened to whatever the widest
	# pid actually on screen needs, never narrower than 6, so the common
	# case costs nothing extra (this is a length check per already-
	# scanned entry, not another scan) and only a genuinely wide pid
	# grows the column at all.
	i=0
	while [ "$i" -lt "$n" ]; do
		pl=${#TK[$id][$i]["pid"]}
		[ "$pl" -gt "$pidw" ] && pidw=$pl
		i=$((i + 1))
	done
	namew=$((w - 2 - pidw - 1 - ownerw - 1 - 6 - 1 - 7 - 1))
	vis=$((h - 1 - graphh))
	[ "$vis" -lt 1 ] && { vis=$((h - 1)); showgraph=0; }
	TK[$id]["vis"]=$vis
	TK[$id]["w"]=$w
	top=${TK[$id]["top"]}
	[ "$top" -gt $((n - vis)) ] && top=$((n - vis))
	[ "$top" -lt 0 ] && top=0
	TK[$id]["top"]=$top
	sel=${TK[$id]["sel"]}
	[ "$sel" -ge "$n" ] && sel=$((n - 1)) && TK[$id]["sel"]=$sel
	[ "$sel" -lt 0 ] && sel=0

	full=${TK[$id]["full"]:-0}
	# The sorted column's heading carries its direction; a number column's
	# mark goes in front, where its right-justified digits leave room.
	mk="${GL[down]}"
	[ "$dir" = asc ] && mk="${GL[up]}"
	lp=PID; ln=Name; lo=Owner; lc="CPU%"; lm=Mem
	case $by in
	pid) lp="$mk$lp" ;;
	name) ln="$ln$mk" ;;
	owner) lo="$lo$mk" ;;
	cpu) lc="$mk$lc" ;;
	mem) lm="$mk$lm" ;;
	esac
	console pen "$DT_INK" "$DT_FACE" bold
	pidtxt := tasks_rjust "$lp" "$pidw"
	t := str pad "$ln" "$namew"
	owner := str pad "$lo" "$ownerw"
	cpu := tasks_rjust "$lc" 6
	mem := tasks_rjust "$lm" 7
	# Where each heading starts, for tasks_click: pid, name, owner, cpu,
	# mem, and where the last one ends. Mirrored, the columns run the
	# other way, the name right-aligned: a start and end per column.
	if [ "$DT_MIRRORON" = 1 ]; then
		t := dt_rpad "$ln" "$namew"
		console put -p "w$id" 1 2 "$mem $cpu $owner $t $pidtxt"
		TK[$id]["hx"]="m $((ownerw + namew + 19)) $((ownerw + namew + 19 + pidw)) $((ownerw + 18)) $((ownerw + namew + 18)) 17 $((17 + ownerw)) 10 16 2 9"
	else
		console put -p "w$id" 1 1 "$pidtxt $t $owner $cpu $mem"
		TK[$id]["hx"]="1 $((pidw + 2)) $((pidw + namew + 3)) $((pidw + namew + ownerw + 4)) $((pidw + namew + ownerw + 11)) $((pidw + namew + ownerw + 18))"
	fi

	i=$top
	r=2
	while [ "$r" -le $((vis + 1)) ]; do
		if [ "$i" -lt "$n" ]; then
			pidtxt := tasks_rjust "${TK[$id][$i]["pid"]}" "$pidw"
			t=
			[ "$full" = 1 ] && t := tasks_cmdline "${TK[$id][$i]["pid"]}"
			[ -z "$t" ] && t=${TK[$id][$i]["name"]}
			[ ${#t} -gt "$namew" ] && t="${t:0:$namew}"
			t := str pad "$t" "$namew"
			owner=${TK[$id][$i]["owner"]}
			[ ${#owner} -gt "$ownerw" ] && owner="${owner:0:$ownerw}"
			owner := str pad "$owner" "$ownerw"
			cpu="${TK[$id][$i]["cpu"]}%"
			cpu := tasks_rjust "$cpu" 6
			mem := tasks_human "${TK[$id][$i]["mem"]}"
			mem := tasks_rjust "$mem" 7
			line="$pidtxt $t $owner $cpu $mem"
			if [ "$DT_MIRRORON" = 1 ]; then
				t=${t%"${t##*[! ]}"}
				t := dt_rpad "$t" "$namew"
				line="$mem $cpu $owner $t $pidtxt"
			fi
		else
			line := str pad "" $((pidw + namew + ownerw + 17))
		fi
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			console pen "$DT_SELINK" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" $((1 + ${DT_MIRRORON:-0})) "$line"
		i=$((i + 1))
		r=$((r + 1))
	done
	t=$((w - 1))
	[ "$DT_MIRRORON" = 1 ] && t=1
	[ "$TK_BAR" = 1 ] && dt_scrollbar "$id" 2 "$t" "$vis" "$n" "$vis" "$top"
	if [ "$showgraph" = 1 ]; then
		leftw=$(((w - 2 - 1) / 2))
		rightw=$((w - 2 - 1 - leftw))
		r=$((vis + 2))
		console pen "$DT_INK" "$DT_FACE"
		lbl := tasks_rjust "${TK[$id]["syscpu"]:-0}%" 4
		lbl := str pad "CPU $lbl" "$leftw"
		console put -p "w$id" "$r" 1 "$lbl"
		lbl := tasks_rjust "${TK[$id]["sysmem"]:-0}%" 4
		lbl := str pad "Mem $lbl" "$rightw"
		console put -p "w$id" "$r" $((leftw + 2)) "$lbl"
		spark := tasks_spark "$id" cpuh "$leftw"
		console put -p "w$id" $((r + 1)) 1 "$spark"
		spark := tasks_spark "$id" memh "$rightw"
		console put -p "w$id" $((r + 1)) $((leftw + 2)) "$spark"
	fi
	dt_want "$TK_SCANMS"
}

fn tasks_end(int? id = "", sig = "") {
	local sel pid

	sel=${TK[$id]["sel"]}
	pid=${TK[$id][$sel]["pid"]}
	[ -n "$pid" ] && kill "-$sig" "$pid" 2> /dev/null
	return 0
}

fn tasks_key(int id, key) {
	local n vis

	n=${TK[$id]["n"]}
	vis=${TK[$id]["vis"]}
	local sel=${TK[$id]["sel"]} top=${TK[$id]["top"]}

	case $key in
	up) sel=$((sel - 1)) ;;
	down) sel=$((sel + 1)) ;;
	x) tasks_end "$id" TERM; return 0 ;;
	shift-x) tasks_end "$id" KILL; return 0 ;;
	c) tasks_sortby "$id" cpu; return 0 ;;
	m) tasks_sortby "$id" mem; return 0 ;;
	n) TK[$id]["full"]=$((1 - ${TK[$id]["full"]:-0})); return 0 ;;
	w) tasks_filtercycle "$id"; return 0 ;;
	*) return 1 ;;
	esac
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	TK[$id]["sel"]=$sel
	TK[$id]["top"]=$top
	return 0
}

fn tasks_click(int id, int r, int? c = "", btn = "") {
	local top n i vis k
	local -a hx

	top=${TK[$id]["top"]}
	n=${TK[$id]["n"]}
	vis=${TK[$id]["vis"]:-1}
	# A heading sorts by its column. Only when the click's column is known:
	# the context menu calls this with a row alone.
	if [ "$r" = 1 ] && [ -n "$c" ]; then
		read -r -a hx <<< "${TK[$id]["hx"]}"
		if [ "${hx[0]}" = m ]; then
			k=0
			while [ "$k" -lt 5 ]; do
				if [ "$c" -ge "${hx[$((1 + 2 * k))]}" ] && [ "$c" -lt "${hx[$((2 + 2 * k))]}" ]; then
					tasks_headsort "$id" "${TK_COLS[$k]}"
					return 0
				fi
				k=$((k + 1))
			done
			return 0
		fi
		k=0
		while [ "$k" -lt 5 ]; do
			if [ "$c" -ge "${hx[$k]:-0}" ] && [ "$c" -lt "${hx[$((k + 1))]:-0}" ]; then
				tasks_headsort "$id" "${TK_COLS[$k]}"
				return 0
			fi
			k=$((k + 1))
		done
		return 0
	fi
	# The scrollbar's track: a click jumps there, as far through the list
	# as it is down the track.
	local bc=$((${TK[$id]["w"]:-0} - 1))

	[ "$DT_MIRRORON" = 1 ] && bc=1
	if [ "$TK_BAR" = 1 ] && [ -n "$c" ] && [ "$c" = "$bc" ] &&
	   [ "$r" -ge 2 ] && [ "$r" -le $((vis + 1)) ] && [ "$n" -gt "$vis" ]; then
		if [ "$vis" -gt 1 ]; then
			top=$(((r - 2) * (n - vis) / (vis - 1)))
		else
			top=0
		fi
		TK[$id]["top"]=$top
		return 0
	fi
	# r=1 is the header row (tasks_draw's own layout: header at pane row
	# 1, the list starting at row 2) -- found while adding #53's context
	# menu, since it selects the row a right-click landed on the same
	# way this already should for a left one. Off by one before this:
	# r=2, the first visible row, gave index top+1, not top+0, so every
	# click here has been selecting one row below the one clicked.
	[ "$r" -lt 2 ] && return 0
	i=$((top + r - 2))
	[ "$i" -ge "$n" ] && return 0
	TK[$id]["sel"]=$i
}

# The actual window, given values already resolved -- shared by the menu
# bar's own View Details, which reads them from the current selection
# when the item is finally chosen, and the context menu's, which
# captures them the moment the row is right-clicked so that a rescan
# before the item is actually picked can never make it show a different
# process. A point-in-time snapshot either way, the same as Get Info's,
# not a live one: keeping it current would mean giving a second window
# its own scan cadence for what is meant to be a quick glance, not a
# second Task Manager.
fn tasks_opendetails(int? pid = "", name = "", owner = "", int? cpu = "", int? mem = "") {
	local gid r c cmd

	[ -z "$pid" ] && return 0
	cmd := tasks_cmdline "$pid" || cmd=$name
	r=$((DT_ROWS / 2 - 5))
	c=$(((DT_COLS - 56) / 2))
	gid := dt_new "Process Details" 11 56 "$r" "$c" tdetail
	TD[$gid]["pid"]=$pid
	TD[$gid]["name"]=$name
	TD[$gid]["owner"]=$owner
	TD[$gid]["cpu"]=$cpu
	TD[$gid]["mem"]=$mem
	TD[$gid]["cmd"]=$cmd
}

fn tasks_details(int? id = "") {
	local sel=${TK[$id]["sel"]}

	tasks_opendetails "${TK[$id][$sel]["pid"]}" "${TK[$id][$sel]["name"]}" \
		"${TK[$id][$sel]["owner"]}" "${TK[$id][$sel]["cpu"]}" \
		"${TK[$id][$sel]["mem"]}"
}

# End Task by pid directly -- the context menu's own version of
# tasks_end, for the same reason tasks_opendetails exists: a captured
# pid cannot be made stale by a rescan between the right-click and the
# item finally being chosen, where re-reading the selection could be.
fn tasks_killpid(int? pid = "", sig = "") {
	[ -n "$pid" ] && kill "-$sig" "$pid" 2> /dev/null
	return 0
}

# Set directly rather than through tasks_key: a menu item is not a key, and
# routing it through the key handler only worked here because "x" the key
# and "x" the argument happen to be the same string.
fn tasks_sortby(int id, by) {
	TK[$id]["by"]=$by
	case $by in
	cpu | mem) TK[$id]["dir"]=desc ;;
	*) TK[$id]["dir"]=asc ;;
	esac
}

# The wheel moves the view three rows and leaves the selection where it is,
# as it does in Files.
fn tasks_wheel(int id, dir, int? r = "", int? c = "") {
	local top=${TK[$id]["top"]:-0} n=${TK[$id]["n"]:-0}
	local vis=${TK[$id]["vis"]:-1}

	case $dir in
	up) top=$((top - 3)) ;;
	down) top=$((top + 3)) ;;
	*) return 1 ;;
	esac
	[ "$top" -gt $((n - vis)) ] && top=$((n - vis))
	[ "$top" -lt 0 ] && top=0
	TK[$id]["top"]=$top
	return 0
}
fn tasks_fulltoggle(int? id = "") { TK[$id]["full"]=$((1 - ${TK[$id]["full"]:-0})); }

tasks_menus() {
	local full=${TK[$DT_FOCUS]["full"]:-0}
	local fe=0 fm=0 fd=0

	case $TK_FILTER in
	mine) fm=1 ;;
	desktop) fd=1 ;;
	*) fe=1 ;;
	esac
	dt_menu "File"
	dt_item "Close" w dt_close_focused
	dt_editmenu
	dt_menu "Task"
	dt_item "Sort by CPU" c tasks_sortby "$DT_FOCUS" cpu
	dt_item "Sort by Memory" m tasks_sortby "$DT_FOCUS" mem
	dt_sub "Show"
	dt_mark "Everyone" e "$fe" tasks_filterset everyone
	dt_mark "Mine" m "$fm" tasks_filterset mine
	dt_mark "This Desktop" d "$fd" tasks_filterset desktop
	dt_end
	dt_mark "Full Command Line" n "$full" tasks_fulltoggle "$DT_FOCUS"
	dt_sep
	dt_item "End Task" x tasks_end "$DT_FOCUS" TERM
	dt_item "End Task (force)" f tasks_end "$DT_FOCUS" KILL
	dt_sep
	dt_item "View Details" i tasks_details "$DT_FOCUS"
}

# A right-click selects the row under it first, the same as a left click
# does, before the menu opens on it. _context is handed only the window
# id, never the click position the way _click is -- MB_CY is the raw row
# dt_context_open was given, still there when this runs.
fn tasks_context(int id) {
	local r sel none pid name owner cpu mem

	# dt_ctxbuild calls this fresh every frame the menu stays open, not
	# once at the click -- files_context gets away with that because it
	# only reads a selection a real left click already set, never moves
	# it. Selecting here too, the way this ticket asks, cannot run every
	# frame the same way: a background rescan while the menu just sits
	# open would reorder the list under it, and re-deriving the row from
	# MB_CY again on the next rebuild could land on a different process
	# than the one actually clicked. MB_CY itself does not change for as
	# long as one open menu is the same menu, so it doubles as "have I
	# already captured this one" -- select and snapshot once, on the
	# frame it changes, and every later rebuild of the same menu just
	# redraws what was already captured.
	if [ "${TK[$id]["ctxrow"]}" != "$MB_CY" ]; then
		r=$((MB_CY - DT[$id]["row"]))
		tasks_click "$id" "$r"
		sel=${TK[$id]["sel"]}
		TK[$id]["ctxrow"]=$MB_CY
		TK[$id]["ctxpid"]=${TK[$id][$sel]["pid"]}
		TK[$id]["ctxname"]=${TK[$id][$sel]["name"]}
		TK[$id]["ctxowner"]=${TK[$id][$sel]["owner"]}
		TK[$id]["ctxcpu"]=${TK[$id][$sel]["cpu"]}
		TK[$id]["ctxmem"]=${TK[$id][$sel]["mem"]}
	fi
	pid=${TK[$id]["ctxpid"]}
	name=${TK[$id]["ctxname"]}
	owner=${TK[$id]["ctxowner"]}
	cpu=${TK[$id]["ctxcpu"]}
	mem=${TK[$id]["ctxmem"]}
	none=0
	[ -z "$pid" ] && none=1
	dt_menu "Task"
	if [ "$none" = 1 ]; then
		dt_dim "End Task"
		dt_dim "End Task (force)"
		dt_dim "View Details"
	else
		dt_item "End Task" x tasks_killpid "$pid" TERM
		dt_item "End Task (force)" f tasks_killpid "$pid" KILL
		dt_sep
		dt_item "View Details" i tasks_opendetails "$pid" "$name" "$owner" \
			"$cpu" "$mem"
	fi
}

# Process Details -- read only, a snapshot tasks_details already took.
fn tdetail_draw(int? id = "", int? h = "", int? w = "", int? row = "", int? col = "") {
	local mem cmd

	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 1 2 "PID:    %s" "${TD[$id]["pid"]}"
	dt_tput "$id" 2 2 "Name:   %s" "${TD[$id]["name"]}"
	dt_tput "$id" 3 2 "Owner:  %s" "${TD[$id]["owner"]}"
	mem := tasks_human "${TD[$id]["mem"]:-0}"
	dt_tput "$id" 4 2 "CPU:    %s%%       Memory: %s" "${TD[$id]["cpu"]}" "$mem"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 6 2 "Command:"
	console pen "$DT_INK" "$DT_FACE"
	cmd=${TD[$id]["cmd"]:0:$((w - 4))}
	console put -p "w$id" 7 2 "$cmd"
	console pen "$DT_DIM" "$DT_FACE"
	dt_tput "$id" 9 2 "escape closes"
}

fn tdetail_key(int? id = "", key = "") {
	case $key in
	escape) dt_del "$id"; return 0 ;;
	esac
	return 1
}

fn tdetail_close(int? id = "") {
	unset "TD[$id]"
}

if [ -z "$DT_ROWS" ]; then
	echo "tasks: this is a desktop app; open it from the hibr menu"
fi

# Copy takes the selected process, as its pid and its name.
fn tasks_copy(int id) {
	local sel=${TK[$id]["sel"]}

	[ -n "${TK[$id][$sel]["pid"]}" ] || return 1
	ret "${TK[$id][$sel]["pid"]} ${TK[$id][$sel]["name"]}"
}

# Copy takes everything Process Details shows, a line each.
fn tdetail_copy(int id) {
	ret "PID: ${TD[$id]["pid"]}
Name: ${TD[$id]["name"]}
Owner: ${TD[$id]["owner"]}
Command: ${TD[$id]["cmd"]}"
}
