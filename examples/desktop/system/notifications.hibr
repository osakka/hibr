#!/usr/bin/env hibr
#
# notifications -- a look back at what DT_NOTEHIST kept: newest first, each
# note's time, priority, sender and text. Up and down select one, delete clears it,
# and the History menu clears the low ones or all of them.
#
# Opened directly by the menu bar's icon (dt_bar in wm/bar.hibr, dt_mouse in
# wm/input.hibr) and by the Notifications pane's own "View History" row,
# never from a generic Applications pick -- hidden, the same reason About
# and Process Details are: nothing about "show me what already happened"
# makes sense launched with no history behind it, though here an empty one
# just shows an empty list rather than being refused.
#
# dt_new's own convention names every lifecycle hook after the app's
# registered name, "notifications" here (the id dt_launch passes through
# as dt_new's own prefix argument) -- not some shorter prefix of the
# file's choosing, or dt_new silently finds none of these and draws
# nothing at all. NHW (this window's own per-id state) is free to be
# named anything, since nothing looks it up by convention.

strict

app notifications "A read-only look back at recent notifications"
# part: control-panel/notifications.hibr

command -v dt_app > /dev/null && dt_app notifications "Notifications" 16 66 \
	once "◉" fixed hidden

declare -gA NHW

fn notifications_open(int id, arg) {
	NHW[$id]["top"]=0
	NHW[$id]["sel"]=0
}

fn notifications_close(int? id = "") {
	unset "NHW[$id]"
}

# Keep the selection on a note there is, and in view.
fn nh_fit(int id) {
	local n=${#DT_NOTEHIST_ORDER[@]} vis=${NHW[$id]["vis"]:-1}
	local sel=${NHW[$id]["sel"]:-0} top=${NHW[$id]["top"]:-0}

	sel := dt_scrollsel "$sel" "$n"
	top := dt_scrollfit "$top" "$n" "$vis" "$sel"
	NHW[$id]["sel"]=$sel
	NHW[$id]["top"]=$top
}

# The history id of the note at list position i, newest first.
fn nh_at(int i) {
	local n=${#DT_NOTEHIST_ORDER[@]}

	[ "$i" -ge 0 ] && [ "$i" -lt "$n" ] || return 1
	ret "${DT_NOTEHIST_ORDER[$((n - 1 - i))]}"
}

# Newest first, each row its time, its priority, who it is from and its
# text.
fn notifications_draw(int id, int h, int w, int row, int col) {
	local n i r vis top hid at t line p sel f

	DT_NOTEUNSEEN=0
	n=${#DT_NOTEHIST_ORDER[@]}
	vis=$((h - 1))
	NHW[$id]["vis"]=$vis
	nh_fit "$id"
	top=${NHW[$id]["top"]}
	sel=${NHW[$id]["sel"]}

	console pen "$DT_INK" "$DT_FACE"
	if [ "$n" = 0 ]; then
		dt_tput "$id" 1 1 "Nothing yet"
		return 0
	fi
	i=0
	r=1
	while [ "$r" -le "$vis" ]; do
		if hid := nh_at $((top + i)); then
			at=${DT_NOTEHIST[$hid]["at"]}
			printf -v t "%(%H:%M)T" $((at / 1000))
			p=${DT_NOTEHIST[$hid]["prio"]:-normal}
			line="${DT_NOTEHIST[$hid]["text"]}"
			[ ${#line} -gt $((w - 30)) ] && line="${line:0:$((w - 30))}"
			f=${DT_NOTEHIST[$hid]["from"]:-Desktop}
			f := str pad "${f:0:12}" 13
			if [ $((top + i)) = "$sel" ] && [ "$DT_FOCUS" = "$id" ]; then
				console pen "$DT_SELINK" "$DT_ACTIVE"
				printf -v line '%s  %-7s %s%s' "$t" "$p" "$f" "$line"
				line := str pad "$line" $((w - 2))
				console put -p "w$id" "$r" 1 "$line"
			else
				console pen "$DT_DIM" "$DT_FACE"
				console put -p "w$id" "$r" 1 "$t  "
				case $p in
				urgent) console pen "$DT_BAD" "$DT_FACE" bold ;;
				high) console pen "$DT_WARN" "$DT_FACE" bold ;;
				low) console pen "$DT_DIM" "$DT_FACE" ;;
				*) console pen "$DT_INK" "$DT_FACE" ;;
				esac
				printf -v p '%-7s ' "$p"
				console put -p "w$id" "$r" 8 "$p"
				console pen "$DT_DIM" "$DT_FACE" bold
				console put -p "w$id" "$r" 16 "$f"
				console pen "$DT_INK" "$DT_FACE"
				line := str pad "$line" $((w - 30))
				console put -p "w$id" "$r" 29 "$line"
			fi
		fi
		i=$((i + 1))
		r=$((r + 1))
	done
}

fn notifications_key(int? id = "", key = "") {
	local sel=${NHW[$id]["sel"]:-0} vis=${NHW[$id]["vis"]:-1}

	case $key in
	up) NHW[$id]["sel"]=$((sel - 1)) ;;
	down) NHW[$id]["sel"]=$((sel + 1)) ;;
	pageup) NHW[$id]["sel"]=$((sel - vis)) ;;
	pagedown) NHW[$id]["sel"]=$((sel + vis)) ;;
	home) NHW[$id]["sel"]=0 ;;
	end) NHW[$id]["sel"]=${#DT_NOTEHIST_ORDER[@]} ;;
	delete | backspace) nh_clearsel "$id" ;;
	enter | return) nh_show "$id" ;;
	*) return 1 ;;
	esac
	nh_fit "$id"
	return 0
}

# A click selects the note on that row, and a second one on the same row
# opens it: a row is 30 columns of a message that may be any length, and
# until 0.99.156 the only way to read the rest of one was Copy.
fn notifications_click(int id, int r, int c, btn) {
	local was=${NHW[$id]["sel"]:-0}

	NHW[$id]["sel"]=$((${NHW[$id]["top"]:-0} + r - 1))
	nh_fit "$id"
	if dt_isdbl "$id" && [ "$was" = "${NHW[$id]["sel"]}" ]; then
		nh_show "$id"
	fi
	return 0
}

# Open the selected note in a window of its own. An opener is never named
# <prefix>_open: dt_new calls that on the window it is making, so a
# notedetail_open that opened a notedetail window would call itself until
# the stack ran out (Gitea #157's own lesson, checked by 540-examples.t).
fn nh_show(int id) {
	local hid

	hid := nh_at "${NHW[$id]["sel"]:-0}" || return 1
	dt_launch notedetail "$hid"
	return 0
}

# The wheel moves the selection by one notch, DT_SCROLLWHEEL rows, the same
# distance it moves anything else.
fn notifications_wheel(int? id = "", dir = "", int? r = "", int? c = "") {
	local sel=${NHW[$id]["sel"]:-0}

	case $dir in
	up) NHW[$id]["sel"]=$((sel - DT_SCROLLWHEEL)) ;;
	down) NHW[$id]["sel"]=$((sel + DT_SCROLLWHEEL)) ;;
	esac
	nh_fit "$id"
	return 0
}

# Clear the selected note; the next one down takes its place.
fn nh_clearsel(int id) {
	local hid

	hid := nh_at "${NHW[$id]["sel"]:-0}" || return 0
	dt_notehist_del "$hid"
	nh_fit "$id"
}

notifications_menus() {
	local id=$DT_FOCUS

	dt_menu "File"
	dt_item "Close" w dt_close_focused
	dt_editmenu
	dt_menu "History"
	if [ "${#DT_NOTEHIST_ORDER[@]}" -gt 0 ]; then
		dt_item "Clear Selected" s nh_clearsel "$id"
		dt_sep
		dt_item "Clear Low" l dt_notehist_clear low
		dt_item "Clear All" a dt_notehist_clear urgent
	else
		dt_dim "Clear Selected"
		dt_sep
		dt_dim "Clear Low"
		dt_dim "Clear All"
	fi
}

# Copy takes the selected note's text.
fn notifications_copy(int id) {
	local hid

	hid := nh_at "${NHW[$id]["sel"]:-0}" || return 1
	ret "${DT_NOTEHIST[$hid]["text"]}"
}

# Cut takes it and clears it from the history.
fn notifications_cut(int id) {
	local hid t

	hid := nh_at "${NHW[$id]["sel"]:-0}" || return 1
	t=${DT_NOTEHIST[$hid]["text"]}
	dt_notehist_del "$hid"
	nh_fit "$id"
	ret "$t"
}

# --- the note itself -------------------------------------------------------

# A row in the list is 30 columns of a message that may be any length, and
# the action a note carried was thrown away when it reached the history --
# so a note that came and went behind something else lost both the rest of
# its words and the one thing it was for (Gitea #195). This window is a
# note as it was: who sent it, when, the whole text wrapped, and its action
# as a button.
#
# Registered here rather than in a file of its own because it is the same
# concern as the list, the way Files registers its own dialogs.
command -v dt_app > /dev/null && dt_app notedetail "Notification" 12 56 \
	many "◉" fixed hidden

declare -gA NDW

fn notedetail_open(int id, arg) {
	NDW[$id]["hid"]=$arg
	NDW[$id]["sel"]=0
}

fn notedetail_close(int? id = "") {
	unset "NDW[$id]"
}

# The note's own lines, wrapped to the window -- dt_notewrap fills
# DT_NOTELINES, which is what a live note is laid out with, so a note reads
# the same in both places.
fn notedetail_draw(int id, int h, int w, int row, int col) {
	local hid r at t p f act line
	local -a lines

	hid=${NDW[$id]["hid"]}
	console pen "$DT_INK" "$DT_FACE"
	if [ -z "${DT_NOTEHIST[$hid]["text"]+x}" ]; then
		dt_tput "$id" 1 2 "This notification has been cleared."
		return 0
	fi
	at=${DT_NOTEHIST[$hid]["at"]}
	printf -v t "%(%a %d %b %H:%M)T" $((at / 1000))
	f=${DT_NOTEHIST[$hid]["from"]:-Desktop}
	p=${DT_NOTEHIST[$hid]["prio"]:-normal}
	console pen "$DT_DIM" "$DT_FACE" bold
	dt_tput "$id" 1 2 "$f"
	console pen "$DT_DIM" "$DT_FACE"
	line="$t  $p"
	dt_tput "$id" 1 $((w - ${#line} - 1)) "$line"
	dt_notewrap "${DT_NOTEHIST[$hid]["text"]}" $((w - 4))
	lines=("${DT_NOTELINES[@]}")
	console pen "$DT_INK" "$DT_FACE"
	r=3
	for line in "${lines[@]}"; do
		[ "$r" -ge $((h - 2)) ] && break
		dt_tput "$id" "$r" 2 "$line"
		r=$((r + 1))
	done
	# The action as a button, where there is one. Its own first word is
	# what it is called: a notification's action is kept as argv words,
	# so there is a command to name rather than a line to re-split.
	if act := dt_notehist_what "$hid"; then
		dt_button "$id" $((h - 1)) 2 "$act" 0 ndact
	fi
	dt_button "$id" $((h - 1)) $((w - 10)) "Close" 0 ndclose
	return 0
}

fn notedetail_click(int id, int r, int c, btn) {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	case $tag in
	ndact) nd_do "$id" ;;
	ndclose) dt_wantclose "$id" ;;
	esac
	return 0
}

fn notedetail_key(int? id = "", key = "") {
	case $key in
	escape | q) dt_wantclose "$id" ;;
	enter | return) nd_do "$id" ;;
	*) return 1 ;;
	esac
	return 0
}

# Run the note's action and close the window, which is what clicking the
# live note did: the note itself stays in the history, since a record is a
# record.
fn nd_do(int id) {
	dt_notehist_run "${NDW[$id]["hid"]}" || return 0
	dt_wantclose "$id"
	return 0
}

notedetail_menus() {
	dt_menu "File"
	dt_item "Close" w dt_close_focused
	dt_editmenu
}
