#!/usr/bin/env hibr
#
# desktop -- a window manager, written in hibr.
#
# This is the middle of the three layers in docs/adr/0020: the console module
# is the display server, this is the window manager, and the file you write
# yourself is the session.  Source this, call dt_open, make some windows and
# call dt_run:
#
#     . desktop.hibr
#     dt_open
#     dt_new "A window" 10 40 4 8
#     dt_run
#
# Nothing here is C.  Everything below draws with `console put` and reads
# `console key`, and it redraws every window from the bottom of the stack
# upwards every frame, because the console only sends the cells that changed.

need display || { echo "desktop: no display available" >&2; exit 1; }

# The session's own arguments, captured here at the top level where $@ is
# still theirs: a function sees its own, and dt_autohold needs to hand these
# back to a fresh copy of itself.  $0 needs no such capture -- it is one
# value on the shell itself, the same in a function as at the top.
DT_SELFARGS=("$@")

DT_NEXT=1
DT_FOCUS=
DT_DRAG=
DT_DR=0
DT_DC=0
DT_QUIT=0
DT_SIZE=
# Which corner is being dragged, and the opposite corner's own row/col,
# captured once at the press that started the drag and held fixed for the
# rest of it -- the window's own row and col start changing the moment a
# top or left edge does, so the anchor cannot be re-read from DT[$id].
DT_SIZECORNER=
DT_SIZE_AR=0
DT_SIZE_AC=0
# A title-bar button pressed but not yet released -- close, min or max --
# shown inverted while held, and only acted on if the release lands back
# on the same one, the same press-then-release convention every other
# clickable thing in a real GUI already uses. Dragging off before letting
# go cancels it, the same as any other button; nothing here fires early.
DT_BTNID=
DT_BTNKIND=
DT_BTNOVER=0
# Scratch, filled by dt_btnspec for whichever button style is current and
# read straight back by dt_win: which kind sits at each of dt_btn's own
# fixed offsets (1, 3, 5 movable; 1, 3 fixed), its glyph, its colour, and
# what wraps the two ends of the cluster.
BTN_K=()
BTN_G=()
BTN_C=()
BTN_DL=
BTN_DR=
DT_GRAB=
DT_MOUSE=
DT_CLIP=
DT_CLIPOP=
DT_DND=
DT_DNDN=
DT_DNDG=
DT_DNDR=0
DT_DNDC=0
DT_DNDICON=
DT_DNDS=()
DT_PATHS=()
DT_NOTE=
DT_CONFIRM=
DT_CONFIRM_CMD=
DT_ROWS=24
DT_COLS=80

# Keyboard shortcuts a script -- or Settings -- can rebind. f10 and escape,
# which open the menu bar, are not in here: an app cannot have those keys
# at all, so there is nothing to configure. Everything else an app's own
# _key sees first, same as always -- a shortcut here only fires once the
# focused window has declined the key.
declare -gA DT_KEYS
DT_KEYS[close]="alt-f4"
DT_KEYS[detach]="ctrl-\\"
DT_KEYS[quit]=q
DT_KEYS[cycle]=tab
DT_KEYS[strip]="alt-s"

# Any app can have a global shortcut of its own, assigned from Settings --
# most have none, which is the point: a game or About does not want to
# steal a key from every window just for existing. term and tasks ship with
# one, since those two are reached often enough from outside any app to be
# worth a default; nothing stops a script or Settings from giving the same
# to any other, or taking these away. Nothing happens if the named app was
# never sourced, the same way dt_launch always behaves for a name nothing
# registered. alt-ctrl-, not ctrl-alt-: an alt combination arrives as ESC
# followed by the plain control byte, and the console names that "alt-"
# then whatever the control byte itself is, in that order -- unlike a
# CSI-encoded key's modifiers, which are named ctrl- before alt-. escape is
# avoided here on purpose: alt-escape is indistinguishable from a plain
# escape in most terminals, since ESC is also how alt itself arrives.
declare -gA DT_APPKEY
DT_APPKEY[term]="alt-ctrl-t"
DT_APPKEY[tasks]="alt-ctrl-p"
DT_KEYCAP=
declare -A DT

DT_WALL="${DT_WALL-#0d1b2a}"
DT_DOT="${DT_DOT-#16324a}"
DT_BAR="${DT_BAR-#1b3a5c}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_IDLE="${DT_IDLE-#4a5568}"
DT_FACE="${DT_FACE-#101820}"
DT_INK="${DT_INK-#cbd5e0}"
DT_GLYPH="${DT_GLYPH-·}"

# A real image as the wallpaper instead of the repeated glyph, drawn by the
# img module (mods/img) if it can be loaded -- empty means the glyph, same
# as it always has been. Setting one and setting DT_GLYPH are mutually
# exclusive in the UI (Appearance's Wallpaper row, the strip's own wallpaper
# module) for the same reason a radio button only shows one choice at a
# time, but nothing stops a hand-edited config from having both; DT_WALLIMG
# wins when it does. DT_WALLTRIED is not a setting -- it just stops dt_wall
# from retrying `need img` every single frame once it is known not to load.
DT_WALLIMG="${DT_WALLIMG-}"
DT_WALLTRIED=

# The cursor a new terminal starts with, until the program inside it asks
# for one of its own with DECSCUSR -- block, underline or bar.
DT_CURSOR="${DT_CURSOR-block}"

# Whether the cursor blinks. Off by default: a steady cursor is what the
# terminal module has always drawn, and blinking is a look, not a fix, so it
# stays opt-in. It costs nothing extra either way -- the focused terminal
# already redraws every 30ms to catch its own echo promptly, blink or not.
DT_CURSOR_BLINK="${DT_CURSOR_BLINK-0}"

# A window's shadow, cast on whatever is under it. On by default, since it
# costs one console darken call per window and nothing when off.
DT_SHADOW="${DT_SHADOW-1}"

# The same, for an open menu -- a separate setting, since a menu is drawn
# far more often than a window is moved, and someone who wants one without
# the other should be able to say so.
DT_MSHADOW="${DT_MSHADOW-1}"

# A shadow under the menu bar, giving it a sense of sitting above the
# desktop -- its own setting rather than tied to DT_SHADOW or DT_MSHADOW,
# the same reasoning as both of those already have: it is drawn every
# frame the bar is (always), not just when a window moves or a menu opens.
DT_BARSHADOW="${DT_BARSHADOW-1}"

# How much a shadow darkens what is under it -- console darken's own pct,
# kept per theme rather than as one constant. 55 (its builtin default)
# reads as a soft, barely-there shadow against a dark face like midnight's,
# because scaling an already-low RGB value down by 45% is a small absolute
# change -- but the same 45% off paper's near-white face lands on a flat
# medium grey, a hard-edged block rather than a shadow. Appearance's own
# cp_theme sets this alongside the other seven colours; unset here only
# matters before it is loaded at all.
DT_SHADOW_PCT="${DT_SHADOW_PCT-55}"

# What a double click on a title bar does -- zoom, minimise, close, or
# nothing. DT_DBLMS is how close together the two clicks have to land, and
# is not itself a setting: it is a threshold, not a preference.  DT_DBLID
# and DT_DBLT track the last title-bar click, to compare the next one
# against.
DT_DBLACTION="${DT_DBLACTION-zoom}"
DT_DBLMS=400
DT_DBLID=
DT_DBLT=0

# A window's own frame: single or double lined, or none at all. None is a
# blank frame, not no frame: the border ring -- corners, sides, grow box --
# goes undrawn, but the title and its buttons are still there, still
# clickable, exactly as under single or double. A style is a table entry:
# DT_FRAMES[name] carries its own six glyphs, so a fifth frame is six
# lines here, not a change to dt_win.
DT_FRAME="${DT_FRAME-single}"
declare -gA DT_FRAMES
DT_FRAMES[single]["tl"]="┌"; DT_FRAMES[single]["tr"]="┐"
DT_FRAMES[single]["bl"]="└"; DT_FRAMES[single]["br"]="┘"
DT_FRAMES[single]["h"]="─";  DT_FRAMES[single]["v"]="│"
DT_FRAMES[double]["tl"]="╔"; DT_FRAMES[double]["tr"]="╗"
DT_FRAMES[double]["bl"]="╚"; DT_FRAMES[double]["br"]="╝"
DT_FRAMES[double]["h"]="═";  DT_FRAMES[double]["v"]="║"

# Which side the min/max/close cluster docks to, where the title sits in
# whatever room that leaves, and which glyphs the cluster is drawn with:
# the Windows-style brackets this shipped with, coloured circles, or
# coloured squares. dt_btnspec is the table for the third of these, the
# same shape cp_theme's own case statement already is for a theme.
DT_BTNSIDE="${DT_BTNSIDE-right}"
DT_TITLEALIGN="${DT_TITLEALIGN-left}"
DT_BTNSTYLE="${DT_BTNSTYLE-brackets}"

# Whether a plain side (not just a corner) resizes too -- one dimension,
# the opposite edge anchored. On by default; off leaves the four corners
# as the only way, the same as before this existed. There is no top edge
# of its own regardless: row wr is the title bar over its whole width, so
# the two top corners are the only way to resize from above a window,
# with this on or off.
DT_EDGERESIZE="${DT_EDGERESIZE-1}"

# Move a window by holding a modifier and clicking anywhere in its body,
# not just its title bar -- off by default, the same reasoning
# console's own mouse motion reporting is: it takes a click away from
# whatever the app under the pointer would otherwise do with it, alt
# included, so it is the desktop owner's decision to make, never the
# default. When it fires, the window manager takes the click outright,
# before the app under the pointer ever sees it -- there is no "the app
# declined it" convention anywhere else a click is dispatched, and this
# does not invent one just for itself.
DT_DRAGMOD="${DT_DRAGMOD-0}"
DT_DRAGKEY="${DT_DRAGKEY-alt}"

# How often the desktop wakes and redraws with nothing else asking for a
# turn -- see dt_want and dt_run for why 2000 costs nothing in latency.
DT_TICK="${DT_TICK-2000}"

# Settings are a script of the user's own, written by the desktop whenever
# one changes and read back at the next start: plain assignments, so it can
# be edited by hand and needs no format of its own.  An app that wants a
# variable of its own kept names it with dt_keep.
DT_CONF="${DT_CONF-${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desktop.hibr}"
DT_KEEP=(DT_WALL DT_DOT DT_BAR DT_ACTIVE DT_IDLE DT_FACE DT_INK DT_GLYPH
	DT_WALLIMG
	DT_TICK DT_ICONS DT_DISKS DT_CURSOR DT_CURSOR_BLINK DT_SHADOW
	DT_MSHADOW DT_BARSHADOW DT_DBLACTION DT_SHADOW_PCT CS_SIDE CS_Y
	CS_COLLAPSED CS_LEN CS_SHADOW
	DT_FRAME DT_BTNSIDE DT_TITLEALIGN DT_BTNSTYLE DT_EDGERESIZE
	DT_DRAGMOD DT_DRAGKEY)

# Where the desktop's stderr goes while it holds the screen, so an app's
# error message cannot scribble over the display, and the reason for a
# failure is still there to read after it.
DT_LOG="${DT_LOG-${XDG_STATE_HOME:-$HOME/.local/state}/hibr/desktop.log}"
DT_ERR=

# Keep these variables in the settings file too.
dt_keep() {
	DT_KEEP+=("$@")
}

# Read the settings file, if there is one.  It runs after the session file
# has set its defaults, so what was chosen last time wins.
dt_load() {
	[ -r "$DT_CONF" ] && . "$DT_CONF"
	return 0
}

# Write every kept variable back, through a temporary file and a rename,
# so a crash halfway through never leaves half a settings file.
dt_save() {
	local v tmp=$DT_CONF.$$

	mkdir -p "${DT_CONF%/*}" 2> /dev/null || return 1
	{
		echo "# The desktop's settings, written whenever one changes and"
		echo "# read at the next start.  A script like any other."
		for v in "${DT_KEEP[@]}"; do
			[ -n "${!v+set}" ] && printf '%s=%q\n' "$v" "${!v}"
		done
		for v in "${!DT_ICONPOS[@]}"; do
			printf 'dt_iconpos %q %q\n' "$v" "${DT_ICONPOS["$v"]}"
		done
		for v in "${!DT_KEYS[@]}"; do
			printf 'DT_KEYS["%s"]=%q\n' "$v" "${DT_KEYS["$v"]}"
		done
		for v in "${!DT_APPKEY[@]}"; do
			printf 'DT_APPKEY["%s"]=%q\n' "$v" "${DT_APPKEY["$v"]}"
		done
	} > "$tmp" && mv -f "$tmp" "$DT_CONF"
}

# Open the display, take the mouse, and note how big the screen is.
#
# ctrl-c, ctrl-\ and ctrl-z become keys rather than signals: the desktop is
# left by Quit, never by a stray interrupt, and the key goes to the focused
# window -- which is how a program in a terminal window gets its ctrl-c.
dt_open() {
	title "hibr: desktop"
	dt_load
	console open || return 1
	# What a cell left at the terminal's own default colour should darken
	# toward, for a window's shadow: the desktop's own idea of plain
	# ink-on-face, the same colours everything undecorated already reads
	# as. Without this, a shadow over a terminal's own plain, uncoloured
	# output -- a shell prompt, ls of regular files, most of what
	# actually appears on screen -- showed no visible darkening at all.
	console darkdefault "$DT_INK" "$DT_FACE"
	console signals off
	# Click and drag only, not motion: reporting every movement with no
	# button held (XTerm mode 1003) was tried for the strip's own hover
	# highlight, and cost far more than that was worth -- a continuous
	# stream of escape sequences on every mouse movement anywhere on
	# screen, whether or not anything in hibr cared, which broke a real
	# terminal's own copy-and-paste convention (holding shift to bypass
	# app mouse reporting only ever had to suppress clicks and drags, not
	# a flood of plain movement) and made the desktop's own selection
	# band lag well behind the pointer, queued behind stale hover reports
	# from a moment earlier. The strip still scrolls by wheel (the wheel
	# event carries its own position) and by keyboard once given
	# attention with its own shortcut; only hovering it with the mouse
	# and getting no click at all is gone.
	console mouse drag
	console cursor off
	# mkdir is a process, and startup should not pay for one per folder
	# every time: only when the folder is not there yet.
	if [ -d "${DT_LOG%/*}" ] || mkdir -p "${DT_LOG%/*}" 2> /dev/null; then
		exec {DT_ERR}>&2 2>> "$DT_LOG"
	fi
	dt_size
	dt_deskscan
}

# Re-read the screen size after a resize.
dt_size() {
	local sz
	sz := console size
	DT_ROWS=${sz% *}
	DT_COLS=${sz#* }
	dt_iconlay
	cs_clamp
}

# Give the terminal back.
dt_close() {
	if [ -n "$DT_ERR" ]; then
		exec 2>&$DT_ERR {DT_ERR}>&-
		DT_ERR=
	fi
	console mouse off
	console signals on
	console close
}

# Which of an app's five functions actually exist, asked once.
dt_has() {
	command -v "$1" > /dev/null
}

# Make a window and put it on top.  Its id lands in $RET.
#
# The app argument is a prefix, not a command: an app called clock provides
# any of clock_draw, clock_key, clock_click, clock_open and clock_close, and
# the ones it does not write are never called.  That is the whole reason it
# is a prefix -- an app with no clock_key cannot swallow a key by accident,
# which a single function answering a verb in a case statement does, because
# a case that matches nothing succeeds.
dt_new() {
	local id=$DT_NEXT ap=${6-} f

	DT[$id]["title"]="$1"
	DT[$id]["h"]="$2"
	DT[$id]["w"]="$3"
	DT[$id]["row"]="$4"
	DT[$id]["col"]="$5"
	DT[$id]["app"]="$ap"
	DT[$id]["min"]=0
	DT[$id]["autoclose"]=
	for f in draw key click mouse wheel open close copy cut paste drop \
		refresh; do
		if [ -n "$ap" ] && dt_has "${ap}_$f"; then
			DT[$id]["$f"]="${ap}_$f"
		else
			DT[$id]["$f"]=
		fi
	done
	DT_NEXT=$((DT_NEXT + 1))
	console pane "w$id" "$4" "$5" "$2" "$3"
	DT_FOCUS=$id
	[ -n "${DT[$id]["open"]}" ] && ${DT[$id]["open"]} "$id" "$7"
	ret "$id"
}

# Close a window and forget it.
dt_del() {
	local id=$1

	[ -n "${DT[$id]["close"]}" ] && ${DT[$id]["close"]} "$id"
	console pane drop "w$id"
	unset "DT[$id]"
	if [ "$DT_FOCUS" = "$id" ]; then
		local l
		l := console pane list
		l=${l##* }
		DT_FOCUS=${l#w}
	fi
}

# An app calls this from its own _draw to ask that its window be closed --
# the terminal does, once the program inside has ended cleanly -- rather
# than calling dt_del there itself, which would pull the pane out from under
# the border dt_win still has left to draw over it.
dt_wantclose() {
	DT[$1]["autoclose"]=1
}

# Close whatever asked to be, once the frame it asked in is fully drawn.
dt_autoclose() {
	local id

	for id in "${!DT[@]}"; do
		[ -n "${DT[$id]["autoclose"]}" ] && dt_del "$id"
	done
}

# Show or hide a window without destroying it.  A minimised window has no
# pane, so nothing draws it and nothing can hit it; its only remaining handle
# is the label dt_wall puts on the bar, which is why that label exists.
dt_min() {
	local id=$1 l

	if [ "${DT[$id]["min"]}" = 1 ]; then
		DT[$id]["min"]=0
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}"
		console pane raise "w$id"
		DT_FOCUS=$id
	else
		DT[$id]["min"]=1
		console pane drop "w$id"
		if [ "$DT_FOCUS" = "$id" ]; then
			l := console pane list
			l=${l##* }
			DT_FOCUS=${l#w}
		fi
	fi
}

# --- what an app may call -------------------------------------------------
#
# An app draws with `console put -p "w$id"` and otherwise minds its own
# business. The few that manage *other* windows -- a control panel, a task
# switcher -- go through these rather than reading DT, which is the window
# manager's own table and not an interface.

# Every window, hidden ones included, in the order they were opened.
#
# Not in stacking order: a list that reshuffles every time something is
# raised is unusable as a list, and raising things is exactly what a window
# list is for. Anything that wants the stack can ask console pane list.
dt_ids() {
	local id out=

	for id in "${!DT[@]}"; do out="$out $id"; done
	ret "${out# }"
}

# What a window is called.
dt_title() {
	ret "${DT[$1]["title"]}"
}

# Is it minimised?
dt_hidden() {
	[ "${DT[$1]["min"]}" = 1 ]
}

# Put a window on top and give it the keyboard.
dt_raise() {
	dt_hidden "$1" && { dt_min "$1"; return 0; }
	console pane raise "w$1"
	DT_FOCUS=$1
}

# --------------------------------------------------------------------------

# Draw inside a window, in its own coordinates, with the frame allowed for.
dt_put() {
	console put -p "w$1" $(($2 + 1)) $(($3 + 1)) "$4"
}

# Repeat a string n times.  One builtin call, not a loop with ${#} in it.
# The result goes through a variable and then ret: := binds for a builtin,
# not for a function, so a bare `str repeat` here would print to the screen.
dt_rep() {
	local o

	str repeat "$2" "$1" o
	ret "$o"
}

# Paint the wallpaper.  The bar is drawn afterwards, over the windows, so a
# drop-down menu covers them.
dt_wall() {
	local drawn=

	if [ -n "$DT_WALLIMG" ]; then
		if ! dt_has img && [ -z "$DT_WALLTRIED" ]; then
			DT_WALLTRIED=1
			need img
		fi
		dt_has img && img draw "$DT_WALLIMG" 0 0 "$DT_ROWS" "$DT_COLS" &&
			drawn=1
	fi
	if [ -z "$drawn" ]; then
		console pen "$DT_DOT" "$DT_WALL"
		console fill 0 0 "$DT_ROWS" "$DT_COLS" "$DT_GLYPH"
	fi
	if [ "$DT_ICONS" = 1 ]; then
		[ $((EPOCHSECONDS - DI_SCANT)) -ge 3 ] && dt_deskscan
		dt_icondraw
	fi
}

# The three button-icon styles: which glyph and colour each of min, max
# and close gets, and what wraps the movable (3-button) or fixed
# (2-button) cluster. Fills BTN_K/BTN_G/BTN_C/BTN_DL/BTN_DR in the same
# left-to-right order dt_btn's own fixed offsets (1, 3, 5 or 1, 3) expect,
# so a fourth style is a branch here, never a change to dt_win or dt_btn.
dt_btnspec() {
	local style=$1 fixed=$2

	if [ "$fixed" = 1 ]; then BTN_K=(min close); else BTN_K=(min max close); fi
	case $style in
	circles)
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("●" "●"); BTN_C=("#f6ad55" "#f56565")
		else
			BTN_G=("●" "●" "●")
			BTN_C=("#f6ad55" "#68d391" "#f56565")
		fi
		;;
	squares)
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("■" "■"); BTN_C=("#f6ad55" "#f56565")
		else
			BTN_G=("■" "■" "■")
			BTN_C=("#f6ad55" "#68d391" "#f56565")
		fi
		;;
	*)
		BTN_DL="┤"; BTN_DR="├"
		if [ "$fixed" = 1 ]; then
			BTN_G=("_" "x"); BTN_C=("$DT_INK" "#f56565")
		else
			BTN_G=("_" "□" "x")
			BTN_C=("$DT_INK" "$DT_INK" "#f56565")
		fi
		;;
	esac
}

# dt_btnspec's own arrays, reordered left to right for the side the
# cluster actually docks to. min/max/close reads left to right on the
# right; mirrored on the left it reads close/max/min, so close is always
# the button nearest the window's own outer corner, whichever side that
# is -- the same relationship a real title bar keeps moved to either side.
dt_btnorder() {
	local style=$1 fixed=$2 side=$3

	dt_btnspec "$style" "$fixed"
	[ "$side" != left ] && return 0
	if [ "$fixed" = 1 ]; then
		BTN_K=("${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[1]}" "${BTN_C[0]}")
	else
		BTN_K=("${BTN_K[2]}" "${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[2]}" "${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[2]}" "${BTN_C[1]}" "${BTN_C[0]}")
	fi
}

# The cluster dt_btnspec's own glyphs draw as one string -- always 5
# (fixed) or 7 (movable) characters, matching the offsets dt_btn already
# hit-tests, whatever style set the glyphs themselves.
dt_btnstr() {
	if [ ${#BTN_G[@]} = 3 ]; then
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]} ${BTN_G[2]}$BTN_DR"
	else
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]}$BTN_DR"
	fi
}

# Draw one window: its face, then its app, then its frame over the top.
dt_win() {
	local id=$1
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}
	local fixed=${DT_APPS[${DT[$id]["app"]}]["fixed"]}

	[ "$DT_SHADOW" = 1 ] &&
		console darken $((wr + 1)) $((wc + 2)) "$h" "$w" "$DT_SHADOW_PCT"
	[ "$DT_FOCUS" = "$id" ] && on=$DT_ACTIVE
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"

	# None is a blank frame, not no frame: the ring of border glyphs is
	# left undrawn -- no corners, no sides, no grow box -- but the title
	# and its buttons are still there, still clickable, exactly as under
	# single or double. Nothing about a window's controls ever depends on
	# whether its edge is drawn.
	if [ "$DT_FRAME" != none ]; then
		console pen "$on" "$DT_FACE"
		local tl=${DT_FRAMES[$DT_FRAME]["tl"]} tr=${DT_FRAMES[$DT_FRAME]["tr"]}
		local bl=${DT_FRAMES[$DT_FRAME]["bl"]} br=${DT_FRAMES[$DT_FRAME]["br"]}
		local fh=${DT_FRAMES[$DT_FRAME]["h"]} fv=${DT_FRAMES[$DT_FRAME]["v"]}
		local bar
		bar := dt_rep $((w - 2)) "$fh"
		console put -p "w$id" 0 0 "$tl$bar$tr"
		console put -p "w$id" $((h - 1)) 0 "$bl$bar$br"
		console pen "$DT_INK" "$DT_FACE"
		# A fixed window keeps the plain corner the border just drew
		# instead of the grow box: no drag can resize it, so nothing
		# should invite one.
		[ "$fixed" != 1 ] &&
			console put -p "w$id" $((h - 1)) $((w - 1)) "◢"
		local r=1
		while [ "$r" -lt $((h - 1)) ]; do
			console put -p "w$id" "$r" 0 "$fv"
			console put -p "w$id" "$r" $((w - 1)) "$fv"
			r=$((r + 1))
		done
	fi

	local bs bc off i
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$DT_BTNSIDE"
	# A blank frame is blank throughout: the tick marks a style wraps its
	# cluster in are box-drawing glyphs too, and stay undrawn along with
	# the ring itself, even though the buttons they wrap keep working.
	[ "$DT_FRAME" = none ] && { BTN_DL=" "; BTN_DR=" "; }
	bs := dt_btnstr
	if [ "$DT_BTNSIDE" = left ]; then bc=1; else bc=$((w - 1 - ${#bs})); fi
	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" 0 "$bc" "$bs"
	if [ "$fixed" = 1 ]; then off=(1 3); else off=(1 3 5); fi
	i=0
	while [ "$i" -lt ${#BTN_G[@]} ]; do
		if [ "${BTN_C[$i]}" != "$DT_INK" ]; then
			console pen "${BTN_C[$i]}" "$DT_FACE" bold
			console put -p "w$id" 0 $((bc + ${off[$i]})) "${BTN_G[$i]}"
		fi
		i=$((i + 1))
	done

	# Room for the title is measured from the button cluster's own real
	# position and width, not a style's worst case -- a fixed window's
	# five-wide cluster leaves two columns more than a movable one's seven,
	# and a centred or right-aligned title has to land on the real
	# boundary or it reads as off-centre once anything narrower than the
	# widest cluster is in play.
	local t=${DT[$id]["title"]} tc0 room tc
	if [ "$DT_BTNSIDE" = left ]; then
		tc0=$((bc + ${#bs}))
		room=$((w - 1 - tc0 - 4))
	else
		tc0=2
		room=$((bc - tc0 - 4))
	fi
	[ ${#t} -gt "$room" ] && t="${t:0:$room}"
	case $DT_TITLEALIGN in
	center) tc=$((tc0 + (room - ${#t}) / 2)) ;;
	right)  tc=$((tc0 + room - ${#t})) ;;
	*)      tc=$tc0 ;;
	esac
	local tdl="┤" tdr="├"
	[ "$DT_FRAME" = none ] && { tdl=" "; tdr=" "; }
	console pen "$on" "$DT_FACE" bold
	console put -p "w$id" 0 "$tc" "$tdl $t $tdr"

	# Held down and still over the one that was pressed: shown inverted,
	# so a click actually looks like it did something before whatever it
	# does finishes happening -- the same press-then-release feedback
	# every other clickable thing in a real GUI already gives.
	if [ "$DT_BTNID" = "$id" ] && [ "$DT_BTNOVER" = 1 ]; then
		i=0
		while [ "$i" -lt ${#BTN_K[@]} ]; do
			if [ "${BTN_K[$i]}" = "$DT_BTNKIND" ]; then
				console pen "$DT_FACE" "${BTN_C[$i]}" bold
				console put -p "w$id" 0 $((bc + ${off[$i]})) \
					"${BTN_G[$i]}"
			fi
			i=$((i + 1))
		done
	fi
}

# One full frame, bottom of the stack upwards.
dt_draw() {
	local l id

	DT_WANT=
	dt_wall
	l := console pane list
	for id in $l; do dt_win "${id#w}"; done
	[ -n "$DT_DND" ] && dt_dnddraw
	dt_menus
	dt_ctxbuild
	dt_bar
	dt_stripdraw
	dt_drop
	dt_note_draw
	dt_confirm_draw
	console flush
}

# Which title-bar button is at this column, if any.  fixed omits max, whose
# button is not drawn there either, so a click at its old column falls
# through to the window's body instead of hitting a button that is not there.
dt_btn() {
	local w=$1 c=$2 fixed=$3 bc bw

	if [ "$fixed" = 1 ]; then bw=5; else bw=7; fi
	if [ "$DT_BTNSIDE" = left ]; then bc=1; else bc=$((w - 1 - bw)); fi
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$DT_BTNSIDE"
	if [ "$fixed" = 1 ]; then
		case $((c - bc)) in
		1) ret "${BTN_K[0]}" ;;
		3) ret "${BTN_K[1]}" ;;
		*) ret "" ;;
		esac
		return 0
	fi
	case $((c - bc)) in
	1) ret "${BTN_K[0]}" ;;
	3) ret "${BTN_K[1]}" ;;
	5) ret "${BTN_K[2]}" ;;
	*) ret "" ;;
	esac
}

# Handle one mouse report.
#
# An app is told a click in *pane* coordinates -- the same ones it draws in,
# where row 0 is the top border -- and not in some separate body coordinate
# system. Two systems is one too many: an app that draws at row 4 and is told
# a click at row 3 has to hold both in its head, and the first two apps each
# got the conversion wrong. The window manager handles row 0 itself, so an
# app only ever sees a click at row 1 or below.
#
# A report is `<action> <button> <row> <col>` for a press, a release or a
# drag, and `<action> <row> <col>` for the wheel, which has no button -- so
# the position cannot be read from a fixed argument. The action may carry a
# modifier, `ctrl-press`, which is stripped: a modified click is still a
# click here.
#
# Window fields are read into locals first: a subscript is only literal when
# it is quoted, and arithmetic never sees the quotes, so DT[$id][col] inside
# $(( )) would mean DT[$id][5] here.

dt_mouse() {
	local act=${1##*-} mr mc mods
	local id b wr wc wh ww ap mo now dr dc

	mods=${1%"$act"}
	mods=${mods%-}
	shift
	case $act in
	wheelup | wheeldown) mr=$1; mc=$2 ;;
	*) mr=$2; mc=$3 ;;
	esac

	case $act in
	press)
		DT_NOTE=
		if [ "$mr" = 0 ]; then
			if [ "$mc" -ge $((DT_COLS - 19)) ] &&
			   [ "$mc" -lt $((DT_COLS - 14)) ]; then
				dt_mclose
				dt_has clock_draw && dt_launch clock
				return 0
			fi
			if [ "$1" = right ]; then
				dt_context_open bar "" "$mr" "$mc"
				return 0
			fi
			b := dt_mhit "$mc" || { dt_mclose; return 0; }
			if [ "$b" = "$MB_OPEN" ]; then
				dt_mclose
			else
				dt_mopen "$b"
			fi
			return 0
		fi
		if [ "$MB_OPEN" != -1 ]; then
			if dt_mpick "$mr" "$mc"; then
				dt_mdo
			else
				dt_mclose
			fi
			return 0
		fi
		cs_press "$mr" "$mc" && return 0
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			if [ "$1" = right ]; then
				dt_context_open desktop "" "$mr" "$mc"
				return 0
			fi
			DT_FOCUS=
			dt_iconpress "$mr" "$mc" "$mods"
			return 0
		fi
		id=${id#w}
		console pane raise "w$id"
		DT_FOCUS=$id
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		ww=${DT[$id]["w"]}
		wh=${DT[$id]["h"]}
		ap=${DT[$id]["click"]}
		if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" != 1 ]; then
			# Any of the four corners starts a resize, the opposite one
			# anchored: captured once, here, since the window's own row
			# and col start changing the moment a top or left edge does.
			if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" = $((wc + ww - 1)) ]
			then
				DT_SIZE=$id; DT_SIZECORNER=br
				DT_SIZE_AR=$wr; DT_SIZE_AC=$wc
				return 0
			fi
			if [ "$mr" = "$wr" ] && [ "$mc" = "$wc" ]; then
				DT_SIZE=$id; DT_SIZECORNER=tl
				DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$((wc + ww - 1))
				return 0
			fi
			if [ "$mr" = "$wr" ] && [ "$mc" = $((wc + ww - 1)) ]; then
				DT_SIZE=$id; DT_SIZECORNER=tr
				DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$wc
				return 0
			fi
			if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" = "$wc" ]; then
				DT_SIZE=$id; DT_SIZECORNER=bl
				DT_SIZE_AR=$wr; DT_SIZE_AC=$((wc + ww - 1))
				return 0
			fi
			# A side, not just a corner -- one dimension only, the
			# opposite edge anchored. There is no top edge of its own:
			# row wr is the title bar over its whole width, so the two
			# top corners are the only way to resize from above it.
			if [ "$DT_EDGERESIZE" = 1 ]; then
				if [ "$mc" = "$wc" ] && [ "$mr" -gt "$wr" ] &&
				   [ "$mr" -lt $((wr + wh - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=l
					DT_SIZE_AC=$((wc + ww - 1))
					return 0
				fi
				if [ "$mc" = $((wc + ww - 1)) ] && [ "$mr" -gt "$wr" ] &&
				   [ "$mr" -lt $((wr + wh - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=r
					DT_SIZE_AC=$wc
					return 0
				fi
				if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" -gt "$wc" ] &&
				   [ "$mc" -lt $((wc + ww - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=b
					DT_SIZE_AR=$wr
					return 0
				fi
			fi
		fi
		if [ "$mr" -ne "$wr" ]; then
			if [ "$DT_DRAGMOD" = 1 ] && [ "$1" != right ]; then
				case "-$mods-" in
				*"-$DT_DRAGKEY-"*)
					DT_DRAG=$id
					DT_DR=$((mr - wr))
					DT_DC=$((mc - wc))
					return 0
					;;
				esac
			fi
			mo=${DT[$id]["mouse"]}
			if [ -n "$mo" ]; then
				DT_MOUSE=$id
				$mo "$id" press "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
				return 0
			fi
			if [ "$1" = right ] &&
			   dt_has "${DT[$id]["app"]}_context"; then
				dt_context_open "${DT[$id]["app"]}" "$id" \
					"$mr" "$mc"
				return 0
			fi
			[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wc)) "$1"
			return 0
		fi
		b := dt_btn "$ww" $((mc - wc)) "${DT_APPS[${DT[$id]["app"]}]["fixed"]}"
		if [ "$1" = right ] && [ -z "$b" ]; then
			dt_context_open titlebar "$id" "$mr" "$mc"
			return 0
		fi
		if [ -n "$b" ]; then
			DT_BTNID=$id
			DT_BTNKIND=$b
			DT_BTNOVER=1
			return 0
		fi
		now := dt_ms
		if [ "$DT_DBLACTION" != none ] &&
		   [ "$DT_DBLID" = "$id" ] &&
		   [ $((now - DT_DBLT)) -lt "$DT_DBLMS" ]; then
			DT_DBLID=
			case $DT_DBLACTION in
			zoom)
				[ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" \
					!= 1 ] && dt_zoom "$id"
				;;
			min) dt_min "$id" ;;
			close) dt_del "$id" ;;
			esac
			return 0
		fi
		DT_DBLID=$id
		DT_DBLT=$now
		DT_DRAG=$id
		DT_DR=$((mr - wr))
		DT_DC=$((mc - wc))
		;;
	drag | release)
		# A title-bar button held down: while dragging, just track whether
		# the pointer is still over the one that was pressed, for dt_win's
		# own highlight; the action itself only ever fires from release,
		# and only if it landed back on the same button.
		if [ -n "$DT_BTNID" ]; then
			id=$DT_BTNID
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			ww=${DT[$id]["w"]}
			b := dt_btn "$ww" $((mc - wc)) \
				"${DT_APPS[${DT[$id]["app"]}]["fixed"]}"
			if [ "$b" = "$DT_BTNKIND" ] && [ "$mr" = "$wr" ]; then
				DT_BTNOVER=1
			else
				DT_BTNOVER=0
			fi
			if [ "$act" = release ]; then
				if [ "$DT_BTNOVER" = 1 ]; then
					case $DT_BTNKIND in
					close) dt_del "$id" ;;
					min) dt_min "$id" ;;
					max) dt_zoom "$id" ;;
					esac
				fi
				DT_BTNID=
				DT_BTNKIND=
				DT_BTNOVER=0
			fi
			return 0
		fi
		# Something being dragged between windows belongs to the desktop
		# until it is dropped, whoever started it.
		if [ -n "$DT_DND" ]; then
			DT_DNDR=$mr
			DT_DNDC=$mc
			if [ "$act" = release ]; then
				DT_MOUSE=
				dt_ondrop "$mr" "$mc" "$mods"
			fi
			return 0
		fi
		# A band being drawn across the empty desktop.
		if [ -n "$DI_BAND" ]; then
			dt_iconband "$act" "$mr" "$mc"
			return 0
		fi
		# A press on an icon that moves becomes a drag of the selection.
		if [ -n "$DI_PRESS" ]; then
			dt_iconmove "$act" "$mr" "$mc"
			return 0
		fi
		# A window that took the press with _mouse is told the rest of it,
		# wherever the pointer goes, until the button comes up.
		if [ -n "$DT_MOUSE" ]; then
			id=$DT_MOUSE
			mo=${DT[$id]["mouse"]}
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			[ "$act" = release ] && DT_MOUSE=
			[ -n "$mo" ] &&
				$mo "$id" "$act" "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
			DT_DNDR=$mr
			DT_DNDC=$mc
			return 0
		fi
		;;
	esac

	case $act in
	drag)
		if [ -n "$CS_DRAG" ]; then
			if [ -z "$CS_DRAGKIND" ]; then
				dr=$((mr - CS_PRESSR)); [ "$dr" -lt 0 ] && dr=$((0 - dr))
				dc=$((mc - CS_PRESSC)); [ "$dc" -lt 0 ] && dc=$((0 - dc))
				if [ "$dc" -gt "$dr" ] && [ "$dc" -gt 0 ]; then
					CS_DRAGKIND=resize
				elif [ "$dr" -gt 0 ]; then
					CS_DRAGKIND=move
				fi
			fi
			case $CS_DRAGKIND in
			resize) cs_resize "$mc" ;;
			move)
				CS_Y=$mr
				[ "$CS_Y" -lt 1 ] && CS_Y=1
				[ "$CS_Y" -ge "$DT_ROWS" ] && CS_Y=$((DT_ROWS - 1))
				;;
			esac
			return 0
		fi
		if [ -n "$DT_SIZE" ]; then
			dt_cornersize "$DT_SIZE" "$DT_SIZECORNER" "$DT_SIZE_AR" \
				"$DT_SIZE_AC" "$mr" "$mc"
			return 0
		fi
		[ -z "$DT_DRAG" ] && return 0
		dt_move "$DT_DRAG" $((mr - DT_DR)) $((mc - DT_DC))
		;;
	release)
		if [ -n "$CS_DRAG" ]; then
			case $CS_DRAGKIND in
			"")
				if [ "$CS_COLLAPSED" = 1 ]; then
					CS_COLLAPSED=0
				else
					CS_COLLAPSED=1
				fi
				;;
			move)
				if [ "$mc" -lt $((DT_COLS / 2)) ]; then
					CS_SIDE=left
				else
					CS_SIDE=right
				fi
				;;
			esac
			CS_DRAG=
			CS_DRAGKIND=
			dt_save
			return 0
		fi
		DT_DRAG=
		DT_SIZE=
		DT_SIZECORNER=
		;;
	wheelup | wheeldown)
		if cs_hit "$mr" "$mc"; then
			if [ "$act" = wheelup ]; then
				cs_scroll -1
			else
				cs_scroll 1
			fi
			return 0
		fi
		id := console hit "$mr" "$mc"
		[ -z "$id" ] && return 0
		id=${id#w}
		ap=${DT[$id]["wheel"]}
		[ -z "$ap" ] && return 0
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		$ap "$id" "${act#wheel}" $((mr - wr)) $((mc - wc))
		;;
	esac
}

# The smallest a window can be and still have a usable title bar: the
# buttons alone take eight columns, and a body with no rows is not a window.
DT_MINW=16
DT_MINH=4

# Put a window at a size, clamped to what is sensible and what fits.
dt_resize() {
	local id=$1 h=$2 w=$3 r c

	[ "$h" -lt "$DT_MINH" ] && h=$DT_MINH
	[ "$w" -lt "$DT_MINW" ] && w=$DT_MINW
	r=${DT[$id]["row"]}
	c=${DT[$id]["col"]}
	[ $((r + h)) -gt "$DT_ROWS" ] && h=$((DT_ROWS - r))
	[ $((c + w)) -gt "$DT_COLS" ] && w=$((DT_COLS - c))
	[ "$h" -lt "$DT_MINH" ] && return 1
	[ "$w" -lt "$DT_MINW" ] && return 1
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	DT[$id]["oh"]=
	console pane "w$id" "$r" "$c" "$h" "$w"
}

# Resize by dragging any of the window's four corners, the opposite one
# held at (ar, ac) for the whole drag -- captured once, at the press that
# started it, since the window's own row and col start changing the
# moment a top or left edge does. br is dt_resize alone, unchanged from
# what a single grow box always did: the near corner is already the
# anchor, so only height and width change. tl moves both row and col, so
# it clamps both itself against the screen's near edge and against the
# minimum size the far corner still needs. tr and bl each move one of the
# two, clamped the same way, and hand the other edge (already free of any
# row/col change) to dt_resize, which clamps it against the screen's own
# far edge exactly as it always has.
dt_cornersize() {
	local id=$1 corner=$2 ar=$3 ac=$4 mr=$5 mc=$6 r c

	case $corner in
	tl)
		r=$mr; c=$mc
		[ "$r" -lt 1 ] && r=1
		[ "$c" -lt 0 ] && c=0
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		DT[$id]["row"]=$r
		DT[$id]["col"]=$c
		DT[$id]["h"]=$((ar - r + 1))
		DT[$id]["w"]=$((ac - c + 1))
		DT[$id]["oh"]=
		console pane "w$id" "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
		;;
	tr)
		# r is already clamped so ar-r+1 cannot be under DT_MINH, and ar
		# itself was always a valid row for a window that already fit the
		# screen -- dt_resize's own early-return, for a height still too
		# small once it clamps against the screen's far edge, can never
		# actually fire here; only its far-edge clamp on the width does.
		r=$mr
		[ "$r" -lt 1 ] && r=1
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		DT[$id]["row"]=$r
		dt_resize "$id" $((ar - r + 1)) $((mc - ac + 1))
		;;
	bl)
		# Same reasoning as tr, mirrored: c is already clamped so
		# ac-c+1 cannot be under DT_MINW.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		DT[$id]["col"]=$c
		dt_resize "$id" $((mr - ar + 1)) $((ac - c + 1))
		;;
	l)
		# One dimension only: the left edge moves, height and the right
		# edge (ac) do not, the same clamp as tl's own column half.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		DT[$id]["col"]=$c
		dt_resize "$id" "${DT[$id]["h"]}" $((ac - c + 1))
		;;
	r)
		# The mirror of l: the right edge moves, the left one (ac) does
		# not, so dt_resize's own clamp on the width is all this needs.
		dt_resize "$id" "${DT[$id]["h"]}" $((mc - ac + 1))
		;;
	b)
		# The mirror of r, the other axis: the bottom edge moves, the
		# top one (ar) does not.
		dt_resize "$id" $((mr - ar + 1)) "${DT[$id]["w"]}"
		;;
	*)
		dt_resize "$id" $((mr - ar + 1)) $((mc - ac + 1))
		;;
	esac
}

# Move a window, clamped to the screen below the menu bar.
dt_move() {
	local id=$1 r=$2 c=$3

	[ "$r" -lt 1 ] && r=1
	[ "$c" -lt 0 ] && c=0
	[ $((r + DT[$id]["h"])) -gt "$DT_ROWS" ] &&
		r=$((DT_ROWS - DT[$id]["h"]))
	[ $((c + DT[$id]["w"])) -gt "$DT_COLS" ] &&
		c=$((DT_COLS - DT[$id]["w"]))
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	console pane "w$id" "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Fill the screen, or go back to where the window was.
dt_zoom() {
	local id=$1

	if [ -n "${DT[$id]["oh"]}" ]; then
		DT[$id]["row"]=${DT[$id]["or"]}
		DT[$id]["col"]=${DT[$id]["oc"]}
		DT[$id]["h"]=${DT[$id]["oh"]}
		DT[$id]["w"]=${DT[$id]["ow"]}
		DT[$id]["oh"]=
	else
		DT[$id]["or"]=${DT[$id]["row"]}
		DT[$id]["oc"]=${DT[$id]["col"]}
		DT[$id]["oh"]=${DT[$id]["h"]}
		DT[$id]["ow"]=${DT[$id]["w"]}
		DT[$id]["row"]=1
		DT[$id]["col"]=0
		DT[$id]["h"]=$((DT_ROWS - 1))
		DT[$id]["w"]=$DT_COLS
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Handle one decoded key or mouse line.
#
# The wheel goes to the window under the pointer rather than to the focused
# one, which is what every other desktop does and what anyone expects when
# they scroll a list they have not clicked on yet.
dt_event() {
	local k="$1" an knorm qn cn cln dn sn

	if [ -n "$DT_KEYCAP" ]; then
		case $k in
		"mouse "*) DT_KEYCAP= ;;
		escape) DT_KEYCAP= ;;
		*)
			case $DT_KEYCAP in
			app:*)
				an=${DT_KEYCAP#app:}
				DT_APPKEY[$an]=$k
				dt_note "${DT_APPS[$an]["title"]} is now $k"
				;;
			*)
				DT_KEYS[$DT_KEYCAP]=$k
				dt_note "${DT_KEYCAP^} is now $k"
				;;
			esac
			dt_save
			DT_KEYCAP=
			;;
		esac
		return 0
	fi
	if [ -n "$DT_CONFIRM" ]; then
		case $k in
		"mouse press "*)
			set -- $k
			local yn
			yn := dt_confirm_hit "$4" "$5"
			if [ -n "$yn" ]; then
				dt_confirm_key "$yn"
			else
				DT_CONFIRM=
			fi
			;;
		"mouse "*) ;;
		*) dt_confirm_key "$k" ;;
		esac
		return 0
	fi
	case $k in
	"mouse "*)
		set -- $k
		shift
		dt_mouse "$@"
		return 0
		;;
	esac
	if [ -n "$DT_GRAB" ]; then
		dt_gkey "$k" && return 0
		return 0
	fi
	if [ -n "$DT_DND" ]; then
		[ "$k" = escape ] && DT_DND= && DT_MOUSE=
		return 0
	fi
	DT_NOTE=
	if [ "$MB_OPEN" != -1 ]; then
		dt_mkey "$k" && return 0
		return 0
	fi
	# The strip takes left/right ahead of the focused window once CS_ATTN
	# has been given to it explicitly by its own shortcut -- there is no
	# mouse involved here at all; the wheel scrolls it separately, from
	# wherever the pointer actually is when it turns.
	if [ "$k" = left ] || [ "$k" = right ]; then
		if [ "$CS_ATTN" = 1 ]; then
			if [ "$k" = left ]; then
				cs_scroll -1
			else
				cs_scroll 1
			fi
			return 0
		fi
	fi
	# Copy and paste belong to the desktop, the same keys in every window,
	# and so does a paste arriving from the terminal the desktop runs on:
	# it goes to the app's _paste when it has one.
	case $k in
	alt-c) dt_edit copy; return 0 ;;
	alt-x) dt_edit cut; return 0 ;;
	alt-v) dt_edit paste; return 0 ;;
	"paste "*)
		if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["paste"]}" ]; then
			${DT[$DT_FOCUS]["paste"]} "$DT_FOCUS" "${k#paste }"
			return 0
		fi
		;;
	esac
	# f10 is the one key an app cannot have, because it is the only way
	# back to the menu bar from a window that wants everything else --
	# a terminal running vi wants escape, and must be allowed it.
	if [ "$k" != f10 ] && [ -n "$DT_FOCUS" ] &&
	   [ -n "${DT[$DT_FOCUS]["key"]}" ]; then
		if ${DT[$DT_FOCUS]["key"]} "$DT_FOCUS" "$k"; then
			return 0
		fi
	fi
	if [ -z "$DT_FOCUS" ] && [ "$DT_ICONS" = 1 ] && dt_iconkey "$k"; then
		return 0
	fi
	case $k in
	f10 | escape)
		CS_ATTN=0
		dt_mopen 0
		return 0
		;;
	esac
	# Compared by dt_keynorm, not as the literal string: a rebound
	# DT_KEYS entry combining ctrl and alt would have exactly the same
	# either-order ambiguity dt_appkeyed's own shortcuts do.
	knorm := dt_keynorm "$k"
	qn := dt_keynorm "${DT_KEYS[quit]}"
	cn := dt_keynorm "${DT_KEYS[cycle]}"
	cln := dt_keynorm "${DT_KEYS[close]}"
	dn := dt_keynorm "${DT_KEYS[detach]}"
	sn := dt_keynorm "${DT_KEYS[strip]}"
	if [ "$knorm" = "$qn" ]; then
		dt_quitconfirm
	elif [ "$knorm" = "$cn" ]; then
		dt_cycle
	elif [ "$knorm" = "$cln" ]; then
		dt_close_focused
	elif [ "$knorm" = "$dn" ]; then
		dt_detach
	elif [ "$knorm" = "$sn" ]; then
		if [ "$CS_ATTN" = 1 ]; then
			CS_ATTN=0
			dt_note "Control Strip: released"
		else
			CS_ATTN=1
			dt_note "Control Strip: arrows scroll it, until escape"
		fi
	else
		dt_appkeyed "$k"
	fi
}

# A shortcut in one canonical modifier order, ctrl then alt then shift,
# whatever order it named them in -- an alt combination arrives as ESC
# followed by the plain control byte, and is named "alt-" then whatever
# that byte is, in that order; a CSI-encoded one (some terminals report
# a modified plain key this way too, not only function keys and arrows)
# is named "ctrl-" before "alt-". Comparing shortcuts by this instead of
# by the exact string is what makes alt-ctrl-t and ctrl-alt-t the same
# shortcut regardless of which encoding a real keypress happened to take
# -- a user typing what looks like the natural chord should not have to
# know or care which one their own terminal uses.
dt_keynorm() {
	local k=$1
	local base=$k mods= out=

	case $k in *-*) base=${k##*-}; mods=${k%-"$base"} ;; esac
	case $mods in *ctrl*) out="${out}ctrl-" ;; esac
	case $mods in *alt*) out="${out}alt-" ;; esac
	case $mods in *shift*) out="${out}shift-" ;; esac
	ret "$out$base"
}

# Launch whichever app, if any, has k as its own shortcut -- the general
# form DT_KEYS' fixed four desktop actions above are not: any number of
# apps, not two of them by name in this case statement.
dt_appkeyed() {
	local an knorm anorm

	knorm := dt_keynorm "$1"
	for an in "${!DT_APPKEY[@]}"; do
		anorm := dt_keynorm "${DT_APPKEY[$an]}"
		if [ "$anorm" = "$knorm" ]; then
			dt_launch "$an"
			return 0
		fi
	done
}

# Ask for the next frame within ms, from inside an app's _draw.
#
# The request lasts one frame: a game that is paused, hidden or not focused
# simply stops asking, and the desktop goes back to DT_TICK.  An idle desktop
# must not pay for an animation nobody is watching.  A request slower than
# DT_TICK is ignored, so it can never slow the desktop down.
dt_want() {
	[ "$1" -ge "$DT_TICK" ] && return 0
	if [ -z "$DT_WANT" ] || [ "$1" -lt "$DT_WANT" ]; then
		DT_WANT=$1
	fi
}

# A live redraw on every SIGWINCH of a drag makes the screen scramble once
# per pixel the terminal moves through, which is what dragging a real GUI
# window's edge does not do -- it freezes the content and snaps it once at
# the end.  console resizing is a cheap peek at the same flag console
# resized consumes, with none of its clear-and-repaint side effects, so a
# burst of them costs nothing extra: this waits for DT_RSTILL ms of quiet
# before it calls console reassert and redraws, once, at the settled size.
DT_RSTILL=150

# The event loop.  Draw, wait, dispatch, repeat.
#
# A key read while rsz is waiting out the quiet period is still consumed
# from the pty whether this looks at it or not, so it has to be kept in pk
# rather than just skipped -- skipping it reads the byte and throws the
# value away, which is a key silently lost, not a key left for later.
dt_run() {
	local k rsz=0 last now pk=
	while [ "$DT_QUIT" = 0 ]; do
		[ "$rsz" = 0 ] && { dt_draw; dt_autoclose; }
		if [ "$rsz" = 1 ]; then
			k := console key 80
		else
			k := console key "${DT_WANT:-$DT_TICK}"
		fi
		[ -n "$k" ] && pk=$k
		if console resizing; then
			rsz=1
			last := dt_ms
			continue
		fi
		if [ "$rsz" = 1 ]; then
			now := dt_ms
			if [ $((now - last)) -ge "$DT_RSTILL" ]; then
				console reassert
				dt_size
				rsz=0
				k=$pk
			else
				continue
			fi
		fi
		pk=
		[ -n "$k" ] && dt_event "$k"
	done
}

# --- the menu bar ---------------------------------------------------------
#
# System 7's, as closely as a text console allows: the hibr menu on the left
# where the apple went, then the active application's own menus, then the
# clock and the application menu on the right.  The menus belong to whatever
# has focus, so they change when you click a different window, and when
# nothing has focus they are the desktop's own.
#
# An app declares them by providing <app>_menus, which calls dt_menu, dt_item
# and dt_sep -- the same shape as `opt` declaring a command line, and the
# same prefix contract as _draw and _key: an app with no _menus simply has
# none, and the bar shows the desktop's.
#
# F10 or escape opens the bar; then the arrows move, a letter picks the item
# beside it, enter chooses and escape closes.  Nothing is reserved while the
# bar is shut, which is what keeps ctrl-c free for whatever runs in a window.

declare -A MB
declare -A MI
declare -A DT_APPS
MB_N=0
MB_OPEN=-1
MB_SEL=0
MB_APP=
MB_CUR=
MB_STACK=
MB_PAR=
MB_IN=0

# A menu that opened at the pointer rather than under its bar title: MB_CX
# and MB_CY are where it goes instead, MB_CTXWHO is what to ask for its
# items every frame it stays open (an app prefix, or "desktop" for the hibr
# menu itself), MB_CTXID the window it belongs to, if any.
MB_CX=
MB_CY=
MB_CTXWHO=
MB_CTXID=

# Start a menu.  Called from an app's <app>_menus.
dt_menu() {
	MB[$MB_N]["title"]="$1"
	MB[$MB_N]["n"]=0
	MB[$MB_N]["w"]=0
	MB[$MB_N]["bar"]=1
	MB_CUR=$MB_N
	MB_N=$((MB_N + 1))
}

# Add an item to the menu being declared: label, key, then the command.
# An empty key means the item has no letter and is reached with the arrows.
dt_item() {
	dt_row "" 0 "$@"
}

# The same, with a tick beside it when the third argument is not 0.
dt_mark() {
	local lb=$1 k=$2 on=$3

	shift 3
	if [ "$on" = 0 ] || [ -z "$on" ]; then
		dt_row " " 0 "$lb" "$k" "$@"
	else
		dt_row "✓" 0 "$lb" "$k" "$@"
	fi
}

# An item that is there but cannot be chosen, which is how a menu says a
# thing exists and is not available now -- quieter than hiding it, and it
# keeps the menu the same shape from one moment to the next.
dt_dim() {
	dt_row "" 1 "$1" "" :
}

# Start a submenu.  Items until dt_end belong to it.
#
# The parent is MB_CUR -- the menu being declared -- and not the last menu
# created, which after one dt_end is the submenu that just closed. Getting
# that wrong hangs the second submenu off the first, and it looks almost
# right until you notice a menu item has gone missing.
dt_sub() {
	local p=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$p]["n"]}
	dt_menu "$1"
	MB[$((MB_N - 1))]["bar"]=0
	MI[$p][$n]["label"]="$1"
	MI[$p][$n]["key"]=""
	MI[$p][$n]["cmd"]=""
	MI[$p][$n]["sep"]=0
	MI[$p][$n]["dim"]=0
	MI[$p][$n]["tick"]=""
	MI[$p][$n]["sub"]=$((MB_N - 1))
	MB[$p]["n"]=$((n + 1))
	dt_wide "$p" $((${#1} + 8))
	MB_STACK="$p $MB_STACK"
}

# Finish a submenu and go back to the menu that owns it.
dt_end() {
	MB_CUR=${MB_STACK%% *}
	MB_STACK=${MB_STACK#* }
}

# Remember the widest label a menu has to fit.
dt_wide() {
	[ "$2" -gt "${MB[$1]["w"]}" ] && MB[$1]["w"]=$2
}

# One row of a menu.  Everything above goes through here.
dt_row() {
	local tick=$1 dim=$2 lb=$3 k=$4 m n

	shift 4
	m=${MB_CUR:-$((MB_N - 1))}
	n=${MB[$m]["n"]}
	MI[$m][$n]["label"]="$lb"
	MI[$m][$n]["key"]="$k"
	MI[$m][$n]["cmd"]="$*"
	MI[$m][$n]["sep"]=0
	MI[$m][$n]["dim"]="$dim"
	MI[$m][$n]["tick"]="$tick"
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
	dt_wide "$m" $((${#lb} + 8))
}

# Add a dividing line.
dt_sep() {
	local m=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$m]["n"]}
	MI[$m][$n]["sep"]=1
	MI[$m][$n]["label"]=
	MI[$m][$n]["key"]=
	MI[$m][$n]["cmd"]=
	MI[$m][$n]["dim"]=0
	MI[$m][$n]["tick"]=""
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
}

# Register an app the hibr menu can open: name, title, height, width.
dt_app() {
	DT_APPS[$1]["title"]="$2"
	DT_APPS[$1]["h"]="$3"
	DT_APPS[$1]["w"]="$4"
	DT_APPS[$1]["once"]=
	[ "$5" = once ] && DT_APPS[$1]["once"]=1
	DT_APPS[$1]["icon"]="${6:-◆}"
	DT_APPS[$1]["fixed"]=
	[ "$7" = fixed ] && DT_APPS[$1]["fixed"]=1
	# hidden is for an app dt_launch has to find by name -- About hibr,
	# or a window like Rename/Get Info that only ever opens on a specific
	# file, never generically -- but that must never appear as a choice
	# of its own on the hibr menu or in App Shortcuts' list of apps to
	# give a global key. dt_appmenu and dt_appnames both read it; neither
	# hardcodes a name the way dt_appmenu once hardcoded "about".
	DT_APPS[$1]["hidden"]=
	[ "$8" = hidden ] && DT_APPS[$1]["hidden"]=1
	# Set by dt_apps while it sources this file, from where it found it --
	# empty for one sourced any other way, which stays a flat item.
	DT_APPS[$1]["dir"]="$DT_APPDIR_CUR"
}

# Where apps are found: every .hibr in each of these, at any depth, in this
# order.  The user's own folder comes first, so a file there replaces a
# bundled app of the same name; a session adds its own folders after.
DT_APPDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps")
declare -gA DT_SRC

# Load every app in the folders.  Each file declares itself with dt_app, so
# the folder is the whole configuration: drop a script in, in a subfolder of
# your own if you like, and it is on the menu at the next start -- globstar
# is always on, which is what makes ** reach into them. A file whose name
# was already loaded from an earlier folder is skipped. An app in a
# subfolder gets a submenu of its own on the hibr menu, named after it --
# DT_APPDIR_CUR is the path dt_app reads to know which, relative to
# whichever root found it, empty at the top of one.
dt_apps() {
	local d f b rel

	for d in "${DT_APPDIRS[@]}"; do
		for f in "$d"/**/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			rel=${f#"$d"/}
			case $rel in
			*/*) DT_APPDIR_CUR=${rel%/*} ;;
			*) DT_APPDIR_CUR= ;;
			esac
			. "$f"
		done
	done
	DT_APPDIR_CUR=
}

# Desk accessories are ordinary apps -- dt_app, nothing else, the same
# registration every other app uses. They get a directory list of their
# own, the same customizable-with-a-default shape DT_APPDIRS and
# CP_PANEDIRS already have, only so the hibr menu can group them under one
# name regardless of where DA_DIRS points -- the nostalgic Desk Accessories
# folder, not a mechanism an accessory has to do anything for. A flat scan,
# not dt_apps' recursive one: an accessory does not earn a folder-submenu
# concept of its own the way a whole app folder does.
DA_DIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desk-accessories")
da_apps() {
	local d f b

	for d in "${DA_DIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			DT_APPDIR_CUR="Desk Accessories"
			. "$f"
		done
	done
	DT_APPDIR_CUR=
}

# Every registered app, sorted by title without regard to case, as names --
# for anything that wants every app in one flat list rather than the hibr
# menu's own folder-grouped one below (Settings' App Shortcuts rows do).
dt_appnames() {
	local n l out=
	local -a all

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		l := str lower "${DT_APPS[$n]["title"]}"
		all+=("$l	$n")
	done
	arr sort all
	for l in "${all[@]}"; do out="$out ${l#*	}"; done
	ret "${out# }"
}

# Add one folder level's worth of the hibr menu: apps stored directly in
# it as items, each immediate child folder as a submenu built the same way,
# recursing to any depth -- prefix is that folder's own path, "" for the
# top. reserved is letters the *caller's* menu has already used, since a
# submenu is its own menu with its own letters otherwise: About hibr, Quit
# and the rest only need keeping clear of at the top.
dt_appmenu() {
	local prefix=$1 used=${2:-} n d l child k path
	local -a all seen

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		d=${DT_APPS[$n]["dir"]}
		if [ "$d" = "$prefix" ]; then
			l := str lower "${DT_APPS[$n]["title"]}"
			all+=("$l	a	$n")
			continue
		fi
		if [ -n "$prefix" ]; then
			case $d in "$prefix"/*) ;; *) continue ;; esac
			child=${d#"$prefix"/}
		else
			[ -z "$d" ] && continue
			child=$d
		fi
		child=${child%%/*}
		case " ${seen[*]-} " in *" $child "*) continue ;; esac
		seen+=("$child")
		l := str lower "$child"
		if [ -n "$prefix" ]; then
			all+=("$l	f	$prefix/$child")
		else
			all+=("$l	f	$child")
		fi
	done
	[ "${#all[@]}" -eq 0 ] && return 0
	arr sort all
	for l in "${all[@]}"; do
		IFS=$'\t' read -r _ kind path <<< "$l"
		if [ "$kind" = f ]; then
			dt_sub "${path##*/}"
			dt_appmenu "$path"
			dt_end
		else
			k := dt_akey "${DT_APPS[$path]["title"]}" "$used"
			used="$used$k"
			dt_item "${DT_APPS[$path]["title"]}" "$k" \
				dt_launch "$path"
		fi
	done
}

# The window already showing an app, if there is one.
dt_appwin() {
	local id

	for id in "${!DT[@]}"; do
		if [ "${DT[$id]["app"]}" = "$1" ]; then
			ret "$id"
			return 0
		fi
	done
	return 1
}

# Open a registered app in a fresh window, stepped down and across so a
# second one does not land exactly on the first.  An app declared `once`
# has one window at most: launching it again brings that one forward,
# shown if it was hidden.  Anything after the name goes to its _open.
dt_launch() {
	local n=$1 r c id

	[ -z "${DT_APPS[$n]["title"]}" ] && return 1
	if [ -n "${DT_APPS[$n]["once"]}" ] && id := dt_appwin "$n"; then
		dt_raise "$id"
		ret "$id"
		return 0
	fi
	r=$((2 + (DT_NEXT * 2) % 6))
	c=$((4 + (DT_NEXT * 4) % 16))
	dt_new "${DT_APPS[$n]["title"]}" "${DT_APPS[$n]["h"]}" \
		"${DT_APPS[$n]["w"]}" "$r" "$c" "$n" "$2"
}

# Rebuild the bar for whatever has focus.  Cheap enough to do every frame:
# it is a handful of assignments, and it has to follow the focus anyway.
dt_menus() {
	local who=${DT_FOCUS:-} ap=

	[ -n "$who" ] && ap=${DT[$who]["app"]}
	MB_N=0

	dt_menu "✎"
	dt_item "About hibr" a dt_about
	dt_sep
	# about already has its own permanent item above; it registers with
	# dt_app only so dt_launch about can find it, not to be listed a
	# second time as an ordinary app -- its own dt_app call marks it
	# hidden, which is what dt_appmenu actually skips.
	dt_appmenu "" aqdu
	dt_sep
	dt_item "Clean Up Icons" u dt_iconclean
	dt_sep
	if [ -n "$HIBR_HOLD" ]; then
		dt_item "Detach" d dt_detach
	else
		dt_dim "Detach"
	fi
	dt_item "Quit" q dt_quit

	# The bar's app name follows focus regardless of whether the app has
	# menus of its own to add -- Clock and About have none, and still have
	# a name.  A window with no registered app (a bare dt_new) has no name
	# to show either, so this still falls back to Desktop for it.
	MB_APP=$ap
	if [ -n "$ap" ] && dt_has "${ap}_menus"; then
		${ap}_menus
	fi

	# Edit is the desktop's, like Window: the same two items everywhere,
	# dimmed where the focused app cannot do them, so it never changes shape.
	dt_menu "Edit"
	if [ -n "$who" ] && [ -n "${DT[$who]["copy"]}" ]; then
		dt_item "Copy       alt-c" c dt_edit copy
	else
		dt_dim "Copy       alt-c"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["cut"]}" ]; then
		dt_item "Cut        alt-x" t dt_edit cut
	else
		dt_dim "Cut        alt-x"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["paste"]}" ] &&
	   [ -n "$DT_CLIP" ]; then
		dt_item "Paste      alt-v" v dt_edit paste
	else
		dt_dim "Paste      alt-v"
	fi

	# Always last, and always there: an app that has its own menus must
	# not be able to hide the only way to move or close its window.
	dt_menu "Window"
	if [ -z "$DT_FOCUS" ]; then
		dt_dim "Move"
		dt_dim "Resize"
		dt_dim "Zoom"
		dt_dim "Hide"
		dt_sep
		dt_dim "Close"
	else
		dt_item "Move" m dt_grab move
		if [ "${DT_APPS[${DT[$DT_FOCUS]["app"]}]["fixed"]}" = 1 ]; then
			dt_dim "Resize"
			dt_dim "Zoom"
		else
			dt_item "Resize" r dt_grab size
			dt_item "Zoom" z dt_zoom_focused
		fi
		dt_item "Hide" h dt_hide_focused
		dt_sep
		dt_item "Close" w dt_close_focused
	fi
	dt_sep
	dt_item "Cycle" c dt_cycle
	dt_layout
}

# Pick an accelerator for a label that nothing else in the menu has taken.
# Calculator and Clock both start with a C, and a menu where two items
# answer to the same letter is a menu where one of them cannot be reached.
dt_akey() {
	local t=$1 used=$2 i=0 c

	while [ "$i" -lt ${#t} ]; do
		c=${t:$i:1}
		c := str lower "$c"
		case $c in
		[a-z])
			case $used in
			*"$c"*) ;;
			*) ret "$c"; return 0 ;;
			esac
			;;
		esac
		i=$((i + 1))
	done
	for c in 1 2 3 4 5 6 7 8 9; do
		case $used in
		*"$c"*) ;;
		*) ret "$c"; return 0 ;;
		esac
	done
	ret ""
}

# Where a single-character accelerator sits in a label, case-insensitive
# -- -1 when it is not one character, or is not actually in the label at
# all, which is true of a shortcut an app author picked to mean
# something rather than to spell part of the word ("x" for "End Task").
# dt_menu_draw underlines the letter in place when this finds one, and
# falls back to showing the key after the label, the way every item
# used to, when it does not.
dt_akeypos() {
	local lb=$1 k=$2 i=0 c lk

	if [ "${#k}" != 1 ]; then
		ret -1
		return 0
	fi
	lk := str lower "$k"
	while [ "$i" -lt "${#lb}" ]; do
		c := str lower "${lb:$i:1}"
		[ "$c" = "$lk" ] && { ret "$i"; return 0; }
		i=$((i + 1))
	done
	ret -1
}

# Work out where each title sits on the bar.
dt_layout() {
	local i=0 c=1 t

	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			MB[$i]["x"]=0
			MB[$i]["tw"]=0
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		MB[$i]["x"]=$c
		MB[$i]["tw"]=$((${#t} + 2))
		c=$((c + ${#t} + 2))
		i=$((i + 1))
	done
	MB_AX=$((DT_COLS - 14))
}

dt_quit() { DT_QUIT=1; }

# --- files between windows -------------------------------------------------
#
# An app starts a drag with dt_dnd from inside its _mouse, naming the paths
# it carries; the desktop draws it under the pointer and hands it on release
# to the _drop of the window it lands on -- or to the desktop itself.  A drop
# moves, and copies with ctrl held; escape cancels.  The moving and copying
# is here, once, so every app refuses the same things and says so the same
# way.

# Start dragging: a label and a picture to show under the pointer, then the
# paths carried.  Icons dragged about the desktop may carry none.
dt_dnd() {
	DT_DNDN=$1
	DT_DNDG=${2:-▯}
	shift 2
	DT_DNDS=("$@")
	DT_DND=1
	DT_DNDICON=
}

dt_dnddraw() {
	console pen "$DT_FACE" "$DT_ACTIVE" bold
	console put "$DT_DNDR" $((DT_DNDC + 1)) " $DT_DNDG $DT_DNDN "
}

# Hand what was dropped to whatever is under the pointer.  Not dt_drop,
# which already draws the open menu.
dt_ondrop() {
	local mr=$1 mc=$2 op=move id ap wr wc
	local -a src

	src=("${DT_DNDS[@]}")
	DT_DND=
	DT_DNDS=()
	case $3 in *ctrl*) op=copy ;; esac
	[ "$mr" = 0 ] && return 0
	id := console hit "$mr" "$mc"
	if [ -n "$id" ]; then
		id=${id#w}
		DT_DNDICON=
		ap=${DT[$id]["drop"]}
		if [ "${#src[@]}" = 0 ]; then
			dt_note "Only files can be dropped on a window"
			return 0
		fi
		if [ -z "$ap" ]; then
			dt_note "${DT[$id]["title"]} does not take files"
			return 0
		fi
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		$ap "$id" $((mr - wr)) $((mc - wc)) "$op" "${src[@]}"
		return 0
	fi
	dt_has dt_deskdrop && dt_deskdrop "$mr" "$mc" "$op" "${src[@]}"
	return 0
}

# Move or copy one path into a folder: 0 done, 1 refused with the reason in
# DT_WHY, 2 nothing to do.  Nothing is ever put over something already
# there, and a folder cannot go inside itself.
dt_fileop1() {
	local op=$1 src=$2 dst=$3 base dir

	base=${src##*/}
	if ! [ -e "$src" ] && ! [ -L "$src" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$dst" ]; then
		DT_WHY="${dst##*/} is not a folder"
		return 1
	fi
	dir=${src%/*}
	[ -z "$dir" ] && dir=/
	[ "$op" = move ] && [ "$dir" = "$dst" ] && return 2
	case "$dst/" in
	"$src/"*)
		DT_WHY="$base cannot go inside itself"
		return 1
		;;
	esac
	if [ -e "$dst/$base" ] || [ -L "$dst/$base" ]; then
		DT_WHY="${dst##*/} already has a $base"
		return 1
	fi
	if [ "$op" = copy ]; then
		command cp -R -- "$src" "$dst/" 2>> "$DT_LOG"
	else
		command mv -- "$src" "$dst/" 2>> "$DT_LOG"
	fi
	if [ $? != 0 ]; then
		DT_WHY="Could not $op $base"
		return 1
	fi
	return 0
}

# Say how a batch went: what was done, and the first thing refused.
dt_tally() {
	local done=$1 bad=$2 what=$3 last=$4 why=$5

	if [ "$bad" = 0 ]; then
		[ "$done" = 1 ] && dt_note "$what $last"
		[ "$done" -gt 1 ] && dt_note "$what $done items"
	elif [ "$done" = 0 ]; then
		if [ "$bad" = 1 ]; then
			dt_note "$why"
		else
			dt_note "$why, and $((bad - 1)) more could not go"
		fi
	else
		dt_note "$what $done; $why"
	fi
}

# Move or copy paths into a folder, and say once how it went.
dt_fileop() {
	local op=$1 dst=$2 src n=0 bad=0 why= last= what

	shift 2
	for src in "$@"; do
		dt_fileop1 "$op" "$src" "$dst"
		case $? in
		0) n=$((n + 1)); last=${src##*/} ;;
		1) bad=$((bad + 1)); [ -z "$why" ] && why=$DT_WHY ;;
		esac
	done
	what="Moved"
	[ "$op" = copy ] && what="Copied"
	if [ "$n" = 1 ]; then
		dt_tally 1 "$bad" "$what" "$last to ${dst##*/}" "$why"
	else
		dt_tally "$n" "$bad" "$what" "" "$why"
		[ "$n" -gt 1 ] && [ "$bad" = 0 ] &&
			dt_note "$what $n items to ${dst##*/}"
	fi
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# Tell every window that shows files that something on disk has changed.
dt_changed() {
	local id cb

	for id in "${!DT[@]}"; do
		cb=${DT[$id]["refresh"]}
		[ -n "$cb" ] && $cb "$id"
	done
	dt_has dt_deskscan && dt_deskscan
	return 0
}

# The trash, where the freedesktop specification puts it, so a file thrown
# away here can be found by any other desktop on the machine and the other
# way round.
DT_TRASH="${DT_TRASH-${XDG_DATA_HOME:-$HOME/.local/share}/Trash}"

# A path as the trash's info file writes it: percent-escaped, UTF-8 left be.
dt_urlpath() {
	local p=$1 out= ch i=0 x

	while [ "$i" -lt "${#p}" ]; do
		ch=${p:i:1}
		case $ch in
		[A-Za-z0-9/._~-]) out="$out$ch" ;;
		*)
			printf -v x '%d' "'$ch"
			if [ "$x" -gt 0 ] && [ "$x" -lt 128 ]; then
				printf -v x '%%%02X' "$x"
				out="$out$x"
			else
				out="$out$ch"
			fi
			;;
		esac
		i=$((i + 1))
	done
	ret "$out"
}

# Move one file or folder to the trash, with the note that says where it
# was: 0 done, 1 refused with the reason in DT_WHY.
dt_trash1() {
	local p=$1 base n i=1 when enc

	base=${p##*/}
	if ! [ -e "$p" ] && ! [ -L "$p" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$DT_TRASH/info" ] || ! [ -d "$DT_TRASH/files" ]; then
		if ! mkdir -p "$DT_TRASH/files" "$DT_TRASH/info" 2> /dev/null; then
			DT_WHY="There is no trash to put $base in"
			return 1
		fi
	fi
	n=$base
	while [ -e "$DT_TRASH/files/$n" ] || [ -L "$DT_TRASH/files/$n" ] ||
	      [ -e "$DT_TRASH/info/$n.trashinfo" ]; do
		n="$base.$i"
		i=$((i + 1))
	done
	printf -v when '%(%Y-%m-%dT%H:%M:%S)T' -1
	enc := dt_urlpath "$p"
	if ! printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$enc" "$when" \
		> "$DT_TRASH/info/$n.trashinfo"; then
		DT_WHY="Could not write the trash's note for $base"
		return 1
	fi
	if ! command mv -- "$p" "$DT_TRASH/files/$n" 2>> "$DT_LOG"; then
		rm -f "$DT_TRASH/info/$n.trashinfo"
		DT_WHY="Could not move $base to the trash"
		return 1
	fi
	return 0
}

# Move paths to the trash, and say once how it went.
dt_trash() {
	local p n=0 bad=0 why= last=

	for p in "$@"; do
		if dt_trash1 "$p"; then
			n=$((n + 1))
			last=${p##*/}
		else
			bad=$((bad + 1))
			[ -z "$why" ] && why=$DT_WHY
		fi
	done
	if [ "$n" = 1 ]; then
		dt_tally 1 "$bad" "Moved" "$last to the trash" "$why"
	else
		dt_tally "$n" "$bad" "Moved" "" "$why"
		[ "$n" -gt 1 ] && [ "$bad" = 0 ] &&
			dt_note "Moved $n items to the trash"
	fi
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# --- application handlers ------------------------------------------------
#
# What opens a file, by its extension -- a script of the user's own
# registers one with dt_handler, the same idiom dt_app uses to register a
# window:
#
#     dt_handler jpg feh
#     dt_handler json term less
#
# "term" runs the program in a terminal window, for anything that reads a
# terminal itself -- an interpreter, a pager; without it the program is
# started detached, for anything that draws its own window outside the
# desktop, such as an image viewer or a media player, which must not be
# waited for or the desktop would hang until it closed. A name with no
# extension, or one nothing was registered for, still opens in a terminal
# with hvi, exactly as it always did.
declare -gA DT_HANDLERS

dt_handler() {
	local ext=$1 term=0 i=0 a

	shift
	if [ "$1" = term ]; then
		term=1
		shift
	fi
	DT_HANDLERS[$ext]["term"]=$term
	for a in "$@"; do
		DT_HANDLERS[$ext][$i]="$a"
		i=$((i + 1))
	done
	DT_HANDLERS[$ext]["n"]=$i
}

# The extension a name is opened by: everything after the last dot, or
# empty for one with none -- "Makefile" and ".bashrc" both have none, since
# a leading dot is the name, not a separator.
dt_ext() {
	local nm=${1##*/}

	case $nm in
	*.*) ret "${nm##*.}" ;;
	*) ret "" ;;
	esac
}

# A handler's own argv, read by term_open once it is asked to run one
# instead of hvi: set right here, right before dt_launch term, so term.hibr
# never has to know this table exists.
DT_OPENCMD=()

# Run a registered handler on a path.
dt_runhandler() {
	local ext=$1 path=$2 n i=0

	n=${DT_HANDLERS[$ext]["n"]}
	DT_OPENCMD=()
	while [ "$i" -lt "$n" ]; do
		DT_OPENCMD+=("${DT_HANDLERS[$ext][$i]}")
		i=$((i + 1))
	done
	if [ "${DT_HANDLERS[$ext]["term"]}" = 1 ]; then
		dt_launch term "$path"
	else
		( "${DT_OPENCMD[@]}" "$path" >> "$DT_LOG" 2>&1 & )
		DT_OPENCMD=()
	fi
}

# Open a path: a folder in a file browser, a registered extension with its
# own handler, a picture in the image viewer if one is loaded, and anything
# else in a terminal with hvi, since every file a terminal can show is one
# it can edit. A user's own dt_handler for the same extension is checked
# first and wins, the same rule a file of your own replacing a bundled app
# already follows elsewhere.
dt_openfile() {
	local ext

	if [ -d "$1" ]; then
		dt_launch files "$1"
		return 0
	fi
	ext := dt_ext "$1"
	if [ -n "${DT_HANDLERS[$ext]["n"]}" ]; then
		dt_runhandler "$ext" "$1"
	elif [ "$ext" = png ] && dt_has imgview_open; then
		dt_launch imgview "$1"
	elif [ -n "${DT_APPS[term]["title"]}" ]; then
		dt_launch term "$1"
	else
		dt_note "Nothing here opens ${1##*/}"
	fi
}

# --- icons on the desktop ----------------------------------------------------
#
# A clean desktop: Home, the disks if DT_DISKS wants them, and the trash --
# laid out down from the top right, where the Mac put them.  Nothing else.
# Apps stay in the hibr menu; the desktop is not a second copy of a folder,
# so no file ever gets an icon of its own just for having been put somewhere.
#
# A double click opens one -- Home and a disk in Files, the trash in Files
# on what it holds.  A click selects, ctrl adds or takes away, shift takes a
# run, and a drag across the empty desktop draws a band that selects what it
# touches.  Dragging a selection moves the icons themselves: somewhere empty
# keeps their arrangement, onto the trash or a disk hands over whatever files
# it carries, onto a window hands the files to that window.  With no window
# focused the arrows move between icons, shift with them extends, space
# picks one, enter opens and delete throws away.  DT_ICONS=0 turns every
# icon off; DT_DISKS=0 leaves Home and the trash but drops the disks.
#
# What is selected is kept by the icon's key, not its place in the list, so
# a rescan -- the disks can change without anyone dragging anything -- does
# not move it to a different icon.

DT_ICONS="${DT_ICONS-1}"
DT_DISKS="${DT_DISKS-1}"
DT_ICONW=12
declare -gA DT_ICONPOS
declare -gA DI
declare -gA DI_MARK
declare -gA DI_KEEP
DI_N=0
DI_CUR=
DI_ANCHOR=
DI_PRESS=
DI_DEFER=
DI_LAST=0
DI_LASTK=
DI_BAND=
DI_BANDR=
DI_SCANT=0
DT_DNDFROM=

# Where an icon was put, as the settings file restores it.
dt_iconpos() {
	DT_ICONPOS["$1"]="$2"
}

# Milliseconds, for telling a double click from two.
dt_ms() {
	local t=${EPOCHREALTIME/./}

	ret $((t / 1000))
}

# One icon.
dt_iconadd() {
	local n=$DI_N

	DI[$n]["kind"]=$1
	DI[$n]["name"]=$2
	DI[$n]["label"]=$3
	DI[$n]["glyph"]=$4
	DI[$n]["key"]=$5
	DI_N=$((n + 1))
}

# Read what the desktop shows: home, the disks if wanted, the trash.
dt_deskscan() {
	local f g

	DI_N=0
	DI_SCANT=$EPOCHSECONDS
	[ "$DT_ICONS" = 1 ] || return 0
	dt_iconadd place "$HOME" "Home" "⌂" home
	[ "$DT_DISKS" = 1 ] && dt_diskscan
	g="▽"
	for f in "$DT_TRASH"/files/* "$DT_TRASH"/files/.*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		case ${f##*/} in . | ..) continue ;; esac
		g="▼"
		break
	done
	dt_iconadd trash "$DT_TRASH/files" "Trash" "$g" trash
	dt_iconlay
}

# Real, mounted disks: a filesystem backed by an actual block device, so
# tmpfs, proc, cgroups and the dozen other things a modern kernel mounts
# never turn up as one.  DT_MOUNTS is /proc/mounts, overridable so a test can
# hand this a file of its own rather than reporting on whatever is real.
# Reading it is one open and a loop of reads, never a fork.
DT_MOUNTS="${DT_MOUNTS-/proc/mounts}"
DT_DISKFS="${DT_DISKFS-ext2 ext3 ext4 xfs btrfs vfat exfat ntfs ntfs3 \
iso9660 udf zfs hfsplus apfs}"
dt_diskscan() {
	local dev mnt fs rest lbl

	[ -r "$DT_MOUNTS" ] || return 0
	while IFS=' ' read -r dev mnt fs rest; do
		case $dev in /dev/*) ;; *) continue ;; esac
		case " $DT_DISKFS " in *" $fs "*) ;; *) continue ;; esac
		mnt=${mnt//\\040/ }
		if [ "$mnt" = / ]; then
			lbl=/
		else
			lbl=${mnt##*/}
		fi
		dt_iconadd place "$mnt" "$lbl" "▥" "disk:$mnt"
	done < "$DT_MOUNTS"
}

# Where each icon goes: where it was put, or the next free place down from
# the top right, a column at a time.
dt_iconlay() {
	local i=0 slot=0 per p k r c cl

	per=$(((DT_ROWS - 2) / 3))
	[ "$per" -lt 1 ] && per=1
	while [ "$i" -lt "$DI_N" ]; do
		k=${DI[$i]["key"]}
		p=${DT_ICONPOS["$k"]}
		if [ -n "$p" ]; then
			# A saved spot is a preference, not a promise: clamp it to
			# whatever screen this is on every time, or an icon dragged
			# to the edge on a wide one lands off-screen, or under the
			# bar, after a resize to a narrower one -- dt_size calls
			# this on every resize for exactly that.  The saved value
			# itself is left alone, so it fits again if the screen does.
			cl := dt_iconclamp "${p% *}" "${p#* }"
			r=${cl% *}
			c=${cl#* }
		else
			r=$((2 + (slot % per) * 3))
			c=$((DT_COLS - DT_ICONW - 1 - (slot / per) * DT_ICONW))
			slot=$((slot + 1))
		fi
		DI[$i]["r"]=$r
		DI[$i]["c"]=$c
		i=$((i + 1))
	done
}

dt_icondraw() {
	local i=0 r c g l k

	while [ "$i" -lt "$DI_N" ]; do
		r=${DI[$i]["r"]}
		c=${DI[$i]["c"]}
		g=${DI[$i]["glyph"]}
		l=${DI[$i]["label"]}
		k=${DI[$i]["key"]}
		[ "${#l}" -gt $((DT_ICONW - 2)) ] && l="${l:0:$((DT_ICONW - 3))}…"
		case ${DI[$i]["kind"]} in
		dir) console pen "#f6ad55" "$DT_WALL" bold ;;
		trash) console pen "$DT_INK" "$DT_WALL" bold ;;
		*) console pen "$DT_ACTIVE" "$DT_WALL" bold ;;
		esac
		console put "$r" $((c + (DT_ICONW - ${#g}) / 2)) "$g"
		if [ -n "${DI_MARK["$k"]}" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		elif [ "$k" = "$DI_CUR" ]; then
			console pen "$DT_INK" "$DT_IDLE"
		else
			console pen "$DT_INK" "$DT_WALL"
		fi
		console put $((r + 1)) $((c + (DT_ICONW - ${#l}) / 2)) "$l"
		i=$((i + 1))
	done
	[ -n "$DI_BANDR" ] && dt_banddraw
}

# The rubber band, drawn dashed so it reads as a selection, not a window.
dt_banddraw() {
	local r0 c0 r1 c1 r t

	read -r r0 c0 r1 c1 <<< "$DI_BANDR"
	console pen "$DT_ACTIVE" "$DT_WALL"
	if [ "$c1" -gt "$c0" ]; then
		t := str repeat "┄" $((c1 - c0 + 1))
		console put "$r0" "$c0" "$t"
		console put "$r1" "$c0" "$t"
	fi
	r=$r0
	while [ "$r" -le "$r1" ]; do
		console put "$r" "$c0" "┆"
		console put "$r" "$c1" "┆"
		r=$((r + 1))
	done
}

# Which icon is at a cell, if any; the last drawn is on top.
dt_iconat() {
	local i=$DI_N r c

	while [ "$i" -gt 0 ]; do
		i=$((i - 1))
		r=${DI[$i]["r"]}
		c=${DI[$i]["c"]}
		if [ "$1" -ge "$r" ] && [ "$1" -le $((r + 1)) ] &&
		   [ "$2" -ge "$c" ] && [ "$2" -lt $((c + DT_ICONW)) ]; then
			ret "$i"
			return 0
		fi
	done
	return 1
}

# The icon with a key, by its place in the list.
dt_iconidx() {
	local i=0

	while [ "$i" -lt "$DI_N" ]; do
		if [ "${DI[$i]["key"]}" = "$1" ]; then
			ret "$i"
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

# Nothing selected.
dt_iconclear() {
	local k

	for k in "${!DI_MARK[@]}"; do unset DI_MARK["$k"]; done
}

# Select or unselect one icon by key.
dt_iconmark() {
	if [ "$2" = 1 ]; then
		DI_MARK["$1"]=1
	else
		unset DI_MARK["$1"]
	fi
}

# What is selected, as places in the list; the cursor alone when nothing is.
dt_iconsel() {
	local i=0 out=

	while [ "$i" -lt "$DI_N" ]; do
		[ -n "${DI_MARK["${DI[$i]["key"]}"]}" ] && out="$out $i"
		i=$((i + 1))
	done
	if [ -z "$out" ] && [ -n "$DI_CUR" ]; then
		dt_iconidx "$DI_CUR" || return 1
		return 0
	fi
	[ -n "$out" ] || return 1
	ret "${out# }"
}

# The files behind a list of icons, for a drag or a delete: only a kind that
# means "a disposable file" hands one back.  place -- Home, a disk -- never
# does, or dragging Home onto the trash would trash the whole home directory;
# neither does trash itself.  Nothing makes a dir or file icon right now, but
# the kind is kept for whatever eventually does.
dt_iconpaths() {
	local i

	DT_PATHS=()
	for i in $1; do
		case ${DI[$i]["kind"]} in
		dir | file) DT_PATHS+=("${DI[$i]["name"]}") ;;
		esac
	done
}

# Select a run of icons, in the order they are listed.
dt_iconrange() {
	local a b i

	a := dt_iconidx "$1" || return 0
	b := dt_iconidx "$2" || return 0
	[ "$a" -gt "$b" ] && { i=$a; a=$b; b=$i; }
	i=$a
	while [ "$i" -le "$b" ]; do
		DI_MARK["${DI[$i]["key"]}"]=1
		i=$((i + 1))
	done
}

# A press on the desktop.  On an icon: select it, add it with ctrl, take a
# run with shift, open it if it was pressed a moment ago.  A plain press on
# something already selected leaves the rest selected until the button comes
# up, so a selection can be picked up and dragged whole.  On nothing: start
# a rubber band.
dt_iconpress() {
	local mr=$1 mc=$2 mods=$3 i k now

	DI_PRESS=
	DI_DEFER=
	if ! i := dt_iconat "$mr" "$mc"; then
		case $mods in *ctrl*) ;; *) dt_iconclear ;; esac
		dt_iconclear_keep
		DI_BAND="$mr $mc"
		DI_BANDR=
		return 0
	fi
	k=${DI[$i]["key"]}
	now := dt_ms
	case $mods in
	*ctrl*)
		if [ -n "${DI_MARK["$k"]}" ]; then
			dt_iconmark "$k" 0
		else
			dt_iconmark "$k" 1
		fi
		DI_ANCHOR=$k
		;;
	*shift*)
		[ -n "$DI_ANCHOR" ] || DI_ANCHOR=$k
		dt_iconclear
		dt_iconrange "$DI_ANCHOR" "$k"
		;;
	*)
		if [ "$k" = "$DI_LASTK" ] && [ $((now - DI_LAST)) -lt 700 ]; then
			DI_LAST=0
			dt_iconopen "$i"
			return 0
		fi
		if [ -n "${DI_MARK["$k"]}" ] && [ "${#DI_MARK[@]}" -gt 1 ]; then
			DI_DEFER=1
		else
			dt_iconclear
			dt_iconmark "$k" 1
		fi
		DI_ANCHOR=$k
		;;
	esac
	DI_CUR=$k
	DI_LAST=$now
	DI_LASTK=$k
	DI_PRESS="$i $mr $mc"
}

# Remember what was selected when a band starts, so ctrl can add to it.
dt_iconclear_keep() {
	local k

	for k in "${!DI_KEEP[@]}"; do unset DI_KEEP["$k"]; done
	for k in "${!DI_MARK[@]}"; do DI_KEEP["$k"]=1; done
}

# Stretch the rubber band, selecting every icon it touches.
dt_iconband() {
	local act=$1 mr=$2 mc=$3 r0 c0 r1 c1 i r c k

	if [ "$act" = release ]; then
		DI_BAND=
		DI_BANDR=
		return 0
	fi
	r0=${DI_BAND% *}
	c0=${DI_BAND#* }
	r1=$mr
	c1=$mc
	[ "$r0" -gt "$r1" ] && { r=$r0; r0=$r1; r1=$r; }
	[ "$c0" -gt "$c1" ] && { c=$c0; c0=$c1; c1=$c; }
	[ "$r0" -lt 1 ] && r0=1
	DI_BANDR="$r0 $c0 $r1 $c1"
	i=0
	while [ "$i" -lt "$DI_N" ]; do
		r=${DI[$i]["r"]}
		c=${DI[$i]["c"]}
		k=${DI[$i]["key"]}
		if [ $((r + 1)) -ge "$r0" ] && [ "$r" -le "$r1" ] &&
		   [ $((c + DT_ICONW - 1)) -ge "$c0" ] && [ "$c" -le "$c1" ]; then
			DI_MARK["$k"]=1
		elif [ -z "${DI_KEEP["$k"]}" ]; then
			unset DI_MARK["$k"]
		fi
		i=$((i + 1))
	done
}

# Moving after a press on an icon drags the selection; letting go without
# moving is only a click, which settles a deferred one.
dt_iconmove() {
	local act=$1 mr=$2 mc=$3 i pr pc sel n

	if [ "$act" = release ]; then
		if [ -n "$DI_DEFER" ]; then
			dt_iconclear
			dt_iconmark "$DI_CUR" 1
		fi
		DI_PRESS=
		DI_DEFER=
		return 0
	fi
	i=${DI_PRESS%% *}
	pr=${DI_PRESS#* }
	pc=${pr#* }
	pr=${pr% *}
	if [ "$mr" = "$pr" ] && [ $((mc - pc)) -lt 2 ] &&
	   [ $((pc - mc)) -lt 2 ]; then
		return 0
	fi
	DI_PRESS=
	DI_DEFER=
	sel := dt_iconsel || sel=$i
	case " $sel " in *" $i "*) ;; *) sel=$i ;; esac
	dt_iconpaths "$sel"
	set -- $sel
	n=$#
	if [ "$n" = 1 ]; then
		dt_dnd "${DI[$i]["label"]}" "${DI[$i]["glyph"]}" "${DT_PATHS[@]}"
	else
		dt_dnd "$n items" "${DI[$i]["glyph"]}" "${DT_PATHS[@]}"
	fi
	DT_DNDICON=$sel
	DT_DNDFROM="$pr $pc"
	DT_DNDR=$mr
	DT_DNDC=$mc
}

# Open what an icon stands for.
dt_iconopen() {
	local i=$1

	case ${DI[$i]["kind"]} in
	place) dt_launch files "${DI[$i]["name"]}" ;;
	trash)
		mkdir -p "$DT_TRASH/files" 2> /dev/null
		dt_launch files "$DT_TRASH/files"
		;;
	esac
}

# Put an icon at a place, kept on the screen, and remember it.
# A row and column pulled onto the screen an icon is twelve columns wide and
# three rows tall on, its top-left corner kept below the menu bar.
dt_iconclamp() {
	local r=$1 c=$2

	[ "$r" -lt 1 ] && r=1
	[ "$r" -gt $((DT_ROWS - 3)) ] && r=$((DT_ROWS - 3))
	[ "$c" -lt 0 ] && c=0
	[ "$c" -gt $((DT_COLS - DT_ICONW)) ] && c=$((DT_COLS - DT_ICONW))
	ret "$r $c"
}

dt_iconset() {
	local key=$1 cl

	cl := dt_iconclamp "$2" "$3"
	DT_ICONPOS["$key"]=$cl
}

# Forget every saved position and lay every icon out fresh, for when they
# have drifted somewhere inconvenient -- the hibr menu's Clean Up Icons.
dt_iconclean() {
	DT_ICONPOS=()
	dt_iconlay
	dt_save
}

# Put an icon where it was let go, centred under the pointer.
dt_iconplace() {
	dt_iconset "$1" "$2" $(($3 - DT_ICONW / 2))
	dt_iconlay
	dt_save
}

# Something let go over the desktop rather than a window: onto an icon, it
# does what that icon means for files; onto empty wallpaper, a selection of
# icons being dragged is repositioned there, and files from anywhere else are
# refused -- the background holds no files of its own to receive them.
dt_deskdrop() {
	local mr=$1 mc=$2 op=$3 from=$DT_DNDICON at=$DT_DNDFROM i dr dc p r

	shift 3
	DT_DNDICON=
	DT_DNDFROM=
	if i := dt_iconat "$mr" "$mc"; then
		case " $from " in
		*" $i "*) ;;
		*)
			[ $# -gt 0 ] || return 0
			case ${DI[$i]["kind"]} in
			trash) dt_trash "$@" ;;
			place) dt_fileop "$op" "${DI[$i]["name"]}" "$@" ;;
			esac
			return 0
			;;
		esac
	fi
	if [ -n "$from" ]; then
		dr=$((mr - ${at% *}))
		dc=$((mc - ${at#* }))
		for i in $from; do
			r=${DI[$i]["r"]}
			p=${DI[$i]["c"]}
			dt_iconset "${DI[$i]["key"]}" $((r + dr)) $((p + dc))
		done
		dt_iconlay
		dt_save
		return 0
	fi
	[ $# -gt 0 ] && dt_note "Drop onto Home, a disk, or the trash"
}

# The icon nearest the current one in a direction: what is that way, and of
# that, what is closest, counting a row as four columns since icons are
# three rows tall and twelve columns wide.
dt_iconnear() {
	local dir=$1 i=0 cur r0 c0 r c d best= bd dx dy

	if ! cur := dt_iconidx "$DI_CUR"; then
		ret 0
		return 0
	fi
	r0=${DI[$cur]["r"]}
	c0=${DI[$cur]["c"]}
	while [ "$i" -lt "$DI_N" ]; do
		r=${DI[$i]["r"]}
		c=${DI[$i]["c"]}
		dx=$((c - c0))
		dy=$((r - r0))
		d=
		case $dir in
		up) [ "$dy" -lt 0 ] && d=$((-dy * 4 + ${dx#-} * 2)) ;;
		down) [ "$dy" -gt 0 ] && d=$((dy * 4 + ${dx#-} * 2)) ;;
		left) [ "$dx" -lt 0 ] && d=$((-dx + ${dy#-} * 8)) ;;
		right) [ "$dx" -gt 0 ] && d=$((dx + ${dy#-} * 8)) ;;
		esac
		if [ -n "$d" ] && { [ -z "$best" ] || [ "$d" -lt "$bd" ]; }; then
			best=$i
			bd=$d
		fi
		i=$((i + 1))
	done
	[ -n "$best" ] || best=$cur
	ret "$best"
}

# Keys on the desktop, while no window has focus.
dt_iconkey() {
	local k=$1 i sel

	[ "$DI_N" -gt 0 ] || return 1
	case $k in
	up | down | left | right | shift-up | shift-down | shift-left | \
	shift-right)
		i := dt_iconnear "${k#shift-}"
		case $k in
		shift-*)
			[ -n "$DI_CUR" ] && dt_iconmark "$DI_CUR" 1
			dt_iconmark "${DI[$i]["key"]}" 1
			;;
		*)
			dt_iconclear
			dt_iconmark "${DI[$i]["key"]}" 1
			DI_ANCHOR=${DI[$i]["key"]}
			;;
		esac
		DI_CUR=${DI[$i]["key"]}
		;;
	" " | space)
		[ -n "$DI_CUR" ] || return 0
		if [ -n "${DI_MARK["$DI_CUR"]}" ]; then
			dt_iconmark "$DI_CUR" 0
		else
			dt_iconmark "$DI_CUR" 1
		fi
		;;
	ctrl-a)
		i=0
		while [ "$i" -lt "$DI_N" ]; do
			DI_MARK["${DI[$i]["key"]}"]=1
			i=$((i + 1))
		done
		;;
	enter)
		sel := dt_iconsel || return 0
		for i in $sel; do dt_iconopen "$i"; done
		;;
	delete)
		sel := dt_iconsel || return 0
		dt_iconpaths "$sel"
		[ "${#DT_PATHS[@]}" -gt 0 ] && dt_trash "${DT_PATHS[@]}"
		;;
	*) return 1 ;;
	esac
	return 0
}

# What the desktop copies: the paths of the selected files, one to a line.
dt_iconcopy() {
	local sel i out=

	sel := dt_iconsel || return 1
	for i in $sel; do
		case ${DI[$i]["kind"]} in
		place | dir | file) out="$out${DI[$i]["name"]}"$'\n' ;;
		esac
	done
	[ -n "$out" ] || return 1
	ret "${out%$'\n'}"
}

# Give a window a new title; an app knows what it is showing better than
# the menu that opened it does.
dt_retitle() {
	DT[$1]["title"]="$2"
}

# Copy or cut from the focused window, or paste into it.
#
# An app offers <app>_copy and, if it can move rather than only duplicate
# what is selected, <app>_cut -- both hand back the same kind of text with
# ret and fail when nothing is selected.  <app>_paste is given the text and,
# third, cut or copy, so a paste after Cut can move what it receives instead
# of copying it.  The desktop keeps one clipboard for every window, and also
# sends a copy to the clipboard of the terminal it runs on, where that
# terminal allows it -- so what is copied or cut here pastes into anything
# else on the machine.
dt_edit() {
	local cb t

	if [ -z "$DT_FOCUS" ]; then
		[ "$1" = copy ] || return 0
		if t := dt_iconcopy && [ -n "$t" ]; then
			DT_CLIP=$t
			DT_CLIPOP=copy
			console clip "$t"
			dt_note "Copied the paths of what is selected"
		else
			dt_note "No file is selected"
		fi
		return 0
	fi
	cb=${DT[$DT_FOCUS]["$1"]}
	if [ -z "$cb" ]; then
		dt_note "${DT[$DT_FOCUS]["title"]} cannot $1"
		return 0
	fi
	if [ "$1" = paste ]; then
		[ -n "$DT_CLIP" ] && $cb "$DT_FOCUS" "$DT_CLIP" "${DT_CLIPOP:-copy}"
		return 0
	fi
	if ! t := $cb "$DT_FOCUS" || [ -z "$t" ]; then
		dt_note "Nothing is selected"
		return 0
	fi
	DT_CLIP=$t
	DT_CLIPOP=$1
	console clip "$t"
	if [ "$1" = cut ]; then
		dt_note "Cut ${#t} characters"
	else
		dt_note "Copied ${#t} characters"
	fi
}

# --- staying detachable ----------------------------------------------------
#
# Detach only works when the desktop is a held session.  A session calls
# dt_autohold once, before dt_open, to make sure it always is: if it is not
# already held, this restarts it -- the same command, the same arguments --
# inside one, under a free name, and attaches to it right here, so from the
# terminal it looks exactly like the desktop just starting.  This process
# then takes on whatever the held one ends with, and the desktop nothing
# else has changed about runs there instead.
#
# It does nothing, quietly, wherever holding cannot make sense -- no hold
# module, no real terminal to attach from -- or if starting one fails for any
# reason, so a session that calls it is never worse off than one that does
# not: Detach stays dimmed and the desktop opens here as it always did.
#
# A name already running is left alone unless resume asks for it -- coming
# back to the same desktop should be something a session's own --resume
# flag says plainly, not something a bare rerun does on its own guess.

# Every session name already in use, space separated.
dt_holdnames() {
	local lst line out=

	lst := hold list
	while IFS= read -r line; do
		[ -n "$line" ] && out="$out ${line%% *}"
	done <<< "$lst"
	ret "${out# }"
}

dt_autohold() {
	local base=${1:-desktop} resume=$2 have

	[ -n "$HIBR_HOLD" ] && return 0
	[ -t 0 ] && [ -t 1 ] || return 0
	need hold || return 0
	have := dt_holdnames
	case " $have " in
	*" $base "*)
		if [ "$resume" = 1 ]; then
			hold attach "$base"
			exit $?
		fi
		echo "$0: $base is already running -- add --resume to reattach," \
			"or run 'hold attach $base' directly" >&2
		exit 1
		;;
	esac
	hold new -d "$base" hibr "$0" "${DT_SELFARGS[@]}" || return 0
	hold attach "$base"
	exit $?
}

# Leave the desktop running and give the terminal back.  Only a desktop
# started with `hold new` can, which is why the item is dimmed otherwise --
# dt_autohold is what makes that true from the moment this one opens.
dt_detach() {
	need hold && hold detach
}
# The about app shows the machine's own numbers, live; without it (a session
# that never called dt_apps, or one that dropped the file) a note still says
# what this is, since About hibr must never be a dead menu item.
dt_about() {
	dt_has about_draw && { dt_launch about; return 0; }
	dt_note "hibr $HIBR_VERSION — a desktop written in the shell it runs on"
}
dt_close_focused() { [ -n "$DT_FOCUS" ] && dt_del "$DT_FOCUS"; }
dt_hide_focused() { [ -n "$DT_FOCUS" ] && dt_min "$DT_FOCUS"; }
dt_zoom_focused() { [ -n "$DT_FOCUS" ] && dt_zoom "$DT_FOCUS"; }

# Bring the bottom window to the top.
dt_cycle() {
	local l
	l := console pane list
	l=${l%% *}
	[ -n "$l" ] && dt_raise "${l#w}"
}

# Draw the bar itself.
dt_bar() {
	local i=0 t line now

	[ "$DT_BARSHADOW" = 1 ] &&
		console darken 1 0 1 "$DT_COLS" "$DT_SHADOW_PCT"
	console pen "$DT_INK" "$DT_BAR"
	line := dt_rep "$DT_COLS" " "
	console put 0 0 "$line"

	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		if [ "$i" = "$MB_OPEN" ] || [ "$i" = "$MB_PAR" ]; then
			console pen "$DT_BAR" "$DT_ACTIVE" bold
		elif [ "$i" = 0 ]; then
			console pen "$DT_ACTIVE" "$DT_BAR" bold
		else
			console pen "$DT_INK" "$DT_BAR"
		fi
		console put 0 "${MB[$i]["x"]}" " $t "
		i=$((i + 1))
	done

	printf -v now "%(%H:%M)T" -1
	console pen "$DT_INK" "$DT_BAR"
	console put 0 $((DT_COLS - 19)) "$now"
	if [ "$MB_OPEN" = app ]; then
		console pen "$DT_BAR" "$DT_ACTIVE" bold
	else
		console pen "$DT_INK" "$DT_BAR"
	fi
	t := dt_appname
	console put 0 "$MB_AX" " ${t:0:11} ▾"
}

# What to call the active application on the right of the bar.
dt_appname() {
	if [ -z "$MB_APP" ]; then
		ret "Desktop"
	elif [ -n "${DT_APPS[$MB_APP]["title"]}" ]; then
		ret "${DT_APPS[$MB_APP]["title"]}"
	else
		ret "$MB_APP"
	fi
}

# Draw the open menu over everything else.
dt_drop() {
	local m=$MB_OPEN

	[ "$m" = -1 ] && return 0
	if [ "$m" = app ]; then
		dt_drop_apps
		return 0
	fi
	if [ -n "$MB_PAR" ]; then
		dt_menu_draw "$MB_PAR" "" 1
		dt_menu_draw "$m" "${MB[$m]["px"]}" 0
	else
		dt_menu_draw "$m" "" 0
	fi
}

# Draw one menu at its own place.  A submenu is given the column its parent
# occupies so it can sit beside it rather than on top of it.
dt_menu_draw() {
	local m=$1 px=$2 parent=$3
	local i=0 r=1 x w n lb k t sub rowfg rowbg rowbold pos full pre hl post

	x=${MB[$m]["x"]}
	w=${MB[$m]["w"]}
	n=${MB[$m]["n"]}
	[ "$w" -lt 14 ] && w=14
	if [ -n "$px" ]; then
		x=$px
		r=${MB[$m]["py"]:-1}
	elif [ -n "$MB_CX" ]; then
		x=$MB_CX
		r=${MB_CY:-1}
	fi
	[ "$x" -lt 0 ] && x=0
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	[ $((r + n + 1)) -gt "$DT_ROWS" ] && r=$((DT_ROWS - n - 1))
	[ "$r" -lt 1 ] && r=1
	MB[$m]["dy"]=$r
	MB[$m]["dx"]=$x
	MB[$m]["dw"]=$w
	[ "$DT_MSHADOW" = 1 ] &&
		console darken $((r + 1)) $((x + 2)) $((n + 1)) "$w" "$DT_SHADOW_PCT"
	while [ "$i" -lt "$n" ]; do
		if [ "${MI[$m][$i]["sep"]}" = 1 ]; then
			console pen "$DT_IDLE" "$DT_FACE"
			lb := dt_rep "$w" "─"
			console put "$r" "$x" "$lb"
			r=$((r + 1))
			i=$((i + 1))
			continue
		fi
		if [ "$parent" != 1 ] && [ "$i" = "$MB_SEL" ]; then
			rowfg=$DT_FACE; rowbg=$DT_ACTIVE; rowbold=1
		elif [ "${MI[$m][$i]["dim"]}" = 1 ]; then
			rowfg=$DT_IDLE; rowbg=$DT_FACE; rowbold=0
		else
			rowfg=$DT_INK; rowbg=$DT_FACE; rowbold=0
		fi
		if [ "$rowbold" = 1 ]; then
			console pen "$rowfg" "$rowbg" bold
		else
			console pen "$rowfg" "$rowbg"
		fi
		lb=${MI[$m][$i]["label"]}
		k=${MI[$m][$i]["key"]}
		t=${MI[$m][$i]["tick"]}
		sub=${MI[$m][$i]["sub"]}
		if [ -n "$sub" ]; then
			k="▸"
			pos=-1
		else
			pos := dt_akeypos "$lb" "$k"
		fi
		[ -z "$t" ] && t=" "
		if [ "$pos" -ge 0 ]; then
			# The accelerator is a real letter of the label -- underline
			# it in place instead of repeating it after the label, which
			# is what #55 asked for: a trailing "f" for "Files" reads
			# like a second, unexplained shortcut next to the real ones
			# App Shortcuts assigns, not a hint about the letter beside
			# it. "$t " (tick-or-blank, then a space) always precedes
			# the label, so the label's own position shifts by 2.
			pos=$((pos + 2))
			full="$t $lb"
			full := str pad "$full" $((w - 3))
			pre=${full:0:$pos}
			hl=${full:$pos:1}
			post=${full:$((pos + 1))}
			console put "$r" "$x" "$pre"
			if [ "$rowbold" = 1 ]; then
				console pen "$rowfg" "$rowbg" bold underline
			else
				console pen "$rowfg" "$rowbg" underline
			fi
			console put "$r" $((x + pos)) "$hl"
			if [ "$rowbold" = 1 ]; then
				console pen "$rowfg" "$rowbg" bold
			else
				console pen "$rowfg" "$rowbg"
			fi
			console put "$r" $((x + pos + 1)) "$post   "
		else
			# No letter of the label to underline -- a shortcut an app
			# author picked to mean something rather than spell part of
			# the word ("x" for "End Task"), or dt_akey's own digit
			# fallback when a menu ran out of free letters. Shown after
			# the label, as every item's always been.
			lb := str pad "$t $lb" $((w - 3))
			console put "$r" "$x" "$lb $k "
		fi
		r=$((r + 1))
		i=$((i + 1))
	done
	console pen "$DT_INK" "$DT_FACE"
	lb := dt_rep "$w" " "
	console put "$r" "$x" "$lb"
}

# The application menu: every window, the hidden ones marked.
dt_drop_apps() {
	local ids id i=0 r=1 x w=18 t mark n

	ids := dt_ids
	x=$((MB_AX - 4))
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	set -- $ids
	n=$#
	[ "$n" = 0 ] && n=1
	[ "$DT_MSHADOW" = 1 ] &&
		console darken $((r + 1)) $((x + 2)) $((n + 1)) "$w" "$DT_SHADOW_PCT"
	for id in $ids; do
		if [ "$i" = "$MB_SEL" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		mark=" "
		[ "$id" = "$DT_FOCUS" ] && mark="•"
		dt_hidden "$id" && mark="·"
		t := dt_title "$id"
		t := str pad "$mark ${t}" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
		i=$((i + 1))
	done
	if [ "$i" = 0 ]; then
		console pen "$DT_IDLE" "$DT_FACE"
		t := str pad " no windows" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
	fi
	console pen "$DT_INK" "$DT_FACE"
	t := dt_rep "$w" " "
	console put "$r" "$x" "$t"
	MB_AN=$i
}

# How many rows the open menu occupies, and how many items it holds.
dt_mrows() {
	if [ "$MB_OPEN" = app ]; then
		ret "${MB_AN:-0}"
	else
		ret "${MB[$MB_OPEN]["n"]}"
	fi
}

# Move the highlight, stepping over separators.
dt_mmove() {
	local d=$1 n i=$MB_SEL k=0

	n := dt_mrows
	[ "$n" = 0 ] && return 0
	while [ "$k" -lt "$n" ]; do
		i=$(((i + d + n) % n))
		[ "$MB_OPEN" = app ] && break
		[ "${MI[$MB_OPEN][$i]["sep"]}" = 1 ] && { k=$((k + 1)); continue; }
		[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] && { k=$((k + 1)); continue; }
		break
	done
	MB_SEL=$i
}

# Open a menu, closing whatever was open.
dt_mopen() {
	MB_OPEN=$1
	MB_PAR=
	MB_SEL=0
	MB_CX=
	MB_CY=
	MB_CTXWHO=
	MB_CTXID=
	[ "$1" = app ] && return 0
	[ "${MI[$1][0]["sep"]}" = 1 ] || [ "${MI[$1][0]["dim"]}" = 1 ] &&
		dt_mmove 1
}

dt_mclose() {
	MB_OPEN=-1
	MB_PAR=
	MB_SEL=0
	MB_CX=
	MB_CY=
	MB_CTXWHO=
	MB_CTXID=
}

# Ask for a menu at the pointer rather than under a bar title: who is
# "desktop" for the hibr menu, or an app's prefix for its own <app>_context.
# The menu itself does not exist until the next frame builds it -- dt_mouse
# only records where and for whom, the same lag any other request has.
dt_context_open() {
	MB_CTXWHO=$1
	MB_CTXID=$2
	MB_CY=$3
	MB_CX=$4
	MB_PAR=
	MB_SEL=0
}

# Build or drop the open context menu, once a frame, after dt_menus has
# rebuilt the bar -- an app's own items are no more special than Window's,
# rebuilt fresh every time for the same reason. desktop reuses index 0,
# the hibr menu dt_menus just built, rather than building anything of its
# own.
dt_ctxbuild() {
	local before who=$MB_CTXWHO

	[ -z "$who" ] && return 0
	case $who in
	desktop) before=$MB_N; dt_deskcontext ;;
	titlebar) before=$MB_N; dt_titlecontext "$MB_CTXID" ;;
	bar) before=$MB_N; dt_barcontext ;;
	widget) before=$MB_N; dt_dropcontext ;;
	*)
		if ! dt_has "${who}_context"; then
			dt_mclose
			return 0
		fi
		before=$MB_N
		"${who}_context" "$MB_CTXID"
		;;
	esac
	if [ "$MB_N" = "$before" ]; then
		dt_mclose
		return 0
	fi
	# dt_menu always marks what it starts as a bar title, since every other
	# caller is building the bar itself; a context menu is never on it.
	MB[$before]["bar"]=0
	# Only the first frame opens it here -- every one after runs while the
	# menu is already up, possibly down inside a submenu of its own, and
	# resetting MB_OPEN on every rebuild snapped that shut the moment it
	# opened: dt_mdown set it, and the next frame's dt_ctxbuild set it right
	# back.
	[ "$MB_OPEN" = -1 ] && MB_OPEN=$before
}

# --- widgets -----------------------------------------------------------
#
# A checkbox and a dropdown, drawn the same way any other app content is:
# console put into the window's own pane, in the coordinates it draws in.
# Neither keeps state of its own -- an app passes in what to show and gets
# a tag back from dt_hit when its region is clicked, the same contract as
# an app's own _click callback, and updates its own state under its own
# window id, never here.
declare -gA WG

# Forget a window's widget regions.  Call at the top of its _draw, before
# drawing any dt_check or dt_wdrop -- a scrolled list moves them, so last
# frame's regions must not answer this frame's click.
dt_wclear() {
	unset "WG[$1]"
}

# Record a widget's hit region.  The draw helpers below call this; an app
# does not call it directly.
dt_wreg() {
	local id=$1 r=$2 c=$3 w=$4 tag=$5 n

	n=${WG[$id]["n"]:-0}
	WG[$id][$n]["r"]=$r
	WG[$id][$n]["c"]=$c
	WG[$id][$n]["w"]=$w
	WG[$id][$n]["tag"]=$tag
	WG[$id]["n"]=$((n + 1))
}

# Which widget, if any, sits at a pane-relative row/col -- ret's its tag,
# empty for none.  An app's _click asks this before falling back to its
# own per-row logic.
dt_hit() {
	local id=$1 r=$2 c=$3 n i=0 wr wc ww

	n=${WG[$id]["n"]:-0}
	while [ "$i" -lt "$n" ]; do
		wr=${WG[$id][$i]["r"]}
		wc=${WG[$id][$i]["c"]}
		ww=${WG[$id][$i]["w"]}
		if [ "$r" = "$wr" ] && [ "$c" -ge "$wc" ] &&
		   [ "$c" -lt $((wc + ww)) ]; then
			ret "${WG[$id][$i]["tag"]}"
			return 0
		fi
		i=$((i + 1))
	done
	ret ""
}

# The column a registered widget's own region starts at, for opening
# something (a dropdown's popup) aligned to the widget itself rather than
# to wherever inside it happened to be clicked -- id and row the same as
# the dt_hit call that found tag there.
dt_wcol() {
	local id=$1 r=$2 tag=$3 n i=0

	n=${WG[$id]["n"]:-0}
	while [ "$i" -lt "$n" ]; do
		if [ "${WG[$id][$i]["r"]}" = "$r" ] &&
		   [ "${WG[$id][$i]["tag"]}" = "$tag" ]; then
			ret "${WG[$id][$i]["c"]}"
			return 0
		fi
		i=$((i + 1))
	done
	ret "$2"
}

# Draw a checkbox: "[x] label" or "[ ] label".  tag is what dt_hit answers
# for a click on it -- the field the app will toggle, by default the label
# itself.
dt_check() {
	local id=$1 r=$2 c=$3 on=$4 label=$5 tag=${6:-$5} mark=" "

	[ "$on" = 1 ] && mark=x
	console put -p "w$id" "$r" "$c" "[$mark] $label"
	dt_wreg "$id" "$r" "$c" $((${#label} + 4)) "$tag"
}

# Draw a value that opens a list of choices: "value ▾", padded to w
# columns. tag is what dt_hit answers for a click on it.
dt_wdrop() {
	local id=$1 r=$2 c=$3 w=$4 value=$5 tag=${6:-$5} lb

	lb := str pad "$value" $((w - 2))
	console put -p "w$id" "$r" "$c" "$lb ▾"
	dt_wreg "$id" "$r" "$c" "$w" "$tag"
}

# Draw a single-line editable field: the text, padded or truncated to w,
# and -- while focused -- the character at the cursor shown inverted, the
# same convention a selected list row already uses. There is no dt_wreg
# here: a field's own tag is for dt_hit to say a click landed on it, which
# an app's _click uses to move the cursor there and give it focus, not to
# fire an action the way a checkbox or a dropdown's arrow does.
dt_textdraw() {
	local id=$1 r=$2 c=$3 w=$4 text=$5 cur=$6 focused=$7 shown t ch

	shown="$text"
	[ ${#shown} -gt "$w" ] && shown="${shown:0:$w}"
	console pen "$DT_INK" "$DT_FACE"
	t := str pad "$shown" "$w"
	console put -p "w$id" "$r" "$c" "$t"
	if [ "$focused" = 1 ] && [ "$cur" -lt "$w" ]; then
		ch=" "
		[ "$cur" -lt "${#shown}" ] && ch="${shown:$cur:1}"
		console pen "$DT_FACE" "$DT_INK" bold
		console put -p "w$id" "$r" $((c + cur)) "$ch"
	fi
}

# Apply one key to a text field's own (text, cursor) pair, returned as
# "text cursor" for the caller's own state to hold -- an app keeps a
# field in its own array, the same as dt_check and dt_wdrop never own the
# value they draw either. Status is 1 for a key this does not handle
# (enter, escape, tab...), so a caller's own _key still decides those for
# itself; text and cursor come back unchanged in that case.
dt_textkey() {
	local text=$1 cur=$2 key=$3

	case $key in
	left) [ "$cur" -gt 0 ] && cur=$((cur - 1)) ;;
	right) [ "$cur" -lt "${#text}" ] && cur=$((cur + 1)) ;;
	home) cur=0 ;;
	end) cur=${#text} ;;
	backspace)
		if [ "$cur" -gt 0 ]; then
			text="${text:0:$((cur - 1))}${text:$cur}"
			cur=$((cur - 1))
		fi
		;;
	delete)
		[ "$cur" -lt "${#text}" ] &&
			text="${text:0:$cur}${text:$((cur + 1))}"
		;;
	*)
		if [ ${#key} = 1 ]; then
			text="${text:0:$cur}$key${text:$cur}"
			cur=$((cur + 1))
		else
			ret "$text $cur"
			return 1
		fi
		;;
	esac
	ret "$text $cur"
}

# A vertical scrollbar: a track of │ over h rows starting at row0, one
# cell shown as the thumb █ at a position proportional to how far through
# total the view already is. shown is how many of total are visible at
# once; nothing is drawn when everything already is, the same as a
# checkbox or a dropdown draws nothing it was not asked for. The shape
# the file browser's own list view and a terminal's scrollback both need,
# so a fix or a restyle is one place, not two.
dt_scrollbar() {
	local id=$1 row0=$2 col=$3 h=$4 total=$5 shown=$6 pos=$7 thumb r

	[ "$total" -gt "$shown" ] || return 0
	thumb=$((row0 + pos * (h - 1) / (total - shown)))
	[ "$thumb" -ge $((row0 + h)) ] && thumb=$((row0 + h - 1))
	r=$row0
	while [ "$r" -lt $((row0 + h)) ]; do
		if [ "$r" = "$thumb" ]; then
			console pen "#63b3ed" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "█"
		else
			console pen "#2d3748" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "│"
		fi
		r=$((r + 1))
	done
}

# Open a popup list of choices anchored under a dt_wdrop -- built the next
# frame by dt_dropcontext, the same one-frame lag dt_context_open always
# has. cb is called as "cb id value" when one is chosen; nothing runs if
# the popup is dismissed instead. This is a context menu with nowhere on
# the desktop it belongs to, which is exactly what a dropdown is -- it
# reuses dt_context_open and the MB/MI menu machinery rather than a second
# popup system of its own.
DT_POPID=
DT_POPCB=
DT_POPVALS=()
dt_droplist() {
	local id=$1 r=$2 c=$3 cb=$4

	shift 4
	DT_POPID=$id
	DT_POPCB=$cb
	DT_POPVALS=("$@")
	# r and c come in pane-relative, the same coordinates an app draws and
	# is clicked in everywhere else, but dt_context_open positions on the
	# real screen -- add the window's own row and column to convert.
	dt_context_open widget "$id" $((DT[$id]["row"] + r + 1)) \
		$((DT[$id]["col"] + c))
}

# Build the popup opened by dt_droplist, one item per value offered.
dt_dropcontext() {
	local v

	dt_menu ""
	for v in "${DT_POPVALS[@]}"; do
		dt_item "$v" "" "$DT_POPCB" "$DT_POPID" "$v"
	done
}

# Right-click on the bare desktop.
DT_WALLGLYPHS=("·" "░" "▒" "⋅" "+")
dt_wallnext() {
	local i=0 g

	for g in "${DT_WALLGLYPHS[@]}"; do
		i=$((i + 1))
		[ "$g" = "$DT_GLYPH" ] && break
	done
	DT_GLYPH=${DT_WALLGLYPHS[$((i % ${#DT_WALLGLYPHS[@]}))]}
	dt_save
}
dt_deskcontext() {
	dt_menu "Desktop"
	dt_item "Arrange Icons" a dt_iconclean
	dt_item "Change Wallpaper" w dt_wallnext
}

# Right-click on empty menu-bar space: quick launchers, for the two apps
# that also have a keyboard shortcut of their own -- everything else stays
# reachable from the hibr menu only.
dt_barcontext() {
	dt_menu "Desktop"
	if dt_has term_draw; then
		dt_item "New Terminal" t dt_launch term
	else
		dt_dim "New Terminal"
	fi
	if dt_has tasks_draw; then
		dt_item "Task Manager" m dt_launch tasks
	else
		dt_dim "Task Manager"
	fi
}

# Right-click on a window's title bar: the Window menu's own items, since
# that is what a title bar is for, without reaching the menu bar first.
dt_titlecontext() {
	local id=$1

	dt_menu "Window"
	dt_item "Move" m dt_grab move
	if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" = 1 ]; then
		dt_dim "Resize"
		dt_dim "Zoom"
	else
		dt_item "Resize" r dt_grab size
		dt_item "Zoom" z dt_zoom "$id"
	fi
	dt_item "Hide" h dt_min "$id"
	dt_sep
	dt_item "Close" w dt_del "$id"
}

# Step into the submenu of the highlighted item, if it has one.
#
# A submenu opens level with the row that owns it, not with its parent's own
# top row -- dt_menu_draw's own r starts at 1 and gains exactly one per
# index drawn, separators included, so MB_SEL is already the row offset to
# add, no separate counting needed.
dt_mdown() {
	local sub

	[ "$MB_OPEN" = app ] && return 1
	sub=${MI[$MB_OPEN][$MB_SEL]["sub"]}
	[ -z "$sub" ] && return 1
	MB[$sub]["px"]=$((${MB[$MB_OPEN]["dx"]} + ${MB[$MB_OPEN]["dw"]} - 1))
	MB[$sub]["py"]=$((${MB[$MB_OPEN]["dy"]:-1} + MB_SEL))
	MB_PAR=$MB_OPEN
	MB_OPEN=$sub
	MB_SEL=0
	return 0
}

# Back out of a submenu to the one that owns it.
dt_mup() {
	local p=$MB_PAR i=0 n

	[ -z "$p" ] && return 1
	n=${MB[$p]["n"]}
	while [ "$i" -lt "$n" ]; do
		[ "${MI[$p][$i]["sub"]}" = "$MB_OPEN" ] && MB_SEL=$i
		i=$((i + 1))
	done
	MB_OPEN=$p
	MB_PAR=
	return 0
}

# Choose the highlighted item.
dt_mdo() {
	local m=$MB_OPEN i=$MB_SEL ids id n=0 cmd

	if [ "$m" != app ] && [ -n "${MI[$m][$i]["sub"]}" ]; then
		dt_mdown
		return 0
	fi
	dt_mclose
	if [ "$m" = app ]; then
		ids := dt_ids
		for id in $ids; do
			[ "$n" = "$i" ] && { dt_raise "$id"; return 0; }
			n=$((n + 1))
		done
		return 0
	fi
	[ "${MI[$m][$i]["sep"]}" = 1 ] && return 0
	[ "${MI[$m][$i]["dim"]}" = 1 ] && return 0
	cmd=${MI[$m][$i]["cmd"]}
	[ -n "$cmd" ] && $cmd
}

# Is a click inside the open menu?  Sets the highlight if it is.
dt_mpick() {
	local r=$1 c=$2 n x w dy rel

	n := dt_mrows
	if [ "$MB_OPEN" = app ]; then
		x=$((MB_AX - 4))
		w=18
		dy=1
	else
		x=${MB[$MB_OPEN]["dx"]:-${MB[$MB_OPEN]["x"]}}
		w=${MB[$MB_OPEN]["w"]}
		[ "$w" -lt 12 ] && w=12
		dy=${MB[$MB_OPEN]["dy"]:-1}
	fi
	rel=$((r - dy + 1))
	[ "$rel" -lt 1 ] || [ "$rel" -gt "$n" ] && return 1
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	[ "$c" -lt "$x" ] || [ "$c" -ge $((x + w)) ] && return 1
	[ "$MB_OPEN" != app ] &&
		[ "${MI[$MB_OPEN][$((rel - 1))]["sep"]}" = 1 ] && return 1
	MB_SEL=$((rel - 1))
	return 0
}

# Which menu title is under a column on the bar, if any.
#
# No `ret ""` on a miss: `ret` ends the function on the spot, the same as
# `return`, so a trailing `return 1` after one is dead code and the caller
# always sees status 0 -- `x := dt_mhit ... || ...` never took the miss
# branch, and a click on empty bar space opened whatever `x` was left
# holding from the last hit. `:=` clears the slot before the call, so a
# bare `return 1` alone already leaves it empty.
dt_mhit() {
	local c=$1 i=0 x w

	[ "$c" -ge "$MB_AX" ] && { ret app; return 0; }
	while [ "$i" -lt "$MB_N" ]; do
		x=${MB[$i]["x"]}
		w=${MB[$i]["tw"]}
		[ "$c" -ge "$x" ] && [ "$c" -lt $((x + w)) ] &&
			{ ret "$i"; return 0; }
		i=$((i + 1))
	done
	return 1
}

# Keys while the bar has the keyboard.  Returns 1 for a key it does not use.
dt_mkey() {
	local k=$1 n i=0 lb

	case $k in
	escape) dt_mup || dt_mclose; return 0 ;;
	left)
		dt_mup && return 0
		if [ "$MB_OPEN" = app ]; then
			dt_mopen $((MB_N - 1))
		elif [ "$MB_OPEN" -gt 0 ]; then
			dt_mopen $((MB_OPEN - 1))
		else
			dt_mopen app
		fi
		return 0
		;;
	right)
		dt_mdown && return 0
		if [ "$MB_OPEN" = app ]; then
			dt_mopen 0
		elif [ $((MB_OPEN + 1)) -lt "$MB_N" ]; then
			dt_mopen $((MB_OPEN + 1))
		else
			dt_mopen app
		fi
		return 0
		;;
	up) dt_mmove -1; return 0 ;;
	down) dt_mmove 1; return 0 ;;
	enter | " ") dt_mdo; return 0 ;;
	esac
	if [ "$MB_OPEN" != app ] && [ ${#k} = 1 ]; then
		n=${MB[$MB_OPEN]["n"]}
		while [ "$i" -lt "$n" ]; do
			[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] &&
				{ i=$((i + 1)); continue; }
			if [ -n "${MI[$MB_OPEN][$i]["key"]}" ] &&
			   [ "${MI[$MB_OPEN][$i]["key"]}" = "$k" ]; then
				MB_SEL=$i
				dt_mdo
				return 0
			fi
			i=$((i + 1))
		done
	fi
	return 1
}

# Take the arrows for moving or resizing the focused window, until enter or
# escape gives them back.  This is the keyboard's answer to dragging a title
# bar, and the only one there is: a desktop that can only be arranged with a
# mouse is a desktop half its users cannot arrange.
dt_grab() {
	[ -z "$DT_FOCUS" ] && return 1
	DT_GRAB=$1
	if [ "$1" = move ]; then
		dt_note "moving — arrows, then enter"
	else
		dt_note "resizing — arrows, then enter"
	fi
}

# One key while the arrows are taken.  Returns 1 for a key it does not want.
dt_gkey() {
	local id=$DT_FOCUS dr=0 dc=0

	case $1 in
	up) dr=-1 ;;
	down) dr=1 ;;
	left) dc=-1 ;;
	right) dc=1 ;;
	enter | escape | " ")
		DT_GRAB=
		DT_NOTE=
		return 0
		;;
	*) return 1 ;;
	esac
	if [ -z "$id" ]; then
		DT_GRAB=
		return 0
	fi
	if [ "$DT_GRAB" = move ]; then
		dt_move "$id" $((DT[$id]["row"] + dr)) \
			$((DT[$id]["col"] + dc))
	else
		dt_resize "$id" $((DT[$id]["h"] + dr)) \
			$((DT[$id]["w"] + dc))
	fi
	return 0
}

# A note in the middle of the screen, until the next key.
dt_note() {
	DT_NOTE="$1"
}

dt_note_draw() {
	local w r c t

	[ -z "$DT_NOTE" ] && return 0
	w=$((${#DT_NOTE} + 4))
	r=$((DT_ROWS / 2 - 1))
	c=$(((DT_COLS - w) / 2))
	console pen "$DT_INK" "$DT_FACE" bold
	t := dt_rep "$w" " "
	console put "$r" "$c" "$t"
	console put $((r + 1)) "$c" "  $DT_NOTE  "
	console put $((r + 2)) "$c" "$t"
}

# Ask before doing something that cannot be taken back by pressing the key
# again: y or enter runs cmd, anything else -- including a click, which
# cancels rather than reaching whatever it landed on -- forgets it. cmd is
# a single word, a function of no arguments, since the message can hold a
# space and a command built from stored, later-unquoted menu text cannot.
dt_confirm() {
	DT_NOTE=
	DT_CONFIRM="$1"
	DT_CONFIRM_CMD=$2
}

# A small window of its own, not just a coloured box: a border and a
# title bar, the same shapes dt_win draws, at an absolute position rather
# than a pane's, since this has no pane and takes no drag or resize.
# [y]es and [n]o are also clickable -- dt_confirm_hit tests a point against
# the same box this lays out, so the two can never drift apart.
DT_CONFIRM_HINT="[y]es        [n]o"

dt_confirm_geom() {
	local msg=$DT_CONFIRM w h y0 x0

	w=$((${#msg} + 6))
	[ "$w" -lt $((${#DT_CONFIRM_HINT} + 4)) ] && w=$((${#DT_CONFIRM_HINT} + 4))
	h=5
	y0=$((DT_ROWS / 2 - h / 2))
	x0=$(((DT_COLS - w) / 2))
	ret "$y0 $x0 $w $h"
}

# y, n, or empty for a point that is not on either word of the hint line.
dt_confirm_hit() {
	local mr=$1 mc=$2 g y0 x0 w h hr hx half

	[ -z "$DT_CONFIRM" ] && return 1
	g := dt_confirm_geom
	set -- $g
	y0=$1 x0=$2 w=$3 h=$4
	hr=$((y0 + 3))
	[ "$mr" != "$hr" ] && return 1
	hx=$((x0 + (w - ${#DT_CONFIRM_HINT}) / 2))
	[ "$mc" -lt "$hx" ] || [ "$mc" -ge $((hx + ${#DT_CONFIRM_HINT})) ] &&
		return 1
	half=$(( (${#DT_CONFIRM_HINT} + 1) / 2 ))
	if [ $((mc - hx)) -lt "$half" ]; then
		ret y
	else
		ret n
	fi
}

dt_confirm_draw() {
	local msg=$DT_CONFIRM w h y0 x0 bar r g

	[ -z "$msg" ] && return 0
	g := dt_confirm_geom
	set -- $g
	y0=$1 x0=$2 w=$3 h=$4
	console pen "$DT_INK" "$DT_FACE"
	console fill "$y0" "$x0" "$h" "$w" " "
	bar := dt_rep $((w - 2)) "─"
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	console put "$y0" "$x0" "┌$bar┐"
	console put $((y0 + h - 1)) "$x0" "└$bar┘"
	console pen "$DT_INK" "$DT_FACE"
	r=$((y0 + 1))
	while [ "$r" -lt $((y0 + h - 1)) ]; do
		console put "$r" "$x0" "│"
		console put "$r" $((x0 + w - 1)) "│"
		r=$((r + 1))
	done
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	console put "$y0" $((x0 + 2)) "┤ Confirm ├"
	console pen "$DT_INK" "$DT_FACE" bold
	console put $((y0 + 2)) $((x0 + (w - ${#msg}) / 2)) "$msg"
	console pen "$DT_IDLE" "$DT_FACE"
	console put $((y0 + 3)) $((x0 + (w - ${#DT_CONFIRM_HINT}) / 2)) \
		"$DT_CONFIRM_HINT"
}

dt_confirm_key() {
	local cmd=$DT_CONFIRM_CMD

	DT_CONFIRM=
	DT_CONFIRM_CMD=
	case $1 in
	y | Y | enter)
		# cmd may end the loop (dt_quit) with no redraw of its own after
		# it, same as every other quit path -- draw once here, box
		# already cleared above, so that is what a pty test's last
		# frame shows rather than the box still up.
		dt_draw
		$cmd
		;;
	esac
	return 0
}

# The bare key asks first: q used to end the desktop on the spot, and one
# key too many landed on it more than once. Quit on the hibr menu does not
# go through this -- reaching it is already two keys (f10, then q), so
# asking a third time is the annoyance this exists to remove, not add back.
dt_quitconfirm() {
	dt_confirm "Quit hibr?" dt_quit
}

# Start capturing the next key as action's own shortcut -- Settings calls
# this when a shortcut row is activated; dt_event's own DT_KEYCAP check
# takes the very next key, of any kind, rather than dispatching it.
dt_keycap() {
	DT_KEYCAP=$1
	case $1 in
	app:*) dt_note "Press a key for ${DT_APPS[${1#app:}]["title"]}…" ;;
	*) dt_note "Press a key for ${1^}…" ;;
	esac
}

# --- the control strip ---------------------------------------------------
#
# One line of quick-toggle modules, each in its own brackets, drawn
# straight over everything else the same fixed-position way the bar and
# the confirm box already are -- not a DT[] window: it has no title,
# cannot be resized the way a window is, and must never take the keyboard
# focus a window has. Not authentic to any one System version on purpose:
# the real Control Strip sat at the bottom and only ever slid left and
# right along it; this one docks to either side and slides up and down
# instead, a deliberate choice over period accuracy.
CS_MODDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/control-strip")
declare -gA CS_MODS
CS_MOD_LIST=()
declare -gA CS_SRC

CS_SIDE="${CS_SIDE-left}"
CS_Y="${CS_Y-}"
CS_COLLAPSED="${CS_COLLAPSED-0}"
CS_LEN="${CS_LEN-}"
CS_SCROLL="${CS_SCROLL-0}"

# The strip's own shadow -- a separate setting from DT_SHADOW, the same
# reasoning as DT_MSHADOW: the strip is drawn every frame it is on screen,
# not just when a window moves, so someone who wants window shadows without
# paying for this one every frame should be able to say so.
CS_SHADOW="${CS_SHADOW-1}"
CS_ATTN=0
CS_DRAG=
CS_DRAGKIND=
CS_PRESSR=0
CS_PRESSC=0

# Register a strip module: name, the title it draws in its own brackets
# (also what a tooltip would say, once there is one), and how many columns
# its content needs there -- the title's own length by default, since the
# title is what is drawn unless a module wants something narrower.
# name_draw row col draws that content, starting at col; name_click row col
# is called the same way, for a click anywhere in it. Neither takes an id
# -- there is never more than one instance of a strip module, unlike a
# window.
cs_module() {
	CS_MODS[$1]["title"]="$2"
	CS_MODS[$1]["w"]="${3:-${#2}}"
	CS_MOD_LIST+=("$1")
}

# Load every module in the folders. Flat, not recursive, the same as
# Control Panel's own panes -- a module is not an app.
cs_modules() {
	local d f b

	for d in "${CS_MODDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			[ -n "${CS_SRC["$b"]}" ] && continue
			CS_SRC["$b"]=$f
			. "$f"
		done
	done
}

# The row the strip sits on -- computed once, the first time it is needed,
# so "80% down" means 80% of the real screen rather than of the 24-row
# default DT_ROWS still holds when this file is only just being sourced.
cs_y() {
	[ -z "$CS_Y" ] && CS_Y=$((DT_ROWS * 8 / 10))
	ret "$CS_Y"
}

# Pulled onto the screen the same way an icon's own saved spot is: a
# preference, not a promise, clamped every time dt_size runs (on open and
# on every resize) rather than baked into the saved value -- so a strip
# dragged near the bottom of a tall screen is still reachable after a
# resize to a shorter one, and lands back where it was if the screen grows
# again. A never-set CS_Y is left alone; cs_y's own default already
# accounts for whatever DT_ROWS turns out to be.
cs_clamp() {
	[ -z "$CS_Y" ] && return 0
	[ "$CS_Y" -lt 1 ] && CS_Y=1
	[ "$CS_Y" -ge "$DT_ROWS" ] && CS_Y=$((DT_ROWS - 1))
}

# How many modules are actually shown -- every one of them, unless the
# strip has been dragged shorter than that, or scrolling has moved some
# off either end.
cs_count() {
	local total=${#CS_MOD_LIST[@]}
	local n=${CS_LEN:-$total}

	[ "$n" -gt "$total" ] && n=$total
	[ $((CS_SCROLL + n)) -gt "$total" ] && n=$((total - CS_SCROLL))
	ret "$n"
}

# The whole row's width, brackets and the arrow both included -- of the
# modules actually shown, not every registered one.
cs_width() {
	local n=0 i cnt m

	cnt := cs_count
	i=$CS_SCROLL
	while [ "$i" -lt $((CS_SCROLL + cnt)) ]; do
		m=${CS_MOD_LIST[$i]}
		n=$((n + ${CS_MODS[$m]["w"]:-1} + 2))
		i=$((i + 1))
	done
	ret $((n + 1))
}

# The column shown-module i's own content starts at -- one past its own
# opening bracket, and past the arrow too on the side that leads with it.
cs_modcol() {
	local w cnt i c m

	w := cs_width
	cnt := cs_count
	if [ "$CS_SIDE" = left ]; then
		c=1
	else
		c=$((DT_COLS - w + 2))
	fi
	i=$CS_SCROLL
	while [ "$i" -lt $((CS_SCROLL + cnt)) ]; do
		[ "$i" = "$1" ] && { ret "$c"; return 0; }
		m=${CS_MOD_LIST[$i]}
		c=$((c + ${CS_MODS[$m]["w"]:-1} + 2))
		i=$((i + 1))
	done
	ret -1
}

# Which shown module a column belongs to, if any -- ret's its real index
# into CS_MOD_LIST, not a position among the ones currently shown.
cs_at() {
	local w cnt i c m mw

	w := cs_width
	cnt := cs_count
	if [ "$CS_SIDE" = left ]; then
		c=1
	else
		c=$((DT_COLS - w + 2))
	fi
	i=$CS_SCROLL
	while [ "$i" -lt $((CS_SCROLL + cnt)) ]; do
		m=${CS_MOD_LIST[$i]}
		mw=${CS_MODS[$m]["w"]:-1}
		if [ "$1" -ge "$c" ] && [ "$1" -lt $((c + mw)) ]; then
			ret "$i"
			return 0
		fi
		c=$((c + mw + 2))
		i=$((i + 1))
	done
	return 1
}

# Whether row/col falls on the strip right now -- expanded or its own
# collapsed tab. What hover, wheel and a press all three ask, instead of
# three copies of the same rectangle.
cs_hit() {
	local row w col

	[ "${#CS_MOD_LIST[@]}" = 0 ] && return 1
	[ -z "$1" ] && return 1
	row := cs_y
	[ "$1" != "$row" ] && return 1
	if [ "$CS_COLLAPSED" = 1 ]; then
		if [ "$CS_SIDE" = left ]; then
			[ "$2" = 0 ]
		else
			[ "$2" = $((DT_COLS - 1)) ]
		fi
		return $?
	fi
	w := cs_width
	[ "$CS_SIDE" = left ] && col=0 || col=$((DT_COLS - w))
	[ "$2" -ge "$col" ] && [ "$2" -lt $((col + w)) ]
}

# Scroll by dir modules, clamped so the shown window never runs past
# either end of the registered list.
cs_scroll() {
	local total=${#CS_MOD_LIST[@]} cnt

	cnt := cs_count
	CS_SCROLL=$((CS_SCROLL + $1))
	[ "$CS_SCROLL" -lt 0 ] && CS_SCROLL=0
	[ $((CS_SCROLL + cnt)) -gt "$total" ] && CS_SCROLL=$((total - cnt))
	[ "$CS_SCROLL" -lt 0 ] && CS_SCROLL=0
	return 0
}

# Live-resize from the arrow's own drag: how many modules fit between the
# strip's fixed anchor edge and the pointer's current column, computed
# fresh from that position every time rather than accumulated one drag
# event at a time, the same reason a real resize handle tracks the
# pointer instead of its own last delta.
cs_resize() {
	local budget total i m w used=0 cnt=0

	total=${#CS_MOD_LIST[@]}
	if [ "$CS_SIDE" = left ]; then
		budget=$1
	else
		budget=$((DT_COLS - 1 - $1))
	fi
	[ "$budget" -lt 0 ] && budget=0
	i=$CS_SCROLL
	while [ "$i" -lt "$total" ]; do
		m=${CS_MOD_LIST[$i]}
		w=$((${CS_MODS[$m]["w"]:-1} + 2))
		[ $((used + w)) -gt "$budget" ] && break
		used=$((used + w))
		cnt=$((cnt + 1))
		i=$((i + 1))
	done
	[ "$cnt" -lt 1 ] && cnt=1
	if [ "$cnt" -ge $((total - CS_SCROLL)) ]; then
		CS_LEN=
	else
		CS_LEN=$cnt
	fi
}

dt_stripdraw() {
	local row w col i cnt m mw c

	[ "${#CS_MOD_LIST[@]}" = 0 ] && return 0
	row := cs_y
	if [ "$CS_COLLAPSED" = 1 ]; then
		console pen "$DT_ACTIVE" "$DT_FACE" bold
		if [ "$CS_SIDE" = left ]; then
			console put "$row" 0 "▸"
		else
			console put "$row" $((DT_COLS - 1)) "◂"
		fi
		return 0
	fi
	cnt := cs_count
	w := cs_width
	[ "$CS_SIDE" = left ] && col=0 || col=$((DT_COLS - w))
	[ "$CS_SHADOW" = 1 ] &&
		console darken $((row + 1)) $((col + 2)) 1 "$w" "$DT_SHADOW_PCT"
	console pen "$DT_INK" "$DT_FACE"
	console fill "$row" "$col" 1 "$w" " "
	c=$col
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	if [ "$CS_SIDE" = right ]; then
		console put "$row" "$c" "◂"
		c=$((c + 1))
	fi
	i=$CS_SCROLL
	while [ "$i" -lt $((CS_SCROLL + cnt)) ]; do
		m=${CS_MOD_LIST[$i]}
		mw=${CS_MODS[$m]["w"]:-1}
		console pen "$DT_IDLE" "$DT_FACE"
		console put "$row" "$c" "["
		console put "$row" $((c + mw + 1)) "]"
		dt_has "${m}_draw" && "${m}_draw" "$row" $((c + 1))
		c=$((c + mw + 2))
		i=$((i + 1))
	done
	[ "$CS_SIDE" = left ] && { console pen "$DT_ACTIVE" "$DT_FACE" bold
		console put "$row" "$c" "▸"; }
}

# A press on the strip's own row: the arrow starts a drag -- vertical
# movement repositions it, horizontal resizes it, decided once the first
# real movement shows which, and if it turns out not to have moved at all
# by release, toggles collapsed instead. A click inside a module's own
# brackets goes to its _click. return 0 alone means handled, so
# dt_mouse's press case can tell it from a miss with ||.
cs_press() {
	local row w col arrowcol

	cs_hit "$1" "$2" || return 1
	row=$1
	if [ "$CS_COLLAPSED" = 1 ]; then
		CS_DRAG=1
		CS_DRAGKIND=
		CS_PRESSR=$1
		CS_PRESSC=$2
		return 0
	fi
	w := cs_width
	[ "$CS_SIDE" = left ] && col=0 || col=$((DT_COLS - w))
	[ "$CS_SIDE" = left ] && arrowcol=$((col + w - 1)) || arrowcol=$col
	if [ "$2" = "$arrowcol" ]; then
		CS_DRAG=1
		CS_DRAGKIND=
		CS_PRESSR=$1
		CS_PRESSC=$2
		return 0
	fi
	local i m mc
	i := cs_at "$2" || return 0
	m=${CS_MOD_LIST[$i]}
	mc := cs_modcol "$i"
	dt_has "${m}_click" && "${m}_click" "$row" "$mc"
	return 0
}

# Open a dropdown of choices for a strip module, below its own row if that
# fits on the screen, above it otherwise -- the strip has no window to
# translate a widget's own row/col through the way dt_droplist does for a
# Control Panel pane, so it reaches dt_context_open's absolute coordinates
# directly. Reuses the same widget/dt_dropcontext machinery, and the same
# "" DT_POPID a window-less caller already gets away with there, since an
# empty argument vanishes under unquoted word splitting rather than
# reaching the callback at all.
cs_dropopen() {
	local r=$1 c=$2 cb=$3 n

	shift 3
	n=$#
	if [ $((r + n + 1)) -gt "$DT_ROWS" ]; then
		r=$((r - n))
		[ "$r" -lt 1 ] && r=1
	else
		r=$((r + 1))
	fi
	DT_POPID=
	DT_POPCB=$cb
	DT_POPVALS=("$@")
	dt_context_open widget "" "$r" "$c"
}
