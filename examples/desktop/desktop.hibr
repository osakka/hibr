#!/usr/bin/env hibr
#
# desktop -- a window manager, written in hibr.
#
# This is the middle of the three layers in docs/adr/0020: the console module
# is the display server, this is the window manager, and the file you write
# yourself is the session.  Source this, call dt_open, make some windows and
# call dt_run:
#
#     . desktop.hibr
#     dt_open
#     dt_new "A window" 10 40 4 8
#     dt_run
#
# Nothing here is C.  Everything below draws with `console put` and reads
# `console key`, and it redraws every window from the bottom of the stack
# upwards every frame, because the console only sends the cells that changed.

need display || { echo "desktop: no display available" >&2; exit 1; }

# The desktop's own version, independent of HIBR_VERSION (include/hibr.h's
# HIBR_VER): the window manager, its apps and Control Panel change on
# their own schedule, much faster than the shell underneath them, and
# tying the two together would mean bumping the core's own version for a
# change that never touched a single line of src/*.c. HIBR_ABI is what
# actually needs cross-checking between the two -- whether a module is
# built against what this shell offers -- and that already exists.
DT_VER=0.45

# Where the rest of the window manager is: beside this file, wherever it was
# installed or copied to. BASH_SOURCE is this file's own path while it is
# being sourced, however the session reached it. A shell older than 0.43
# has no BASH_SOURCE, and would otherwise look for every part in the
# current directory and report each one missing.
if [ -z "$BASH_SOURCE" ]; then
	echo "desktop: needs hibr 0.43 or later (this is ${HIBR_VERSION:-older})" >&2
	return 1 2> /dev/null || exit 1
fi

strict

DT_HERE=${BASH_SOURCE%/*}
[ "$DT_HERE" = "$BASH_SOURCE" ] && DT_HERE=.

# The window manager, one concern to a file. Nothing in them runs a desktop
# function while loading, so the order is for reading: the state everything
# shares first, then what is built on it.
for dt_part in state settings session windows frame draw \
	wallpaper input keys menus bar context apps \
	files handlers icons hold notify confirm strip; do
	. "$DT_HERE/wm/$dt_part.hibr"
done

# The widgets apps draw with: a library, every file in widgets/ -- see
# widgets/README.md for what makes a file belong there.
for dt_part in "$DT_HERE"/widgets/*.hibr; do
	. "$dt_part"
done
unset dt_part
