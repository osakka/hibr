#!/usr/bin/env hibr
#
# lib/pim -- what Contacts, Calendar and Mail share about the servers that
# keep calendars and address books: which are chosen, where each one's copy
# lives, and the background jobs that keep it -- lib/pimsync.hibr run for a
# server now and then, and anything else that should not wait in the loop
# (an invitation being mailed). Sourced by the apps that need it, once,
# however many do; it is not an app.
#
# Syncing is the desktop's, not a window's: a ticker after every frame
# hands finished jobs on and syncs each chosen server every DT_PIMEVERY
# minutes, whether or not a Contacts or Calendar window is open -- so a
# reminder is read from a fresh copy and Mail finishes addresses from one.
# An app that wants to know a sync has finished registers with pe_onsync;
# one that only wants to know whether to read again compares PE_GEN.

strict

PE_LIBDONE=1
PE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hibr/pim"
PE_LIB=${BASH_SOURCE%/*}
DT_PIMSERVERS="${DT_PIMSERVERS-}"
DT_PIMEVERY="${DT_PIMEVERY-15}"
command -v dt_keep > /dev/null && dt_keep DT_PIMSERVERS DT_PIMEVERY

declare -gA PEJ
declare -gA PES
PEJ_N=0
PEJ_LIVE=0
PE_GEN=0
PE_SRVS=()
PE_HOOKS=()

command -v dt_ticker > /dev/null && dt_ticker pe_tick

# The servers chosen for calendars and contacts, into PE_SRVS -- kept
# tab-separated, since a server's name may have a space in it.
pe_servers() {
	PE_SRVS=()
	[ -n "$DT_PIMSERVERS" ] || return 1
	IFS=$'\t' read -ra PE_SRVS <<< "$DT_PIMSERVERS"
	[ "${#PE_SRVS[@]}" -gt 0 ]
}

# A server's store folder.
fn pe_dir(srv) { ret "$PE_DIR/${srv//\//_}"; }

# Be told, by name, each time a sync finishes: the function is called with
# the server.
fn pe_onsync(name) {
	case " ${PE_HOOKS[*]} " in *" $name "*) return 0 ;; esac
	PE_HOOKS+=("$name")
}

# Run something in the background for a server, its output kept for poll
# to hand on, then the callback. The job's number is the result.
fn pe_job(what, srv, then, ...rest) {
	local n d

	d := pe_dir "$srv"
	mkdir -p "$d/jobs" 2> /dev/null
	PEJ_N=$((PEJ_N + 1))
	n=$PEJ_N
	PEJ[$n]["what"]=$what
	PEJ[$n]["srv"]=$srv
	PEJ[$n]["then"]=$then
	PEJ[$n]["dir"]=$d/jobs
	(
		"${rest[@]}" > "$d/jobs/$n.out" 2> "$d/jobs/$n.err"
		printf '%s\n' "$?" > "$d/jobs/$n.st"
	) &
	PEJ[$n]["pid"]=$!
	PEJ_LIVE=$((PEJ_LIVE + 1))
	dt_want 300
	ret "$n"
}

# A job's last line so far.
fn pe_joblast(int n) {
	local f=${PEJ[$n]["dir"]}/$n.out l= x

	[ -s "$f" ] || { ret ""; return 0; }
	while IFS= read -r x; do l=$x; done < "$f"
	ret "$l"
}

# Hand each finished job to its callback, marked done first so the callback
# can start the next.
pe_poll() {
	local n st d

	[ "$PEJ_LIVE" -gt 0 ] || return 0
	for n in "${!PEJ[@]}"; do
		d=${PEJ[$n]["dir"]}
		[ -s "$d/$n.st" ] || continue
		read -r st < "$d/$n.st"
		PEJ_LIVE=$((PEJ_LIVE - 1))
		PEJ[$n]["done"]=1
		"${PEJ[$n]["then"]}" "$n" "$st"
		command rm -f "$d/$n.out" "$d/$n.err" "$d/$n.st"
		unset PEJ["$n"]
	done
	[ "$PEJ_LIVE" -gt 0 ] && dt_want 500
	return 0
}

# Whether a sync is running for a server -- a sync, not any other job.
fn pe_running(srv) {
	local n

	for n in "${!PEJ[@]}"; do
		[ -z "${PEJ[$n]["done"]}" ] && [ "${PEJ[$n]["what"]}" = sync ] && [ "${PEJ[$n]["srv"]}" = "$srv" ] &&
			{ ret "$n"; return 0; }
	done
	return 1
}

# Sync a server, or every one chosen; one already running is asked again.
fn pe_sync(srv = "") {
	local s d n
	local -a list

	if [ -n "$srv" ]; then
		list=("$srv")
	else
		pe_servers || return 0
		list=("${PE_SRVS[@]}")
	fi
	for s in "${list[@]}"; do
		if n := pe_running "$s"; then
			PES["again$s"]=1
			continue
		fi
		d := pe_dir "$s"
		mkdir -p "$d"
		n := pe_job sync "$s" pe_synced "$HIBR" "$PE_LIB/pimsync.hibr" "$s" "$d"
		PES["last$s"]=$EPOCHSECONDS
	done
	return 0
}

# A sync finished: what it said kept for the apps' status bars, the
# generation moved on, whoever asked told.
fn pe_synced(int n, int st) {
	local s=${PEJ[$n]["srv"]} l f

	l := pe_joblast "$n"
	case $l in
	"done 0") PES["status$s"]="Up to date" ;;
	done*) PES["status$s"]="${l#done } new" ;;
	busy) PES["status$s"]="Another sync is running" ;;
	error*) PES["status$s"]="Could not sync: ${l#error }" ;;
	*)
		if [ "$st" != 0 ]; then
			l=
			[ -s "${PEJ[$n]["dir"]}/$n.err" ] && read -r l < "${PEJ[$n]["dir"]}/$n.err"
			PES["status$s"]="Could not sync${l:+: ${l#hibr: }}"
		fi
		;;
	esac
	PE_GEN=$((PE_GEN + 1))
	for f in "${PE_HOOKS[@]}"; do
		"$f" "$s"
	done
	if [ "${PES["again$s"]}" = 1 ]; then
		PES["again$s"]=
		pe_sync "$s"
	fi
}

# What a server's sync last said, or nothing.
fn pe_status(srv) { ret "${PES["status$srv"]}"; }

# After every frame: finished jobs handed on, and each chosen server synced
# when DT_PIMEVERY minutes have passed since it last was -- asking for the
# frame the next one is due in, so an idle desktop sleeps until then.
pe_tick() {
	local s due next=0

	pe_poll
	pe_servers || return 0
	for s in "${PE_SRVS[@]}"; do
		due=$((${PES["last$s"]:-0} + DT_PIMEVERY * 60))
		if [ "$EPOCHSECONDS" -ge "$due" ]; then
			pe_sync "$s"
			due=$((EPOCHSECONDS + DT_PIMEVERY * 60))
		fi
		[ "$next" = 0 ] || [ "$due" -lt "$next" ] && next=$due
	done
	[ "$next" -gt 0 ] && dt_want $(((next - EPOCHSECONDS) * 1000 + 50))
	return 0
}
