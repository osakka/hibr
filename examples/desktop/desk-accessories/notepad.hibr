#!/usr/bin/env hibr
#
# notepad -- one plain-text scratch note, kept in a window of its own and
# written to disk the moment it changes, the same "no Save to forget"
# rule Control Panel's own settings already follow.
#
# Deliberately small: one page, no word wrap, no search -- hvi is the real
# editor. This is the System 6 Note Pad, a place to jot something down
# without leaving the desktop for it. Text is selected with shift and the
# arrows, home and end, or by dragging; the desktop's Cut, Copy and Paste
# work on it, so what is copied in a terminal pastes here and back.

strict

app notepad "A scratch note, saved as you type"

command -v dt_app > /dev/null && dt_app notepad "Note Pad" 12 40 once "▧"

declare -gA NP
NP_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hibr/notepad.txt"

# Read the note off disk into this window's own lines -- always at least
# one, even an empty one, so the cursor always has a line to sit on.
fn np_load(int id) {
	local line n=0

	if [ -r "$NP_FILE" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			NP[$id][$n]="$line"
			n=$((n + 1))
		done < "$NP_FILE"
	fi
	[ "$n" = 0 ] && { NP[$id][0]=""; n=1; }
	NP[$id]["n"]=$n
	NP[$id]["cr"]=0
	NP[$id]["cc"]=0
	NP[$id]["top"]=0
	NP[$id]["sel"]=
}

# The selection in order, start before end, into NP_SR NP_SC NP_ER NP_EC;
# fails when there is none, or it is empty.
NP_SR=0
NP_SC=0
NP_ER=0
NP_EC=0
fn np_order(int id) {
	local ar ac cr=${NP[$id]["cr"]} cc=${NP[$id]["cc"]}

	[ "${NP[$id]["sel"]}" = 1 ] || return 1
	ar=${NP[$id]["ar"]}
	ac=${NP[$id]["ac"]}
	if [ "$ar" -lt "$cr" ] || { [ "$ar" = "$cr" ] && [ "$ac" -le "$cc" ]; }; then
		NP_SR=$ar NP_SC=$ac NP_ER=$cr NP_EC=$cc
	else
		NP_SR=$cr NP_SC=$cc NP_ER=$ar NP_EC=$ac
	fi
	[ "$NP_SR" != "$NP_ER" ] || [ "$NP_SC" != "$NP_EC" ]
}

# The selected text, its lines joined by newlines.
fn np_seltext(int id) {
	local i out

	np_order "$id" || return 1
	if [ "$NP_SR" = "$NP_ER" ]; then
		out=${NP[$id][$NP_SR]:$NP_SC:$((NP_EC - NP_SC))}
	else
		out=${NP[$id][$NP_SR]:$NP_SC}
		i=$((NP_SR + 1))
		while [ "$i" -lt "$NP_ER" ]; do
			out="$out"$'\n'"${NP[$id][$i]}"
			i=$((i + 1))
		done
		out="$out"$'\n'"${NP[$id][$NP_ER]:0:$NP_EC}"
	fi
	ret "$out"
}

# Remove the selection, leaving the cursor where it began; nothing to do
# without one.
fn np_delsel(int id) {
	local n

	np_order "$id" || { NP[$id]["sel"]=; return 0; }
	NP[$id][$NP_SR]="${NP[$id][$NP_SR]:0:$NP_SC}${NP[$id][$NP_ER]:$NP_EC}"
	while [ "$NP_ER" -gt "$NP_SR" ]; do
		np_delline "$id" $((NP_SR + 1))
		n=${NP[$id]["n"]}
		NP[$id]["n"]=$((n - 1))
		NP_ER=$((NP_ER - 1))
	done
	NP[$id]["cr"]=$NP_SR
	NP[$id]["cc"]=$NP_SC
	NP[$id]["sel"]=
}

# Put text in at the cursor, newlines and all, leaving the cursor after it.
fn np_insert(int id, text) {
	local cr=${NP[$id]["cr"]} cc=${NP[$id]["cc"]} line after part first=1

	line=${NP[$id][$cr]}
	after=${line:$cc}
	NP[$id][$cr]=${line:0:$cc}
	while :; do
		part=${text%%$'\n'*}
		if [ "$first" = 1 ]; then
			NP[$id][$cr]="${NP[$id][$cr]}$part"
			first=0
		else
			cr=$((cr + 1))
			np_insline "$id" "$cr" "$part"
			NP[$id]["n"]=$((${NP[$id]["n"]} + 1))
		fi
		[ "$part" = "$text" ] && break
		text=${text#*$'\n'}
	done
	NP[$id]["cr"]=$cr
	NP[$id]["cc"]=${#NP[$id][$cr]}
	NP[$id][$cr]="${NP[$id][$cr]}$after"
}

fn notepad_copy(int id) {
	local t

	t := np_seltext "$id" || return 1
	ret "$t"
}

fn notepad_cut(int id) {
	local t

	t := np_seltext "$id" || return 1
	np_delsel "$id"
	np_save "$id"
	ret "$t"
}

fn notepad_paste(int id, text, op = "") {
	np_delsel "$id"
	np_insert "$id" "$text"
	np_save "$id"
}

# Written whole, to a temporary file first, the same atomic rename dt_save
# already uses for the desktop's own settings.
fn np_save(int id) {
	local i=0 n=${NP[$id]["n"]} tmp="$NP_FILE.$$"

	mkdir -p "${NP_FILE%/*}" 2> /dev/null || return 1
	{
		while [ "$i" -lt "$n" ]; do
			printf '%s\n' "${NP[$id][$i]}"
			i=$((i + 1))
		done
	} > "$tmp" && mv -f "$tmp" "$NP_FILE"
}

fn notepad_open(int id, arg) {
	np_load "$id"
}

fn notepad_draw(int id, int h, int w, int row, int col) {
	local n=${NP[$id]["n"]} cr=${NP[$id]["cr"]} cc=${NP[$id]["cc"]}
	local top=${NP[$id]["top"]} i r line hoff shown

	[ "$cr" -lt "$top" ] && top=$cr
	[ "$cr" -ge $((top + h)) ] && top=$((cr - h + 1))
	[ "$top" -lt 0 ] && top=0
	NP[$id]["top"]=$top

	# The cursor's own line scrolls sideways to keep the cursor on screen;
	# every other line just starts at its own left margin. Kept, not just
	# local, so a click on this same row knows what column it is really
	# looking at.
	hoff=0
	[ "$cc" -ge "$w" ] && hoff=$((cc - w + 1))
	NP[$id]["hoff"]=$hoff

	console pen "$DT_INK" "$DT_FACE"
	r=1
	i=$top
	while [ "$r" -le "$h" ]; do
		line=""
		[ "$i" -lt "$n" ] && line="${NP[$id][$i]}"
		if [ "$i" = "$cr" ]; then
			shown="${line:$hoff}"
		else
			shown="$line"
		fi
		shown := str pad "${shown:0:$w}" "$w"
		console put -p "w$id" "$r" 1 "$shown"
		r=$((r + 1))
		i=$((i + 1))
	done
	if np_order "$id"; then
		np_drawsel "$id" "$h" "$w"
		console pen "$DT_INK" "$DT_FACE"
	fi
	console pen "#1a202c" "#63b3ed"
	console put -p "w$id" $((cr - top + 1)) $((cc - hoff + 1)) \
		"${NP[$id][$cr]:$cc:1}"
	[ -z "${NP[$id][$cr]:$cc:1}" ] &&
		console put -p "w$id" $((cr - top + 1)) $((cc - hoff + 1)) " "
}

# Draw the selected part of each line on screen over the plain text.
fn np_drawsel(int id, int h, int w) {
	local i=$NP_SR a b off line top=${NP[$id]["top"]}

	console pen "#1a202c" "$DT_ACTIVE"
	while [ "$i" -le "$NP_ER" ]; do
		if [ "$i" -ge "$top" ] && [ "$i" -lt $((top + h)) ]; then
			line=${NP[$id][$i]}
			a=0
			b=${#line}
			[ "$i" = "$NP_SR" ] && a=$NP_SC
			[ "$i" = "$NP_ER" ] && b=$NP_EC
			off=0
			[ "$i" = "${NP[$id]["cr"]}" ] && off=${NP[$id]["hoff"]}
			[ $((a - off)) -lt 0 ] && a=$off
			[ $((b - off)) -gt "$w" ] && b=$((off + w))
			[ "$b" -gt "$a" ] &&
				console put -p "w$id" $((i - top + 1)) $((a - off + 1)) \
					"${line:$a:$((b - a))}"
		fi
		i=$((i + 1))
	done
}

fn notepad_key(int id, key) {
	local n=${NP[$id]["n"]} cr=${NP[$id]["cr"]} cc=${NP[$id]["cc"]}
	local line=${NP[$id][$cr]} rest

	case $key in
	shift-up | shift-down | shift-left | shift-right | shift-home | shift-end)
		if [ "${NP[$id]["sel"]}" != 1 ]; then
			NP[$id]["sel"]=1
			NP[$id]["ar"]=$cr
			NP[$id]["ac"]=$cc
		fi
		key=${key#shift-}
		;;
	up | down | left | right | home | end) NP[$id]["sel"]= ;;
	backspace)
		if np_order "$id"; then
			np_delsel "$id"
			np_save "$id"
			return 0
		fi
		NP[$id]["sel"]=
		;;
	*)
		if [ "$key" = enter ] || [ "${#key}" = 1 ]; then
			np_delsel "$id"
			n=${NP[$id]["n"]}
			cr=${NP[$id]["cr"]}
			cc=${NP[$id]["cc"]}
			line=${NP[$id][$cr]}
		fi
		;;
	esac
	case $key in
	up)
		[ "$cr" -gt 0 ] && cr=$((cr - 1))
		[ "$cc" -gt "${#NP[$id][$cr]}" ] && cc=${#NP[$id][$cr]}
		;;
	down)
		[ "$cr" -lt $((n - 1)) ] && cr=$((cr + 1))
		[ "$cc" -gt "${#NP[$id][$cr]}" ] && cc=${#NP[$id][$cr]}
		;;
	left)
		if [ "$cc" -gt 0 ]; then
			cc=$((cc - 1))
		elif [ "$cr" -gt 0 ]; then
			cr=$((cr - 1))
			cc=${#NP[$id][$cr]}
		fi
		;;
	right)
		if [ "$cc" -lt "${#line}" ]; then
			cc=$((cc + 1))
		elif [ "$cr" -lt $((n - 1)) ]; then
			cr=$((cr + 1))
			cc=0
		fi
		;;
	home) cc=0 ;;
	end) cc=${#line} ;;
	backspace)
		if [ "$cc" -gt 0 ]; then
			NP[$id][$cr]="${line:0:$((cc - 1))}${line:$cc}"
			cc=$((cc - 1))
		elif [ "$cr" -gt 0 ]; then
			cc=${#NP[$id][$((cr - 1))]}
			NP[$id][$((cr - 1))]="${NP[$id][$((cr - 1))]}$line"
			np_delline "$id" "$cr"
			n=$((n - 1))
			cr=$((cr - 1))
		fi
		;;
	enter)
		rest=${line:$cc}
		NP[$id][$cr]="${line:0:$cc}"
		np_insline "$id" $((cr + 1)) "$rest"
		n=$((n + 1))
		cr=$((cr + 1))
		cc=0
		;;
	*)
		[ "${#key}" = 1 ] || return 1
		NP[$id][$cr]="${line:0:$cc}$key${line:$cc}"
		cc=$((cc + 1))
		;;
	esac
	NP[$id]["cr"]=$cr
	NP[$id]["cc"]=$cc
	NP[$id]["n"]=$n
	np_save "$id"
}

# Insert a new line at i, moving every line from there down one.
fn np_insline(int id, int i, text) {
	local j=${NP[$id]["n"]}

	while [ "$j" -gt "$i" ]; do
		NP[$id][$j]=${NP[$id][$((j - 1))]}
		j=$((j - 1))
	done
	NP[$id][$i]=$text
}

# Remove line i, moving every line after it up one.
fn np_delline(int? id = "", int? i = "") {
	local j=$i n=${NP[$id]["n"]}

	while [ "$j" -lt $((n - 1)) ]; do
		NP[$id][$j]=${NP[$id][$((j + 1))]}
		j=$((j + 1))
	done
	unset "NP[$id][$((n - 1))]"
}

# A press puts the cursor where it lands and starts a selection there; a
# drag carries the cursor, and so the selection, with it. A press with
# shift extends the selection already there instead.
fn notepad_mouse(int id, act, btn, int mr, int mc, mods = "") {
	local r=$(($mr - 1)) c=$(($mc - 1))
	local top=${NP[$id]["top"]} row

	[ "$btn" = left ] || return 0
	row=$((top + r))
	[ "$row" -ge "${NP[$id]["n"]}" ] && row=$((${NP[$id]["n"]} - 1))
	[ "$row" -lt 0 ] && row=0
	# Only the cursor's own row was drawn scrolled sideways -- everywhere
	# else column 0 on screen is column 0 of the line.
	[ "$row" = "${NP[$id]["cr"]}" ] && c=$((c + ${NP[$id]["hoff"]:-0}))
	[ "$c" -gt "${#NP[$id][$row]}" ] && c=${#NP[$id][$row]}
	[ "$c" -lt 0 ] && c=0
	if [ "$act" = press ]; then
		case $mods in
		*shift*)
			if [ "${NP[$id]["sel"]}" != 1 ]; then
				NP[$id]["ar"]=${NP[$id]["cr"]}
				NP[$id]["ac"]=${NP[$id]["cc"]}
			fi
			;;
		*)
			NP[$id]["ar"]=$row
			NP[$id]["ac"]=$c
			;;
		esac
		NP[$id]["sel"]=1
	fi
	NP[$id]["cr"]=$row
	NP[$id]["cc"]=$c
}

if [ -z "$DT_ROWS" ]; then
	if [ -r "$NP_FILE" ]; then
		cat "$NP_FILE"
	else
		echo "notepad: nothing saved yet"
	fi
fi
