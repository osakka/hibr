# wm/handlers -- what opens a file, by its extension.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# What opens a file, by its extension -- a script of the user's own
# registers one with dt_handler, the same idiom dt_app uses to register a
# window:
#
#     dt_handler jpg feh
#     dt_handler json term less
#
# "term" runs the program in a terminal window, for anything that reads a
# terminal itself -- an interpreter, a pager; without it the program is
# started detached, for anything that draws its own window outside the
# desktop, such as an image viewer or a media player, which must not be
# waited for or the desktop would hang until it closed. A name with no
# extension, or one nothing was registered for, still opens in a terminal
# with hvi, exactly as it always did.
declare -gA DT_HANDLERS

fn dt_handler(ext, ...rest) {
	local term=0 i=0 a

	shift
	if [ "$1" = term ]; then
		term=1
		shift
	fi
	DT_HANDLERS[$ext]["term"]=$term
	for a in "$@"; do
		DT_HANDLERS[$ext][$i]="$a"
		i=$((i + 1))
	done
	DT_HANDLERS[$ext]["n"]=$i
}

# The extension a name is opened by: everything after the last dot, or
# empty for one with none -- "Makefile" and ".bashrc" both have none, since
# a leading dot is the name, not a separator.
fn dt_ext(path) {
	local nm=${path##*/}

	case $nm in
	*.*) ret "${nm##*.}" ;;
	*) ret "" ;;
	esac
}

# A handler's own argv, read by term_open once it is asked to run one
# instead of hvi: set right here, right before dt_launch term, so term.hibr
# never has to know this table exists.
DT_OPENCMD=()

# Set alongside DT_OPENCMD when the file being opened is itself the
# program -- an executable run directly, not through a registered
# handler's own interpreter -- so term.hibr knows not to append the
# path a second time as an argument, and to leave the window up on a
# clean exit so there is something to read rather than a flash and gone.
DT_OPENSELF=

# Run a registered handler on a path.
fn dt_runhandler(ext, path) {
	local n i=0

	n=${DT_HANDLERS[$ext]["n"]}
	DT_OPENCMD=()
	while [ "$i" -lt "$n" ]; do
		DT_OPENCMD+=("${DT_HANDLERS[$ext][$i]}")
		i=$((i + 1))
	done
	if [ "${DT_HANDLERS[$ext]["term"]}" = 1 ]; then
		dt_launch term "$path"
	else
		( "${DT_OPENCMD[@]}" "$path" >> "$DT_LOG" 2>&1 & )
		DT_OPENCMD=()
	fi
}

# Open a path: a folder in a file browser, a registered extension with its
# own handler, an executable run directly in a terminal, a picture in the
# image viewer if it is loaded, and anything
# else in a terminal with hvi, since every file a terminal can show is one
# it can edit. A user's own dt_handler for the same extension is checked
# first and wins, the same rule a file of your own replacing a bundled app
# already follows elsewhere. The executable bit is what decides run vs
# edit, not a second extension: a hibr desktop app that wants a window of
# its own belongs in DT_APPDIRS, where the hibr menu already finds it --
# sourcing an arbitrary double-clicked file into the running desktop, with
# every global that implies, is not a line this crosses.
DT_OPENPENDING=

# Run once the "unregistered extension" confirm below is answered yes --
# DT_OPENPENDING carries the path rather than the confirm command itself
# naming it, since dt_confirm's own callback is a bare word-split string
# and a path with a space in it would not survive that as an argument.
dt_openfile_confirmed() {
	dt_launch term "$DT_OPENPENDING"
	DT_OPENPENDING=
}

fn dt_openfile(path) {
	local ext

	if [ -d "$path" ]; then
		dt_launch files "$path"
		return 0
	fi
	ext := dt_ext "$path"
	dt_openers "$path"
	if [ -n "$DT_OWCONF" ] && [ "${#DT_OWLIST[@]}" -gt 0 ]; then
		dt_openwith "${DT_OWLIST[0]}" "$path"
	elif [ -n "${DT_HANDLERS[$ext]["n"]}" ]; then
		dt_runhandler "$ext" "$path"
	elif [ -x "$path" ]; then
		DT_OPENCMD=("$path")
		DT_OPENSELF=1
		dt_launch term "$path"
	elif [ "${#DT_OWLIST[@]}" -gt 0 ] &&
	     [ "${DT_OPENERS[${DT_OWLIST[0]}]["how"]}" = app ]; then
		dt_openwith "${DT_OWLIST[0]}" "$path"
	elif [ -n "${DT_APPS[term]["title"]}" ]; then
		DT_OPENPENDING=$path
		if [ -n "$ext" ]; then
			dt_confirm "Unregistered extension .$ext -- open in hvi anyway?" \
				dt_openfile_confirmed
		else
			dt_confirm "No file type registered for this -- open in hvi anyway?" \
				dt_openfile_confirmed
		fi
	else
		dt_note "Nothing here opens ${path##*/}"
	fi
}

# --- Open With ---------------------------------------------------------------
#
# What can open a file, for Files' Open With menu: every opener whose types
# take the file's extension, in the order DT_OPENWITH gives for that
# extension -- "png:imgview,hvi txt:hvi" -- or else in the order
# they were registered, a File Types handler for the extension first. The
# first is the default, what a double-click does; choosing another from
# Open With opens it there once and remembers nothing. Control Panel >
# File Types sets the list and the default for each type.
#
# A type is a space-separated list of extensions, "*" for any file, "x" for
# one that may be run. How it opens: app, given the path (dt_launch); edit,
# hvi in a terminal; run, the file itself in a terminal.
declare -gA DT_OPENERS
DT_OPENERORDER=()
DT_OPENWITH="${DT_OPENWITH-}"
DT_OWLIST=()
DT_OWCONF=

fn dt_opener(name, title, types, how, app = "") {
	[ -n "${DT_OPENERS[$name]["title"]}" ] || DT_OPENERORDER+=("$name")
	DT_OPENERS[$name]["title"]=$title
	DT_OPENERS[$name]["types"]=" $types "
	DT_OPENERS[$name]["how"]=$how
	DT_OPENERS[$name]["app"]=$app
}

dt_opener imgview "Image Viewer" "png ans" app imgview
dt_opener dbase "dBASE" "db" app dbase
dt_opener hvi "Text Editor (hvi)" "*" edit
dt_opener run "Run in Terminal" "x" run

# Whether an opener can open this path, and is there to do it.
fn dt_opencan(name, path, ext) {
	local ty=${DT_OPENERS[$name]["types"]} ap=${DT_OPENERS[$name]["app"]}

	[ -n "$ty" ] || return 1
	if [ -n "$ap" ]; then
		dt_has "${ap}_open" || dt_has "${ap}_draw" || return 1
	fi
	case $ty in
	*" * "*) return 0 ;;
	*" x "*) [ -x "$path" ] && return 0 ;;
	esac
	[ -n "$ext" ] && case $ty in *" $ext "*) return 0 ;; esac
	return 1
}

# The openers for a path, in their order, into DT_OWLIST: the configured
# list for its extension where there is one, then anything else that can
# open it; "handler" stands for a File Types handler of the extension.
fn dt_openers(path) {
	local ext n e
	local -a conf all ow

	DT_OWLIST=()
	DT_OWCONF=
	ext := dt_ext "$path"
	read -ra ow <<< "$DT_OPENWITH"
	for e in "${ow[@]}"; do
		[ "${e%%:*}" = "$ext" ] || continue
		IFS=, read -ra conf <<< "${e#*:}"
	done
	[ -n "$ext" ] && [ -n "${DT_HANDLERS[$ext]["n"]}" ] && all+=(handler)
	# What names the extension comes before what takes any file.
	for n in "${DT_OPENERORDER[@]}"; do
		case ${DT_OPENERS[$n]["types"]} in *" * "* | *" x "*) continue ;; esac
		dt_opencan "$n" "$path" "$ext" && all+=("$n")
	done
	for n in "${DT_OPENERORDER[@]}"; do
		case ${DT_OPENERS[$n]["types"]} in *" * "* | *" x "*) ;; *) continue ;; esac
		dt_opencan "$n" "$path" "$ext" && all+=("$n")
	done
	if [ "${#conf[@]}" -gt 0 ]; then
		DT_OWCONF=1
		for n in "${conf[@]}"; do
			case " ${all[*]} " in *" $n "*) DT_OWLIST+=("$n") ;; esac
		done
		return 0
	fi
	DT_OWLIST=("${all[@]}")
}

# An opener's name for a menu.
fn dt_openertitle(name, ext = "") {
	if [ "$name" = handler ]; then
		ret "${DT_HANDLERS[$ext][0]##*/}"
	else
		ret "${DT_OPENERS[$name]["title"]:-$name}"
	fi
}

# Open a path with one opener, this once.
fn dt_openwith(name, path) {
	local ext ap

	ext := dt_ext "$path"
	case $name in
	handler) dt_runhandler "$ext" "$path"; return 0 ;;
	esac
	ap=${DT_OPENERS[$name]["app"]}
	case ${DT_OPENERS[$name]["how"]} in
	app) dt_launch "$ap" "$path" ;;
	edit) DT_OPENCMD=(); dt_launch term "$path" ;;
	run)
		DT_OPENCMD=("$path")
		DT_OPENSELF=1
		dt_launch term "$path"
		;;
	*) return 1 ;;
	esac
}

# Open a path with a command typed for it, this once, in a terminal: the
# command's words, then the path.
fn dt_openwithcmd(cmd, path) {
	local -a words

	read -ra words <<< "$cmd"
	[ "${#words[@]}" -gt 0 ] || return 1
	DT_OPENCMD=("${words[@]}")
	dt_launch term "$path"
}

# --- Open Terminal Here --------------------------------------------------------
#
# A terminal window whose shell starts in a folder. DT_TERMHERE is what it
# runs: "shell" for $SHELL, or a command's name.
DT_TERMHERE="${DT_TERMHERE-shell}"

fn dt_termhere(dir) {
	local sh=$DT_TERMHERE

	[ -d "$dir" ] || return 1
	[ "$sh" = shell ] && sh=${SHELL:-${HIBR:-hibr}}
	[ "$sh" = hibr ] && sh=${HIBR:-hibr}
	DT_OPENCMD=("${HIBR:-hibr}" -c 'cd -- "$1" && exec "$2"' termhere "$dir" "$sh")
	DT_OPENSELF=1
	dt_launch term "$dir"
}

