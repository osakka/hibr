# wm/settings -- what the person using the desktop chooses -- keys, theme,
# wallpaper, cursor, shadows, frames and buttons -- and the settings file
# that keeps them: dt_keep, dt_load, dt_save.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Every key the desktop acts on, and every one can be changed -- in the
# Shortcuts pane, or here. Menu Bar, Copy, Cut and Paste are looked at
# before the focused window sees the key, so they work in every window;
# the rest only once the focused window has declined it. Quit has none by
# default: it is in the hibr menu, and one stray key should not end
# everything. Each is set only if a session has not set it first, like
# every other default here.
declare -gA DT_KEYS
[ -n "${DT_KEYS["menu"]+x}" ] || DT_KEYS["menu"]="f10"
[ -n "${DT_KEYS["menu2"]+x}" ] || DT_KEYS["menu2"]="escape"
[ -n "${DT_KEYS["copy"]+x}" ] || DT_KEYS["copy"]="alt-c"
[ -n "${DT_KEYS["cut"]+x}" ] || DT_KEYS["cut"]="alt-x"
[ -n "${DT_KEYS["paste"]+x}" ] || DT_KEYS["paste"]="alt-v"
[ -n "${DT_KEYS["selectall"]+x}" ] || DT_KEYS["selectall"]="ctrl-a"
[ -n "${DT_KEYS["scrollup"]+x}" ] || DT_KEYS["scrollup"]="shift-pageup"
[ -n "${DT_KEYS["scrolldown"]+x}" ] || DT_KEYS["scrolldown"]="shift-pagedown"
[ -n "${DT_KEYS["snapleft"]+x}" ] || DT_KEYS["snapleft"]="alt-left"
[ -n "${DT_KEYS["snapright"]+x}" ] || DT_KEYS["snapright"]="alt-right"
[ -n "${DT_KEYS["snaptop"]+x}" ] || DT_KEYS["snaptop"]="alt-up"
[ -n "${DT_KEYS["snapbottom"]+x}" ] || DT_KEYS["snapbottom"]="alt-down"
[ -n "${DT_KEYS["snapcenter"]+x}" ] || DT_KEYS["snapcenter"]=
[ -n "${DT_KEYS["ws1"]+x}" ] || DT_KEYS["ws1"]="alt-1"
[ -n "${DT_KEYS["ws2"]+x}" ] || DT_KEYS["ws2"]="alt-2"
[ -n "${DT_KEYS["ws3"]+x}" ] || DT_KEYS["ws3"]="alt-3"
for dt_k in 4 5 6 7 8 9; do
	[ -n "${DT_KEYS["ws$dt_k"]+x}" ] || DT_KEYS["ws$dt_k"]=
done
[ -n "${DT_KEYS["wsnext"]+x}" ] || DT_KEYS["wsnext"]="ctrl-alt-right"
[ -n "${DT_KEYS["wsprev"]+x}" ] || DT_KEYS["wsprev"]="ctrl-alt-left"
[ -n "${DT_KEYS["tile"]+x}" ] || DT_KEYS["tile"]=
[ -n "${DT_KEYS["tilemain"]+x}" ] || DT_KEYS["tilemain"]=
[ -n "${DT_KEYS["close"]+x}" ] || DT_KEYS["close"]="ctrl-w"
[ -n "${DT_KEYS["detach"]+x}" ] || DT_KEYS["detach"]="ctrl-\\"
[ -n "${DT_KEYS["quit"]+x}" ] || DT_KEYS["quit"]=
[ -n "${DT_KEYS["cycle"]+x}" ] || DT_KEYS["cycle"]="alt-tab"
[ -n "${DT_KEYS["strip"]+x}" ] || DT_KEYS["strip"]="alt-s"
[ -n "${DT_KEYS["shot"]+x}" ] || DT_KEYS["shot"]="ctrl-alt-g"

# The defaults above, kept, so dt_load can put one back.
declare -gA DT_KEYDEF
for dt_k in "${!DT_KEYS[@]}"; do DT_KEYDEF["$dt_k"]=${DT_KEYS["$dt_k"]}; done
unset dt_k

# Any app can have a global shortcut of its own, assigned from Settings --
# most have none, which is the point: a game or About does not want to
# steal a key from every window just for existing. term and tasks ship with
# one, since those two are reached often enough from outside any app to be
# worth a default; nothing stops a script or Settings from giving the same
# to any other, or taking these away. Nothing happens if the named app was
# never sourced, the same way dt_launch always behaves for a name nothing
# registered. alt-ctrl-, not ctrl-alt-: an alt combination arrives as ESC
# followed by the plain control byte, and the console names that "alt-"
# then whatever the control byte itself is, in that order -- unlike a
# CSI-encoded key's modifiers, which are named ctrl- before alt-. escape is
# avoided here on purpose: alt-escape is indistinguishable from a plain
# escape in most terminals, since ESC is also how alt itself arrives.
declare -gA DT_APPKEY
DT_APPKEY[term]="alt-ctrl-t"
DT_APPKEY[tasks]="alt-ctrl-p"
DT_KEYCAP=
declare -A DT

DT_WALL="${DT_WALL-#0d1b2a}"
DT_DOT="${DT_DOT-#16324a}"
DT_BAR="${DT_BAR-#1b3a5c}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_IDLE="${DT_IDLE-#4a5568}"
DT_FACE="${DT_FACE-#101820}"
DT_INK="${DT_INK-#cbd5e0}"
# Colour roles, beside the seven a theme always has: dim text, text drawn
# on the accent (a selection), good, warning and bad (the traffic-light
# buttons, an answer, an error), info, and a darker surface for keys and
# cells to sit in. A theme file may set any of them; these are what it
# gets when it does not -- the values every dark theme was drawn with.
DT_DIM="${DT_DIM-#718096}"
DT_SELINK="${DT_SELINK-#1a202c}"
DT_GOOD="${DT_GOOD-#68d391}"
DT_WARN="${DT_WARN-#f6ad55}"
DT_BAD="${DT_BAD-#f56565}"
DT_INFO="${DT_INFO-#4fd1c5}"
DT_WELL="${DT_WELL-#2d3748}"
DT_GLYPH="${DT_GLYPH-·}"

# A real image as the wallpaper instead of the repeated glyph, drawn by the
# img module (mods/img) if it can be loaded -- empty means the glyph, same
# as it always has been. Setting one and setting DT_GLYPH are mutually
# exclusive in the UI (Appearance's Wallpaper row, the strip's own wallpaper
# module) for the same reason a radio button only shows one choice at a
# time, but nothing stops a hand-edited config from having both; DT_WALLIMG
# wins when it does. DT_WALLTRIED is not a setting -- it just stops dt_wall
# from retrying `need img` every single frame once it is known not to load.
DT_WALLIMG="${DT_WALLIMG-}"
DT_WALLTRIED=

# How the wallpaper image fills the screen: stretch (ignore its own aspect
# ratio, the original and only behaviour), scale (fit entirely within the
# screen, keeping its own ratio, the glyph pattern showing through any
# letterboxed margin), zoom (fill the screen, keeping its own ratio, the
# overflow cropped), or center (its own native size, unscaled, centred,
# cropped or letterboxed as its size and the screen's disagree). Kept in
# the static DT_KEEP list below, not with dt_keep, since that function is
# not defined yet this early in the core file's own top-to-bottom run --
# dt_keep is for variables an app or pane declares after desktop.hibr has
# already loaded.
DT_WALLMODE="${DT_WALLMODE-stretch}"

# The cursor a new terminal starts with, until the program inside it asks
# for one of its own with DECSCUSR -- block, underline or bar.
DT_CURSOR="${DT_CURSOR-block}"

# Whether the cursor blinks. Off by default: a steady cursor is what the
# terminal module has always drawn, and blinking is a look, not a fix, so it
# stays opt-in. It costs nothing extra either way -- the focused terminal
# already redraws every 30ms to catch its own echo promptly, blink or not.
DT_CURSOR_BLINK="${DT_CURSOR_BLINK-0}"

# A window's shadow, cast on whatever is under it. On by default, since it
# costs one console darken call per window and nothing when off.
DT_SHADOW="${DT_SHADOW-1}"

# The same, for an open menu -- a separate setting, since a menu is drawn
# far more often than a window is moved, and someone who wants one without
# the other should be able to say so.
DT_MSHADOW="${DT_MSHADOW-1}"

# A shadow under the menu bar, giving it a sense of sitting above the
# desktop -- its own setting rather than tied to DT_SHADOW or DT_MSHADOW,
# the same reasoning as both of those already have: it is drawn every
# frame the bar is (always), not just when a window moves or a menu opens.
DT_BARSHADOW="${DT_BARSHADOW-1}"

# A shadow under a dialog's buttons -- widgets/button.hibr draws it, and
# this is its own setting for the same reason each of the others is.
DT_BTNSHADOW="${DT_BTNSHADOW-1}"

# How a dialog's buttons are drawn: filled, a block of colour each, or
# brackets, [OK] on the window's face, filled only while it has focus -- the
# same width either way, so no dialog's layout moves when it changes.
DT_DLGBTN="${DT_DLGBTN-filled}"
DT_DLGBTNS=(filled brackets)

# How much a shadow darkens what is under it -- console darken's own pct,
# kept per theme rather than as one constant. 55 (its builtin default)
# reads as a soft, barely-there shadow against a dark face like midnight's,
# because scaling an already-low RGB value down by 45% is a small absolute
# change -- but the same 45% off paper's near-white face lands on a flat
# medium grey, a hard-edged block rather than a shadow. Appearance's own
# cp_theme sets this alongside the other seven colours; unset here only
# matters before it is loaded at all.
DT_SHADOW_PCT="${DT_SHADOW_PCT-55}"

# What a double click on a title bar does -- zoom, minimise, close, or
# nothing. DT_DBLMS is how close together the two clicks have to land, and
# is not itself a setting: it is a threshold, not a preference.  DT_DBLID
# and DT_DBLT track the last title-bar click, to compare the next one
# against.
DT_DBLACTION="${DT_DBLACTION-zoom}"
DT_DBLMS=400
DT_DBLID=
DT_DBLT=0

# A window's own frame: single or double lined, or none at all. None is a
# blank frame, not no frame: the border ring -- corners, sides, grow box --
# goes undrawn, but the title and its buttons are still there, still
# clickable, exactly as under single or double. A style is a table entry:
# DT_FRAMES[name] carries its own six glyphs, filled from the glyph set by
# dt_glyphs (wm/glyphs.hibr), so a fifth frame is six lines there, not a
# change to dt_win.
DT_FRAME="${DT_FRAME-single}"

# Which side the min/max/close cluster docks to, where the title sits in
# whatever room that leaves, and which glyphs the cluster is drawn with:
# the Windows-style brackets this shipped with, coloured circles, or
# coloured squares. dt_btnspec is the table for the third of these, the
# same shape cp_theme's own case statement already is for a theme.
DT_BTNSIDE="${DT_BTNSIDE-right}"
DT_TITLEALIGN="${DT_TITLEALIGN-left}"
DT_BTNSTYLE="${DT_BTNSTYLE-brackets}"

# Whether a plain side (not just a corner) resizes too -- one dimension,
# the opposite edge anchored. On by default; off leaves the four corners
# as the only way, the same as before this existed. There is no top edge
# of its own regardless: row wr is the title bar over its whole width, so
# the two top corners are the only way to resize from above a window,
# with this on or off.
DT_EDGERESIZE="${DT_EDGERESIZE-1}"

# Move a window by holding a modifier and dragging anywhere in its body,
# not just its title bar -- on by default with alt, as most desktops do.
# It takes an alt-click away from the app under the pointer: when it
# fires, the window manager takes the click outright, before the app ever
# sees it -- there is no "the app declined it" convention anywhere else a
# click is dispatched, and this does not invent one just for itself.
DT_DRAGMOD="${DT_DRAGMOD-1}"
DT_DRAGKEY="${DT_DRAGKEY-alt}"

# Whether a terminal window gives the desktop's own chord shortcuts back --
# alt-tab cycling windows rather than reaching the program inside. On by
# default: only a chord or a function key someone has bound is taken, never
# a plain key, never ctrl with one letter (dt_keyassigned), and one window can still
# be told to pass everything (term_passall), for a desktop running inside.
DT_TERMKEEP="${DT_TERMKEEP-1}"

# Whether ctrl with a single letter always reaches the program in a
# terminal window, even when one is a desktop shortcut -- they are the
# control characters programs read: ctrl-c, a shell's ctrl-w, vi's ctrl-w
# windows. On by default; off, a shortcut on ctrl-w closes even a terminal.
DT_TERMCTRL="${DT_TERMCTRL-1}"

# A terminal window's scrollbar, on its right edge -- on by default, so the
# scrollback is visible as something there is. The terminal app keeps it.
DT_TERMBAR="${DT_TERMBAR-1}"

# Which version of these settings a saved file was written by. A file from
# before the number existed is version 0; dt_load brings an older one up to
# date once, so a default changed here reaches someone whose first save
# froze the old one -- the trap a frozen DT_TICK=200 once was.
DT_SETVER="${DT_SETVER-}"

# How many consecutive drag reports dt_run lets go by before it actually
# redraws -- 0 skips none (today's behaviour, and the default): a drag
# itself is not slower for it, since every report still updates the
# window's own position, only the screen catches up less often, which
# trades a window looking like it hops rather than glides in exchange for
# dt_win drawing every open window's own full content less often. A
# press or a release always redraws regardless -- only a drag report can
# be skipped, and only while another one immediately follows it.
DT_DRAWSKIP="${DT_DRAWSKIP-0}"
# What Cycle (alt-tab) goes through: the windows of this workspace, or of
# every workspace, going to whichever one the next window is on.
DT_CYCLE="${DT_CYCLE-workspace}"

# Settings are a script of the user's own, written by the desktop whenever
# one changes and read back at the next start: plain assignments, so it can
# be edited by hand and needs no format of its own.  An app that wants a
# variable of its own kept names it with dt_keep.
DT_CONF="${DT_CONF-${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desktop.hibr}"
DT_KEEP=(DT_WALL DT_DOT DT_BAR DT_ACTIVE DT_IDLE DT_FACE DT_INK DT_GLYPH
	DT_DIM DT_SELINK DT_GOOD DT_WARN DT_BAD DT_INFO DT_WELL
	DT_WALLIMG DT_WALLMODE
	DT_ICONS DT_DISKS DT_CURSOR DT_CURSOR_BLINK DT_SHADOW
	DT_MSHADOW DT_BARSHADOW DT_DBLACTION DT_SHADOW_PCT CS_SIDE CS_Y
	CS_COLLAPSED CS_LEN CS_SHADOW
	DT_FRAME DT_BTNSIDE DT_TITLEALIGN DT_BTNSTYLE DT_EDGERESIZE
	DT_DRAGMOD DT_DRAGKEY DT_DRAWSKIP DT_CYCLE DT_NOTEMS DT_NOTEPOS DT_NOTECOUNT DT_SHOTDIR DT_SHOTFMT DT_SHOTLAST DT_OPENWITH DT_TERMHERE DT_BARTIME
	DT_BARGAP DT_BELLICON DT_BTNSHADOW DT_DLGBTN DT_TERMKEEP DT_TERMCTRL DT_GLYPHSET DT_PLACE DT_WSN DT_TILEMAIN DT_SETVER)

# Where the desktop's stderr goes while it holds the screen, so an app's
# error message cannot scribble over the display, and the reason for a
# failure is still there to read after it.
DT_LOG="${DT_LOG-${XDG_STATE_HOME:-$HOME/.local/state}/hibr/desktop.log}"
DT_ERR=

# Keep these variables in the settings file too.
dt_keep() {
	DT_KEEP+=("$@")
}

# Read the settings file, if there is one.  It runs after the session file
# has set its defaults, so what was chosen last time wins.
dt_load() {
	DT_SETVER=
	if [ -r "$DT_CONF" ]; then
		. "$DT_CONF"
		if [ -z "$DT_SETVER" ]; then
			DT_TERMKEEP=1
		fi
		if [ "${DT_SETVER:-0}" -lt 2 ]; then
			DT_TERMBAR=1
			DT_DRAGMOD=1
			[ "${DT_KEYS["close"]}" = alt-f4 ] && DT_KEYS["close"]="ctrl-w"
			[ "${DT_KEYS["cycle"]}" = tab ] && DT_KEYS["cycle"]="alt-tab"
			[ "${DT_KEYS["quit"]}" = q ] && DT_KEYS["quit"]=
		fi
	fi
	DT_SETVER=2
	dt_keyfix
	dt_glyphs "$DT_GLYPHSET"
	return 0
}

# Settings saved by 0.77 to 0.79 could hold a shortcut on an arrow, enter or
# another key that moves around the panel -- the capture took whatever came
# next -- and a Menu Bar on the right arrow took every arrow from every
# window. Such a binding goes back to its default (or to none, for an app's
# launch key), and an entry for an action that no longer exists is dropped.
dt_keyfix() {
	local k

	for k in "${!DT_KEYS[@]}"; do
		if [ -z "${DT_KEYDEF["$k"]+x}" ]; then
			unset DT_KEYS["$k"]
		elif [ -n "${DT_KEYS["$k"]}" ] && dt_keynav "${DT_KEYS["$k"]}"; then
			DT_KEYS["$k"]=${DT_KEYDEF["$k"]}
		fi
	done
	for k in "${!DT_APPKEY[@]}"; do
		[ -n "${DT_APPKEY["$k"]}" ] && dt_keynav "${DT_APPKEY["$k"]}" &&
			DT_APPKEY["$k"]=
	done
	return 0
}

# Write every kept variable back, through a temporary file and a rename,
# so a crash halfway through never leaves half a settings file.
dt_save() {
	local v tmp=$DT_CONF.$$ n i line

	mkdir -p "${DT_CONF%/*}" 2> /dev/null || return 1
	{
		echo "# The desktop's settings, written whenever one changes and"
		echo "# read at the next start.  A script like any other."
		for v in "${DT_KEEP[@]}"; do
			[ -n "${!v+set}" ] && printf '%s=%q\n' "$v" "${!v}"
		done
		for v in "${!DT_ICONPOS[@]}"; do
			printf 'dt_iconpos %q %q\n' "$v" "${DT_ICONPOS["$v"]}"
		done
		for v in "${!DT_KEYS[@]}"; do
			printf 'DT_KEYS["%s"]=%q\n' "$v" "${DT_KEYS["$v"]}"
		done
		for v in "${!DT_APPKEY[@]}"; do
			printf 'DT_APPKEY["%s"]=%q\n' "$v" "${DT_APPKEY["$v"]}"
		done
		# A dt_handler call, reconstructed from the table it built --
		# added to by the File Types pane now, not only by a line in a
		# script of the user's own, so the same table needs writing back
		# out here too. %q on each word, not on the whole line, so a
		# command with an argument of its own survives the round trip.
		for v in "${!DT_HANDLERS[@]}"; do
			n=${DT_HANDLERS[$v]["n"]}
			line="dt_handler $(printf '%q' "$v")"
			[ "${DT_HANDLERS[$v]["term"]}" = 1 ] && line="$line term"
			i=0
			while [ "$i" -lt "$n" ]; do
				line="$line $(printf '%q' "${DT_HANDLERS[$v][$i]}")"
				i=$((i + 1))
			done
			echo "$line"
		done
	} > "$tmp" && mv -f "$tmp" "$DT_CONF"
}
