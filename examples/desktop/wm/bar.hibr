# wm/bar -- the menu bar's own contents on the right: the notification icon,
# the clock and the application menu.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The bar clock's own strftime format, chosen in Date & Time. dt_bar
# measures what it renders and leaves where the clock and the icon landed
# in DT_CLOCKC/DT_CLOCKW/DT_BELLC/DT_BELLW, so a wider format moves both
# left and the clicks follow them, rather than overrunning the application
# menu.
DT_BARTIME="${DT_BARTIME-%H:%M}"

# Cells between the dot, the clock and the application menu, 1 to 4. The
# default, 2, is the rhythm the menu titles on the left already have from
# the space either side of each name.
DT_BARGAP="${DT_BARGAP-2}"

# The notification icon in the bar, by name -- see dt_bellglyph. flag is
# the default because it is not an emoji: every monospace font has it, one
# cell wide. The bell is, and a terminal without an emoji font draws it as
# an empty box, or counts it one cell wide and pushes the clock along.
DT_BELLICON="${DT_BELLICON-flag}"
DT_BELLICONS=(flag bell note mail dot diamond star)
DT_CLOCKC=-1
DT_CLOCKW=0
DT_BELLC=-1
DT_BELLW=0
DT_CONFIRM=
DT_CONFIRM_CMD=
DT_CONFIRM_FOCUS=
DT_ROWS=24
DT_COLS=80

# Draw the bar itself.
dt_bar() {
	local i=0 t line now gap bell w=${DT_PRIMARY_W:-$DT_COLS}

	[ "$DT_BARSHADOW" = 1 ] &&
		console darken 1 "$DT_PRIMARY_COL" 1 "$w" "$DT_SHADOW_PCT"
	console pen "$DT_INK" "$DT_BAR"
	line := dt_rep "$w" " "
	console put 0 "$DT_PRIMARY_COL" "$line"

	DT_MENUEND=0
	DT_MENUSTART=$((DT_PRIMARY_COL + w))
	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		[ $((MB[$i]["x"] + ${#t} + 2)) -gt "$DT_MENUEND" ] &&
			DT_MENUEND=$((MB[$i]["x"] + ${#t} + 2))
		[ "${MB[$i]["x"]}" -lt "$DT_MENUSTART" ] && DT_MENUSTART=${MB[$i]["x"]}
		if [ "$i" = "$MB_OPEN" ] || [ "$i" = "$MB_PAR" ]; then
			console pen "$DT_BAR" "$DT_ACTIVE" bold
		elif [ "$i" = 0 ]; then
			console pen "$DT_ACTIVE" "$DT_BAR" bold
		else
			console pen "$DT_INK" "$DT_BAR"
		fi
		console put 0 "${MB[$i]["x"]}" " $t "
		i=$((i + 1))
	done

	now := dt_clocktext "$DT_BARTIME" -1
	case $DT_PBAR in on) gap := dt_pbar && now="$gap  ${GL[dot]}  $now" ;; esac
	# DT_BARGAP cells between each item on the right -- the application
	# menu's own leading space is one of them.
	gap=${DT_BARGAP:-2}
	[ "$gap" -lt 1 ] && gap=1
	[ "$gap" -gt 4 ] && gap=4
	DT_CLOCKW := str width "$now"
	DT_CLOCKC=$((MB_AX - (gap - 1) - DT_CLOCKW))
	case $DT_MIRRORON in 1) DT_CLOCKC=$((MB_AX + 14 + gap - 1)) ;; esac
	# The icon, and beside it how many notes have come since the history
	# was last opened -- nothing beside it when that is none. Its width is
	# measured like the clock's rather than assumed: the bell is two cells.
	bell := dt_bellglyph "$DT_BELLICON"
	if [ "$DT_NOTEUNSEEN" -gt 9 ]; then
		bell="${bell}9+"
	elif [ "$DT_NOTEUNSEEN" -gt 0 ]; then
		bell="${bell}$DT_NOTEUNSEEN"
	fi
	DT_BELLW := str width "$bell"
	DT_BELLC=$((DT_CLOCKC - gap - DT_BELLW))
	# Long app menus win here too: what would draw over a menu's title
	# gives way, and with no width it cannot be clicked either. Mirrored,
	# the clock, the bell and the numbers run rightwards from the
	# application menu at the left end, and give way to the menus' start.
	case $DT_MIRRORON in
	1)
		DT_BELLC=$((DT_CLOCKC + DT_CLOCKW + gap))
		[ $((DT_CLOCKC + DT_CLOCKW)) -gt "$DT_MENUSTART" ] && DT_CLOCKW=0
		[ $((DT_BELLC + DT_BELLW)) -gt "$DT_MENUSTART" ] && DT_BELLW=0
		dt_wsdraw 0 $((DT_BELLC + DT_BELLW + gap))
		;;
	*)
		[ "$DT_CLOCKC" -le "$DT_MENUEND" ] && DT_CLOCKW=0
		[ "$DT_BELLC" -le "$DT_MENUEND" ] && DT_BELLW=0
		dt_wsdraw $((DT_BELLC - gap))
		;;
	esac
	t := dt_ms
	case $DT_BARTIME in
	*%S* | *%T* | *%r* | *%s* | *%X* | *%c*)
		dt_want $((1000 - t % 1000 + 10)) ;;
	*) dt_want $((60000 - t % 60000 + 20)) ;;
	esac
	if [ "$DT_NOTEUNSEEN" -gt 0 ]; then
		console pen "$DT_ACTIVE" "$DT_BAR" bold
	else
		console pen "$DT_INK" "$DT_BAR"
	fi
	[ "$DT_BELLW" -gt 0 ] && console put 0 "$DT_BELLC" "$bell"
	console pen "$DT_INK" "$DT_BAR"
	[ "$DT_CLOCKW" -gt 0 ] && console put 0 "$DT_CLOCKC" "$now"
	if [ "$MB_OPEN" = app ]; then
		console pen "$DT_BAR" "$DT_ACTIVE" bold
	else
		console pen "$DT_INK" "$DT_BAR"
	fi
	t := dt_appname
	console put 0 "$MB_AX" " ${t:0:11} ${GL[sdown]}"
}

# The glyph a notification icon name stands for.
fn dt_bellglyph(style) {
	case $style in
	bell) ret "🔔" ;;
	note) ret "♪" ;;
	mail) ret "✉" ;;
	dot) ret "●" ;;
	diamond) ret "◆" ;;
	star) ret "✱" ;;
	*) ret "⚑" ;;
	esac
}

# A time in a strftime format, as the bar draws it: epoch seconds, or -1
# for now. Leading blanks go, so %l's space-padded hour does not leave a
# gap against the bell.
# The last answer and what it was for, because the bar asks for this on
# every frame and it can change at most once a second -- while the Hijri
# codes (ADR 0034) cost three module calls, 2.4 ms together, to say what
# changes once a day.
DT_CLOCKKEY=
DT_CLOCKWAS=

fn dt_clocktext(fmt, int when) {
	local out f=$fmt t=$when wd mo n s key

	[ "$t" -lt 0 ] && t=$EPOCHSECONDS
	# Everything the answer depends on, so a language, calendar or
	# adjustment change is not answered from a stale one.
	key="$t|$fmt|$DT_HCAL|$DT_HADJ|$DT_LANGON|$DT_DIGITS"
	if [ "$key" = "$DT_CLOCKKEY" ]; then
		ret "$DT_CLOCKWAS"
	fi
	# Names in the language chosen: the catalogue's, put in before
	# strftime sees the format, %% kept as it is.
	if [ -n "$DT_LANGON" ] && [[ $f == *%[AaBb]* ]]; then
		printf -v wd '%(%u %m)T' "$t"
		read -r wd mo <<< "$wd"
		mo=${mo#0}
		f=${f//%%/$'\001'}
		f=${f//%A/${DT_WDAYSA[$((wd - 1))]}}
		f=${f//%a/${DT_WDAYS[$((wd - 1))]}}
		f=${f//%B/${DT_MONTHS[$((mo - 1))]}}
		f=${f//%b/${DT_MONTHSB[$((mo - 1))]}}
		f=${f//$'\001'/%%}
	fi
	# The Hijri codes (ADR 0034): the hcal module's, in the calendar
	# chosen; with none chosen they say nothing. Only a format that has
	# one loads the module.
	case $f in
	*%i[demYBb]*)
		if [ "$DT_HCAL" != none ] && need hcal 2> /dev/null; then
			n=$DT_HCAL
			hcal info -c "$n" > /dev/null 2>&1 || n=civil
			if [ -n "$DT_LANGON" ] && [ "${#DT_HMONTHS[@]}" = 12 ]; then
				local IFS='|'
				s="${DT_HMONTHS[*]}"
				out := hcal format -c "$n" -a "$DT_HADJ" -n "$s" "$f" "$t" 2> /dev/null
			else
				out := hcal format -c "$n" -a "$DT_HADJ" "$f" "$t" 2> /dev/null
			fi
		else
			f=${f//%id/}; f=${f//%ie/}; f=${f//%im/}
			f=${f//%iY/}; f=${f//%iB/}; f=${f//%ib/}
			printf -v out "%($f)T" "$t"
		fi
		;;
	*) printf -v out "%($f)T" "$t" ;;
	esac
	while [ "${out:0:1}" = " " ]; do out=${out:1}; done
	[ "$DT_DIGITS" = arabic ] && out := dt_digits "$out"
	DT_CLOCKKEY=$key
	DT_CLOCKWAS=$out
	ret "$out"
}

# What to call the active application on the right of the bar.
dt_appname() {
	if [ -z "$MB_APP" ]; then
		ret "Desktop"
	elif [ -n "${DT_APPS[$MB_APP]["title"]}" ]; then
		ret "${DT_APPS[$MB_APP]["title"]}"
	else
		ret "$MB_APP"
	fi
}
