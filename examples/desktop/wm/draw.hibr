# wm/draw -- one frame of the whole desktop, bottom of the stack upwards.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Repeat a string n times.  One builtin call, not a loop with ${#} in it.
# The result goes through a variable and then ret: := binds for a builtin,
# not for a function, so a bare `str repeat` here would print to the screen.
fn dt_rep(int n, s) {
	local o

	str repeat "$s" "$n" o
	ret "$o"
}

# One full frame, bottom of the stack upwards.
#
# The menus are rebuilt only when something could have changed them: input
# arrived since the last build, focus moved, or a menu is open. A frame a
# timer asked for -- the clock's second, a cursor's blink -- reuses the last
# build, which cost a fifth of every idle frame. What a shut bar shows is
# its titles and the focused app's name, and only input or a focus change
# can alter those; an open menu is rebuilt every frame as before.
DT_MENUIN=
DT_MENUFOC=

# Which windows may be left as they are when their app says nothing has
# changed, and what geometry that answer was worked out for.
DT_ALONE=
DT_ALONEFOR=
DT_FORCEONCE=
# Whether every window is clear of every other, which is what lets the
# wallpaper be left alone: a shadow falling on another window has to be cast
# onto cells that window painted this very frame, and only a wallpaper that
# painted guarantees that for every shadow at once.
DT_NOOVERLAP=
# How many bytes of input the console has read, as of this frame: anything
# that may redraw only now and then compares it, so a key or a click is
# never waited out.
DT_INCNT=

# A window can be left alone only if its own rectangle, and the strip its
# shadow falls on, touch no other window's. Two that overlap are always both
# redrawn: windows are drawn bottom to top, so a lower one repainting would
# paint over the higher one's cells, and a higher one's shadow darkens what
# is under it -- which, on a lower window nobody repainted, would darken
# cells that are already dark, again on every frame. The wallpaper is no
# longer a problem for either of them (it paints behind the panes now), so
# this is the only rule left. Worked out once per arrangement, not per
# frame: five windows is ten comparisons and the answer only changes when
# something moves.
fn dt_alone(...rest) {
	local sig= id a b ar ac ah aw br bc bh bw ok out=
	local -a w alone

	# The look goes in the same signature as the geometry, so a theme or a
	# frame style or a glyph set changing is one full frame for everybody
	# -- otherwise a window nobody redrew would keep yesterday's colours.
	# Derived from the values themselves rather than hooked into whatever
	# changes them, so there is no list to keep up to date.
	sig="$DT_FACE|$DT_INK|$DT_ACTIVE|$DT_IDLE|$DT_FRAME|$DT_TITLEBAR"
	sig="$sig|$DT_SHADOW|$DT_SHADOW_PCT|$DT_GLYPHSET|$DT_LANG|$DT_TITLEALIGN"
	sig="$sig|$DT_BTNSIDE|$DT_DIM|$DT_SELINK|$DT_ROWS|$DT_COLS "
	for id in "${rest[@]}"; do
		id=${id#w}
		w+=("$id")
		sig="$sig$id,${DT[$id]["row"]},${DT[$id]["col"]},${DT[$id]["h"]},${DT[$id]["w"]} "
	done
	if [ "$sig" = "$DT_ALONEFOR" ]; then
		return 0
	fi
	# Something moved or the look changed: draw everything once.
	DT_FORCEONCE=1
	for a in "${w[@]}"; do
		ar=$((DT[$a]["row"]))
		ac=$((DT[$a]["col"]))
		ah=$((DT[$a]["h"] + 1))
		aw=$((DT[$a]["w"] + 2))
		ok=1
		for b in "${w[@]}"; do
			[ "$a" = "$b" ] && continue
			br=$((DT[$b]["row"]))
			bc=$((DT[$b]["col"]))
			bh=$((DT[$b]["h"] + 1))
			bw=$((DT[$b]["w"] + 2))
			if [ $((ar < br + bh)) = 1 ] && [ $((br < ar + ah)) = 1 ] &&
			   [ $((ac < bc + bw)) = 1 ] && [ $((bc < ac + aw)) = 1 ]; then
				ok=
				break
			fi
		done
		[ -n "$ok" ] && out="$out$a "
	done
	DT_ALONE=$out
	DT_ALONEFOR=$sig
	# A shadow is cast on whatever is under it, and darkening the same
	# cells twice makes them twice as dark -- so a shadow may only be cast
	# onto cells painted this frame. Where nothing overlaps, every shadow
	# falls on wallpaper and casting them follows the wallpaper. Where two
	# windows do overlap, one's shadow falls on the other, and the only
	# arrangement in which every shadow is certain of fresh cells beneath
	# it is the one where the wallpaper paints too. So overlapping windows
	# cost the wallpaper's own saving, and keep the picture right.
	DT_NOOVERLAP=
	read -ra alone <<< "$out"
	[ "${#w[@]}" = "${#alone[@]}" ] && DT_NOOVERLAP=1
	return 0
}

# A window that is not drawn -- minimised, or on another workspace -- still
# has its app's _idle called each frame, for what must go on unseen: a
# terminal reads its program's output there, or the pty stays readable, the
# desktop wakes on it at once, draws nothing that reads it, and holds a core.
dt_idle() {
	local id

	for id in "${!DT[@]}"; do
		[ -n "${DT[$id]["idle"]}" ] || continue
		dt_away "$id" || dt_hidden "$id" || continue
		DT_NOTEWIN=$id
		${DT[$id]["idle"]} "$id"
	done
	DT_NOTEWIN=
}

# Read what every window's own program has written and draw nothing: the
# same calls dt_idle makes, for every window rather than only the ones no
# frame draws. A frame held back to keep the rate down must still do this,
# because a watched descriptor nobody reads stays ready -- so skipping the
# read as well as the drawing would turn a held frame into a spin, which is
# the opposite of the point.
dt_drain() {
	local id

	for id in "${!DT[@]}"; do
		[ -n "${DT[$id]["idle"]}" ] || continue
		DT_NOTEWIN=$id
		${DT[$id]["idle"]} "$id"
	done
	DT_NOTEWIN=
}

dt_draw() {
	local l id ls

	DT_WANT=
	CS_SIDEX=$CS_SIDE
	DT_NOTEPOSX=$DT_NOTEPOS
	case $DT_MIRRORON in 1) dt_mirrorx ;; esac
	# Which windows are where, before the wallpaper rather than after it:
	# dt_wall's own decision about whether it need paint at all reads the
	# arrangement, so a window that has just moved has to be in it already
	# or its old cells would stay for a frame.
	DT_INCNT := console consumed
	l := console pane list
	read -ra ls <<< "$l"
	dt_alone "${ls[@]}"
	DT_WALLDREW=
	dt_wall
	for id in "${ls[@]}"; do dt_win "${id#w}"; done
	DT_FORCEONCE=
	dt_idle
	[ -n "$DT_DND" ] && dt_dnddraw
	# What a *shut* menu bar shows is its menus' titles and the focused
	# app's name, and both follow focus. Everything else dt_menus works
	# out is an item, which cannot be seen while the bar is shut -- and
	# the frame that opens a menu rebuilds first, because MB_OPEN is set
	# during input and this gate runs before anything draws. So a rebuild
	# is not needed merely because something was typed, which is what it
	# used to key on (`console consumed`): that cost 4.8 ms of an 11 ms
	# keystroke frame, rebuilding every menu in the bar to draw the same
	# titles (Gitea #109). DT_MENUIN is now only "the menus have been
	# built": anything that changes what a shut bar shows clears it, as
	# wm/lang.hibr and wm/session.hibr already did.
	if [ -z "$DT_MENUIN" ] || [ "$DT_FOCUS" != "$DT_MENUFOC" ] ||
	   [ "$MB_OPEN" != -1 ] || [ -n "$MB_CTXWHO" ]; then
		dt_menus
		dt_ctxbuild
		DT_MENUIN=1
		DT_MENUFOC=$DT_FOCUS
	fi
	dt_bar
	dt_stripdraw
	dt_drop
	dt_note_draw
	dt_identify_draw
	dt_blankdraw
	dt_sbtick
	dt_confirm_draw
	dt_shot_draw
	console flush
}
