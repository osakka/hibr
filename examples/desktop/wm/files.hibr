# wm/files -- files between windows: dragging, dropping, moving, copying,
# the trash, and the clipboard.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_WHY=

# An app starts a drag with dt_dnd from inside its _mouse, naming the paths
# it carries; the desktop draws it under the pointer and hands it on release
# to the _drop of the window it lands on -- or to the desktop itself.  A drop
# moves, and copies with ctrl held; escape cancels.  The moving and copying
# is here, once, so every app refuses the same things and says so the same
# way.

# Start dragging: a label and a picture to show under the pointer, then the
# paths carried.  Icons dragged about the desktop may carry none.
dt_dnd() {
	DT_DNDN=$1
	DT_DNDG=${2:-${GL[file]}}
	shift 2
	DT_DNDS=("$@")
	DT_DND=1
	DT_DNDICON=
}

dt_dnddraw() {
	console pen "$DT_FACE" "$DT_ACTIVE" bold
	console put "$DT_DNDR" $((DT_DNDC + 1)) " $DT_DNDG $DT_DNDN "
}

# Hand what was dropped to whatever is under the pointer.  Not dt_drop,
# which already draws the open menu.
fn dt_ondrop(int mr, int mc, mods) {
	local op=move id ap wr wc
	local -a src

	src=("${DT_DNDS[@]}")
	DT_DND=
	DT_DNDS=()
	case $mods in *ctrl*) op=copy ;; esac
	[ "$mr" = 0 ] && return 0
	id := console hit "$mr" "$mc"
	if [ -n "$id" ]; then
		id=${id#w}
		DT_DNDICON=
		ap=${DT[$id]["drop"]}
		if [ "${#src[@]}" = 0 ]; then
			dt_notep low "Only files can be dropped on a window"
			return 0
		fi
		if [ -z "$ap" ]; then
			dt_notep low "%s does not take files" "${DT[$id]["title"]}"
			return 0
		fi
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		DT_NOTEWIN=$id
		$ap "$id" $((mr - wr)) $((mc - wc)) "$op" "${src[@]}"
		return 0
	fi
	dt_has dt_deskdrop && dt_deskdrop "$mr" "$mc" "$op" "${src[@]}"
	return 0
}

# Move or copy one path into a folder: 0 done, 1 refused with the reason in
# DT_WHY, 2 nothing to do.  Nothing is ever put over something already
# there, and a folder cannot go inside itself.
fn dt_fileop1(op, src, dst) {
	local base dir

	base=${src##*/}
	if ! [ -e "$src" ] && ! [ -L "$src" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$dst" ]; then
		DT_WHY="${dst##*/} is not a folder"
		return 1
	fi
	dir=${src%/*}
	[ -z "$dir" ] && dir=/
	[ "$op" = move ] && [ "$dir" = "$dst" ] && return 2
	case "$dst/" in
	"$src/"*)
		DT_WHY="$base cannot go inside itself"
		return 1
		;;
	esac
	if [ -e "$dst/$base" ] || [ -L "$dst/$base" ]; then
		DT_WHY="${dst##*/} already has a $base"
		return 1
	fi
	if [ "$op" = copy ]; then
		command cp -R -- "$src" "$dst/" 2>> "$DT_LOG"
	else
		command mv -- "$src" "$dst/" 2>> "$DT_LOG"
	fi
	if [ $? != 0 ]; then
		DT_WHY="Could not $op $base"
		return 1
	fi
	return 0
}

# Say how a batch went: what was done, and the first thing refused. detail
# (optional) is appended to the done>1 note only -- "to $dst" or "to the
# trash" -- so the caller has one note to fire for that case, not two: a
# second dt_note right after this used to silently replace the first one's
# still-single DT_NOTE, which the queue would otherwise show as both.
fn dt_tally(int done, int bad, what, last, why, detail = "") {
	case $DT_LANG in ?*) what := dt_tr "$what" ;; esac
	if [ "$bad" = 0 ]; then
		[ "$done" = 1 ] && dt_notep low "$what $last"
		[ "$done" -gt 1 ] && dt_notep low "%s %s items%s" "$what" "$done" "${detail:+ $detail}"
	elif [ "$done" = 0 ]; then
		if [ "$bad" = 1 ]; then
			dt_notep high "$why"
		else
			dt_notep high "%s, and %s more could not go" "$why" "$((bad - 1))"
		fi
	else
		dt_notep high "$what $done; $why"
	fi
}

# Move or copy paths into a folder, and say once how it went.
fn dt_fileop(op, dst, ...rest) {
	local src n=0 bad=0 why= last= what

	shift 2
	if dt_has dt_davop; then
		for src in "$dst" "$@"; do
			if dt_isremote "$src"; then
				dt_davop "$op" "$dst" "$@"
				return
			fi
		done
	fi
	for src in "$@"; do
		dt_fileop1 "$op" "$src" "$dst"
		case $? in
		0) n=$((n + 1)); last=${src##*/} ;;
		1) bad=$((bad + 1)); [ -z "$why" ] && why=$DT_WHY ;;
		esac
	done
	what := dt_tr "Moved"
	[ "$op" = copy ] && what := dt_tr "Copied"
	if [ "$n" = 1 ]; then
		dt_tally 1 "$bad" "$what" "$last to ${dst##*/}" "$why"
	else
		dt_tally "$n" "$bad" "$what" "" "$why" "to ${dst##*/}"
	fi
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# Tell every window that shows files that something on disk has changed.
dt_changed() {
	local id cb

	for id in "${!DT[@]}"; do
		cb=${DT[$id]["refresh"]}
		[ -n "$cb" ] && DT_NOTEWIN=$id && $cb "$id"
	done
	DT_NOTEWIN=
	dt_has dt_deskscan && dt_deskscan
	return 0
}

# The trash, where the freedesktop specification puts it, so a file thrown
# away here can be found by any other desktop on the machine and the other
# way round.
DT_TRASH="${DT_TRASH-${XDG_DATA_HOME:-$HOME/.local/share}/Trash}"

# A path as the trash's info file writes it: percent-escaped, UTF-8 left be.
fn dt_urlpath(p) {
	local out= ch i=0 x

	while [ "$i" -lt "${#p}" ]; do
		ch=${p:i:1}
		case $ch in
		[A-Za-z0-9/._~-]) out="$out$ch" ;;
		*)
			printf -v x '%d' "'$ch"
			if [ "$x" -gt 0 ] && [ "$x" -lt 128 ]; then
				printf -v x '%%%02X' "$x"
				out="$out$x"
			else
				out="$out$ch"
			fi
			;;
		esac
		i=$((i + 1))
	done
	ret "$out"
}

# Move one file or folder to the trash, with the note that says where it
# was: 0 done, 1 refused with the reason in DT_WHY.
fn dt_trash1(p) {
	local base n i=1 when enc

	base=${p##*/}
	if ! [ -e "$p" ] && ! [ -L "$p" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$DT_TRASH/info" ] || ! [ -d "$DT_TRASH/files" ]; then
		if ! mkdir -p "$DT_TRASH/files" "$DT_TRASH/info" 2> /dev/null; then
			DT_WHY="There is no trash to put $base in"
			return 1
		fi
	fi
	n=$base
	while [ -e "$DT_TRASH/files/$n" ] || [ -L "$DT_TRASH/files/$n" ] ||
	      [ -e "$DT_TRASH/info/$n.trashinfo" ]; do
		n="$base.$i"
		i=$((i + 1))
	done
	printf -v when '%(%Y-%m-%dT%H:%M:%S)T' -1
	enc := dt_urlpath "$p"
	if ! printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$enc" "$when" \
		> "$DT_TRASH/info/$n.trashinfo"; then
		DT_WHY="Could not write the trash's note for $base"
		return 1
	fi
	if ! command mv -- "$p" "$DT_TRASH/files/$n" 2>> "$DT_LOG"; then
		rm -f "$DT_TRASH/info/$n.trashinfo"
		DT_WHY="Could not move $base to the trash"
		return 1
	fi
	return 0
}

# Move paths to the trash, and say once how it went. A fully successful
# run gets a clickable note straight to the trash's own folder -- dt_tally
# only ever fires a plain dt_note, and that folder is specific to trash,
# not something dt_fileop's own move/copy shares.
dt_trash() {
	local p n=0 bad=0 why= last=

	for p in "$@"; do
		if dt_trash1 "$p"; then
			n=$((n + 1))
			last=${p##*/}
		else
			bad=$((bad + 1))
			[ -z "$why" ] && why=$DT_WHY
		fi
	done
	if [ "$n" -gt 0 ] && [ "$bad" = 0 ]; then
		if [ "$n" = 1 ]; then
			dt_notify "Moved $last to the trash" \
				dt_launch files "$DT_TRASH/files"
		else
			dt_notify "Moved $n items to the trash" \
				dt_launch files "$DT_TRASH/files"
		fi
	else
		dt_tally "$n" "$bad" "Moved" "$last to the trash" "$why"
	fi
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# Copy or cut from the focused window, or paste into it.
#
# An app offers <app>_copy and, if it can move rather than only duplicate
# what is selected, <app>_cut -- both hand back the same kind of text with
# ret and fail when nothing is selected.  <app>_paste is given the text and,
# third, cut or copy, so a paste after Cut can move what it receives instead
# of copying it.  The desktop keeps one clipboard for every window, and also
# sends a copy to the clipboard of the terminal it runs on, where that
# terminal allows it -- so what is copied or cut here pastes into anything
# else on the machine, and, through hold, on every machine joined to it.
#
# DT_CLIPKIND says what the text is: "text", or "paths" -- files, one to a
# line, which Files pastes as the files themselves and anything else pastes
# as their names. An app's _copy that hands back paths sets it to paths;
# dt_edit has already set it to text before asking.
fn dt_edit(op) {
	local cb t

	if [ -z "$DT_FOCUS" ]; then
		[ "$op" = copy ] || return 0
		if t := dt_iconcopy && [ -n "$t" ]; then
			dt_clipset "$t" copy paths
			dt_notep low "Copied the paths of what is selected"
		else
			dt_notep low "No file is selected"
		fi
		return 0
	fi
	cb=${DT[$DT_FOCUS]["$op"]}
	if [ -z "$cb" ]; then
		dt_notep low "%s cannot %s" "${DT[$DT_FOCUS]["title"]}" "$op"
		return 0
	fi
	if [ "$op" = paste ]; then
		[ -n "$DT_CLIP" ] && $cb "$DT_FOCUS" "$DT_CLIP" "${DT_CLIPOP:-copy}"
		return 0
	fi
	DT_CLIPKIND=text
	if ! t := $cb "$DT_FOCUS" || [ -z "$t" ]; then
		dt_notep low "Nothing is selected"
		return 0
	fi
	dt_clipset "$t" "$op" "$DT_CLIPKIND"
	if [ "$op" = cut ]; then
		dt_notep low "Cut %s characters" "${#t}"
	else
		dt_notep low "Copied %s characters" "${#t}"
	fi
}
