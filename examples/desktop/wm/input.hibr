# wm/input -- keys and the mouse: where each one goes, and the shortcuts the
# desktop keeps for itself.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Handle one mouse report.
#
# An app is told a click in *pane* coordinates -- the same ones it draws in,
# where row 0 is the top border -- and not in some separate body coordinate
# system. Two systems is one too many: an app that draws at row 4 and is told
# a click at row 3 has to hold both in its head, and the first two apps each
# got the conversion wrong. The window manager handles row 0 itself, so an
# app only ever sees a click at row 1 or below.
#
# A report is `<action> <button> <row> <col>` for a press, a release or a
# drag, and `<action> <row> <col>` for the wheel, which has no button -- so
# the position cannot be read from a fixed argument. The action may carry a
# modifier, `ctrl-press`, which is stripped: a modified click is still a
# click here.
#
# Window fields are read into locals first: a subscript is only literal when
# it is quoted, and arithmetic never sees the quotes, so DT[$id][col] inside
# $(( )) would mean DT[$id][5] here.

dt_mouse() {
	local act=${1##*-} mr mc mods
	local id b wr wc wh ww ap mo now dr dc wsn

	mods=${1%"$act"}
	mods=${mods%-}
	shift
	case $act in
	wheelup | wheeldown) mr=$1; mc=$2 ;;
	*) mr=$2; mc=$3 ;;
	esac

	case $act in
	press)
		if [ "$mr" = 0 ]; then
			if [ "$1" != right ] && wsn := dt_wshit "$mc"; then
				dt_mclose
				dt_wsgo "$wsn"
				return 0
			fi
			if [ "$mc" -ge "$DT_BELLC" ] &&
			   [ "$mc" -lt $((DT_BELLC + DT_BELLW)) ]; then
				dt_mclose
				dt_has notifications_draw && dt_launch notifications
				return 0
			fi
			if [ "$mc" -ge "$DT_CLOCKC" ] &&
			   [ "$mc" -lt $((DT_CLOCKC + DT_CLOCKW)) ]; then
				dt_mclose
				dt_has clock_draw && dt_launch clock
				return 0
			fi
			if [ "$1" = right ]; then
				dt_context_open bar "" "$mr" "$mc"
				return 0
			fi
			b := dt_mhit "$mc" || { dt_mclose; return 0; }
			if [ "$b" = "$MB_OPEN" ]; then
				dt_mclose
			else
				dt_mopen "$b"
			fi
			return 0
		fi
		if [ "$MB_OPEN" != -1 ]; then
			if dt_mpick "$mr" "$mc"; then
				dt_mdo
			else
				dt_mclose
			fi
			return 0
		fi
		id := dt_note_hit "$mr" "$mc" && { dt_note_click "$id"; return 0; }
		cs_press "$mr" "$mc" && return 0
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			if [ "$1" = right ]; then
				dt_context_open desktop "" "$mr" "$mc"
				return 0
			fi
			DT_FOCUS=
			dt_iconpress "$mr" "$mc" "$mods"
			return 0
		fi
		id=${id#w}
		console pane raise "w$id"
		DT_FOCUS=$id
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		ww=${DT[$id]["w"]}
		wh=${DT[$id]["h"]}
		ap=${DT[$id]["click"]}
		if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" != 1 ]; then
			# Any of the four corners starts a resize, the opposite one
			# anchored: captured once, here, since the window's own row
			# and col start changing the moment a top or left edge does.
			if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" = $((wc + ww - 1)) ]
			then
				DT_SIZE=$id; DT_SIZECORNER=br
				DT_SIZE_AR=$wr; DT_SIZE_AC=$wc
				return 0
			fi
			if [ "$mr" = "$wr" ] && [ "$mc" = "$wc" ]; then
				DT_SIZE=$id; DT_SIZECORNER=tl
				DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$((wc + ww - 1))
				return 0
			fi
			if [ "$mr" = "$wr" ] && [ "$mc" = $((wc + ww - 1)) ]; then
				DT_SIZE=$id; DT_SIZECORNER=tr
				DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$wc
				return 0
			fi
			if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" = "$wc" ]; then
				DT_SIZE=$id; DT_SIZECORNER=bl
				DT_SIZE_AR=$wr; DT_SIZE_AC=$((wc + ww - 1))
				return 0
			fi
			# A side, not just a corner -- one dimension only, the
			# opposite edge anchored. There is no top edge of its own:
			# row wr is the title bar over its whole width, so the two
			# top corners are the only way to resize from above it.
			if [ "$DT_EDGERESIZE" = 1 ]; then
				if [ "$mc" = "$wc" ] && [ "$mr" -gt "$wr" ] &&
				   [ "$mr" -lt $((wr + wh - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=l
					DT_SIZE_AC=$((wc + ww - 1))
					return 0
				fi
				if [ "$mc" = $((wc + ww - 1)) ] && [ "$mr" -gt "$wr" ] &&
				   [ "$mr" -lt $((wr + wh - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=r
					DT_SIZE_AC=$wc
					return 0
				fi
				if [ "$mr" = $((wr + wh - 1)) ] && [ "$mc" -gt "$wc" ] &&
				   [ "$mc" -lt $((wc + ww - 1)) ]; then
					DT_SIZE=$id; DT_SIZECORNER=b
					DT_SIZE_AR=$wr
					return 0
				fi
			fi
		fi
		if [ "$mr" -ne "$wr" ]; then
			if [ "$DT_DRAGMOD" = 1 ] && [ "$1" != right ]; then
				case "-$mods-" in
				*"-$DT_DRAGKEY-"*)
					DT_DRAG=$id
					DT_DR=$((mr - wr))
					DT_DC=$((mc - wc))
					return 0
					;;
				esac
			fi
			mo=${DT[$id]["mouse"]}
			if [ -n "$mo" ]; then
				DT_MOUSE=$id
				$mo "$id" press "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
				return 0
			fi
			if [ "$1" = right ] &&
			   dt_has "${DT[$id]["app"]}_context"; then
				dt_context_open "${DT[$id]["app"]}" "$id" \
					"$mr" "$mc"
				return 0
			fi
			[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wc)) "$1"
			return 0
		fi
		b := dt_btn "$ww" $((mc - wc)) "${DT_APPS[${DT[$id]["app"]}]["fixed"]}"
		if [ "$1" = right ] && [ -z "$b" ]; then
			dt_context_open titlebar "$id" "$mr" "$mc"
			return 0
		fi
		if [ -n "$b" ]; then
			DT_BTNID=$id
			DT_BTNKIND=$b
			DT_BTNOVER=1
			return 0
		fi
		now := dt_ms
		if [ "$DT_DBLACTION" != none ] &&
		   [ "$DT_DBLID" = "$id" ] &&
		   [ $((now - DT_DBLT)) -lt "$DT_DBLMS" ]; then
			DT_DBLID=
			case $DT_DBLACTION in
			zoom)
				[ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" \
					!= 1 ] && dt_zoom "$id"
				;;
			min) dt_min "$id" ;;
			close) dt_del "$id" ;;
			esac
			return 0
		fi
		DT_DBLID=$id
		DT_DBLT=$now
		DT_DRAG=$id
		DT_DRAGR0=$wr
		DT_DRAGC0=$wc
		DT_DR=$((mr - wr))
		DT_DC=$((mc - wc))
		;;
	drag | release)
		# A title-bar button held down: while dragging, just track whether
		# the pointer is still over the one that was pressed, for dt_win's
		# own highlight; the action itself only ever fires from release,
		# and only if it landed back on the same button.
		if [ -n "$DT_BTNID" ]; then
			id=$DT_BTNID
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			ww=${DT[$id]["w"]}
			b := dt_btn "$ww" $((mc - wc)) \
				"${DT_APPS[${DT[$id]["app"]}]["fixed"]}"
			if [ "$b" = "$DT_BTNKIND" ] && [ "$mr" = "$wr" ]; then
				DT_BTNOVER=1
			else
				DT_BTNOVER=0
			fi
			if [ "$act" = release ]; then
				if [ "$DT_BTNOVER" = 1 ]; then
					case $DT_BTNKIND in
					close) dt_del "$id" ;;
					min) dt_min "$id" ;;
					max) dt_zoom "$id" ;;
					esac
				fi
				DT_BTNID=
				DT_BTNKIND=
				DT_BTNOVER=0
			fi
			return 0
		fi
		# Something being dragged between windows belongs to the desktop
		# until it is dropped, whoever started it.
		if [ -n "$DT_DND" ]; then
			DT_DNDR=$mr
			DT_DNDC=$mc
			if [ "$act" = release ]; then
				DT_MOUSE=
				dt_ondrop "$mr" "$mc" "$mods"
			fi
			return 0
		fi
		# A band being drawn across the empty desktop.
		if [ -n "$DI_BAND" ]; then
			dt_iconband "$act" "$mr" "$mc"
			return 0
		fi
		# A press on an icon that moves becomes a drag of the selection.
		if [ -n "$DI_PRESS" ]; then
			dt_iconmove "$act" "$mr" "$mc"
			return 0
		fi
		# A window that took the press with _mouse is told the rest of it,
		# wherever the pointer goes, until the button comes up.
		if [ -n "$DT_MOUSE" ]; then
			id=$DT_MOUSE
			mo=${DT[$id]["mouse"]}
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			[ "$act" = release ] && DT_MOUSE=
			[ -n "$mo" ] &&
				$mo "$id" "$act" "$1" $((mr - wr)) $((mc - wc)) \
					"$mods"
			DT_DNDR=$mr
			DT_DNDC=$mc
			return 0
		fi
		;;
	esac

	case $act in
	drag)
		if [ -n "$CS_DRAG" ]; then
			if [ -z "$CS_DRAGKIND" ]; then
				dr=$((mr - CS_PRESSR)); [ "$dr" -lt 0 ] && dr=$((0 - dr))
				dc=$((mc - CS_PRESSC)); [ "$dc" -lt 0 ] && dc=$((0 - dc))
				if [ "$dc" -gt "$dr" ] && [ "$dc" -gt 0 ]; then
					CS_DRAGKIND=resize
				elif [ "$dr" -gt 0 ]; then
					CS_DRAGKIND=move
				fi
			fi
			case $CS_DRAGKIND in
			resize) cs_resize "$mc" ;;
			move)
				CS_Y=$mr
				[ "$CS_Y" -lt 1 ] && CS_Y=1
				[ "$CS_Y" -ge "$DT_ROWS" ] && CS_Y=$((DT_ROWS - 1))
				;;
			esac
			return 0
		fi
		if [ -n "$DT_SIZE" ]; then
			# A tiled window's size is the layout's; say so once.
			if dt_intile "$DT_SIZE"; then
				[ "$DT_SIZENOTE" = "$DT_SIZE" ] ||
					dt_notep low "Tiled: the layout sizes this window"
				DT_SIZENOTE=$DT_SIZE
				return 0
			fi
			dt_cornersize "$DT_SIZE" "$DT_SIZECORNER" "$DT_SIZE_AR" \
				"$DT_SIZE_AC" "$mr" "$mc"
			return 0
		fi
		[ -z "$DT_DRAG" ] && return 0
		dt_move "$DT_DRAG" $((mr - DT_DR)) $((mc - DT_DC))
		;;
	release)
		# Let go over a workspace's number on the bar: the window goes to
		# that workspace, where it was before the drag began.
		if [ -n "$DT_DRAG" ] && [ "$mr" = 0 ] && wsn := dt_wshit "$mc"; then
			dt_move "$DT_DRAG" "$DT_DRAGR0" "$DT_DRAGC0"
			dt_wsmove "$DT_DRAG" "$wsn"
			DT_DRAG=
			return 0
		fi
		# A tiled window let go over another swaps places with it, and
		# anywhere else goes back to its own.
		if [ -n "$DT_DRAG" ] && dt_intile "$DT_DRAG"; then
			if wsn := dt_tileat "$mr" "$mc" "$DT_DRAG"; then
				dt_tileswap "$DT_DRAG" "$wsn"
			else
				dt_tile
			fi
			DT_DRAG=
			return 0
		fi
		DT_SIZENOTE=
		if [ -n "$CS_DRAG" ]; then
			case $CS_DRAGKIND in
			"")
				if [ "$CS_COLLAPSED" = 1 ]; then
					CS_COLLAPSED=0
				else
					CS_COLLAPSED=1
				fi
				;;
			move)
				if [ "$mc" -lt $((DT_COLS / 2)) ]; then
					CS_SIDE=left
				else
					CS_SIDE=right
				fi
				;;
			esac
			CS_DRAG=
			CS_DRAGKIND=
			dt_save
			return 0
		fi
		DT_DRAG=
		DT_SIZE=
		DT_SIZECORNER=
		;;
	wheelup | wheeldown)
		if cs_hit "$mr" "$mc"; then
			if [ "$act" = wheelup ]; then
				cs_scroll -1
			else
				cs_scroll 1
			fi
			return 0
		fi
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			dt_wswheel "$act"
			return 0
		fi
		id=${id#w}
		ap=${DT[$id]["wheel"]}
		[ -z "$ap" ] && return 0
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		$ap "$id" "${act#wheel}" $((mr - wr)) $((mc - wc))
		;;
	esac
}

# Handle one decoded key or mouse line.
#
# The wheel goes to the window under the pointer rather than to the focused
# one, which is what every other desktop does and what anyone expects when
# they scroll a list they have not clicked on yet.
fn dt_event(k) {
	local an knorm qn cn cln dn sn ev

	case $k in
	"mouse drag "*) DT_LASTDRAG=1; DT_LASTMOVE=1 ;;
	"mouse wheel"*) DT_LASTDRAG=0; DT_LASTMOVE=1 ;;
	*) DT_LASTDRAG=0; DT_LASTMOVE=0 ;;
	esac
	if [ -n "$DT_KEYCAP" ]; then
		case $k in
		# A mouse event does not cancel: a shortcut row already selected
		# from an earlier attempt arms capture on the very first click
		# of the next one (panel_click's own "a second click on an
		# already-selected row activates it"), so the click that
		# arrives right after -- the other half of an ordinary
		# double-click, or just a habitual re-click -- would otherwise
		# be read as this event and cancel the capture it had itself
		# just armed, before the intended key was ever pressed. Only
		# escape cancels; a stray click while capturing is absorbed.
		"mouse "*) ;;
		escape) DT_KEYCAP=; dt_notep low "Cancelled" ;;
		*)
			an=$DT_KEYCAP
			DT_KEYCAP=
			# A key that moves around the panel ends the capture
			# unchanged and then moves, as it would have: the arrow
			# pressed to go on to the next row goes on to it.
			if dt_keynav "$k"; then
				dt_notep low "Not changed"
			else
				dt_keytake "$an" "$k"
				return 0
			fi
			;;
		esac
		[ "$k" = escape ] || [ "${k#mouse }" != "$k" ] && return 0
	fi
	if [ -n "$DT_CONFIRM" ]; then
		case $k in
		"mouse press "*)
			read -ra ev <<< "$k"
			local yn
			yn := dt_confirm_hit "${ev[3]}" "${ev[4]}"
			if [ -n "$yn" ]; then
				dt_confirm_key "$yn"
			else
				DT_CONFIRM=
			fi
			;;
		"mouse "*) ;;
		*) dt_confirm_key "$k" ;;
		esac
		return 0
	fi
	# A mode that takes the keyboard over -- moving or resizing a window
	# from the keyboard, the Control Strip's arrows -- ends on a click, and
	# on any key it has no use for, which then goes where it would have:
	# a mode nobody can see must not swallow what is typed.
	case $k in
	"mouse press "*)
		if [ -n "$DT_GRAB" ]; then
			DT_GRAB=
			dt_note_clear
		fi
		CS_ATTN=0
		;;
	esac
	case $k in
	"mouse "*)
		read -ra ev <<< "$k"
		dt_mouse "${ev[@]:1}"
		return 0
		;;
	esac
	if [ -n "$DT_GRAB" ]; then
		dt_gkey "$k" && return 0
		DT_GRAB=
		dt_note_clear
	fi
	if [ -n "$DT_DND" ]; then
		DT_DND=
		DT_MOUSE=
		[ "$k" = escape ] && return 0
	fi
	if [ "$MB_OPEN" != -1 ]; then
		dt_mkey "$k" && return 0
		return 0
	fi
	# The strip takes left/right ahead of the focused window once CS_ATTN
	# has been given to it explicitly by its own shortcut -- there is no
	# mouse involved here at all; the wheel scrolls it separately, from
	# wherever the pointer actually is when it turns.
	if [ "$CS_ATTN" = 1 ]; then
		case $k in
		left) cs_scroll -1; return 0 ;;
		right) cs_scroll 1; return 0 ;;
		escape) CS_ATTN=0; dt_notep low "Control Strip: released"; return 0 ;;
		*) CS_ATTN=0 ;;
		esac
	fi
	# Copy, Cut and Paste belong to the desktop, the same keys in every
	# window, whatever they are set to; and so does a paste arriving from
	# the terminal the desktop runs on: it goes to the app's _paste when it
	# has one, and becomes the desktop's clipboard too, so Paste pastes it
	# again in any window and on any display joined to this one.
	if dt_keyis copy "$k"; then dt_edit copy; return 0; fi
	if dt_keyis cut "$k"; then dt_edit cut; return 0; fi
	if dt_keyis paste "$k"; then dt_edit paste; return 0; fi
	case $k in
	"paste "*)
		DT_CLIP=${k#paste }
		DT_CLIPOP=copy
		DT_CLIPKIND=text
		if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["paste"]}" ]; then
			${DT[$DT_FOCUS]["paste"]} "$DT_FOCUS" "${k#paste }"
			return 0
		fi
		;;
	esac
	# The Menu Bar key (f10 unless changed) is looked at before any window
	# sees the key, because it has to be the way back to the menu bar from
	# a window that wants everything else. Its second key (escape) comes
	# after, so a terminal running vi still gets escape.
	if dt_keyis menu "$k"; then
		CS_ATTN=0
		dt_mopen 0
		return 0
	fi
	if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["key"]}" ]; then
		if ${DT[$DT_FOCUS]["key"]} "$DT_FOCUS" "$k"; then
			return 0
		fi
	fi
	if [ -z "$DT_FOCUS" ] && [ "$DT_ICONS" = 1 ] && dt_iconkey "$k"; then
		return 0
	fi
	if dt_keyis menu2 "$k"; then
		CS_ATTN=0
		dt_mopen 0
		return 0
	fi
	# Compared by dt_keynorm, not as the literal string: a rebound
	# DT_KEYS entry combining ctrl and alt would have exactly the same
	# either-order ambiguity dt_appkeyed's own shortcuts do.
	knorm := dt_keynorm "$k"
	qn := dt_keynorm "${DT_KEYS[quit]}"
	cn := dt_keynorm "${DT_KEYS[cycle]}"
	cln := dt_keynorm "${DT_KEYS[close]}"
	dn := dt_keynorm "${DT_KEYS[detach]}"
	sn := dt_keynorm "${DT_KEYS[strip]}"
	if [ "$knorm" = "$qn" ]; then
		dt_quitconfirm
	elif [ "$knorm" = "$cn" ]; then
		dt_cycle
	elif [ "$knorm" = "$cln" ]; then
		dt_close_focused
	elif [ "$knorm" = "$dn" ]; then
		dt_detach
	elif dt_wskey "$k"; then
		:
	elif dt_keyis tile "$k"; then
		dt_tiletoggle
	elif dt_keyis tilemain "$k"; then
		dt_tilemain
	elif dt_keyis snapleft "$k"; then
		dt_snap_focused left
	elif dt_keyis snapright "$k"; then
		dt_snap_focused right
	elif dt_keyis snaptop "$k"; then
		dt_snap_focused top
	elif dt_keyis snapbottom "$k"; then
		dt_snap_focused bottom
	elif dt_keyis snapcenter "$k"; then
		dt_snap_focused center
	elif [ "$knorm" = "$sn" ]; then
		if [ "$CS_ATTN" = 1 ]; then
			CS_ATTN=0
			dt_notep low "Control Strip: released"
		else
			CS_ATTN=1
			dt_notep low "Control Strip: arrows scroll it, until escape"
		fi
	else
		dt_appkeyed "$k"
	fi
}

# Milliseconds, for telling a double click from two.
dt_ms() {
	local t=${EPOCHREALTIME/./}

	ret $((t / 1000))
}
