# wm/frame -- drawing a window's frame: its border, its title, and the
# buttons in its title bar.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict functions vars

# The three button-icon styles: which glyph and colour each of min, max
# and close gets, and what wraps the movable (3-button) or fixed
# (2-button) cluster. Fills BTN_K/BTN_G/BTN_C/BTN_DL/BTN_DR in the same
# left-to-right order dt_btn's own fixed offsets (1, 3, 5 or 1, 3) expect,
# so a fourth style is a branch here, never a change to dt_win or dt_btn.
fn dt_btnspec(style, fixed) {
	if [ "$fixed" = 1 ]; then BTN_K=(min close); else BTN_K=(min max close); fi
	case $style in
	circles)
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("●" "●"); BTN_C=("#f6ad55" "#f56565")
		else
			BTN_G=("●" "●" "●")
			BTN_C=("#f6ad55" "#68d391" "#f56565")
		fi
		;;
	squares)
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("■" "■"); BTN_C=("#f6ad55" "#f56565")
		else
			BTN_G=("■" "■" "■")
			BTN_C=("#f6ad55" "#68d391" "#f56565")
		fi
		;;
	*)
		BTN_DL="┤"; BTN_DR="├"
		if [ "$fixed" = 1 ]; then
			BTN_G=("_" "x"); BTN_C=("$DT_INK" "#f56565")
		else
			BTN_G=("_" "□" "x")
			BTN_C=("$DT_INK" "$DT_INK" "#f56565")
		fi
		;;
	esac
}

# dt_btnspec's own arrays, reordered left to right for the side the
# cluster actually docks to. min/max/close reads left to right on the
# right; mirrored on the left it reads close/max/min, so close is always
# the button nearest the window's own outer corner, whichever side that
# is -- the same relationship a real title bar keeps moved to either side.
fn dt_btnorder(style, fixed, side) {
	dt_btnspec "$style" "$fixed"
	[ "$side" != left ] && return 0
	if [ "$fixed" = 1 ]; then
		BTN_K=("${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[1]}" "${BTN_C[0]}")
	else
		BTN_K=("${BTN_K[2]}" "${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[2]}" "${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[2]}" "${BTN_C[1]}" "${BTN_C[0]}")
	fi
}

# The cluster dt_btnspec's own glyphs draw as one string -- always 5
# (fixed) or 7 (movable) characters, matching the offsets dt_btn already
# hit-tests, whatever style set the glyphs themselves.
dt_btnstr() {
	if [ ${#BTN_G[@]} = 3 ]; then
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]} ${BTN_G[2]}$BTN_DR"
	else
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]}$BTN_DR"
	fi
}

# Draw one window: its face, then its app, then its frame over the top.
fn dt_win(id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}
	local fixed=${DT_APPS[${DT[$id]["app"]}]["fixed"]} pc

	[ "$DT_SHADOW" = 1 ] &&
		console darken $((wr + 1)) $((wc + 2)) "$h" "$w" "$DT_SHADOW_PCT"
	[ "$DT_FOCUS" = "$id" ] && on=$DT_ACTIVE
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"

	# None is a blank frame, not no frame: the ring of border glyphs is
	# left undrawn -- no corners, no sides, no grow box -- but the title
	# and its buttons are still there, still clickable, exactly as under
	# single or double. Nothing about a window's controls ever depends on
	# whether its edge is drawn.
	if [ "$DT_FRAME" != none ]; then
		console pen "$on" "$DT_FACE"
		local tl=${DT_FRAMES[$DT_FRAME]["tl"]} tr=${DT_FRAMES[$DT_FRAME]["tr"]}
		local bl=${DT_FRAMES[$DT_FRAME]["bl"]} br=${DT_FRAMES[$DT_FRAME]["br"]}
		local fh=${DT_FRAMES[$DT_FRAME]["h"]} fv=${DT_FRAMES[$DT_FRAME]["v"]}
		local bar
		bar := dt_rep $((w - 2)) "$fh"
		console put -p "w$id" 0 0 "$tl$bar$tr"
		console put -p "w$id" $((h - 1)) 0 "$bl$bar$br"
		console pen "$DT_INK" "$DT_FACE"
		# A fixed window keeps the plain corner the border just drew
		# instead of the grow box: no drag can resize it, so nothing
		# should invite one.
		[ "$fixed" != 1 ] &&
			console put -p "w$id" $((h - 1)) $((w - 1)) "◢"
		local r=1
		while [ "$r" -lt $((h - 1)) ]; do
			console put -p "w$id" "$r" 0 "$fv"
			console put -p "w$id" "$r" $((w - 1)) "$fv"
			r=$((r + 1))
		done
	fi

	local bs bc off i
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$DT_BTNSIDE"
	# A blank frame is blank throughout: the tick marks a style wraps its
	# cluster in are box-drawing glyphs too, and stay undrawn along with
	# the ring itself, even though the buttons they wrap keep working.
	[ "$DT_FRAME" = none ] && { BTN_DL=" "; BTN_DR=" "; }
	bs := dt_btnstr
	if [ "$DT_BTNSIDE" = left ]; then bc=1; else bc=$((w - 1 - ${#bs})); fi
	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" 0 "$bc" "$bs"
	if [ "$fixed" = 1 ]; then off=(1 3); else off=(1 3 5); fi
	i=0
	while [ "$i" -lt ${#BTN_G[@]} ]; do
		if [ "${BTN_C[$i]}" != "$DT_INK" ]; then
			console pen "${BTN_C[$i]}" "$DT_FACE" bold
			console put -p "w$id" 0 $((bc + ${off[$i]})) "${BTN_G[$i]}"
		fi
		i=$((i + 1))
	done

	# Room for the title is measured from the button cluster's own real
	# position and width, not a style's worst case -- a fixed window's
	# five-wide cluster leaves two columns more than a movable one's seven,
	# and a centred or right-aligned title has to land on the real
	# boundary or it reads as off-centre once anything narrower than the
	# widest cluster is in play.
	local t=${DT[$id]["title"]} tc0 room tc tmax
	if [ "$DT_BTNSIDE" = left ]; then
		tc0=$((bc + ${#bs}))
		room=$((w - 1 - tc0 - 4))
	else
		tc0=2
		room=$((bc - tc0 - 4))
	fi
	[ ${#t} -gt "$room" ] && t="${t:0:$room}"
	tmax=$((tc0 + room - ${#t}))
	case $DT_TITLEALIGN in
	# Centred on the bar's own full width, not on the room left over once
	# the button cluster is excluded -- centring in that remaining room
	# pushes the title away from the buttons by about half the cluster's
	# own width, which is exactly what reads as off-centre, and in the
	# opposite direction depending on which side the buttons are docked.
	# Still clamped into the same safe range the button cluster already
	# keeps clear, so a long title still cannot run into it.
	center) tc=$((1 + (w - 6 - ${#t}) / 2))
		[ "$tc" -lt "$tc0" ] && tc=$tc0
		[ "$tc" -gt "$tmax" ] && tc=$tmax ;;
	right)  tc=$tmax ;;
	*)      tc=$tc0 ;;
	esac
	local tdl="┤" tdr="├"
	[ "$DT_FRAME" = none ] && { tdl=" "; tdr=" "; }
	console pen "$on" "$DT_FACE" bold
	console put -p "w$id" 0 "$tc" "$tdl $t $tdr"

	# Held down and still over the one that was pressed: the glyph alone
	# changes colour, no block behind it -- a grey one takes the theme's
	# accent, a coloured one (close's red, the traffic lights) a brighter
	# version of its own -- so a click looks like it did something before
	# whatever it does finishes happening, in the theme's own colours.
	if [ "$DT_BTNID" = "$id" ] && [ "$DT_BTNOVER" = 1 ]; then
		i=0
		while [ "$i" -lt ${#BTN_K[@]} ]; do
			if [ "${BTN_K[$i]}" = "$DT_BTNKIND" ]; then
				if [ "${BTN_C[$i]}" = "$DT_INK" ]; then
					pc=$DT_ACTIVE
				else
					pc := dt_lighten "${BTN_C[$i]}" 45
				fi
				console pen "$pc" "$DT_FACE" bold
				console put -p "w$id" 0 $((bc + ${off[$i]})) \
					"${BTN_G[$i]}"
			fi
			i=$((i + 1))
		done
	fi
}

# A #rrggbb colour moved pct of the way toward white; anything else as it
# came.
fn dt_lighten(c, p) {
	local r g b

	match "$c" '^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$' ||
		{ ret "$c"; return 0; }
	r=$((16#${M[1]})); g=$((16#${M[2]})); b=$((16#${M[3]}))
	r=$((r + (255 - r) * p / 100))
	g=$((g + (255 - g) * p / 100))
	b=$((b + (255 - b) * p / 100))
	printf -v c '#%02x%02x%02x' "$r" "$g" "$b"
	ret "$c"
}

# Which title-bar button is at this column, if any.  fixed omits max, whose
# button is not drawn there either, so a click at its old column falls
# through to the window's body instead of hitting a button that is not there.
fn dt_btn(w, c, fixed) {
	local bc bw

	if [ "$fixed" = 1 ]; then bw=5; else bw=7; fi
	if [ "$DT_BTNSIDE" = left ]; then bc=1; else bc=$((w - 1 - bw)); fi
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$DT_BTNSIDE"
	if [ "$fixed" = 1 ]; then
		case $((c - bc)) in
		1) ret "${BTN_K[0]}" ;;
		3) ret "${BTN_K[1]}" ;;
		*) ret "" ;;
		esac
		return 0
	fi
	case $((c - bc)) in
	1) ret "${BTN_K[0]}" ;;
	3) ret "${BTN_K[1]}" ;;
	5) ret "${BTN_K[2]}" ;;
	*) ret "" ;;
	esac
}
