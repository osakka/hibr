# wm/apps -- applications: registering them, finding them in their folders,
# listing them and launching them.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_APPDIR_CUR=

# What runs once when the desktop starts, after any restart has put its
# windows back: an app registers a function of its own with dt_atstart
# (Stickies opens its notes), and dt_run calls each one before its first
# frame.
DT_ATSTART=()
fn dt_atstart(f) {
	DT_ATSTART+=("$f")
}

dt_runatstart() {
	local f

	for f in "${DT_ATSTART[@]}"; do
		dt_has "$f" && "$f"
	done
	DT_ATSTART=()
}

# Register an app the hibr menu can open: name, title, height, width.
fn dt_app(name, title, int h, int w, once = "", icon = "", fixed = "", hidden = "", bare = "") {
	DT_APPS[$name]["title"]="$title"
	DT_APPS[$name]["h"]="$h"
	DT_APPS[$name]["w"]="$w"
	DT_APPS[$name]["once"]=
	[ "$once" = once ] && DT_APPS[$name]["once"]=1
	DT_APPS[$name]["icon"]="${icon:-◆}"
	DT_APPS[$name]["fixed"]=
	[ "$fixed" = fixed ] && DT_APPS[$name]["fixed"]=1
	# hidden is for an app dt_launch has to find by name -- About hibr,
	# or a window like Rename/Get Info that only ever opens on a specific
	# file, never generically -- but that must never appear as a choice
	# of its own on the hibr menu or in App Shortcuts' list of apps to
	# give a global key. dt_appmenu and dt_appnames both read it; neither
	# hardcodes a name the way dt_appmenu once hardcoded "about".
	DT_APPS[$name]["hidden"]=
	[ "$hidden" = hidden ] && DT_APPS[$name]["hidden"]=1
	# bare: no frame, no shadow, no title bar -- a strip across the top in
	# a darker shade of the window's own colour (DT[$id]["bg"], which the
	# app sets), with a close box on it, and a grow mark in the corner. A
	# sticky note is one.
	DT_APPS[$name]["bare"]=
	[ "$bare" = bare ] && DT_APPS[$name]["bare"]=1
	# Set by dt_apps while it sources this file, from where it found it --
	# empty for one sourced any other way, which stays a flat item.
	DT_APPS[$name]["dir"]="$DT_APPDIR_CUR"
}

# Where apps are found: every .hibr in each of these, at any depth, in this
# order.  The user's own folder comes first, so a file there replaces a
# bundled app of the same name; a session adds its own folders after.
DT_APPDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps")
declare -gA DT_SRC

# Load every app in the folders.  Each file declares itself with dt_app, so
# the folder is the whole configuration: drop a script in, in a subfolder of
# your own if you like, and it is on the menu at the next start -- globstar
# is always on, which is what makes ** reach into them. A file whose name
# was already loaded from an earlier folder is skipped. An app in a
# subfolder gets a submenu of its own on the hibr menu, named after it --
# DT_APPDIR_CUR is the path dt_app reads to know which, relative to
# whichever root found it, empty at the top of one.
dt_apps() {
	local d f b rel

	for d in "${DT_APPDIRS[@]}"; do
		for f in "$d"/**/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			rel=${f#"$d"/}
			case $rel in
			*/*) DT_APPDIR_CUR=${rel%/*} ;;
			*) DT_APPDIR_CUR= ;;
			esac
			. "$f"
		done
	done
	DT_APPDIR_CUR=
}

# Desk accessories are ordinary apps -- dt_app, nothing else, the same
# registration every other app uses. They get a directory list of their
# own, the same customizable-with-a-default shape DT_APPDIRS and
# CP_PANEDIRS already have, only so the hibr menu can group them under one
# name regardless of where DA_DIRS points -- the nostalgic Desk Accessories
# folder, not a mechanism an accessory has to do anything for. A flat scan,
# not dt_apps' recursive one: an accessory does not earn a folder-submenu
# concept of its own the way a whole app folder does.
DA_DIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desk-accessories")

da_apps() {
	local d f b

	for d in "${DA_DIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			DT_APPDIR_CUR="Desk Accessories"
			. "$f"
		done
	done
	DT_APPDIR_CUR=
}

# Every registered app, sorted by title without regard to case, as names --
# for anything that wants every app in one flat list rather than the hibr
# menu's own folder-grouped one below (Settings' App Shortcuts rows do).
dt_appnames() {
	local n l out=
	local -a all

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		l := str lower "${DT_APPS[$n]["title"]}"
		all+=("$l	$n")
	done
	arr sort all
	for l in "${all[@]}"; do out="$out ${l#*	}"; done
	ret "${out# }"
}

# Add one folder level's worth of the hibr menu: apps stored directly in
# it as items, each immediate child folder as a submenu built the same way,
# recursing to any depth -- prefix is that folder's own path, "" for the
# top. reserved is letters the *caller's* menu has already used, since a
# submenu is its own menu with its own letters otherwise: About hibr, Quit
# and the rest only need keeping clear of at the top.
fn dt_appmenu(prefix, used = "") {
	local n d l child k path kind
	local -a all seen

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		d=${DT_APPS[$n]["dir"]}
		if [ "$d" = "$prefix" ]; then
			l := str lower "${DT_APPS[$n]["title"]}"
			all+=("$l	a	$n")
			continue
		fi
		if [ -n "$prefix" ]; then
			case $d in "$prefix"/*) ;; *) continue ;; esac
			child=${d#"$prefix"/}
		else
			[ -z "$d" ] && continue
			child=$d
		fi
		child=${child%%/*}
		case " ${seen[*]-} " in *" $child "*) continue ;; esac
		seen+=("$child")
		l := str lower "$child"
		if [ -n "$prefix" ]; then
			all+=("$l	f	$prefix/$child")
		else
			all+=("$l	f	$child")
		fi
	done
	[ "${#all[@]}" -eq 0 ] && return 0
	arr sort all
	for l in "${all[@]}"; do
		IFS=$'\t' read -r _ kind path <<< "$l"
		if [ "$kind" = f ]; then
			dt_sub "${path##*/}"
			dt_appmenu "$path"
			dt_end
		else
			k := dt_akey "${DT_APPS[$path]["title"]}" "$used"
			used="$used$k"
			dt_item "${DT_APPS[$path]["title"]}" "$k" \
				dt_launch "$path"
		fi
	done
}

# The window already showing an app, if there is one.
fn dt_appwin(app) {
	local id

	for id in "${!DT[@]}"; do
		if [ "${DT[$id]["app"]}" = "$app" ]; then
			ret "$id"
			return 0
		fi
	done
	return 1
}

# Open a registered app in a fresh window, where dt_place puts it -- in the
# first free spot, by default. An app may say how big it wants to be at
# the moment it opens with <app>_size, answering "h w" (the terminal's
# depends on a setting); otherwise its dt_app size. An app declared `once`
# has one window at most: launching it again brings that one forward,
# shown if it was hidden.  Anything after the name goes to its _open.
fn dt_launch(n, arg = "") {
	local h w sz id pl r c

	[ -z "${DT_APPS[$n]["title"]}" ] && return 1
	# An app that does something rather than showing a window -- the
	# Screenshot desk accessory -- gives <app>_launch, and that is all.
	if dt_has "${n}_launch"; then
		"${n}_launch" "$arg"
		return 0
	fi
	if [ -n "${DT_APPS[$n]["once"]}" ] && id := dt_appwin "$n"; then
		dt_raise "$id"
		ret "$id"
		return 0
	fi
	h=${DT_APPS[$n]["h"]}
	w=${DT_APPS[$n]["w"]}
	if dt_has "${n}_size" && sz := "${n}_size"; then
		h=${sz% *}
		w=${sz#* }
	fi
	pl := dt_place "$h" "$w"
	read -r r c h w <<< "$pl"
	dt_new "${DT_APPS[$n]["title"]}" "$h" "$w" "$r" "$c" "$n" "$arg"
}

# The about app shows the machine's own numbers, live; without it (a session
# that never called dt_apps, or one that dropped the file) a note still says
# what this is, since About hibr must never be a dead menu item.
dt_about() {
	dt_has about_draw && { dt_launch about; return 0; }
	dt_notep low "hibr $HIBR_VERSION — a desktop written in the shell it runs on"
}
