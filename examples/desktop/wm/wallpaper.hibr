# wm/wallpaper -- the desktop's own background: a glyph, or an image fitted
# to the screen.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_WALLR=0
DT_WALLC=0
DT_WALLH=0
DT_WALLW=0

# How a picture is drawn, everywhere the desktop draws one: auto takes
# pixels where the terminal can place them (the kitty graphics protocol, or
# sixel) and half blocks where it cannot, and the rest say outright. dt_imgm
# is what every caller passes to `img draw -m`, so one setting reaches the
# viewer, the wallpaper, Mail's pictures, the film player and the browser.
# The value is `pixels`; a settings file written before 0.99.76 says `sixel`
# and means the same thing, which is why nothing migrates it.
DT_IMGMODE="${DT_IMGMODE-auto}"
dt_keep DT_IMGMODE
DT_IMGARG=()

# The -m argument for the mode chosen, as an array since it is two words or
# none, and a strict file cannot split a string into them.
dt_imgm() {
	DT_IMGARG=()
	case $DT_IMGMODE in
	auto | "") ;;
	*) DT_IMGARG=(-m "$DT_IMGMODE") ;;
	esac
	return 0
}

# What the terminal can do with a picture: "kitty 10 20", "sixel 8 16" or
# "none 0 0". Which protocol is the console's business, not an app's: an app
# asks dt_imgpix whether there are pixels to be had at all.
dt_imggfx() {
	local g

	if ! command -v console > /dev/null; then
		ret "none 0 0"
	fi
	g := console gfx 2> /dev/null || g="none 0 0"
	ret "$g"
}

# Whether this terminal places pixels, whichever protocol it speaks. The
# first word of dt_imggfx is the name of one, or "none".
dt_imgpix() {
	local g

	g := dt_imggfx
	case $g in
	kitty* | sixel*) return 0 ;;
	esac
	return 1
}

# Whether a picture drawn now will be real pixels rather than cells: the
# setting says so outright, or it says auto and the terminal can. What a
# caller needs when the two cases want different cells around the picture --
# the wallpaper blanks what it is about to put a bitmap over.
dt_imgwill() {
	case $DT_IMGMODE in
	pixels | sixel) return 0 ;;
	auto | "") dt_imgpix && return 0 ;;
	esac
	return 1
}

# The row/col/h/w to hand img draw for DT_WALLMODE, in DT_WALLR/C/H/W --
# the same "cols must be 2*sw/sh, not sw/sh" cell-aspect correction
# wallpaper.hibr's own preview already uses, since img draw's own cell is
# one column wide but two source pixel rows tall. The *display* crops
# whatever falls outside the screen to it, scaling only the part that shows
# -- cropped, not squashed, which is what these two modes mean -- so zoom
# and center can freely come out larger than the screen or with a negative
# row/col and nothing here needs to clamp for it. That was not true until
# 0.99.95: cn_image refused such a rectangle outright and img fell back to
# half-block cells, so neither mode had ever been pixels on any terminal
# (Gitea #117). A pane's own edge still refuses, which is why nothing here
# draws the wallpaper through one.
#
# Cached on the image, the mode and the screen size together, since this
# runs every frame: a frame where none of the three changed reads the last
# answer instead of asking img size -- a full decode with no result but
# two numbers -- again for nothing.
DT_WALLFITFOR=
DT_WALLFITMODE=
DT_WALLFITROWS=
DT_WALLFITCOLS=

dt_wallfit() {
	local sw sh out fitr fitc

	if [ "$DT_WALLMODE" = stretch ]; then
		DT_WALLR=0
		DT_WALLC=0
		DT_WALLH=$DT_ROWS
		DT_WALLW=$DT_COLS
		return 0
	fi
	if [ "$DT_WALLFITFOR" = "$DT_WALLIMG" ] &&
	   [ "$DT_WALLFITMODE" = "$DT_WALLMODE" ] &&
	   [ "$DT_WALLFITROWS" = "$DT_ROWS" ] &&
	   [ "$DT_WALLFITCOLS" = "$DT_COLS" ]; then
		return 0
	fi
	DT_WALLR=0
	DT_WALLC=0
	DT_WALLH=$DT_ROWS
	DT_WALLW=$DT_COLS
	out := img size "$DT_WALLIMG"
	if [ -n "$out" ]; then
		sw=${out% *}
		sh=${out#* }
		if [ "$sw" -gt 0 ] && [ "$sh" -gt 0 ]; then
			if [ "$DT_WALLMODE" = center ]; then
				fitc=$sw
				fitr=$((sh / 2))
			else
				fitc=$DT_COLS
				fitr=$((fitc * sh / (2 * sw)))
				if [ "$DT_WALLMODE" = scale ] &&
				   [ "$fitr" -gt "$DT_ROWS" ]; then
					fitr=$DT_ROWS
					fitc=$((fitr * 2 * sw / sh))
				elif [ "$DT_WALLMODE" = zoom ] &&
				     [ "$fitr" -lt "$DT_ROWS" ]; then
					fitr=$DT_ROWS
					fitc=$((fitr * 2 * sw / sh))
				fi
			fi
			[ "$fitc" -lt 1 ] && fitc=1
			[ "$fitr" -lt 1 ] && fitr=1
			DT_WALLH=$fitr
			DT_WALLW=$fitc
			DT_WALLR=$(((DT_ROWS - fitr) / 2))
			DT_WALLC=$(((DT_COLS - fitc) / 2))
		fi
	fi
	DT_WALLFITFOR=$DT_WALLIMG
	DT_WALLFITMODE=$DT_WALLMODE
	DT_WALLFITROWS=$DT_ROWS
	DT_WALLFITCOLS=$DT_COLS
}

# Everything that decides what the wallpaper's own cells should hold: what
# it paints, and everything that gets drawn on top of it and can go away
# again -- when one does, those cells are the wallpaper's once more and have
# to be painted back. The windows are in it through dt_alone's own
# signature, which carries every window's rectangle and the look.
fn dt_wallsig() {
	local s

	s="$DT_WALLIMG|$DT_WALLMODE|$DT_IMGMODE|$DT_GLYPH|$DT_WALL|$DT_DOT"
	# The displays too: the wallpaper, the bar and the icons are confined
	# to the primary one, so a display joining or leaving, or the primary
	# moving between them, changes every cell of it.
	s="$s|$DT_ICONS|$DI_SCANT|$DT_ROWS|$DT_COLS|$DT_WS|$DT_MIRRORON"
	s="$s|$DT_PRIMARY_COL|$DT_PRIMARY_W"
	s="$s|$MB_OPEN|$MB_CTXWHO|$DT_DND|$DT_DNDR|$DT_DNDN|$DT_DNDG"
	s="$s|${#DT_NOTEQ_ORDER[@]}|$DT_IDNAME|$DT_BLANK|${#DT_BLANKR[@]}"
	s="$s|$DT_CONFIRM|$DT_SHOT|$DT_SAVING|$DT_LOCKED"
	s="$s|$CS_COLLAPSED|$CS_SIDEX|$CS_SCROLL|${#CS_MOD_LIST[@]}"
	s="$s|$DT_ALONEFOR"
	ret "$s"
}

# A picture drawn under the text is kept only while its caller places it again,
# so the frame that stops placing it is the frame it goes -- and a wallpaper
# that is only being left alone would vanish and come back a second later,
# taking every shadow cast on the cells it covers with it (Gitea #112). So a
# frame that paints nothing still says the picture is wanted.
#
# `img keep`, never `img draw`: draw falls back to half blocks whenever pixels
# cannot be placed -- which is every `center` and `zoom` wallpaper, since the
# rectangle those fit lies partly off the screen and the display refuses it
# (Gitea #117) -- and those blocks are cells written at absolute coordinates,
# which on this path, outside `console behind on`, would land on top of every
# window and stay there until something else made them dirty. keep draws
# nothing whatever happens, and fails when there was nothing to keep.
fn dt_wallkeep() {
	[ -n "$DT_WALLIMG" ] || return 0
	dt_has img || return 0
	dt_imgwill || return 0
	dt_imgm
	img keep "$DT_WALLIMG" "$DT_WALLR" "$DT_WALLC" "$DT_WALLH" \
		"$DT_WALLW" "${DT_IMGARG[@]}" || return 0
	return 0
}

# Paint the wallpaper.  The bar is drawn afterwards, over the windows, so a
# drop-down menu covers them.
dt_wall() {
	local drawn= sig ms

	# The icons' own rescan, and the frame it asks for, happen whether or
	# not anything is painted: inside the gate below they would stop the
	# first time the wallpaper was left alone, and a mounted disk would
	# never appear again while Control Panel still said Icons were on.
	if [ "$DT_ICONS" = 1 ]; then
		[ $((EPOCHSECONDS - DI_SCANT)) -ge 5 ] && dt_deskscan
		dt_want 5000
	fi
	# Nothing it paints has changed, and nothing drawn over it has gone:
	# its cells are still on the screen, because every window paints
	# inside its own rectangle and this paints behind them. Painted at
	# least once a second regardless, so anything the signature does not
	# know about cannot be seen for longer than that.
	sig := dt_wallsig
	ms := dt_ms
	if [ "$sig" = "$DT_WALLFOR" ] && [ "$DT_FORCEDRAW" != 1 ] &&
	   [ -n "$DT_NOOVERLAP" ] &&
	   [ -z "$DT_FORCEONCE" ] && [ $((ms - DT_WALLMS)) -lt 1000 ]; then
		dt_wallkeep
		return 0
	fi
	DT_WALLFOR=$sig
	DT_WALLMS=$ms

	# Paint around the windows, not over them. Nothing visible changes --
	# every window is drawn after this and covers its own cells anyway --
	# but it is what lets a window nobody redrew be left alone, and it
	# reaches the picture too, since the img module draws through the same
	# put. The cells a window used to cover are outside every pane the
	# moment it moves, so they are repainted here with no damage to track;
	# and a note or a menu that has gone had its cells outside the windows
	# as well.
	console behind on
	if [ -n "$DT_WALLIMG" ]; then
		if ! dt_has img && [ -z "$DT_WALLTRIED" ]; then
			DT_WALLTRIED=1
			need img
		fi
		if dt_has img; then
			dt_wallfit
			case $DT_WALLMODE in
			scale | center)
				console pen "$DT_DOT" "$DT_WALL"
				console fill 0 0 "$DT_ROWS" "$DT_COLS" "$DT_GLYPH"
				;;
			esac
			# Where a picture of real pixels is going, the cells it
			# covers are blanked with no colours of their own
			# first: a bitmap writes no cells, so last frame's
			# text would otherwise stay on top of it -- and a cell
			# with a background colour paints over a picture the
			# terminal is compositing below the text, which is how
			# a kitty wallpaper would be invisible under the very
			# fill that used to stand in for it.
			if dt_imgwill; then
				console pen default default
				console fill "$DT_WALLR" "$DT_WALLC" \
					"$DT_WALLH" "$DT_WALLW" " "
			fi
			dt_imgm
			# -u: text is drawn over the wallpaper in this same
			# frame -- the bar, every window, the icons -- and a
			# picture that owns its cells would be dropped before
			# it was ever sent (ADR 0037, Gitea #104).
			img draw "$DT_WALLIMG" "$DT_WALLR" "$DT_WALLC" \
				"$DT_WALLH" "$DT_WALLW" "${DT_IMGARG[@]}" -u \
				&& drawn=1
		fi
	fi
	if [ -z "$drawn" ]; then
		console pen "$DT_DOT" "$DT_WALL"
		console fill 0 0 "$DT_ROWS" "$DT_COLS" "$DT_GLYPH"
	fi
	# The icons are the desktop's too, and a window covers them whether
	# they were painted under it or skipped, so this stays inside the
	# behind-the-panes mode. Its rescan is above, outside the gate.
	[ "$DT_ICONS" = 1 ] && dt_icondraw
	console behind off
}

# Right-click on the bare desktop.
DT_WALLGLYPHS=("·" "░" "▒" "⋅" "+")

# What the wallpaper was last painted for, and when. It used to say whether
# this frame painted it as well (DT_WALLDREW), which the Control Strip read
# to know its own cells had been painted over; the strip draws on every
# frame since 0.99.97 and nothing else ever read it, so it is gone.
DT_WALLFOR=
DT_WALLMS=0

dt_wallnext() {
	local i=0 g

	for g in "${DT_WALLGLYPHS[@]}"; do
		i=$((i + 1))
		[ "$g" = "$DT_GLYPH" ] && break
	done
	DT_GLYPH=${DT_WALLGLYPHS[$((i % ${#DT_WALLGLYPHS[@]}))]}
	dt_save
}
