# wm/menus -- menus: an app declaring them, the desktop drawing them, and
# the keyboard and mouse moving through them.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# System 7's, as closely as a text console allows: the hibr menu on the left
# where the apple went, then the active application's own menus, then the
# clock and the application menu on the right.  The menus belong to whatever
# has focus, so they change when you click a different window, and when
# nothing has focus they are the desktop's own.
#
# An app declares them by providing <app>_menus, which calls dt_menu, dt_item
# and dt_sep -- the same shape as `opt` declaring a command line, and the
# same prefix contract as _draw and _key: an app with no _menus simply has
# none, and the bar shows the desktop's.
#
# Edit is the desktop's, and comes after the app's menus unless the app
# calls dt_editmenu itself -- which an app with a File menu does right after
# it, for System 7's File, Edit, then the rest.
#
# F10 or escape opens the bar; then the arrows move, a letter picks the item
# beside it, enter chooses and escape closes.  Nothing is reserved while the
# bar is shut, which is what keeps ctrl-c free for whatever runs in a window.

declare -A MB
declare -A MI
declare -A DT_APPS
MB_N=0
MB_OPEN=-1
MB_SEL=0
MB_APP=
MB_CUR=
MB_EDITED=0
MB_STACK=
MB_PAR=
MB_IN=0
MB_AX=0
MB_AN=

# A menu that opened at the pointer rather than under its bar title: MB_CX
# and MB_CY are where it goes instead, MB_CTXWHO is what to ask for its
# items every frame it stays open (an app prefix, or "desktop" for the hibr
# menu itself), MB_CTXID the window it belongs to, if any.
MB_CX=
MB_CY=
MB_CTXWHO=
MB_CTXID=

# Start a menu.  Called from an app's <app>_menus.
fn dt_menu(title) {
	MB[$MB_N]["title"]="$title"
	MB[$MB_N]["n"]=0
	MB[$MB_N]["w"]=0
	MB[$MB_N]["bar"]=1
	MB[$MB_N]["own"]=
	MB_CUR=$MB_N
	MB_N=$((MB_N + 1))
}

# Add an item to the menu being declared: label, key, then the command.
# An empty key means the item has no letter and is reached with the arrows.
dt_item() {
	dt_row "" 0 "$@"
}

# The same, with a tick beside it when the third argument is not 0.
fn dt_mark(lb, k, int on, ...rest) {
	shift 3
	if [ "$on" = 0 ] || [ -z "$on" ]; then
		dt_row " " 0 "$lb" "$k" "$@"
	else
		dt_row "${GL[check]}" 0 "$lb" "$k" "$@"
	fi
}

# An item that is there but cannot be chosen, which is how a menu says a
# thing exists and is not available now -- quieter than hiding it, and it
# keeps the menu the same shape from one moment to the next.
fn dt_dim(label) {
	dt_row "" 1 "$label" "" :
}

# Start a submenu.  Items until dt_end belong to it.
#
# The parent is MB_CUR -- the menu being declared -- and not the last menu
# created, which after one dt_end is the submenu that just closed. Getting
# that wrong hangs the second submenu off the first, and it looks almost
# right until you notice a menu item has gone missing.
fn dt_sub(label) {
	local p=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$p]["n"]}
	dt_menu "$label"
	MB[$((MB_N - 1))]["bar"]=0
	MI[$p][$n]["label"]="$label"
	MI[$p][$n]["key"]=""
	MI[$p][$n]["cmd"]=""
	MI[$p][$n]["argc"]=0
	MI[$p][$n]["sep"]=0
	MI[$p][$n]["dim"]=0
	MI[$p][$n]["tick"]=""
	MI[$p][$n]["sub"]=$((MB_N - 1))
	MB[$p]["n"]=$((n + 1))
	dt_wide "$p" $((${#1} + 8))
	MB_STACK="$p $MB_STACK"
}

# Finish a submenu and go back to the menu that owns it.
dt_end() {
	MB_CUR=${MB_STACK%% *}
	MB_STACK=${MB_STACK#* }
}

# Remember the widest label a menu has to fit.
fn dt_wide(int m, int w) {
	[ "$w" -gt "${MB[$m]["w"]}" ] && MB[$m]["w"]=$w
}

# One row of a menu.  Everything above goes through here.  The command is
# kept as its own words, a0..aN-1, not one joined string run split: a
# dropdown's value is often a label with a space in it ("2:05 PM"), and
# split it reached its callback as two arguments, the second one lost.
# An empty word is still dropped, as splitting always dropped it: the
# Control Strip's dropdowns pass an empty window id and rely on it never
# reaching their callback.
fn dt_row(tick, int dim, lb, k, ...rest) {
	local m n i=0 a

	shift 4
	m=${MB_CUR:-$((MB_N - 1))}
	n=${MB[$m]["n"]}
	MI[$m][$n]["label"]="$lb"
	MI[$m][$n]["key"]="$k"
	MI[$m][$n]["cmd"]="$*"
	for a in "$@"; do
		[ -z "$a" ] && continue
		MI[$m][$n]["a$i"]=$a
		i=$((i + 1))
	done
	MI[$m][$n]["argc"]=$i
	MI[$m][$n]["sep"]=0
	MI[$m][$n]["dim"]="$dim"
	MI[$m][$n]["tick"]="$tick"
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
	dt_wide "$m" $((${#lb} + 8))
}

# Add a dividing line.
dt_sep() {
	local m=${MB_CUR:-$((MB_N - 1))} n

	n=${MB[$m]["n"]}
	MI[$m][$n]["sep"]=1
	MI[$m][$n]["label"]=
	MI[$m][$n]["key"]=
	MI[$m][$n]["cmd"]=
	MI[$m][$n]["argc"]=0
	MI[$m][$n]["dim"]=0
	MI[$m][$n]["tick"]=""
	MI[$m][$n]["sub"]=
	MB[$m]["n"]=$((n + 1))
}

# Rebuild the bar for whatever has focus.  Cheap enough to do every frame:
# it is a handful of assignments, and it has to follow the focus anyway.
dt_menus() {
	local who=${DT_FOCUS:-} ap=

	[ -n "$who" ] && ap=${DT[$who]["app"]}
	MB_N=0

	dt_menu "✎"
	if [ -n "$ap" ] && dt_aboutinfo "$ap"; then
		dt_item "About ${DT_ABOUT["$ap"]["title"]}${GL[ellipsis]}" a dt_aboutapp "$ap"
		dt_item "About hibr Desktop" h dt_about
	else
		dt_item "About hibr Desktop" a dt_about
	fi
	dt_sep
	# about already has its own permanent item above; it registers with
	# dt_app only so dt_launch about can find it, not to be listed a
	# second time as an ordinary app -- its own dt_app call marks it
	# hidden, which is what dt_appmenu actually skips.
	dt_appmenu "" aqdur
	dt_sep
	dt_item "Screen Saver" s dt_saverstart
	dt_item "Lock Screen" l dt_lock
	dt_sep
	dt_item "Restart Desktop" r dt_restart
	if [ -n "$HIBR_HOLD" ]; then
		dt_item "Detach" d dt_detach
	else
		dt_dim "Detach"
	fi
	dt_item "Quit" q dt_quit

	# The bar's app name follows focus regardless of whether the app has
	# menus of its own to add -- Clock and About have none, and still have
	# a name.  A window with no registered app (a bare dt_new) has no name
	# to show either, so this still falls back to Desktop for it.
	MB_APP=$ap
	MB_EDITED=0
	if [ -n "$ap" ] && dt_has "${ap}_menus"; then
		local m0=$MB_N
		${ap}_menus
		while [ "$m0" -lt "$MB_N" ]; do
			MB[$m0]["own"]=$DT_FOCUS
			m0=$((m0 + 1))
		done
	fi
	[ -z "$who" ] && dt_findermenus
	[ "$MB_EDITED" = 1 ] || dt_editmenu

	# Always last, and always there: an app that has its own menus must
	# not be able to hide the only way to move or close its window.
	dt_menu "Window"
	if [ -z "$DT_FOCUS" ]; then
		dt_dim "Move"
		dt_dim "Resize"
		dt_dim "Zoom"
		dt_dim "Snap"
		dt_dim "Hide"
		dt_sep
		dt_dim "Close"
	else
		dt_item "Move" m dt_grab move
		if [ "${DT_APPS[${DT[$DT_FOCUS]["app"]}]["fixed"]}" = 1 ]; then
			dt_dim "Resize"
			dt_dim "Zoom"
		else
			dt_item "Resize" r dt_grab size
			dt_item "Zoom" z dt_zoom_focused
		fi
		dt_sub "Snap"
		dt_item "Left" l dt_snap_focused left
		dt_item "Right" r dt_snap_focused right
		dt_item "Top" t dt_snap_focused top
		dt_item "Bottom" b dt_snap_focused bottom
		dt_item "Center" c dt_snap_focused center
		dt_end
		if [ "$DT_WSN" -gt 1 ]; then
			local wsi=1
			dt_sub "Move to Workspace"
			while [ "$wsi" -le "$DT_WSN" ]; do
				if [ "$wsi" = "$DT_WS" ]; then
					dt_dim "Workspace $wsi"
				else
					dt_item "Workspace $wsi" "$wsi" \
						dt_wsmove_focused "$wsi"
				fi
				wsi=$((wsi + 1))
			done
			dt_end
		fi
		dt_item "Hide" h dt_hide_focused
		if [ "${DT[$DT_FOCUS]["app"]}" = term ] && [ "$DT_TERMKEEP" = 1 ] &&
		   dt_has term_passall; then
			dt_mark "Pass Every Key" p "${TW[$DT_FOCUS]["passall"]:-0}" \
				term_passall "$DT_FOCUS"
		fi
		dt_sep
		dt_item "Close" w dt_close_focused
	fi
	dt_sep
	local tv=0
	dt_tiled "$DT_WS" && tv=1
	dt_mark "Tile Workspace" i "$tv" dt_tiletoggle
	if [ -n "$DT_FOCUS" ] && dt_intile "$DT_FOCUS"; then
		dt_item "Make Main" a dt_tilemain
	else
		dt_dim "Make Main"
	fi
	dt_item "Cycle" c dt_cycle
	dt_layout
}

# The desktop's own menus when nothing is focused -- the Finder's, as on
# System 7: File, Edit, View and Special, the icons on the desktop being
# what they act on.
dt_findermenus() {
	local sel

	dt_menu "File"
	dt_item "New Window" n dt_launch files
	if sel := dt_iconsel; then
		dt_item "Open" o dt_iconopenall
	else
		dt_dim "Open"
	fi
	if dt_has files_search; then
		dt_item "Find${GL[ellipsis]}" f dt_finderfind
	else
		dt_dim "Find${GL[ellipsis]}"
	fi
	dt_sep
	dt_dim "Close Window"
	dt_editmenu
	dt_menu "View"
	dt_mark "Desktop Icons" i "${DT_ICONS:-0}" dt_iconsflip
	dt_item "Refresh" r dt_refresh
	dt_menu "Special"
	dt_item "Clean Up Desktop" u dt_iconclean
	if dt_trashcount && [ "$DT_TRASHN" -gt 0 ]; then
		dt_item "Empty Trash${GL[ellipsis]}" t dt_trashask
	else
		dt_dim "Empty Trash${GL[ellipsis]}"
	fi
}

# File > Open: every icon chosen, opened as a double click would.
dt_iconopenall() {
	local sel i
	local -a is

	sel := dt_iconsel || return 0
	read -ra is <<< "$sel"
	for i in "${is[@]}"; do
		dt_iconopen "$i"
	done
	return 0
}

# File > Find: a Files window at Home, searching.
dt_finderfind() {
	local id

	id := dt_launch files || return 0
	dt_has files_search && files_search "$id"
	return 0
}

# View > Desktop Icons.
dt_iconsflip() {
	if [ "${DT_ICONS:-0}" = 1 ]; then DT_ICONS=0; else DT_ICONS=1; fi
	dt_save
}

# How many things are in the trash, into DT_TRASHN.
DT_TRASHN=0
dt_trashcount() {
	local f
	local -a fs

	DT_TRASHN=0
	[ -d "$DT_TRASH/files" ] || return 0
	fs=("$DT_TRASH/files"/* "$DT_TRASH/files"/.[!.]*)
	for f in "${fs[@]}"; do
		[ -e "$f" ] || [ -L "$f" ] && DT_TRASHN=$((DT_TRASHN + 1))
	done
	return 0
}

# Special > Empty Trash: asked first, since nothing comes back from it.
dt_trashask() {
	dt_trashcount
	if [ "$DT_TRASHN" = 1 ]; then
		dt_confirm "Empty the Trash? The one item in it is deleted for good." dt_trashempty
	else
		dt_confirm "Empty the Trash? The $DT_TRASHN items in it are deleted for good." dt_trashempty
	fi
}
dt_trashempty() {
	local n

	[ -n "$DT_TRASH" ] && [ -d "$DT_TRASH/files" ] || return 0
	dt_trashcount
	n=$DT_TRASHN
	command rm -rf -- "$DT_TRASH/files" "$DT_TRASH/info" 2>> "$DT_LOG"
	mkdir -p "$DT_TRASH/files" "$DT_TRASH/info" 2> /dev/null
	dt_changed
	if [ "$n" = 1 ]; then dt_notep low "The Trash is empty: 1 item deleted"; else dt_notep low "The Trash is empty: $n items deleted"; fi
}

# What an About box says about an app, from the file that declared it:
# DT_ABOUT[app]["title"], ["desc"], ["file"], ["icon"]. A hidden app -- an
# editor, a dialog -- answers for the app its file belongs to, so the
# Calendar's event editor is About Calendar. Read once, on first need;
# fails for a window with no app file to read.
declare -gA DT_ABOUT
fn dt_aboutinfo(ap) {
	local f l own desc=

	[ -n "${DT_ABOUT["$ap"]["title"]+x}" ] && { [ -n "${DT_ABOUT["$ap"]["title"]}" ]; return; }
	DT_ABOUT["$ap"]["title"]=
	f=$(grep -rl --include='*.hibr' -e "dt_app $ap " "${DT_APPDIRS[@]}" 2> /dev/null | head -n 1)
	[ -n "$f" ] || return 1
	own=$ap
	if l=$(grep -m 1 '^app ' "$f"); then
		l=${l#app }
		own=${l%% *}
		desc=${l#"$own"}
		desc=${desc# }
		desc=${desc#\"}
		desc=${desc%\"}
	fi
	[ -n "${DT_APPS["$own"]["title"]+x}" ] || own=$ap
	DT_ABOUT["$ap"]["title"]=${DT_APPS["$own"]["title"]:-$ap}
	DT_ABOUT["$ap"]["icon"]=${DT_APPS["$own"]["icon"]}
	DT_ABOUT["$ap"]["desc"]=$desc
	DT_ABOUT["$ap"]["file"]=$f
	DT_ABOUT["$ap"]["own"]=$own
	return 0
}

# About <App>: the app's own, when it has <app>_about, or the desktop's
# card made from what the app declares.
fn dt_aboutapp(ap) {
	local own id h=10 w=56

	dt_aboutinfo "$ap" || return 0
	own=${DT_ABOUT["$ap"]["own"]:-$ap}
	if dt_has "${own}_about"; then
		"${own}_about"
		return 0
	fi
	id := dt_new "About ${DT_ABOUT["$ap"]["title"]}" "$h" "$w" $(((DT_ROWS - h) / 2)) $(((DT_COLS - w) / 2)) dtabout
	DTAB[$id]["app"]=$ap
	return 0
}

# The desktop's About card: icon and name, what the app says it is, where
# it came from, and the shell it runs on.
declare -gA DTAB
fn dtabout_draw(int id, int h, int w, int row, int col) {
	local ap=${DTAB[$id]["app"]} t d f line r=4
	local -a words

	dt_wclear "$id"
	t=${DT_ABOUT["$ap"]["title"]}
	d=${DT_ABOUT["$ap"]["desc"]}
	f=${DT_ABOUT["$ap"]["file"]}
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	console put -p "w$id" 1 2 "${DT_ABOUT["$ap"]["icon"]}  $t"
	console pen "$DT_INK" "$DT_FACE"
	read -ra words <<< "$d"
	line=
	for t in "${words[@]}"; do
		if [ $((${#line} + ${#t} + 1)) -gt $((w - 4)) ]; then
			console put -p "w$id" 2 2 "$line"
			line=$t
			r=3
			continue
		fi
		line="${line:+$line }$t"
	done
	console put -p "w$id" $((r - 1)) 2 "$line"
	console pen "$DT_DIM" "$DT_FACE"
	f=${f/#$HOME/\~}
	console put -p "w$id" "$r" 2 "${f:0:$((w - 4))}"
	console put -p "w$id" $((r + 1)) 2 "hibr $HIBR_VERSION"
	dt_dlgbtns "$id" "$h" "$w" ok ok OK
}
fn dtabout_key(int id, key) {
	case $key in
	enter | escape | " ") dt_del "$id" ;;
	*) return 1 ;;
	esac
	return 0
}
fn dtabout_click(int? id = "", int? r = "", int? c = "", btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c" || return 0
	[ "$tag" = ok ] && dt_del "$id"
	return 0
}
fn dtabout_close(int id) {
	unset DTAB["$id"]
	return 0
}

# Edit is the desktop's, like Window: the same three items everywhere,
# dimmed where the focused app cannot do them, so it never changes shape,
# each showing the key it is set to now. Once a bar: an app that placed it
# after its File menu has it there and nowhere else.
dt_editmenu() {
	local who=${DT_FOCUS:-} lc lt lp lu lr

	[ "$MB_EDITED" = 1 ] && return 0
	MB_EDITED=1
	dt_menu "Edit"
	printf -v lu '%-11s%s' Undo "${DT_KEYS["undo"]}"
	printf -v lr '%-11s%s' Redo "${DT_KEYS["redo"]}"
	if [ -n "$who" ] && [ -n "${DT[$who]["undo"]}" ]; then
		dt_item "$lu" u dt_editdo undo
	else
		dt_dim "$lu"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["redo"]}" ]; then
		dt_item "$lr" r dt_editdo redo
	else
		dt_dim "$lr"
	fi
	dt_sep
	printf -v lc '%-11s%s' Copy "${DT_KEYS["copy"]}"
	printf -v lt '%-11s%s' Cut "${DT_KEYS["cut"]}"
	printf -v lp '%-11s%s' Paste "${DT_KEYS["paste"]}"
	if [ -n "$who" ] && [ -n "${DT[$who]["copy"]}" ]; then
		dt_item "$lc" c dt_edit copy
	else
		dt_dim "$lc"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["cut"]}" ]; then
		dt_item "$lt" t dt_edit cut
	else
		dt_dim "$lt"
	fi
	if [ -n "$who" ] && [ -n "${DT[$who]["paste"]}" ] &&
	   [ -n "$DT_CLIP" ]; then
		dt_item "$lp" v dt_edit paste
	else
		dt_dim "$lp"
	fi
	dt_sep
	if [ -n "$who" ] && [ -n "${DT[$who]["selall"]}" ]; then
		dt_item "Select All" a dt_editdo selall
	else
		dt_dim "Select All"
	fi
}

# Undo, Redo or Select All in the focused window, through its own _undo,
# _redo or _selall; nothing for a window that has none.
fn dt_editdo(op) {
	local cb

	[ -n "$DT_FOCUS" ] || return 0
	cb=${DT[$DT_FOCUS]["$op"]}
	if [ -z "$cb" ]; then
		dt_notep low "${DT[$DT_FOCUS]["title"]} cannot $op"
		return 0
	fi
	DT_NOTEWIN=$DT_FOCUS
	$cb "$DT_FOCUS" || dt_notep low "Nothing to $op"
	return 0
}

# Pick an accelerator for a label that nothing else in the menu has taken.
# Calculator and Clock both start with a C, and a menu where two items
# answer to the same letter is a menu where one of them cannot be reached.
fn dt_akey(t, used) {
	local i=0 c

	while [ "$i" -lt ${#t} ]; do
		c=${t:$i:1}
		c := str lower "$c"
		case $c in
		[a-z])
			case $used in
			*"$c"*) ;;
			*) ret "$c"; return 0 ;;
			esac
			;;
		esac
		i=$((i + 1))
	done
	for c in 1 2 3 4 5 6 7 8 9; do
		case $used in
		*"$c"*) ;;
		*) ret "$c"; return 0 ;;
		esac
	done
	ret ""
}

# Where a single-character accelerator sits in a label, case-insensitive
# -- -1 when it is not one character, or is not actually in the label at
# all, which is true of a shortcut an app author picked to mean
# something rather than to spell part of the word ("x" for "End Task").
# dt_menu_draw underlines the letter in place when this finds one, and
# falls back to showing the key after the label, the way every item
# used to, when it does not.
fn dt_akeypos(lb, k) {
	local i=0 c lk

	if [ "${#k}" != 1 ]; then
		ret -1
		return 0
	fi
	lk := str lower "$k"
	while [ "$i" -lt "${#lb}" ]; do
		c := str lower "${lb:$i:1}"
		[ "$c" = "$lk" ] && { ret "$i"; return 0; }
		i=$((i + 1))
	done
	ret -1
}

# Work out where each title sits on the bar.
dt_layout() {
	local i=0 c=$((DT_PRIMARY_COL + 1)) t

	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			MB[$i]["x"]=0
			MB[$i]["tw"]=0
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		MB[$i]["x"]=$c
		MB[$i]["tw"]=$((${#t} + 2))
		c=$((c + ${#t} + 2))
		i=$((i + 1))
	done
	MB_AX=$((DT_PRIMARY_COL + ${DT_PRIMARY_W:-$DT_COLS} - 14))
}

# Draw the open menu over everything else.
dt_drop() {
	local m=$MB_OPEN

	[ "$m" = -1 ] && return 0
	if [ "$m" = app ]; then
		dt_drop_apps
		return 0
	fi
	if [ -n "$MB_PAR" ]; then
		dt_menu_draw "$MB_PAR" "" 1
		dt_menu_draw "$m" "${MB[$m]["px"]}" 0
	else
		dt_menu_draw "$m" "" 0
	fi
}

# Draw one menu at its own place.  A submenu is given the column its parent
# occupies so it can sit beside it rather than on top of it.
fn dt_menu_draw(int m, int? px, int parent) {
	local i=0 r=1 x w n lb k t sub rowfg rowbg rowbold pos full pre hl post

	x=${MB[$m]["x"]}
	w=${MB[$m]["w"]}
	n=${MB[$m]["n"]}
	[ "$w" -lt 14 ] && w=14
	if [ -n "$px" ]; then
		x=$px
		r=${MB[$m]["py"]:-1}
	elif [ -n "$MB_CX" ]; then
		x=$MB_CX
		r=${MB_CY:-1}
	fi
	[ "$x" -lt 0 ] && x=0
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	[ $((r + n + 1)) -gt "$DT_ROWS" ] && r=$((DT_ROWS - n - 1))
	[ "$r" -lt 1 ] && r=1
	MB[$m]["dy"]=$r
	MB[$m]["dx"]=$x
	MB[$m]["dw"]=$w
	[ "$DT_MSHADOW" = 1 ] &&
		console darken $((r + 1)) $((x + 2)) $((n + 1)) "$w" "$DT_SHADOW_PCT"
	while [ "$i" -lt "$n" ]; do
		if [ "${MI[$m][$i]["sep"]}" = 1 ]; then
			console pen "$DT_IDLE" "$DT_FACE"
			lb := dt_rep "$w" "${GL[hline]}"
			console put "$r" "$x" "$lb"
			r=$((r + 1))
			i=$((i + 1))
			continue
		fi
		if [ "$parent" != 1 ] && [ "$i" = "$MB_SEL" ]; then
			rowfg=$DT_FACE; rowbg=$DT_ACTIVE; rowbold=1
		elif [ "${MI[$m][$i]["dim"]}" = 1 ]; then
			rowfg=$DT_IDLE; rowbg=$DT_FACE; rowbold=0
		else
			rowfg=$DT_INK; rowbg=$DT_FACE; rowbold=0
		fi
		if [ "$rowbold" = 1 ]; then
			console pen "$rowfg" "$rowbg" bold
		else
			console pen "$rowfg" "$rowbg"
		fi
		lb=${MI[$m][$i]["label"]}
		k=${MI[$m][$i]["key"]}
		t=${MI[$m][$i]["tick"]}
		sub=${MI[$m][$i]["sub"]}
		if [ -n "$sub" ]; then
			k="${GL[sright]}"
			pos=-1
		else
			pos := dt_akeypos "$lb" "$k"
		fi
		[ -z "$t" ] && t=" "
		if [ "$pos" -ge 0 ]; then
			# The accelerator is a real letter of the label -- underline
			# it in place instead of repeating it after the label, which
			# is what #55 asked for: a trailing "f" for "Files" reads
			# like a second, unexplained shortcut next to the real ones
			# App Shortcuts assigns, not a hint about the letter beside
			# it. "$t " (tick-or-blank, then a space) always precedes
			# the label, so the label's own position shifts by 2.
			pos=$((pos + 2))
			full="$t $lb"
			full := str pad "$full" $((w - 3))
			pre=${full:0:$pos}
			hl=${full:$pos:1}
			post=${full:$((pos + 1))}
			console put "$r" "$x" "$pre"
			if [ "$rowbold" = 1 ]; then
				console pen "$rowfg" "$rowbg" bold underline
			else
				console pen "$rowfg" "$rowbg" underline
			fi
			console put "$r" $((x + pos)) "$hl"
			if [ "$rowbold" = 1 ]; then
				console pen "$rowfg" "$rowbg" bold
			else
				console pen "$rowfg" "$rowbg"
			fi
			console put "$r" $((x + pos + 1)) "$post   "
		else
			# No letter of the label to underline -- a shortcut an app
			# author picked to mean something rather than spell part of
			# the word ("x" for "End Task"), or dt_akey's own digit
			# fallback when a menu ran out of free letters. Shown after
			# the label, as every item's always been.
			lb := str pad "$t $lb" $((w - 3))
			console put "$r" "$x" "$lb $k "
		fi
		r=$((r + 1))
		i=$((i + 1))
	done
	console pen "$DT_INK" "$DT_FACE"
	lb := dt_rep "$w" " "
	console put "$r" "$x" "$lb"
}

# The application menu: every window, the hidden ones marked, and one on
# another workspace marked with that workspace's number -- choosing it
# switches there.
dt_drop_apps() {
	local ids id i=0 r=1 x w=18 t mark n il

	ids := dt_ids
	read -ra il <<< "$ids"
	x=$((MB_AX - 4))
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	n=${#il[@]}
	[ "$n" = 0 ] && n=1
	[ "$DT_MSHADOW" = 1 ] &&
		console darken $((r + 1)) $((x + 2)) $((n + 1)) "$w" "$DT_SHADOW_PCT"
	for id in "${il[@]}"; do
		if [ "$i" = "$MB_SEL" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		mark=" "
		[ "$id" = "$DT_FOCUS" ] && mark="${GL[bullet]}"
		dt_hidden "$id" && mark="${GL[dot]}"
		dt_away "$id" && mark=${DT[$id]["ws"]}
		t := dt_title "$id"
		t := str pad "$mark ${t}" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
		i=$((i + 1))
	done
	if [ "$i" = 0 ]; then
		console pen "$DT_IDLE" "$DT_FACE"
		t := str pad " no windows" "$w"
		console put "$r" "$x" "$t"
		r=$((r + 1))
	fi
	console pen "$DT_INK" "$DT_FACE"
	t := dt_rep "$w" " "
	console put "$r" "$x" "$t"
	MB_AN=$i
}

# How many rows the open menu occupies, and how many items it holds.
dt_mrows() {
	if [ "$MB_OPEN" = app ]; then
		ret "${MB_AN:-0}"
	else
		ret "${MB[$MB_OPEN]["n"]}"
	fi
}

# Move the highlight, stepping over separators.
fn dt_mmove(int d) {
	local n i=$MB_SEL k=0

	n := dt_mrows
	[ "$n" = 0 ] && return 0
	while [ "$k" -lt "$n" ]; do
		i=$(((i + d + n) % n))
		[ "$MB_OPEN" = app ] && break
		[ "${MI[$MB_OPEN][$i]["sep"]}" = 1 ] && { k=$((k + 1)); continue; }
		[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] && { k=$((k + 1)); continue; }
		break
	done
	MB_SEL=$i
}

# Open a menu, closing whatever was open.
fn dt_mopen(m) {
	MB_OPEN=$m
	MB_PAR=
	MB_SEL=0
	MB_CX=
	MB_CY=
	MB_CTXWHO=
	MB_CTXID=
	[ "$m" = app ] && return 0
	[ "${MI[$m][0]["sep"]}" = 1 ] || [ "${MI[$m][0]["dim"]}" = 1 ] &&
		dt_mmove 1
}

dt_mclose() {
	MB_OPEN=-1
	MB_PAR=
	MB_SEL=0
	MB_CX=
	MB_CY=
	MB_CTXWHO=
	MB_CTXID=
}

# Step into the submenu of the highlighted item, if it has one.
#
# A submenu opens level with the row that owns it, not with its parent's own
# top row -- dt_menu_draw's own r starts at 1 and gains exactly one per
# index drawn, separators included, so MB_SEL is already the row offset to
# add, no separate counting needed.
dt_mdown() {
	local sub

	[ "$MB_OPEN" = app ] && return 1
	sub=${MI[$MB_OPEN][$MB_SEL]["sub"]}
	[ -z "$sub" ] && return 1
	MB[$sub]["px"]=$((${MB[$MB_OPEN]["dx"]} + ${MB[$MB_OPEN]["dw"]} - 1))
	MB[$sub]["py"]=$((${MB[$MB_OPEN]["dy"]:-1} + MB_SEL))
	MB_PAR=$MB_OPEN
	MB_OPEN=$sub
	MB_SEL=0
	return 0
}

# Back out of a submenu to the one that owns it.
dt_mup() {
	local p=$MB_PAR i=0 n

	[ -z "$p" ] && return 1
	n=${MB[$p]["n"]}
	while [ "$i" -lt "$n" ]; do
		[ "${MI[$p][$i]["sub"]}" = "$MB_OPEN" ] && MB_SEL=$i
		i=$((i + 1))
	done
	MB_OPEN=$p
	MB_PAR=
	return 0
}

# Choose the highlighted item.
dt_mdo() {
	local m=$MB_OPEN i=$MB_SEL ids id n=0 j=0 argc il
	local -a argv

	if [ "$m" != app ] && [ -n "${MI[$m][$i]["sub"]}" ]; then
		dt_mdown
		return 0
	fi
	dt_mclose
	if [ "$m" = app ]; then
		ids := dt_ids
		read -ra il <<< "$ids"
		for id in "${il[@]}"; do
			[ "$n" = "$i" ] && { dt_raise "$id"; return 0; }
			n=$((n + 1))
		done
		return 0
	fi
	[ "${MI[$m][$i]["sep"]}" = 1 ] && return 0
	[ "${MI[$m][$i]["dim"]}" = 1 ] && return 0
	argc=${MI[$m][$i]["argc"]:-0}
	while [ "$j" -lt "$argc" ]; do
		argv+=("${MI[$m][$i]["a$j"]}")
		j=$((j + 1))
	done
	DT_NOTEWIN=${MB[$m]["own"]}
	[ "$argc" -gt 0 ] && "${argv[@]}"
	DT_NOTEWIN=
}

# Is a click inside the open menu?  Sets the highlight if it is.
fn dt_mpick(int r, int c) {
	local n x w dy rel

	n := dt_mrows
	if [ "$MB_OPEN" = app ]; then
		x=$((MB_AX - 4))
		w=18
		dy=1
	else
		x=${MB[$MB_OPEN]["dx"]:-${MB[$MB_OPEN]["x"]}}
		w=${MB[$MB_OPEN]["w"]}
		[ "$w" -lt 12 ] && w=12
		dy=${MB[$MB_OPEN]["dy"]:-1}
	fi
	rel=$((r - dy + 1))
	[ "$rel" -lt 1 ] || [ "$rel" -gt "$n" ] && return 1
	[ $((x + w)) -gt "$DT_COLS" ] && x=$((DT_COLS - w))
	[ "$c" -lt "$x" ] || [ "$c" -ge $((x + w)) ] && return 1
	[ "$MB_OPEN" != app ] &&
		[ "${MI[$MB_OPEN][$((rel - 1))]["sep"]}" = 1 ] && return 1
	MB_SEL=$((rel - 1))
	return 0
}

# Which menu title is under a column on the bar, if any.
#
# No `ret ""` on a miss: `ret` ends the function on the spot, the same as
# `return`, so a trailing `return 1` after one is dead code and the caller
# always sees status 0 -- `x := dt_mhit ... || ...` never took the miss
# branch, and a click on empty bar space opened whatever `x` was left
# holding from the last hit. `:=` clears the slot before the call, so a
# bare `return 1` alone already leaves it empty.
fn dt_mhit(int c) {
	local i=0 x w

	[ "$c" -ge "$MB_AX" ] && { ret app; return 0; }
	while [ "$i" -lt "$MB_N" ]; do
		x=${MB[$i]["x"]}
		w=${MB[$i]["tw"]}
		[ "$c" -ge "$x" ] && [ "$c" -lt $((x + w)) ] &&
			{ ret "$i"; return 0; }
		i=$((i + 1))
	done
	return 1
}

# The next (dir 1) or previous (dir -1) top-level bar menu from i, skipping
# any submenu index in between. dt_appmenu's own dt_sub calls (a folder of
# apps -- Desk Accessories is the common one) and an app's own _menus both
# interleave submenu entries into the same MB[] array the bar menus
# themselves live in, so "the next index" is not "the next bar menu": with
# Desk Accessories sitting between the hibr menu and Edit, MB_OPEN + 1 on
# the hibr menu landed on it by plain index arithmetic, so right arrow on
# an item with no submenu of its own (About hibr, say) opened Desk
# Accessories instead of moving to Edit. Returns -1 or MB_N when there is
# no further bar menu that way, for the caller to fall back to "app".
fn dt_mbar(int i, int dir) {
	i=$((i + dir))
	while [ "$i" -ge 0 ] && [ "$i" -lt "$MB_N" ] &&
	      [ "${MB[$i]["bar"]}" != 1 ]; do
		i=$((i + dir))
	done
	ret "$i"
}

# Keys while the bar has the keyboard.  Returns 1 for a key it does not use.
fn dt_mkey(k) {
	local n i=0 lb

	case $k in
	escape) dt_mup || dt_mclose; return 0 ;;
	left)
		dt_mup && return 0
		if [ "$MB_OPEN" = app ]; then
			n := dt_mbar "$MB_N" -1
		else
			n := dt_mbar "$MB_OPEN" -1
		fi
		if [ "$n" -ge 0 ]; then
			dt_mopen "$n"
		else
			dt_mopen app
		fi
		return 0
		;;
	right)
		dt_mdown && return 0
		if [ "$MB_OPEN" = app ]; then
			dt_mopen 0
		else
			n := dt_mbar "$MB_OPEN" 1
			if [ "$n" -lt "$MB_N" ]; then
				dt_mopen "$n"
			else
				dt_mopen app
			fi
		fi
		return 0
		;;
	up) dt_mmove -1; return 0 ;;
	down) dt_mmove 1; return 0 ;;
	enter | " ") dt_mdo; return 0 ;;
	esac
	if [ "$MB_OPEN" != app ] && [ ${#k} = 1 ]; then
		n=${MB[$MB_OPEN]["n"]}
		while [ "$i" -lt "$n" ]; do
			[ "${MI[$MB_OPEN][$i]["dim"]}" = 1 ] &&
				{ i=$((i + 1)); continue; }
			if [ -n "${MI[$MB_OPEN][$i]["key"]}" ] &&
			   [ "${MI[$MB_OPEN][$i]["key"]}" = "$k" ]; then
				MB_SEL=$i
				dt_mdo
				return 0
			fi
			i=$((i + 1))
		done
	fi
	return 1
}
