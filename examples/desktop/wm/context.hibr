# wm/context -- menus that open at the pointer: on the desktop, the menu bar
# and a title bar.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Ask for a menu at the pointer rather than under a bar title: who is
# "desktop" for the hibr menu, or an app's prefix for its own <app>_context.
# The menu itself does not exist until the next frame builds it -- dt_mouse
# only records where and for whom, the same lag any other request has.
fn dt_context_open(who, id, int r, int c) {
	MB_CTXWHO=$who
	MB_CTXID=$id
	MB_CY=$r
	MB_CX=$c
	MB_PAR=
	MB_SEL=0
}

# Build or drop the open context menu, once a frame, after dt_menus has
# rebuilt the bar -- an app's own items are no more special than Window's,
# rebuilt fresh every time for the same reason. desktop reuses index 0,
# the hibr menu dt_menus just built, rather than building anything of its
# own.
dt_ctxbuild() {
	local before who=$MB_CTXWHO k

	[ -z "$who" ] && return 0
	case $who in
	desktop) before=$MB_N; dt_deskcontext ;;
	titlebar) before=$MB_N; dt_titlecontext "$MB_CTXID" ;;
	bar) before=$MB_N; dt_barcontext ;;
	widget) before=$MB_N; dt_dropcontext ;;
	*)
		if ! dt_has "${who}_context"; then
			dt_mclose
			return 0
		fi
		before=$MB_N
		"${who}_context" "$MB_CTXID"
		k=$before
		while [ "$k" -lt "$MB_N" ]; do
			MB[$k]["own"]=$MB_CTXID
			k=$((k + 1))
		done
		;;
	esac
	if [ "$MB_N" = "$before" ]; then
		dt_mclose
		return 0
	fi
	# dt_menu always marks what it starts as a bar title, since every other
	# caller is building the bar itself; a context menu is never on it.
	MB[$before]["bar"]=0
	# Only the first frame opens it here -- every one after runs while the
	# menu is already up, possibly down inside a submenu of its own, and
	# resetting MB_OPEN on every rebuild snapped that shut the moment it
	# opened: dt_mdown set it, and the next frame's dt_ctxbuild set it right
	# back.
	[ "$MB_OPEN" = -1 ] && MB_OPEN=$before
}

dt_deskcontext() {
	dt_menu "Desktop"
	dt_item "Arrange Icons" a dt_iconclean
	if dt_has panel_goto; then
		dt_item "Change Wallpaper${GL[ellipsis]}" w dt_panelpane appearance
	else
		dt_dim "Change Wallpaper${GL[ellipsis]}"
	fi
	dt_item "Next Wallpaper" n dt_wallnext
	dt_sep
	dt_item "Refresh Desktop" r dt_refresh
}

# Open the Control Panel at one of its panes, or bring it there if it is
# open already.
fn dt_panelpane(pane) {
	local id

	id := dt_launch panel "$pane" || return 0
	dt_has panel_goto && panel_goto "$id" "$pane"
	return 0
}

# Draw the whole screen again from nothing -- for a terminal something else
# wrote over, or one that never showed what it was sent -- and look again
# at what is on disk, for the desktop's icons and every window of files.
dt_refresh() {
	console reassert
	dt_changed
	dt_notep low "Refreshed"
}

# Right-click on empty menu-bar space: quick launchers, for the two apps
# that also have a keyboard shortcut of their own -- everything else stays
# reachable from the hibr menu only.
dt_barcontext() {
	dt_menu "Desktop"
	if dt_has term_draw; then
		dt_item "New Terminal" t dt_launch term
	else
		dt_dim "New Terminal"
	fi
	if dt_has tasks_draw; then
		dt_item "Task Manager" m dt_launch tasks
	else
		dt_dim "Task Manager"
	fi
}

# Right-click on a window's title bar: the Window menu's own items, since
# that is what a title bar is for, without reaching the menu bar first.
fn dt_titlecontext(int id) {
	local sess lst nm row col rows cols pri

	dt_menu "Window"
	dt_item "Move" m dt_grab move
	if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" = 1 ]; then
		dt_dim "Resize"
		dt_dim "Zoom"
	else
		dt_item "Resize" r dt_grab size
		dt_item "Zoom" z dt_zoom "$id"
	fi
	dt_item "Hide" h dt_min "$id"
	dt_mark "On Every Workspace" e "${DT[$id]["sticky"]:-0}" dt_sticky "$id"
	if [ "$DT_WSN" -gt 1 ]; then
		local wsi=1
		dt_sub "Move to Workspace"
		while [ "$wsi" -le "$DT_WSN" ]; do
			if [ "$wsi" = "${DT[$id]["ws"]:-1}" ]; then
				dt_dim "Workspace $wsi"
			else
				dt_item "Workspace $wsi" "$wsi" dt_wsmove "$id" "$wsi"
			fi
			wsi=$((wsi + 1))
		done
		dt_end
	fi
	# Another display only when there is one: with a single terminal
	# attached the list would hold just the one this window is on.
	if [ -n "$HIBR_HOLD" ] && need hold; then
		sess := dt_holdsess
		lst := hold clients "$sess"
		while [ "${lst%$'\n'}" != "$lst" ]; do lst=${lst%$'\n'}; done
		if [ "${lst//[!$'\n']/}" != "" ]; then
			dt_sub "Move to Display"
			while IFS=' ' read -r nm row col rows cols pri; do
				[ -z "$nm" ] && continue
				dt_item "$nm" "" \
					dt_movewin "$id" "$row" "$col" "$rows" "$cols"
			done <<< "$lst"
			dt_end
		fi
	fi
	dt_sep
	dt_item "Close" w dt_closereq "$id"
}
