#!/usr/bin/env hibr
#
# shadow -- a Control Strip module toggling window shadows, the same
# DT_SHADOW setting Behaviour's own Window Shadow row changes. Its own
# name, not a glyph -- bold in the active colour when on, dimmed when off,
# since a single icon read as nothing in particular to anyone who had not
# already memorised what it meant.

command -v cs_module > /dev/null && cs_module shadow Shadow

shadow_draw() {
	local row=$1 col=$2

	if [ "$DT_SHADOW" = 1 ]; then
		console pen "$DT_ACTIVE" "$DT_FACE" bold
	else
		console pen "$DT_IDLE" "$DT_FACE"
	fi
	console put "$row" "$col" "Shadow"
}

shadow_click() {
	if [ "$DT_SHADOW" = 1 ]; then
		DT_SHADOW=0
	else
		DT_SHADOW=1
	fi
	dt_save
}
