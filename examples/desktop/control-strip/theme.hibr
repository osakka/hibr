#!/usr/bin/env hibr
#
# theme -- a Control Strip module cycling the desktop's own colour theme,
# by its own name rather than a first letter or a swatch -- a click opens
# every theme as a dropdown, reusing Appearance's own cp_theme() and
# CP_THEMES rather than a second copy of the same colour table. If Control
# Panel is not loaded there is nothing to offer, so a click does nothing,
# honestly, rather than switching only some of the colours.

command -v cs_module > /dev/null && cs_module theme Theme

theme_draw() {
	local row=$1 col=$2

	console pen "$DT_INK" "$DT_FACE"
	console put "$row" "$col" "Theme"
}

theme_click() {
	command -v cp_theme > /dev/null || return 0
	command -v cs_dropopen > /dev/null || return 0
	cs_dropopen "$1" "$2" theme_pick "${CP_THEMES[@]}"
}

theme_pick() {
	cp_theme "$1" && dt_save
}
