#!/usr/bin/env hibr
#
# shadow -- a Control Strip module toggling window shadows, the same
# DT_SHADOW setting Behaviour's own Window Shadow row changes.

command -v cs_module > /dev/null && cs_module shadow

shadow_draw() {
	local row=$1 col=$2

	console pen "$DT_INK" "$DT_FACE"
	if [ "$DT_SHADOW" = 1 ]; then
		console put "$row" "$col" "x"
	else
		console put "$row" "$col" " "
	fi
}

shadow_click() {
	if [ "$DT_SHADOW" = 1 ]; then
		DT_SHADOW=0
	else
		DT_SHADOW=1
	fi
	dt_save
}
