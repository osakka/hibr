#!/usr/bin/env hibr
#
# wallpaper -- a Control Strip module cycling the desktop's own wallpaper
# glyph, the same DT_GLYPH setting Appearance's own Wallpaper row changes.
# Its own name, not the glyph itself -- a click opens every glyph as a
# dropdown, each shown as itself, which is its own preview.

command -v cs_module > /dev/null && cs_module wallpaper Wallpaper

WALL_GLYPHS=("·" "░" "▒" "⋅" "+")

wallpaper_draw() {
	local row=$1 col=$2

	console pen "$DT_INK" "$DT_FACE"
	console put "$row" "$col" "Wallpaper"
}

wallpaper_click() {
	command -v cs_dropopen > /dev/null || return 0
	cs_dropopen "$1" "$2" wallpaper_pick "${WALL_GLYPHS[@]}"
}

wallpaper_pick() {
	DT_GLYPH=$1
	DT_WALLIMG=
	dt_save
}
