#!/usr/bin/env hibr
#
# cursor -- a Control Strip module for a new terminal's cursor style, the
# same DT_CURSOR setting Behaviour's own Cursor row changes. Its own name
# rather than a shape or a letter -- a click opens the three styles as a
# dropdown, the same as Behaviour's own Cursor row does from a click on
# its value, so the current style is seen and chosen in the same place.

command -v cs_module > /dev/null && cs_module cursor Cursor

CURSOR_STYLES=(block underline bar)

cursor_draw() {
	local row=$1 col=$2

	console pen "$DT_INK" "$DT_FACE"
	console put "$row" "$col" "Cursor"
}

cursor_click() {
	command -v cs_dropopen > /dev/null || return 0
	cs_dropopen "$1" "$2" cursor_pick "${CURSOR_STYLES[@]}"
}

cursor_pick() {
	DT_CURSOR=$1
	dt_save
}
