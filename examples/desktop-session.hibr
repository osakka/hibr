#!/usr/bin/env hibr
#
# A desktop session -- the third of the three layers in docs/adr/0020.
#
# The console module is the display server, desktop.hibr is the window
# manager, and this file is the part you own: it says which apps load and
# which windows open, the way ~/.xinitrc does.  Copy it, change it, it is
# yours.
#
#     ./build/hibr examples/desktop-session.hibr
#     ./build/hibr examples/desktop-session.hibr --resume
#     ./build/hibr examples/desktop-session.hibr --session work --resume
#
# Drag a title bar to move a window, click _ to minimise, □ to fill the
# screen, x to close.  Tab cycles, escape brings back a minimised window,
# q quits.  ctrl-\ or Detach on the hibr menu leaves it running and gives
# the terminal back; --resume is how you come back to it.  --session names
# which held session this is, "desktop" unless you say otherwise -- for
# more than one, running side by side under different names.

opt .            "hibr's desktop, held so it can always be detached from"
opt -r --resume  resume         "Reattach to it if it is already running"
opt -s --session session str=desktop \
	"Which held session this is, for keeping more than one"
args "$@"

d=${0%/*}
[ "$d" = "$0" ] && d=.
. "$d/desktop.hibr"

# So Detach and ctrl-\ always work: if this is not already a held session
# named $session, restart it as one and attach to it right here.  Without
# --resume, one already running under that name is left alone rather than
# reattached to quietly -- run again with it to come back.  See dt_autohold
# in desktop.hibr for what "always" leaves out.
dt_autohold "$session" "$resume"

# Apps are ordinary hibr files, found in folders: your own
# ~/.config/hibr/apps first, then the ones that come with hibr.  Each file
# declares itself with dt_app -- its title, its window's size, and whether a
# second launch opens another window -- so a script dropped in a folder is
# on the hibr menu at the next start, sorted by title.  A file of yours
# with the same name as a bundled one replaces it.
DT_APPDIRS+=("$d/apps")
dt_apps

# Control Panel panes are the same idea, one level down: each is a plain
# hibr file too, found the same way, loaded once Control Panel itself
# (which defines cp_pane) is on the hibr menu above.
CP_PANEDIRS+=("$d/control-panel")
command -v cp_panes > /dev/null && cp_panes

# Desk accessories are ordinary apps -- Note Pad, Puzzle -- kept in their
# own folder only so the hibr menu groups them under that name.
DA_DIRS+=("$d/desk-accessories")
da_apps

# The Control Strip's own quick-toggle modules -- cs_module is desktop.hibr's
# own, so this needs nothing else on the hibr menu to have loaded first.
CS_MODDIRS+=("$d/control-strip")
cs_modules

FB_DIR=$PWD

# Defaults go before dt_open, which then reads what was saved last time
# over the top of them.
DT_TICK=200

dt_open || exit 1
#dt_new "Files"        10 34  1  2 files
#dt_new "Control Panel" 20 58 10  2 panel
#dt_new "Calculator"   16 24  1 40 calc
dt_run
dt_close
