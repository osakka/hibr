#!/usr/bin/env hibr
#
# A desktop session -- the third of the three layers in docs/adr/0020.
#
# The console module is the display server, desktop.hibr is the window
# manager, and this file is the part you own: it says which apps load and
# which windows open, the way ~/.xinitrc does.  Copy it, change it, it is
# yours.
#
#     ./build/hibr examples/desktop-session.hibr
#
# Drag a title bar to move a window, click _ to minimise, □ to fill the
# screen, x to close.  Tab cycles, escape brings back a minimised window,
# q quits.

d=${0%/*}
[ "$d" = "$0" ] && d=.
. "$d/desktop.hibr"

# Apps are ordinary hibr files.  Each declares itself with `app` and provides
# some of <name>_draw, _key, _click, _wheel, _open and _close; the window
# manager calls only the ones that exist.  Both of these also run on their
# own -- try `hibr examples/apps/calc.hibr '2 ** 16'`.
. "$d/apps/calc.hibr"
. "$d/apps/files.hibr"
. "$d/apps/panel.hibr"
. "$d/apps/term.hibr"

# A clock, small enough to write here.  It only draws, so it can never take
# a key meant for another window.  Nothing opens it: press its name on the
# bar, or add a dt_new line below.
clock_draw() {
	local now

	printf -v now "%(%H:%M:%S)T" -1
	console pen "#68d391" "$DT_FACE" bold
	console put -p "w$1" 2 4 "$now"
	console pen "$DT_INK" "$DT_FACE"
	printf -v now "%(%A %d %B)T" -1
	console put -p "w$1" 4 2 "$now"
}

FB_DIR=$PWD

# What the hibr menu can open.  A session says which apps exist; the window
# manager does not go looking.
dt_app files "Files"      12 34
dt_app calc  "Calculator" 16 24
dt_app panel "Settings"   14 34
dt_app clock "Clock"       7 26
dt_app term  "Terminal"   14 52

dt_open || exit 1
dt_new "Files"      10 34  1  2 files
dt_new "Settings"   12 34 12  2 panel
dt_new "Calculator" 16 24  1 40 calc
DT_TICK=200
dt_run
dt_close
