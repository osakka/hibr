#!/usr/bin/env hibr
#
# catalogue -- install, remove and update what the desktop runs: its
# applications, themes, colour schemes, languages and modules
# (Gitea #159, renamed from `apps` in 0.99.195).
#
#   catalogue list [TEXT]            what the index offers, or what matches TEXT
#   catalogue installed              what is installed here, and from where
#   catalogue info NAME              everything the index says about one
#   catalogue install NAME...        fetch, verify and place
#   catalogue remove NAME...         take one away
#   catalogue update [NAME...]       everything with a newer version, or these
#   catalogue index [URL]            the index this fetches from, or set it
#   catalogue refresh                fetch the index again now
#
# The shape is ADR 0041's, and that record is this program's specification:
# **an app is a folder of plain files, and a bundle is only how it travels.**
# Installing is placing a file where a scan already looks -- every one of the
# desktop's eight scan lists begins with a folder of the person's own and now
# has a data folder after it, so a file you wrote shadows a fetched app of
# the same name and an update cannot overwrite your copy.
#
# Three things about trust, named separately because they protect different
# things and because claiming more than this would be a lie:
#
#   TLS      the identity of the *server* the index came from. Certificates
#            are verified by default (ADR 0009); nothing here turns that off.
#   sha256   the integrity of the *payload*. A bundle changed in transit or
#            on a mirror is refused. This forks `sha256sum`, which the shell
#            has no equivalent of; `--plan` already knows it only reads.
#   nothing  the identity of the *author*. There are no signatures, and
#            `catalogue info` says so in as many words rather than implying it.
#
# What it will not do, each refused rather than half-done: a bundle holding
# a `.so` is refused with that word (native code has no sandbox, and root
# loads modules only from the folder compiled in -- ADR 0016); a member whose
# path is absolute or climbs out of its own folder is refused naming the
# path; and an app with a window open is not removed, which it learns by
# asking the running desktop over its own control socket.
#
# No C, so no module: `dav get` fetches (binary-safe to a file, unlike `dav
# request`, which NUL-terminates its answer), `json` reads the index with its
# types, `archive` looks inside a bundle before anything is unpacked, and
# `mkdir`, `rm` and `mv` place it. The desktop app is a window that runs this
# as a child, the way the Vault accessory runs `vw`, so the manager works for
# someone who never starts the desktop.

strict

AP_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps.json
AP_DATA=${XDG_DATA_HOME:-$HOME/.local/share}/hibr
AP_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/hibr
AP_INDEX=$AP_CACHE/index.json
AP_SIG=$AP_CACHE/index.json.asc
AP_STATE=$AP_DATA/apps.json
# Which scope an install writes into (ADR 0045). `user` is yours and is
# the default; `system` is an administrator's, for every user of the
# machine, and `--system` chooses it.
#
# The path comes from the shell rather than from a second copy of
# `/var/lib/hibr` kept here: `$HIBR_SYSDIR` is the compiled-in value the
# module search itself uses, so the place a module is installed to and
# the place it is looked for in cannot drift apart. A shell too old to
# set it has no system scope at all, which is the honest answer rather
# than a guess at where one would be.
AP_SCOPE=user
AP_SYSROOT=${HIBR_SYSDIR-}

# Point everything at one scope. Called once, before anything reads a
# path, so there is no moment where half the program is writing to one
# place and half to another.
fn ap_scope(which) {
	case $which in
	user) return 0 ;;
	system) ;;
	*) ap_die "$which: a scope is user or system" ;;
	esac
	[ -n "$AP_SYSROOT" ] ||
		ap_die "this hibr has no system scope: it does not set \$HIBR_SYSDIR.
A system install needs hibr 0.99.197 or newer."
	AP_SCOPE=system
	AP_DATA=$AP_SYSROOT
	AP_STATE=$AP_DATA/apps.json
	return 0
}

# A verb that writes, at a scope this account cannot write to, says so in a
# sentence of its own rather than letting `mkdir` say it from the middle of
# the work (Gitea #238): the owner met
# `mkdir: cannot create directory '/var/lib/hibr/apps': Permission denied`,
# which names the symptom, not the thing to do about it.
#
# An ordinary account asking for `--system` is the **expected** case rather
# than an odd one: ADR 0045 makes that root root-owned and 0755 exactly so
# every user of the machine reads it and none can change what they all run.
# So the answer is the command they meant to type.
#
# Reading is never gated -- `--system list` and `--system installed` are
# what somebody checks *before* reaching for sudo -- so this is called from
# the verbs that write and nowhere else.
fn ap_needwrite(verb) {
	local d

	# The root may not exist yet, which is the ordinary case at user
	# scope on a fresh account, so what has to be writable is the
	# nearest parent that does exist.
	d=$AP_DATA
	while [ -n "$d" ] && [ ! -e "$d" ]; do
		d=${d%/*}
	done
	[ -n "$d" ] || d=/
	[ -w "$d" ] && return 0
	[ "$AP_SCOPE" = system ] &&
		ap_die "catalogue $verb --system writes $AP_DATA, which is root's.
That is deliberate: it is root-owned so every user of this machine reads the
same copy and nobody else can change what they all run (ADR 0045). Run it as
root instead:

  sudo catalogue $verb --system ..."
	ap_die "catalogue $verb writes $AP_DATA, which this account cannot write to."
}
# Where the index is fetched from. A static URL on purpose: the catalogue is
# a git repository with a JSON index in it, so it can be browsed, mirrored
# by anyone and served by any static host -- github.com/osakka/hibr-apps is
# the repository and this is the same folder as a page. A bundle's own
# address in the index is relative, so a copy of that folder anywhere is a
# catalogue. Overridden by `catalogue index URL` or HIBR_APPS_URL.
AP_URL_DEFAULT=https://osakka.github.io/hibr-apps/index.json
AP_URL=
# The kinds a bundle may install into, which are the desktop's own scan
# roots -- and what a file is called in each. Five of them are scripts and
# three are data: a theme, a colour scheme and a translation catalogue are
# JSON (ADR 0028, ADR 0032), read from `$XDG_CONFIG_HOME/hibr/<kind>`
# exactly as a script is, so installing one is placing a file where the
# desktop already looks. The extension is the kind's, not the bundle's
# guess: `ap_dest` appended `.hibr` to everything, so a theme had nowhere
# to land at all (Gitea #224).
#
# The ninth is `mods`, and it is the one that is not a scan root of the
# desktop's: `$XDG_DATA_HOME/hibr/mods` is a **module** search directory a
# non-root shell walks when something asks for a module by name (ADR 0044,
# Gitea #221). It is native code, so three things that are advisory for a
# script are refusals for it -- the signature, the ABI and the machine --
# and it is the only kind whose files may end in `.so`.
AP_KINDS=(apps system control-panel control-strip savers themes colours lang
	  mods)
declare -gA AP_KEXT=(
	[apps]=.hibr [system]=.hibr [control-panel]=.hibr
	[control-strip]=.hibr [savers]=.hibr
	[themes]=.json [colours]=.json [lang]=.json
	[mods]=.so
)
# What signs the catalogue. The apt repository's own key: one key for the
# two things this project publishes, rather than a second to lose. The
# *fingerprint* is the check and the keyring is only where to look -- a
# swapped keyring verifies nothing unless it holds a key with these forty
# characters, which is the point of pinning one.
#
# HIBR_APPS_KEYFP names a different one, because a catalogue is a folder
# anybody may copy and serve (`catalogue index URL`) and somebody running their
# own signs it with their own key. That is a real need and not only a
# test hook, and it is not a hole in the model: what this defends against
# is **a catalogue or a mirror that has been changed**, not an attacker
# who can already set your environment -- one who can do that can put
# their own `gpg` on your PATH, or their own `apps` for that matter.
AP_KEYFP=${HIBR_APPS_KEYFP:-A1E3CA788A8FB02052DA22B413035BE1B1674431}
AP_SIGOK=
AP_SIGWHY=
AP_SIGSAID=
# Where the desktop was installed, for the one question this asks of
# it: does it already ship this app. Overridable so a test can point
# at a tree of its own.
HIBR_DESKTOP="${HIBR_DESKTOP-}"
declare -gA AP_IX
declare -gA AP_ST
declare -gA AP_ENT
# Every path a placement wrote, relative to AP_DATA, filled by ap_putone and
# ap_puttar for whoever called them: an app may place more than its own file
# now that a bundle can carry a Control Panel pane or a Control Strip module
# of its own (Gitea #217), and a folder on disk cannot say what it came with.
AP_PLACED=()
# The parts of one installed entry, left by ap_parts for its caller.
AP_PARTS=()
# The state is one file that two catalogues can want at once, so a verb
# that writes it holds a lock across read-modify-write (Gitea #242). The
# mutex is a **directory**: `mkdir` is one syscall that either creates or
# fails, with no check-then-act in between to lose a race in.
AP_LOCK=
AP_LOCKED=0
# How many tenths of a second to wait for somebody else to finish before
# saying so. An install fetches over the network while it holds this, so
# the wait is generous: `catalogue install apps/` is twenty-one bundles.
# Taken from the environment when it is there, so a suite can make the
# timeout happen in a moment instead of waiting a minute and a half for
# it -- and so anybody scripting this can decide for themselves.
AP_LOCKWAIT=${AP_LOCKWAIT:-900}
# The modules an entry needs that are not loadable here and *are* in this
# catalogue, left by ap_needs for ap_install to place first. Empty is the
# ordinary case, since everything hibr ships is loadable already.
AP_WANT=()
# Which section of the index is in force: `entries`, keyed by an id of
# kind/name, where one exists, and the older `apps`, keyed by name, where it
# does not. The desktop has eight namespaces and a name is only unique inside
# one of them -- `clock` is an application and a screen saver -- so a
# catalogue keyed by name alone loses one of any pair (Gitea #222).
AP_SECT=apps
# Set by the dav module after each request; a strict file declares it.
DAV_CODE=

# A complaint, and the status to leave with.
fn ap_die(text, int st = 1) {
	echo "catalogue: $text" >&2
	exit "$st"
}

fn ap_say(text) {
	echo "$text"
}

# The index's address: what was set, else the environment, else the default.
ap_url() {
	local -A c

	[ -n "$AP_URL" ] && { ret "$AP_URL"; return 0; }
	if [ -n "$HIBR_APPS_URL" ]; then
		AP_URL=$HIBR_APPS_URL
	elif [ -r "$AP_CONF" ] && json parse c < "$AP_CONF" 2> /dev/null &&
	     [ -n "${c["url"]}" ]; then
		AP_URL=${c["url"]}
	else
		AP_URL=$AP_URL_DEFAULT
	fi
	ret "$AP_URL"
}

# Fetch the index. Kept in the cache folder, so `list` and `info` cost
# nothing after the first; `refresh` and every `install` fetch it again,
# because installing against a stale index is how a sha256 mismatch gets
# blamed on the mirror.
fn ap_fetch(int force = 0) {
	local u tmp

	u := ap_url
	if [ "$force" = 0 ] && [ -r "$AP_INDEX" ]; then
		return 0
	fi
	need dav 2> /dev/null || ap_die "the dav module is needed to fetch the index"
	mkdir -p "$AP_CACHE" || ap_die "cannot make $AP_CACHE"
	tmp=$AP_INDEX.new
	rm -f "$tmp" 2> /dev/null
	if ! dav get "$u" "$tmp" 2> /dev/null; then
		rm -f "$tmp" 2> /dev/null
		ap_die "$u: the index could not be fetched${DAV_CODE:+ ($DAV_CODE)}"
	fi
	mv -f "$tmp" "$AP_INDEX" || ap_die "cannot put the index in place"
	# The signature travels beside the index and is fetched with it. A
	# catalogue that has none is not an error here -- it is a state
	# `ap_verify` reads and every caller decides about, because the
	# answer differs by kind (ADR 0044).
	rm -f "$AP_SIG" 2> /dev/null
	dav get "$u.asc" "$AP_SIG" 2> /dev/null ||
		rm -f "$AP_SIG" 2> /dev/null
	return 0
}

# Where the key that signs the catalogue is kept. Not in the data folder,
# which is writable: beside the shell that was installed, which is the
# same place `catalogue.hibr` itself came from. The launcher fills
# HIBR_APPS_KEYRING in; the two standard prefixes are for a shell run from
# a build tree, and `$HIBR` is this shell's own absolute path.
fn ap_keyring() {
	local p

	for p in "$HIBR_APPS_KEYRING" \
		 "${HIBR%/bin/hibr}/share/hibr/keyring.gpg" \
		 /usr/share/hibr/keyring.gpg \
		 /usr/local/share/hibr/keyring.gpg; do
		[ -n "$p" ] && [ -r "$p" ] && { ret "$p"; return 0; }
	done
	return 1
}

# Whether the index this is about to read was signed by the key pinned
# above. Three outcomes, not two, and the third is the one that matters:
# **verified**, **not signed by that key**, and **nothing here can tell**
# -- a host with no gpg. The last two are the same answer for a module
# (refuse) and the same answer for a script (say so once and go on), but
# they are different sentences, and a person debugging one wants to know
# which it was.
#
# The fingerprint is the check. gpg's own exit status says "a good
# signature by somebody in this keyring", which is a different question,
# so the status line is read and VALIDSIG's own fingerprint is compared --
# first field, and the last, which is the primary key when the signature
# was made by a subkey.
fn ap_verify() {
	local kr out tag word fp rest

	[ -n "$AP_SIGOK" ] && return 0
	AP_SIGOK=0
	# The catalogue's own fault before this machine's: a catalogue that
	# offers no signature is the answer whatever is or is not installed
	# here, and saying "the key is not installed" about one would send a
	# person to fix the wrong end.
	if [ ! -r "$AP_SIG" ]; then
		AP_SIGWHY="the catalogue offers no signature"
		return 0
	fi
	if ! command -v gpg > /dev/null 2>&1; then
		AP_SIGWHY="there is no gpg on this machine to check it with"
		return 0
	fi
	if ! kr := ap_keyring; then
		AP_SIGWHY="hibr's own copy of the catalogue key is not installed"
		return 0
	fi
	out=$(command gpg --batch --no-default-keyring --keyring "$kr" \
		--status-fd 1 --verify "$AP_SIG" "$AP_INDEX" 2> /dev/null)
	while read -r tag word fp rest; do
		[ "$tag" = "[GNUPG:]" ] || continue
		[ "$word" = VALIDSIG ] || continue
		if [ "$fp" = "$AP_KEYFP" ] || [ "${rest##* }" = "$AP_KEYFP" ]; then
			AP_SIGOK=1
			return 0
		fi
		AP_SIGWHY="it is signed by $fp, not by $AP_KEYFP"
		return 0
	done <<< "$out"
	AP_SIGWHY="the signature does not check out against $AP_KEYFP"
	return 0
}

# Said once per run, and only where it is the truth a person needs: before
# something is placed. A script goes on -- TLS said who answered and the
# sha256 said the payload arrived whole, which is ADR 0041's stated model
# and a script is a file you can open. A module does not, and that refusal
# is ap_install's, not this.
fn ap_sigsay() {
	ap_verify
	[ "$AP_SIGOK" = 1 ] && return 0
	# A script is installed from an unverified catalogue with a warning
	# because you can read it before you run it -- that is ADR 0041's
	# whole sentence and it holds for an install into your own home.
	# It does not hold for an install into everybody's: the people who
	# will run this are not the person who read it, and most of them
	# will never know it was fetched. So at system scope the warning
	# becomes the refusal a module already gets (ADR 0045).
	if [ "$AP_SCOPE" = system ]; then
		ap_die "refusing to install into the system scope from a catalogue this cannot verify
$AP_SIGWHY.
A script installed here runs for every user of this machine, and they
are not the person who read it. Install it into your own scope, or
publish a signed catalogue."
	fi
	[ -n "$AP_SIGSAID" ] && return 0
	AP_SIGSAID=1
	ap_say "warning: this catalogue is not verified -- $AP_SIGWHY"
	return 0
}

# The index, parsed. Its shape is one object per app under "apps", keyed by
# name, which is what makes a lookup a lookup rather than a walk.
fn ap_load(int force = 0) {
	ap_fetch "$force"
	[ "${#AP_IX[@]}" -gt 0 ] && [ "$force" = 0 ] && return 0
	AP_IX=()
	json parse AP_IX < "$AP_INDEX" 2> /dev/null ||
		ap_die "$AP_INDEX does not parse as JSON"
	# Counted, not asked with ${..+x}: an entry that holds only a map is
	# not "set" by that test, which is a trap CLAUDE.md records in as many
	# words -- and every entry here holds only a map.
	# An index from 0.99.184 on carries both: `entries` for anything that
	# reads it, and `apps` for an older client, which gets every entry
	# whose name is unique and misses only the one it could not have
	# named anyway.
	AP_SECT=apps
	[ "${#AP_IX["entries"][@]}" -gt 0 ] && AP_SECT=entries
	[ "${#AP_IX["$AP_SECT"][@]}" -gt 0 ] ||
		ap_die "the index has no apps in it"
	return 0
}

# What a name the person typed means. An id (`savers/clock`) is itself; a
# bare name is the one entry that carries it, and **several is a refusal
# rather than a choice** -- whichever the index happened to hold is not an
# answer to "install clock".
fn ap_resolve(want) {
	local id hit= n=0 all=

	[ "${#AP_IX["$AP_SECT"]["$want"][@]}" -gt 0 ] && { ret "$want"; return 0; }
	# An id against a name-keyed catalogue: `apps/demo` is `demo` there,
	# which is what lets anything holding an id -- the state, an update --
	# read an older index as well as a new one.
	[ "${#AP_IX["$AP_SECT"]["${want##*/}"][@]}" -gt 0 ] &&
		{ ret "${want##*/}"; return 0; }
	for id in "${!AP_IX["$AP_SECT"][@]}"; do
		[ "${id##*/}" = "$want" ] || continue
		hit=$id
		all="$all${all:+, }$id"
		n=$((n + 1))
	done
	if [ "$n" -gt 1 ]; then
		ap_die "$want: the catalogue has more than one -- $all
Name the one you mean."
	fi
	[ "$n" = 1 ] || return 1
	ret "$hit"
}

# What is installed here, as name -> version/kind/where, kept beside the
# files rather than derived from them: a folder on disk cannot say which
# version it is or which index it came from.
ap_state() {
	local k f i

	AP_ST=()
	[ -r "$AP_STATE" ] || return 0
	# A state that will not parse is **damaged**, which is not the same
	# answer as "nothing is installed" and must never be given as one
	# (Gitea #241). Reading it as empty is what turned a half-written
	# file into a silent, total loss of the record: every installed file
	# stayed on disk, owned by nobody, and the next install would have
	# written a fresh state over the top of it. An empty file is still
	# fine -- that is a scope nothing has been installed into yet.
	if [ -s "$AP_STATE" ] && ! json parse AP_ST < "$AP_STATE" 2> /dev/null; then
		AP_ST=()
		ap_die "$AP_STATE will not read as JSON, so what is installed here
cannot be known. Nothing has been changed. The files are still where they
were; it is the record of them that is damaged.

Move it aside to start a fresh one -- the files already installed stay, and
\`catalogue install\` will place them again over the top:

  mv $AP_STATE $AP_STATE.damaged"
	fi
	# A state written before 0.99.184 is keyed by name, and every entry
	# in it is an application -- the catalogue published nothing else --
	# so a bare key means `apps/<key>` exactly (Gitea #222). Migrated on
	# the way in, and the next save writes it as an id.
	for k in "${!AP_ST["installed"][@]}"; do
		case $k in
		*/*) continue ;;
		esac
		for f in version kind sha256; do
			AP_ST["installed"]["apps/$k"]["$f"]=${AP_ST["installed"]["$k"]["$f"]}
		done
		for i in "${!AP_ST["installed"]["$k"]["paths"][@]}"; do
			AP_ST["installed"]["apps/$k"]["paths"]["$i"]=${AP_ST["installed"]["$k"]["paths"]["$i"]}
		done
		unset AP_ST["installed"]["$k"]
	done
	return 0
}

# What a typed name means among the things installed here: an id as it
# stands, else the one installed entry whose name it is.
fn ap_insresolve(want) {
	local id

	[ -n "${AP_ST["installed"]["$want"]["kind"]}" ] && { ret "$want"; return 0; }
	for id in "${!AP_ST["installed"][@]}"; do
		[ "${id##*/}" = "$want" ] || continue
		ret "$id"
		return 0
	done
	return 1
}

# Take the state's lock, or say who has it (Gitea #242). Idempotent: the
# dispatch takes it before a writing verb reads anything, which is the
# point -- a lock taken after the read would serialise the writes and
# still lose the update. ap_statesave asks again in case a path reaches
# it another way, and a second ask is free.
fn ap_lock() {
	local n=0 who
	[ "$AP_LOCKED" = 1 ] && return 0
	mkdir -p "$AP_DATA" || ap_die "cannot make $AP_DATA"
	AP_LOCK=$AP_DATA/.lock
	while :; do
		mkdir "$AP_LOCK" 2> /dev/null && break
		# Whoever holds it may be gone: a crash leaves the
		# directory behind, and a lock nothing can break is a
		# catalogue nothing can ever write again. Broken only on a
		# pid we positively read and that is positively dead --
		# an empty read means the holder is mid-write, which is
		# the live case and the one that must never be broken.
		who=
		read -r who 2> /dev/null < "$AP_LOCK/pid" || who=
		if [ -n "$who" ] && ! kill -0 "$who" 2> /dev/null; then
			ap_say "taking over a lock left by $who, which is gone"
			rm -rf "$AP_LOCK" 2> /dev/null
			continue
		fi
		n=$((n + 1))
		[ "$n" -gt "$AP_LOCKWAIT" ] &&
			ap_die "another catalogue is writing $AP_DATA${who:+, as pid $who}.
Only one at a time may change the state: two at once and one of them is
lost. Try again when it has finished."
		sleep 0.1
	done
	printf '%s\n' "$$" > "$AP_LOCK/pid" 2> /dev/null
	AP_LOCKED=1
	trap 'ap_unlock' EXIT
	return 0
}

# Give it back. Never changes the status: it runs from an EXIT trap, and
# a trap that fails there would replace whatever the verb was reporting.
fn ap_unlock() {
	[ "$AP_LOCKED" = 1 ] || return 0
	rm -rf "$AP_LOCK" 2> /dev/null
	AP_LOCKED=0
	return 0
}

# Written to a temporary file beside the real one and renamed over it, so
# the state on disk is always either the whole of the old one or the whole
# of the new (Gitea #241). It used to be `printf > "$AP_STATE"`, which
# truncates in place: a Ctrl-C, a crash or a full disk during that write
# left a partial file, and the next run read it as "nothing installed"
# with every file still on disk and no longer claimed by anything.
#
# The rename is within one directory, so it is rename(2) and atomic. A
# reader takes no lock and needs none: it sees one file or the other.
ap_statesave() {
	local j tmp

	ap_lock
	j := json emit AP_ST || ap_die "cannot emit the state"
	tmp=$AP_STATE.$$
	printf '%s\n' "$j" > "$tmp" || {
		rm -f "$tmp" 2> /dev/null
		ap_die "cannot write $tmp"
	}
	mv -f "$tmp" "$AP_STATE" || {
		rm -f "$tmp" 2> /dev/null
		ap_die "cannot replace $AP_STATE"
	}
	return 0
}

# One app's entry from the index, into AP_ENT; fails when there is no such
# app, which every verb reports in its own words.
fn ap_entry(id) {
	local k key

	AP_ENT=()
	# Either shape: an id in an `entries` index, and the bare name in an
	# `apps` one, so a caller holding an id reads an older catalogue too.
	key=$id
	[ "${#AP_IX["$AP_SECT"]["$key"][@]}" -gt 0 ] || key=${id##*/}
	[ "${#AP_IX["$AP_SECT"]["$key"][@]}" -gt 0 ] || return 1
	# `arch` is in this list, and the fact that it had to be added is the
	# whole argument for the list: an index field that nothing copies
	# here is a field nothing can check, and `ap_needs` read an empty
	# string and let a darwin-arm64 module install on linux-x86_64 --
	# measured, not reasoned about. Anything added to the index that a
	# verb reads goes here too.
	for k in title version about author licence hibr abi arch bundle sha256 kind modules name dir; do
		AP_ENT["$k"]=${AP_IX["$AP_SECT"]["$key"]["$k"]}
	done
	# The *name* is what a file is called where it lands; the **id** is
	# always `kind/name`, computed rather than taken from the key, so the
	# state is keyed the same way whichever catalogue this read -- without
	# that, a name-keyed index and the state would disagree and every
	# installed app would read as not installed (Gitea #222).
	[ -n "${AP_ENT["name"]}" ] || AP_ENT["name"]=${key##*/}
	[ -n "${AP_ENT["kind"]}" ] || AP_ENT["kind"]=apps
	# The name decides a **filename**, so it is checked here -- the one
	# place an index entry becomes the record every verb reads -- rather
	# than where each path is built. A part's path has been checked since
	# bundles could carry one (`ap_partok`) and the entry's own name never
	# was: `"name": "../../../climbed"` with kind `apps` wrote
	# `$AP_DATA/apps/../../../climbed.hibr`, measured as a file three
	# folders above the data directory, with the sha256 matching -- which
	# says the bytes were not changed on the way and nothing at all about
	# where they land. `../../.hibrc` is the same hole with the shell's own
	# startup file on the end of it. The entry is refused rather than the
	# run ended, so one bad entry is missing from a list instead of taking
	# the catalogue with it, the way a bad theme is (Gitea #225).
	if ! ap_nameok "${AP_ENT["name"]}"; then
		printf 'catalogue: %s: the index gives a name that is not one a file can be called, so it is left out\n' \
			"${AP_ENT["kind"]}/${AP_ENT["name"]}" >&2
		AP_ENT=()
		return 1
	fi
	AP_ENT["id"]=${AP_ENT["kind"]}/${AP_ENT["name"]}
	# The key this entry was found under, so whatever needs the entry's
	# *nested* fields -- its parts -- can reach them: AP_ENT holds the
	# scalars only.
	AP_ENT["key"]=$key
	return 0
}

# A name a file may be called: one path component, no climbing, nothing
# hidden. The same characters a part's filename may hold, less the
# extension, which the kind supplies.
fn ap_nameok(name) {
	case $name in
	"" | .* | */* | *[!a-z0-9._-]* | *..*) return 1 ;;
	esac
	return 0
}

# Is this one of the eight kinds a bundle may install into?
fn ap_kindok(kind) {
	local k

	for k in "${AP_KINDS[@]}"; do
		[ "$k" = "$kind" ] && return 0
	done
	return 1
}

# Where an app's own file goes, and where its folder of resources does.
# What a kind calls its files. A kind nothing knows is a script, which is
# what every kind was before this.
fn ap_kext(kind) {
	ret "${AP_KEXT["$kind"]:-.hibr}"
}

# The folder inside a kind that an entry lands in, when the index names
# one -- `Internet` for Mail, so it lands as `apps/Internet/mail.hibr`
# and `dt_apps` gives it the submenu it has in a shipped desktop. Without
# it every fetched application landed flat and a restored desktop listed
# twenty-one under Applications where the tree has four submenus
# (Gitea #233).
#
# It decides a **destination**, so it is checked here rather than
# trusted, exactly as a part's own path is: a segment is letters,
# digits, dashes, underscores and spaces -- `Desk Accessories` is a real
# folder -- and nothing else, so there is no climbing out, no absolute
# path and no empty segment. An index that says otherwise has the dir
# dropped rather than the install refused: the entry is still a perfectly
# good app and the worst that happens is the flat placement everybody had
# before this existed.
fn ap_dirok(dir) {
	local IFS=/ seg

	[ -n "$dir" ] || return 1
	case $dir in
	/* | */ | *//*) return 1 ;;
	esac
	for seg in $dir; do
		case $seg in
		"" | . | ..) return 1 ;;
		*[!a-zA-Z0-9_\ -]*) return 1 ;;
		esac
	done
	return 0
}

fn ap_dest(kind, name, dir = "") {
	local e

	e := ap_kext "$kind"
	ap_dirok "$dir" || dir=
	ret "$AP_DATA/$kind/${dir:+$dir/}$name$e"
}

fn ap_destdir(kind, name, dir = "") {
	ap_dirok "$dir" || dir=
	ret "$AP_DATA/$kind/${dir:+$dir/}$name"
}

# The same, relative, for AP_PLACED and the state -- which is what
# removal walks, so it has to carry the folder too or an app installed
# into one could never be taken away.
fn ap_rel(kind, name, dir = "") {
	ap_dirok "$dir" || dir=
	ret "$kind/${dir:+$dir/}$name"
}

# Every member of an open archive, depth first, as "kind<TAB>path" lines in
# AP_MEM. `archive ls` lists one folder at a time -- it is a folder view of a
# tarball, not a flat listing -- and it *implies* a folder the tarball never
# declared from its members' names. Which is also how a member called
# `../escaped.hibr` arrives: as a folder named `..` at the top level, with
# the file inside it. So the path a check sees has to be the one this walk
# builds, not a line of `archive ls` output, which is
# `kind TAB size TAB mtime TAB name`.
AP_MEM=()
fn ap_walk(nm, prefix = "", int depth = 0) {
	local l kind size mt name path

	[ "$depth" -lt 16 ] ||
		ap_die "the bundle nests folders deeper than 16, which nothing needs"
	if [ -n "$prefix" ]; then
		l=$(archive ls "$nm" "$prefix" 2> /dev/null) || return 0
	else
		l=$(archive ls "$nm" 2> /dev/null) || return 0
	fi
	while IFS=$'\t' read -r kind size mt name; do
		[ -n "$name" ] || continue
		path=${prefix:+$prefix/}$name
		AP_MEM+=("$kind	$path")
		[ "$kind" = d ] && ap_walk "$nm" "$path" $((depth + 1))
	done <<< "$l"
	return 0
}

# A member path from a bundle somebody else made, checked before anything is
# written. This is the one security boundary in this program: a bundle that
# can write outside its own folder can write anywhere this runs. Absolute
# paths, any `..` component and an empty name are refused, each naming the
# path.
#
# A `.so` is refused everywhere **except** in a bundle of kind `mods`,
# which is the one kind that exists to carry one (ADR 0044). The kind is
# passed in rather than read from a global for the usual reason: a part
# decides its own destination, so the check has to be asked about the kind
# the file is going to, not the kind the bundle happens to be.
fn ap_pathok(p, kind = "") {
	local part
	local -a parts

	case $p in
	"" | /*) return 1 ;;
	esac
	case $p in
	*.so | *.so.*) [ "$kind" = mods ] || return 1 ;;
	esac
	IFS=/ read -ra parts <<< "$p"
	for part in "${parts[@]}"; do
		case $part in
		.. ) return 1 ;;
		esac
	done
	return 0
}

# The sha256 of a file. Forks sha256sum: the shell has no hash of its own,
# and this is the seam signing would later use.
fn ap_sha(path) {
	local line h

	line=$(command sha256sum "$path" 2> /dev/null) ||
		ap_die "sha256sum is needed to verify a bundle"
	h=${line%% *}
	[ -n "$h" ] || ap_die "$path: sha256sum said nothing"
	ret "$h"
}

# Which windows a running desktop has open for this app, as a count and
# their titles. Nothing open, or no desktop at all, is zero -- asked over
# the desktop's own control socket rather than guessed, because somebody
# running `catalogue remove` from a terminal inside the desktop is exactly who
# this protects (ADR 0041, item 9).
fn ap_windows(name) {
	local out t n=0
	local -A w
	local i

	command -v desktop > /dev/null || { ret 0; return 0; }
	out=$(command desktop ctl windows 2> /dev/null) || { ret 0; return 0; }
	json parse w <<< "$out" 2> /dev/null || { ret 0; return 0; }
	i=0
	while [ "$i" -lt "${#w["windows"][@]}" ]; do
		if [ "${w["windows"][$i]["app"]}" = "$name" ]; then
			n=$((n + 1))
			t="$t${t:+, }${w["windows"][$i]["title"]}"
		fi
		i=$((i + 1))
	done
	AP_WINS=$t
	ret "$n"
}
AP_WINS=

# --- the verbs ------------------------------------------------------------

# `-j` answers the same walk as JSON, for anything that is not a person:
# the desktop's Applications window reads this rather than parsing the
# columns below it, so the window and the command read **one** answer
# instead of one parsing the other's layout (Gitea #219).
#
# Not the result slot, which is what that ticket asked for: `apps` is a
# separate program and the desktop runs it as a child, so `:=` captures
# its standard output (ADR 0038) and a child cannot fill its parent's
# slot. A builtin like `mod list` can; a command can only print, and the
# honest version of "one answer" for a command is a machine-readable one.
fn ap_list(want = "", int j = 0) {
	local name n=0 v here i
	local -A out

	ap_load
	ap_state
	here := ap_arch
	for name in "${!AP_IX["$AP_SECT"][@]}"; do
		ap_entry "$name" || continue
		# A module built for another machine is not something to
		# choose between: this shell knows what it is running on, so
		# listing one it could never load is asking a person to do
		# arithmetic the program has already done. It is hidden from
		# the list and from `-j`, which is what the Catalogue window
		# reads -- and `catalogue info NAME` still answers for it, because
		# somebody who asks by name is asking a different question
		# and deserves the reason rather than a silence.
		[ -n "${AP_ENT["arch"]}" ] && [ "${AP_ENT["arch"]}" != "$here" ] &&
			continue
		if [ -n "$want" ]; then
			case ${AP_ENT["id"]}${AP_ENT["title"]}${AP_ENT["about"]} in
			*"$want"*) ;;
			*) continue ;;
			esac
		fi
		v=${AP_ST["installed"]["${AP_ENT["id"]}"]["version"]}
		if [ "$j" = 1 ]; then
			# Each fact in a field of its own, rather than the
			# sentence the column holds: a window wants to know
			# *whether* there is an update, not to read "installed
			# 1.0, 1.1 available" and work it out again.
			out["entries"]["${AP_ENT["id"]}"]["id"]=${AP_ENT["id"]}
			out["entries"]["${AP_ENT["id"]}"]["name"]=${AP_ENT["name"]}
			out["entries"]["${AP_ENT["id"]}"]["kind"]=${AP_ENT["kind"]}
			out["entries"]["${AP_ENT["id"]}"]["title"]=${AP_ENT["title"]}
			out["entries"]["${AP_ENT["id"]}"]["version"]=${AP_ENT["version"]}
			out["entries"]["${AP_ENT["id"]}"]["about"]=${AP_ENT["about"]}
			out["entries"]["${AP_ENT["id"]}"]["installed"]=$v
			out["entries"]["${AP_ENT["id"]}"]["update"]=0
			[ -n "$v" ] && [ "$v" != "${AP_ENT["version"]}" ] &&
				out["entries"]["${AP_ENT["id"]}"]["update"]=1
			# What `installed` has said in its own columns since
			# 0.99.197 and the window could not see, so a copy
			# that can never run looked like a working one
			# (Gitea #244). Only asked about an entry that is
			# installed: `ap_shipped` globs the desktop's folders
			# and there is no sense paying that for the eighty
			# the person does not have.
			out["entries"]["${AP_ENT["id"]}"]["defunct"]=0
			out["entries"]["${AP_ENT["id"]}"]["shadows"]=0
			out["entries"]["${AP_ENT["id"]}"]["scope"]=
			if [ -n "$v" ]; then
				out["entries"]["${AP_ENT["id"]}"]["scope"]=$AP_SCOPE
				ap_insys "${AP_ENT["id"]}" &&
					out["entries"]["${AP_ENT["id"]}"]["defunct"]=1
				ap_shipped "${AP_ENT["kind"]}" "${AP_ENT["name"]}" &&
					out["entries"]["${AP_ENT["id"]}"]["shadows"]=1
				# The files it brought, so a window can say
				# what removing it would take away rather
				# than asking afterwards.
				ap_parts "${AP_ENT["id"]}"
				for i in "${!AP_PARTS[@]}"; do
					out["entries"]["${AP_ENT["id"]}"]["parts"]["$i"]=${AP_PARTS["$i"]}
				done
			fi
			n=$((n + 1))
			continue
		fi
		if [ -n "$v" ]; then
			if [ "$v" = "${AP_ENT["version"]}" ]; then
				v="installed"
			else
				v="installed $v, ${AP_ENT["version"]} available"
			fi
		else
			v=${AP_ENT["version"]}
		fi
		printf '%-24s %-24s %s\n' "${AP_ENT["id"]}" "${AP_ENT["title"]}" "$v"
		n=$((n + 1))
	done
	if [ "$j" = 1 ]; then
		# An empty answer is an empty `entries`, not nothing at all:
		# a reader that has to branch on "did I get JSON" is a reader
		# that will forget to. Written out rather than built, because
		# an element cannot be assigned an empty map -- `out["x"]=()`
		# is a syntax error, in bash as well as here.
		# The kinds travel with the answer, in the order they are
		# declared here, so a window grouping by kind reads this
		# list rather than keeping one of its own. The Catalogue
		# kept a second copy until 0.99.194 and it was three
		# releases behind -- `mods` arrived in `apps` in 0.99.191
		# and the window could not show one (Gitea #220). A reader
		# that wants the kinds and the entries makes one call, so
		# this costs no fork.
		# A map keyed by kind rather than a list, because hibr's maps
		# keep the order they were filled in and a reader then gets
		# the order and the membership from one thing.
		local ki kl=
		for ki in "${AP_KINDS[@]}"; do
			kl="$kl${kl:+,}\"$ki\":1"
			out["kinds"]["$ki"]=1
		done
		local js
		if [ "$n" = 0 ]; then
			# Written out rather than built: an element cannot be
			# assigned an empty map, and the kinds are a fact
			# about this program rather than about the index, so
			# an empty catalogue still answers with them.
			printf '{"entries":{},"kinds":{%s}}\n' "$kl"
			return 0
		fi
		js := json emit out
		printf '%s\n' "$js"
		return 0
	fi
	[ "$n" = 0 ] && ap_say "nothing in the index${want:+ matches $want}"
	return 0
}

# The desktop as it was **shipped**, which is a different folder from
# the one this writes into: `$PREFIX/share/hibr/desktop`, worked out from
# the running shell's own path the way the catalogue's keyring is. Empty
# when there is none to find, which is every case but an installed hibr.
fn ap_deskdir() {
	local p

	for p in "$HIBR_DESKTOP" "${HIBR%/bin/hibr}/share/hibr/desktop" \
		 /usr/share/hibr/desktop /usr/local/share/hibr/desktop; do
		[ -n "$p" ] && [ -d "$p" ] && { ret "$p"; return 0; }
	done
	return 1
}

# Whether this kind and name is **also** one the desktop ships. The
# `hibr` package carries no applications since 0.99.194, but a source
# install with `APPS=all`, or an upgrade from before it that has not
# been reconfigured, still can -- so somebody may hold both a fetched
# copy and a shipped one, and the fetched one wins, because
# every scan list reads the data folder before the shipped one. That is
# the right answer and an invisible one, so it is said out loud here
# (Gitea #220).
fn ap_shipped(kind, name) {
	local d e f

	d := ap_deskdir || return 1
	e := ap_kext "$kind"
	for f in "$d/$kind/$name$e" "$d/$kind"/*/"$name$e" \
		 "$d/$kind"/*/*/"$name$e"; do
		[ -r "$f" ] && return 0
	done
	return 1
}

# What version of this the **machine's** scope has, if any -- an
# administrator's copy, for every user. Empty when there is none, when
# this hibr has no system scope, or when we are installing into that
# scope ourselves.
#
# Read from the system scope's own state file rather than from the
# disk, because the question is "which version is installed there" and
# only the state knows that; a file on disk says a name and nothing
# else.
fn ap_sysver(id) {
	local f v
	local -A j

	[ -n "$AP_SYSROOT" ] || return 1
	[ "$AP_SCOPE" = system ] && return 1
	f=$AP_SYSROOT/apps.json
	[ -r "$f" ] || return 1
	json parse j < "$f" 2> /dev/null || return 1
	v=${j["installed"]["$id"]["version"]}
	[ -n "$v" ] || return 1
	ret "$v"
}

# Is there a copy in the machine's scope at all, for the defunct column.
#
# Asked of the **paths this install recorded**, not of a path rebuilt
# from the kind and the name: an application lives in a folder of its
# own now (`apps/Internet/mail.hibr`), and a rebuilt path missed every
# one of them -- the first version of this looked for
# `apps/snake.hibr` while the thing sat at `apps/Games/snake.hibr`, so
# the column was blank for exactly the entries it exists to mark. The
# state already knows where each file went; there is no second way to
# work it out that cannot be wrong.
fn ap_insys(name) {
	local i p

	[ -n "$AP_SYSROOT" ] || return 1
	[ "$AP_SCOPE" = system ] && return 1
	for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
		p=${AP_ST["installed"]["$name"]["paths"]["$i"]}
		[ -r "$AP_SYSROOT/$p" ] && return 0
	done
	return 1
}

# The files an installed entry brought that are not its own: a `part`, in
# another scan root, owned by this entry and refcounted so a pane two apps
# both bring survives one of them going. Left in AP_PARTS, since a strict
# file passes a list back through a global.
#
# Derived rather than recorded, so no state written before this release has
# to be migrated. `paths` is the entry's own file first, then each part,
# and -- when the bundle carried resources of its own -- the resource
# **folder** last, which is `paths[0]` without its extension and is a
# directory rather than a part. Counting `paths` minus one would report
# that folder as a part, which is the one thing this has to get right.
fn ap_parts(name) {
	local i p own res

	AP_PARTS=()
	own=${AP_ST["installed"]["$name"]["paths"]["0"]}
	res=${own%.*}
	for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
		[ "$i" = 0 ] && continue
		p=${AP_ST["installed"]["$name"]["paths"]["$i"]}
		[ "$p" = "$res" ] && continue
		AP_PARTS+=("$p")
	done
	return 0
}

fn ap_installed(int j = 0) {
	local name n=0 nd=0 js i sh sy what np auto
	local -A out seen

	ap_state
	for name in "${!AP_ST["installed"][@]}"; do
		sh=
		sy=
		ap_shipped "${AP_ST["installed"]["$name"]["kind"]}" \
			"${name##*/}" && sh=1
		ap_insys "$name" && sy=1
		if [ "$j" = 1 ]; then
			out["installed"]["$name"]["id"]=$name
			out["installed"]["$name"]["version"]=${AP_ST["installed"]["$name"]["version"]}
			out["installed"]["$name"]["kind"]=${AP_ST["installed"]["$name"]["kind"]}
			out["installed"]["$name"]["shadows"]=${sh:-0}
			out["installed"]["$name"]["defunct"]=${sy:-0}
			# Named rather than inferred from the path: the
			# system scope is /var/lib/hibr, which is not where
			# anybody would think to look (ADR 0045 says so in
			# as many words), so it has to be said.
			out["installed"]["$name"]["scope"]=$AP_SCOPE
			# Every path it placed, which is what a window needs to
			# say what removing it would take away.
			for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
				out["installed"]["$name"]["paths"]["$i"]=${AP_ST["installed"]["$name"]["paths"]["$i"]}
			done
			n=$((n + 1))
			continue
		fi
		# A copy of somebody's own that the machine also has is
		# **defunct**, not merely shadowing: the machine's is read
		# first, so this one takes space and runs never. It can
		# only come from having installed it before the
		# administrator did, since an install is refused once the
		# machine has it.
		what=
		[ -n "$sy" ] && { what="defunct: the machine has this"; nd=$((nd + 1)) ; }
		[ -z "$what" ] && [ -n "$sh" ] && what="shadows the one hibr ships"
		# Why this is here, which is a different question from what it
		# is and the one a person asks of a folder they did not fill.
		# A module fetched to satisfy somebody's `needs` says whose;
		# everything else in this list was asked for by name, which is
		# what makes the absence of a word mean "you installed this".
		auto=${AP_ST["installed"]["$name"]["auto"]}
		[ -z "$what" ] && [ -n "$auto" ] &&
			what="automatic: needed by $auto"
		# And what it brought with it. The count rather than the names,
		# so twenty-one entries stay a list somebody can read; `info`
		# and `owns` have the names.
		ap_parts "$name"
		np=${#AP_PARTS[@]}
		if [ -z "$what" ] && [ "$np" -gt 0 ]; then
			what="+$np part"
			[ "$np" = 1 ] || what="$what"s
		fi
		printf '%-16s %-10s %-14s %-7s %s\n' "$name" \
			"${AP_ST["installed"]["$name"]["version"]}" \
			"${AP_ST["installed"]["$name"]["kind"]}" \
			"$AP_SCOPE" \
			"$what"
		seen["${AP_ST["installed"]["$name"]["paths"]["0"]}"]=1
		for i in "${AP_PARTS[@]}"; do
			seen["$i"]=1
		done
		n=$((n + 1))
	done
	if [ "$j" = 1 ]; then
		if [ "$n" = 0 ]; then
			printf '{"installed":{}}\n'
			return 0
		fi
		js := json emit out
		printf '%s\n' "$js"
		return 0
	fi
	[ "$n" = 0 ] && ap_say "nothing installed"
	# The two numbers a person can check against the folder, said
	# together because apart they do not reconcile: twenty-one entries
	# put thirty files in a scope, and until this line the other nine
	# had nothing anywhere to account for them (Gitea #237). Distinct
	# files, so a pane two apps both bring is one of them.
	[ "$n" -gt 0 ] &&
		printf '\n%s entries, %s files\n' "$n" "${#seen[@]}"
	[ "$nd" -gt 0 ] &&
		ap_say "$nd of these is defunct: the machine has its own, which is read first -- \`catalogue remove NAME\` frees the space"
	return 0
}

# Fetch a bundle, verify it exactly as an install verifies it, and write
# it to standard output without placing anything. This is the thing a
# catalogue of **scripts** can offer that a package manager cannot: read
# it before you run it, which is the whole point of an app being a file
# you can open (ADR 0041). The desktop's Applications window is a window
# around this (Gitea #219).
#
# Only the entry's own file: a part is its own entry and is read by
# asking for it by name, rather than this deciding what else you meant.
fn ap_show(want) {
	local name tmp ext

	ap_load
	name := ap_resolve "$want" || ap_die "$want: no such app in the index"
	ap_entry "$name" || ap_die "$name: no such app in the index"
	ext := ap_kext "${AP_ENT["kind"]}"
	case ${AP_ENT["bundle"]} in
	*"$ext") ;;
	*) ap_die "${AP_ENT["id"]}: its bundle is not a ${ext} -- there is no single file to read" ;;
	esac
	tmp := ap_getbundle "${AP_ENT["id"]}" "${AP_ENT["bundle"]}" "${AP_ENT["sha256"]}"
	command cat -- "$tmp" || ap_die "${AP_ENT["id"]}: cannot read what was fetched"
	rm -f "$tmp" 2> /dev/null
	return 0
}

# "What is this file, and who put it here?" -- the reverse of the listing,
# and the question somebody actually asks of a folder they did not fill
# (Gitea #237). Until this verb the only way to answer it was to read
# apps.json by hand.
#
# A path can be in four places and ADR 0045's whole point is that the same
# name can be in all of them with exactly one running, so every answer
# names the scope rather than leaving it to be inferred from a path that
# does not say.
fn ap_owns(...args) {
	local path name own i n=0 d c s hit scope
	local -a by kind

	[ "${#args[@]}" = 1 ] || ap_die "usage: catalogue owns PATH"
	path=${args[0]}
	# An absolute path inside this scope's own root is taken as the path
	# it is; anything else is read as relative to that root, which is
	# how the state records it and how `installed` prints it.
	case $path in
	"$AP_DATA"/*) path=${path#"$AP_DATA"/} ;;
	/*) ;;
	esac
	ap_state
	scope := ap_scopesay
	for name in "${!AP_ST["installed"][@]}"; do
		own=${AP_ST["installed"]["$name"]["paths"]["0"]}
		hit=
		[ "$path" = "$own" ] && hit=own
		if [ -z "$hit" ]; then
			ap_parts "$name"
			for i in "${AP_PARTS[@]}"; do
				[ "$i" = "$path" ] && { hit=part; break ; }
			done
		fi
		[ -n "$hit" ] || continue
		by+=("$name")
		kind+=("$hit")
		n=$((n + 1))
	done
	if [ "$n" -gt 0 ]; then
		printf '%s\n' "$path"
		for i in "${!by[@]}"; do
			name=${by["$i"]}
			if [ "${kind["$i"]}" = own ]; then
				printf '  %s %s itself, in %s\n' "$name" \
					"${AP_ST["installed"]["$name"]["version"]}" \
					"$scope"
			else
				printf '  a part of %s %s, in %s\n' "$name" \
					"${AP_ST["installed"]["$name"]["version"]}" \
					"$scope"
			fi
		done
		# A part two entries both bring is refcounted, so saying
		# "removed when X is" of either one would be false.
		if [ "$n" -gt 1 ]; then
			printf '  kept until every one of those is removed\n'
		elif [ "${kind["0"]}" = part ]; then
			printf '  removed when %s is\n' "${by["0"]}"
		fi
		return 0
	fi
	# Not the catalogue's. Which of the other three it is still matters,
	# because each is removed a different way or not at all.
	c=${AP_CONF%/apps.json}
	[ -e "$c/$path" ] &&
		{ ap_say "$path: yours, by hand, in $c -- the catalogue never wrote it and no update will touch it"; return 0 ; }
	if [ -n "$AP_SYSROOT" ] && [ "$AP_SCOPE" != system ] &&
	   [ -e "$AP_SYSROOT/$path" ]; then
		ap_say "$path: installed for the whole machine, in $AP_SYSROOT -- an administrator put it there, and it is read before your own"
		return 0
	fi
	d := ap_deskdir
	[ -n "$d" ] && [ -e "$d/$path" ] &&
		{ ap_say "$path: not the catalogue's -- this is the copy hibr ships, in $d"; return 0 ; }
	s=$AP_DATA/$path
	[ -e "$s" ] &&
		{ ap_say "$path: it is in $AP_DATA and nothing here claims it -- the catalogue did not place it"; return 1 ; }
	ap_say "$path: nothing here knows about it, and there is no such file in any scope"
	return 1
}

# Which scope this run is acting on, as a person would say it.
fn ap_scopesay() {
	[ "$AP_SCOPE" = system ] && { ret "the machine's scope"; return 0 ; }
	ret "your own scope"
}

# The record against the files, both ways (Gitea #243). Two things can be
# wrong and neither was visible before: a path the record claims that is
# not on disk, and a file in the scope that nothing claims.
#
# The second is what #241 and #242 produced -- a half-written record, or
# one install erasing another's entry -- and the person it happened to had
# no way to see it. `installed` reads the record and believes it; this is
# the only thing that asks the disk.
#
# It needs no network: the comparison is state against files. The index is
# consulted only to recognise an orphan, and only when it is already
# cached, so a check still works on a machine that cannot reach the
# catalogue -- which is exactly the machine something has gone wrong on.
fn ap_check(...args) {
	local a repair=0 name i p rel k f under sha id ent own
	local nm=0 no=0 nf=0 fixed=0 left=0
	local -A claim dirs bysha partof adopt
	local -a miss orph keepp

	for a in "${args[@]}"; do
		case $a in
		-r | --repair) repair=1 ;;
		*) ap_die "usage: catalogue check [--repair]" ;;
		esac
	done
	if [ "$repair" = 1 ]; then
		ap_needwrite check
		ap_lock
	fi
	ap_state
	for name in "${!AP_ST["installed"][@]}"; do
		for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
			p=${AP_ST["installed"]["$name"]["paths"]["$i"]}
			claim["$p"]=$name
			[ -d "$AP_DATA/$p" ] && dirs["$p"]=$name
		done
	done
	for p in "${!claim[@]}"; do
		[ -e "$AP_DATA/$p" ] && continue
		miss+=("$p")
		nm=$((nm + 1))
	done
	# Every file in the scope's own roots. A resource folder is claimed
	# as a folder, so what is inside it is claimed with it rather than
	# one file at a time.
	for k in "${AP_KINDS[@]}"; do
		[ -d "$AP_DATA/$k" ] || continue
		for f in "$AP_DATA/$k"/**; do
			[ -f "$f" ] || continue
			nf=$((nf + 1))
			rel=${f#"$AP_DATA/"}
			[ -n "${claim["$rel"]+x}" ] && continue
			under=
			for p in "${!dirs[@]}"; do
				case $rel in
				"$p"/*) under=1; break ;;
				esac
			done
			[ -n "$under" ] && continue
			orph+=("$rel")
			no=$((no + 1))
		done
	done
	if [ "$nm" = 0 ] && [ "$no" = 0 ]; then
		p=path
		[ "${#claim[@]}" = 1 ] || p=paths
		ap_say "the record and the files agree: ${#claim[@]} $p, all of them there"
		return 0
	fi
	# What an orphan *is*, when the index can say. A bundle of plain
	# files -- what `addapp` publishes -- stores the installed file
	# itself, so its sha256 names the entry it came from; a tarball's
	# sha256 is the tarball's, so an orphan from one cannot be
	# recognised and is reported as unknown rather than guessed at.
	if [ "$no" -gt 0 ] && [ -r "$AP_INDEX" ]; then
		ap_load
		for k in "${!AP_IX["$AP_SECT"][@]}"; do
			ap_entry "$k" || continue
			[ -n "${AP_ENT["sha256"]}" ] &&
				bysha["${AP_ENT["sha256"]}"]=${AP_ENT["id"]}
			for i in "${!AP_IX["$AP_SECT"]["$k"]["parts"][@]}"; do
				sha=${AP_IX["$AP_SECT"]["$k"]["parts"]["$i"]["sha256"]}
				[ -n "$sha" ] &&
					partof["$sha"]=${AP_ENT["id"]}
			done
		done
	fi
	printf '%s\n' "$AP_DATA"
	for p in "${miss[@]}"; do
		printf '  missing  %-34s claimed by %s\n' "$p" "${claim["$p"]}"
	done
	for rel in "${orph[@]}"; do
		id=
		ent=
		if [ "${#bysha[@]}" -gt 0 ]; then
			sha := ap_sha "$AP_DATA/$rel"
			id=${bysha["$sha"]}
			[ -z "$id" ] && ent=${partof["$sha"]}
		fi
		if [ -n "$id" ]; then
			printf '  orphan   %-34s is %s, which the record has lost\n' "$rel" "$id"
			adopt["$id"]=1
		elif [ -n "$ent" ]; then
			printf '  orphan   %-34s a part of %s, which the record has lost\n' "$rel" "$ent"
			adopt["$ent"]=1
		else
			printf '  orphan   %-34s nothing in the index matches it\n' "$rel"
		fi
	done
	if [ "$repair" = 0 ]; then
		printf '\n%s claimed and missing, %s present and unclaimed, of %s files\n' \
			"$nm" "$no" "$nf"
		ap_say "\`catalogue check --repair\` makes the record true: it drops a claim on a file that is gone and takes back one it can recognise. It removes nothing -- the paths above are yours to delete."
		return 1
	fi
	# Repair the **record**, never the files. A claim on a file that is
	# gone is dropped; an entry with no paths left goes with it. An
	# orphan the index recognises is claimed again, which is the whole
	# of recovering from #242 -- the files were always right, it was the
	# record that forgot them.
	printf '\n'
	for name in "${!AP_ST["installed"][@]}"; do
		# An entry's **own** file is what says it is installed. With
		# that gone the entry is gone, whatever is left of its
		# parts: a pane on its own is not an app. Those part files
		# are then unclaimed and the next check names them, which is
		# the honest answer -- removing the app would have taken
		# them, and something else took the app instead. Nothing
		# loops, because adopting an entry needs its own file back.
		own=${AP_ST["installed"]["$name"]["paths"]["0"]}
		if [ ! -e "$AP_DATA/$own" ]; then
			unset AP_ST["installed"]["$name"]
			printf '  dropped %s, whose own file is gone\n' "$name"
			fixed=$((fixed + 1))
			continue
		fi
		keepp=()
		for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
			p=${AP_ST["installed"]["$name"]["paths"]["$i"]}
			[ -e "$AP_DATA/$p" ] && keepp+=("$p")
		done
		[ "${#keepp[@]}" = "${#AP_ST["installed"]["$name"]["paths"][@]}" ] &&
			continue
		unset AP_ST["installed"]["$name"]["paths"]
		i=0
		for p in "${keepp[@]}"; do
			AP_ST["installed"]["$name"]["paths"]["$i"]=$p
			i=$((i + 1))
		done
		printf '  %s: dropped a claim on a part that is gone\n' "$name"
		fixed=$((fixed + 1))
	done
	for id in "${!adopt[@]}"; do
		ap_entry "$id" || continue
		ap_adopt "$id" || continue
		printf '  took back %s %s, which the record had lost\n' \
			"$id" "${AP_ENT["version"]}"
		fixed=$((fixed + 1))
	done
	[ "$fixed" -gt 0 ] && ap_statesave
	for rel in "${orph[@]}"; do
		[ -e "$AP_DATA/$rel" ] || continue
		left=$((left + 1))
	done
	ap_say "the record is true about what it claims now; anything still listed above is a file to keep or delete yourself"
	return 0
}

# Claim an entry's own file and whichever of its parts are on disk, for a
# record that lost them. The paths are worked out the way an install works
# them out, so a repaired entry is indistinguishable from an installed one.
fn ap_adopt(id) {
	local rel e pk pa i n=0
	local -a got

	e := ap_kext "${AP_ENT["kind"]}"
	rel := ap_rel "${AP_ENT["kind"]}" "${AP_ENT["name"]}" "${AP_ENT["dir"]}"
	[ -e "$AP_DATA/$rel$e" ] || return 1
	got=("$rel$e")
	for i in "${!AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"][@]}"; do
		pk=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["kind"]}
		pa=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["as"]}
		[ -e "$AP_DATA/$pk/$pa" ] && got+=("$pk/$pa")
	done
	AP_ST["installed"]["$id"]["version"]=${AP_ENT["version"]}
	AP_ST["installed"]["$id"]["kind"]=${AP_ENT["kind"]}
	AP_ST["installed"]["$id"]["sha256"]=${AP_ENT["sha256"]}
	unset AP_ST["installed"]["$id"]["paths"]
	for i in "${!got[@]}"; do
		AP_ST["installed"]["$id"]["paths"]["$i"]=${got["$i"]}
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] || return 1
	return 0
}

fn ap_info(want, int j = 0) {
	local u name k js i pn pk pa id
	local -A out

	ap_load
	ap_state
	name := ap_resolve "$want" || ap_die "$want: no such app in the index"
	ap_entry "$name" || ap_die "$name: no such app in the index"
	# The state is keyed by the **id**, always `kind/name`, and in a
	# catalogue serving only the older `apps` section a resolved name is
	# the bare one -- so asking the state with it silently finds nothing
	# and `info` says a thing is not installed when it is. Found by
	# #237's own check for the `brings` row, which missed for the same
	# reason the `installed` row had been missing all along.
	id=${AP_ENT["id"]:-$name}
	u := ap_url
	if [ "$j" = 1 ]; then
		for k in id name kind title version about author licence \
			 hibr abi modules bundle sha256; do
			out["$k"]=${AP_ENT["$k"]}
		done
		out["index"]=$u
		out["installed"]=${AP_ST["installed"]["$id"]["version"]}
		for i in "${!AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"][@]}"; do
			out["parts"]["$i"]["kind"]=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["kind"]}
			out["parts"]["$i"]["as"]=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["as"]}
		done
		js := json emit out
		printf '%s\n' "$js"
		return 0
	fi
	printf '%s\n' "${AP_ENT["name"]} -- ${AP_ENT["title"]}"
	[ -n "${AP_ENT["about"]}" ] && printf '\n%s\n' "${AP_ENT["about"]}"
	printf '\nversion   %s\n' "${AP_ENT["version"]}"
	printf 'author    %s\n' "${AP_ENT["author"]:-not said}"
	printf 'licence   %s\n' "${AP_ENT["licence"]:-not said}"
	printf 'needs     hibr %s, module ABI %s%s%s\n' \
		"${AP_ENT["hibr"]:-any}" "${AP_ENT["abi"]:-any}" \
		"${AP_ENT["modules"]:+, modules: ${AP_ENT["modules"]}}" \
		"${AP_ENT["arch"]:+, machine: ${AP_ENT["arch"]}}"
	printf 'kind      %s\n' "${AP_ENT["kind"]}"
	# What it places besides itself (Gitea #237). Two places know, and
	# which one does depends on how the bundle is served: a catalogue of
	# plain files -- what `addapp` makes -- names every part in the
	# index, so this answers *before* an install, which is the more
	# useful moment; a tarball keeps them in its own `app.json`, which
	# nothing can read without fetching it. So the index is asked first
	# and the state second, and for a tarball that is not installed the
	# honest answer is to say nothing rather than to claim none.
	# A part is refcounted, so one two apps both bring outlives the
	# removal of either.
	pn=0
	for i in "${!AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"][@]}"; do
		pk=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["kind"]}
		pa=${AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"]["$i"]["as"]}
		if [ "$pn" = 0 ]; then
			printf 'brings    %s/%s\n' "$pk" "$pa"
		else
			printf '          %s/%s\n' "$pk" "$pa"
		fi
		pn=$((pn + 1))
	done
	if [ "$pn" = 0 ] && [ -n "${AP_ST["installed"]["$id"]["version"]}" ]; then
		ap_parts "$id"
		for i in "${AP_PARTS[@]}"; do
			if [ "$pn" = 0 ]; then
				printf 'brings    %s\n' "$i"
			else
				printf '          %s\n' "$i"
			fi
			pn=$((pn + 1))
		done
	fi
	printf 'bundle    %s\n' "${AP_ENT["bundle"]}"
	printf 'sha256    %s\n' "${AP_ENT["sha256"]:-none given}"
	printf 'index     %s\n' "$u"
	ap_verify
	if [ "$AP_SIGOK" = 1 ]; then
		printf 'signed    yes, by %s\n' "$AP_KEYFP"
	else
		printf 'signed    no -- %s\n' "$AP_SIGWHY"
	fi
	[ -n "${AP_ST["installed"]["$id"]["version"]}" ] &&
		printf 'installed %s\n' "${AP_ST["installed"]["$id"]["version"]}"
	if [ "$AP_SIGOK" = 1 ]; then
		printf '\n%s\n' "The index is signed by the key above, and it holds"
		printf '%s\n' "every bundle's sha256 -- so the signature covers this"
		printf '%s\n' "bundle as well. What it says is that the catalogue is"
		printf '%s\n' "the one that key publishes, not that the app is good."
	elif [ "${AP_ENT["kind"]}" = mods ]; then
		printf '\n%s\n' "This is a module -- native code, with no sandbox, that"
		printf '%s\n' "runs as you. It will not be installed from a catalogue"
		printf '%s\n' "this cannot verify, and it cannot verify this one."
	else
		printf '\n%s\n' "Nothing here says who wrote this app: this catalogue"
		printf '%s\n' "is not signed. TLS says which server the index came"
		printf '%s\n' "from and the sha256 says the bundle was not changed on"
		printf '%s\n' "the way; the rest is reading the file, which you can."
	fi
	return 0
}

# The bundle's address, resolved against the index's own: a relative path in
# the index means "beside the index", which is what makes a mirror a copy of
# one folder rather than a rewrite of every entry.
fn ap_bundleurl(bundle) {
	local u

	case $bundle in
	http://* | https://*) ret "$bundle"; return 0 ;;
	esac
	u := ap_url
	ret "${u%/*}/$bundle"
}

# Fetch a bundle and check it against what the index said. The temporary
# file is in the cache folder rather than /tmp: it can be large, and a
# fetch interrupted leaves it where the next one will overwrite it.
fn ap_getbundle(name, bundle, want) {
	local u tmp got

	u := ap_bundleurl "$bundle"
	mkdir -p "$AP_CACHE" || ap_die "cannot make $AP_CACHE"
	# The name is what a message calls this -- an id like
	# `control-panel/mailset.hibr` for a part -- so the temporary file
	# cannot be named after it directly.
	tmp="$AP_CACHE/${name//\//-}.part"
	rm -f "$tmp" 2> /dev/null
	need dav 2> /dev/null || ap_die "the dav module is needed to fetch a bundle"
	dav get "$u" "$tmp" 2> /dev/null ||
		ap_die "$u: could not be fetched${DAV_CODE:+ ($DAV_CODE)}"
	if [ -z "$want" ]; then
		rm -f "$tmp" 2> /dev/null
		ap_die "$name: the index gives no sha256, so the bundle cannot be verified"
	fi
	got := ap_sha "$tmp"
	if [ "$got" != "$want" ]; then
		rm -f "$tmp" 2> /dev/null
		# Two things cause this and the common one is harmless, so it
		# is named first. A bundle's path is stable -- it is
		# overwritten when a new version is published (Gitea #230) --
		# and a static host caches the index and each bundle
		# **independently**: GitHub Pages holds each for ten minutes
		# and a client cannot ask for a fresh one. Measured: three
		# distinct query strings all answered `x-cache: HIT` on the
		# same cached object, and `Cache-Control: no-cache` and
		# `Pragma: no-cache` both answered from the cache too. So for
		# a few minutes after a publish an index from before it can be
		# paired with a bundle from after it, and the hashes cannot
		# agree. Saying only "changed in transit or on a mirror" there
		# reads as tampering for what is a cache being a cache.
		ap_die "$name: the bundle is not what the index describes
  the index says $want
  what arrived is $got
Refused, and nothing was written. Most often this means the catalogue was
published in the last few minutes: a static host serves the index and the
bundle from its cache independently, so an index from before the publish
can be paired with a bundle from after it. Wait a few minutes and try
again. If it keeps happening, the bundle really was changed in transit or
on a mirror, and refusing is the right answer."
	fi
	ret "$tmp"
}

# Place an entry whose parts the **index** names: the file itself, and each
# part it brings as a plain file of its own. There were tarballs here until
# 0.99.189 -- a .tar.gz carrying an app.json saying where each member went
# -- and that was a container for a manifest of files, which is what the
# index already is, plus a binary blob in a git repository that nothing
# could diff (Gitea #231).
#
# What the tarball gave for free and this has to do deliberately: **every
# part is fetched and verified before any is written**. A bundle with one
# bad member is not a bundle to install the rest of, and that promise was
# structural when the bundle was one object.
#
# `ap_puttar` is still here for a catalogue that serves one, since an index
# may be anybody's.
fn ap_putparts(kind, name, src, key) {
	local i pk pn pp psha dest e t rel n=0
	local -a ptmp pkind pname

	e := ap_kext "$kind"
	for i in "${!AP_IX["$AP_SECT"]["$key"]["parts"][@]}"; do
		pk=${AP_IX["$AP_SECT"]["$key"]["parts"]["$i"]["kind"]}
		pn=${AP_IX["$AP_SECT"]["$key"]["parts"]["$i"]["as"]}
		pp=${AP_IX["$AP_SECT"]["$key"]["parts"]["$i"]["path"]}
		psha=${AP_IX["$AP_SECT"]["$key"]["parts"]["$i"]["sha256"]}
		if ! ap_partok "$pk" "$pn"; then
			rm -f "$src" "${ptmp[@]}" 2> /dev/null
			ap_die "$name: the index names a part as $pk/$pn
Refused. A part's kind is one of ${AP_KINDS[*]} and its own name is a plain
filename -- a part decides where a file lands."
		fi
		[ -n "$pp" ] || {
			rm -f "$src" "${ptmp[@]}" 2> /dev/null
			ap_die "$name: the index names the part $pk/$pn with no path to fetch it from"
		}
		# Verified here, one at a time, and nothing placed until the
		# loop has finished without dying. Bound with `:=` and not
		# captured with `$( )`: ap_getbundle refuses a bad part by
		# calling ap_die, and in a command substitution that would
		# exit the subshell and let the install carry on with a part
		# it could not verify.
		t := ap_getbundle "$pk/$pn" "$pp" "$psha"
		ptmp+=("$t")
		pkind+=("$pk")
		pname+=("$pn")
		n=$((n + 1))
	done
	dest := ap_dest "$kind" "$name" "${AP_ENT["dir"]}"
	rel := ap_rel "$kind" "$name" "${AP_ENT["dir"]}"
	mkdir -p "${dest%/*}" || ap_die "cannot make ${dest%/*}"
	mv -f "$src" "$dest" || ap_die "cannot put $dest in place"
	# The app's own file carries the entry's folder; a **part** never
	# does. A part names its own kind and filename and lands at the
	# root of that kind -- a Control Panel pane is found by one flat
	# scan, where only `apps` recurses -- so a folder under `apps` is
	# the app's alone (Gitea #233).
	AP_PLACED=("$rel$e")
	for i in "${!ptmp[@]}"; do
		pk=${pkind["$i"]}
		pn=${pname["$i"]}
		mkdir -p "$AP_DATA/$pk" || ap_die "cannot make $AP_DATA/$pk"
		mv -f "${ptmp["$i"]}" "$AP_DATA/$pk/$pn" ||
			ap_die "$name: cannot put $pk/$pn in place"
		AP_PLACED+=("$pk/$pn")
		ap_say "installed $pk/$pn, which $name brings with it"
	done
	ap_say "installed $name as $dest"
	return 0
}

# Place a single-file bundle: the app itself, which is most apps.
fn ap_putone(kind, name, src) {
	local dest e rel

	dest := ap_dest "$kind" "$name" "${AP_ENT["dir"]}"
	rel := ap_rel "$kind" "$name" "${AP_ENT["dir"]}"
	e := ap_kext "$kind"
	mkdir -p "${dest%/*}" || ap_die "cannot make ${dest%/*}"
	mv -f "$src" "$dest" || ap_die "cannot put $dest in place"
	AP_PLACED=("$rel$e")
	ap_say "installed $name as $dest"
	return 0
}

# A part of a bundle that is not the app: a Control Panel pane, a Control
# Strip module, a saver, or the picture a theme is drawn with. Named in the
# bundle's own app.json, because the index has no business knowing a
# bundle's layout, and checked here rather than trusted -- a part decides a
# *destination*, so the rules the member paths already follow (no climbing,
# no absolute, no .so) have to hold for where it lands as well as for where
# it came from.
#
# The name is a **filename**: `mailset.hibr`, `construction.png`. A part
# used to name a bare name and have `.hibr` appended, which a theme's own
# picture could not express -- it has to land beside the theme's JSON, in
# the same kind, under another extension (Gitea #224). `app.json` says `as`
# for the filename and the older `name` still means "with this kind's own
# extension", so every bundle published before this installs unchanged.
# The set holds the underscore because a part is a **filename the desktop
# already reads**: the retro car theme's picture is `retro_car.png`.
# `addapp` in the catalogue repository was the stricter of the two and
# refused that theme outright until Gitea #224.
fn ap_partok(kind, file) {
	ap_kindok "$kind" || return 1
	case $file in
	"" | .* | *[!a-z0-9._-]* | *..* ) return 1 ;;
	esac
	# A `.so` only where a `.so` belongs, which is a part of kind `mods`
	# -- the same rule ap_pathok keeps about where a member may come
	# from, asked here about where it is going (ADR 0044).
	case $file in
	*.so | *.so.*) [ "$kind" = mods ] || return 1 ;;
	esac
	return 0
}

# Place a tarball: every member read out of it and written as a plain file.
#
# ADR 0041 gave the reason as "`source` cannot read a scheme", and that
# stopped being true in 0.99.140: ADR 0043 taught `b_src` to ask `net_sch`,
# so `. /dev/archive/b/app.hibr` sources fine today and `BASH_SOURCE` is
# the scheme path. Re-examined for that in 0.99.183 and unpacking kept, on
# a different measurement: an app's resources live at "${DT_SRC%.hibr}/",
# and a module that opens its own path cannot see a scheme at all --
# `img size /tmp/x.png` answers `4 4` where `img size
# /dev/archive/b/x.png` is `cannot open`, and media and web read the same
# way. Mounting a bundle is therefore not one change but four modules'
# file handling, and an app with a picture in it would be the one that
# broke. The desktop's own scans glob `*.hibr` as well, so it would have
# to open every bundle at startup and hold a handle for its life.
#
# The app's own file goes to <kind>/NAME.hibr and everything else under
# <kind>/NAME/, rather than the whole bundle into a folder. Measured, not
# chosen by taste: dt_apps makes a subfolder a submenu, so a one-file app in
# apps/NAME/ would hang under an "Applications > NAME" submenu of its own
# with one item in it. This way the app is on the Applications menu where it
# belongs, DT_SRC is the app's real file so dt_aboutinfo reads its own
# header comment, and its resources are at "${DT_SRC%.hibr}/".
fn ap_puttar(kind, name, src) {
	local l k path app= dest dir rel n=0 j i pk pn pf pe ext
	local -A m
	local -a pfile pkind pname

	need archive 2> /dev/null || ap_die "the archive module is needed to unpack a bundle"
	archive open ap "$src" 2> /dev/null ||
		ap_die "$name: the bundle does not open as a tarball"
	AP_MEM=()
	ap_walk ap
	archive close ap
	[ "${#AP_MEM[@]}" -gt 0 ] || {
		rm -f "$src" 2> /dev/null
		ap_die "$name: the bundle is empty"
	}
	# Every member checked before anything is written, and the whole
	# bundle refused rather than the bad member skipped: a bundle with one
	# hostile path in it is not a bundle to install the rest of.
	for l in "${AP_MEM[@]}"; do
		k=${l%%	*}
		path=${l#*	}
		if [ "$k" = l ]; then
			rm -f "$src" 2> /dev/null
			ap_die "$name: the bundle holds a symbolic link, $path
Refused. A link in a bundle can point anywhere on this machine."
		fi
		ap_pathok "$path" "$kind" && continue
		rm -f "$src" 2> /dev/null
		case $path in
		*.so | *.so.*)
			ap_die "$name: the bundle holds a module, $path
Refused. A .so is native code with no sandbox of any kind. Only a bundle
of kind 'mods' may carry one, and it lands where a non-root shell looks
for a module asked for by name -- never where root looks (ADR 0016,
ADR 0044)." ;;
		esac
		ap_die "$name: the bundle holds $path, which is outside its own folder
Refused. A member path may not be absolute and may not climb with '..'."
	done
	archive open ap "$src" 2> /dev/null ||
		ap_die "$name: the bundle does not open as a tarball"
	# Which file is the app: what app.json says, else NAME.hibr, else the
	# only .hibr there is. The index has no business knowing a bundle's
	# own layout, which is why this is read from inside it.
	if j=$(archive cat ap app.json 2> /dev/null) &&
	   json parse m <<< "$j" 2> /dev/null; then
		app=${m["app"]}
		[ -n "${m["kind"]}" ] && kind=${m["kind"]}
		# The parts: one object each of file, kind and name, saying
		# which member goes to which of the desktop's scan roots.
		# Without this an app's own Control Panel pane could not
		# travel at all -- a bundle placed everything under the
		# app's own kind, and a pane is scanned from another
		# (Gitea #217).
		for i in "${!m["parts"][@]}"; do
			pf=${m["parts"]["$i"]["file"]}
			pk=${m["parts"]["$i"]["kind"]}
			# `as` is the filename to write; `name` is the older
			# form, which means "with this kind's own extension".
			pn=${m["parts"]["$i"]["as"]}
			if [ -z "$pn" ]; then
				pn=${m["parts"]["$i"]["name"]}
				[ -n "$pn" ] || pn=${pf##*/}
				pe := ap_kext "$pk"
				pn=${pn%"$pe"}$pe
			fi
			if ! ap_partok "$pk" "$pn"; then
				archive close ap
				rm -f "$src" 2> /dev/null
				ap_die "$name: the bundle names a part as $pk/$pn
Refused. A part's kind is one of ${AP_KINDS[*]} and its own name is a plain
filename -- a part decides where a file lands."
			fi
			pfile+=("$pf")
			pkind+=("$pk")
			pname+=("$pn")
		done
	fi
	# Which member is the thing itself: what app.json says, else
	# NAME with this kind's extension, else the only member that has it.
	# The extension is the kind's, so a theme's bundle is searched for a
	# .json and an app's for a .hibr (Gitea #224).
	ext := ap_kext "$kind"
	if [ -z "$app" ]; then
		for l in "${AP_MEM[@]}"; do
			[ "${l#*	}" = "$name$ext" ] && app=$name$ext
		done
	fi
	if [ -z "$app" ]; then
		for l in "${AP_MEM[@]}"; do
			path=${l#*	}
			case $path in
			*"$ext") if [ -z "$app" ]; then app=$path; else app=; break; fi ;;
			esac
		done
	fi
	if ! ap_kindok "$kind"; then
		archive close ap
		rm -f "$src" 2> /dev/null
		ap_die "$name: $kind is not a kind an app installs into"
	fi
	if [ -z "$app" ]; then
		archive close ap
		rm -f "$src" 2> /dev/null
		ap_die "$name: the bundle does not say which file is the app, and holds no $name$ext"
	fi
	# The entry's own folder, the same as every other placement path:
	# a tarball bundle is only a different wrapper, not a different
	# destination. Left flat here it would be worse than merely
	# inconsistent -- `ap_update` compares where an entry *would* land
	# with where the state says it is, so an entry with a `dir` and a
	# tarball would be reinstalled, placed flat again, and reported as
	# moving on every single update, for ever.
	dest := ap_dest "$kind" "$name" "${AP_ENT["dir"]}"
	dir := ap_destdir "$kind" "$name" "${AP_ENT["dir"]}"
	rel := ap_rel "$kind" "$name" "${AP_ENT["dir"]}"
	mkdir -p "${dest%/*}" || ap_die "cannot make ${dest%/*}"
	rm -rf "$dir" 2> /dev/null
	AP_PLACED=("$rel$ext")
	for l in "${AP_MEM[@]}"; do
		k=${l%%	*}
		path=${l#*	}
		[ "$path" = "app.json" ] && continue
		# A part is placed below, in its own kind's folder, so it is
		# not also a resource of this app's own.
		for i in "${!pfile[@]}"; do
			[ "$path" = "${pfile["$i"]}" ] && { path=; break ; }
		done
		[ -n "$path" ] || continue
		if [ "$k" = d ]; then
			mkdir -p "$dir/$path" || ap_die "cannot make $dir/$path"
			continue
		fi
		if [ "$path" = "$app" ]; then
			archive cat ap "$path" > "$dest" ||
				ap_die "cannot write $dest"
			continue
		fi
		case $path in
		*/*) mkdir -p "$dir/${path%/*}" ||
			ap_die "cannot make $dir/${path%/*}" ;;
		*) mkdir -p "$dir" || ap_die "cannot make $dir" ;;
		esac
		archive cat ap "$path" > "$dir/$path" ||
			ap_die "cannot write $dir/$path"
		n=$((n + 1))
	done
	# And every part into the scan root it named. Each is a file of its
	# own there, not a folder: a pane is read exactly as one the person
	# wrote, which is the whole of ADR 0041's model.
	for i in "${!pfile[@]}"; do
		pk=${pkind["$i"]}
		pn=${pname["$i"]}
		mkdir -p "$AP_DATA/$pk" || ap_die "cannot make $AP_DATA/$pk"
		archive cat ap "${pfile["$i"]}" > "$AP_DATA/$pk/$pn" ||
			ap_die "$name: the bundle has no ${pfile["$i"]} to place as $pk/$pn"
		AP_PLACED+=("$pk/$pn")
		ap_say "installed $pk/$pn, which $name brings with it"
	done
	archive close ap
	rm -f "$src" 2> /dev/null
	# A bundle of only the app leaves no folder behind to confuse anyone.
	[ "$n" = 0 ] && rm -rf "$dir" 2> /dev/null
	[ "$n" = 0 ] || AP_PLACED+=("$rel")
	if [ "$n" = 0 ]; then
		ap_say "installed $name as $dest"
	else
		ap_say "installed $name as $dest, with $n file(s) in $dir"
	fi
	return 0
}

# What an entry says it needs, checked rather than printed. `catalogue info` has
# shown `needs hibr X, module ABI Y, modules: Z` from the beginning and
# nothing ever read those fields, so an app needing the db module installed
# happily on a machine without it and failed at its first call, in a window,
# as a shell error in desktop.log. An index field nothing enforces reads as
# a promise (Gitea #217).
# This machine, as the catalogue spells it: the system and the machine,
# lowercased and joined -- `linux-x86_64`, `darwin-arm64`.
#
# From the shell's own `$OSTYPE` and `$HOSTTYPE` since 0.99.195, which
# hibr sets at startup from `uname()` the way bash does, so this is a
# string operation where it used to be a fork -- and a fork per entry
# that declares an arch, which `catalogue install apps/` makes twenty-one of.
# They are bash's names rather than one of ours on purpose: every script
# already knows them, and `HIBR_ARCH` is taken -- it means the arena's
# chunk size.
#
# `$OSTYPE` is bash's spelling, not the catalogue's: `linux-gnu` where
# a bundle path says `linux`, and `darwin23` where it says `darwin`. So
# the first `-` and any trailing digits come off, which is the whole
# difference between the two vocabularies. A shell too old to set it at
# all falls back to the fork rather than guessing.
fn ap_arch() {
	local u o

	if [ -n "${OSTYPE-}" ] && [ -n "${HOSTTYPE-}" ]; then
		o=${OSTYPE%%-*}
		o=${o%%[0-9]*}
		ret "${o,,}-${HOSTTYPE,,}"
		return 0
	fi
	u := uname -sm
	u=${u,,}
	ret "${u% *}-${u#* }"
}

fn ap_needs(name) {
	local abi hv m oldest arch here
	local -a mods

	# A module is built for one ABI and one machine, and neither is a
	# thing to find out after fetching it (ADR 0044). An entry that
	# names no arch is a script, and says nothing about machines.
	arch=${AP_ENT["arch"]}
	if [ -n "$arch" ]; then
		here := ap_arch
		[ "$arch" = "$here" ] ||
			ap_die "$name: is built for $arch and this is $here
A module is native code: it cannot be loaded on another machine."
	fi
	abi=${AP_ENT["abi"]}
	if [ -n "$abi" ] && [ "$abi" != "$HIBR_ABI" ]; then
		ap_die "$name: needs module ABI $abi and this hibr has $HIBR_ABI
A module's ABI must match exactly, so this app's own module could not load."
	fi
	hv=${AP_ENT["hibr"]}
	if [ -n "$hv" ]; then
		# The older of the two: if that is not the one asked for,
		# this hibr is older than the app needs.
		oldest=$(printf '%s\n%s\n' "$hv" "$HIBR_VERSION" |
			 command sort -V | command head -1) ||
			ap_die "sort is needed to compare versions"
		[ "$oldest" = "$hv" ] ||
			ap_die "$name: needs hibr $hv or newer, and this is $HIBR_VERSION"
	fi
	# What the entry needs loaded before it can run. Three answers in
	# order, and only the third is a refusal (ADR 0045).
	#
	# **Already loadable** is satisfied, and covers everything hibr
	# ships -- `need` resolves an interface as well as a module name,
	# so `terminal` finds `term.so` the way the app itself does.
	#
	# **In this catalogue as `mods/NAME`** is collected into AP_WANT for
	# the caller to install first. It is not installed from here: this
	# function runs before anything is fetched, on purpose, so that an
	# entry this hibr cannot satisfy costs nothing and leaves nothing
	# behind -- and an install that started placing modules from inside
	# a check would break that promise.
	#
	# **Neither** is the end of it. An entry naming a module that is
	# nowhere is a broken entry, not a machine that is missing
	# something, and installing an app that cannot work is worse than
	# saying so.
	AP_WANT=()
	if [ -n "${AP_ENT["modules"]}" ]; then
		IFS=', ' read -ra mods <<< "${AP_ENT["modules"]}"
		for m in "${mods[@]}"; do
			[ -n "$m" ] || continue
			need "$m" 2> /dev/null && continue
			if ap_entry "mods/$m" > /dev/null 2>&1; then
				AP_WANT+=("mods/$m")
				continue
			fi
			ap_die "$name: needs the $m module, which neither hibr
nor this catalogue provides. Nothing was installed."
		done
	fi
	# `ap_entry` above overwrote AP_ENT with whichever module it last
	# looked at, and every caller of this reads AP_ENT afterwards --
	# the bundle, the sha256, the name it installs under. Put it back.
	# Without this an app that needs a fetchable module is installed
	# *as that module*, which is a silent wrong file rather than an
	# error, and only shows up as the app being missing.
	[ "${#AP_WANT[@]}" -gt 0 ] && ap_entry "$name"
	return 0
}

# Every entry of one kind, for `catalogue install apps/` -- a trailing slash
# and nothing after it means the whole of that kind. The desktop ships no
# applications since 0.99.194 (Gitea #220), so putting a full desktop
# back is one command rather than twenty-one, and that is the difference
# between a policy and a chore. Unambiguous because a real id always has
# a name after the slash.
fn ap_ofkind(kind) {
	local k n=0
	local -a out

	ap_kindok "$kind" ||
		ap_die "$kind: not a kind -- one of ${AP_KINDS[*]}"
	for k in "${!AP_IX["$AP_SECT"][@]}"; do
		ap_entry "$k" || continue
		[ "${AP_ENT["kind"]}" = "$kind" ] || continue
		out+=("${AP_ENT["id"]}")
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] || ap_die "nothing of kind $kind in the index"
	ret "${out[*]}"
}

# One module, fetched because an entry said it needed it. A module is
# never a `part` -- a part is removed with its owner, and `pim` serves
# Calendar, Contacts and anybody's script (ADR 0045) -- so it is
# installed as an entry of its own and the state remembers *why*, which
# is the whole of what a later `purge` reads.
#
# A module entry declares no modules of its own: `mkindex` writes the
# field only for a script, so this cannot recurse. That is deliberate
# rather than lucky -- what a module needs is `hibr_require`'s business,
# resolved when it loads, and a catalogue second-guessing it would be
# two answers to one question.
fn ap_getmod(mid, why) {
	local tmp i
	local -a placed

	ap_entry "$mid" ||
		ap_die "$why: needs $mid, which went missing from the index between the check and the fetch"
	# The same refusal an explicit `catalogue install mods/x` gets, for the
	# same reason: a module is native code and runs as you, so an
	# unverifiable catalogue is the end of it (ADR 0044). Coming here
	# by way of an app's own declaration changes nothing about that.
	ap_verify
	[ "$AP_SIGOK" = 1 ] ||
		ap_die "$why needs the ${AP_ENT["name"]} module, and this catalogue cannot be verified
$AP_SIGWHY.
A module is native code and runs as you: a signature is not optional for
one (ADR 0044). Nothing was installed."
	ap_needs "$mid"
	# `mkindex` writes no `modules` for a module -- what a module needs
	# is `hibr_require`'s business, resolved when it loads -- so this
	# is empty for every entry this catalogue publishes. A hand-written
	# index could say otherwise, and silently not installing what it
	# asked for is the worst of the three possible answers: refusing
	# says what happened, and installing would mean recursion with no
	# bound on it.
	[ "${#AP_WANT[@]}" = 0 ] ||
		ap_die "$mid: the index says this module needs ${AP_WANT[*]}
A module's own requirements are resolved when it loads, not by this
catalogue, so nothing here can satisfy that. Nothing was installed."
	tmp := ap_getbundle "${AP_ENT["name"]}" "${AP_ENT["bundle"]}" \
			    "${AP_ENT["sha256"]}"
	ap_putone mods "${AP_ENT["name"]}" "$tmp"
	ap_say "  -- which $why needs"
	AP_ST["installed"]["$mid"]["version"]=${AP_ENT["version"]}
	AP_ST["installed"]["$mid"]["kind"]=mods
	AP_ST["installed"]["$mid"]["sha256"]=${AP_ENT["sha256"]}
	# Why it is here, which is what tells a later `purge` that nobody
	# asked for this one by name. An explicit `catalogue install mods/pim`
	# does not set it, so purge leaves that one alone.
	AP_ST["installed"]["$mid"]["auto"]=$why
	unset AP_ST["installed"]["$mid"]["paths"]
	placed=("${AP_PLACED[@]}")
	for i in "${!placed[@]}"; do
		AP_ST["installed"]["$mid"]["paths"]["$i"]=${placed["$i"]}
	done
	ap_statesave
	return 0
}

# What the previous install of this entry left that the one just placed
# does not include, removed. Called after the files are in place and
# before the state is rewritten, which is the only moment both lists
# exist.
fn ap_stale(name) {
	local i p keep
	local -a old

	for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
		old+=("${AP_ST["installed"]["$name"]["paths"]["$i"]}")
	done
	[ "${#old[@]}" -gt 0 ] || return 0
	for p in "${old[@]}"; do
		keep=
		for i in "${AP_PLACED[@]}"; do
			[ "$i" = "$p" ] && { keep=1; break ; }
		done
		[ -n "$keep" ] && continue
		ap_claimed "$p" "$name" && continue
		[ -e "$AP_DATA/$p" ] || continue
		case $p in
		*/) rm -rf "$AP_DATA/$p" 2> /dev/null ;;
		*.hibr | *.json | *.so | *.png) rm -f "$AP_DATA/$p" 2> /dev/null ;;
		*) rm -rf "$AP_DATA/$p" 2> /dev/null ;;
		esac
		ap_say "took away $p, which this version no longer places"
	done
	return 0
}

fn ap_install(...names) {
	local name want tmp kind i ext all mid sysv
	local -a wants

	[ "${#names[@]}" -gt 0 ] || ap_die "usage: catalogue install NAME..."
	# The index again, always: installing against a stale one is how a
	# sha256 mismatch gets blamed on the mirror.
	ap_load 1
	ap_state
	# `KIND/` expanded first, so what follows is one loop over ids and
	# every refusal reads the same whichever way the name was given.
	for want in "${names[@]}"; do
		case $want in
		*/)
			all := ap_ofkind "${want%/}"
			read -ra wants <<< "$all"
			names+=("${wants[@]}")
			;;
		esac
	done
	for want in "${names[@]}"; do
		case $want in */) continue ;; esac
		name := ap_resolve "$want" ||
			ap_die "$want: no such app in the index"
		ap_entry "$name" || ap_die "$name: no such app in the index"
		kind=${AP_ENT["kind"]}
		ap_kindok "$kind" ||
			ap_die "$name: the index says kind $kind, which is not one an app installs into"
		# Where the two kinds part. A script says what it is on the
		# screen; its reader is the backstop, so an unverified
		# catalogue is a sentence and the install goes on. A module
		# has no reader and runs as you, so an unverified catalogue
		# is the end of it -- without this the signature is
		# decoration and `catalogue info` would be claiming a check
		# nothing makes (ADR 0044).
		if [ "$kind" = mods ]; then
			ap_verify
			[ "$AP_SIGOK" = 1 ] ||
				ap_die "$name: refusing to install a module from a catalogue this cannot verify
$AP_SIGWHY.
A module is native code and runs as you: a signature is not optional for
one, where for a script the sha256 and TLS are the stated trust model and
you can read the file (ADR 0041, ADR 0044)."
		else
			ap_sigsay
		fi
		# Already there for the whole machine? Then there is
		# nothing a copy in one person's home could do. An
		# administrator's install is **authoritative** -- the
		# machine's scope is read before anybody's own data folder
		# (ADR 0045) -- so a second copy would not be a newer
		# version winning, it would be a file that is never read,
		# taking space and drifting out of date in silence.
		#
		# Refused whatever the versions say, for that reason: a
		# newer one in a folder nothing reads is worth less than
		# no copy at all. The way to run something the machine does
		# not provide is ~/.config/hibr/apps, which is a file you
		# wrote rather than one a catalogue placed, and is the one
		# thing read before the machine's.
		sysv := ap_sysver "$name" &&
			ap_die "$name: the machine already has this, at $sysv
An install for the whole machine is authoritative: it is read before
your own, so a copy here would never run. To change what you get, put
a file of your own in ~/.config/hibr/apps, which is read before either
and which no update overwrites."
		# Before fetching, not after: refusing an app this hibr
		# cannot run should cost nothing and leave nothing behind.
		ap_needs "$name"
		# Whatever it needs that is not loadable here and is in this
		# catalogue, placed before the thing that needs it -- so an
		# app is never on disk in a state where its first `need`
		# fails. ap_needs has already refused anything that is in
		# neither place, before a byte was fetched.
		if [ "${#AP_WANT[@]}" -gt 0 ]; then
			for mid in "${AP_WANT[@]}"; do
				ap_getmod "$mid" "$name"
			done
			# ap_getmod walked AP_ENT onto each module in turn;
			# every line below reads it for *this* entry.
			ap_entry "$name" || ap_die "$name: no such app in the index"
		fi
		tmp := ap_getbundle "${AP_ENT["name"]}" "${AP_ENT["bundle"]}" \
				    "${AP_ENT["sha256"]}"
		# A bundle that is the file itself, or a tarball: decided by
		# the **kind's** own extension rather than by `.hibr`, so a
		# theme or a colour scheme (which are JSON) is placed as
		# itself instead of being opened as an archive (Gitea #224).
		ext := ap_kext "$kind"
		case ${AP_ENT["bundle"]} in
		*"$ext")
			# An entry that brings parts is placed with them, each
			# fetched and verified first (Gitea #231); one that
			# brings none is the file itself, which is most.
			if [ "${#AP_IX["$AP_SECT"]["${AP_ENT["key"]}"]["parts"][@]}" -gt 0 ]; then
				ap_putparts "$kind" "${AP_ENT["name"]}" "$tmp" \
					    "${AP_ENT["key"]}"
			else
				ap_putone "$kind" "${AP_ENT["name"]}" "$tmp"
			fi ;;
		*) ap_puttar "$kind" "${AP_ENT["name"]}" "$tmp" ;;
		esac
		name=${AP_ENT["id"]}
		# Whatever the last install of this entry placed and this
		# one did not. Reinstalling has always written the new paths
		# over the old record and left the old *files*, so an entry
		# that stopped bringing a part left it behind for ever --
		# invisible, since nothing on disk says who put it there.
		# `dir` made that reachable rather than merely untidy: an
		# app that used to land as `apps/mail.hibr` now lands as
		# `apps/Internet/mail.hibr`, and without this both are on
		# the scan path at once (Gitea #233).
		#
		# A path another installed entry also brings is kept, the
		# same refcount `ap_remove` asks -- `ap_claimed` is the one
		# place that question is answered.
		ap_stale "$name"
		AP_ST["installed"]["$name"]["version"]=${AP_ENT["version"]}
		AP_ST["installed"]["$name"]["kind"]=$kind
		AP_ST["installed"]["$name"]["sha256"]=${AP_ENT["sha256"]}
		# Every path this placed, so removing takes away what was
		# installed rather than what the kind and the name imply: a
		# bundle may bring a pane or a strip module with it, and
		# nothing on disk says so (Gitea #217).
		unset AP_ST["installed"]["$name"]["paths"]
		for i in "${!AP_PLACED[@]}"; do
			AP_ST["installed"]["$name"]["paths"]["$i"]=${AP_PLACED["$i"]}
		done
		ap_statesave
	done
	return 0
}

# Whether any *other* installed app brings this same path. One Control Panel
# pane serves Calendar and Contacts both, so removing one of the two must
# leave the other's pane where it is -- which is bookkeeping, not a guess:
# the state says what each app placed (Gitea #217).
fn ap_claimed(path, except) {
	local other i

	for other in "${!AP_ST["installed"][@]}"; do
		[ "$other" = "$except" ] && continue
		for i in "${!AP_ST["installed"]["$other"]["paths"][@]}"; do
			[ "${AP_ST["installed"]["$other"]["paths"]["$i"]}" = "$path" ] &&
				return 0
		done
	done
	return 1
}

# Is any installed entry still asking for this module? Read from each
# one's own `modules`, which is the index's answer rather than a second
# list kept here -- so an app whose declaration changed is believed at
# its current version, not at the one it was installed from.
#
# It reads the state this process has, which today is the user's own.
# When a **system** scope lands (ADR 0045) there is a second state above
# this one, and a user's purge must not take a module a system-installed
# app needs: this is the one function that has to learn about it, and
# the seam is left visible rather than generalised in advance.
fn ap_wanted(mod) {
	local name m
	local -a mods

	for name in "${!AP_ST["installed"][@]}"; do
		[ "${AP_ST["installed"]["$name"]["kind"]}" = mods ] && continue
		ap_entry "$name" || continue
		[ -n "${AP_ENT["modules"]}" ] || continue
		IFS=', ' read -ra mods <<< "${AP_ENT["modules"]}"
		for m in "${mods[@]}"; do
			[ "$m" = "$mod" ] && return 0
		done
	done
	return 1
}

# Modules that were fetched **because something needed them** and that
# nothing installed needs now. A module installed by name is never here:
# `auto` is set only by ap_getmod, so asking for `mods/pim` yourself
# makes it yours and purge leaves it alone for ever.
#
# Native code is never removed as a side effect of removing something
# else, which is why this is a verb and not a step inside `remove`: the
# refcount can only see what this catalogue installed, and a script of
# your own that calls `need pim` is invisible to it. Deleting it behind
# that script's back is a worse failure than leaving a megabyte on disk.
fn ap_purge(...args) {
	local a yes=0 dry=0 name base n=0 ans
	local -a gone

	for a in "${args[@]}"; do
		case $a in
		-y | --yes) yes=1 ;;
		-n | --dry-run) dry=1 ;;
		*) ap_die "usage: catalogue purge [-y] [--dry-run]" ;;
		esac
	done
	ap_load
	ap_state
	for name in "${!AP_ST["installed"][@]}"; do
		[ "${AP_ST["installed"]["$name"]["kind"]}" = mods ] || continue
		[ -n "${AP_ST["installed"]["$name"]["auto"]}" ] || continue
		base=${name##*/}
		ap_wanted "$base" && continue
		gone+=("$name")
		n=$((n + 1))
	done
	if [ "$n" = 0 ]; then
		ap_say "nothing to purge: every module here was asked for by name, or something still needs it"
		return 0
	fi
	# What it can see is one scope's state. A user's purge cannot reach
	# a system install and must not, which falls out of AP_STATE moving
	# with the scope; a **system** purge cannot see what any individual
	# has installed in their own home, and that one is a real limit
	# rather than a safe one, so it is said rather than implied.
	[ "$AP_SCOPE" = system ] &&
		ap_say "this reads the system scope only; a module some user's own app needs is not visible here"
	printf 'fetched for something that is gone, and nothing installed needs now:\n'
	for name in "${gone[@]}"; do
		printf '  %-22s was needed by %s\n' "$name" \
		       "${AP_ST["installed"]["$name"]["auto"]}"
	done
	[ "$dry" = 1 ] && return 0
	# A desktop runs this as a child with no terminal, so there is
	# nobody to answer: refusing is the only honest thing, and it names
	# the flag rather than hanging on a read that can never return.
	if [ "$yes" = 0 ]; then
		if [ ! -t 0 ]; then
			ap_die "nothing was removed: there is no terminal to ask on.
Run it with -y to remove these without being asked, or --dry-run to
list them and stop."
		fi
		printf 'remove these? [y/N] '
		read -r ans
		case $ans in
		y | Y | yes) ;;
		*) ap_say "nothing was removed"; return 0 ;;
		esac
	fi
	ap_remove -f "${gone[@]}"
	return 0
}

fn ap_remove(...names) {
	local name w base kind dest dir n force=0 i p np
	local -a want

	for name in "${names[@]}"; do
		case $name in
		-f | --force) force=1 ;;
		*) want+=("$name") ;;
		esac
	done
	[ "${#want[@]}" -gt 0 ] || ap_die "usage: catalogue remove [-f] NAME..."
	ap_state
	for w in "${want[@]}"; do
		name := ap_insresolve "$w" || ap_die "$w: not installed here"
		kind=${AP_ST["installed"]["$name"]["kind"]}
		[ -n "$kind" ] || ap_die "$w: not installed here"
		base=${name##*/}
		# Only when the answer can change what happens. `ap_windows`
		# asks a running desktop over its control socket, and a
		# desktop wedged mid-request is a connect that neither fails
		# nor completes (Gitea #180) -- so under `-f`, where the
		# answer is discarded, asking it is a question whose only
		# possible effect is to hang. `catalogue purge -y` in an
		# image build is exactly that case.
		n=0
		[ "$force" = 0 ] && n := ap_windows "$base"
		if [ "$n" -gt 0 ]; then
			ap_die "$w: $n window(s) of it are open ($AP_WINS)
Close them first, or `catalogue remove -f $w`. Removing it frees the folder
its code is read from, and the desktop would be left calling functions with
nothing behind them."
		fi
		np=0
		for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
			np=$((np + 1))
		done
		if [ "$np" = 0 ]; then
			# Installed before 0.99.183, when nothing recorded
			# what it placed: the kind and the name are all there
			# is, which is what this always did.
			dest := ap_dest "$kind" "$base"
			dir := ap_destdir "$kind" "$base"
			rm -f "$dest" 2> /dev/null
			rm -rf "$dir" 2> /dev/null
		else
			for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
				p=${AP_ST["installed"]["$name"]["paths"]["$i"]}
				if ap_claimed "$p" "$name"; then
					ap_say "kept $p, which another installed app brings too"
					continue
				fi
				case $p in
				*.hibr) rm -f "$AP_DATA/$p" 2> /dev/null ;;
				*) rm -rf "$AP_DATA/$p" 2> /dev/null ;;
				esac
			done
		fi
		unset AP_ST["installed"]["$name"]
		ap_statesave
		ap_say "removed $name"
	done
	return 0
}

fn ap_update(...names) {
	local name w n=0 kind where ext moved i np
	local -a want

	ap_load 1
	ap_state
	if [ "${#names[@]}" -gt 0 ]; then
		want=("${names[@]}")
	else
		for name in "${!AP_ST["installed"][@]}"; do want+=("$name"); done
	fi
	for w in "${want[@]}"; do
		# Either an id from the state or a name somebody typed:
		# ap_entry takes both, and ap_resolve is for the ambiguous
		# bare name it cannot.
		if ! ap_entry "$w"; then
			name := ap_resolve "$w" ||
				ap_die "$w: no such app in the index"
			ap_entry "$name" ||
				ap_die "$name: no such app in the index"
		fi
		# The state is keyed by the id, which is the entry's own and
		# not whatever the index key happened to be.
		name=${AP_ENT["id"]}
		kind=${AP_ST["installed"]["$name"]["kind"]}
		[ -n "$kind" ] || ap_die "$w: not installed here"
		# Up to date is not only "the same version". An entry can
		# move without changing version -- `dir` arrived in 0.99.195
		# and put every application in a folder, which is a new
		# **path** for the same bytes -- and an update that compares
		# versions alone leaves it where it was for ever. Found by
		# upgrading and watching twenty-one applications stay flat
		# while the index said they belonged in four folders
		# (Gitea #233).
		#
		# Asked of the path rather than of the version, so it needs
		# no second thing to keep in step: where would this land
		# now, and is that where the state says it is.
		where := ap_rel "$kind" "${AP_ENT["name"]}" "${AP_ENT["dir"]}"
		ext := ap_kext "$kind"
		moved=1
		np=0
		for i in "${!AP_ST["installed"]["$name"]["paths"][@]}"; do
			np=$((np + 1))
			[ "${AP_ST["installed"]["$name"]["paths"]["$i"]}" = "$where$ext" ] &&
				{ moved=; break ; }
		done
		if [ "${AP_ENT["version"]}" = "${AP_ST["installed"]["$name"]["version"]}" ] &&
		   [ -z "$moved" ]; then
			continue
		fi
		# Three different things, and each says which it is. An
		# entry installed before 0.99.183 recorded no paths at all,
		# so there is nothing to compare and it is reinstalled once
		# to write them down -- which is not a move, and calling it
		# one would be this release's own complaint about a sentence
		# that says a false thing.
		if [ -n "$moved" ] && [ "$np" = 0 ]; then
			ap_say "$name: records where it is"
		elif [ -n "$moved" ]; then
			ap_say "$name: moves to $where$ext"
		else
			ap_say "$name: ${AP_ST["installed"]["$name"]["version"]} -> ${AP_ENT["version"]}"
		fi
		ap_install "$name"
		n=$((n + 1))
	done
	[ "$n" = 0 ] && ap_say "everything is up to date"
	return 0
}

fn ap_setindex(url = "") {
	local u
	local -A c

	if [ -z "$url" ]; then
		u := ap_url
		ap_say "$u"
		return 0
	fi
	case $url in
	https://*) ;;
	http://*)
		echo "catalogue: $url is not https, so nothing says which server answered" >&2
		;;
	*) ap_die "$url: an index is an http:// or https:// address" ;;
	esac
	mkdir -p "${AP_CONF%/*}" || ap_die "cannot make ${AP_CONF%/*}"
	c["url"]=$url
	local j tmp
	j=$(json emit c) || ap_die "cannot emit the setting"
	# Renamed into place for the same reason the state is: a half-written
	# settings file would lose the index address, and the default would
	# then quietly take over (Gitea #241).
	tmp=$AP_CONF.$$
	printf '%s\n' "$j" > "$tmp" || {
		rm -f "$tmp" 2> /dev/null
		ap_die "cannot write $tmp"
	}
	mv -f "$tmp" "$AP_CONF" || {
		rm -f "$tmp" 2> /dev/null
		ap_die "cannot replace $AP_CONF"
	}
	AP_URL=$url
	rm -f "$AP_INDEX" 2> /dev/null
	ap_say "the index is $url"
	return 0
}

# What it does, in the one place somebody asks. Until 0.99.138 this lived
# only in a comment at the top of this file and in ADR 0041: a wrong verb
# got two lines on standard error and there was no way to ask at all, which
# is the Sheet lesson in another costume -- work already paid for and never
# handed over.
ap_help() {
	printf '%s\n' \
	"catalogue -- what the desktop runs: applications, themes, colour" \
	"schemes, languages and modules, fetched from an index over HTTPS" \
	"" \
	"  catalogue list [TEXT]       what the index offers, or what matches TEXT" \
	"  catalogue installed         what is installed here, and from where;" \
	"                              '+N parts' is what an entry brought with" \
	"                              it, and the last line reconciles entries" \
	"                              against files" \
	"  catalogue owns PATH         what a file is and who put it there --" \
	"                              yours, an app's part, the machine's, or" \
	"                              the copy hibr ships" \
	"  catalogue check [--repair]  the record against the files: a claim" \
	"                              with no file, and a file nothing claims." \
	"                              --repair makes the record true and" \
	"                              removes nothing" \
	"  catalogue info NAME         everything the index says about one" \
	"  catalogue show NAME         fetch it, verify it, and print it -- read an" \
	"                         app before you install it, which a catalogue" \
	"                         of scripts can offer and a package manager" \
	"                         cannot" \
	"" \
	"  -j on list, installed or info answers JSON instead of columns, for" \
	"  anything that is not a person: the desktop's Applications window" \
	"  reads that rather than parsing these columns, so the window and the" \
	"  command read one answer instead of one parsing the other's layout." \
	"" \
	"  catalogue install NAME...   fetch, verify and place" \
	"  catalogue install KIND/     every app of one kind, so a bare desktop" \
	"                         comes back in one command: 'catalogue install" \
	"                         apps/' places every application, and" \
	"                         'catalogue install themes/' every theme" \
	"  catalogue remove [-f] NAME  take one away; -f even if a window is open" \
	"  --system on any of them installs into, removes from or lists" \
	"  the machine's own scope rather than your own: one copy for" \
	"  every user, in \$HIBR_SYSDIR, which only root can write. Your" \
	"  own copy of a thing still wins over the machine's, and the" \
	"  machine's over what hibr shipped. An unsigned catalogue is" \
	"  refused there, where for your own scope it is a warning: the" \
	"  people who run it are not the person who read it." \
	"" \
	"  catalogue purge        take away modules that were fetched for" \
	"                         something that is gone and that nothing" \
	"                         installed needs now; -y to skip the ask," \
	"                         --dry-run to list them and stop. A module" \
	"                         you asked for by name is never purged" \
	"  catalogue update [NAME...]  everything with a newer version, or these" \
	"  catalogue index [URL]       the index this fetches from, or set it" \
	"  catalogue refresh           fetch the index again now" \
	"  catalogue help              this" \
	"" \
	"An app is a folder of plain files and a bundle is only how it travels;" \
	"installing is placing a file where the desktop already looks. Your own" \
	"file of the same name shadows a fetched one, and an update cannot" \
	"overwrite it." \
	"" \
	"TLS says which server the index came from and the sha256 says the" \
	"bundle was not changed on the way. Who wrote it is the signature on" \
	"the index, which covers every bundle through those hashes:" \
	"'catalogue info NAME' says whether this catalogue has one that checks out." \
	"" \
	"A module -- kind 'mods' -- is the one thing here that is native code" \
	"rather than a file you can read, so it is refused outright from a" \
	"catalogue that cannot be verified, where a script is installed with a" \
	"warning. It lands in \$XDG_DATA_HOME/hibr/mods, which a non-root shell" \
	"searches when something asks for a module by name: 'need NAME' finds" \
	"one installed here, and a mistyped command never loads it." \
	"" \
	"See docs/catalogue.md, docs/adr/0041, docs/adr/0044 and" \
	"docs/adr/0045."
}

ap_usage() {
	echo "usage: catalogue [-j] list [TEXT] | [-j] installed | [-j] info NAME |" >&2
	echo "       (kinds: ${AP_KINDS[*]})" >&2
	echo "       show NAME | install NAME...|KIND/ | remove [-f] NAME... |" >&2
	echo "       update [NAME...] | owns PATH | check [--repair] |" >&2
	echo "       purge [-y] | index [URL] | refresh | help" >&2
	echo "       --system on any of them: the machine's scope, not yours" >&2
	exit 2
}

# `-j` anywhere in the arguments of a verb that answers something: the
# desktop reads JSON where a person reads columns.
AP_J=0
AP_WANTSYS=0
ap_args=()
for a in "$@"; do
	case $a in
	-j | --json) AP_J=1 ;;
	--system) AP_WANTSYS=1 ;;
	*) ap_args+=("$a") ;;
	esac
done
set -- "${ap_args[@]}"
# Before any verb runs, so nothing reads a path from one scope and
# writes to another.
[ "$AP_WANTSYS" = 1 ] && ap_scope system

# A verb that writes asks first, so a scope this account cannot write to is
# a sentence rather than a half-done install (Gitea #238). Reading is never
# gated: `--system list` is what somebody runs before reaching for sudo.
# A verb that writes takes the lock **before** it reads, since a lock
# taken after the read serialises the writes and loses the update all the
# same (Gitea #242). Reading verbs take none and need none: the state is
# renamed into place, so a reader sees one whole file or the other.
case ${1-} in
install | remove | uninstall | update | upgrade | purge)
	ap_needwrite "$1"
	ap_lock
	;;
esac

case ${1-} in
list) shift; ap_list "${1-}" "$AP_J" ;;
installed) ap_installed "$AP_J" ;;
info) [ -n "${2-}" ] || ap_usage; ap_info "$2" "$AP_J" ;;
show | read) [ -n "${2-}" ] || ap_usage; ap_show "$2" ;;
install) shift; ap_install "$@" ;;
remove | uninstall) shift; ap_remove "$@" ;;
owns | owner) shift; ap_owns "$@" ;;
check) shift; ap_check "$@" ;;
purge) shift; ap_purge "$@" ;;
update | upgrade) shift; ap_update "$@" ;;
index) ap_setindex "${2-}" ;;
refresh) ap_load 1; ap_say "the index is up to date" ;;
help | --help | -h) ap_help ;;
*) ap_usage ;;
esac
