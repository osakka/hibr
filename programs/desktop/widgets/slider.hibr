# widgets/slider -- a slider.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# Draw a slider: a track of ─ over w columns with a ● at the position
# value falls between min and max, arrow keys the way to change it once
# the row is selected -- clicking selects it, the same as a dropdown
# before it is opened, but there is no popup to open; the track is a
# picture of the value, not a control of its own to press at a given
# column. tag is what dt_hit answers for a click on it.
fn dt_slider(int id, int r, int c, int w, int value, int min, int max, tag) {
	local tag=${tag:-$value}
	local pos i t

	pos=0
	[ "$max" -gt "$min" ] &&
		pos=$(( (value - min) * (w - 1) / (max - min) ))
	[ "$pos" -lt 0 ] && pos=0
	[ "$pos" -gt $((w - 1)) ] && pos=$((w - 1))
	t=""
	i=0
	while [ "$i" -lt "$w" ]; do
		[ "$i" = "$pos" ] && t="$t${GL[circle]}" || t="$t${GL[hline]}"
		i=$((i + 1))
	done
	if dt_hot "$id" "$tag"; then
		console pen -s
		console pen "$DT_ACTIVE" "$DT_WELL"
		console put -p "w$id" "$r" "$c" "$t"
		console pen -r
	else
		console put -p "w$id" "$r" "$c" "$t"
	fi
	dt_wreg "$id" "$r" "$c" "$w" "$tag"
}

# The value a click at column c means, for a track of w columns that starts
# at c0 and runs from min to max: the inverse of the position above, and in
# this file beside it so the two cannot drift. A caller clamps and snaps to
# its own step, because the step is the setting's business and not the
# track's -- a track eleven columns wide has eleven positions whatever the
# range is. frac is where in the cell the pointer was, in thousandths, from
# dt_cellpx where the terminal reports pixels, so a step finer than a cell
# can be chosen (Gitea #370); 500, the middle, is exactly the column.
fn dt_slidepos(int c, int c0, int w, int min, int max, int frac = 500) {
	local v=$min

	[ "$w" -gt 1 ] && v=$((min + ((c - c0) * 1000 + frac - 500) * (max - min) / ((w - 1) * 1000)))
	[ "$v" -lt "$min" ] && v=$min
	[ "$v" -gt "$max" ] && v=$max
	ret "$v"
}
