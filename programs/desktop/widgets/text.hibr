# widgets/text -- a single-line text field: drawing it, and one key applied
# to it.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# Draw a single-line editable field: the text, padded or truncated to w,
# and -- while focused -- the character at the cursor shown inverted, the
# same convention a selected list row already uses. There is no dt_wreg
# here: a field's own tag is for dt_hit to say a click landed on it, which
# an app's _click uses to move the cursor there and give it focus, not to
# fire an action the way a checkbox or a dropdown's arrow does.
# The one-line field that has focus, as this frame drew it: which window,
# its text and its cursor.
#
# The widget is the only thing that knows which field is focused -- an app
# keeps its own value and tells dt_textdraw which one to draw inverted --
# so this is what lets the desktop's own Copy, Cut and Paste reach a field
# whose app offers no clipboard of its own (Gitea #214). It is cleared at
# the top of every frame by dt_draw and filled again by whichever field
# draws itself focused, so it describes what is on the screen now rather
# than whatever had focus last.
#
# Declared here rather than beside the clear, because a pane sourced on
# its own in a fixture has the widget and not the window manager, and
# under `strict vars` the first dt_textdraw would be refused for creating
# a global its file never declared.
declare -gA DT_FIELD
DT_FIELD["id"]=
DT_FIELD["text"]=
DT_FIELD["cur"]=0
# And its selection (Gitea #295): anc is the end the selection was started
# from, empty for none, the cursor being the other end. at names the field
# as window, row and column, so a selection is dropped the moment another
# field is the focused one; rect is where it is drawn, "row col width",
# for a press and a drag to land on. None of these is cleared per frame.
DT_FIELD["anc"]=
DT_FIELD["at"]=
DT_FIELD["rect"]=
# How far the focused field is scrolled: the character at its left edge.
DT_FIELD["off"]=0
# Whether the field was drawn focused the last time its window was drawn:
# set here, cleared by dt_fieldstale before every draw of that window. A
# window whose focus has moved from its field to a button draws the field
# unfocused and so leaves this empty, and Copy, Cut and Paste then go to
# the window rather than into a field that no longer has the focus -- a
# paste holding a space would otherwise have pressed the button (#357).
DT_FIELD["live"]=
# How a paste into the focused field folds lines: empty, where a line break
# becomes a space so a name pasted over two lines stays two words, or url,
# where a line break and the blanks around it go, as a browser's address bar
# does -- a terminal program that wrapped a long address put them there.
DT_FIELD["paste"]=

# The focused field's undo history (Gitea #372), kept while it has the
# focus and dropped when another field takes it: each entry is what the
# field held, "cursor<tab>text", before a change. Changes less than a
# second apart are one step, so a word typed in one go is undone in one
# go. DT_FHAS names the field the history is for, DT_FLAST and DT_FLASTC
# what it held when last drawn, and DT_FWANT is set while the desktop is
# typing an undo or a redo into it, so that is not taken for an edit.
declare -ga DT_FUNDO=() DT_FREDO=()
DT_FHAS=
DT_FLAST=
DT_FLASTC=0
DT_FLASTMS=0
DT_FWANT=
DT_FUNDOMAX=100

# A focused field as it is drawn: note a change since the last draw.
fn dt_fieldnote(at, text, int cur) {
	local now

	if [ "$DT_FHAS" != "$at" ]; then
		DT_FHAS=$at
		DT_FUNDO=()
		DT_FREDO=()
		DT_FLAST=$text
		DT_FLASTC=$cur
		DT_FLASTMS=0
		return 0
	fi
	if [ "$text" = "$DT_FLAST" ]; then
		DT_FLASTC=$cur
		return 0
	fi
	if [ -n "$DT_FWANT" ]; then
		DT_FWANT=
		DT_FLAST=$text
		DT_FLASTC=$cur
		return 0
	fi
	now=${EPOCHREALTIME/./}
	now=$((now / 1000))
	if [ $((now - DT_FLASTMS)) -ge 1000 ] || [ "${#DT_FUNDO[@]}" = 0 ]; then
		DT_FUNDO+=("$DT_FLASTC"$'\t'"$DT_FLAST")
		[ "${#DT_FUNDO[@]}" -gt "$DT_FUNDOMAX" ] &&
			DT_FUNDO=("${DT_FUNDO[@]:1}")
	fi
	DT_FREDO=()
	DT_FLASTMS=$now
	DT_FLAST=$text
	DT_FLASTC=$cur
	return 0
}

# Whether the focused field has something to undo, or to redo.
fn dt_fieldcan(op) {
	dt_fieldlive || return 1
	[ "$DT_FHAS" = "${DT_FIELD["at"]}" ] || return 1
	if [ "$op" = undo ]; then
		[ "${#DT_FUNDO[@]}" -gt 0 ]
	else
		[ "${#DT_FREDO[@]}" -gt 0 ]
	fi
}

# The most characters a paste puts into a one-line field. DT_CLIP can hold
# Files' own list of paths or a whole selection from Write, and a field
# that holds thousands of characters is no use to anybody -- but a paste
# that silently drops the rest is worse, so the cut is said out loud.
DT_FIELDMAX=1024

# A window is about to be drawn: its field is live again only if this draw
# draws it focused. A window left undrawn keeps what it had.
fn dt_fieldstale(int id) {
	[ "${DT_FIELD["id"]}" = "$id" ] && DT_FIELD["live"]=
	DT_TEXTAT["$id"]=
	return 0
}

# Every field a window drew on its last draw, focused or not, as "row col
# width|" in its own coordinates: where the pointer is an I-beam (Gitea
# #394). Cleared before each draw of the window, so a window left undrawn
# keeps the fields it showed.
declare -gA DT_TEXTAT

# Whether row r, column c of window id is inside one of its fields.
fn dt_textat(int id, int r, int c) {
	local f fr fc fw
	local -a all

	[ -n "${DT_TEXTAT["$id"]-}" ] || return 1
	IFS='|' read -ra all <<< "${DT_TEXTAT["$id"]}"
	for f in "${all[@]}"; do
		read -r fr fc fw <<< "$f"
		[ -n "$fw" ] || continue
		[ "$r" = "$fr" ] && [ "$c" -ge "$fc" ] && [ "$c" -lt $((fc + fw)) ] &&
			return 0
	done
	return 1
}

# Whether the focused window has a field that has the focus.
dt_fieldlive() {
	[ -n "$DT_FOCUS" ] && [ "${DT_FIELD["id"]}" = "$DT_FOCUS" ] &&
		[ "${DT_FIELD["live"]}" = 1 ]
}

fn dt_textdraw(int id, int r, int c, int w, text, int cur, int focused, paste = "", secret = "") {
	local shown t ch lo hi off=0 most plain=1 end lc cc j pre= plo=0

	[[ $text != *[!\ -~]* ]] || plain=0
	DT_TEXTAT["$id"]+="$r $c $w|"
	if [ "$focused" = 1 ]; then
		if [ "${DT_FIELD["at"]}" = "$id $r $c" ]; then
			off=${DT_FIELD["off"]:-0}
		else
			DT_FIELD["anc"]=
		fi
		# Scrolled only as far as keeps the cursor in the box, and no
		# further than leaves the end of the text and the cell after it
		# showing, so taking text away brings what is left back into view.
		[ "$cur" -lt "$off" ] && off=$cur
		[ "$w" -gt 0 ] && [ "$cur" -gt $((off + w - 1)) ] && off=$((cur - w + 1))
		most=$((${#text} + 1 - w))
		[ "$most" -lt 0 ] && most=0
		[ "$off" -gt "$most" ] && off=$most
		[ "$plain" = 1 ] || off := dt_clsnap "$text" "$off"
		DT_FIELD["off"]=$off
		DT_FIELD["at"]="$id $r $c"
		DT_FIELD["rect"]="$r $c $w"
		DT_FIELD["id"]=$id
		DT_FIELD["text"]=$text
		DT_FIELD["cur"]=$cur
		DT_FIELD["live"]=1
		DT_FIELD["paste"]=$paste
		DT_FIELD["secret"]=$secret
		[ -n "${DT_FIELD["anc"]}" ] && [ "${DT_FIELD["anc"]}" -gt "${#text}" ] &&
			DT_FIELD["anc"]=${#text}
		[ -z "$DT_FDPEND" ] || dt_fdtake "$id" "$r" "$c" "$w"
		dt_fieldnote "$id $r $c" "$text" "$cur"
	elif [ "${DT_FIELD["at"]}" = "$id $r $c" ]; then
		# Drawn without the keys it shows its start, so it forgets how far
		# it was scrolled: a click on it is placed against the start, and
		# the next draw with the keys must agree with what was clicked.
		DT_FIELD["off"]=0
	fi
	# Text an input method holds is drawn where it will go, underlined, the
	# cursor after it; the field's own text and cursor are left as they are.
	if [ "$focused" = 1 ] && [ -n "${DT_IMEPRE-}" ] && [ "$secret" != 1 ] &&
	   pre := dt_imepre "$id" "$id $r $c"; then
		plo=$cur
		text="${text:0:$cur}$pre${text:$cur}"
		cur=$((cur + ${#pre}))
		[[ $text != *[!\ -~]* ]] || plain=0
		[ "$w" -gt 0 ] && [ "$cur" -gt $((off + w - 1)) ] && off=$((cur - w + 1))
		[ "$plain" = 1 ] || off := dt_clsnap "$text" "$off"
	fi
	shown="${text:$off:$w}"
	# A field never draws half a cluster: the marks after the last letter
	# shown are shown with it.
	if [ "$plain" = 0 ]; then
		end := dt_clfwd "$text" $((off + ${#shown}))
		shown="${text:$off:$((end - off))}"
		# Right-to-left text is laid out as the textarea's is, so the
		# cursor and the selection land where their characters were drawn.
		if bd_row "$text" "$off" "$end"; then
			dt_textbd "$id" "$r" "$c" "$w" "$cur" "$off" "$focused" "$plo" "${#pre}"
			return 0
		fi
	fi
	console pen "$DT_INK" "$DT_FACE"
	t := str pad "$shown" "$w"
	console put -p "w$id" "$r" "$c" "$t"
	# The selection, in the colours a selected row wears.
	if [ "$focused" = 1 ] && lo := dt_fieldrange; then
		hi=$((${lo#* } - off))
		lo=$((${lo% *} - off))
		[ "$lo" -lt 0 ] && lo=0
		[ "$hi" -gt "${#shown}" ] && hi=${#shown}
		if [ "$lo" -lt "$hi" ]; then
			lc=$lo
			if [ "$plain" = 0 ]; then
				lo := dt_clsnap "$shown" "$lo"
				hi := dt_clfwd "$shown" "$hi"
				lc := dt_clcol "$shown" "$lo"
			fi
			console pen "$DT_SELINK" "$DT_ACTIVE"
			console put -p "w$id" "$r" $((c + lc)) "${shown:$lo:$((hi - lo))}"
		fi
	fi
	if [ -n "$pre" ] && [ "$plo" -ge "$off" ]; then
		lo=$((plo - off))
		lc=$lo
		[ "$plain" = 1 ] || lc := dt_clcol "$shown" "$lo"
		console pen "$DT_INK" "$DT_FACE" underline
		console put -p "w$id" "$r" $((c + lc)) "${shown:$lo:${#pre}}"
	fi
	cur=$((cur - off))
	[ "$focused" = 1 ] && [ "$cur" -ge 0 ] || return 0
	cc=$cur
	j=$((cur + 1))
	if [ "$plain" = 0 ]; then
		cc := dt_clcol "$shown" "$cur"
		j := dt_clnext "$shown" "$cur"
	fi
	[ "$cc" -lt "$w" ] || return 0
	# The cursor is the whole cluster under it, letter and marks inverted
	# together; marks with no letter of their own sit on a blank.
	ch=" "
	if [ "$cur" -lt "${#shown}" ]; then
		ch="${shown:$cur:$((j - cur))}"
		if [ "$plain" = 0 ]; then
			t := str width "$ch"
			[ "$t" = 0 ] && ch=" $ch"
		fi
	fi
	console pen "$DT_FACE" "$DT_INK" bold
	console put -p "w$id" "$r" $((c + cc)) "$ch"
}

# Draw a field of right-to-left text that bd_row has laid out: the row in
# display order, then the selection and the cursor at the columns their
# characters went to, each letter with its marks.
fn dt_textbd(int id, int r, int c, int w, int cur, int off, int focused, int plo = 0, int pn = 0) {
	local t lo hi col g

	console pen "$DT_INK" "$DT_FACE"
	t := str repeat " " "$w"
	console put -p "w$id" "$r" "$c" "$t"
	bd_put "$id" "$r" "$c"
	[ "$focused" = 1 ] || return 0
	if lo := dt_fieldrange; then
		hi=${lo#* }
		lo=${lo% *}
		console pen "$DT_SELINK" "$DT_ACTIVE"
		bd_sel "$id" "$r" "$c" "$off" "$lo" "$hi"
	fi
	if [ "$pn" -gt 0 ]; then
		console pen "$DT_INK" "$DT_FACE" underline
		bd_sel "$id" "$r" "$c" "$off" "$plo" $((plo + pn))
	fi
	col := bd_col $((cur - off))
	[ "$col" -lt "$w" ] || return 0
	g := bd_glyph "$col"
	console pen "$DT_FACE" "$DT_INK" bold
	console put -r -p "w$id" "$r" $((c + col)) "$g"
}

# Apply one key to a text field's own (text, cursor) pair, returned as
# "text cursor" for the caller's own state to hold -- an app keeps a
# field in its own array, the same as dt_check and dt_wdrop never own the
# value they draw either. Status is 1 for a key this does not handle
# (enter, escape, tab...), so a caller's own _key still decides those for
# itself; nothing is returned then, and the caller's own pair stands.
#
# The selection is the focused field's, as it was last drawn -- a pair
# that is not that field's has none. Shift with an arrow, home or end
# moves the cursor and keeps the other end where it was; any other move
# lets the selection go; typing, backspace and delete replace or remove
# what is selected (Gitea #295). The pair is written back to DT_FIELD as
# each key changes it, so several keys between two frames still find
# their field.
fn dt_textkey(text, int cur, key) {
	local own=0 anc= lo hi

	if [ -n "${DT_FIELD["at"]}" ] && [ "${DT_FIELD["text"]}" = "$text" ] &&
	   [ "${DT_FIELD["cur"]}" = "$cur" ]; then
		own=1
		anc=${DT_FIELD["anc"]}
	fi
	lo=$cur
	hi=$cur
	if [ -n "$anc" ] && [ "$anc" != "$cur" ]; then
		lo=$anc
		hi=$cur
		[ "$lo" -gt "$hi" ] && { lo=$cur; hi=$anc; }
	fi
	# An input method takes the key first (Gitea #543), in the focused field
	# and never in a secret one; what it commits replaces a selection, as
	# typing does, and a key it passes then does what it always did.
	if [ -n "${DT_IME-}" ] && [ "$own" = 1 ] && [ "${DT_FIELD["secret"]}" != 1 ] &&
	   dt_imekey "$key" "${DT_FIELD["at"]}"; then
		if [ "$DT_IMEP" != 1 ]; then
			if [ -n "$DT_IMEC" ] || [ "$lo" != "$hi" ]; then
				text="${text:0:$lo}$DT_IMEC${text:$hi}"
				cur=$((lo + ${#DT_IMEC}))
			fi
			dt_textown "$own" "$text" "$cur" ""
			ret "$text $cur"
			return 0
		fi
		# The key goes on, and the caller may not take an answer for a key
		# it does its own thing with -- enter, tab -- so what was committed
		# is typed into the window first, as a paste is, and the key then
		# acts on the field as it now stands.
		if [ -n "$DT_IMEC" ]; then
			dt_imetype "${DT_FIELD["id"]}" "${DT[${DT_FIELD["id"]}]["key"]}" "$DT_IMEC"
			text="${text:0:$lo}$DT_IMEC${text:$hi}"
			cur=$((lo + ${#DT_IMEC}))
			anc=
			lo=$cur
			hi=$cur
		fi
	fi
	case $key in
	shift-left | shift-right | shift-home | shift-end)
		[ -n "$anc" ] || anc=$cur
		case $key in
		shift-left) cur := dt_clprev "$text" "$cur" ;;
		shift-right) cur := dt_clnext "$text" "$cur" ;;
		shift-home) cur=0 ;;
		shift-end) cur=${#text} ;;
		esac
		dt_textown "$own" "$text" "$cur" "$anc"
		ret "$text $cur"
		return 0
		;;
	esac
	# Something selected, and a key that acts on it: it goes, and a
	# character typed takes its place.
	if [ "$lo" != "$hi" ]; then
		lo := dt_clsnap "$text" "$lo"
		hi := dt_clfwd "$text" "$hi"
		case $key in
		left) cur=$lo ;;
		right) cur=$hi ;;
		backspace | delete)
			text="${text:0:$lo}${text:$hi}"
			cur=$lo
			;;
		*)
			if [ ${#key} = 1 ]; then
				text="${text:0:$lo}$key${text:$hi}"
				cur=$((lo + 1))
			else
				lo=$hi
			fi
			;;
		esac
		if [ "$lo" != "$hi" ]; then
			dt_textown "$own" "$text" "$cur" ""
			ret "$text $cur"
			return 0
		fi
	fi
	case $key in
	left) cur := dt_clprev "$text" "$cur" ;;
	right) cur := dt_clnext "$text" "$cur" ;;
	home) cur=0 ;;
	end) cur=${#text} ;;
	ctrl-u)
		text=${text:$cur}
		cur=0
		;;
	ctrl-k) text=${text:0:$cur} ;;
	backspace)
		if [ "$cur" -gt 0 ]; then
			text="${text:0:$((cur - 1))}${text:$cur}"
			cur=$((cur - 1))
		fi
		;;
	# Backspace takes the last character, so a mistyped mark goes alone;
	# delete takes the whole cluster after the cursor.
	delete)
		lo := dt_clnext "$text" "$cur"
		text="${text:0:$cur}${text:$lo}"
		;;
	*)
		if [ ${#key} = 1 ]; then
			text="${text:0:$cur}$key${text:$cur}"
			cur=$((cur + 1))
		else
			return 1
		fi
		;;
	esac
	dt_textown "$own" "$text" "$cur" ""
	ret "$text $cur"
}

# Write a field's pair and its selection's far end back to DT_FIELD, when
# the pair was the focused field's (own); otherwise leave it be.
fn dt_textown(int own, text, int cur, anc = "") {
	[ "$own" = 1 ] || return 0
	DT_FIELD["text"]=$text
	DT_FIELD["cur"]=$cur
	DT_FIELD["anc"]=$anc
}

# The focused field's selection as "lo hi", start and end in characters;
# status 1 when nothing is selected, or the field is not in the focused
# window.
fn dt_fieldrange() {
	local anc=${DT_FIELD["anc"]} cur=${DT_FIELD["cur"]:-0}

	[ -n "$anc" ] && [ "$anc" != "$cur" ] || return 1
	[ -z "${DT_FOCUS-}" ] || [ "${DT_FIELD["id"]}" = "$DT_FOCUS" ] || return 1
	if [ "$anc" -lt "$cur" ]; then
		ret "$anc $cur"
	else
		ret "$cur $anc"
	fi
}

# The focused field's selected text; status 1 when nothing is selected.
fn dt_fieldsel() {
	local r lo hi

	r := dt_fieldrange || return 1
	lo=${r% *}
	hi=${r#* }
	ret "${DT_FIELD["text"]:$lo:$((hi - lo))}"
}

# Text pasted into a one-line field, as one line: a line break becomes a
# space, or with mode url goes with the blanks around it; a tab is a space.
fn dt_pastefold(t, mode = "") {
	local a b

	t=${t//$'\r\n'/$'\n'}
	t=${t//$'\r'/$'\n'}
	if [ "$mode" = url ]; then
		while [[ $t == *$'\n'* ]]; do
			a=${t%%$'\n'*}
			b=${t#*$'\n'}
			a=${a%"${a##*[! $'\t']}"}
			b=${b#"${b%%[! $'\t']*}"}
			t=$a$b
		done
	else
		t=${t//$'\n'/ }
	fi
	ret "${t//$'\t'/ }"
}

# Paste into a one-line field at its cursor: what was copied on several
# lines becomes one (dt_pastefold, by the field's own rule when it is the
# focused one). Gives "text cur", the same as dt_textkey.
fn dt_textpaste(text, int cur, ins) {
	local r lo=$cur hi=$cur mode=

	[ "${DT_FIELD["text"]}" = "$text" ] && [ "${DT_FIELD["cur"]}" = "$cur" ] &&
		mode=${DT_FIELD["paste"]}
	ins := dt_pastefold "$ins" "$mode"
	# Over a selection in the focused field, the paste replaces it.
	if [ "${DT_FIELD["text"]}" = "$text" ] && [ "${DT_FIELD["cur"]}" = "$cur" ] &&
	   r := dt_fieldrange; then
		lo=${r% *}
		hi=${r#* }
	fi
	text="${text:0:$lo}$ins${text:$hi}"
	cur=$((lo + ${#ins}))
	[ "$lo" != "$hi" ] && dt_textown 1 "$text" "$cur" ""
	ret "$text $cur"
}

# Selecting in the focused field with the mouse (Gitea #295), carried by
# the window manager, so every field has it without its app doing a
# thing: the cursor is put where a press lands and a drag extends the
# selection, by typing -- home and arrows, shift and arrows -- into the
# app's own _key, the same write path the field's Paste already uses.
# A press on the focused field is not handed to the app: it is focused
# already, so its click could only move the cursor, and moving it here
# keeps DT_FIELD in step with the app's own pair. Shift with the press
# extends the selection to it.
DT_FDRAG=

# Whether pane row r, column c of window id is on its focused field.
fn dt_fdhit(id, int r, int c) {
	local fr fc fw

	[ "${DT_FIELD["id"]}" = "$id" ] && [ -n "${DT_FIELD["rect"]}" ] || return 1
	# Only a field the window drew focused on its last draw: one it has
	# stopped drawing keeps its rectangle here, and a press there was taken
	# as the field's for ever after, so the app never had the click (the
	# Browser's address bar once an address was sent).
	[ "${DT_FIELD["live"]}" = 1 ] || return 1
	read -r fr fc fw <<< "${DT_FIELD["rect"]}"
	[ "$r" = "$fr" ] && [ "$c" -ge "$fc" ] && [ "$c" -le $((fc + fw)) ]
}

# Type k of one key into window id's own _key.
fn dt_fdtype(id, key, int k) {
	local cb=${DT[$id]["key"]}

	[ -n "$cb" ] || return 0
	# A press commits what an input method holds before the cursor moves.
	[ -z "${DT_IMEPRE-}" ] || dt_imedone
	while [ "$k" -gt 0 ]; do
		dt_appcall "$id" "$cb" "$key" || true
		k=$((k - 1))
	done
}

# The index in window id's focused field of the cluster at column c of its
# pane.
fn dt_fdidx(id, int c) {
	local fr fc fw t x off=${DT_FIELD["off"]:-0}

	read -r fr fc fw <<< "${DT_FIELD["rect"]}"
	t=$((c - fc))
	[ "$t" -lt 0 ] && t=0
	x=${DT_FIELD["text"]}
	if ! dt_clplain "$x" && bd_row "$x" "$off" "${#x}"; then
		t := bd_at "$t"
	else
		t := dt_clidx "${x:$off}" "$t"
	fi
	ret $((t + off))
}

# Move window id's focused field's cursor to column c of its pane, as a
# selection's far end when ext is 1.
fn dt_fdmove(id, int c, int ext) {
	local t

	t := dt_fdidx "$id" "$c"
	dt_fdto "$id" "$t" "$ext"
}

# Move window id's focused field's cursor to index t, as a selection's far
# end when ext is 1: typed into the app as arrows, one a cluster.
fn dt_fdto(id, int t, int ext) {
	local cur=${DT_FIELD["cur"]:-0} x=${DT_FIELD["text"]} p= k h

	[ "$t" -lt 0 ] && t=0
	[ "$t" -gt "${#x}" ] && t=${#x}
	t := dt_clsnap "$x" "$t"
	# A plain move lets any selection go first: left over one goes to its
	# start rather than one character back, which would land the cursor
	# short of the press.
	[ "$ext" = 1 ] && p=shift- || DT_FIELD["anc"]=
	if [ -z "$p" ]; then
		h := dt_clcount "$x" 0 "$t"
		if [ "$t" -gt "$cur" ]; then
			k := dt_clcount "$x" "$cur" "$t"
		else
			k := dt_clcount "$x" "$t" "$cur"
		fi
		if [ "$h" -lt "$k" ]; then
			dt_fdtype "$id" home 1
			cur=0
		fi
	fi
	if [ "$t" -gt "$cur" ]; then
		k := dt_clcount "$x" "$cur" "$t"
		dt_fdtype "$id" "${p}right" "$k"
	elif [ "$t" -lt "$cur" ]; then
		k := dt_clcount "$x" "$t" "$cur"
		dt_fdtype "$id" "${p}left" "$k"
	fi
	dt_want 10
}

# A press at pane row r, column c: on window id's focused field, the cursor
# goes there (or the selection does, with shift) and the drag is held. A
# second press in the same place within DT_DBLMS selects the word there, and
# a third the whole field.
fn dt_fdpress(id, int r, int c, mods = "") {
	local ext=0 n=1

	dt_fdhit "$id" "$r" "$c" || return 1
	case "-$mods-" in *-shift-*) ext=1 ;; esac
	if [ "$ext" = 0 ]; then
		n := dt_fdcount "$id" "$r" "$c"
	fi
	case $n in
	2) dt_fdword "$id" "$c" ;;
	3) dt_fdall "$id" ;;
	*)
		dt_fdmove "$id" "$c" "$ext"
		DT_FDRAG=$id
		;;
	esac
	return 0
}

# Presses on fields, counted for a double and a triple click: the window,
# the row and column, when, and how many so far. A fourth starts again.
DT_FDCLK=

# Count a press at pane row r, column c of window id: 1, 2 or 3.
fn dt_fdcount(id, int r, int c) {
	local now cid cr cc ct cn

	now := dt_ms
	read -r cid cr cc ct cn <<< "$DT_FDCLK"
	if [ "$cid" = "$id" ] && [ "$cr" = "$r" ] && [ "$cc" = "$c" ] &&
	   [ -n "$ct" ] && [ $((now - ct)) -lt "$DT_DBLMS" ] && [ "$cn" -lt 3 ]; then
		cn=$((cn + 1))
	else
		cn=1
	fi
	DT_FDCLK="$id $r $c $now $cn"
	ret "$cn"
}

# Whether ch is part of a word, for a double click: anything but a blank
# or punctuation, and the underscore, which names are made of.
fn dt_fdwordch(ch) {
	[ "$ch" = _ ] && return 0
	case $ch in
	[[:space:]] | [[:punct:]]) return 1 ;;
	esac
	return 0
}

# Select the word at pane column c of window id's focused field; on a blank
# or a punctuation mark, that one character.
fn dt_fdword(id, int c) {
	local t=${DT_FIELD["text"]} i lo hi

	i := dt_fdidx "$id" "$c"
	[ "$i" -ge "${#t}" ] && i=$((${#t} - 1))
	[ "$i" -ge 0 ] || return 0
	lo=$i
	hi=$((i + 1))
	if dt_fdwordch "${t:$i:1}"; then
		while [ "$lo" -gt 0 ] && dt_fdwordch "${t:$((lo - 1)):1}"; do
			lo=$((lo - 1))
		done
		while [ "$hi" -lt "${#t}" ] && dt_fdwordch "${t:$hi:1}"; do
			hi=$((hi + 1))
		done
	fi
	lo := dt_clsnap "$t" "$lo"
	hi := dt_clfwd "$t" "$hi"
	dt_fdto "$id" "$lo" 0
	dt_fdto "$id" "$hi" 1
}

# Select the whole of window id's focused field.
fn dt_fdall(id) {
	DT_FIELD["anc"]=
	dt_fdtype "$id" home 1
	dt_fdtype "$id" shift-end 1
	dt_want 10
}

# A press on a field its window had not given the keys (0.99.422, the
# owner's): the app is handed the press, as before, and when the window
# then draws that field focused, the cursor goes where the press landed.
# Held as "window row column when", and taken only within a second, so a
# field given the keys later by a key rather than a press is left alone.
DT_FDPEND=
# Set by dt_textdraw when the pending press's field is drawn focused, and
# acted on by dt_fdgo once the frame is drawn, never in the middle of it.
DT_FDGO=

# Note a press at pane row r, column c of window id, on one of its fields
# that does not have the keys; status 1 when there is no field there.
fn dt_fdlater(id, int r, int c) {
	local now

	DT_FDPEND=
	dt_textat "$id" "$r" "$c" || return 1
	now := dt_ms
	dt_fdcount "$id" "$r" "$c"
	DT_FDPEND="$id $r $c $now"
}

# The field a pending press was on is drawn focused at row r, columns c to
# c + w of window id: take the press for dt_fdgo.
fn dt_fdtake(id, int r, int c, int w) {
	local pid pr pc pt now

	read -r pid pr pc pt <<< "$DT_FDPEND"
	[ "$pid" = "$id" ] && [ "$pr" = "$r" ] || return 0
	[ "$pc" -ge "$c" ] && [ "$pc" -le $((c + w)) ] || return 0
	DT_FDPEND=
	now := dt_ms
	[ $((now - pt)) -lt 1000 ] || return 0
	DT_FDGO="$id $pc"
}

# After a frame: put the cursor where a pending press landed, unless the app
# selected its field on giving it the keys -- an address bar selects all,
# and a press that only gave it the keys must not undo that.
fn dt_fdgo() {
	local id c

	read -r id c <<< "$DT_FDGO"
	DT_FDGO=
	[ "${DT_FIELD["id"]}" = "$id" ] && [ "${DT_FIELD["live"]}" = 1 ] || return 0
	[ -z "${DT_FIELD["anc"]}" ] || return 0
	dt_fdmove "$id" "$c" 0
}

# A drag or a release while a field's selection is being drawn out, at
# screen row mr, column mc.
fn dt_fddrag(act, int mr, int mc) {
	local id=$DT_FDRAG wa

	[ "$act" = release ] && DT_FDRAG=
	[ -n "${DT[$id]["col"]+x}" ] || { DT_FDRAG=; return 0; }
	wa := dt_wapp "$id"
	dt_fdmove "$id" $((mc - wa)) 1
}

# An app's own Cut on its focused field: the selected text, taken out of
# the field by a backspace typed into window id's own _key (Gitea #295).
# Status 1 when nothing is selected.
fn dt_fieldcut(id) {
	local t

	t := dt_fieldsel || return 1
	dt_fdtype "$id" backspace 1
	ret "$t"
}
