# widgets/text -- a single-line text field: drawing it, and one key applied
# to it.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# Draw a single-line editable field: the text, padded or truncated to w,
# and -- while focused -- the character at the cursor shown inverted, the
# same convention a selected list row already uses. There is no dt_wreg
# here: a field's own tag is for dt_hit to say a click landed on it, which
# an app's _click uses to move the cursor there and give it focus, not to
# fire an action the way a checkbox or a dropdown's arrow does.
# The one-line field that has focus, as this frame drew it: which window,
# its text and its cursor.
#
# The widget is the only thing that knows which field is focused -- an app
# keeps its own value and tells dt_textdraw which one to draw inverted --
# so this is what lets the desktop's own Copy, Cut and Paste reach a field
# whose app offers no clipboard of its own (Gitea #214). It is cleared at
# the top of every frame by dt_draw and filled again by whichever field
# draws itself focused, so it describes what is on the screen now rather
# than whatever had focus last.
#
# Declared here rather than beside the clear, because a pane sourced on
# its own in a fixture has the widget and not the window manager, and
# under `strict vars` the first dt_textdraw would be refused for creating
# a global its file never declared.
declare -gA DT_FIELD
DT_FIELD["id"]=
DT_FIELD["text"]=
DT_FIELD["cur"]=0

# The most characters a paste puts into a one-line field. DT_CLIP can hold
# Files' own list of paths or a whole selection from Write, and a field
# that holds thousands of characters is no use to anybody -- but a paste
# that silently drops the rest is worse, so the cut is said out loud.
DT_FIELDMAX=1024

fn dt_textdraw(int id, int r, int c, int w, text, int cur, int focused) {
	local shown t ch

	if [ "$focused" = 1 ]; then
		DT_FIELD["id"]=$id
		DT_FIELD["text"]=$text
		DT_FIELD["cur"]=$cur
	fi
	shown="$text"
	[ ${#shown} -gt "$w" ] && shown="${shown:0:$w}"
	console pen "$DT_INK" "$DT_FACE"
	t := str pad "$shown" "$w"
	console put -p "w$id" "$r" "$c" "$t"
	if [ "$focused" = 1 ] && [ "$cur" -lt "$w" ]; then
		ch=" "
		[ "$cur" -lt "${#shown}" ] && ch="${shown:$cur:1}"
		console pen "$DT_FACE" "$DT_INK" bold
		console put -p "w$id" "$r" $((c + cur)) "$ch"
	fi
}

# Apply one key to a text field's own (text, cursor) pair, returned as
# "text cursor" for the caller's own state to hold -- an app keeps a
# field in its own array, the same as dt_check and dt_wdrop never own the
# value they draw either. Status is 1 for a key this does not handle
# (enter, escape, tab...), so a caller's own _key still decides those for
# itself; nothing is returned then, and the caller's own pair stands.
fn dt_textkey(text, int cur, key) {
	case $key in
	left) [ "$cur" -gt 0 ] && cur=$((cur - 1)) ;;
	right) [ "$cur" -lt "${#text}" ] && cur=$((cur + 1)) ;;
	home) cur=0 ;;
	end) cur=${#text} ;;
	ctrl-u)
		text=${text:$cur}
		cur=0
		;;
	ctrl-k) text=${text:0:$cur} ;;
	backspace)
		if [ "$cur" -gt 0 ]; then
			text="${text:0:$((cur - 1))}${text:$cur}"
			cur=$((cur - 1))
		fi
		;;
	delete)
		[ "$cur" -lt "${#text}" ] &&
			text="${text:0:$cur}${text:$((cur + 1))}"
		;;
	*)
		if [ ${#key} = 1 ]; then
			text="${text:0:$cur}$key${text:$cur}"
			cur=$((cur + 1))
		else
			return 1
		fi
		;;
	esac
	ret "$text $cur"
}

# Paste into a one-line field at its cursor: what was copied on several
# lines becomes one, its newlines and tabs spaces. Gives "text cur", the
# same as dt_textkey.
fn dt_textpaste(text, int cur, ins) {
	ins=${ins//$'\r'/}
	ins=${ins//$'\n'/ }
	ins=${ins//$'\t'/ }
	ret "${text:0:$cur}$ins${text:$cur} $((cur + ${#ins}))"
}
