# widgets/scrollbar -- a vertical scrollbar.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# A vertical scrollbar: a track of GL[vline] over h rows starting at row0,
# one cell shown as the thumb GL[block] at a position proportional to how
# far through total the view already is, both in the theme's colours -- the
# thumb in its accent, the track in its idle colour. shown is how many of
# total are visible at once; nothing is drawn when everything already is,
# the same as a checkbox or a dropdown draws nothing it was not asked for.
# The shape the file browser's own list view and a terminal's scrollback
# both need, so a fix or a restyle is one place, not two.
# Where a scrolled list should start, given where it starts now. top is
# clamped so the last line cannot be scrolled past and the first cannot be
# scrolled before, and -- when at names a line -- that line is brought into
# view first, which is what moving a selection with the keys needs. A pure
# function on purpose: the offset itself belongs under the window id in the
# app's own map, like everything else an app remembers, so this holds no
# state and two callers cannot fight over it.
#
# The Control Panel's picker had these three comparisons written out in two
# places, and the About window wanted them as well; the scrollbar below
# already says a fix or a restyle should be one place and not two.
fn dt_scrollfit(int top, int total, int vis, int? at = "") {
	local max=$((total - vis))

	if [ -n "$at" ]; then
		[ "$at" -lt "$top" ] && top=$at
		[ "$at" -ge $((top + vis)) ] && top=$((at - vis + 1))
	fi
	[ "$top" -gt "$max" ] && top=$max
	[ "$top" -lt 0 ] && top=0
	ret "$top"
}

# One wheel notch is this many rows, everywhere. It was 2 in About and in a
# Control Panel pane's body, and 3 in Task Manager and the notification
# history -- not a choice anybody made, just four days' work. A number with
# a name is what makes it one.
DT_SCROLLWHEEL="${DT_SCROLLWHEEL-3}"

# A selection clamped to the list it is in: 0 to n-1, where a viewport's own
# top clamps to n-vis. Two different bounds, which is why this is its own
# call rather than a flag on dt_scrollfit -- and the pair of them is what a
# list does on every move:
#
#     sel := dt_scrollsel "$sel" "$n"
#     top := dt_scrollfit "$top" "$n" "$vis" "$sel"
#
# written out in Task Manager and the notification history, and already
# half-shared in the Control Panel's picker, which gates the second line on
# the selection having actually moved so a wheel-scrolled list does not snap
# back to it.
fn dt_scrollsel(int sel, int n) {
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt 0 ] && sel=0
	ret "$sel"
}

# Which way a key or a wheel direction scrolls a viewport, and how far: the
# new top, clamped, with status 1 for a key this does not own so the caller
# can go on to its own. `step` is how far an arrow moves (a wheel notch
# passes DT_SCROLLWHEEL); a page is a windowful.
#
# Here because four apps had written it out, each slightly differently --
# which is how the wheel came to move a different distance in each of them.
# The offset itself stays in the caller's own map under its window id: this
# is a pure function, so two windows of one app cannot fight over it.
fn dt_scrollmove(k, int top, int total, int vis, int? step = "") {
	local s=${step:-1}

	case $k in
	up) top=$((top - s)) ;;
	down) top=$((top + s)) ;;
	pageup) top=$((top - vis)) ;;
	pagedown) top=$((top + vis)) ;;
	home) top=0 ;;
	end) top=$total ;;
	*) return 1 ;;
	esac
	top := dt_scrollfit "$top" "$total" "$vis"
	ret "$top"
}

#
# Given a key, the bar can be held and dragged (Gitea #298): its track is
# a clickable region, a press puts the view where it lands and the window
# manager carries the drag to the release, telling the app each step as
# <app>_scroll id key top -- whether or not the window takes drags itself.
# thumb=1 registers the thumb alone, for a bar drawn on a split divider
# whose other cells still drag the divider.
declare -gA DT_SB
DT_SBDRAG=

fn dt_scrollbar(int id, int row0, int col, int h, int total, int shown, int pos, key = "", thumb1 = "") {
	local thumb r tg=${GL[block]} kg=${GL[vline]}

	[ "$total" -gt "$shown" ] || return 0
	thumb=$((row0 + pos * (h - 1) / (total - shown)))
	[ "$thumb" -ge $((row0 + h)) ] && thumb=$((row0 + h - 1))
	if [ -n "$key" ]; then
		DT_SB["$id:$key"]="v $row0 $col $h $total $shown"
		if [ "$thumb1" = 1 ]; then
			dt_wreg "$id" "$thumb" "$col" 1 "dtsb:$key"
		else
			for ((r = row0; r < row0 + h; r++)); do
				dt_wreg "$id" "$r" "$col" 1 "dtsb:$key"
			done
		fi
	fi
	r=$row0
	while [ "$r" -lt $((row0 + h)) ]; do
		if [ "$r" = "$thumb" ]; then
			console pen "$DT_ACTIVE" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "$tg"
		else
			console pen "$DT_IDLE" "$DT_FACE"
			console put -p "w$id" "$r" "$col" "$kg"
		fi
		r=$((r + 1))
	done
}

# The same along a row: a track of GL[hline] over w columns from col0, the
# thumb where the view already is. Lines wider than the window are the case
# it is for -- the About window's own sysinfo block, whose logo is wider
# than anything else it shows -- and the arithmetic is the vertical one
# turned on its side, so the two stay in step by being the same.
fn dt_hscrollbar(int id, int row, int col0, int w, int total, int shown, int pos, key = "") {
	local thumb c tg=${GL[block]} kg=${GL[hline]}

	[ "$total" -gt "$shown" ] || return 0
	thumb=$((col0 + pos * (w - 1) / (total - shown)))
	[ "$thumb" -ge $((col0 + w)) ] && thumb=$((col0 + w - 1))
	if [ -n "$key" ]; then
		DT_SB["$id:$key"]="h $row $col0 $w $total $shown"
		dt_wreg "$id" "$row" "$col0" "$w" "dtsb:$key"
	fi
	c=$col0
	while [ "$c" -lt $((col0 + w)) ]; do
		if [ "$c" = "$thumb" ]; then
			console pen "$DT_ACTIVE" "$DT_FACE"
			console put -p "w$id" "$row" "$c" "$tg"
		else
			console pen "$DT_IDLE" "$DT_FACE"
			console put -p "w$id" "$row" "$c" "$kg"
		fi
		c=$((c + 1))
	done
}

# The top a place along a bar stands for: at is the row (or column) the
# pointer is on, start and len the track's, and the answer runs 0 to
# total-shown -- the thumb's own arithmetic turned round.
fn dt_scrollpos(int at, int start, int len, int total, int shown) {
	local t

	if [ "$len" -le 1 ] || [ "$total" -le "$shown" ]; then
		ret 0
		return 0
	fi
	t=$(((at - start) * (total - shown) / (len - 1)))
	[ "$t" -lt 0 ] && t=0
	[ "$t" -gt $((total - shown)) ] && t=$((total - shown))
	ret "$t"
}

# A press at pane row r, column c: on a bar drawn with a key, in a window
# whose app offers _scroll, the view goes there and the drag is held.
fn dt_sbpress(int id, int r, int c) {
	local tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	dtsb:*) ;;
	*) return 1 ;;
	esac
	dt_has "${DT[$id]["app"]}_scroll" || return 1
	DT_SBDRAG="$id ${tag#dtsb:}"
	dt_sbto "$id" "${tag#dtsb:}" "$r" "$c"
	return 0
}

# Tell the app the top that pane row r, column c on its bar stands for.
fn dt_sbto(int id, key, int r, int c) {
	local g t
	local -a f

	g=${DT_SB["$id:$key"]}
	[ -n "$g" ] || return 0
	read -ra f <<< "$g"
	if [ "${f[0]}" = v ]; then
		t := dt_scrollpos "$r" "${f[1]}" "${f[3]}" "${f[4]}" "${f[5]}"
	else
		t := dt_scrollpos "$c" "${f[2]}" "${f[3]}" "${f[4]}" "${f[5]}"
	fi
	"${DT[$id]["app"]}_scroll" "$id" "$key" "$t"
	dt_want 10
}

# A drag or a release while a bar is held, at screen row mr, column mc.
fn dt_sbdrag(act, int mr, int mc) {
	local id key

	read -r id key <<< "$DT_SBDRAG"
	[ "$act" = release ] && DT_SBDRAG=
	[ -n "${DT[$id]["row"]+x}" ] || { DT_SBDRAG=; return 0; }
	dt_sbto "$id" "$key" $((mr - DT[$id]["row"])) $((mc - DT[$id]["col"]))
}

# Where a list with a selection starts this frame: brought to the selection
# only when the selection has moved since it last was (seen, which the
# caller stores back as sel), and otherwise only kept in range -- so the
# wheel, the page keys or a held scrollbar, which move the view and not the
# selection, are not pulled back on the next frame. Bringing it every frame
# is what stopped the Catalogue's wheel at the end of one category, and
# Task Manager's and Modules' at a screen from the selection (Gitea #298).
fn dt_scrollview(int top, int total, int vis, int sel, seen = "") {
	if [ "$sel" != "$seen" ]; then
		top := dt_scrollfit "$top" "$total" "$vis" "$sel"
	else
		top := dt_scrollfit "$top" "$total" "$vis"
	fi
	ret "$top"
}
