# widgets/button -- push buttons, a row of them, and moving focus.
#
# Part of the widget library apps draw with -- see widgets/README.md.
# interface: shared

strict

# Where a button is drawn: a window's pane, or with id "root" straight onto
# the screen, for the window manager's own overlays (the confirm box) that
# have no window and no pane. Either way dt_hit finds it under the same id.
fn dt_bput(id, int r, int c, text) {
	if [ "$id" = root ]; then
		console put "$r" "$c" "$text"
	else
		console put -p "w$id" "$r" "$c" "$text"
	fi
}

# The colour a button's shadow is drawn in, worked out once per theme: the
# face darkened by the theme's own DT_SHADOW_PCT, twice over. Once is a
# window's depth, which a whole window's worth of darkened cells makes
# visible; a thin row of half blocks at that depth vanished into midnight's
# near-black face. DT_BTNSHADOW (wm/settings.hibr) turns it off.
DT_BTNSHADE=
DT_BTNSHADE_FOR=

dt_btnshade() {
	local k="$DT_FACE $DT_SHADOW_PCT" p=$DT_SHADOW_PCT

	if [ "$DT_BTNSHADE_FOR" != "$k" ]; then
		DT_BTNSHADE := console shade "$DT_FACE" $((p * p / 100)) ||
			DT_BTNSHADE=$DT_IDLE
		DT_BTNSHADE_FOR=$k
	fi
	ret "$DT_BTNSHADE"
}

# The colour a button is filled with while the pointer is over it, and a
# title bar's button's glyph is drawn in (Gitea #384).
# A scheme's own "hot" when it gives one; otherwise its accent made
# brighter: lighter on a dark face, deeper on a light one, so it stands out
# from the plain accent either way and keeps the face's colour readable on
# it. Worked out once per scheme.
DT_HOTC=
DT_HOTC_FOR=

dt_hotcolour() {
	local k="$DT_HOT $DT_ACTIVE $DT_FACE" r g b

	if [ "$DT_HOTC_FOR" != "$k" ]; then
		if [ -n "$DT_HOT" ]; then
			DT_HOTC=$DT_HOT
		elif match "$DT_FACE" '^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$'; then
			r=$((16#${M[1]}))
			g=$((16#${M[2]}))
			b=$((16#${M[3]}))
			if [ $(((r * 299 + g * 587 + b * 114) / 1000)) -lt 128 ]; then
				DT_HOTC := dt_lighten "$DT_ACTIVE" 35
			else
				DT_HOTC := console shade "$DT_ACTIVE" 70 || DT_HOTC=$DT_ACTIVE
			fi
		else
			DT_HOTC=$DT_ACTIVE
		fi
		DT_HOTC_FOR=$k
	fi
	ret "$DT_HOTC"
}

# An icon button's colours, "face light dark" (Gitea #604): the scheme's
# buttonface, buttonlight and buttondark where it gives them. Otherwise a
# key worked out from the scheme: the icon is drawn in the light edge's
# colour, as Blit draws a key (ADR 0237), so it has to read on the face --
# on a dark scheme the well, lit by the ink; on a light one the face
# deepened to a grey the face's own colour reads on -- and the dark edge is
# the key's face at half its brightness. Worked out once per scheme.
DT_BTNC=
DT_BTNC_FOR=

dt_btncolours() {
	local k="$DT_BUTTONFACE $DT_BUTTONLIGHT $DT_BUTTONDARK $DT_FACE $DT_WELL $DT_INK $DT_IDLE" f l d

	if [ "$DT_BTNC_FOR" != "$k" ]; then
		if dt_islight "$DT_FACE"; then
			f := console shade "$DT_FACE" 55 || f=$DT_IDLE
			l=$DT_FACE
		else
			f=$DT_WELL
			l=$DT_INK
		fi
		f=${DT_BUTTONFACE:-$f}
		l=${DT_BUTTONLIGHT:-$l}
		d=$DT_BUTTONDARK
		[ -n "$d" ] || d := console shade "$f" 50 || d=$DT_IDLE
		DT_BTNC="$f $l $d"
		DT_BTNC_FOR=$k
	fi
	ret "$DT_BTNC"
}

# Draw one button, " label " filled: the accent colour when it has focus,
# muted when it has not, with Turbo Vision's shadow -- a ▄ beside it and a
# row of ▀ under it. With DT_DLGBTN=brackets it is [label] on the window's
# face instead, the same width, and filled only while it has focus. on is 1
# for focus and 2 for the default -- the button enter presses while focus is
# in a field or a list -- whose label is the accent colour, so it is always
# plain what enter will do. tag is what dt_hit answers for a click on it.
# Given a width w, it is an icon button instead (Gitea #604): label is the
# icon, drawn as a key cap w columns wide, and state is raised (empty),
# pressed -- while the pointer holds it, which only the caller knows -- or
# lit, a latched key such as a player's play (dt_iconbutton).
fn dt_button(id, int r, int c, label, int on, tag, int? w = "", state = "") {
	local t n sh bg=$DT_IDLE hot s

	if [ -n "$w" ]; then
		dt_iconbutton "$id" "$r" "$c" "$label" "$on" "$tag" "$w" "$state"
		return 0
	fi
	case $DT_LANG in ?*) label := dt_tr "$label" ;; esac
	t=" $label "

	n=${#t}
	case $DT_DLGBTN in
	chalk | slate)
		s := dt_chromeset "$DT_DLGBTN"
		if [ -n "$s" ]; then
			dt_glyphbutton "$id" "$r" "$c" "$label" "$on" "$tag" "$s"
			return 0
		fi
		;;
	esac
	if [ "$DT_DLGBTN" = brackets ]; then
		t="[$label]"
		bg=$DT_FACE
	fi
	# Under the pointer it is filled with the hot colour, the one thing a
	# press would do, whether or not it has the focus -- so the pointer
	# always shows, even on a dialog that opens with its button focused.
	# With the focus and no pointer it is filled with the accent, as it
	# always was (Gitea #370, #384).
	if dt_hot "$id" "$tag"; then
		hot := dt_hotcolour
		console pen "$DT_FACE" "$hot" bold
	else
		case $on in
		1) console pen "$DT_FACE" "$DT_ACTIVE" bold ;;
		2) console pen "$DT_ACTIVE" "$bg" bold ;;
		*) console pen "$DT_INK" "$bg" ;;
		esac
	fi
	dt_bput "$id" "$r" "$c" "$t"
	if [ "$DT_BTNSHADOW" = 1 ]; then
		sh := dt_btnshade
		console pen "$sh" "$DT_FACE"
		dt_bput "$id" "$r" $((c + n)) "${GL[lower]}"
		t := dt_rep "$n" "${GL[upper]}"
		dt_bput "$id" $((r + 1)) $((c + 1)) "$t"
	fi
	dt_wreg "$id" "$r" "$c" "$n" "$tag"
}

# An icon button, dt_button's icon form: a key cap w columns wide -- its
# left end, the icon centred on its face, its right end -- in
# dt_btncolours' face, with the icon and the light edge in the light
# colour and the dark edge in the line colour. In the blit glyph set the
# ends are Blit's key-left and key-right and the icon's cells carry the
# bevel, raised (framed-raised, SGR 51:6) or pressed (key-pressed-*,
# framed-pressed, 51:7), Blit itself turning the bevel over for a pressed
# key; elsewhere the ends are blank face, and a key that is down takes its
# dark edge's colour for a face, there being no bevel to show it. lit is a
# latched key, down and filled with the accent, its icon in the colour a
# selection's text is. Under the pointer, or with the focus, the face is
# brighter on a dark key and deeper on a light one.
fn dt_iconbutton(id, int r, int c, glyph, int on, tag, int w, state = "") {
	local cols f l d le=${GL[keyl]} re=${GL[keyr]} fr=framed-raised gw p t s
	local -a fx=()

	cols := dt_btncolours
	read -r f l d <<< "$cols"
	if dt_hot "$id" "$tag" || [ "$on" = 1 ]; then
		if dt_islight "$f"; then
			f := console shade "$f" 85 || f=$d
		else
			f := dt_lighten "$f" 15
		fi
	fi
	case $state in
	pressed | lit)
		le=${GL[keypl]}
		re=${GL[keypr]}
		fr=framed-pressed
		[ -n "${GL[keyl]}" ] || f=$d
		;;
	esac
	if [ "$state" = lit ]; then
		f=$DT_ACTIVE
		l=$DT_SELINK
	fi
	[ -n "${GL[keyl]}" ] && fx=("$fr")
	gw := str width "$glyph"
	[ "$w" -ge $((gw + 2)) ] || w=$((gw + 2))
	p=$(((w - 2 - gw) / 2))
	t := dt_rep "$p" " "
	t+=$glyph
	s := dt_rep $((w - 2 - gw - p)) " "
	t+=$s
	console pen "$l" "$f" "line=$d"
	dt_bput "$id" "$r" "$c" "${le:- }"
	dt_bput "$id" "$r" $((c + w - 1)) "${re:- }"
	console pen "$l" "$f" "${fx[@]}" "line=$d"
	dt_bput "$id" "$r" $((c + 1)) "$t"
	dt_wreg "$id" "$r" "$c" "$w" "$tag"
}

# The columns a row of buttons with these labels takes, shadow included --
# for centring it.
fn dt_btnw(...labels) {
	local w=0 l

	for l in "${labels[@]}"; do
		w=$((w + ${#l} + 4))
	done
	[ "${#labels[@]}" -gt 0 ] && w=$((w - 2 + DT_BTNSHADOW))
	ret "$w"
}

# A Chalk or Slate button (Blit ADR 0210), as Dialog Buttons chooses, from
# glyph set s: a cap glyph each end and the label framed between them
# (SGR 51, Blit's top and bottom line), the default one -- the one with the
# focus, or the one enter answers -- with the thick ring and its caps. The
# same width as any other button, so a dialog's layout does not move. Its
# colours are the scheme's: the caps sit on the face, Chalk's label on the
# face too and Slate's on the well, in the ink, ringed in the ink. Under
# the pointer the label takes the hot colour, as any button's does.
fn dt_glyphbutton(id, int r, int c, label, int on, tag, s) {
	local face=$DT_FACE bf fg=$DT_INK ring=$DT_INK fr=framed l=button-left rt=button-right hot
	local -a cap=()

	bf=$face
	# A Slate cap paints the button's face in the line colour, on the
	# dialog's own (Blit ADR 0211).
	[ "$s" = slate ] && { bf=$DT_WELL; cap=("line=$bf"); }
	[ "$on" -ge 1 ] && { fr=framed-thick; l=default-button-left; rt=default-button-right; }
	console pen "$DT_INK" "$face" "${cap[@]}"
	dt_bput "$id" "$r" "$c" "${GL["$s-$l"]}"
	dt_bput "$id" "$r" $((c + ${#label} + 1)) "${GL["$s-$rt"]}"
	if dt_hot "$id" "$tag"; then
		hot := dt_hotcolour
		fg=$hot
	fi
	console pen "$fg" "$bf" bold $fr "line=$ring"
	dt_bput "$id" "$r" $((c + 1)) "$label"
	dt_wreg "$id" "$r" "$c" $((${#label} + 2)) "$tag"
}

# Draw a row of buttons from c, two columns apart: pairs of tag and label,
# the one whose tag is focus drawn as having it. When focus is on none of
# them -- in a field or a list -- the first, which is always the dialog's
# action, is drawn as the default: it is what enter does from there.
fn dt_buttons(id, int r, int c, focus, ...pairs) {
	local i=0 on n=${#pairs[@]} def=1 deftag=${pairs[0]}

	if [ -n "$DT_LANG" ]; then
		while [ $((i + 1)) -lt "$n" ]; do
			pairs[$((i + 1))] := dt_tr "${pairs[$((i + 1))]}"
			i=$((i + 2))
		done
		i=0
	fi
	while [ $((i + 1)) -lt "$n" ]; do
		[ "${pairs[$i]}" = "$focus" ] && def=0
		i=$((i + 2))
	done
	case $DT_MIRRORON in
	1)
		local -a rev
		i=$((n - 2))
		while [ "$i" -ge 0 ]; do
			rev+=("${pairs[$i]}" "${pairs[$((i + 1))]}")
			i=$((i - 2))
		done
		pairs=("${rev[@]}")
		;;
	esac
	i=0
	while [ $((i + 1)) -lt "$n" ]; do
		on=0
		[ "${pairs[$i]}" = "$deftag" ] && [ "$def" = 1 ] && on=2
		[ "${pairs[$i]}" = "$focus" ] && on=1
		dt_button "$id" "$r" "$c" "${pairs[$((i + 1))]}" "$on" \
			"${pairs[$i]}"
		c=$((c + ${#pairs[$((i + 1))]} + 4))
		i=$((i + 2))
	done
}

# A dialog's buttons, centred along the bottom of its window: on the last
# row but one, leaving the last for the shadow. h and w are what the
# app's _draw was handed; pairs are dt_buttons'.
fn dt_dlgbtns(int id, int h, int w, focus, ...pairs) {
	local i=1 bw
	local -a labels

	while [ "$i" -lt "${#pairs[@]}" ]; do
		case $DT_LANG in ?*) pairs[$i] := dt_tr "${pairs[$i]}" ;; esac
		labels+=("${pairs[$i]}")
		i=$((i + 2))
	done
	bw := dt_btnw "${labels[@]}"
	dt_buttons "$id" $((h - 1)) $(((w + 2 - bw) / 2)) "$focus" \
		"${pairs[@]}"
}

# The tag after (dir 1) or before (dir -1) cur among tags, wrapping at
# either end -- how tab moves through a dialog's fields and buttons. A cur
# that is not one of them gives the first.
fn dt_focus(cur, int dir, ...tags) {
	local n=${#tags[@]} i=0

	while [ "$i" -lt "$n" ]; do
		if [ "${tags[$i]}" = "$cur" ]; then
			ret "${tags[$(( (i + dir + n) % n ))]}"
		fi
		i=$((i + 1))
	done
	ret "${tags[0]}"
}

# Which way a key moves focus: tab and shift-tab always, the arrows only
# when a button already has it (onbtn 1), so a text field keeps its cursor
# keys and a list its scrolling. ret's 1 or -1; fails for any other key.
fn dt_focuskey(key, int? onbtn = "") {
	case $key in
	tab) ret 1 ;;
	shift-tab) ret -1 ;;
	right | down) [ "$onbtn" = 1 ] || return 1; ret 1 ;;
	left | up) [ "$onbtn" = 1 ] || return 1; ret -1 ;;
	*) return 1 ;;
	esac
}
