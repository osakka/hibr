# widgets/hit -- where widgets are: the regions a widget registers as it
# draws, and which one a click landed on.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# A checkbox and a dropdown, drawn the same way any other app content is:
# console put into the window's own pane, in the coordinates it draws in.
# Neither keeps state of its own -- an app passes in what to show and gets
# a tag back from dt_hit when its region is clicked, the same contract as
# an app's own _click callback, and updates its own state under its own
# window id, never here.
declare -gA WG

# Forget a window's widget regions.  Call at the top of its _draw, before
# drawing any dt_check or dt_wdrop -- a scrolled list moves them, so last
# frame's regions must not answer this frame's click.
fn dt_wclear(id) {
	unset "WG[$id]" "WH[$id]" "WT[$id]"
}

# Tooltips an app gives its own regions (Gitea #370): what the region tagged
# tag says when the pointer rests on it. Set where it is drawn, as the
# region is, and cleared with it by dt_wclear. The desktop's own glyphs --
# a title bar's buttons, the Control Strip's modules, the bar's items --
# say what they are without being told.
declare -gA WT
fn dt_tip(id, tag, text) {
	WT[$id]["$tag"]=$text
}

# The rows a list lights under the pointer (Gitea #370), kept apart from
# the widgets' regions so a list that turns a click into a row by its own
# arithmetic goes on doing so: dt_hit never answers one of these, only
# dt_hover reads them. Cleared with the rest by dt_wclear.
declare -gA WH

# Register a list row as something that lights under the pointer; it is
# drawn with dt_hotpen under the same tag.
fn dt_hotreg(id, int r, int c, int w, tag) {
	local n

	n=${WH[$id]["n"]:-0}
	WH[$id][$n]["r"]=$r
	WH[$id][$n]["c"]=$c
	WH[$id][$n]["w"]=$w
	WH[$id][$n]["tag"]=$tag
	WH[$id]["n"]=$((n + 1))
}

# Which registered row, if any, is at a pane-relative row and column.
fn dt_hothit(id, int r, int c) {
	local n i=0 wc

	n=${WH[$id]["n"]:-0}
	while [ "$i" -lt "$n" ]; do
		wc=${WH[$id][$i]["c"]}
		if [ "$r" = "${WH[$id][$i]["r"]}" ] && [ "$c" -ge "$wc" ] &&
		   [ "$c" -lt $((wc + ${WH[$id][$i]["w"]})) ]; then
			ret "${WH[$id][$i]["tag"]}"
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

# Record a widget's hit region.  The draw helpers below call this; an app
# does not call it directly.
fn dt_wreg(id, int r, int c, int w, tag) {
	local n

	n=${WG[$id]["n"]:-0}
	WG[$id][$n]["r"]=$r
	WG[$id][$n]["c"]=$c
	WG[$id][$n]["w"]=$w
	WG[$id][$n]["tag"]=$tag
	WG[$id]["n"]=$((n + 1))
}

# Which widget, if any, sits at a pane-relative row/col -- ret's its tag,
# empty for none.  An app's _click asks this before falling back to its
# own per-row logic.
fn dt_hit(id, int r, int c) {
	local n i=0 wr wc ww

	n=${WG[$id]["n"]:-0}
	while [ "$i" -lt "$n" ]; do
		wr=${WG[$id][$i]["r"]}
		wc=${WG[$id][$i]["c"]}
		ww=${WG[$id][$i]["w"]}
		if [ "$r" = "$wr" ] && [ "$c" -ge "$wc" ] &&
		   [ "$c" -lt $((wc + ww)) ]; then
			ret "${WG[$id][$i]["tag"]}"
			return 0
		fi
		i=$((i + 1))
	done
	# A miss is a bare `return 1`, and nothing before it: `ret` ends a
	# function **with status 0**, so `ret ""` here meant dt_hit reported
	# a hit for every click ever made, anywhere. `:=` has already
	# cleared the slot before the call, so there is nothing to put back.
	#
	# What that cost: an app whose `_click` reads
	# `tag := dt_hit ... && { case ...; return 0; }` swallowed every
	# click that was not on a widget -- the Catalogue's
	# whole list, measured as a click on a row doing nothing at all.
	# The two apps written `|| return 0` were luckier and still wrong:
	# the Vault said "Nothing is selected" for a click on empty space,
	# because an empty tag reached `vault_do`, and the contact editor
	# cleared the focused field for one.
	return 1
}

# Whether the region tagged tag in window id is under the pointer (Gitea
# #370), for a widget or a list row that lights while it is. The desktop
# works it out from the regions dt_wreg registered; nothing else asks.
fn dt_hot(id, tag) {
	[ -n "$tag" ] && [ "$DT_HOTWIN" = "$id" ] && [ "$DT_HOTTAG" = "$tag" ]
}

# The pen for a list row or anything else registered as tag: fg on bg, or
# on the well colour while the pointer is over it -- the colour the bar's
# titles light with, so there is one look for "a click here does
# something". A selected row keeps its own pen; its caller does not ask.
fn dt_hotpen(id, tag, fg, bg, ...attrs) {
	if dt_hot "$id" "$tag"; then
		console pen "$fg" "$DT_WELL" "${attrs[@]}"
	else
		console pen "$fg" "$bg" "${attrs[@]}"
	fi
}

# What the pointer was over in a window when it was last drawn, so a window
# left alone because nothing in it changed is drawn again when what is lit
# in it has (a _dirty answering "clean" knows nothing of the pointer).
fn dt_hotmark(int id) {
	if [ "$DT_HOTWIN" = "$id" ]; then
		DT[$id]["hotdrawn"]=$DT_HOTTAG
	else
		DT[$id]["hotdrawn"]=
	fi
}

fn dt_hotmoved(int id) {
	local now=

	[ "$DT_HOTWIN" = "$id" ] && now=$DT_HOTTAG
	[ "${DT[$id]["hotdrawn"]-}" != "$now" ]
}

# The column a registered widget's own region starts at, for opening
# something (a dropdown's popup) aligned to the widget itself rather than
# to wherever inside it happened to be clicked -- id and row the same as
# the dt_hit call that found tag there.
fn dt_wcol(int id, int r, tag) {
	local n i=0

	n=${WG[$id]["n"]:-0}
	while [ "$i" -lt "$n" ]; do
		if [ "${WG[$id][$i]["r"]}" = "$r" ] &&
		   [ "${WG[$id][$i]["tag"]}" = "$tag" ]; then
			ret "${WG[$id][$i]["c"]}"
			return 0
		fi
		i=$((i + 1))
	done
	ret "$r"
}
