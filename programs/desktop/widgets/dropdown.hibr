# widgets/dropdown -- a dropdown: its value, and the popup list of choices
# under it.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# Draw a value that opens a list of choices: "value ▾", padded to w
# columns, and a value too long for them cut with an ellipsis, so it can
# never cover its own caret or run past what is beside it (Gitea #282).
# tag is what dt_hit answers for a click on it.
fn dt_wdrop(int id, int r, int c, int w, value, tag = "") {
	local tag=${tag:-$value} lb=$value bl
	local -i vw

	vw := str width "$value"
	if [ "$vw" -gt $((w - 2)) ]; then
		lb := dt_cut "$value" $((w - 3))
		lb="$lb${GL[ellipsis]}"
	fi
	# The field and its caret first, then the value over its start, each
	# a write of its own: as one, a right-to-left value -- an Arabic
	# language's name, an Arabizi reading -- was reordered with the caret
	# and its padding, and drew to the caret's right (Gitea #543).
	bl := str pad "" $((w - 2))
	if dt_hot "$id" "$tag"; then
		console pen -s
		console pen "$DT_INK" "$DT_WELL"
		console put -p "w$id" "$r" "$c" "$bl ${GL[sdown]}"
		console put -p "w$id" "$r" "$c" "$lb"
		console pen -r
	else
		console put -p "w$id" "$r" "$c" "$bl ${GL[sdown]}"
		console put -p "w$id" "$r" "$c" "$lb"
	fi
	dt_wreg "$id" "$r" "$c" "$w" "$tag"
}

# Open a popup list of choices anchored under a dt_wdrop -- built the next
# frame by dt_dropcontext, the same one-frame lag dt_context_open always
# has. cb is called as "cb id value" when one is chosen; nothing runs if
# the popup is dismissed instead. This is a context menu with nowhere on
# the desktop it belongs to, which is exactly what a dropdown is -- it
# reuses dt_context_open and the MB/MI menu machinery rather than a second
# popup system of its own.
DT_POPID=
DT_POPCB=
DT_POPVALS=()
# Choices shown dimmed, which cannot be chosen: a caller sets
# DT_POPDIMNEXT just before dt_droplist, which takes it for the list it
# opens and leaves the next list with none.
DT_POPDIM=()
DT_POPDIMNEXT=()
# What turns a value into the words on its row, where they differ: a caller
# sets DT_POPNAMENEXT just before dt_droplist, the same way, and the callback
# is still handed the value.
DT_POPNAME=
DT_POPNAMENEXT=
# The value chosen now, which the list opens on and ticks: a caller sets
# DT_POPCURNEXT just before dt_droplist, the same way. DT_POPSELONCE is the
# row to start on, taken by the first build alone, so the arrows are not
# put back there every frame.
DT_POPCUR=
DT_POPCURNEXT=
DT_POPSELONCE=
# Every value ticked, for a list of things each on or off -- Not in the
# Switcher: set as DT_POPONNEXT the same way. Without it the value chosen
# now is the one ticked.
DT_POPON=()
DT_POPONNEXT=()

# Open a list of choices under a window's dropdown: r and c are the
# window's own, the coordinates an app draws and is clicked in, made the
# screen's for dt_dropat.
fn dt_droplist(int id, int r, int c, cb, ...rest) {
	shift 4
	dt_dropat $((DT[$id]["row"] + r + 1)) $((DT[$id]["col"] + c)) "$id" "$cb" "$@"
}

# Open a list of choices at a place on the screen, for id (a window, or
# none for what has no window -- the Control Strip): the one way a list is
# opened, so every list takes what its caller set and leaves nothing for
# the next.
fn dt_dropat(int r, int c, id, cb, ...rest) {
	local v i=0

	shift 4
	DT_POPID=$id
	DT_POPCB=$cb
	DT_POPVALS=("$@")
	DT_POPDIM=("${DT_POPDIMNEXT[@]}")
	DT_POPDIMNEXT=()
	DT_POPNAME=$DT_POPNAMENEXT
	DT_POPNAMENEXT=
	DT_POPCUR=$DT_POPCURNEXT
	DT_POPCURNEXT=
	DT_POPON=("${DT_POPONNEXT[@]}")
	DT_POPONNEXT=()
	[ "${#DT_POPON[@]}" -gt 0 ] || [ -z "$DT_POPCUR" ] || DT_POPON=("$DT_POPCUR")
	DT_POPSELONCE=0
	for v in "${DT_POPVALS[@]}"; do
		[ "$v" = "$DT_POPCUR" ] || [ "$v" = "${DT_POPON[0]-}" ] && { DT_POPSELONCE=$i; break; }
		i=$((i + 1))
	done
	dt_context_open widget "$id" "$r" "$c"
}

# Build the popup opened by dt_droplist, one item per value offered, the
# value chosen now ticked as a menu ticks its choice, and the first build
# starting on it.
dt_dropcontext() {
	local v l d on

	dt_menu ""
	for v in "${DT_POPVALS[@]}"; do
		l=$v
		[ -n "$DT_POPNAME" ] && l := "$DT_POPNAME" "$v"
		on=0
		for d in "${DT_POPON[@]}"; do
			[ "$d" = "$v" ] && { on=1; break; }
		done
		for d in "${DT_POPDIM[@]}"; do
			[ "$d" = "$v" ] && { dt_dim "$l"; continue 2; }
		done
		dt_mark "$l" "" "$on" "$DT_POPCB" "$DT_POPID" "$v"
	done
	if [ -n "$DT_POPSELONCE" ]; then
		MB_SEL=$DT_POPSELONCE
		DT_POPSELONCE=
	fi
}
