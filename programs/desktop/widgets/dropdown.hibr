# widgets/dropdown -- a dropdown: its value, and the popup list of choices
# under it.
#
# Part of the widget library apps draw with -- see widgets/README.md.

strict

# Draw a value that opens a list of choices: "value ▾", padded to w
# columns, and a value too long for them cut with an ellipsis, so it can
# never cover its own caret or run past what is beside it (Gitea #282).
# tag is what dt_hit answers for a click on it.
fn dt_wdrop(int id, int r, int c, int w, value, tag) {
	local tag=${tag:-$value} lb=$value
	local -i vw

	vw := str width "$value"
	if [ "$vw" -gt $((w - 2)) ]; then
		lb := dt_cut "$value" $((w - 3))
		lb="$lb${GL[ellipsis]}"
	fi
	lb := str pad "$lb" $((w - 2))
	console put -p "w$id" "$r" "$c" "$lb ${GL[sdown]}"
	dt_wreg "$id" "$r" "$c" "$w" "$tag"
}

# Open a popup list of choices anchored under a dt_wdrop -- built the next
# frame by dt_dropcontext, the same one-frame lag dt_context_open always
# has. cb is called as "cb id value" when one is chosen; nothing runs if
# the popup is dismissed instead. This is a context menu with nowhere on
# the desktop it belongs to, which is exactly what a dropdown is -- it
# reuses dt_context_open and the MB/MI menu machinery rather than a second
# popup system of its own.
DT_POPID=
DT_POPCB=
DT_POPVALS=()
# Choices shown dimmed, which cannot be chosen: a caller sets
# DT_POPDIMNEXT just before dt_droplist, which takes it for the list it
# opens and leaves the next list with none.
DT_POPDIM=()
DT_POPDIMNEXT=()

fn dt_droplist(int id, int r, int c, cb, ...rest) {
	shift 4
	DT_POPID=$id
	DT_POPCB=$cb
	DT_POPVALS=("$@")
	DT_POPDIM=("${DT_POPDIMNEXT[@]}")
	DT_POPDIMNEXT=()
	# r and c come in pane-relative, the same coordinates an app draws and
	# is clicked in everywhere else, but dt_context_open positions on the
	# real screen -- add the window's own row and column to convert.
	dt_context_open widget "$id" $((DT[$id]["row"] + r + 1)) \
		$((DT[$id]["col"] + c))
}

# Build the popup opened by dt_droplist, one item per value offered.
dt_dropcontext() {
	local v

	dt_menu ""
	for v in "${DT_POPVALS[@]}"; do
		case " ${DT_POPDIM[*]} " in
		*" $v "*) dt_dim "$v" ;;
		*) dt_item "$v" "" "$DT_POPCB" "$DT_POPID" "$v" ;;
		esac
	done
}
