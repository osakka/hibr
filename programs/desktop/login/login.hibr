#!/usr/bin/env hibr
#
# login -- hibr's login screen, for a text terminal: a screen saver always
# behind it, and a box over the saver asking for a user name, then that
# person's picture, name and password, and whether to start the desktop or
# a shell. The password is checked and the session opened through PAM by
# the auth module (`auth open`), and the session runs as the person
# (`auth run`), on this terminal, until it ends -- then the screen comes
# back for the next.
#
# It runs as root, started by systemd (hibr-login@.service, shipped off
# and enabled by hand: `systemctl enable --now hibr-login@tty2`), and is
# Linux only. Root never reads a person's files: their About Me
# (~/.config/hibr/me.json -- data, never run) and its picture are read by a
# child that has dropped to them, which hands back the JSON and the picture
# already decoded to a small PPM; root parses the one with hibr's own
# parser and draws the other with the img module's own few lines, so no
# image library ever sees a person's file as root. Root is refused at the
# box -- this is for people.
#
# Run as root it ends after each session and systemd starts a new one:
# pam_systemd moves whatever opened a session into that session, so a
# screen that stayed would carry the first person's session into the next
# login, and logind would refuse the second a session of its own.
#
# Settings are /etc/hibr/login.json, root's to write, and Control Panel >
# Login Manager's to change (Gitea #389): "saver" (a name, or random),
# "title" (above the box; the host name by default), "message" (one line
# under it), "service" (the PAM service; hibr-login when its file is
# installed), "glyphs" (unicode, or ascii -- the default on a Linux
# console, whose font has no katakana for the Matrix), "theme" and
# "colours" (a theme gives its colour scheme and glyphs; "colours" names a
# scheme of its own over the theme's), "language" (the screen's own words,
# a catalogue's code; English when there is none), "session" (desktop or shell, for
# whoever has not chosen) and "power" (on or off: Sleep, Restart and Shut
# Down from the screen, where it is the computer's own). A scheme, a theme
# and a saver are read only from the folders hibr ships and the system
# scope ($HIBR_SYSDIR) -- never from anybody's home, since this is root.
# The file is read once, at start: a change shows at the next logout.
# What it has to say goes to the journal under systemd, else to
# /var/log/hibr-login.log -- never onto the screen. A run as anyone but
# root is a trial of the screen itself, and can log in only as its own
# user.

strict

LG_HERE=${BASH_SOURCE%/*}
[ "$LG_HERE" = "$BASH_SOURCE" ] && LG_HERE=.

LG_CONFFILE="${LG_CONFFILE-/etc/hibr/login.json}"
LG_SERVICE="${LG_SERVICE-}"
LG_PAMDIR="${LG_PAMDIR-}"
# The seat and VT the screen is shown on, when it is not a VT of its own --
# a display server runs it on a pty, which says neither, and logind then
# took every login for a remote one with no seat: no sound over Bluetooth,
# no network or brightness for the person at the machine (Gitea #367). Blit
# sets them; on a VT (hibr-login@ttyN) PAM works them out itself.
LG_SEAT="${LG_SEAT-}"
LG_VTNR="${LG_VTNR-}"
LG_SAVER="${LG_SAVER-random}"
LG_TITLE="${LG_TITLE-}"
LG_MESSAGE="${LG_MESSAGE-}"
LG_ONCE="${LG_ONCE-}"
LG_THEME="${LG_THEME-}"
LG_COLOURS="${LG_COLOURS-}"
LG_DEFSESS="${LG_DEFSESS-desktop}"
LG_POWER="${LG_POWER-on}"
LG_LANG="${LG_LANG-}"
# Whether the language reads right to left, so the box is mirrored.
LG_RTL=
# The power actions this screen offers, found once at start, and where the
# chooser is: the action highlighted, the state it was opened from, the
# action waiting to be confirmed, and the row its list starts at.
declare -ga LG_PWACTS
LG_PWACTS=()
LG_PWSEL=0
LG_PWFROM=
LG_PWASK=
LG_PWROW=
# Where the password box last drew its rows, for a click: the box's top
# row, and the column the name, password and session start at.
LG_BOXR=
LG_BOXX=
LG_SESSIONCMD="${LG_SESSIONCMD-}"

if [ -z "${DT_GLYPHSET+x}" ]; then
	DT_GLYPHSET=unicode
	[ "$TERM" = linux ] && DT_GLYPHSET=ascii
fi
DT_INK="${DT_INK-#cbd5e0}"
DT_FACE="${DT_FACE-#101820}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_DIM="${DT_DIM-#718096}"
DT_BAD="${DT_BAD-#f56565}"
DT_WELL="${DT_WELL-#2d3748}"

LG_STATE=saver
LG_USER=
LG_PASS=
LG_NAME=
LG_LINE=
LG_PIC=
LG_SESS=desktop
LG_MSG=
LG_BAD=
LG_HOLD=0
LG_SEEN=0
LG_TMP=
LG_QUIT=
declare -gA LG_CONF
declare -gA LG_ME

# Read the settings file, if there is one -- a bad one is said and left.
lg_conf() {
	local j

	[ -r "$LG_CONFFILE" ] || return 0
	j=$(head -c 65536 "$LG_CONFFILE")
	if ! json parse LG_CONF "$j" 2> /dev/null; then
		printf 'login: %s is not JSON; using the defaults\n' "$LG_CONFFILE" >&2
		return 0
	fi
	[ -n "${LG_CONF["saver"]}" ] && LG_SAVER=${LG_CONF["saver"]}
	[ -n "${LG_CONF["title"]}" ] && LG_TITLE=${LG_CONF["title"]}
	[ -n "${LG_CONF["message"]}" ] && LG_MESSAGE=${LG_CONF["message"]}
	[ -n "${LG_CONF["service"]}" ] && LG_SERVICE=${LG_CONF["service"]}
	[ -n "${LG_CONF["theme"]}" ] && LG_THEME=${LG_CONF["theme"]}
	[ -n "${LG_CONF["colours"]}" ] && LG_COLOURS=${LG_CONF["colours"]}
	case ${LG_CONF["session"]} in desktop|shell) LG_DEFSESS=${LG_CONF["session"]} ;; esac
	case ${LG_CONF["power"]} in on|off) LG_POWER=${LG_CONF["power"]} ;; esac
	[ -n "${LG_CONF["language"]}" ] && LG_LANG=${LG_CONF["language"]}
	case ${LG_CONF["glyphs"]} in unicode|ascii) DT_GLYPHSET=${LG_CONF["glyphs"]} ;; esac
	return 0
}

# How the screen looks, from the settings: the theme, then a colour scheme
# of its own over the theme's. Root draws the title and the message, so no
# control character in them reaches the terminal, as for a person's name.
lg_look() {
	LG_TITLE=${LG_TITLE//[[:cntrl:]]/}
	LG_MESSAGE=${LG_MESSAGE//[[:cntrl:]]/}
	[ -n "$LG_THEME" ] && lg_theme "$LG_THEME"
	[ -n "$LG_COLOURS" ] && lg_colours "$LG_COLOURS"
	return 0
}

# Where a theme, a colour scheme or a saver of this name is, as root may
# read it: the system scope first, which an administrator installed and
# is authoritative (ADR 0045), then what hibr ships. Never a home.
fn lg_find(kind, file) {
	local d

	[[ $file =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
	for d in ${HIBR_SYSDIR:+"$HIBR_SYSDIR/$kind"} "$LG_HERE/../$kind"; do
		[ -f "$d/$file" ] && [ ! -L "$d/$file" ] && { ret "$d/$file"; return 0; }
	done
	return 1
}

# Take a theme's colour scheme and glyphs -- what this screen draws with
# of what a theme says. A "colours" of the settings' own is applied after
# it and wins, as it does in Control Panel > Appearance.
fn lg_theme(name) {
	local f v
	local -A t

	f := lg_find themes "$name.json" ||
		{ printf 'login: no theme called %s\n' "$name" >&2; return 0; }
	json parse t < "$f" 2> /dev/null ||
		{ printf 'login: %s is not JSON\n' "$f" >&2; return 0; }
	v=${t["colours"]-}
	[ -z "$LG_COLOURS" ] && [ -n "$v" ] && LG_COLOURS=$v
	if [ -z "${LG_CONF["glyphs"]}" ]; then
		case ${t["glyphs"]-} in unicode|ascii) DT_GLYPHSET=${t["glyphs"]} ;; esac
	fi
	return 0
}

# Speak a language: its catalogue, from what hibr ships or the system scope
# as a theme is, loaded with the lang module the desktop uses, so dt_tr
# (lib/tr.hibr) answers in it. Right to left, the box is mirrored and the
# console puts each line in display order, as the desktop does on a
# terminal that does not do it itself -- a VT and Blit both. A catalogue
# that is not there, or will not load, leaves the screen in English.
lg_lang() {
	local f i

	DT_LANGON=
	LG_RTL=
	[ -n "$LG_LANG" ] || return 0
	f := lg_find lang "$LG_LANG.json" ||
		{ printf 'login: no language called %s\n' "$LG_LANG" >&2; return 0; }
	if ! need lang 2> /dev/null || ! lang load "$f" 2> /dev/null; then
		printf 'login: %s could not be loaded; English it is\n' "$f" >&2
		return 0
	fi
	DT_LANGON=1
	i := lang info
	[[ $i == *$'\t'rtl$'\t'* ]] && LG_RTL=1
	return 0
}

# The console's own right-to-left ordering, each time it is opened, for a
# language that reads that way -- unless DT_BIDI says the terminal does it.
lg_bidi() {
	[ -n "$LG_RTL" ] && [ "${DT_BIDI:-auto}" != off ] && console bidi on
	return 0
}

# Draw in a colour scheme: read through lib/colours.hibr, the reader the
# desktop's own Appearance uses, so a file refused there is refused here;
# a scheme that is not there, or is refused, leaves the colours as they
# were.
fn lg_colours(name) {
	local f

	f := lg_find colours "$name.json" ||
		{ printf 'login: no colour scheme called %s\n' "$name" >&2; return 0; }
	cp_colourread login "$f" ||
		{ printf 'login: %s is not a colour scheme\n' "$f" >&2; return 0; }
	DT_INK=${CP_CO["login"]["ink"]}
	DT_FACE=${CP_CO["login"]["face"]}
	DT_ACTIVE=${CP_CO["login"]["active"]}
	DT_DIM=${CP_CO["login"]["dim"]}
	DT_BAD=${CP_CO["login"]["bad"]}
	DT_WELL=${CP_CO["login"]["well"]}
	return 0
}

# Run a command as a person, to read what is theirs: as root a child drops
# to them first; anyone else may only read their own. It gets five seconds:
# a person who made their About Me a pipe nobody writes to must not hang
# the screen for everyone else.
fn lg_as(u, ...rest) {
	local pid dog st

	if [ "$EUID" = 0 ]; then
		( drop "$u" > /dev/null 2>&1 && "${rest[@]}" ) &
	elif [ "$u" = "$(id -un)" ]; then
		( "${rest[@]}" ) &
	else
		return 1
	fi
	pid=$!
	( sleep 5; kill -9 "$pid" ) > /dev/null 2>&1 &
	dog=$!
	wait "$pid"
	st=$?
	kill "$dog" 2> /dev/null
	return "$st"
}

# Read a person's file, as them, only if it is a plain file.
fn lg_readf(f) { [ -f "$f" ] && head -c 65536 -- "$f"; }

# Decode a person's picture, as them, only if it is a plain file.
fn lg_ppm(f) { [ -f "$f" ] && img -o ppm -w 16 -h 8 "$f"; }

# Find out who a typed name is: the account's real name, home and shell
# from the password database, then their own About Me, read as them. What
# they wrote there is drawn by root, so no control character survives --
# an escape sequence in a name would otherwise reach the terminal.
fn lg_who(u) {
	local ent j pic home cfg
	local -a f

	LG_NAME=$u
	LG_LINE=
	LG_PIC=
	LG_SESS=$LG_DEFSESS
	LG_ME=()
	[[ $u =~ ^[a-z_][a-z0-9_.-]*[$]?$ ]] || return 1
	ent=$(getent passwd "$u" 2> /dev/null)
	[ -n "$ent" ] || return 1
	IFS=: read -ra f <<< "$ent"
	[ "${f[2]}" != 0 ] || return 1
	[ -n "${f[4]%%,*}" ] && LG_NAME=${f[4]%%,*}
	home=${f[5]}
	cfg=$home/.config
	[ "$EUID" != 0 ] && [ -n "$XDG_CONFIG_HOME" ] && cfg=$XDG_CONFIG_HOME
	j=$(lg_as "$u" lg_readf "$cfg/hibr/me.json" 2> /dev/null)
	if [ -n "$j" ] && json parse LG_ME "$j" 2> /dev/null; then
		[ -n "${LG_ME["name"]}" ] && LG_NAME=${LG_ME["name"]:0:40}
		LG_LINE=${LG_ME["line"]:0:60}
		case ${LG_ME["session"]} in desktop|shell) LG_SESS=${LG_ME["session"]} ;; esac
		pic=${LG_ME["picture"]}
		case $pic in
		"~/"*) pic=$home/${pic#"~/"} ;;
		/*) ;;
		?*) pic=$home/$pic ;;
		esac
		if [ -n "$pic" ] && need img 2> /dev/null; then
			lg_as "$u" lg_ppm "$pic" > "$LG_TMP/pic-$u.ppm" 2> /dev/null &&
				[ -s "$LG_TMP/pic-$u.ppm" ] && LG_PIC=$LG_TMP/pic-$u.ppm
		fi
	fi
	LG_NAME=${LG_NAME//[[:cntrl:]]/}
	LG_LINE=${LG_LINE//[[:cntrl:]]/}
	return 0
}

# The screen's size, into SV_ROWS and SV_COLS.
lg_size() { sv_size; }

# Draw the box over the saver: the title, then either the user name field
# or the person's picture, name, password and session.
lg_box() {
	local w=56 h=14 r c i fw t dots n sx px lw x
	local rows=$SV_ROWS cols=$SV_COLS

	[ "$w" -gt $((cols - 2)) ] && w=$((cols - 2))
	[ "$w" -lt 30 ] && w=30
	r=$(( (rows - h) / 2 ))
	c=$(( (cols - w) / 2 ))
	[ "$r" -lt 0 ] && r=0
	[ "$c" -lt 0 ] && c=0
	console pen "$DT_INK" "$DT_FACE"
	console fill "$r" "$c" "$h" "$w" " "
	console put "$r" "$c" "${GL[tl]}"
	console put "$r" $((c + w - 1)) "${GL[tr]}"
	console put $((r + h - 1)) "$c" "${GL[bl]}"
	console put $((r + h - 1)) $((c + w - 1)) "${GL[br]}"
	i=1
	while [ "$i" -lt $((w - 1)) ]; do
		console put "$r" $((c + i)) "${GL[hline]}"
		console put $((r + h - 1)) $((c + i)) "${GL[hline]}"
		i=$((i + 1))
	done
	i=1
	while [ "$i" -lt $((h - 1)) ]; do
		console put $((r + i)) "$c" "${GL[vline]}"
		console put $((r + i)) $((c + w - 1)) "${GL[vline]}"
		i=$((i + 1))
	done
	t := lg_cut "${LG_TITLE:-$HOSTNAME}" $((w - 4))
	lw := str width "$t"
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	console put $((r + 1)) $((c + (w - lw) / 2)) "$t"
	if [ -n "$LG_MESSAGE" ]; then
		console pen "$DT_DIM" "$DT_FACE"
		lg_text $((r + 2)) $((c + 3)) $((w - 6)) "$LG_MESSAGE"
	fi
	lg_pwlabel $((r + h)) "$c" "$w"
	if [ "$LG_STATE" = power ]; then
		lg_pwbox "$r" "$c" "$w" "$h"
		return 0
	fi
	if [ "$LG_STATE" = name ]; then
		fw=$((w - 6))
		console pen "$DT_INK" "$DT_FACE"
		t := dt_tr "User name"
		lg_text $((r + 5)) $((c + 3)) "$fw" "$t"
		console pen "$DT_INK" "$DT_WELL"
		console fill $((r + 6)) $((c + 3)) 1 "$fw" " "
		console put $((r + 6)) $((c + 3)) "${LG_USER: -$fw}"
		n=${#LG_USER}
		[ "$n" -gt "$fw" ] && n=$fw
		lg_msg $((r + h - 3)) $((c + 3)) $((w - 6))
		console cursor $((r + 6)) $((c + 3 + n))
		return 0
	fi
	# The picture on the start side, the words beside it; mirrored, the
	# picture is on the right and the words before it.
	sx=$((c + 3))
	px=$((c + 21))
	if [ -n "$LG_RTL" ]; then
		sx=$((c + w - 19))
		px=$((c + 3))
	fi
	if [ -n "$LG_PIC" ] && [ "$w" -ge 50 ]; then
		img draw "$LG_PIC" $((r + 3)) "$sx" 8 16 2> /dev/null
	else
		console pen "$DT_DIM" "$DT_WELL"
		console fill $((r + 3)) "$sx" 8 16 " "
		console put $((r + 6)) $((sx + 7)) "${LG_NAME:0:1}"
	fi
	[ "$w" -lt 50 ] && px=$((c + 3))
	fw=$((w - 24))
	[ "$w" -lt 50 ] && fw=$((w - 6))
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	lg_text $((r + 3)) "$px" "$fw" "$LG_NAME"
	console pen "$DT_DIM" "$DT_FACE"
	lg_text $((r + 4)) "$px" "$fw" "$LG_LINE"
	console pen "$DT_INK" "$DT_FACE"
	t := dt_tr "Password"
	lg_text $((r + 6)) "$px" "$fw" "$t"
	n=${#LG_PASS}
	[ "$n" -gt "$fw" ] && n=$fw
	dots=
	i=0
	while [ "$i" -lt "$n" ]; do
		dots+=${GL[bullet]}
		i=$((i + 1))
	done
	console pen "$DT_INK" "$DT_WELL"
	console fill $((r + 7)) "$px" 1 "$fw" " "
	console put $((r + 7)) "$px" "$dots"
	lg_sessrow $((r + 9)) "$px" "$fw"
	LG_BOXR=$r
	LG_BOXX=$px
	# The message is under the picture, so it has the box's whole width:
	# beside it the hint was cut, in English as in any other language.
	lg_msg $((r + h - 3)) $((c + 3)) $((w - 6))
	console cursor $((r + 7)) $((px + n))
}

# Text in the columns from x to x+w, cut to fit and against the start
# side: the left, or the right when the language reads right to left.
fn lg_text(int r, int x, int w, t) {
	local tw

	t := lg_cut "$t" "$w"
	if [ -n "$LG_RTL" ]; then
		tw := str width "$t"
		x=$((x + w - tw))
	fi
	console put "$r" "$x" "$t"
}

# Text cut to w columns. A character is a column unless the text says
# otherwise, which is the common case and the cheap one.
fn lg_cut(t, int w) {
	local tw out= ch i=0 n

	[ "$w" -lt 1 ] && { ret ""; return 0; }
	tw := str width "$t"
	[ "$tw" -le "$w" ] && { ret "$t"; return 0; }
	[ "$tw" = "${#t}" ] && { ret "${t:0:$w}"; return 0; }
	tw=0
	while [ "$i" -lt "${#t}" ]; do
		ch=${t:$i:1}
		n := str width "$ch"
		[ $((tw + n)) -gt "$w" ] && break
		out+=$ch
		tw=$((tw + n))
		i=$((i + 1))
	done
	ret "$out"
}

# The Session row: its label, then Desktop and Shell, the chosen one in the
# accent; mirrored, from the right. Where each was drawn is kept for a
# click (LG_SESSD, LG_SESSS: the column it starts at and its width).
LG_SESSD=
LG_SESSS=
fn lg_sessrow(int r, int px, int fw) {
	local l d sh lw dw sw x

	l := dt_tr "Session"
	d := dt_tr "Desktop"
	sh := dt_tr "Shell"
	d=" $d "
	sh=" $sh "
	lw := str width "$l"
	dw := str width "$d"
	sw := str width "$sh"
	console pen "$DT_INK" "$DT_FACE"
	if [ -n "$LG_RTL" ]; then
		x=$((px + fw - lw))
		console put "$r" "$x" "$l"
		LG_SESSD="$((x - 2 - dw)) $dw"
		LG_SESSS="$((x - 3 - dw - sw)) $sw"
	else
		console put "$r" "$px" "$l"
		LG_SESSD="$((px + lw + 2)) $dw"
		LG_SESSS="$((px + lw + 3 + dw)) $sw"
	fi
	if [ "$LG_SESS" = desktop ]; then
		console pen "$DT_FACE" "$DT_ACTIVE" bold
	else
		console pen "$DT_DIM" "$DT_FACE"
	fi
	console put "$r" "${LG_SESSD%% *}" "$d"
	if [ "$LG_SESS" = shell ]; then
		console pen "$DT_FACE" "$DT_ACTIVE" bold
	else
		console pen "$DT_DIM" "$DT_FACE"
	fi
	console put "$r" "${LG_SESSS%% *}" "$sh"
}

# Under the box, where the power actions are offered: Power, and the key
# that opens it, at the end side of the box. Kept for a click (LG_PWLAB).
LG_PWLAB=
fn lg_pwlabel(int r, int c, int w) {
	local t tw x

	LG_PWLAB=
	[ "${#LG_PWACTS[@]}" -gt 0 ] || return 0
	[ "$r" -lt "$SV_ROWS" ] || return 0
	t := dt_tr "Power"
	t=" ${GL[power]} $t  F10 "
	tw := str width "$t"
	x=$((c + w - tw - 1))
	[ -n "$LG_RTL" ] && x=$((c + 1))
	console pen "$DT_INK" "$DT_FACE"
	console put "$r" "$x" "$t"
	LG_PWLAB="$r $x $tw"
}

# The chooser, in the box: each action logind allows, the highlighted one
# in the accent, then the line that says what Enter and Esc do.
fn lg_pwbox(int r, int c, int w, int h) {
	local i t

	LG_PWROW=$((r + 4))
	console pen "$DT_INK" "$DT_FACE"
	t := dt_tr "Power"
	lg_text $((r + 3)) $((c + 3)) $((w - 6)) "$t"
	for i in "${!LG_PWACTS[@]}"; do
		t := lg_pwname "${LG_PWACTS[$i]}"
		if [ "$i" = "$LG_PWSEL" ]; then
			console pen "$DT_FACE" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_WELL"
		fi
		console fill $((LG_PWROW + i)) $((c + 3)) 1 $((w - 6)) " "
		lg_text $((LG_PWROW + i)) $((c + 4)) $((w - 8)) "$t"
	done
	LG_BOXX=$((c + 3))
	lg_msg $((r + h - 3)) $((c + 3)) $((w - 6))
	console cursor off
}

# The message line: what went wrong in red, a hint otherwise.
fn lg_msg(int r, int c, int w) {
	local t=$LG_MSG

	if [ -n "$LG_BAD" ]; then
		console pen "$DT_BAD" "$DT_FACE"
	else
		console pen "$DT_DIM" "$DT_FACE"
		if [ -z "$t" ]; then
			if [ "$LG_STATE" = name ]; then
				t := dt_tr "Enter to go on"
			elif [ "$LG_STATE" = power ]; then
				t := dt_tr "Enter: do it  Esc: back"
			else
				t := dt_tr "Tab: session  Enter: log in  Esc: name"
			fi
		fi
	fi
	lg_text "$r" "$c" "$w" "$t"
}

# Back to the saver, everything typed forgotten.
lg_rest() {
	LG_STATE=saver
	LG_USER=
	LG_PASS=
	LG_MSG=
	LG_BAD=
	LG_PIC=
	console cursor off
	sv_begin "$LG_SAVER" || { console pen white black; console clear; }
}

# Log in: open the session, give the terminal to it until it ends, and
# come back to the saver.
lg_login() {
	local -a opt=(-q) cmd
	local st why

	[ -n "$LG_SERVICE" ] && opt+=(-s "$LG_SERVICE")
	[ -n "$LG_PAMDIR" ] && opt+=(-c "$LG_PAMDIR")
	[ -n "$LG_SEAT" ] && opt+=(-e "XDG_SEAT=$LG_SEAT")
	[ -n "$LG_VTNR" ] && opt+=(-e "XDG_VTNR=$LG_VTNR")
	# What Blit is, for the desktop's glyphs: a session starts from an
	# empty environment, so this is the way through. Nothing else of
	# Blit's is passed: its tokens and the login screen's own surface are
	# this screen's, not the session's (the Blit maintainer, 0.99.357).
	[ -n "${BLIT_VERSION-}" ] && opt+=(-e "BLIT_VERSION=$BLIT_VERSION")
	LG_MSG := dt_tr "Checking${GL[ellipsis]}"
	LG_BAD=
	lg_box
	console flush
	why := auth open "${opt[@]}" "$LG_USER" "$LG_PASS"
	st=$?
	LG_PASS=
	if [ "$st" != 0 ]; then
		LG_BAD=1
		if [ "$st" = 1 ]; then
			[ "$why" = "Authentication failure" ] && why=
			# A refusal keeps the way back on the line, since the name
			# may be what was wrong: the box asks every name for a
			# password, so as not to say which names are accounts.
			if [ -n "$why" ]; then
				LG_MSG=$why
			else
				LG_MSG := dt_tr "Not the password. Esc: name"
			fi
		elif [ -n "$why" ]; then
			LG_MSG := dt_tr "Cannot log in: %s" "$why"
		else
			LG_MSG := dt_tr "Cannot log in"
		fi
		printf 'login: %s refused: %s\n' "$LG_USER" "${why:-wrong password}" >&2
		local now
		now := lg_ms
		LG_HOLD=$((now + 2000))
		return 0
	fi
	printf 'login: %s logged in (%s)\n' "$LG_USER" "$LG_SESS" >&2
	if [ -n "$LG_SESSIONCMD" ]; then
		read -ra cmd <<< "$LG_SESSIONCMD"
		cmd+=("$LG_SESS")
	else
		cmd=("$HIBR" "$LG_HERE/start.hibr" "$LG_SESS")
	fi
	console mouse off
	console close
	# The session's standard error is the terminal, which is where this
	# screen draws: this screen's own goes to its log (or, under systemd,
	# the journal), and a session that inherited it wrote a shell's every
	# prompt there, so choosing Shell showed a screen that never answered.
	auth run "${cmd[@]}" 2>&1
	st=$?
	auth close
	printf 'login: %s logged out (status %s)\n' "$LG_USER" "$st" >&2
	if [ -n "$LG_ONCE" ] || [ "$EUID" = 0 ]; then
		LG_QUIT=1
		return 0
	fi
	console open
	console mouse click
	lg_bidi
	lg_size
	lg_rest
}

# Whether this screen is at the computer: a seat named by whatever runs it
# (Blit sets LG_SEAT), or a virtual terminal of its own (hibr-login@ttyN).
# Over SSH or in a window it is neither, and Shut Down there would turn off
# a computer nobody at it asked to turn off.
lg_local() {
	local t

	[ -n "$LG_SEAT" ] && return 0
	t=$(tty 2> /dev/null)
	[[ $t =~ ^/dev/tty[0-9]+$ ]]
}

# The power actions to offer, asked of logind once (lib/logind.hibr): none
# when the settings say off or the screen is not the computer's own.
lg_pwfind() {
	local a

	LG_PWACTS=()
	[ "$LG_POWER" = on ] && lg_local || return 0
	for a in suspend hibernate reboot poweroff; do
		ld_can "$a" && LG_PWACTS+=("$a")
	done
	return 0
}

# What an action is called on the screen.
fn lg_pwname(a) {
	local t

	case $a in
	suspend) t := dt_tr "Sleep" ;;
	hibernate) t := dt_tr "Hibernate" ;;
	reboot) t := dt_tr "Restart" ;;
	poweroff) t := dt_tr "Shut Down" ;;
	*) return 1 ;;
	esac
	ret "$t"
}

# Open the chooser, from whatever was showing; F10 or a click on Power.
lg_pwopen() {
	[ "${#LG_PWACTS[@]}" -gt 0 ] || return 0
	[ "$LG_STATE" = power ] && return 0
	LG_PWFROM=$LG_STATE
	[ "$LG_PWFROM" = saver ] && LG_PWFROM=name
	LG_STATE=power
	LG_PWSEL=0
	LG_PWASK=
	LG_MSG=
	LG_BAD=
}

# Back to what the chooser was opened from.
lg_pwclose() {
	LG_STATE=${LG_PWFROM:-name}
	LG_PWASK=
	LG_MSG=
	LG_BAD=
}

# Choose the highlighted action: Sleep and Hibernate at once, Restart and
# Shut Down only once asked again, as the desktop's own do.
lg_pwchoose() {
	local a=${LG_PWACTS[$LG_PWSEL]} t

	case $a in
	reboot | poweroff)
		if [ "$LG_PWASK" != "$a" ]; then
			LG_PWASK=$a
			t := lg_pwname "$a"
			LG_MSG := dt_tr "%s? Enter: yes  Esc: no" "$t"
			LG_BAD=
			return 0
		fi
		;;
	esac
	lg_pwgo "$a"
}

# Do it, through logind. A refusal says so in the box and in the log.
fn lg_pwgo(a) {
	LG_PWASK=
	printf 'login: power: %s\n' "$a" >&2
	if ! ld_do "$a"; then
		printf 'login: power: %s refused: %s\n' "$a" "$LD_WHY" >&2
		LG_MSG := dt_tr "The computer did not do it: logind refused"
		LG_BAD=1
		return 0
	fi
	lg_pwclose
	lg_rest
}

# Milliseconds, for the hold after a wrong password.
lg_ms() {
	local t=${EPOCHREALTIME/./}

	ret $((t / 1000))
}

# Back from the password to the name, the name kept to be put right.
lg_back() {
	LG_STATE=name
	LG_PASS=
	LG_MSG=
	LG_BAD=
	LG_PIC=
}

# A click on the password box: on Desktop or Shell chooses it, on the
# person's name goes back to the name, anywhere else does nothing.
fn lg_click(k) {
	local -a ev
	local r c

	read -ra ev <<< "$k"
	r=${ev[3]}
	c=${ev[4]}
	[ -n "$LG_BOXR" ] || return 0
	if [ "$r" = $((LG_BOXR + 9)) ]; then
		if lg_in "$c" "$LG_SESSD"; then
			LG_SESS=desktop
		elif lg_in "$c" "$LG_SESSS"; then
			LG_SESS=shell
		fi
	elif [ "$r" -ge $((LG_BOXR + 3)) ] && [ "$r" -le $((LG_BOXR + 4)) ]; then
		lg_back
	fi
	return 0
}

# Whether column c is inside a span kept as "start width".
fn lg_in(int c, span) {
	local -a s

	read -ra s <<< "$span"
	[ "${#s[@]}" = 2 ] && [ "$c" -ge "${s[0]}" ] && [ "$c" -lt $((s[0] + s[1])) ]
}

# Whether a click landed on the Power label under the box.
fn lg_pwhit(k) {
	local -a ev l

	[ -n "$LG_PWLAB" ] || return 1
	read -ra ev <<< "$k"
	read -ra l <<< "$LG_PWLAB"
	[ "${ev[3]}" = "${l[0]}" ] && [ "${ev[4]}" -ge "${l[1]}" ] &&
		[ "${ev[4]}" -lt $((l[1] + l[2])) ]
}

# A key or a click in the chooser: the arrows move, Enter chooses -- twice
# for Restart and Shut Down -- and Esc goes back, first from a question,
# then from the chooser. A click on an action chooses it.
fn lg_pwkey(k) {
	local n=${#LG_PWACTS[@]} r
	local -a ev

	case $k in
	up) [ "$LG_PWSEL" -gt 0 ] && LG_PWSEL=$((LG_PWSEL - 1)); LG_PWASK=; LG_MSG= ;;
	down) [ "$LG_PWSEL" -lt $((n - 1)) ] && LG_PWSEL=$((LG_PWSEL + 1)); LG_PWASK=; LG_MSG= ;;
	enter) lg_pwchoose ;;
	escape)
		if [ -n "$LG_PWASK" ]; then
			LG_PWASK=
			LG_MSG=
		else
			lg_pwclose
		fi
		;;
	"mouse press "*)
		read -ra ev <<< "$k"
		r=$((ev[3] - LG_PWROW))
		if [ -n "$LG_PWROW" ] && [ "$r" -ge 0 ] && [ "$r" -lt "$n" ]; then
			[ "$r" != "$LG_PWSEL" ] && LG_PWASK=
			LG_PWSEL=$r
			lg_pwchoose
		fi
		;;
	esac
	return 0
}

# A key or a click.
fn lg_key(k) {
	local now

	now := lg_ms
	[ "$now" -lt "$LG_HOLD" ] && return 0
	LG_SEEN=$EPOCHSECONDS
	if [ "$k" = f10 ]; then
		lg_pwopen
		return 0
	fi
	if [ "$LG_STATE" = power ]; then
		lg_pwkey "$k"
		return 0
	fi
	case $k in
	"mouse press "*)
		if [ "$LG_STATE" != saver ] && lg_pwhit "$k"; then
			lg_pwopen
			return 0
		fi
		;;
	esac
	if [ "$LG_STATE" = saver ]; then
		LG_STATE=name
		[ "${#k}" = 1 ] || return 0
	fi
	if [ "$LG_STATE" = name ]; then
		case $k in
		escape) lg_rest ;;
		enter)
			[ -n "$LG_USER" ] || return 0
			LG_MSG=
			LG_BAD=
			if ! lg_who "$LG_USER"; then
				LG_NAME=$LG_USER
			fi
			LG_STATE=pass
			;;
		backspace) LG_USER=${LG_USER%?} ;;
		ctrl-u) LG_USER= ;;
		*) [ "${#k}" = 1 ] && [ "${#LG_USER}" -lt 32 ] && LG_USER+=$k ;;
		esac
		return 0
	fi
	case $k in
	escape) lg_back ;;
	enter) [ -n "$LG_PASS" ] && lg_login ;;
	tab|left|right)
		if [ "$LG_SESS" = desktop ]; then LG_SESS=shell; else LG_SESS=desktop; fi
		;;
	# Backspace with nothing typed goes back to the name, which is the way
	# back anybody tries first when the name was the mistake.
	backspace)
		if [ -z "$LG_PASS" ]; then
			lg_back
		else
			LG_PASS=${LG_PASS%?}
		fi
		;;
	"mouse press "*) lg_click "$k" ;;
	ctrl-u) LG_PASS= ;;
	*)
		if [ "${#k}" = 1 ]; then
			LG_PASS+=$k
			LG_BAD=
			LG_MSG=
		fi
		;;
	esac
	return 0
}

# The screen: the saver's frames, the box over them while it asks, keys
# between; never ends on its own.
lg_main() {
	local ms k

	need console || { echo "login: needs the console module" >&2; return 1; }
	need auth || { echo "login: needs the auth module" >&2; return 1; }
	if [ "$EUID" = 0 ]; then
		need sys || { echo "login: needs the sys module, for drop" >&2; return 1; }
	fi
	if [ -t 2 ]; then
		if [ "$EUID" = 0 ]; then
			exec 2>> /var/log/hibr-login.log
		else
			mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/hibr" 2> /dev/null
			exec 2>> "${XDG_STATE_HOME:-$HOME/.local/state}/hibr/login.log"
		fi
	fi
	LG_TMP=$(mktemp -d "${TMPDIR:-/tmp}/hibr-login.XXXXXX") || return 1
	trap 'rm -rf "$LG_TMP"' EXIT
	. "$LG_HERE/../lib/colours.hibr"
	. "$LG_HERE/../lib/logind.hibr"
	. "$LG_HERE/../lib/tr.hibr"
	lg_conf
	lg_look
	lg_lang
	lg_pwfind
	[ -z "$LG_SERVICE" ] && [ -r /etc/pam.d/hibr-login ] && LG_SERVICE=hibr-login
	. "$LG_HERE/../wm/glyphs.hibr"
	. "$LG_HERE/../savers/saver.hibr"
	sv_load
	console open || return 1
	console mouse click
	lg_bidi
	lg_size
	lg_rest
	while [ -z "$LG_QUIT" ]; do
		if [ "$LG_STATE" != saver ] && [ $((EPOCHSECONDS - LG_SEEN)) -ge 60 ]; then
			lg_rest
		fi
		ms=1000
		if [ -n "$SV_NAME" ]; then
			ms := sv_frame
		fi
		if [ "$LG_STATE" != saver ]; then
			lg_box
			[ "$ms" -gt 500 ] && ms=500
		fi
		console flush
		if [ -n "$HIBR_TESTIDLE" ]; then
			k := console consumed
			printf '\e]7777;idle;%s;0\a' "$k"
		fi
		k := console key "$ms"
		[ -n "$k" ] && [ "$k" != resize ] && lg_key "$k"
		if console resized; then
			lg_size
		fi
	done
	console mouse off
	console close 2> /dev/null
	return 0
}

[ "${BASH_SOURCE}" = "$0" ] && lg_main "$@"
