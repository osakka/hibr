#!/usr/bin/env hibr
#
# runtime -- the app runtime (ADR 0050): what an app's own process sources
# in place of the desktop. The app interface (interface.hibr: the widgets
# and the window manager's shared files), then every request and
# declaration as a function that sends itself to the desktop
# (requests.hibr, generated from interface.tsv), then the socket those go
# through: opened with a hello carrying the protocol and the hibr version,
# which the desktop checks before it carries anything.
#
# DT_HERE is where the desktop's files are, DT_RTSOCK the desktop's socket
# for app processes, and DT_RTTOKEN the token of this launch, which the
# hello spends and which says whose this process is; all three are given by
# whatever started this one (dt_rtspawn). Run rather than sourced --
# `hibr runtime.hibr APP FILE`, as the desktop starts an installed app
# (dt_rthost) -- it is that app's whole process: the app's file read, the
# hello, its windows' cells on a channel of their own, and its loop.

strict
DT_HERE="${DT_HERE:-${BASH_SOURCE[0]%/*}}"
# A slip in an app -- a write the desktop's copies refuse, an arithmetic
# error -- fails that one command and is logged, as it does in the desktop,
# never ends the app's loop with it.
set -o keepgoing

# A line from the desktop may be as long as what it holds -- the clipboard's
# history at the hello, one large copy -- and the desktop is not a peer this
# process guards against, so its lines may run to 256 MiB.
DT_RTLINEMAX="${DT_RTLINEMAX-268435456}"
. "$DT_HERE/interface.hibr"
. "$DT_HERE/requests.hibr"
# A hangup is not an app's end: the desktop's end of its socket is. An app
# process started from the desktop is in the desktop's process group, as a
# non-interactive shell's jobs are, so a desktop that dies outright -- its
# terminal hung up, or killed -- hangs it up too, and it ended before it had
# read that its socket had ended. With a handler it reads the end and goes
# in order; a handler, never an ignore, which the programs an app starts
# would inherit across exec.
trap : HUP
# Every app process waits through the console (dt_rtrun) and may watch its
# own descriptors with it before the loop starts, so it is loaded here.
need console || dt_log "app runtime: no console module, so no wait for this app"

# The other kinds of thing this process's file registers, each drawn in a
# view of its own (ADR 0050, the view kinds): by prefix, "pane" a Control
# Panel pane, "strip" a Control Strip module, "saver MS" a screen saver and
# the milliseconds between its frames. The registrations themselves are
# the desktop's, read from the file; here they say what this process draws.
# Both are recorded before the file is read, so the desktop can never call
# them by name.
declare -gA DT_RTKP
DT_RTBARD=
DT_RTBARS=
DT_RTHOOKS=()
# What the pointer is over, which a pane of rows drawn here lights
# (dt_hotpen): the desktop's own, told (dt_rtrowshover).
DT_HOTWIN=
DT_HOTTAG=
# What each pane of rows drawn here last told the desktop it holds.
declare -gA DT_RTROWTXT
# A pane's title, as its file declares it: what the panel's rows name the
# pane by when a search narrows them here ("Show all of TITLE").
declare -gA CP_PANES
fn cp_pane(pane, title, icon, group = "system") {
	DT_RTKP["$pane"]=pane
	CP_PANES["$pane"]["title"]=$title
}
fn sv_saver(name, title, int ms) {
	DT_RTKP["$name"]="saver $ms"
}

# Every function the app interface defines, recorded before the app's own
# file is read: the desktop telling this process to run one of them is
# refused, since only the app's own functions are its to call here.
declare -gA DT_RTIFACE
dt_rtifacerec() {
	local l x

	x := declare -F
	while read -r l; do
		DT_RTIFACE["${l##* }"]=1
	done <<< "$x"
	return 0
}
dt_rtifacerec
# The desktop's state this process is sent is a copy, never this process's
# to write: the variable table refuses any write to it but the runtime's own
# applying of what arrived (ADR 0050, varwatch). Without the module nothing
# can be shared, so no app runs.
need varwatch || { dt_log "app runtime: no varwatch module"; exit 1; }
varwatch guard on
# Whether a batch of what the desktop sent has set anything, so what it
# derives (dt_derive) is rebuilt once after the batch.
DT_RTDERIVE=
# How many lines the desktop has sent this process, for a check that an idle
# desktop sends none.
DT_RTRECV=0

# The connection to the desktop, and what it said to the hello.
DT_RTFD=
DT_RTSAID=
# The one-time token the hello's ok gave for this process's cells channel,
# and that channel once open.
DT_RTCTOK=
DT_RTCFD=
# The apps this process's file registers (its dt_app lines), one prefix
# each: a window's calls resolve from its own app, never from the process.
DT_RTPFX=()
# The views the desktop has bound, by name: a window's (w$ID) "win ID DH DW
# OR OC", a pane's (p$ID) "pane ID PANE OR OC", a strip module's (s$NAME)
# "strip NAME HV", a saver's (v) "saver NAME"; those to draw whole at the
# next pass (new, resized, called or asked again); when a saver's next frame
# is due; and whether there has been one, so the last one forgotten ends the
# process.
declare -gA DT_RTV DT_RTVNEW DT_RTVDUE DT_RTVH DT_RTVW DT_RTONCE
DT_RTHADV=
# The calls the desktop has revoked (`revoke SEQ`: a key it took as
# declined when no answer came in time, ADR 0050), noted as their lines
# arrive -- before any call is run -- so one still waiting is dropped, never
# run; and those dropped, so the revoke's own line, reached in turn, says
# nothing more of them.
declare -gA DT_RTREVOKED DT_RTDROPPED
# The window a note an app's callback raises is about, and why a call said
# no, as the desktop keeps them around a callback.
DT_NOTEWIN=
DT_WHY=
# The maps each app of this process keeps a window's state in (its
# dt_keepstate line), by app; and this process's channel to the desktop for
# its terminals' programs, which the desktop owns (mods/pty, ADR 0050).
declare -gA DT_RTKEEP
DT_RTPTYFD=
# The token of this process's launch, from its environment or, forked from
# the zygote, from the request that made it; and the descriptors the
# zygote's last message carried (zygote recv).
DT_RTTOKEN=${DT_RTTOKEN-}
ZG_FDS=
# The app a fresh process forked from the zygote runs, and its file.
DT_RTZAPP=
DT_RTZFILE=
# Set once this process has kept a window's state for a fresh one (a
# Restart Desktop): it holds still until its socket ends (dt_rtfreeze).
DT_RTFROZEN=
# When the zygote forked this process, in microseconds, so how long it took
# to be ready is said once (the app read, and a window taken up).
DT_RTFORKT=

# Open the connection and say hello: the protocol, the hibr version and
# the app's name. A desktop that refuses says why, which is kept in
# DT_RTSAID and is status 1; so is no desktop answering within two seconds.
fn dt_rtopen(app) {
	local l w t=${DT_RTTOKEN-}

	[ -n "${DT_RTSOCK-}" ] || { DT_RTSAID="no desktop socket was given"; return 1; }
	# connect, not a /dev/unix redirection: its descriptor is close-on-exec,
	# so a program this app starts never holds the app's end and keeps it
	# looking alive to the desktop once the app has gone; and its quieting
	# lasts the one command, where `exec {fd}<> ... 2> /dev/null` threw away
	# this process's standard error for good.
	if ! connect -U "$DT_RTSOCK" DT_RTFD 2> /dev/null; then
		DT_RTFD=
		DT_RTSAID="cannot reach the desktop at $DT_RTSOCK"
		return 1
	fi
	# The launch's token, which says whose this process is, is spent by
	# the hello, and nothing this app starts is handed it.
	unset DT_RTTOKEN
	l := dt_rtline hello "$DT_RTPROTO" "$HIBR_VERSION" "$app" "$t"
	send "$DT_RTFD" "$l" 2> /dev/null ||
		{ DT_RTSAID="the desktop went before the hello"; return 1; }
	# The answer: what the desktop sends this process first -- its
	# settings and the rest of what is mirrored -- then ok, or refused and
	# why. Read through the line reader both ends use, waiting on the
	# socket for at most two seconds in all, never a byte at a time.
	console watch "$DT_RTFD" || { DT_RTSAID="no console to wait with"; return 1; }
	local end=$((${EPOCHREALTIME/./} / 1000 + 2000)) now st
	local -a got
	while :; do
		dt_rtlines "$DT_RTFD"
		st=$?
		got=("${DT_RTGOT[@]}")
		for l in "${got[@]}"; do
			read -ra w <<< "$l"
			case ${w[0]-} in
			ok)
				console unwatch "$DT_RTFD"
				DT_RTCTOK=${w[2]-}
				dt_rtderived
				# The language put into effect here once, as the
				# desktop's is at its start; after this dt_derive
				# follows it when it moves.
				dt_langapply
				return 0
				;;
			refused)
				console unwatch "$DT_RTFD"
				DT_RTREFUSED=1
				DT_RTSAID := dt_rtdec "${w[1]-}"
				return 1
				;;
			*) dt_rtcalled "$l" ;;
			esac
		done
		[ -n "${DT_RTMORE["$DT_RTFD"]+x}" ] && continue
		now=$((${EPOCHREALTIME/./} / 1000))
		if [ "$st" = 1 ] || [ "$now" -ge "$end" ]; then
			console unwatch "$DT_RTFD"
			DT_RTSAID="the desktop did not answer the hello"
			return 1
		fi
		console key $((end - now)) > /dev/null
	done
}

# What the desktop's state arriving derives, rebuilt once after a batch.
dt_rtderived() {
	[ -n "$DT_RTDERIVE" ] || return 0
	DT_RTDERIVE=
	dt_derive
}

# One message to the desktop: tell, ask or declare, the function, and its
# words. A told request is sent and never waited for, an asked one waited
# for (dt_rtask); of what is declared only dt_app is taken, as this
# process's prefixes, and the rest says it is not carried yet.
fn dt_rtsend(verb, name, ...args) {
	local l

	# An app's registration is read by the desktop from its file (ADR
	# 0050: read, not run); here it says which prefixes this process answers
	# for, as its file is read, before there is any connection.
	if [ "$verb" = declare ] && [ "$name" = dt_app ]; then
		DT_RTPFX+=("${args[0]-}")
		return 0
	fi
	# The Edit menu is the desktop's, like Window: where an app's _menus
	# asks for it, a menu marked edit holds its place, and the desktop
	# builds its own Edit there (wm/rtview.hibr), once a bar as ever.
	if [ "$verb" = declare ] && [ "$name" = dt_editmenu ]; then
		[ "$MB_EDITED" = 1 ] && return 0
		MB_EDITED=1
		dt_menu "Edit"
		MB[$((MB_N - 1))]["edit"]=1
		return 0
	fi
	if [ "$verb" = declare ] && [ "$name" = cs_module ]; then
		DT_RTKP["${args[0]-}"]=strip
		return 0
	fi
	# A bar item may draw itself or open a pop-up, each drawn here in a view
	# the desktop binds: so this process opens a cells channel.
	case $name in dt_baridraw | dt_baritem) DT_RTBARD=1 ;; esac
	# An item it has put on the bar keeps this process for the session, as
	# declared background work does (ADR 0050): its windows going is not
	# its end.
	[ "$name" = dt_baritem ] && [ -n "${args[1]-}" ] && DT_RTBARS=1
	# A bar hook runs here, each pass, where the item's own state is
	# (dt_rtrun); the desktop runs it no more (wm/rtkinds.hibr).
	if [ "$verb" = declare ] && [ "$name" = dt_barhook ]; then
		[[ " ${DT_RTHOOKS[*]-} " == *" ${args[0]-} "* ]] || DT_RTHOOKS+=("${args[0]-}")
		DT_RTBARS=1
		return 0
	fi
	# A pop-up's own functions, said before the desktop opens it, so it
	# calls and draws them here.
	[ "$name" = dt_baripop ] && dt_rtpophas "${args[1]-}"
	# The maps an app keeps a window's state in are this process's own, so
	# a window carried to a fresh process (dt_rtstash) takes them with it.
	if [ "$verb" = declare ] && [ "$name" = dt_keepstate ]; then
		DT_RTKEEP["${args[0]-}"]="${args[*]:1}"
		return 0
	fi
	[ -n "$DT_RTFD" ] || { dt_log "app runtime: $name with no desktop connected"; return 1; }
	case $verb in
	tell)
		# A window playing video is the desktop's to know, which holds
		# its frames to DT_LIVEMS, and this process's too, which holds its
		# draws the same way (dt_rtdraw): kept here as well as told.
		if [ "$name" = dt_live ]; then
			if [ -n "${args[1]-}" ]; then
				DT_LIVE["${args[0]-}"]=1
			else
				unset DT_LIVE["${args[0]-}"]
			fi
		fi
		# A list of choices goes up built, with the words its namer gives
		# each value, just before the request that opens it.
		[ "$name" != dt_context_open ] || [ "${args[0]-}" != widget ] || dt_rtpoplist "${args[1]-}"
		;;
	ask)
		dt_rtask "$name" "${args[@]}" && ret -k
		return
		;;
	*)
		dt_log "app runtime: $name is $verb, which is not carried yet (ADR 0050)"
		return 1
		;;
	esac
	l := dt_rtline "$verb" "$name" "${args[@]}"
	# What its file says as it is read -- a bar item it puts there, a hook
	# -- is said again to a restarted desktop it is kept for (dt_rtrejoin):
	# what it registers. A note or a notification is an event, said once.
	case $name in
	dt_note* | dt_notify*) ;;
	*) [ -z "${DT_LOADING-}" ] || DT_RTLOADL+=("$l") ;;
	esac
	# A plain send: the desktop never blocks reading, so this never waits
	# on it, and a full buffer is the right brake on an app that floods.
	# A desktop that has gone is a status, never a signal.
	send "$DT_RTFD" "$l" 2> /dev/null ||
		{ dt_log "app runtime: the desktop has gone"; return 1; }
	return 0
}
DT_RTLOADL=()

# An asked request: `ask SEQ NAME WORDS...`, and this process waits for its
# answer (owner, 2026-11-19: DT_RTASKMS, 2000 ms). Only the desktop's
# socket wakes the wait -- what the app itself watches is set aside for it
# -- and while it waits, what the desktop shares is applied as it arrives
# and anything it tells is queued (DT_RTQ), never run inside the caller's
# own call. The answer's value is handed back as ret, a map when it is one;
# the status is the request's, 125 when no answer came in time (it is not
# sent again: a second dt_new is a second window), 126 when the desktop
# refused, 1 when the desktop has gone. The wait is the desktop's, never
# this app's: it is logged as `asked:`, not charged as a stall.
DT_RTASKN=0
DT_RTASKMS="${DT_RTASKMS-2000}"
DT_RTQ=()
fn dt_rtask(name, ...args) {
	local l x seq st=125 got= kind val end now t0 i
	local -a w watched keep

	[ -n "$DT_RTFD" ] || { dt_log "app runtime: $name asked with no desktop connected"; return 1; }
	DT_RTASKN=$((DT_RTASKN + 1))
	seq=$DT_RTASKN
	t0=${EPOCHREALTIME/./}
	end=$((t0 / 1000 + DT_RTASKMS))
	l := dt_rtline ask "$seq" "$end" "$name" "${args[@]}"
	send "$DT_RTFD" "$l" 2> /dev/null || { dt_log "app runtime: the desktop has gone"; return 1; }
	# What waited from before applies first, in order: shared lines now,
	# tells kept for after.
	for l in "${DT_RTQ[@]}"; do
		case $l in
		json\ * | jsonk\ * | unsetk\ *) dt_rtcalled "$l" ;;
		*) keep+=("$l") ;;
		esac
	done
	DT_RTQ=("${keep[@]}")
	x := console watching
	read -ra watched <<< "$x"
	for x in "${watched[@]}"; do
		x=${x%%:*}
		[ "$x" = "$DT_RTFD" ] || console unwatch "$x"
	done
	console watch "$DT_RTFD"
	while [ -z "$got" ]; do
		dt_rtlines "$DT_RTFD"
		i=$?
		for l in "${DT_RTGOT[@]}"; do
			[[ $l == "revoke "* ]] && DT_RTREVOKED["${l#revoke }"]=1
			if [ -n "$got" ]; then
				DT_RTQ+=("$l")
				continue
			fi
			read -ra w <<< "$l"
			case ${w[0]-} in
			answer)
				if [ "${w[1]-}" != "$seq" ]; then
					dt_log "app runtime: an answer to ask ${w[1]-?} came after its time; dropped"
					continue
				fi
				got=1
				st=${w[2]-1}
				kind=${w[3]--}
				val := dt_rtdec "${w[4]-%}"
				;;
			json | jsonk | unsetk) dt_rtcalled "$l" ;;
			*) DT_RTQ+=("$l") ;;
			esac
		done
		[ -n "$got" ] && break
		[ -n "${DT_RTMORE["$DT_RTFD"]+x}" ] && continue
		if [ "$i" = 1 ]; then
			st=1
			break
		fi
		now=$((${EPOCHREALTIME/./} / 1000))
		[ "$now" -lt "$end" ] || break
		console key $((end - now)) > /dev/null
	done
	for x in "${watched[@]}"; do
		x=${x%%:*}
		[ "$x" = "$DT_RTFD" ] || console watch "$x"
	done
	dt_rtderived
	x=$(((${EPOCHREALTIME/./} - t0) / 1000))
	[ "$x" -lt "${DT_SLOWMS:-50}" ] || dt_log "asked: $name waited $x ms for the desktop"
	[ -n "$got" ] || { [ "$st" = 1 ] || dt_log "app runtime: $name asked and not answered in $DT_RTASKMS ms"; return "$st"; }
	case $kind in
	j)
		json parse RET <<< "$val"
		[ "$st" = 0 ] && ret -k
		;;
	s) [ "$st" = 0 ] && ret "$val" ;;
	esac
	return "$st"
}

# What the desktop said: shared state (json, jsonk, unsetk), a call into
# this app (call), the views it draws in (view, again, forget) and a
# revoked call. Anything else is not carried yet, and says so.
fn dt_rtcalled(line) {
	local -a w a
	local x name

	read -ra w <<< "$line"
	DT_RTRECV=$((DT_RTRECV + 1))
	case ${w[0]-} in
	json | jsonk | unsetk)
		dt_rtmirrored "${w[@]}"
		return 0
		;;
	answer)
		dt_log "app runtime: an answer to ask ${w[1]-?} came after its time; dropped"
		return 0
		;;
	call | view | again | forget | revoke) ;;
	*)
		dt_log "app runtime: the desktop said ${w[0]:-nothing}, which is not carried yet (ADR 0050)"
		return 0
		;;
	esac
	for x in "${w[@]:1}"; do
		x := dt_rtdec "$x"
		a+=("$x")
	done
	case ${w[0]} in
	call) dt_rtcall "${a[@]}" ;;
	view)
		dt_rtopenwait "${a[@]}"
		dt_rtview "${a[@]}"
		;;
	again)
		name=${a[0]-}
		[ -n "${DT_RTV["$name"]+x}" ] || return 0
		console cells again "$name"
		DT_RTVNEW["$name"]=1
		;;
	forget)
		name=${a[0]-}
		[ -n "${DT_RTV["$name"]+x}" ] || return 0
		console cells forget "$name"
		unset DT_RTV["$name"] DT_RTVNEW["$name"] DT_RTVDUE["$name"] DT_RTVH["$name"] DT_RTVW["$name"] DT_RTWAITOPEN["$name"] DT_RTINAT["$name"]
		[ "${DT_RTFTOLD%%:*}" != "${name#w}" ] || DT_RTFTOLD=
		;;
	revoke)
		if [ -n "${DT_RTDROPPED["${a[0]-}"]+x}" ]; then
			unset DT_RTDROPPED["${a[0]}"]
		else
			dt_log "app runtime: the desktop revoked call ${a[0]-?}, which had run (ADR 0050, a declined key)"
		fi
		unset DT_RTREVOKED["${a[0]-}"]
		;;
	esac
	return 0
}

# `call SEQ TARGET NAME WORDS...`: TARGET a window this process draws and
# NAME the kind of its callback (key, click, open, close...), resolved from
# the window's own app; or TARGET -, NAME a function of this process's own.
# Never one the app interface defines, never by eval, and timed as the
# desktop times a callback (dt_appcall). An ask (SEQ above 0) is answered
# `took SEQ STATUS KIND VALUE WHY`, 126 when refused.
fn dt_rtcall(seq, target, name, ...args) {
	local fn= st=126 v= why= k t0 rows=

	# Revoked before it ran: dropped, and answered 125, not run -- an answer
	# all the same, so the desktop sees this process answering again.
	if [ "$seq" != 0 ] && [ -n "${DT_RTREVOKED["$seq"]+x}" ]; then
		unset DT_RTREVOKED["$seq"]
		DT_RTDROPPED["$seq"]=1
		dt_log "app runtime: the desktop revoked call $seq ($name of window $target) before it ran; dropped"
		k := dt_rtline took "$seq" 125 - "" ""
		send "$DT_RTFD" "$k" 2> /dev/null || dt_log "app runtime: the desktop has gone"
		return 0
	fi
	if [ "$target" = - ] && [ "$name" = carry ]; then
		# Restart Desktop keeps this process (ADR 0050): its code is what
		# is on disk, so it stays, and joins the restarted desktop with the
		# launch this names once its connection ends (dt_rtrejoin). Named
		# nothing, the restart did not happen, and nothing is kept.
		DT_RTCARRY=${args[0]-}
		if [ "$seq" != 0 ]; then
			k := dt_rtline took "$seq" 0 - "" ""
			send "$DT_RTFD" "$k" 2> /dev/null || dt_log "app runtime: the desktop has gone"
		fi
		if [ -n "$DT_RTCARRY" ]; then
			dt_log "app runtime: kept across the desktop's restart"
		else
			dt_log "app runtime: the desktop's restart did not happen; not kept"
		fi
		return 0
	fi
	if [ "$target" = - ]; then
		fn=$name
		# A rows pane's input, worked by the panel's own rows here
		# (widgets/rows.hibr), for the callbacks the pane does not define.
		if ! dt_has "$fn" && [[ $fn == *_* ]] && dt_rtrows "${fn%_*}"; then
			case ${name##*_} in
			key | click) fn=cp_rows${name##*_}; args=("${args[0]-}" "${name%_*}" "${args[@]:1}"); rows=1 ;;
			mouse | wheel) fn=cp_rows${name##*_}; rows=1 ;;
			search | hover) fn=dt_rtrows${name##*_}; rows=1 ;;
			esac
		fi
	elif [[ $target =~ ^[0-9]+$ ]] && [ -n "${DT_RTV["w$target"]+x}" ] &&
		{ [ "$name" = stash ] || [ "$name" = resume ]; }; then
		# A window carried to a fresh process: the runtime's own, around
		# the app's _stash and _resume.
		fn=dt_rt$name
	elif [[ $target =~ ^[0-9]+$ ]] && [ -n "${DT_RTV["w$target"]+x}" ]; then
		# Its menus or its context menu: built here and pushed when
		# different from the last, never answered as a call. An edit is
		# done whole here, as the desktop does one for its own window: the
		# field first, then the window's own callback.
		case $name in
		menus | context)
			dt_rtbuild "$name" "$target"
			[ "$seq" = 0 ] || dt_log "app runtime: the desktop asked for $name, which is pushed; not answered"
			return 0
			;;
		copy | cut | paste | undo | redo | selall | find)
			dt_rtedit "$seq" "$target" "$name" "${args[@]}"
			return 0
			;;
		esac
		fn=${DT[$target]["app"]-}_$name
	else
		dt_log "app runtime: the desktop called $name of window $target, which this process does not draw; refused"
	fi
	if [ -n "$fn" ] && [ -z "$rows" ] && [[ $fn != dt_rt@(stash|resume) ]] &&
		{ [ -n "${DT_RTIFACE["$fn"]+x}" ] || ! dt_has "$fn"; }; then
		dt_log "app runtime: the desktop told $fn, which is not this app's own; refused"
		fn=
	fi
	if [ -n "$fn" ]; then
		RET=
		DT_WHY=
		if [ "$target" = - ]; then
			t0=${EPOCHREALTIME/./}
			"$fn" "${args[@]}"
			st=$?
			dt_spent "$fn" "$((${EPOCHREALTIME/./} - t0))" "${DT_RTPFX[0]-}"
		elif [[ $fn == dt_rt@(stash|resume) ]]; then
			"$fn" "$target" "${args[@]}"
			st=$?
			DT_RTVNEW["w$target"]=1
			# Taken up in place of its _open, which is never told for it.
			[ "$name" != resume ] || unset DT_RTWAITOPEN["w$target"]
		else
			dt_appcall "$target" "$fn" "${args[@]}"
			st=$?
			DT_RTVNEW["w$target"]=1
			case $name in
			key | click | mouse | wheel | drop) DT_RTINAT["w$target"]=${EPOCHREALTIME/./} ;;
			esac
			[ "$name" != open ] || unset DT_RTWAITOPEN["w$target"]
		fi
		v=$RET
		why=${DT_WHY-}
	fi
	[ "$seq" = 0 ] && return 0
	if [ -n "$v" ]; then
		k := dt_rtline took "$seq" "$st" s "$v" "$why"
	else
		k := dt_rtline took "$seq" "$st" - "" "$why"
	fi
	send "$DT_RTFD" "$k" 2> /dev/null || dt_log "app runtime: the desktop has gone"
	return 0
}

# MB and MI emptied for a build of this process's own.
dt_rtmbreset() {
	MB=()
	MI=()
	MB_N=0
	MB_CUR=
	MB_STACK=
	MB_EDITED=0
	DT_KEYCOLLECT=
}

# What _menus or _context of window id's app builds, with the builders the
# desktop has (wm/menubuild.hibr), pushed as `menus APP JSON` or `context APP
# JSON` when it differs from the last this process pushed: the window it was
# built for, the menus and their rows, and whether Edit has its place. The
# desktop builds the same rows again from it and uses the last it has; the
# build is timed as the desktop times a callback.
declare -gA DT_RTMSENT
fn dt_rtbuild(kind, int id) {
	local ap=${DT[$id]["app"]-} t0

	[ -n "$ap" ] || return 0
	# An app with no _menus still says whether its window's field is live,
	# with no menus beside it: the desktop's own File and Edit stand.
	if ! dt_has "${ap}_$kind"; then
		[ "$kind" = menus ] || return 0
		dt_rtmbreset
		dt_rtmbpush menus "$ap" "$id"
		return 0
	fi
	dt_rtmbreset
	t0=${EPOCHREALTIME/./}
	if [ "$kind" = menus ]; then
		dt_appfn "$ap" "${ap}_menus"
	else
		dt_appfn "$ap" "${ap}_context" "$id"
	fi
	dt_spent "$kind:$ap" "$((${EPOCHREALTIME/./} - t0))" "$ap"
	dt_rtmbpush "$kind" "$ap" "$id"
}

# Whether the focused window id's field is live, and has typing to take
# back or put again, as this process knows it now: three digits, 000 for
# any window but the focused one, which only this process can answer.
fn dt_rtfieldbits(id) {
	local f=0 u=0 r=0

	if [ "$DT_FOCUS" = "$id" ] && dt_fieldlive; then
		f=1
		dt_fieldcan undo && u=1
		dt_fieldcan redo && r=1
	fi
	ret "$f$u$r"
}

# After a draw of the focused window: its menus told again when its
# field's facts differ from the last told (DT_RTFTOLD, "ID:BITS"), since
# the desktop's Edit menu and Select All ask them (wm/rtcarry.hibr). Only
# the focused window's, as the desktop keeps one menus for an app: one
# told for a window that has lost the focus would take its app's menus
# away from the window that has it.
DT_RTFTOLD=
fn dt_rtfieldtell(int id) {
	local b

	[ "$DT_FOCUS" = "$id" ] || return 0
	b := dt_rtfieldbits "$id"
	[ "$DT_RTFTOLD" != "$id:$b" ] || return 0
	dt_rtbuild menus "$id"
}

# A list of choices this process is opening (dt_dropat, then dt_context_open
# widget): its rows built here, the namer giving each value its words where
# the app is, and pushed as `context APP JSON` marked list, with the row it
# starts on. Pushed every time, since opening a list is an event of its own.
fn dt_rtpoplist(id = "") {
	local ap=${DT[$id]["app"]-}

	[ -n "$ap" ] || ap=${DT_RTPFX[0]-}
	dt_rtmbreset
	dt_dropcontext
	dt_rtmbpush context "$ap" "$id" "$DT_POPSELONCE"
	DT_POPSELONCE=
}

# Send what MB and MI hold now, as kind of app for window id: a list's
# (sel set, even empty) always, the rest only when it differs.
fn dt_rtmbpush(kind, ap, id = "", ...sel) {
	local mb mi v j l

	mb := json emit MB
	mi := json emit MI
	v=$id
	j='{"id":'
	v := json emit v
	j+="$v,\"n\":$MB_N,\"edited\":$MB_EDITED"
	if [ "$kind" = menus ] && [ "${#sel[@]}" = 0 ]; then
		v := dt_rtfieldbits "$id"
		DT_RTFTOLD="$id:$v"
		j+=",\"field\":${v:0:1},\"fundo\":${v:1:1},\"fredo\":${v:2:1}"
	fi
	if [ "${#sel[@]}" -gt 0 ]; then
		v=${sel[0]}
		v := json emit v
		j+=",\"list\":1,\"sel\":$v"
	elif [ "${DT_RTMSENT["$kind:$ap"]-}" = "$j,$mb,$mi" ]; then
		return 0
	else
		DT_RTMSENT["$kind:$ap"]="$j,$mb,$mi"
	fi
	j+=",\"mb\":$mb,\"mi\":$mi}"
	l := dt_rtline "$kind" "$ap" "$j"
	send "$DT_RTFD" "$l" 2> /dev/null || dt_log "app runtime: the desktop has gone"
	return 0
}

# An edit the desktop asked of window id (`call SEQ ID OP`, a paste with
# the clipboard and how it was taken, Select All from its key with the
# key): done here whole (dt_editwin), and answered with what it took for
# the clipboard and the note to give, which the desktop says, since the
# clipboard is the desktop's (wm/rtcarry.hibr). An answer longer than
# DT_RTEDITMAX is refused with a note instead, and a cut is measured before
# it is made, so the connection stays and nothing is lost.
fn dt_rtedit(int seq, int id, op, clip = "", clipop = "") {
	local k v n=

	# A cut is measured by the same copy before it is made: one too long
	# to answer is not made, so it stays where it was.
	if [ "$op" = cut ] && [ "$seq" != 0 ]; then
		dt_editwin "$id" copy
		k := dt_rteditline "$seq"
		[ "${#k}" -le "$DT_RTEDITMAX" ] || n=${#DT_EDITR["clip"]}
	fi
	if [ -z "$n" ]; then
		dt_editwin "$id" "$op" "$clip" "$clipop"
		DT_RTVNEW["w$id"]=1
		DT_RTINAT["w$id"]=${EPOCHREALTIME/./}
		# The Select All key, sent as an edit with the key beside it: with
		# no field and no _selall, it is the window's own key, as the
		# desktop gives it to a window of its own.
		if [ "$op" = selall ] && [ -n "$clip" ] && [ "${DT_EDITR["say"]-}" = cannot ]; then
			DT_EDITR=()
			k=${DT[$id]["app"]-}_key
			[ -z "${DT_RTIFACE["$k"]+x}" ] && dt_has "$k" && dt_appcall "$id" "$k" "$clip"
		fi
		[ "$seq" = 0 ] && return 0
		k := dt_rteditline "$seq"
		if [ "${#k}" -gt "$DT_RTEDITMAX" ]; then
			n=${#DT_EDITR["clip"]}
			dt_rteditback "$id" "$op" "${DT_EDITR["clip"]}"
		fi
	fi
	if [ -n "$n" ]; then
		dt_log "app runtime: window $id's $op of $n characters is longer than one answer can carry ($DT_RTEDITMAX); refused, nothing taken"
		DT_EDITR=()
		DT_EDITR["say"]=toolong
		DT_EDITR["n"]=$n
		k := dt_rteditline "$seq"
	fi
	send "$DT_RTFD" "$k" 2> /dev/null || dt_log "app runtime: the desktop has gone"
	return 0
}

# The answer to edit seq: what DT_EDITR holds, as JSON on a took line.
fn dt_rteditline(int seq) {
	local v k

	v := json emit DT_EDITR
	k := dt_rtline took "$seq" 0 j "$v" ""
	ret "$k"
}

# A cut too long to answer from a window whose app has no _copy to measure
# it by first: put back by pasting it, as a cut, through the same edit, so
# nothing is lost.
fn dt_rteditback(int id, op, clip) {
	[ "$op" = cut ] || return 0
	dt_editwin "$id" paste "$clip" cut
	[ "${DT_EDITR["say"]-}" = cannot ] || return 0
	dt_log "app runtime: window $id's cut of ${#clip} characters could not be put back: its app has no _copy to measure a cut by and no _paste to undo one"
	return 0
}

# Every window this process draws whose app has an _idle, every pass and
# drawn or not, as the desktop drains its own windows (dt_drain): a
# descriptor the app watches is read whether or not its window is drawn --
# a clean _dirty skips the draw -- so this process never spins on one left
# ready. Here and never across the wire: the descriptor is this process's.
# Timed as the desktop times a window's _idle (dt_idlecall).
dt_rtidle() {
	local v kind id ap t0 t

	for v in "${!DT_RTV[@]}"; do
		read -r kind id _ <<< "${DT_RTV["$v"]}"
		[ "$kind" = win ] || continue
		ap=${DT[$id]["app"]-}
		[ -n "$ap" ] && dt_has "${ap}_idle" || continue
		[ -z "${DT_RTWAITOPEN["$v"]+x}" ] || continue
		DT_NOTEWIN=$id
		slowest on "${DT_SLOWMS:-50}"
		DT_WHO="idle:$ap"
		t0=${EPOCHREALTIME/./}
		dt_appfn "$ap" "${ap}_idle" "$id"
		t=$((${EPOCHREALTIME/./} - t0))
		DT_WHO=
		[ "$t" -lt 1000 ] || dt_spent "idle:$ap" "$t" "$ap"
		DT_NOTEWIN=
	done
	return 0
}

# A window's view whose _open has not yet run here: neither drawn nor its
# _idle called until it has, since the desktop runs a window's _open before
# anything else of it and an app counts on that. The view arrives first and
# the open is told after it, and the two may come in two reads.
declare -gA DT_RTWAITOPEN
fn dt_rtopenwait(name, gen, h, w, kind = "", ...args) {
	[ "$kind" = win ] && [ -z "${DT_RTV["$name"]+x}" ] && [[ ${args[0]-} =~ ^[0-9]+$ ]] || return 0
	[ -n "${DT[${args[0]}]["open"]-}" ] || return 0
	DT_RTWAITOPEN["$name"]=1
}

# The tickers the app interface registers in every process, kept before
# the app's file is read: a ticker beyond these is the app's own.
declare -gA DT_RTBASETICK

# Whether this process has work of its own that goes on with no window: a
# job not yet done, or a ticker its app registered. A job's files are in
# this process's jobs folder until its callback has run; for a ticker the
# folder is given a mark of its own (DT_RTMARK) while the process stays for
# it. The desktop reads the folder (wm/rtcarry.hibr), so neither end ends
# this process while it works, and nothing crosses the wire for it.
DT_RTMARK=
dt_rtworking() {
	local f

	[ "${DTJ_LIVE:-0}" = 0 ] || return 0
	for f in "${DT_TICKERS[@]}"; do
		[ -n "${DT_RTBASETICK["$f"]+x}" ] && continue
		if [ -z "$DT_RTMARK" ] && dt_jobdir; then
			DT_RTMARK="$DTJ_DIR/ticker"
			: > "$DT_RTMARK"
		fi
		return 0
	done
	return 1
}

# `view NAME GEN H W KIND ARGS...`: a place the desktop gave this process to
# draw in. A window's (KIND win, ARGS ID DH DW OR OC) is drawn by its own
# app's _draw with ID, DH, DW and its row and column, at pane origin OR OC.
# A bar item's (bar, ARGS NAME FN C HV, NAME b$NAME) by its own drawing
# function FN into the bar's pane, which here is the view's, at column C.
# A Control Panel pane's (pane, ARGS ID PANE OR OC, NAME p$ID) is drawn by
# the pane's _draw into the panel's window, w$ID, which here is the view's
# own pane: the body H by W from OR OC of it. A strip module's (strip, ARGS
# NAME HV, NAME s$NAME) and a saver's (saver, ARGS NAME, NAME v) draw at
# screen coordinates, which here are the view's own rows of this process's
# screen; a saver's from the top, so its view must be the first.
fn dt_rtview(name, gen, h, w, kind = "", ...args) {
	local pn= ok= p=${args[1]-}

	case $kind:${#args[@]} in
	win:5) [ "$name" = "w${args[0]}" ] && ok=1 ;;
	pane:6) [ "$name" = "p${args[0]}" ] && [ "${DT_RTKP["$p"]-}" = pane ] && ok=1 && pn="w${args[0]}" ;;
	strip:2) [ "$name" = "s${args[0]}" ] && [ "${DT_RTKP["${args[0]}"]-}" = strip ] && ok=1 ;;
	saver:1) [ "$name" = v ] && [[ ${DT_RTKP["${args[0]}"]-} == saver\ * ]] && ok=1 ;;
	pop:2)
		[ "$name" = "o${args[0]}" ] && [ -z "${DT_RTIFACE["$p"]+x}" ] && dt_has "$p" && ok=1
		;;
	bar:4)
		[ "$name" = "b${args[0]}" ] && [ -z "${DT_RTIFACE["$p"]+x}" ] && dt_has "$p" && ok=1 && pn=bar
		;;
	esac
	if [ -z "$ok" ]; then
		dt_log "app runtime: the desktop bound $name as ${kind:-nothing} ${args[*]}, which this process does not draw; refused"
		return 0
	fi
	if [ -z "$DT_RTCFD" ] || ! console cells view "$name" "$gen" "$h" "$w" ${pn:+"$pn"}; then
		dt_log "app runtime: cannot draw $name: no cells channel"
		return 0
	fi
	DT_RTV["$name"]="$kind ${args[*]}"
	DT_RTVH["$name"]=$h
	DT_RTVW["$name"]=$w
	DT_RTVNEW["$name"]=1
	unset DT_RTVDUE["$name"]
	DT_RTHADV=1
	return 0
}

# Draw every view due, then send what changed in one flush: a window whose
# app says it is clean (_dirty) is left unless it is new, called or asked
# again. Cleared to none first, so a shorter string leaves nothing stale;
# drawn in the pen the desktop leaves before a window's _draw, and timed as
# the desktop times a window's draw. A pane, a strip module and a saver are
# drawn as the desktop draws them (dt_rtkind).
dt_rtdraw() {
	local v kind id dh dw or oc ap drew= t0 t now held= dirty= ia hm hold=

	now=${EPOCHREALTIME/./}
	for v in "${!DT_RTV[@]}"; do
		read -r kind id dh dw or oc <<< "${DT_RTV["$v"]}"
		if [ "$kind" != win ]; then
			dt_rtkind "$v" && drew=1
			continue
		fi
		ap=${DT[$id]["app"]-}
		[ -n "$ap" ] && dt_has "${ap}_draw" || continue
		[ -z "${DT_RTWAITOPEN["$v"]+x}" ] || continue
		if [ -z "${DT_RTVNEW["$v"]+x}" ] && dt_has "${ap}_dirty" && ! "${ap}_dirty" "$id"; then
			continue
		fi
		# Dirty only by what it watches -- a terminal's program writing --
		# and drawn less than DT_TERMMS ago: held, as the desktop holds a
		# frame its terminals' output asks for. What the desktop told it
		# (a key, a click, a view bound) is never held, and neither is the
		# answer to it: a window's output within DT_ANSWERMS of the input
		# it was given (a terminal's echo), as the desktop draws the
		# focused window's at once (dt_answer). A window playing video
		# (dt_live) is held to DT_LIVEMS instead, as the desktop holds
		# its frames (dt_holdms); 0 holds it like any other output.
		if [ -z "${DT_RTVNEW["$v"]+x}" ]; then
			ia=${DT_RTINAT["$v"]:-0}
			hm=${DT_TERMMS:-70}
			[ -z "${DT_LIVE[$id]-}" ] || [ "${DT_LIVEMS:-0}" -le 0 ] || [ "$DT_LIVEMS" -ge "$hm" ] || hm=$DT_LIVEMS
			if [ $((now - DT_RTDRAWN)) -lt $((hm * 1000)) ] &&
			   [ $((now - ia)) -ge $((${DT_ANSWERMS:-300} * 1000)) ]; then
				held=1
				[ -n "$hold" ] && [ "$hold" -le "$hm" ] || hold=$hm
				continue
			fi
			dirty=1
		fi
		unset DT_RTVNEW["$v"]
		console cells clear "$v"
		console pen "$DT_INK" "$DT_FACE"
		DT_NOTEWIN=$id
		dt_wclear "$id"
		# Its field is live again only if this draw draws it focused, as
		# the desktop's dt_win has it.
		dt_fieldstale "$id"
		[ "$or$oc" = 00 ] || console pane origin "$v" "$or" "$oc"
		DT_WHO="win:$ap"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		"${ap}_draw" "$id" "$dh" "$dw" "${DT[$id]["row"]-0}" "${DT[$id]["col"]-0}"
		t=$((${EPOCHREALTIME/./} - t0))
		DT_WHO=
		[ "$t" -lt 1000 ] || dt_spent "win:$ap" "$t" "$ap"
		[ "$or$oc" = 00 ] || console pane origin "$v" 0 0
		DT_NOTEWIN=
		drew=1
		dt_rtfieldtell "$id"
	done
	[ -z "$drew" ] || console flush > /dev/null
	[ -z "$dirty" ] || DT_RTDRAWN=$now
	# The rest of a held frame is waited out quietly: what the app watches
	# keeps in its own buffer meanwhile, and the desktop's socket, input,
	# still ends the wait at once.
	if [ -n "$held" ]; then
		DT_RTQUIET=1
		dt_want $(((DT_RTDRAWN + hold * 1000 - now) / 1000 + 1))
	fi
	return 0
}
# When a view dirty only by what it watches was last drawn, in microseconds;
# and whether the next wait is a held frame's, quiet to what it watches.
DT_RTDRAWN=0
DT_RTQUIET=
# When each window this process draws was last given input, in
# microseconds: its output is not held for DT_ANSWERMS after.
declare -gA DT_RTINAT

# Draw one view of another kind than a window, as the desktop draws it in
# its own process, timed the same way; status 1 when nothing was due. A
# pane and a strip module have no _dirty, so they are drawn every pass, as
# the desktop draws them every frame, and the flush sends only what
# changed. A pane is drawn into the panel's window through its view, at the
# body's origin, with the body's size and left column; a strip module at
# its view's own row of this process's screen, in the pen the strip leaves
# before it (lit while the pointer is over it); a saver begins on a new or
# asked-again view and then draws a frame each period, never cleared
# between them, since each frame draws only what moved.
fn dt_rtkind(v) {
	local kind a b c d e f now r ms who t0 t

	read -r kind a b c d e f <<< "${DT_RTV["$v"]}"
	case $kind in
	pane)
		who=$b
		dt_has "${who}_draw" || dt_rtrows "$who" || return 1
		console cells clear "$v"
		console pen "$DT_INK" "$DT_FACE"
		DT_NOTEWIN=$a
		dt_wclear "$a"
		console pane origin "w$a" "$c" "$d"
		unset DT_RTVNEW["$v"]
		DT_WHO="pane:$who"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		if dt_has "${who}_draw"; then
			"${who}_draw" "$a" "${DT_RTVH["$v"]}" "$((DT_RTVW["$v"] - e + d))" "$e"
		else
			# Its rows, as the panel draws them: the selection lit while
			# the panel's keys are the pane's (the view's last word), and
			# put at the first row when the window shows another pane, as
			# the panel puts it (panel_goto).
			PW[$a]["side"]=$f
			if [ "${CP_ROWPANE[$a]-}" != "$who" ]; then
				PW[$a]["sel"]=0
				PW[$a]["top"]=0
				PW[$a]["last"]=-1
			fi
			cp_rowsdraw "$a" "$who" "${DT_RTVH["$v"]}" "$((DT_RTVW["$v"] - 1))" "$e"
			dt_rtrowstold "$a" "$who"
		fi
		;;
	strip)
		who=$a
		dt_has "${who}_draw" || return 1
		r := console cells at "$v"
		console cells clear "$v"
		if [ "$b" = 1 ]; then
			console pen "$DT_ACTIVE" "$DT_WELL" bold
		else
			console pen "$DT_IDLE" "$DT_FACE"
		fi
		unset DT_RTVNEW["$v"]
		DT_WHO="strip:$who"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		"${who}_draw" "$r" 0
		;;
	saver)
		who=$a
		read -r _ ms <<< "${DT_RTKP["$who"]}"
		now=$((${EPOCHREALTIME/./} / 1000))
		r := console cells at "$v"
		if [ "$r" != 0 ]; then
			[ -n "${DT_RTONCE["first:$v"]+x}" ] ||
				dt_log "app runtime: saver $who's view is not this process's first; not drawn"
			DT_RTONCE["first:$v"]=1
			return 1
		fi
		DT_WHO="saver:$who"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		if [ -n "${DT_RTVNEW["$v"]+x}" ]; then
			unset DT_RTVNEW["$v"]
			console cells clear "$v"
			console pen white black
			"${who}_start" "${DT_RTVH["$v"]}" "${DT_RTVW["$v"]}"
		elif [ "$now" -lt "${DT_RTVDUE["$v"]:-0}" ]; then
			dt_want $((DT_RTVDUE["$v"] - now))
			DT_WHO=
			return 1
		fi
		console cells touch "$v"
		"${who}_frame" "${DT_RTVH["$v"]}" "${DT_RTVW["$v"]}"
		DT_RTVDUE["$v"]=$((now + ms))
		dt_want "$ms"
		;;
	pop)
		who=$a
		r := console cells at "$v"
		console cells clear "$v"
		console pen "$DT_INK" "$DT_FACE"
		unset DT_RTVNEW["$v"]
		DT_WHO="pop:$who"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		"$b" "$r" 0 "${DT_RTVH["$v"]}" "${DT_RTVW["$v"]}"
		;;
	bar)
		who=$a
		console cells clear "$v"
		console pen "$DT_INK" "$DT_BAR"
		console pane origin bar 0 $((c - ${DT_PRIMARY_COL:-0}))
		unset DT_RTVNEW["$v"]
		DT_WHO="bar:$who"
		slowest on "${DT_SLOWMS:-50}"
		t0=${EPOCHREALTIME/./}
		"$b" "$c" "$d"
		;;
	*) return 1 ;;
	esac
	t=$((${EPOCHREALTIME/./} - t0))
	DT_WHO=
	DT_NOTEWIN=
	[ "$t" -lt 1000 ] || dt_spent "$kind:$who" "$t" "$who"
	return 0
}

# Whether p is a Control Panel pane of this process's that is rows: one with
# a <p>_rows and no _draw, which this process draws and works with the
# panel's own rows (widgets/rows.hibr), as the panel does in the desktop.
fn dt_rtrows(p) {
	[ "${DT_RTKP["$p"]-}" = pane ] && ! dt_has "${p}_draw" && dt_has "${p}_rows"
}

# The panel's search, for the rows of window id drawn here: narrowed as the
# panel narrows them (cp_rowsbuild), from the next draw.
fn dt_rtrowssearch(int id, q = "") {
	SQ[$id]["q"]=$q
}

# The pointer over window id at row r, column c (-1 -1 when it has left):
# the row under it lit from the next draw, as the panel lights it.
fn dt_rtrowshover(int id, int r, int c) {
	local tag

	DT_HOTWIN=
	DT_HOTTAG=
	[ "$r" -ge 0 ] || return 0
	tag := dt_hothit "$id" "$r" "$c" || return 0
	DT_HOTWIN=$id
	DT_HOTTAG=$tag
}

# What the rows just drawn under id hold, told to the desktop when it has
# changed, so the panel's search finds the pane by them: each row as the
# search reads it (cp_rowhas). Not while they are narrowed, which is a part.
fn dt_rtrowstold(int id, pane) {
	local i=0 n=${PW[$id]["n"]:-0} t v l=

	[ -z "${PW[$id]["narrow"]-}" ] || return 0
	while [ "$i" -lt "$n" ]; do
		t=${CP[$id][$i]["text"]-}
		case $DT_LANG in ?*) t := dt_tr "$t" ;; esac
		v := cp_rowval "$id" "$i"
		l+="$t ${CP[$id][$i]["after"]-} $v"$'\n'
		i=$((i + 1))
	done
	l=${l,,}
	[ "${DT_RTROWTXT["$pane"]-}" != "$l" ] || return 0
	DT_RTROWTXT["$pane"]=$l
	dt_rvrowsfound "$pane" "$l"
}

# A pop-up's prefix: what it has of popdraw, popmouse and popkey, said to
# the desktop (`has PREFIX KIND...`) before the pop-up opens, once.
declare -gA DT_RTPOPSAID
fn dt_rtpophas(who = "") {
	local k l
	local -a ks=()

	[ -n "$who" ] && [ -n "$DT_RTCFD" ] && [ -z "${DT_RTPOPSAID["$who"]+x}" ] || return 0
	for k in popdraw popmouse popkey; do
		dt_has "${who}_$k" && ks+=("$k")
	done
	DT_RTPOPSAID["$who"]=1
	l := dt_rtline has "$who" "${ks[@]}"
	send "$DT_RTFD" "$l" 2> /dev/null || dt_log "app runtime: the desktop has gone"
	return 0
}

# This process's cells channel: a second connection to the desktop, named
# by the token the hello's ok gave, opened only when one of its apps draws
# or its file registers a pane, a strip module or a saver; then which
# callbacks each of its prefixes has, a line each (`has PREFIX KIND...`),
# which is how the desktop calls a window or a view of it. Status 1 when
# the desktop refused or did not answer within two seconds.
dt_rtcells() {
	local p= q f l fd end now st
	local -a w kinds
	local -A got

	for q in "${DT_RTPFX[@]}"; do
		dt_has "${q}_draw" && { p=$q; break; }
	done
	[ "${#DT_RTKP[@]}" = 0 ] && [ -z "$DT_RTBARD" ] || p=1
	[ -n "$p" ] || return 0
	[ -n "$DT_RTCTOK" ] || { dt_log "app runtime: the desktop gave no cells token"; return 1; }
	connect -U "$DT_RTSOCK" fd 2> /dev/null || { dt_log "app runtime: cannot open a cells channel"; return 1; }
	send "$fd" "cells $DT_RTCTOK" 2> /dev/null || return 1
	DT_RTCTOK=
	console watch "$fd"
	end=$((${EPOCHREALTIME/./} / 1000 + 2000))
	l=
	while :; do
		dt_rtlines "$fd"
		st=$?
		[ "${#DT_RTGOT[@]}" -gt 0 ] && { l=${DT_RTGOT[0]}; break; }
		now=$((${EPOCHREALTIME/./} / 1000))
		[ "$st" != 1 ] && [ "$now" -lt "$end" ] || break
		console key $((end - now)) > /dev/null
	done
	console unwatch "$fd"
	unset DT_RTBUF["$fd"] DT_RTMORE["$fd"]
	read -ra w <<< "$l"
	if [ "${w[0]-}" != ok ]; then
		dt_log "app runtime: the desktop refused a cells channel: ${l:-no answer}"
		exec {fd}>&-
		return 1
	fi
	console cells open "$fd" || return 1
	DT_RTCFD=$fd
	# Every function of each prefix's own, by what follows the prefix: the
	# desktop takes the callbacks it knows from that, so no second list of
	# callback kinds is kept here.
	l := declare -F
	mapfile -t w <<< "$l"
	for p in "${DT_RTPFX[@]}" "${!DT_RTKP[@]}"; do
		[ -z "${got["$p"]+x}" ] || continue
		got["$p"]=1
		kinds=()
		for f in "${w[@]}"; do
			f=${f##* }
			[[ $f == "${p}_"* ]] && [ -z "${DT_RTIFACE["$f"]+x}" ] && kinds+=("${f#"${p}_"}")
		done
		# A rows pane is drawn and worked here as the panel does it: what
		# the panel gives a pane that draws itself, and that it is rows.
		dt_rtrows "$p" && kinds=(draw key click mouse wheel rows)
		l := dt_rtline has "$p" "${kinds[@]}"
		send "$DT_RTFD" "$l" 2> /dev/null || return 1
	done
	return 0
}

# Restart Desktop kept this process (ADR 0050, the owner, 2026-11-22): its
# code is what is on disk, so it stays, and its connection ended with the
# desktop's exec. It joins the restarted desktop: the socket is listened at
# again under the same name; the launch the old desktop named (DT_RTCARRY)
# says whose it is; the hello sends it every shared name again; what its
# file said as it was read is said again; and over a cells channel of its
# own every view it drew is bound again and drawn whole. Its windows, their
# state and its terminals' programs are as they were -- nothing is opened or
# taken up again. Status 1 when the desktop has not taken it back within
# DT_RTREJOINMS, and it ends as a process whose desktop went does.
DT_RTCARRY=
DT_RTREFUSED=
DT_RTREJOINMS="${DT_RTREJOINMS-15000}"
dt_rtrejoin() {
	local t=$DT_RTCARRY end now l v

	DT_RTCARRY=
	unset DT_RTBUF["$DT_RTFD"] DT_RTMORE["$DT_RTFD"]
	exec {DT_RTFD}>&-
	DT_RTFD=
	if [ -n "$DT_RTCFD" ]; then
		console unwatch "$DT_RTCFD" 2> /dev/null
		exec {DT_RTCFD}>&-
		DT_RTCFD=
	fi
	end=$((${EPOCHREALTIME/./} / 1000 + DT_RTREJOINMS))
	while :; do
		# The hello spent the first token and took the name with it.
		declare -g DT_RTTOKEN=$t
		DT_RTREFUSED=
		dt_rtopen "${DT_RTZAPP:-${DT_RTPFX[0]-}}" && break
		if [ -n "$DT_RTFD" ]; then
			unset DT_RTBUF["$DT_RTFD"] DT_RTMORE["$DT_RTFD"]
			exec {DT_RTFD}>&-
			DT_RTFD=
		fi
		# Refused, it is done: a restarted desktop knows the launch before
		# it listens, so one that refuses it is not the desktop this
		# process was kept for -- a restart that failed after all.
		if [ -n "$DT_RTREFUSED" ]; then
			dt_log "app runtime: rejoining: $DT_RTSAID"
			return 1
		fi
		# Not reached, or not answered yet -- the desktop is still
		# starting -- it is tried again until DT_RTREJOINMS.
		now=$((${EPOCHREALTIME/./} / 1000))
		[ "$now" -lt "$end" ] || { dt_log "app runtime: rejoining: $DT_RTSAID"; return 1; }
		# Quiet: a terminal's program writing meanwhile keeps in its own
		# buffer, rather than waking this wait at once each time.
		console key -q 100 > /dev/null
	done
	for l in "${DT_RTLOADL[@]}"; do
		send "$DT_RTFD" "$l" 2> /dev/null || return 1
	done
	for v in "${!DT_RTV[@]}"; do
		DT_RTVNEW["$v"]=1
	done
	dt_rtcells || return 1
	for v in "${!DT_RTV[@]}"; do
		console cells again "$v" 2> /dev/null
	done
	console watch -i "$DT_RTFD" || return 1
	dt_log "app runtime: joined the restarted desktop"
	return 0
}

# A window being carried to a fresh process (a Restart Desktop, ADR 0050):
# the app's own _stash, then each map it keeps the window's state in,
# written beside what _stash saved as rt-ID.json, which the fresh process
# reads back before the app's _resume. What a terminal's _stash hands over
# by descriptor needs nothing here: its program is the desktop's child, and
# the desktop hands its master to whichever process asks for it by its pid.
fn dt_rtstash(int id, dir = "") {
	local ap=${DT[$id]["app"]-} m j out="{}"
	local -A kept

	[ -n "$dir" ] && [ -d "$dir" ] || { dt_log "app runtime: window $id asked to keep its state in ${dir:-nothing}"; return 1; }
	dt_has "${ap}_stash" && dt_appcall "$id" "${ap}_stash" "$dir"
	json parse kept "{}"
	for m in ${DT_RTKEEP["$ap"]-}; do
		j := json get "$m" ".$id" 2> /dev/null || continue
		json parse kept["$m"] "$j"
	done
	out := json emit kept
	printf '%s\n' "$out" > "$dir/rt-$id.json.$$" && mv -f "$dir/rt-$id.json.$$" "$dir/rt-$id.json"
	dt_rtfreeze
}

# Once a window's state is kept for a fresh process, this one holds still
# until it goes: nothing more read from what it watches -- a terminal's
# master above all, whose output read now would be in neither the saved
# screen nor the fresh process -- nothing drawn, no ticker run; only the
# desktop's socket, whose end is this process's.
dt_rtfreeze() {
	local x
	local -a watched

	[ -z "$DT_RTFROZEN" ] || return 0
	DT_RTFROZEN=1
	x := console watching
	read -ra watched <<< "$x"
	for x in "${watched[@]}"; do
		x=${x%%:*}
		[ "$x" = "$DT_RTFD" ] || console unwatch "$x"
	done
	DT_RTPTYFD=
	return 0
}

# A window carried from another process, taken up: its maps read back, then
# the app's _resume, or its _open when it has neither, as a restart does
# in-process (dt_restore).
fn dt_rtresume(int id, dir = "") {
	local ap=${DT[$id]["app"]-} m j f="$dir/rt-$id.json" got=
	local -A kept

	if [ -r "$f" ] && json parse kept < "$f" 2> /dev/null; then
		for m in "${!kept[@]}"; do
			j := json get kept ".$m" 2> /dev/null || continue
			json parse "$m[$id]" "$j" && got=1
		done
	fi
	if dt_has "${ap}_resume"; then
		dt_appcall "$id" "${ap}_resume"
	elif [ -z "$got" ] && dt_has "${ap}_open"; then
		dt_appcall "$id" "${ap}_open" ""
	fi
	[ -z "$DT_RTFORKT" ] ||
		dt_log "app runtime: window $id taken up $(((${EPOCHREALTIME/./} - DT_RTFORKT) / 1000)) ms after its process's fork"
	return 0
}

# What the desktop shares, arriving: `json NAME KIND TEXT` the whole of a
# name, declared as the desktop has it (KIND A a map declared -A, a a list,
# s a scalar) and from then on guarded; `jsonk NAME KEY JSON` one entry of a
# map, `unsetk NAME KEY` one gone. Written only here, with the guard lifted
# for the write, never by eval.
fn dt_rtmirrored(...w) {
	local name kind v k

	name := dt_rtdec "${w[1]-}"
	if ! [[ $name =~ ^[A-Z][A-Z0-9_]*$ ]]; then
		dt_log "app runtime: the desktop sent ${name:-nothing}, which is no shared name; refused"
		return 0
	fi
	DT_RTDERIVE=1
	varwatch apply on
	case ${w[0]} in
	json)
		kind := dt_rtdec "${w[2]-}"
		v := dt_rtdec "${w[3]-}"
		case $kind in
		A) declare -gA "$name" ;;
		a) declare -ga "$name" ;;
		*) declare -g "$name" ;;
		esac
		json parse "$name" <<< "$v" ||
			dt_log "app runtime: the desktop sent $name as JSON this app could not read; kept the old"
		varwatch add "$name"
		;;
	jsonk)
		k := dt_rtdec "${w[2]-}"
		v := dt_rtdec "${w[3]-}"
		local -n m=$name
		unset m["$k"]
		json parse m["$k"] "$v" ||
			dt_log "app runtime: the desktop sent an entry of $name this app could not read"
		;;
	unsetk)
		k := dt_rtdec "${w[2]-}"
		local -n m=$name
		unset m["$k"]
		;;
	esac
	varwatch apply off
	return 0
}

# The app's own loop: one wait for everything -- the desktop's socket,
# whatever the app watches, its timers (dt_want) -- through `console key`,
# which with no display waits on those and the time alone; then the app's
# tickers, the one runner the desktop has too; then what the desktop said,
# at most DT_RTLINES a pass. It ends when the desktop does: a closed socket
# is readable for ever, so the end is noticed, not spun on.
dt_rtrun() {
	local w l st
	local -a got

	# As input: a quiet wait (a held frame's) still ends on what the
	# desktop says.
	console watch -i "$DT_RTFD" || return 1
	while :; do
		# Its bar hooks, each pass, as the desktop runs them each frame:
		# after what the desktop said, so a setting it pushed is read, and
		# before the drawing, so what they change goes out with it.
		for l in "${DT_RTHOOKS[@]}"; do
			"$l"
		done
		# What this pass made due is drawn before the wait, so a key's
		# echo goes out with the call that caused it.
		[ -n "$DT_RTFROZEN" ] || dt_rtdraw
		if [ -n "$DT_RTHADV" ] && [ "${#DT_RTV[@]}" = 0 ]; then
			if [ -z "$DT_RTBARS" ] && ! dt_rtworking; then
				console unwatch "$DT_RTFD"
				dt_log "app runtime: its last window has gone; this app ends"
				return 0
			fi
			if [ "$DT_RTHADV" = 1 ]; then
				DT_RTHADV=2
				dt_log "app runtime: its last window has gone; it stays for its own work (a ticker, a job or an item on the bar)"
			fi
		fi
		# A hook follows the clock's minute (the clock's, prayer's): with
		# one here, nothing waits past the next minute -- one wake a minute,
		# the frame the desktop's clock asks for in any case.
		if [ "${#DT_RTHOOKS[@]}" -gt 0 ]; then
			l=$(((60 - EPOCHSECONDS % 60) * 1000))
			[ -n "$DT_WANT" ] && [ "$DT_WANT" -le "$l" ] || DT_WANT=$l
		fi
		if [ -n "$DT_RTFROZEN" ]; then
			DT_WANT=
		fi
		if [ -n "$DT_RTQUIET" ]; then
			DT_RTQUIET=
			console key -q ${DT_WANT:+"$DT_WANT"}
		else
			console key ${DT_WANT:+"$DT_WANT"}
		fi
		DT_WANT=
		[ -n "$DT_RTFROZEN" ] || dt_rtidle
		# The desktop saying a terminal's program ended: taken up now, so
		# the window asks `term alive` of what is true.
		if [ -n "$DT_RTPTYFD" ]; then
			w := console woke "$DT_RTPTYFD"
			if [ -n "$w" ] && ! pty pump; then
				console unwatch "$DT_RTPTYFD"
				DT_RTPTYFD=
			fi
		fi
		[ -n "$DT_RTFROZEN" ] || dt_tickers
		# Tells an ask kept for after it run first, in order.
		while [ "${#DT_RTQ[@]}" -gt 0 ]; do
			l=${DT_RTQ[0]}
			DT_RTQ=("${DT_RTQ[@]:1}")
			dt_rtcalled "$l"
		done
		w := console woke "$DT_RTFD"
		[ -n "$w" ] || [ -n "${DT_RTMORE["$DT_RTFD"]+x}" ] || continue
		dt_rtlines "$DT_RTFD"
		st=$?
		# The batch waits in DT_RTQ and is taken one line at a time, so an
		# ask made by one of them applies the rest of the batch's shared
		# lines first, in the order they came. A revoke in it is noted
		# first, so the call it withdraws is dropped, not run.
		for l in "${DT_RTGOT[@]}"; do
			[[ $l == "revoke "* ]] && DT_RTREVOKED["${l#revoke }"]=1
		done
		DT_RTQ+=("${DT_RTGOT[@]}")
		while [ "${#DT_RTQ[@]}" -gt 0 ]; do
			l=${DT_RTQ[0]}
			DT_RTQ=("${DT_RTQ[@]:1}")
			dt_rtcalled "$l"
		done
		dt_rtderived
		[ -n "${DT_RTMORE["$DT_RTFD"]+x}" ] && dt_want 0
		if [ "$st" = 1 ]; then
			console unwatch "$DT_RTFD"
			if [ -n "$DT_RTCARRY" ]; then
				dt_rtrejoin && continue
				dt_log "app runtime: the restarted desktop did not take this process back; this app ends"
				return 0
			fi
			dt_log "app runtime: the desktop has gone; this app ends with it"
			return 0
		fi
		if [ "$st" = 2 ]; then
			dt_log "app runtime: the desktop sent a line with no end past DT_RTLINEMAX"
			return 1
		fi
	done
}


# The zygote (ADR 0050): the one prepared host of a desktop's app processes.
# It has read this file -- the app interface, the requests, the modules every
# app process needs -- once, and forks a fresh process for each app the
# desktop asks for on its channel (zfd), so none parses it again and every
# one shares its pages. The channel carries messages with descriptors
# (mods/zygote.c), a line of words each, as the socket's lines are written:
#   desktop to zygote: fork TOKEN APP FILE [WORD...]   with the new process's
#                      channel for its terminals' programs riding on it;
#                      end PID SIGNAL
#   zygote to desktop: zygote PROTOCOL VERSION   forked TOKEN PID
#                      exit PID STATUS
# With no words the fresh process returns from here, status 0, with the app
# and its file in DT_RTZAPP and DT_RTZFILE, and runs it at the top of this
# file -- never inside a function, where the app's file would see this one's
# locals; with words, it execs hibr on them, for a file that is its own
# runtime (a test's). The zygote is every app process's parent, so it waits
# for each and says how it ended; whatever forked a child is entitled to its
# status. When the desktop goes it waits for its processes, which see their
# own sockets end, a little, then ends those left and itself: status 1.
fn dt_rtzygote(int zfd) {
	local l pid st tok app file x n
	local -a w fds run

	need zygote || { dt_log "app runtime: no zygote module"; return 1; }
	need pty 2> /dev/null || dt_log "app runtime: no pty module, so no terminal's program is the desktop's"
	title -s zygote "hibr zygote of the desktop's app processes"
	l := dt_rtline zygote "$DT_RTPROTO" "$HIBR_VERSION"
	zygote send "$zfd" "$l" || return 1
	console watch "$zfd"
	while :; do
		l := zygote reaped
		while read -r pid st; do
			[ -n "$pid" ] || continue
			x := dt_rtline exit "$pid" "$st"
			zygote send "$zfd" "$x"
		done <<< "$l"
		while :; do
			l := zygote recv "$zfd" -t 0 ZG_FDS
			st=$?
			[ "$st" = 0 ] || break
			read -ra w <<< "$l"
			fds=()
			read -ra fds <<< "$ZG_FDS"
			for x in "${!w[@]}"; do
				w[$x] := dt_rtdec "${w[$x]}"
			done
			case ${w[0]-} in
			fork)
				tok=${w[1]-}
				app=${w[2]-}
				file=${w[3]-}
				run=("${w[@]:4}")
				x=${fds[0]-}
				DT_RTFORKT=${EPOCHREALTIME/./}
				if [ -n "$x" ]; then
					pid := zygote fork -k "$x"
				else
					pid := zygote fork
				fi
				if [ "$pid" = 0 ]; then
					console unwatch "$zfd" 2> /dev/null
					title -s "app:$app" "hibr app $app"
					if [ "${#run[@]}" -gt 0 ]; then
						DT_RTTOKEN=$tok exec "$HIBR" "${run[@]}"
						exit 127
					fi
					DT_RTTOKEN=$tok
					if [ -n "$x" ]; then
						pty via "$x" && DT_RTPTYFD=$x && console watch "$DT_RTPTYFD"
					fi
					DT_RTZAPP=$app
					DT_RTZFILE=$file
					return 0
				fi
				[ -z "$x" ] || exec {x}>&-
				for x in "${fds[@]:1}"; do
					exec {x}>&-
				done
				l := dt_rtline forked "$tok" "$pid"
				zygote send "$zfd" "$l"
				;;
			end) zygote end "${w[1]-}" "${w[2]-15}" ;;
			*)
				for x in "${fds[@]}"; do
					exec {x}>&-
				done
				dt_log "app runtime: the zygote was told ${w[0]:-nothing}, which it does not know"
				;;
			esac
		done
		[ "$st" = 1 ] && break
		console key > /dev/null
	done
	console unwatch "$zfd"
	zygote close "$zfd"
	n=$((${EPOCHREALTIME/./} / 1000 + ${DT_RTENDSECS:-5} * 1000))
	while :; do
		l := zygote reaped
		x := zygote kids
		[ -n "$x" ] || break
		if [ "$((${EPOCHREALTIME/./} / 1000))" -ge "$n" ]; then
			read -ra w <<< "$x"
			for pid in "${w[@]}"; do
				zygote end "$pid" 9
			done
		fi
		console key 100 > /dev/null
	done
	return 1
}

# Run as the zygote, by the desktop (dt_rtzstart), on the channel given;
# what returns from it is a fresh app process, which is that app's whole
# process: the hello, so the desktop's state is here before the app's file
# reads it, as it is in the desktop; the app's file, read with no arguments
# of this process's (an app run directly acts on its own), and each part its
# bundle declares (`# part:`), since a bundle is one process; its cells
# channel; its loop.
if [ "${BASH_SOURCE[0]}" = "$0" ] && [ "${1-}" = --zygote ] && [ "$#" = 2 ]; then
	dt_rtzygote "$2" || exit 0
	DT_HOLDWHAT=${DT_RTZAPP##*/}
	DT_HOLDWHAT="${DT_HOLDWHAT%.hibr}'s own process"
	dt_rtopen "$DT_RTZAPP" || { dt_log "app runtime: $DT_RTZAPP: $DT_RTSAID"; exit 1; }
	for f in "${DT_TICKERS[@]}"; do
		DT_RTBASETICK["$f"]=1
	done
	unset f
	DT_LOADING=$DT_RTZFILE
	set --
	. "$DT_LOADING"
	if DT_RTPARTS := dt_rtpartfiles "$DT_LOADING"; then
		mapfile -t DT_RTPARTL <<< "$DT_RTPARTS"
		for DT_LOADING in "${DT_RTPARTL[@]}"; do
			[ -z "$DT_LOADING" ] || . "$DT_LOADING"
		done
	fi
	DT_LOADING=
	dt_log "app runtime: $DT_RTZAPP read $(((${EPOCHREALTIME/./} - DT_RTFORKT) / 1000)) ms after its fork"
	dt_rtcells || exit 1
	dt_rtrun
	[ -z "$DT_RTMARK" ] || command rm -f -- "$DT_RTMARK"
	exit
fi
