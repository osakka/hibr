#!/usr/bin/env hibr
#
# youtube -- YouTube in a window: search, playlists and channels, the
# picture drawn as cells and the sound through the machine's own device,
# with a history that takes a video up where it was left, and favourites.
#
# Nothing here is a YouTube client of its own. YouTube's own page runs in the
# web module's engine, and what the engine can do is its `web caps`. With
# WebKit (hibr-browser) the engine fetches, decodes and plays the video itself,
# picture and sound, as it does any page's; the page is drawn here as cells or
# pixels with YouTube's own controls set aside. With Chromium the page's player
# fetches the video at the lowest quality, muted, and the web module's tap
# copies every chunk it hands the browser's media source down two pipes into a
# media player, which decodes them with FFmpeg's libraries and plays them here.
# Either way this app drives YouTube's player: play and pause, a time, the
# volume. A search, a playlist or a channel is read from the page's own data.
#
# A list: type to search -- or paste a playlist's, a channel's or a
# video's address -- and enter; up and down choose, enter plays a video or
# opens a playlist or a channel, f keeps it as a favourite, escape goes
# back to the list before; h is the history and v the favourites, both on
# the Go menu too.
# The player: space pauses, left and right are five seconds, shift with
# them thirty, up and down the volume, n and p the next video and the one
# before, f a favourite, m the picture (half blocks, ASCII, plain), c the
# captions (drawn here as text, in the window, not in the picture), q the
# quality (144p, 240p, 360p, 480p, and round again), h the history and v the
# favourites (both end the video, noting where it was), escape
# back to the list. A click on the bar goes there. At the end of a video
# the next in the list plays, unless Play > Play Next Automatically is off.
#
# The history and the favourites are files of their own, a line to an
# entry (~/.local/share/hibr/youtube/). YouTube's ads are played as
# YouTube's player plays them (with Chromium, through the same media source:
# they come down the same pipes).

strict

app youtube "YouTube, in a window" 3.6
# part: control-panel/tube.hibr
# modules: media web

command -v dt_app > /dev/null && dt_app youtube "YouTube" 24 84 many "▶"

declare -gA YT
command -v dt_keepstate > /dev/null && dt_keepstate youtube YT
declare -gA YR

YT_BASE="${YT_BASE-https://www.youtube.com}"
# How the picture is drawn. `follow` is Control Panel > Pictures, which is
# the one setting meant to reach every picture the desktop draws (ADR 0037);
# the rest say outright, for someone who wants this window different from
# the Image Viewer. A settings file from before 0.99.77 holds `half`, the
# old default, and cp_setver7 brings that one -- and only that one -- here.
YT_MODE="${YT_MODE-follow}"
YT_QUALITY="${YT_QUALITY-tiny}"
YT_AUTONEXT="${YT_AUTONEXT-1}"
# Captions, when the video has them: off until asked for, c or Play > Captions.
YT_CAPTIONS="${YT_CAPTIONS-0}"
# With an engine whose video is played here (tap): frames a second and how
# finely the picture is coloured, which decide how much a terminal is sent.
YT_FPS="${YT_FPS-24}"
YT_DETAIL="${YT_DETAIL-2}"
# Whether a playing video keeps the screen saver, and the lock with it,
# away: on unless chosen otherwise, the owner's choice (Gitea #277).
YT_SAVERHOLD="${YT_SAVERHOLD-1}"
# The mini player (Gitea #304): whether it casts a shadow, whether it is
# on every workspace, and where it was last left, "row col h w", so it
# opens there again rather than in its display's corner each time.
YT_MINISHADOW="${YT_MINISHADOW-1}"
YT_MINISTICKY="${YT_MINISTICKY-1}"
YT_MINIGEO="${YT_MINIGEO-}"
command -v dt_keep > /dev/null && dt_keep YT_MODE YT_QUALITY YT_FPS YT_DETAIL YT_CAPTIONS YT_AUTONEXT YT_SAVERHOLD YT_MINISHADOW YT_MINISTICKY YT_MINIGEO
YT_MODES=(follow half ascii mono pixels)
YT_DATA="${YT_DATA-${XDG_DATA_HOME:-$HOME/.local/share}/hibr/youtube}"
YT_HIST="$YT_DATA/history.tsv"
YT_FAVS="$YT_DATA/favourites.tsv"
YT_KEEP=500

# A video is taken up where it was left once more than YT_RESUME seconds
# in; within YT_ENDED seconds of its end it counts as watched to the end.
YT_RESUME="${YT_RESUME-30}"
YT_ENDED="${YT_ENDED-20}"

# A page's own data -- a search, a playlist, a channel's videos -- as a
# list of what it shows: videos, playlists and channels, each kind as
# YouTube draws it today (videoRenderer and its kin, lockupViewModel,
# channelRenderer), with the page's own title. Empty until the page has
# made it, a moment after it says it has loaded.
YT_RJS='(function(){var d=window.ytInitialData;if(!d)return "";function t(x){return x?(x.content||x.simpleText||(x.runs||[]).map(function(r){return r.text}).join("")):""}var o=[],seen={};function push(e){if(!e.id||seen[e.kind+e.id])return;seen[e.kind+e.id]=1;o.push(e)}function vid(v){push({kind:"video",id:v.videoId,title:t(v.title),ch:t(v.ownerText||v.shortBylineText),len:t(v.lengthText),views:t(v.shortViewCountText||v.viewCountText),age:t(v.publishedTimeText)})}function badge(x,k){var r="";(function f(n,j){if(r||!n||typeof n!=="object"||j>20)return;if(n.thumbnailBadgeViewModel&&n.thumbnailBadgeViewModel.text){r=n.thumbnailBadgeViewModel.text;return}for(var y in n)f(n[y],j+1)})(x,0);return r}function lock(l){var m=(l.metadata||{}).lockupMetadataViewModel||{},parts=[];(((m.metadata||{}).contentMetadataViewModel||{}).metadataRows||[]).forEach(function(r){(r.metadataParts||[]).forEach(function(p){if(p.text)parts.push(t(p.text))})});var k=l.contentType==="LOCKUP_CONTENT_TYPE_PLAYLIST"?"playlist":l.contentType==="LOCKUP_CONTENT_TYPE_VIDEO"?"video":"";if(!k)return;push({kind:k,id:l.contentId,title:t(m.title),ch:parts[0]||"",len:badge(l.contentImage),views:k==="video"?(parts.filter(function(p){return /^[0-9.,]+[KMB]?( views)?$/.test(p)})[0]||""):"",age:k==="video"?(parts.filter(function(p){return /ago$/.test(p)})[0]||""):""})}function chan(c){var e=c.navigationEndpoint&&c.navigationEndpoint.browseEndpoint||{};push({kind:"channel",id:e.canonicalBaseUrl||("/channel/"+c.channelId),title:t(c.title),ch:"",len:"",views:t(c.videoCountText||c.subscriberCountText),age:""})}function w(n,k){if(!n||typeof n!=="object"||k>80)return;if(n.videoRenderer){vid(n.videoRenderer);return}if(n.playlistVideoRenderer){vid(n.playlistVideoRenderer);return}if(n.gridVideoRenderer){vid(n.gridVideoRenderer);return}if(n.lockupViewModel){lock(n.lockupViewModel);return}if(n.channelRenderer){chan(n.channelRenderer);return}for(var x in n)w(n[x],k+1)}w(d.contents||d,0);var md=d.metadata||{},h=(md.playlistMetadataRenderer||md.channelMetadataRenderer||{}).title||"";return JSON.stringify({head:h,list:o})})()'

# Where YouTube's player is: its state, the time, the length, the title,
# and whether it is showing its own error.
YT_PJS='(function(){var p=document.getElementById("movie_player"),v=document.querySelector("video");if(!p||!p.getPlayerState)return "";var d=p.getVideoData?p.getVideoData():{};return JSON.stringify({st:p.getPlayerState(),t:v?v.currentTime:0,d:p.getDuration?p.getDuration():0,title:d.title||"",author:d.author||"",e:document.querySelector(".ytp-error")?1:0,pa:v&&v.paused?1:0,en:v&&v.ended?1:0,rs:v?v.readyState:0,u:location.href,cc:(function(){var l=[].slice.call(document.querySelectorAll(".ytp-caption-segment")).map(function(e){return e.textContent});return l.some(function(t){return /Click\s+for settings/.test(t)})?"":l.join(" ")})(),vol:v?Math.round(v.volume*100):100,fr:v&&v.getVideoPlaybackQuality?v.getVideoPlaybackQuality().totalVideoFrames:0})})()'

# Start YouTube's player once it is there: the quality asked for, the
# volume, captions off, and the page cut down to the video. That is done by
# structure, not by YouTube's names for things: every element that does not
# hold the video is hidden (the masthead, the recommendations, the comments,
# the player's own controls and overlays), and every one that does -- the
# video's ancestors -- fills the window. A redesign of the page changes none
# of it, since it names nothing; and covering the extras instead does not
# work, as they sit outside the player's stacking context.
YT_CSS='html,body{overflow:hidden!important;background:#000!important;margin:0!important}body *:not(:has(video)):not(video){display:none!important}body *:has(video){display:block!important;position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;min-width:0!important;min-height:0!important;max-width:none!important;max-height:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;transform:none!important;overflow:hidden!important;background:#000!important}video{display:block!important;position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:contain!important;border-radius:0!important;background:#000!important}'
fn yt_startjs(q, v, vid, cc) {
	ret "(function(){var p=document.getElementById(\"movie_player\");if(!p||!p.playVideo||location.href.indexOf(\"v=$vid\")<0)return \"\";if(!document.getElementById(\"hibr-yt\")){var c=document.createElement(\"style\");c.id=\"hibr-yt\";c.textContent='$YT_CSS';document.head.appendChild(c)}try{p.setPlaybackQualityRange(\"$q\",\"$q\")}catch(e){}try{p.${cc}Module(\"captions\")}catch(e){}if(p.unMute)p.unMute();if(p.setVolume)p.setVolume($v);p.playVideo();return \"ok\"})()"
}

# The same for an engine with a tap: muted, since the sound is ours, and the
# page left as it is, since its picture is not what is drawn.
fn yt_startjs_tap(q, cc) {
	ret "(function(){var p=document.getElementById(\"movie_player\");if(!p||!p.playVideo)return \"\";try{p.setPlaybackQualityRange(\"$q\",\"$q\")}catch(e){}try{p.${cc}Module(\"captions\")}catch(e){}if(p.mute)p.mute();p.playVideo();return \"ok\"})()"
}

# What to tell YouTube's player about captions, as the name of the call.
fn yt_ccword() {
	[ "$YT_CAPTIONS" = 1 ] && ret load || ret unload
}

# What the engine does, as `web caps` says it, asked the first time: Chromium's
# page is tapped and its media played here (tap), WebKit plays the page itself
# (sound). Both are one app; only the carrying of the video differs.
YT_CAPS=
fn yt_has(c) {
	[ -n "$YT_CAPS" ] || YT_CAPS := web caps 2> /dev/null
	case " $YT_CAPS " in *" $c "*) return 0 ;; esac
	return 1
}
fn yt_tap() {
	yt_has tap
}

# Whether the engine is here; the reason in the window when not.
fn yt_need(int id) {
	if ! need web 2> /dev/null; then
		YT[$id]["err"]="The web module is not installed"
		return 1
	fi
	if yt_tap; then
		if ! need media 2> /dev/null; then
			YT[$id]["err"]="The media module is not installed"
			return 1
		fi
		return 0
	fi
	yt_has sound && return 0
	YT[$id]["err"]="YouTube needs an engine that plays sound: apt install hibr-browser, or Chromium"
	return 1
}

# A tab of the window's own: st for lists, pt for playing. The player's has
# the tap where the engine has one, so every chunk its page plays can be taken;
# else it is let play sound without a press, since the page is one that was
# opened to be watched.
fn yt_tab(int id, which) {
	local t=${YT[$id]["$which"]}

	if [ -z "$t" ]; then
		dt_has bw_cfg && bw_cfg
		t := web open 2> /dev/null || {
			YT[$id]["err"]="No browser engine to reach YouTube with -- install hibr-browser or Chromium, or set HIBR_WPE or HIBR_WEB_BROWSER"
			return 1
		}
		if [ "$which" = pt ]; then
			if yt_tap; then web tap "$t" 2> /dev/null; else web sound "$t" load 2> /dev/null; fi
		fi
		YT[$id]["$which"]=$t
	fi
	ret "$t"
}

# --- lists: a search, a playlist, a channel, the history, the favourites --

# What a typed text asks for: a playlist, a channel or one video when it is
# an address of one, else a search. Into YTQ_KIND and YTQ_ARG.
YTQ_KIND=
YTQ_ARG=
fn yt_parse(q) {
	local m

	YTQ_KIND=search
	YTQ_ARG=$q
	if [[ $q =~ [?\&]list=([A-Za-z0-9_-]+) ]]; then
		YTQ_KIND=playlist
		YTQ_ARG=${M[1]}
	elif [[ $q =~ (youtube\.com/watch\?.*v=|youtu\.be/|youtube\.com/shorts/)([A-Za-z0-9_-]{11}) ]]; then
		YTQ_KIND=video
		YTQ_ARG=${M[2]}
	elif [[ $q =~ youtube\.com(/@[^/?]+|/channel/[A-Za-z0-9_-]+|/c/[^/?]+) ]]; then
		YTQ_KIND=channel
		YTQ_ARG=${M[1]}
	elif [[ $q =~ ^@[A-Za-z0-9._-]+$ ]]; then
		YTQ_KIND=channel
		YTQ_ARG=/$q
	fi
}

# Show a list: a page's for a search, a playlist or a channel, read when it
# is ready; the history's or the favourites' from their files at once.
# Unless told not to, the list shown before is kept to go back to.
fn yt_load(int id, kind, arg, head = "", push = 1) {
	local t u

	yt_need "$id" || return 0
	# Going to a list from the player ends the video: where it was is noted in
	# the history, and nothing goes on playing, unheard of, behind the list.
	[ -n "${YT[$id]["p"]}" ] && yt_stop "$id"
	if [ "$push" = 1 ] && [ -n "${YT[$id]["kind"]}" ]; then
		YT[$id]["stack"]+="${YT[$id]["kind"]}"$'\t'"${YT[$id]["arg"]}"$'\t'"${YT[$id]["head"]}"$'\n'
	fi
	YT[$id]["kind"]=$kind
	YT[$id]["arg"]=$arg
	YT[$id]["head"]=$head
	YT[$id]["err"]=
	YT[$id]["view"]=list
	dt_searchshut "$id"
	YT[$id]["n"]=0
	YT[$id]["sel"]=0
	YT[$id]["top"]=0
	case $kind in
	history) yt_filelist "$id" "$YT_HIST"; return 0 ;;
	favourites) yt_filelist "$id" "$YT_FAVS"; return 0 ;;
	video)
		YR[$id][0]["kind"]=video
		YR[$id][0]["id"]=$arg
		YR[$id][0]["title"]=$arg
		YR[$id][0]["ch"]=
		YR[$id][0]["len"]=
		YT[$id]["n"]=1
		yt_play "$id" 0
		return 0
		;;
	search) u="$YT_BASE/results?search_query=${arg// /+}" ;;
	playlist) u="$YT_BASE/playlist?list=$arg" ;;
	channel) u="$YT_BASE$arg/videos" ;;
	esac
	t := yt_tab "$id" st || return 0
	web eval "$t" "window.ytInitialData=undefined" > /dev/null 2>&1
	web go "$t" "$u" 2> /dev/null
	YT[$id]["searching"]=$EPOCHSECONDS
}

# A search, or whatever address was typed.
fn yt_search(int id, q) {
	q=${q#"${q%%[! ]*}"}
	q=${q%"${q##*[! ]}"}
	[ -n "$q" ] || return 0
	yt_parse "$q"
	YT[$id]["q"]=$q
	yt_load "$id" "$YTQ_KIND" "$YTQ_ARG"
}

# Back to the list shown before this one; none left puts the keyboard in
# the search field.
fn yt_back(int id) {
	local st=${YT[$id]["stack"]} last
	local -a f

	if [ -z "$st" ]; then
		dt_searchopen "$id"
		return 0
	fi
	st=${st%$'\n'}
	last=${st##*$'\n'}
	[ "$last" = "$st" ] && st= || st=${st%$'\n'*}
	YT[$id]["stack"]=${st:+$st$'\n'}
	IFS=$'\t' read -ra f <<< "$last"
	yt_load "$id" "${f[0]}" "${f[1]}" "${f[2]}" 0
}

# The list a page has made, once it has: into YR, an entry to a row.
fn yt_results(int id) {
	local t=${YT[$id]["st"]} js i k
	local -A r

	if web loading "$t" 2> /dev/null; then
		dt_want 300
		return 0
	fi
	js := web eval "$t" "$YT_RJS" 2> /dev/null
	if [ -z "$js" ]; then
		if [ $((EPOCHSECONDS - YT[$id]["searching"])) -gt 20 ]; then
			YT[$id]["searching"]=
			YT[$id]["err"]="YouTube did not answer"
		fi
		dt_want 300
		return 0
	fi
	json parse r <<< "$js" 2> /dev/null || r=()
	i=0
	while [ -n "${r["list"][$i]["id"]}" ]; do
		for k in kind id title ch len views age; do
			YR[$id][$i]["$k"]=${r["list"][$i]["$k"]}
		done
		i=$((i + 1))
	done
	[ -n "${r["head"]}" ] && [ -z "${YT[$id]["head"]}" ] && YT[$id]["head"]=${r["head"]}
	YT[$id]["n"]=$i
	YT[$id]["searching"]=
	[ "$i" = 0 ] && YT[$id]["err"]="Nothing found"
	return 0
}

# A list kept in a file -- the history or the favourites -- newest first:
# a line to an entry, its fields tab-separated.
fn yt_filelist(int id, f) {
	local -a lines fl
	local i n=0 k j

	[ -r "$f" ] && mapfile -t lines < "$f"
	i=$((${#lines[@]} - 1))
	while [ "$i" -ge 0 ]; do
		IFS=$'\t' read -ra fl <<< "${lines[$i]}"
		if [ -n "${fl[1]}" ]; then
			j=0
			for k in kind id title ch len views age; do
				YR[$id][$n]["$k"]=${fl[$j]}
				j=$((j + 1))
			done
			n=$((n + 1))
		fi
		i=$((i - 1))
	done
	YT[$id]["n"]=$n
	[ "$n" = 0 ] && [ "$f" = "$YT_HIST" ] && YT[$id]["err"]="Nothing watched yet"
	[ "$n" = 0 ] && [ "$f" = "$YT_FAVS" ] && YT[$id]["err"]="No favourites yet -- f keeps one"
	return 0
}

# What the list heading says.
fn yt_heading(int id) {
	local h=${YT[$id]["head"]}

	case ${YT[$id]["kind"]} in
	search) ret "Results for ${YT[$id]["arg"]}" ;;
	playlist) ret "Playlist${h:+: $h}" ;;
	channel) ret "Channel${h:+: $h}" ;;
	history) ret "History" ;;
	favourites) ret "Favourites" ;;
	*) ret "" ;;
	esac
}

# --- history and favourites ---------------------------------------------

# Rewrite a file of entries without the one for an id, then with a new
# line at its end; at most YT_KEEP lines are kept, the oldest dropped.
fn yt_fileput(f, vid, line = "") {
	local -a lines out
	local l n

	[ -r "$f" ] && mapfile -t lines < "$f"
	out=()
	for l in "${lines[@]}"; do
		[[ $l == *$'\t'"$vid"$'\t'* ]] && continue
		out+=("$l")
	done
	[ -n "$line" ] && out+=("$line")
	n=${#out[@]}
	[ "$n" -gt "$YT_KEEP" ] && out=("${out[@]:$((n - YT_KEEP))}")
	command mkdir -p -- "${f%/*}" 2> /dev/null
	if [ "${#out[@]}" -gt 0 ]; then
		printf '%s\n' "${out[@]}" > "$f" 2> /dev/null
	else
		: > "$f" 2> /dev/null
	fi
}

# The history's line for a video, or nothing; its fields into YTH.
declare -ga YTH
fn yt_histget(vid) {
	local -a lines
	local l

	YTH=()
	[ -r "$YT_HIST" ] || return 1
	mapfile -t lines < "$YT_HIST"
	for l in "${lines[@]}"; do
		if [[ $l == *$'\t'"$vid"$'\t'* ]]; then
			IFS=$'\t' read -ra YTH <<< "$l"
			return 0
		fi
	done
	return 1
}

# Note where a window's video was left: watched to the end it starts from
# the beginning next time; left part way it is taken up there.
fn yt_histput(int id, pos = "") {
	local vid=${YT[$id]["vid"]} d=${YT[$id]["dur"]} p i

	[ -n "$vid" ] || return 0
	p=$pos
	if [ -z "$p" ] && [ -n "${YT[$id]["p"]}" ]; then
		yt_info "$id"
		p=${YTI["pos"]}
	fi
	p=${p%.*}
	d=${d%.*}
	[ -n "$p" ] || p=0
	[ -n "$d" ] || d=0
	[ "$d" -gt 0 ] && [ "$p" -ge $((d - YT_ENDED)) ] && p=0
	yt_fileput "$YT_HIST" "$vid" "video"$'\t'"$vid"$'\t'"${YT[$id]["title"]}"$'\t'"${YT[$id]["author"]}"$'\t'"${YT[$id]["len"]}"$'\t'"$p"$'\t'"$d"
}

# Keep an entry as a favourite, or take it out: the chosen one in a list,
# the one playing in the player.
fn yt_fav(int id) {
	local i=${YT[$id]["sel"]} kind vid title ch len

	if [ "${YT[$id]["view"]}" = play ]; then
		kind=video
		vid=${YT[$id]["vid"]}
		title=${YT[$id]["title"]}
		ch=${YT[$id]["author"]}
		len=${YT[$id]["len"]}
	else
		kind=${YR[$id][$i]["kind"]}
		vid=${YR[$id][$i]["id"]}
		title=${YR[$id][$i]["title"]}
		ch=${YR[$id][$i]["ch"]}
		len=${YR[$id][$i]["len"]}
	fi
	[ -n "$vid" ] || return 0
	if [ -n "${YTF["$vid"]}" ]; then
		unset YTF["$vid"]
		yt_fileput "$YT_FAVS" "$vid"
		dt_notep low "Taken out of the favourites: %s" "$title"
	else
		YTF["$vid"]=1
		yt_fileput "$YT_FAVS" "$vid" "$kind"$'\t'"$vid"$'\t'"$title"$'\t'"$ch"$'\t'"$len"
		dt_notep low "Kept as a favourite: %s" "$title"
	fi
	[ "${YT[$id]["kind"]}" = favourites ] && [ "${YT[$id]["view"]}" = list ] &&
		yt_load "$id" favourites "" "" 0
	return 0
}

# Which ids are favourites, for the star beside them.
declare -gA YTF
yt_favload() {
	local -a lines fl
	local l

	YTF=()
	[ -r "$YT_FAVS" ] || return 0
	mapfile -t lines < "$YT_FAVS"
	for l in "${lines[@]}"; do
		IFS=$'\t' read -ra fl <<< "$l"
		[ -n "${fl[1]}" ] && YTF["${fl[1]}"]=1
	done
	return 0
}

# Forget everything watched -- Control Panel's Clear History.
yt_histclear() {
	: > "$YT_HIST" 2> /dev/null
	dt_notep low "The YouTube history is empty"
}

# --- playing ------------------------------------------------------------

# Open an entry: play a video, show a playlist's or a channel's videos.
fn yt_choose(int id, int i) {
	case ${YR[$id][$i]["kind"]} in
	playlist) yt_load "$id" playlist "${YR[$id][$i]["id"]}" "${YR[$id][$i]["title"]}" ;;
	channel) yt_load "$id" channel "${YR[$id][$i]["id"]}" "${YR[$id][$i]["title"]}" ;;
	*) yt_play "$id" "$i" ;;
	esac
}

# Play a list's video: YouTube's watch page in the player tab, which the
# engine plays itself, or whose chunks go to a media player here (tap). A
# video left part way is taken up where it was.
fn yt_play(int id, int i) {
	local vid=${YR[$id][$i]["id"]} t p v a

	[ -n "$vid" ] || return 0
	yt_need "$id" || return 0
	yt_stop "$id"
	t := yt_tab "$id" pt || return 0
	p=$t
	if yt_tap; then
		# A fed media player, a pipe for the picture and one for the sound.
		p := media feed 2> /dev/null || { YT[$id]["err"]="The media module cannot play"; return 0; }
		v := media pipe "$p" video
		a := media pipe "$p" audio
		media fps "$p" "$YT_FPS"
		media detail "$p" "$YT_DETAIL"
		media volume "$p" "${YT[$id]["vol"]:-100}" > /dev/null
		YT[$id]["vfd"]=$v
		YT[$id]["afd"]=$a
	fi
	YT[$id]["p"]=$p
	YT[$id]["fed"]=
	YT[$id]["cur"]=$i
	YT[$id]["vid"]=$vid
	YT[$id]["title"]=${YR[$id][$i]["title"]}
	YT[$id]["author"]=${YR[$id][$i]["ch"]}
	YT[$id]["len"]=${YR[$id][$i]["len"]}
	YT[$id]["state"]=loading
	YT[$id]["since"]=$EPOCHSECONDS
	YT[$id]["sized"]=
	YT[$id]["view"]=play
	YT[$id]["err"]=
	YT[$id]["dur"]=0
	YT[$id]["lpos"]=0
	YT[$id]["tries"]=0
	YT[$id]["bad"]=0
	YT[$id]["chk"]=$EPOCHSECONDS
	YT[$id]["resume"]=
	YT[$id]["upause"]=
	YT[$id]["efr"]=
	YT[$id]["pat"]=
	YT[$id]["sat"]=
	YT[$id]["ofid"]=
	YT[$id]["noauto"]=
	YT[$id]["nan"]=0
	if yt_histget "$vid" && [ "${YTH[5]:-0}" -gt "$YT_RESUME" ]; then
		YT[$id]["resume"]=${YTH[5]}
	fi
	web go "$t" "$YT_BASE/watch?v=$vid" 2> /dev/null
}

# Stop playing, noting where it was left: the page left.
fn yt_stop(int id) {
	local p=${YT[$id]["p"]} t=${YT[$id]["pt"]}

	[ -n "$p" ] && [ "${YT[$id]["state"]}" = playing ] && yt_histput "$id"
	[ -n "$p" ] && yt_tap && media close "$p" 2> /dev/null
	[ -n "$t" ] && web go "$t" about:blank 2> /dev/null
	YT[$id]["p"]=
	YT[$id]["state"]=
}

# The next video in the list after the one playing, or before it: its
# index, skipping playlists and channels; fails at either end.
fn yt_step(int id, int dir) {
	local i=${YT[$id]["cur"]} n=${YT[$id]["n"]}

	while :; do
		i=$((i + dir))
		[ "$i" -ge 0 ] && [ "$i" -lt "$n" ] || return 1
		[ "${YR[$id][$i]["kind"]}" = video ] && { ret "$i"; return 0; }
	done
}

# Play the next video or the one before.
fn yt_next(int id, int dir) {
	local i

	i := yt_step "$id" "$dir" || { dt_notep low "No more in this list"; return 0; }
	YT[$id]["sel"]=$i
	yt_play "$id" "$i"
}

# Ask YouTube's player where it is, into YTP; at most five times a second,
# since a window is drawn more often than the clock moves.
declare -gA YTP
YTPID=
fn yt_page(int id) {
	local js now nv

	now=${EPOCHREALTIME/./}
	now=${now:0:-3}
	if [ "$YTPID" = "$id" ] && [ -n "${YT[$id]["pat"]}" ] && [ $((now - YT[$id]["pat"])) -lt 200 ] && [ -n "${YTP["st"]}" ]; then
		return 0
	fi
	js := web eval "${YT[$id]["pt"]}" "$YT_PJS" 2> /dev/null || return 1
	[ -n "$js" ] || return 1
	YTP=()
	json parse YTP <<< "$js" 2> /dev/null || return 1
	# The page asked is the video's own: right after a go the one before is
	# still there, and what it says is about another video.
	case ${YTP["u"]} in
	*"v=${YT[$id]["vid"]}"*) YT[$id]["ofid"]= ;;
	*)
		# A page that stays on another video is YouTube moving on by itself, which
		# yt_tick follows rather than showing the old video's clock for ever.
		nv=${YTP["u"]#*v=}
		nv=${nv%%[&#]*}
		if [ "$nv" != "${YTP["u"]}" ] && [ -n "$nv" ] && [ "$nv" != "${YT[$id]["ofid"]}" ]; then
			YT[$id]["ofid"]=$nv
			YT[$id]["ofat"]=$EPOCHSECONDS
		fi
		YTP=()
		return 1 ;;
	esac
	YT[$id]["pat"]=$now
	YTPID=$id
	YT[$id]["lpos"]=${YTP["t"]}
	return 0
}

# What the player reports, into YTI: the position and length, paused or
# ended, the volume, and a count of the frames it has shown. What was last
# known stands where the page cannot answer, as at the very start.
declare -gA YTI
fn yt_info(int id) {
	local i

	YTI["pos"]=${YT[$id]["lpos"]:-0}
	YTI["dur"]=${YT[$id]["dur"]:-0}
	YTI["paused"]=0
	YTI["ended"]=0
	YTI["volume"]=${YT[$id]["vol"]:-100}
	YTI["shown"]=${YT[$id]["lshown"]:-0}
	YTI["drawn"]=${YT[$id]["md"]:-cells}
	if yt_tap && [ -n "${YT[$id]["p"]}" ]; then
		# The media player is the clock here, not the page.
		i := media info "${YT[$id]["p"]}" 2> /dev/null || return 0
		YTI["pos"]=${i["pos"]}
		YTI["dur"]=${i["dur"]}
		YTI["paused"]=${i["paused"]}
		YTI["ended"]=${i["ended"]}
		YTI["volume"]=${i["volume"]}
		YTI["shown"]=${i["shown"]}
		YTI["drawn"]=${i["drawn"]}
		return 0
	fi
	[ -n "${YT[$id]["pt"]}" ] || return 0
	yt_page "$id" || return 0
	YTI["pos"]=${YTP["t"]}
	YTI["paused"]=${YTP["pa"]:-0}
	YTI["ended"]=${YTP["en"]:-0}
	YTI["shown"]=${YTP["fr"]:-0}
	YT[$id]["lshown"]=${YTP["fr"]:-0}
	return 0
}

# YouTube's own autoplay is the app's to do (Play Next Automatically): left on, the
# page goes to its choice of next video by itself, whatever the setting says, and
# with the setting on as well the two would both move. Its switch is turned off
# once the player's controls are there, asked each second until they are.
#
# This one names YouTube's own class for the switch: there is no way to find it
# by structure, as the rest of the page is cut. If the name changes the switch
# is never found, so the asking stops after thirty tries, and yt_adopt follows
# the page when it moves on anyway.
fn yt_noauto(int id) {
	local s

	[ -n "${YT[$id]["noauto"]}" ] && return 0
	[ "${YT[$id]["nat"]:-0}" = "$EPOCHSECONDS" ] && return 0
	YT[$id]["nat"]=$EPOCHSECONDS
	YT[$id]["nan"]=$(( ${YT[$id]["nan"]:-0} + 1 ))
	[ "${YT[$id]["nan"]}" -gt 30 ] && { YT[$id]["noauto"]=1; return 0; }
	s := web eval "${YT[$id]["pt"]}" '(function(){var a=document.querySelector(".ytp-autonav-toggle-button");if(!a)return "none";if(a.getAttribute("aria-checked")==="true"){a.click();return "clicked"}return "off"})()' 2> /dev/null
	[ "$s" = off ] && YT[$id]["noauto"]=1
	return 0
}

# Follow the page to a video it went to by itself: the title, the length and the
# clock are asked of it again, and the player is started the way it is for any.
fn yt_adopt(int id, vid) {
	printf 'youtube: the page moved on by itself to %s; following it\n' "$vid" >&2
	YT[$id]["vid"]=$vid
	YT[$id]["title"]=
	YT[$id]["author"]=
	YT[$id]["len"]=
	YT[$id]["dur"]=0
	YT[$id]["lpos"]=0
	YT[$id]["tries"]=0
	YT[$id]["bad"]=0
	YT[$id]["resume"]=
	YT[$id]["upause"]=
	YT[$id]["efr"]=
	YT[$id]["pat"]=
	YT[$id]["sat"]=
	YT[$id]["ofid"]=
	YT[$id]["noauto"]=
	YT[$id]["nan"]=0
	YT[$id]["fed"]=
	YT[$id]["sized"]=
	YT[$id]["err"]=
	YT[$id]["state"]=loading
	YT[$id]["since"]=$EPOCHSECONDS
}

# One step of playing: start the page's player once it is there, take up a
# video where it was left, and at the end go on to the next.
fn yt_tick(int id) {
	local t=${YT[$id]["pt"]} p=${YT[$id]["p"]} s js m i e ms tm
	local -a w

	[ -n "$p" ] || return 0
	# An ended video is not asked about, so the page leaving it would go unseen: its
	# address is looked at every few seconds.
	if [ "${YT[$id]["state"]}" = ended ] && [ $((EPOCHSECONDS - ${YT[$id]["chk"]:-0})) -ge 3 ]; then
		YT[$id]["chk"]=$EPOCHSECONDS
		yt_page "$id" > /dev/null
	fi
	# The page went on to another video by itself, and stayed: this is that video
	# now, the clock and the title with it.
	if [ -n "${YT[$id]["ofid"]}" ] && [ $((EPOCHSECONDS - YT[$id]["ofat"])) -ge 3 ] &&
	   [ $((EPOCHSECONDS - YT[$id]["since"])) -ge 8 ]; then
		yt_adopt "$id" "${YT[$id]["ofid"]}"
		return 0
	fi
	[ "${YT[$id]["state"]}" = playing ] && yt_noauto "$id"
	if [ "${YT[$id]["state"]}" = loading ]; then
		if yt_tap; then
			js := yt_startjs_tap "$YT_QUALITY" "$(yt_ccword)"
		else
			js := yt_startjs "$YT_QUALITY" "${YT[$id]["vol"]:-100}" "${YT[$id]["vid"]}" "$(yt_ccword)"
		fi
		s := web eval "$t" "$js" 2> /dev/null
		if [ "$s" = ok ]; then
			YT[$id]["state"]=playing
			YT[$id]["sat"]=${EPOCHREALTIME/./}
			YT[$id]["sat"]=${YT[$id]["sat"]:0:-3}
		fi
		if [ "${YT[$id]["state"]}" = loading ] &&
		   [ $((EPOCHSECONDS - YT[$id]["since"])) -gt 25 ]; then
			if [ "${YT[$id]["tries"]:-0}" -ge 3 ]; then
				YT[$id]["err"]="YouTube's player did not start"
				yt_stop "$id"
			else
				yt_recover "$id" 0
			fi
			return 0
		fi
		dt_want 300
	fi
	if yt_tap; then
		# Carry what the page has fetched down the pipes. A new media source
		# -- a reset, at the start and at an ad -- is kept up with by starting
		# ours again from where the page is; none of that stream's own init
		# segments has been taken yet, which a seek needs, so "fed" goes back
		# to empty with it.
		s := web take "$t" "${YT[$id]["vfd"]}" "${YT[$id]["afd"]}" 2> /dev/null
		read -ra w <<< "$s"
		if [ "${w[5]}" = 1 ]; then
			YT[$id]["fed"]=
			tm=0
			yt_page "$id" && tm=${YTP["t"]}
			media seek "$p" "$tm"
		elif [ "${w[1]:-0}" -gt 0 ] || [ "${w[3]:-0}" -gt 0 ]; then
			YT[$id]["fed"]=1
		fi
	fi
	if [ "${YT[$id]["dur"]%.*}" = 0 ] && yt_page "$id"; then
		YT[$id]["dur"]=${YTP["d"]}
		[ -n "${YTP["title"]}" ] && YT[$id]["title"]=${YTP["title"]}
		[ -n "${YTP["author"]}" ] && YT[$id]["author"]=${YTP["author"]}
		if [ -z "${YT[$id]["len"]}" ] && [ "${YT[$id]["dur"]%.*}" -gt 0 ]; then
			YT[$id]["len"] := yt_mmss "${YT[$id]["dur"]}"
		fi
	fi
	# Taking a video up where it was left waits for the player to know its
	# length and to hold some of the video: before that there is nothing to
	# go to (yt_held).
	if [ -n "${YT[$id]["resume"]}" ] && [ "${YT[$id]["state"]}" = playing ] &&
	   yt_held "$id"; then
		m := yt_mmss "${YT[$id]["resume"]}"
		yt_seek "$id" "${YT[$id]["resume"]}"
		YT[$id]["resume"]=
		dt_notep low "Taken up at %s, where it was left" "$m"
	fi
	if [ "${YT[$id]["state"]}" = playing ] &&
	   [ $((EPOCHSECONDS - ${YT[$id]["chk"]:-0})) -ge 3 ]; then
		YT[$id]["chk"]=$EPOCHSECONDS
		yt_watch "$id"
		[ "${YT[$id]["state"]}" = playing ] || return 0
	fi
	if [ "${YT[$id]["state"]}" = playing ]; then
		yt_info "$id"
		m=${YT[$id]["dur"]%.*}
		# Ended: the page says so, or the clock is within a second of the
		# length and no frame has come for two.
		e=0
		[ "${YTI["ended"]}" = 1 ] && e=1
		if yt_tap; then
			# The media player's own clock: at the length is the end.
			[ "${m:-0}" -gt 0 ] && [ "${YTI["pos"]%.*}" -ge "$m" ] && e=1
		elif [ "$e" = 0 ] && [ "${m:-0}" -gt 0 ] && [ "${YTI["pos"]%.*}" -ge $((m - 1)) ]; then
			if [ "${YTI["shown"]}" != "${YT[$id]["efr"]}" ]; then
				YT[$id]["efr"]=${YTI["shown"]}
				YT[$id]["eat"]=$EPOCHSECONDS
			elif [ $((EPOCHSECONDS - ${YT[$id]["eat"]:-$EPOCHSECONDS})) -ge 2 ]; then
				e=1
			fi
		fi
		if [ "$e" = 1 ]; then
			yt_histput "$id" "${YT[$id]["dur"]}"
			YT[$id]["state"]=ended
			if [ "$YT_AUTONEXT" = 1 ] && i := yt_step "$id" 1; then
				YT[$id]["sel"]=$i
				yt_play "$id" "$i"
				return 0
			fi
		fi
	fi
	if yt_tap; then
		# When the media player next wants something from us.
		ms := media next "$p" 2> /dev/null
		[ -n "$ms" ] && [ "$ms" -ge 0 ] && dt_want "$ms"
	else
		dt_want 250
	fi
}

# Whether the player holds enough of the video to be taken to a time: it
# knows its length and, with a tap, the start of each stream has been taken
# (a seek asks the tap to queue each init segment again, and it can only queue
# back one it has seen -- asked before, nothing ever decodes); with the engine
# playing it, some of the video is buffered. (Gitea #135.)
fn yt_held(int id) {
	if yt_tap; then
		[ -n "${YT[$id]["fed"]}" ] && [ "${YT[$id]["dur"]%.*}" -gt 0 ]
	else
		[ "${YT[$id]["dur"]%.*}" -gt 0 ] && yt_page "$id" && [ "${YTP["rs"]:-0}" -ge 3 ]
	fi
}

# Every few seconds while playing: whether YouTube's own player is still
# going. It can stop -- its "Something went wrong", or back to unstarted --
# and then nothing more plays. Unstarted twice running, or its error once,
# and the video is loaded again and taken up where it was.
fn yt_watch(int id) {
	# Paused by the viewer is not stopped: the page pausing itself, as it
	# does when it gives up, is.
	[ -n "${YT[$id]["upause"]}" ] && return 0
	yt_info "$id"
	yt_page "$id" || return 0
	if [ "${YTP["e"]}" = 1 ]; then
		yt_recover "$id" "${YTI["pos"]%.*}"
	elif [ "${YTP["pa"]}" = 1 ] && [ "${YTP["en"]}" != 1 ] && [ "${YTI["pos"]%.*}" -le 3 ]; then
		# Paused at the very start, and nobody here paused it: a play() the
		# page turned down before it had anything to play. Asked again.
		web eval "${YT[$id]["pt"]}" 'document.getElementById("movie_player").playVideo()' > /dev/null 2>&1
		YT[$id]["pat"]=
	elif [ "${YTP["st"]}" = -1 ] && [ "${YTI["pos"]%.*}" -gt 3 ]; then
		YT[$id]["bad"]=$(( ${YT[$id]["bad"]:-0} + 1 ))
		[ "${YT[$id]["bad"]}" -ge 2 ] && yt_recover "$id" "${YTI["pos"]%.*}"
	else
		YT[$id]["bad"]=0
	fi
	return 0
}

# Load the video again and take it up at a time, after YouTube's player
# stopped or never started; after three tries it says so instead.
fn yt_recover(int id, int pos) {
	local m n=${YT[$id]["tries"]:-0} why="stopped"

	YT[$id]["bad"]=0
	if [ "$n" -ge 3 ]; then
		YT[$id]["err"]="YouTube's player keeps stopping on this video"
		yt_stop "$id"
		return 0
	fi
	YT[$id]["tries"]=$((n + 1))
	m := yt_mmss "$pos"
	[ "${YT[$id]["state"]}" = loading ] && why="did not start"
	printf 'youtube: the page %s %s at %s; loading it again\n' "$why" \
		"${YT[$id]["vid"]}" "$m" >&2
	if [ "$pos" -gt 0 ]; then
		dt_notep low "YouTube stopped -- picking up again at %s" "$m"
		YT[$id]["resume"]=$pos
	else
		dt_notep low "YouTube did not answer -- trying again"
	fi
	YT[$id]["state"]=loading
	YT[$id]["since"]=$EPOCHSECONDS
	YT[$id]["pat"]=
	YT[$id]["noauto"]=
	YT[$id]["nan"]=0
	YT[$id]["ofid"]=
	web go "${YT[$id]["pt"]}" "$YT_BASE/watch?v=${YT[$id]["vid"]}" 2> /dev/null
}

# Pause or play, in YouTube's player -- and in ours, where the video is played
# here, so the page fetches only as we go.
fn yt_toggle(int id) {
	local p=${YT[$id]["p"]} t=${YT[$id]["pt"]}

	[ -n "$p" ] || return 0
	YT[$id]["pat"]=
	yt_info "$id"
	if [ "${YTI["paused"]}" = 1 ]; then
		YT[$id]["upause"]=
		yt_tap && media play "$p"
		web eval "$t" 'document.getElementById("movie_player").playVideo()' > /dev/null 2>&1
	else
		YT[$id]["upause"]=1
		yt_tap && media pause "$p"
		web eval "$t" 'document.getElementById("movie_player").pauseVideo()' > /dev/null 2>&1
		yt_histput "$id"
	fi
	YT[$id]["pat"]=
}

# Go to a time: YouTube's player sent there.
fn yt_seek(int id, to) {
	local p=${YT[$id]["p"]} t=${YT[$id]["pt"]} d

	[ -n "$p" ] || return 0
	YT[$id]["pat"]=
	yt_info "$id"
	case $to in
	+* | -*) to=$(( ${YTI["pos"]%.*} + to )) ;;
	esac
	d=${YT[$id]["dur"]%.*}
	[ "$to" -lt 0 ] && to=0
	[ "$d" -gt 0 ] && [ "$to" -gt "$d" ] && to=$d
	if yt_tap; then
		# Ours dropped and started again, the tap given the start of each
		# stream again.
		media seek "$p" "$to"
		web tapseek "$t" > /dev/null 2>&1
	fi
	web eval "$t" "document.getElementById(\"movie_player\").seekTo($to,true)" > /dev/null 2>&1
	YT[$id]["pat"]=
}

# --- the window -----------------------------------------------------------

fn youtube_open(int id, arg = "") {
	YT[$id]["view"]=list
	YT[$id]["kind"]=
	YT[$id]["arg"]=
	YT[$id]["head"]=
	YT[$id]["stack"]=
	YT[$id]["q"]=
	dt_searchclear "$id"
	dt_searchopen "$id"
	YT[$id]["n"]=0
	YT[$id]["sel"]=0
	YT[$id]["top"]=0
	YT[$id]["vol"]=100
	YT[$id]["st"]=
	YT[$id]["pt"]=
	YT[$id]["p"]=
	YT[$id]["err"]=
	yt_favload
	yt_need "$id" || return 0
	if [ -n "$arg" ]; then
		dt_searchset "$id" "$arg"
		yt_search "$id" "$arg"
	fi
	return 0
}

fn youtube_find(int id) {
	dt_searchopen "$id"
	return 0
}

fn youtube_close(int id) {
	local t

	yt_minikeep "$id"
	yt_stop "$id"
	for t in "${YT[$id]["st"]}" "${YT[$id]["pt"]}"; do
		[ -n "$t" ] && web close "$t" 2> /dev/null
	done
	unset "YT[$id]"
	unset "YR[$id]"
	yt_webquit "$id"
}

# Stop Chromium when no window that uses it is left -- the Browser's or
# ours -- so one closing never takes the other's pages with it.
fn yt_webquit(int id) {
	local o ids
	local -a il

	ids := dt_ids
	read -ra il <<< "$ids"
	for o in "${il[@]}"; do
		[ "$o" = "$id" ] && continue
		case ${DT[$o]["app"]} in browser | youtube) return 0 ;; esac
	done
	web quit 2> /dev/null
	return 0
}

# After a restart the list is shown again; what was playing is noted in
# the history first, so choosing it again takes it up there.
fn youtube_stash(int id, dir) {
	yt_histput "$id"
	YT[$id]["st"]=
	YT[$id]["pt"]=
	YT[$id]["p"]=
}

fn youtube_resume(int id) {
	local k=${YT[$id]["kind"]} a=${YT[$id]["arg"]} h=${YT[$id]["head"]}

	[ "${YT[$id]["mini"]}" = 1 ] && yt_mini "$id"
	[ "${DT[$id]["chrome"]}" = none ] && DT[$id]["chrome"]=

	YT[$id]["view"]=list
	YT[$id]["st"]=
	YT[$id]["pt"]=
	YT[$id]["p"]=
	YT[$id]["state"]=
	yt_favload
	[ "$k" = video ] && k=
	[ -n "$k" ] && yt_load "$id" "$k" "$a" "$h" 0
	return 0
}

# A window not drawn still carries what the page fetches, or the pipes and
# the page would fall behind; it is drawn again when it is seen.
# Whether this window is keeping the screen awake, with Control Panel >
# YouTube's Keep the Screen Saver Away While Playing on (Gitea #277): the
# picture is moving -- not paused, and the frame on screen a later one than
# when the desktop last asked -- in a window that is not minimised. Not the
# position, which runs on past a stream's end with no frames in it: a
# twelve-second clip read 0:29. The desktop asks only at
# the moment its screen saver would start. The first version asked what
# state the app thought it was in, and a real stream can put that wrong
# while the picture plays on -- an ad's length taken for the video's, a
# reset -- so the saver came over a video being watched (Gitea #299).
# Whether the clock moved is the one thing that cannot be mistaken.
fn youtube_awake(int id) {
	local was

	[ "${YT_SAVERHOLD:-1}" = 1 ] || return 1
	dt_hidden "$id" && return 1
	# Loading is still watching: the start of a video, the next one in a
	# list, or the page's player being brought back after it gave up.
	[ "${YT[$id]["state"]}" = loading ] && return 0
	[ -n "${YT[$id]["p"]}" ] || return 1
	yt_info "$id"
	[ "${YTI["paused"]}" = 1 ] && return 1
	was=${YT[$id]["awshown"]}
	YT[$id]["awshown"]=${YTI["shown"]}
	[ "${YTI["shown"]}" != "$was" ]
}

fn youtube_idle(int id) {
	[ "${YT[$id]["view"]}" = play ] && yt_tick "$id"
	return 0
}

fn youtube_draw(int id, int h, int w, int row, int col) {
	dt_wclear "$id"
	[ -n "${YT[$id]["searching"]}" ] && yt_results "$id"
	if [ "${YT[$id]["mini"]}" = 1 ]; then
		yt_drawmini "$id" "$h" "$w"
	elif [ "${YT[$id]["view"]}" = play ]; then
		yt_drawplay "$id" "$h" "$w"
	else
		yt_drawlist "$id" "$h" "$w"
	fi
}

# The list: the search field, a heading, then an entry to a row -- a
# star for a favourite, the title, the channel, the length or what kind
# of list it opens -- the chosen one lit.
fn yt_drawlist(int id, int h, int w) {
	local n=${YT[$id]["n"]} sel=${YT[$id]["sel"]} top=${YT[$id]["top"]}
	local r=2 i lab tail vis on=0 hd mk len star=${GL[star]} srows

	command -v dt_retitle > /dev/null && dt_retitle "$id" "YouTube"
	# The ` Search:` row is gone: the search is the desktop's one
	# search now (widgets/search.hibr), on this window's bottom row
	# and drawn only once `/` has asked for it.
	srows := dt_searchrows "$id"
	vis=$((h - 1 - srows))
	[ "$vis" -lt 1 ] && vis=1
	console pen "$DT_INK" "$DT_FACE"
	hd := yt_heading "$id"
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	if [ "$DT_MIRRORON" = 1 ]; then
		lab := dt_rpad "${hd:0:$((w - 3))}" $((w - 2))
		console put -p "w$id" 1 1 "$lab"
	else
		console put -p "w$id" 1 2 "${hd:0:$((w - 3))}"
	fi
	if [ -n "${YT[$id]["searching"]}" ]; then
		console pen "$DT_DIM" "$DT_FACE"
		console put -p "w$id" 2 2 "Looking${GL[ellipsis]}"
		n=0
	elif [ -n "${YT[$id]["err"]}" ]; then
		console pen "$DT_BAD" "$DT_FACE"
		console put -p "w$id" 2 2 "${YT[$id]["err"]:0:$((w - 3))}"
	elif [ "$n" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		dt_tput "$id" 2 2 "Type what to look for, or a playlist's or a channel's address, and enter."
	fi
	top := dt_scrollview "$top" "$n" "$vis" "$sel" "${YT[$id]["seen"]-}"
	YT[$id]["seen"]=$sel
	YT[$id]["top"]=$top
	YT[$id]["vis"]=$vis
	i=$top
	while [ "$i" -lt "$n" ] && [ "$r" -lt "$h" ]; do
		len=${YR[$id][$i]["len"]}
		case ${YR[$id][$i]["kind"]} in
		playlist) len="playlist${len:+, $len}" ;;
		channel) len="channel" ;;
		esac
		tail="  ${YR[$id][$i]["ch"]:0:18}  $len"
		mk=" "
		[ -n "${YTF["${YR[$id][$i]["id"]}"]}" ] && mk=$star
		lab="$mk${YR[$id][$i]["title"]}"
		[ $((${#lab} + ${#tail})) -gt "$w" ] && lab="${lab:0:$((w - ${#tail} - 1))}${GL[ellipsis]}"
		if [ "$DT_MIRRORON" = 1 ]; then
			lab="${lab#"$mk"}$mk"
			lab := dt_rpad "$lab" $((w - ${#tail}))
			tail="$len  ${YR[$id][$i]["ch"]:0:18}  "
			lab="$tail$lab"
			tail=
		else
			lab := str pad "$lab" $((w - ${#tail}))
		fi
		if [ "$i" = "$sel" ] && ! dt_searchon "$id"; then
			console pen "$DT_SELINK" "$DT_ACTIVE" bold
		elif [ "$i" = "$sel" ]; then
			console pen "$DT_INK" "$DT_WELL"
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" 1 "$lab$tail"
		dt_wreg "$id" "$r" 1 "$w" "row:$i"
		r=$((r + 1))
		i=$((i + 1))
	done
	r=$w
	[ "$DT_MIRRORON" = 1 ] && r=1
	dt_scrollbar "$id" 2 "$r" "$vis" "$n" "$vis" "$top" list
	dt_searchdraw "$id" "$h" "$w"
}

# Minutes and seconds, with hours in front of an hour or more.
fn yt_mmss(t) {
	local s=${t%.*} out

	[ -n "$s" ] || s=0
	if [ "$s" -ge 3600 ]; then
		printf -v out '%d:%02d:%02d' $((s / 3600)) $((s / 60 % 60)) $((s % 60))
	else
		printf -v out '%d:%02d' $((s / 60)) $((s % 60))
	fi
	ret "$out"
}

# The page in the player's tab, drawn into the window from a row and column: laid out
# at the window's size and drawn as pixels where the display takes them,
# else as cells, or as characters for ascii and mono. A display that
# declines the pixels is found out by the draw failing while the video
# plays; the picture then goes on as cells, and says so (YT[md]). Fails
# until the page has made a frame.
# Whether the page must not be shown yet: loading, or just now started.
fn yt_veiled(int id) {
	local now

	[ "${YT[$id]["state"]}" = loading ] && return 0
	[ -n "${YT[$id]["sat"]}" ] || return 1
	now=${EPOCHREALTIME/./}
	now=${now:0:-3}
	[ $((now - YT[$id]["sat"])) -lt 500 ]
}

fn yt_picture(int id, w, h, row, col, md) {
	local t=${YT[$id]["pt"]} m=cells p=${YT[$id]["p"]}

	[ -n "$t" ] || return 1
	if yt_tap; then
		# The media player draws it: sized, a frame taken, drawn.
		[ -n "$p" ] || return 1
		if [ "${YT[$id]["sized"]}" != "$w $h $md" ]; then
			media size "$p" "$w" "$h" "$md"
			YT[$id]["sized"]="$w $h $md"
		fi
		media frame "$p"
		media draw "$p" "$row" "$col" -p "w$id" 2> /dev/null
		return
	fi
	# Not the page itself: until the start has cut it down to the video it is
	# the real site, masthead and all, filling the window -- and for a moment
	# after, while the engine paints what the cut left. Said Loading instead.
	yt_veiled "$id" && return 1
	case $md in
	pixels | ascii | mono) m=$md ;;
	esac
	[ "$m" = pixels ] && [ "${YT[$id]["decl"]}" = "$w $h" ] && m=cells
	if [ "${YT[$id]["sized"]}" != "$w $h $m" ]; then
		web size "$t" "$h" "$w" 2> /dev/null
		web mode "$t" "$m" 2> /dev/null
		YT[$id]["sized"]="$w $h $m"
		YT[$id]["md"]=$m
		YT[$id]["pfail"]=0
	fi
	web render "$t" 2> /dev/null || return 1
	if web draw "$t" "$row" "$col" -p "w$id" 2> /dev/null; then
		YT[$id]["pfail"]=0
		return 0
	fi
	if [ "$m" = pixels ] && [ "${YT[$id]["state"]}" = playing ]; then
		YT[$id]["pfail"]=$(( ${YT[$id]["pfail"]:-0} + 1 ))
		if [ "${YT[$id]["pfail"]}" -ge 3 ]; then
			YT[$id]["decl"]="$w $h"
			YT[$id]["sized"]=
		fi
	fi
	return 1
}

# The player: the title, the picture, the bar, the keys.
# The captions as text over the picture's bottom rows, at most two lines of
# what the player is showing now, wrapped to the window and centred.
fn yt_drawcc(int id, int h, int w) {
	local t=${YTP["cc"]} n=$((w - 6)) r=$((h - 1)) l1 l2=""

	[ "$YTPID" = "$id" ] || return 0
	[ -n "$t" ] || return 0
	[ "$n" -ge 10 ] || return 0
	if [ "${#t}" -le "$n" ]; then
		l1=$t
	elif [ "${#t}" -le $((n * 2)) ]; then
		l1=${t:0:$n}
		l2=${t:$n}
	else
		# more than two lines: the end is what is being said now
		l1=${t: -$((n * 2)):$n}
		l2=${t: -$n}
	fi
	console pen "$DT_INK" "$DT_WELL" bold
	if [ -n "$l2" ]; then
		console put -p "w$id" $((r - 1)) $(( (w - ${#l1}) / 2 )) " $l1 "
		console put -p "w$id" "$r" $(( (w - ${#l2}) / 2 )) " $l2 "
	else
		console put -p "w$id" "$r" $(( (w - ${#l1}) / 2 )) " $l1 "
	fi
}

fn yt_drawplay(int id, int h, int w) {
	local p=${YT[$id]["p"]} ph=$((h - 2)) pos dur lab fill st a b mk="" md pm l

	# a step first, so the title and the clock drawn are this moment's
	[ -n "$p" ] && yt_tick "$id"
	p=${YT[$id]["p"]}
	if command -v dt_retitle > /dev/null; then
		local wt
		wt := dt_wintitle YouTube "${YT[$id]["title"]:0:40}"
		dt_retitle "$id" "$wt"
	fi
	console pen "$DT_INK" "$DT_FACE" bold
	[ -n "${YTF["${YT[$id]["vid"]}"]}" ] && mk="${GL[star]} "
	lab="$mk${YT[$id]["title"]}"
	[ -n "${YT[$id]["author"]}" ] && lab="$lab -- ${YT[$id]["author"]}"
	lab := str pad " ${lab:0:$((w - 2))}" "$w"
	console put -p "w$id" 1 1 "$lab"
	if [ -n "${YT[$id]["err"]}" ] || [ -z "$p" ]; then
		console pen "$DT_BAD" "$DT_FACE"
		console put -p "w$id" 3 2 "${YT[$id]["err"]:-Stopped.}"
		return 0
	fi
	[ -n "$p" ] || return 0
	md := yt_drawmode
	if ! yt_picture "$id" "$w" "$ph" 2 1 "$md"; then
		console pen "$DT_DIM" "$DT_FACE"
		console put -p "w$id" 3 2 "Loading${GL[ellipsis]}"
	fi
	yt_info "$id"
	[ "$YT_CAPTIONS" = 1 ] && yt_drawcc "$id" "$h" "$w"
	pos=${YTI["pos"]}
	dur=${YT[$id]["dur"]}
	[ "${YT[$id]["state"]}" = ended ] && pos=$dur
	[ "${dur%.*}" -gt 0 ] 2> /dev/null || dur=${YTI["dur"]}
	a := yt_mmss "$pos"
	b := yt_mmss "$dur"
	st="playing"
	[ "${YTI["paused"]}" = 1 ] && st="paused"
	[ "${YTI["ended"]}" = 1 ] || [ "${YT[$id]["state"]}" = ended ] && st="ended"
	[ "${YT[$id]["state"]}" = loading ] && st="starting"
	# What is drawn, and -- when it is following Control Panel > Pictures
	# -- that it is following rather than set: a bar that said only "half"
	# would not change when the key moved the setting from follow to half.
	pm=$md
	[ "$YT_MODE" = follow ] && pm="follow:$md"
	# And when pixels were wanted and are not what is being drawn, why.
	# `pixels` and `follow` both resolve through dt_imgpix -- can this
	# display place a bitmap at all -- and when it cannot the player just
	# drew blocks and said nothing, which reads as the player ignoring
	# the setting rather than the terminal not offering one (Gitea #199).
	[ "$md" != pixels ] && [ "$YT_MODE" = pixels -o "$YT_MODE" = follow ] &&
		case $DT_IMGMODE in
		half | ascii | mono) ;;
		*) pm="$pm, no pixels here" ;;
		esac
	# `md` is what was *asked for*, and the pixel path falls through to
	# cells on its own whenever the display declines -- it has no answer
	# about pictures yet, the terminal draws none, or the frame does not
	# fit the rectangle it is clipped to. The bar said `pixels` over a
	# screen full of blocks, which is a report of an intention dressed
	# as a fact, and it is why this has been unresolvable from outside:
	# the one reading anybody could take could not tell the four layers
	# apart. `media info`'s own `drawn` says what happened (#199).
	[ "$md" = pixels ] && [ "${YTI["drawn"]}" = cells ] &&
		pm="$pm (drawn as blocks: the display declined)"
	l := yt_qlab "$YT_QUALITY"
	lab=" $a / $b  $st  vol ${YTI["volume"]}  $l  ${pm}"
	fill=0
	[ "${dur%.*}" -gt 0 ] 2> /dev/null && fill=$(( ${pos%.*} * w / ${dur%.*} ))
	[ "$fill" -gt "$w" ] && fill=$w
	lab := str pad "$lab" "$w"
	console pen "$DT_SELINK" "$DT_ACTIVE"
	[ "$fill" -gt 0 ] && console put -p "w$id" "$h" 1 "${lab:0:$fill}"
	console pen "$DT_INK" "$DT_WELL"
	console put -p "w$id" "$h" $((fill + 1)) "${lab:$fill}"
	dt_wreg "$id" "$h" 1 "$w" bar
}

fn youtube_key(int id, key) {
	local r n=${YT[$id]["n"]} sel=${YT[$id]["sel"]} p=${YT[$id]["p"]} v k
	local q0

	if [ "${YT[$id]["view"]}" = play ]; then
		case $key in
		" ") yt_toggle "$id"; return 0 ;;
		i) yt_mini "$id"; return 0 ;;
		left) yt_seek "$id" -5; return 0 ;;
		right) yt_seek "$id" +5; return 0 ;;
		shift-left) yt_seek "$id" -30; return 0 ;;
		shift-right) yt_seek "$id" +30; return 0 ;;
		up | down)
			[ -n "$p" ] || return 0
			yt_info "$id"
			v=${YTI["volume"]}
			[ "$key" = up ] && v=$((v + 10)) || v=$((v - 10))
			[ "$v" -gt 100 ] && v=100
			[ "$v" -lt 0 ] && v=0
			if yt_tap; then
				media volume "${YT[$id]["p"]}" "$v" > /dev/null
			else
				web eval "${YT[$id]["pt"]}" "(function(){var p=document.getElementById(\"movie_player\");if(p&&p.setVolume)p.setVolume($v);var e=document.querySelector(\"video\");if(e)e.volume=$v/100})()" > /dev/null 2>&1
			fi
			YT[$id]["vol"]=$v
			YT[$id]["pat"]=
			return 0
			;;
		n) yt_next "$id" 1; return 0 ;;
		p) yt_next "$id" -1; return 0 ;;
		f) yt_fav "$id"; return 0 ;;
		m) yt_mode; return 0 ;;
		c) yt_captions "$id"; return 0 ;;
		q) yt_quality "$id"; return 0 ;;
		h) yt_load "$id" history ""; return 0 ;;
		v) yt_load "$id" favourites ""; return 0 ;;
		escape | backspace)
			if [ "${YT[$id]["mini"]}" = 1 ]; then
				yt_mini "$id"
				return 0
			fi
			yt_stop "$id"
			YT[$id]["view"]=list
			return 0
			;;
		esac
		return 1
	fi
	# YouTube asks a server, so like Mail it acts when the bar is
	# **left** rather than on every keystroke: enter searches.
	if dt_searchon "$id" && [ "$key" = enter ]; then
		q0 := dt_searchq "$id"
		dt_searchshut "$id"
		yt_search "$id" "$q0"
		return 0
	fi
	if dt_searchkey "$id" "$key"; then
		return 0
	fi
	case $key in
	up) [ "$sel" -gt 0 ] && YT[$id]["sel"]=$((sel - 1)) || dt_searchopen "$id" ;;
	down) [ "$sel" -lt $((n - 1)) ] && YT[$id]["sel"]=$((sel + 1)) ;;
	pageup) sel=$((sel - ${YT[$id]["vis"]:-10})); [ "$sel" -lt 0 ] && sel=0; YT[$id]["sel"]=$sel ;;
	pagedown) sel=$((sel + ${YT[$id]["vis"]:-10})); [ "$sel" -ge "$n" ] && sel=$((n - 1)); YT[$id]["sel"]=$sel ;;
	home) YT[$id]["sel"]=0 ;;
	end) YT[$id]["sel"]=$((n > 0 ? n - 1 : 0)) ;;
	enter) [ "$n" -gt 0 ] && yt_choose "$id" "$sel" ;;
	f) [ "$n" -gt 0 ] && yt_fav "$id" ;;
	h) yt_load "$id" history "" ;;
	v) yt_load "$id" favourites "" ;;
	escape | backspace) yt_back "$id" ;;
	tab) dt_searchopen "$id" ;;
	*) return 1 ;;
	esac
	return 0
}

# The next way of drawing the picture, for every window: through the list
# the menu offers rather than a second one written out here, which is how
# `pixels` was missing from this key for a release.
yt_mode() {
	local i=0 n=${#YT_MODES[@]}

	while [ "$i" -lt "$n" ]; do
		if [ "${YT_MODES[$i]}" = "$YT_MODE" ]; then
			YT_MODE=${YT_MODES[$(( (i + 1) % n ))]}
			break
		fi
		i=$((i + 1))
	done
	[ "$i" -lt "$n" ] || YT_MODE=${YT_MODES[0]}
	command -v dt_save > /dev/null && dt_save
}

# What media is actually given. YT_MODE says outright unless it is `follow`,
# and then it is Control Panel > Pictures -- the one setting meant to reach
# every picture the desktop draws (ADR 0037). `auto` there means pixels
# where the terminal can place them and blocks where it cannot, which is
# dt_imgpix's question; media has no `auto` of its own, so it is answered
# here rather than passed on.
fn yt_drawmode() {
	local m=$YT_MODE

	[ "$m" = follow ] && m=${DT_IMGMODE:-auto}
	case $m in
	pixels | sixel) ret pixels ;;
	half | mono | ascii) ret "$m" ;;
	esac
	command -v dt_imgpix > /dev/null && dt_imgpix && ret pixels
	ret half
}

fn youtube_click(int id, int r, int c, btn = "") {
	local tag d

	if [ "${YT[$id]["mini"]}" = 1 ]; then
		[ "$btn" = double ] && yt_mini "$id"
		return 0
	fi
	tag := dt_hit "$id" "$r" "$c"
	if [ "${YT[$id]["view"]}" = play ] && [ -z "$tag" ] && dt_has dt_isdbl && dt_isdbl "$id"; then
		yt_toggle "$id"
		yt_mini "$id"
		return 0
	fi
	case $tag in
	dtsearch) dt_searchopen "$id" ;;
	row:*)
		if [ "${YT[$id]["sel"]}" = "${tag#row:}" ] && ! dt_searchon "$id"; then
			yt_choose "$id" "${tag#row:}"
		else
			YT[$id]["sel"]=${tag#row:}
			dt_searchshut "$id"
		fi
		;;
	bar)
		d=${YT[$id]["dur"]%.*}
		[ "$d" -gt 0 ] 2> /dev/null && yt_seek "$id" $(( (c - 1) * d / ${DT[$id]["w"]} ))
		;;
	*) [ "${YT[$id]["view"]}" = play ] && yt_toggle "$id" ;;
	esac
	return 0
}

fn youtube_wheel(int id, dir, int r = 0, int c = 0) {
	local n=${YT[$id]["n"]:-0} top

	if [ "${YT[$id]["view"]}" = play ]; then
		[ "$dir" = up ] && yt_seek "$id" +5 || yt_seek "$id" -5
		return 0
	fi
	top := dt_scrollmove "$dir" "${YT[$id]["top"]:-0}" "$n" \
		"${YT[$id]["vis"]:-1}" "$DT_SCROLLWHEEL" || return 1
	YT[$id]["top"]=$top
	return 0
}

# The list's scrollbar held and dragged (Gitea #298).
fn youtube_scroll(int id, key, int top) { YT[$id]["top"]=$top; }

# The address of what is chosen or playing, or the search being typed.
fn youtube_copy(int id) {
	local i=${YT[$id]["sel"]}

	if dt_searchon "$id"; then
		i := dt_searchq "$id"
		ret "$i"
		return 0
	fi
	if [ "${YT[$id]["view"]}" = play ] && [ -n "${YT[$id]["vid"]}" ]; then
		ret "$YT_BASE/watch?v=${YT[$id]["vid"]}"
		return 0
	fi
	[ -n "${YR[$id][$i]["id"]}" ] || return 1
	case ${YR[$id][$i]["kind"]} in
	playlist) ret "$YT_BASE/playlist?list=${YR[$id][$i]["id"]}" ;;
	channel) ret "$YT_BASE${YR[$id][$i]["id"]}" ;;
	*) ret "$YT_BASE/watch?v=${YR[$id][$i]["id"]}" ;;
	esac
}

fn youtube_paste(int id, text, op = "") {
	local r

	local q

	dt_searchopen "$id"
	q := dt_searchq "$id"
	r := dt_textpaste "$q" "${#q}" "$text"
	dt_searchset "$id" "${r% *}"
}

youtube_menus() {
	local id=$DT_FOCUS v on q l x

	# Every key the window takes is here, beside its item: the line of
	# hints under the list and the player went, and their rows with it.
	dt_menu "File"
	dt_item "New Window" n dt_launch youtube
	dt_item "Search${GL[ellipsis]}" s youtube_key "$id" /
	dt_rowaccel /
	dt_item "Favourite" f yt_fav "$id"
	dt_rowaccel f
	dt_sep
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "Go"
	if [ "${YT[$id]["view"]}" != play ] && [ "${YT[$id]["n"]:-0}" -gt 0 ]; then
		dt_item "Open" o youtube_key "$id" enter
	else
		dt_dim "Open"
	fi
	dt_rowaccel enter
	dt_item "Back" b yt_back "$id"
	dt_rowaccel escape
	dt_item "History" h yt_load "$id" history ""
	dt_rowaccel h
	dt_item "Favourites" v yt_load "$id" favourites ""
	dt_rowaccel v
	dt_menu "Play"
	if [ -n "${YT[$id]["p"]}" ]; then
		dt_item "Pause or Play" p yt_toggle "$id"
		dt_rowaccel space
		dt_item "Next" n yt_next "$id" 1
		dt_rowaccel n
		dt_item "Previous" r yt_next "$id" -1
		dt_rowaccel p
		dt_item "Back 5 Seconds" k yt_seek "$id" -5
		dt_rowaccel left
		dt_item "On 5 Seconds" l yt_seek "$id" +5
		dt_rowaccel right
		dt_item "Back 30 Seconds" b yt_seek "$id" -30
		dt_rowaccel shift-left
		dt_item "On 30 Seconds" o yt_seek "$id" +30
		dt_rowaccel shift-right
		dt_item "Volume Up" u youtube_key "$id" up
		dt_rowaccel up
		dt_item "Volume Down" d youtube_key "$id" down
		dt_rowaccel down
		dt_item "Stop" s youtube_key "$id" escape
		dt_rowaccel escape
	else
		dt_dim "Pause or Play"
		dt_dim "Next"
		dt_dim "Previous"
		dt_dim "Back 5 Seconds"
		dt_dim "On 5 Seconds"
		dt_dim "Back 30 Seconds"
		dt_dim "On 30 Seconds"
		dt_dim "Volume Up"
		dt_dim "Volume Down"
		dt_dim "Stop"
	fi
	dt_sep
	if [ "${YT[$id]["view"]}" = play ]; then
		dt_mark "Mini Player" i "${YT[$id]["mini"]:-0}" yt_mini "$id"
	else
		dt_dim "Mini Player"
	fi
	dt_rowaccel i
	on=0
	[ "$YT_AUTONEXT" = 1 ] && on=1
	dt_mark "Play Next Automatically" a "$on" yt_autonext
	on=0
	[ "$YT_CAPTIONS" = 1 ] && on=1
	dt_mark "Captions" c "$on" yt_captions "$id"
	dt_sep
	for q in "${YT_QUALITIES[@]}"; do
		on=0
		[ "$YT_QUALITY" = "$q" ] && on=1
		l := yt_qlab "$q"
		x := dt_tr "Quality %s" "$l"
		dt_mark "$x" "${l:0:1}" "$on" yt_setquality "$q"
	done
	dt_menu "Picture"
	for v in "${YT_MODES[@]}"; do
		on=0
		[ "$YT_MODE" = "$v" ] && on=1
		dt_mark "${v^}" "${v:0:1}" "$on" yt_setmode "$v"
	done
	dt_sep
	dt_item "Next Picture" x yt_mode
	dt_rowaccel m
}

# The mini player: only the picture, in a small window with no border,
# title or bar, kept in view on every workspace and moved by dragging it.
# A double click or escape goes back to the full player, where it was;
# a right click on the picture has the player's and the window's controls.
fn yt_mini(int id) {
	local r c h w
	local -a was g

	if [ "${YT[$id]["mini"]}" = 1 ]; then
		yt_minikeep "$id"
		read -ra was <<< "${YT[$id]["norm"]}"
		YT[$id]["mini"]=
		DT[$id]["chrome"]=
		DT[$id]["noshadow"]=
		[ "${was[4]}" = 1 ] || { command -v dt_sticky > /dev/null && dt_sticky "$id" 0; }
		if [ "${#was[@]}" -ge 4 ]; then
			DT[$id]["row"]=${was[0]}
			DT[$id]["col"]=${was[1]}
			dt_resize "$id" "${was[2]}" "${was[3]}"
			dt_move "$id" "${was[0]}" "${was[1]}"
		fi
		YT[$id]["sized"]=
		return 0
	fi
	[ "${YT[$id]["view"]}" = play ] || return 0
	YT[$id]["norm"]="${DT[$id]["row"]} ${DT[$id]["col"]} ${DT[$id]["h"]} ${DT[$id]["w"]} ${DT[$id]["sticky"]:-0}"
	# The corner of the display the player is on, not of the whole
	# screen, which with several displays is a corner of another one
	# (Gitea #293).
	dt_windisp "$id"
	w=$((DTW_W / 3))
	[ "$w" -gt 64 ] && w=64
	[ "$w" -lt 24 ] && w=24
	h=$(((w * 9 / 16 + 1) / 2 + 1))
	r=$((DTW_R + DTW_H - h - 1))
	c=$((DTW_C + DTW_W - w - 2))
	# Where it was last left, while that still fits the screen.
	read -ra g <<< "$YT_MINIGEO"
	if [ "${#g[@]}" = 4 ] && [ $((g[0] + g[2])) -le "$DT_ROWS" ] &&
	   [ $((g[1] + g[3])) -le "$DT_COLS" ] && [ "${g[2]}" -ge 3 ] &&
	   [ "${g[3]}" -ge 12 ]; then
		r=${g[0]}
		c=${g[1]}
		h=${g[2]}
		w=${g[3]}
	fi
	YT[$id]["mini"]=1
	DT[$id]["chrome"]=none
	DT[$id]["noshadow"]=
	[ "${YT_MINISHADOW:-1}" = 1 ] || DT[$id]["noshadow"]=1
	command -v dt_sticky > /dev/null && dt_sticky "$id" "${YT_MINISTICKY:-1}"
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	dt_resize "$id" "$h" "$w"
	dt_move "$id" "$r" "$c"
	YT[$id]["sized"]=
}

# Draw the mini player: the picture filling the window, or the title
# while it loads.
fn yt_drawmini(int id, int h, int w) {
	local p md

	yt_tick "$id"
	p=${YT[$id]["p"]}
	if [ -n "$p" ]; then
		md := yt_drawmode
		yt_picture "$id" "$w" "$h" 0 0 "$md" && return 0
	fi
	console pen "$DT_DIM" "$DT_FACE"
	console put -p "w$id" $((h / 2)) 1 "${YT[$id]["title"]:0:$((w - 2))}"
}

# A right click on the mini player.
fn youtube_context(int? id = "") {
	dt_menu "Player"
	if [ -n "${YT[$id]["p"]}" ]; then
		dt_item "Pause or Play" p yt_toggle "$id"
		dt_item "Back 10 Seconds" b yt_seek "$id" -10
		dt_item "On 10 Seconds" o yt_seek "$id" +10
		dt_item "Next" n yt_next "$id" 1
		dt_item "Louder" l youtube_key "$id" up
		dt_item "Quieter" q youtube_key "$id" down
	else
		dt_dim "Pause or Play"
	fi
	dt_sep
	dt_mark "Sticky" k "${DT[$id]["sticky"]:-0}" yt_ministicky "$id"
	dt_mark "Shadow" h "${YT_MINISHADOW:-1}" yt_minishadow "$id"
	dt_sep
	dt_item "Full Player" f yt_mini "$id"
	dt_item "Close" c dt_closereq "$id"
}

# Remember where the mini player is, for the next time it opens.
fn yt_minikeep(int id) {
	[ "${YT[$id]["mini"]}" = 1 ] || return 0
	YT_MINIGEO="${DT[$id]["row"]} ${DT[$id]["col"]} ${DT[$id]["h"]} ${DT[$id]["w"]}"
	command -v dt_save > /dev/null && dt_save
}

# The mini player on every workspace or on its own, from its right-click
# menu, kept for the next time.
fn yt_ministicky(int id) {
	if [ "${DT[$id]["sticky"]:-0}" = 1 ]; then YT_MINISTICKY=0; else YT_MINISTICKY=1; fi
	command -v dt_sticky > /dev/null && dt_sticky "$id" "$YT_MINISTICKY"
	command -v dt_save > /dev/null && dt_save
}

# A mini player already open takes the settings as Control Panel changes
# them, rather than at the next time it opens.
yt_miniapply() {
	local id

	for id in "${!YT[@]}"; do
		[ "${YT[$id]["mini"]}" = 1 ] || continue
		DT[$id]["noshadow"]=
		[ "${YT_MINISHADOW:-1}" = 1 ] || DT[$id]["noshadow"]=1
		command -v dt_sticky > /dev/null && dt_sticky "$id" "${YT_MINISTICKY:-1}"
	done
	dt_want 10
}

# Its shadow, on or off, from the same menu.
fn yt_minishadow(int id) {
	if [ "${YT_MINISHADOW:-1}" = 1 ]; then YT_MINISHADOW=0; else YT_MINISHADOW=1; fi
	DT[$id]["noshadow"]=
	[ "$YT_MINISHADOW" = 1 ] || DT[$id]["noshadow"]=1
	command -v dt_save > /dev/null && dt_save
	dt_want 10
}

fn yt_setmode(v) {
	YT_MODE=$v
	command -v dt_save > /dev/null && dt_save
}

# The quality's levels, in the order q steps through them, and what each is.
YT_QUALITIES=(tiny small medium large)
fn yt_qlab(q) {
	case $q in
	tiny) ret 144p ;;
	small) ret 240p ;;
	medium) ret 360p ;;
	large) ret 480p ;;
	*) ret "$q" ;;
	esac
}

# Set the quality and tell every player playing now: it takes it at once, not
# at the next video. Kept for next time as well.
fn yt_setquality(q) {
	local id

	YT_QUALITY=$q
	command -v dt_save > /dev/null && dt_save
	for id in "${!YT[@]}"; do
		[ -n "${YT[$id]["p"]}" ] && [ -n "${YT[$id]["pt"]}" ] || continue
		web eval "${YT[$id]["pt"]}" "(function(){var p=document.getElementById(\"movie_player\");try{p.setPlaybackQualityRange(\"$q\",\"$q\")}catch(e){}})()" > /dev/null 2>&1
	done
	dt_want 10
}

# The next level up, and round to the lowest after the highest.
fn yt_quality(int id = 0) {
	local i q l

	for i in "${!YT_QUALITIES[@]}"; do
		[ "${YT_QUALITIES[$i]}" = "$YT_QUALITY" ] && break
	done
	q=${YT_QUALITIES[$(( (i + 1) % ${#YT_QUALITIES[@]} ))]}
	yt_setquality "$q"
	l := yt_qlab "$q"
	dt_notep low "Quality %s" "$l"
}

# Captions on or off: kept for next time, and told to the player playing now.
fn yt_captions(int id = 0) {
	if [ "$YT_CAPTIONS" = 1 ]; then YT_CAPTIONS=0; else YT_CAPTIONS=1; fi
	command -v dt_save > /dev/null && dt_save
	local w
	w := yt_ccword
	[ -n "${YT[$id]["pt"]}" ] && [ -n "${YT[$id]["p"]}" ] &&
		web eval "${YT[$id]["pt"]}" "(function(){var p=document.getElementById(\"movie_player\");try{p.${w}Module(\"captions\")}catch(e){}})()" > /dev/null 2>&1
	YT[$id]["pat"]=
	dt_want 10
}

yt_autonext() {
	if [ "$YT_AUTONEXT" = 1 ]; then YT_AUTONEXT=0; else YT_AUTONEXT=1; fi
	command -v dt_save > /dev/null && dt_save
}
