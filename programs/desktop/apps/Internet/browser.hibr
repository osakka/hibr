#!/usr/bin/env hibr
#
# browser -- the web, in a window: a headless Chromium driven by the web
# module, each page drawn as cells -- its text where the browser laid it
# out, in its colours, over a half-block picture of its backgrounds and
# images. Links are followed with a click, fields typed into, pages
# scrolled with the wheel or the page keys.
#
# A tab strip along the top -- a click switches, x closes, + opens another
# -- then back, forward, reload and the address: what is typed there is
# gone to as it is, with https:// put in front of a bare name, or searched
# for when it is not an address at all (BW_SEARCH). f6 or ctrl-l puts the
# keyboard in it; enter goes, escape gives it back to the page. Every other
# key goes to the page, except one the desktop holds.
#
# Bookmarks are a file of their own, a title and an address to a line,
# tab between (~/.local/share/hibr/bookmarks.tsv): Bookmarks > Add Bookmark
# keeps the page, and the rest of that menu goes to one. A restart brings
# every tab back. Without Chromium or Chrome installed the window says so.
#
# Control Panel > Browser (Gitea #276) sets the home page a new window and
# tab open at, the search, how a page is drawn -- following Pictures, half
# blocks, pixels, or text only, the page's words wrapped to the window with
# each link numbered -- and what each tab is told: JavaScript, images, dark
# pages, zoom, the user agent. The program, the profile and extra flags
# are read when Chromium next starts. Since Gitea #285 it also sets the
# languages pages are asked for, Do Not Track, addresses never fetched,
# what a page may be given (location, camera, microphone, notifications,
# each refused or allowed, since a headless browser can ask nobody), and
# downloads into a folder, each told in a note as it lands; a page's own
# notifications become the desktop's notes. File > Save as PDF prints the
# page to a file.
#
# A page's sound plays through the media module (Gitea #305): the browser
# records each tab's own sound once the page is pressed or typed into --
# or as it loads, with Pages May Play Sound On Their Own -- and each tab
# has a player of its own for it.

strict

app browser "The web, in a window" 1.7
# modules: web
# part: control-panel/browserset.hibr

command -v dt_app > /dev/null && dt_app browser "Browser" 26 96 many "◎"

declare -gA BW
command -v dt_keepstate > /dev/null && dt_keepstate browser BW

BW_SEARCH="${BW_SEARCH-https://lite.duckduckgo.com/lite/?q=}"
BW_HOME="${BW_HOME-https://lite.duckduckgo.com/lite/}"
BW_MODE="${BW_MODE-follow}"
BW_JS="${BW_JS-1}"
BW_IMAGES="${BW_IMAGES-1}"
BW_DARK="${BW_DARK-0}"
BW_ZOOM="${BW_ZOOM-100}"
BW_UA="${BW_UA-}"
BW_PROGRAM="${BW_PROGRAM-}"
BW_PROFILE="${BW_PROFILE-}"
BW_ARGS="${BW_ARGS-}"
BW_LANG="${BW_LANG-}"
BW_DNT="${BW_DNT-0}"
BW_BLOCK="${BW_BLOCK-}"
BW_PGEO="${BW_PGEO-refuse}"
BW_PCAM="${BW_PCAM-refuse}"
BW_PMIC="${BW_PMIC-refuse}"
BW_PNOTE="${BW_PNOTE-refuse}"
BW_DL="${BW_DL-0}"
BW_DLDIR="${BW_DLDIR-$HOME/Downloads}"
BW_AUTOPLAY="${BW_AUTOPLAY-0}"
command -v dt_keep > /dev/null && dt_keep BW_HOME BW_SEARCH BW_MODE BW_JS \
	BW_IMAGES BW_DARK BW_ZOOM BW_UA BW_PROGRAM BW_PROFILE BW_ARGS \
	BW_LANG BW_DNT BW_BLOCK BW_PGEO BW_PCAM BW_PMIC BW_PNOTE BW_DL BW_DLDIR \
	BW_AUTOPLAY
declare -gA BWX
# A tab's sound: its player, the pipe into it, and when it was last
# pressed, typed into or sent somewhere -- the moments a recording may
# begin -- keyed by the tab, which is the browser's and so unique.
declare -gA BWS BWSF BWSA
BW_MARKS="${BW_MARKS-${XDG_DATA_HOME:-$HOME/.local/share}/hibr/bookmarks.tsv}"
BW_FD=
BW_TABS=()
BW_MARKT=()
BW_MARKU=()

# The address a typed text means: as it is with a scheme, https:// before a
# bare name, a search for anything else.
fn bw_addr(t) {
	local q

	t=${t#"${t%%[! ]*}"}
	t=${t%"${t##*[! ]}"}
	case $t in
	*://* | about:* | data:* | file:*) ret "$t"; return 0 ;;
	esac
	if [[ $t != *" "* && $t == *.* ]] || [[ $t == localhost* ]]; then
		ret "https://$t"
		return 0
	fi
	q=${t// /+}
	[ -n "$BW_SEARCH" ] || { ret "https://$q"; return 0; }
	ret "$BW_SEARCH$q"
}

# This window's tabs, by the web module's numbers, into BW_TABS.
fn bw_tabs(int id) {
	read -ra BW_TABS <<< "${BW[$id]["tabs"]}"
}

# The browser's pipe, watched once for every window, so a page that
# changes on its own wakes the desktop.
bw_watch() {
	local fd

	[ -n "$BW_FD" ] && return 0
	fd := web fd 2> /dev/null || return 1
	BW_FD=$fd
	command -v console > /dev/null && console watch "$fd"
	return 0
}

# What Chromium is started with, for whichever window starts it -- the
# YouTube player asks for this too, since the two share one browser.
bw_cfg() {
	web config browser "$BW_PROGRAM" 2> /dev/null
	web config profile "$BW_PROFILE" 2> /dev/null
	web config args "$BW_ARGS" 2> /dev/null
	return 0
}

# What one tab is told: the browser keeps each per page, so the YouTube
# player's own tabs are left as they are.
fn bw_apply(t) {
	local on=on

	[ "$BW_JS" = 1 ] || on=off
	web set "$t" js "$on" 2> /dev/null
	on=on
	[ "$BW_IMAGES" = 1 ] || on=off
	web set "$t" images "$on" 2> /dev/null
	on=off
	[ "$BW_DARK" = 1 ] && on=on
	web set "$t" dark "$on" 2> /dev/null
	web set "$t" zoom "${BW_ZOOM:-100}" 2> /dev/null
	web set "$t" ua "$BW_UA" 2> /dev/null
	web set "$t" lang "$BW_LANG" 2> /dev/null
	on=off
	[ "$BW_DNT" = 1 ] && on=on
	web set "$t" dnt "$on" 2> /dev/null
	web set "$t" block "$BW_BLOCK" 2> /dev/null
	bw_geo "$t"
	on=off
	[ "$BW_PNOTE" = allow ] && on=on
	web set "$t" notes "$on" 2> /dev/null
	on=click
	[ "$BW_AUTOPLAY" = 1 ] && on=load
	web sound "$t" "$on" 2> /dev/null
	return 0
}

# A tab may be about to start its sound: it was just pressed, typed into
# or sent to a page, so it is taken from at once rather than when it has
# something already.
fn bw_sndarm(t) {
	[ -n "$t" ] && BWSA["$t"]=$EPOCHSECONDS
	return 0
}

# A tab's player, closed with the tab or at a new recording.
fn bw_sndstop(t) {
	[ -n "${BWS["$t"]-}" ] && media close "${BWS["$t"]}" 2> /dev/null
	unset BWS["$t"] BWSF["$t"]
	return 0
}

# Take what a window's tabs have recorded into their players. A recording
# opens with a reset that comes alone, before any of its sound, which is
# when the tab's player is started afresh. A tab playing is taken from
# every 200 ms; one gone quiet -- the browser pauses its recording after
# two seconds of silence -- once a second, to hear it start again; and
# one with no recording only for ten seconds after it was pressed, typed
# into or sent somewhere, so a desktop with a Browser open and nothing
# playing asks for nothing.
fn bw_sound(int id) {
	local t s p fd want=
	local -a w

	bw_tabs "$id"
	for t in "${BW_TABS[@]}"; do
		if [ -z "${BWS["$t"]-}" ] &&
		   [ $((EPOCHSECONDS - ${BWSA["$t"]:-0})) -gt 10 ]; then
			continue
		fi
		fd=${BWSF["$t"]:--}
		s := web take "$t" - "$fd" 2> /dev/null || continue
		read -ra w <<< "$s"
		if [ "${w[5]}" = 1 ]; then
			bw_sndstop "$t"
			need media 2> /dev/null || continue
			p := media feed 2> /dev/null || continue
			fd := media pipe "$p" audio 2> /dev/null || {
				media close "$p" 2> /dev/null
				continue
			}
			BWS["$t"]=$p
			BWSF["$t"]=$fd
			want=50
		fi
		case ${w[11]} in
		on) [ "${want:-9999}" -gt 200 ] && want=200 ;;
		quiet) [ -z "$want" ] && want=1000 ;;
		*)
			[ -n "${BWS["$t"]-}" ] && [ "${w[5]}" != 1 ] && bw_sndstop "$t"
			[ -z "$want" ] && want=250
			;;
		esac
	done
	[ -n "$want" ] && dt_want "$want"
	return 0
}

# Where a page is told it is when location is allowed: the place Prayer
# Times knows -- set there, or the time zone's own -- and no position at all
# when location is refused or no place is known.
fn bw_geo(t) {
	local p=

	[ "$BW_PGEO" = allow ] && dt_has dt_ploc && p := dt_ploc
	web set "$t" geo "$p" 2> /dev/null
	return 0
}

# What the whole browser is told, which the YouTube player's tabs share:
# what a page may be given, and whether downloads land in a folder.
bw_wide() {
	local p v

	for p in geolocation:BW_PGEO camera:BW_PCAM microphone:BW_PMIC \
		 notifications:BW_PNOTE; do
		v=${p#*:}
		web permit "${p%%:*}" "${!v}" 2> /dev/null
	done
	if [ "$BW_DL" = 1 ] && [ -n "$BW_DLDIR" ]; then
		mkdir -p "$BW_DLDIR" 2> /dev/null
		web downloads "$BW_DLDIR" 2> /dev/null
	else
		web downloads off 2> /dev/null
	fi
	return 0
}

# What the browser has to say since it was last asked: a download that
# ended, and a page's notification, each a note of the desktop's own.
bw_heard() {
	local l k x

	if x := web downloaded 2> /dev/null; then
		while IFS=$'\t' read -r k l; do
			case $k in
			done) dt_notep normal "Downloaded %s" "${l##*/}" ;;
			failed) dt_notep high "The download of %s did not finish" "$l" ;;
			esac
		done <<< "$x"
	fi
	# A page's own words, which no catalogue holds: passed as they are.
	if x := web notes 2> /dev/null; then
		while IFS=$'\t' read -r k l; do
			x="${k:-${l:-?}}${l:+: $l}"
			dt_notify "$x"
		done <<< "$x"
	fi
	return 0
}

# A setting changed: every Browser tab is told again, and loaded again when
# what was changed only reaches a page as it loads (JavaScript, images, the
# user agent).
fn bw_reapply(again = "") {
	local id t

	for id in "${!BW[@]}"; do
		[ -n "${BW[$id]["tabs"]+x}" ] || continue
		bw_tabs "$id"
		for t in "${BW_TABS[@]}"; do
			bw_apply "$t"
			[ -n "$again" ] && web reload "$t" 2> /dev/null
		done
		BW[$id]["tdone"]=
	done
	# Only to a browser already running: a setting changed in the panel
	# should not start one.
	[ -n "$BW_FD" ] && bw_wide
	return 0
}

# Open a tab in a window, at an address or the home page, and make it the
# one shown; with no home page it is blank and the keyboard in the address.
fn bw_newtab(int id, url = "") {
	local t

	[ -z "$url" ] && [ -n "$BW_HOME" ] && url := bw_addr "$BW_HOME"
	bw_cfg
	t := web open 2> /dev/null || {
		BW[$id]["err"]="No Chromium or Chrome to show pages with -- install one, or set HIBR_WEB_BROWSER"
		return 1
	}
	bw_wide
	bw_apply "$t"
	bw_sndarm "$t"
	[ -n "$url" ] && web go "$t" "$url" 2> /dev/null
	bw_watch
	BW[$id]["tabs"]="${BW[$id]["tabs"]:+${BW[$id]["tabs"]} }$t"
	BW[$id]["cur"]=$t
	BW[$id]["err"]=
	BW[$id]["sized"]=
	[ -z "$url" ] && bw_editaddr "$id"
	return 0
}

# Close one of a window's tabs; the window goes with its last one.
fn bw_closetab(int id, t) {
	local out= x n=0

	bw_tabs "$id"
	for x in "${BW_TABS[@]}"; do
		[ "$x" = "$t" ] && continue
		out="${out:+$out }$x"
		n=$((n + 1))
	done
	bw_sndstop "$t"
	web close "$t" 2> /dev/null
	BW[$id]["tabs"]=$out
	if [ "$n" = 0 ]; then
		BW[$id]["cur"]=
		dt_wantclose "$id"
		return 0
	fi
	if [ "${BW[$id]["cur"]}" = "$t" ]; then
		bw_tabs "$id"
		BW[$id]["cur"]=${BW_TABS[$((n - 1))]}
		BW[$id]["sized"]=
	fi
}

fn browser_open(int id, arg = "") {
	BW[$id]["tabs"]=
	BW[$id]["cur"]=
	BW[$id]["aed"]=
	BW[$id]["abuf"]=
	BW[$id]["acur"]=0
	BW[$id]["sized"]=
	BW[$id]["err"]=
	need web 2> /dev/null || {
		BW[$id]["err"]="The web module is not installed"
		return 0
	}
	bw_newtab "$id" "$arg"
}

# The last Browser window stops watching Chromium's pipe, which nothing
# else drains; Chromium itself stops only when no YouTube window uses it.
fn browser_close(int id) {
	local t ids o other=0 tube=0
	local -a il

	bw_tabs "$id"
	for t in "${BW_TABS[@]}"; do
		bw_sndstop "$t"
		unset BWSA["$t"]
		web close "$t" 2> /dev/null
	done
	unset "BW[$id]"
	for t in "${!BWX[@]}"; do
		[[ $t == "$id:"* ]] && unset BWX["$t"]
	done
	ids := dt_ids
	read -ra il <<< "$ids"
	for o in "${il[@]}"; do
		[ "$o" = "$id" ] && continue
		case ${DT[$o]["app"]} in
		browser) other=1 ;;
		youtube) tube=1 ;;
		esac
	done
	[ "$other" = 1 ] && return 0
	if [ -n "$BW_FD" ]; then
		command -v console > /dev/null && console unwatch "$BW_FD"
		BW_FD=
	fi
	[ "$tube" = 0 ] && web quit 2> /dev/null
	return 0
}

# A restart starts a new browser: every tab is opened again where it was.
fn browser_stash(int id, dir) {
	local t urls= u

	bw_tabs "$id"
	for t in "${BW_TABS[@]}"; do
		u := web url "$t" 2> /dev/null
		[ "$t" = "${BW[$id]["cur"]}" ] && urls="${urls:+$urls }*$u" ||
			urls="${urls:+$urls }$u"
	done
	BW[$id]["urls"]=$urls
}

fn browser_resume(int id) {
	local u cur=
	local -a us

	read -ra us <<< "${BW[$id]["urls"]}"
	BW[$id]["tabs"]=
	BW[$id]["cur"]=
	BW[$id]["sized"]=
	BW_FD=
	need web 2> /dev/null || return 0
	for u in "${us[@]}"; do
		if [ "${u:0:1}" = "*" ]; then
			u=${u:1}
			bw_newtab "$id" "$u" && cur=${BW[$id]["cur"]}
		else
			bw_newtab "$id" "$u"
		fi
	done
	[ -n "$cur" ] && BW[$id]["cur"]=$cur
	[ "${#us[@]}" = 0 ] && bw_newtab "$id"
	BW[$id]["aed"]=
}

# Drain the browser's messages for a window not drawn, or its pipe would
# wake the desktop for ever.
fn browser_idle(int id) {
	[ -n "$BW_FD" ] && web poll > /dev/null 2>&1
	[ -n "$BW_FD" ] && bw_heard
	# A window not drawn has its page stop saying when it repaints, so a
	# busy page in a hidden window wakes nothing (Gitea #289).
	if [ -n "${BW[$id]["live"]}" ]; then
		web set "${BW[$id]["live"]}" live off 2> /dev/null
		BW[$id]["live"]=
	fi
	bw_sound "$id"
	return 0
}

# The next tab along, or the one before, wrapping at either end.
fn bw_steptab(int id, int d) {
	local i n cur=${BW[$id]["cur"]}

	bw_tabs "$id"
	n=${#BW_TABS[@]}
	[ "$n" -gt 1 ] || return 0
	for i in "${!BW_TABS[@]}"; do
		[ "${BW_TABS[$i]}" = "$cur" ] && break
	done
	BW[$id]["cur"]=${BW_TABS[$(((i + d + n) % n))]}
	BW[$id]["sized"]=
	BW[$id]["aed"]=
	return 0
}

# Put the keyboard in the address bar, with the page's address to edit.
fn bw_editaddr(int id) {
	local t=${BW[$id]["cur"]} u=

	[ -n "$t" ] && u := web url "$t" 2> /dev/null
	[ "$u" = about:blank ] && u=
	BW[$id]["aed"]=1
	BW[$id]["abuf"]=$u
	BW[$id]["acur"]=${#u}
}

# Go where the address bar says.
fn bw_goaddr(int id) {
	local t=${BW[$id]["cur"]} a

	BW[$id]["aed"]=
	[ -n "${BW[$id]["abuf"]// /}" ] || return 0
	a := bw_addr "${BW[$id]["abuf"]}"
	if [ -z "$t" ]; then
		bw_newtab "$id" "$a"
	else
		bw_sndarm "$t"
		web go "$t" "$a" 2> /dev/null
	fi
}

fn browser_draw(int id, int h, int w, int row, int col) {
	local t=${BW[$id]["cur"]} ph ar pt

	dt_wclear "$id"
	bw_tabs "$id"
	# The tab strip only when there is more than one tab to choose between
	# (Gitea #292): a lone tab's row goes to the page. ar is the address
	# row, pt the page's first, and the page ends above the status line.
	ar=1
	[ "${#BW_TABS[@]}" -gt 1 ] && ar=2
	pt=$((ar + 1))
	ph=$((h - pt))
	BW[$id]["pt"]=$pt
	BW[$id]["ph"]=$ph
	BW[$id]["w"]=$w
	[ "$ar" = 2 ] && bw_strip "$id" "$t" "$w"
	bw_bar "$id" "$t" "$w" "$ar"
	bw_body "$id" "$t" "$h" "$w" "$pt" "$ph"
	bw_sound "$id"
}

# The tab strip on row 1: each tab, its close box, and + for another.
fn bw_strip(int id, t, int w) {
	local x=1 n tt lab g=${GL[vline]}

	console pen "$DT_DIM" "$DT_WELL"
	lab := str repeat " " "$w"
	console put -p "w$id" 1 1 "$lab"
	for n in "${BW_TABS[@]}"; do
		tt := web title "$n" 2> /dev/null
		[ -n "$tt" ] || tt := web url "$n" 2> /dev/null
		[ -n "$tt" ] && [ "$tt" != about:blank ] || tt="New Tab"
		tt=${tt:0:18}
		lab=" $tt ${GL[cross]} "
		[ $((x + ${#lab})) -gt $((w - 3)) ] && break
		if [ "$n" = "$t" ]; then
			console pen "$DT_INK" "$DT_FACE" bold
		else
			console pen "$DT_DIM" "$DT_WELL"
		fi
		console put -p "w$id" 1 "$x" "$lab"
		dt_wreg "$id" 1 "$x" $((${#lab} - 3)) "tab:$n"
		dt_wreg "$id" 1 $((x + ${#lab} - 2)) 1 "close:$n"
		x=$((x + ${#lab}))
		console pen "$DT_IDLE" "$DT_WELL"
		console put -p "w$id" 1 "$x" "$g"
		x=$((x + 1))
	done
	console pen "$DT_ACTIVE" "$DT_WELL" bold
	console put -p "w$id" 1 "$x" " ${GL[plus]} "
	dt_wreg "$id" 1 "$x" 3 newtab
}

# Back, forward, reload and the address, on row ar.
fn bw_bar(int id, t, int w, int ar) {
	local lab u on=0

	console pen "$DT_INK" "$DT_FACE"
	console put -p "w$id" "$ar" 1 " ${GL[larr]} ${GL[rarr]} ${GL[reload]} "
	dt_wreg "$id" "$ar" 2 1 back
	dt_wreg "$id" "$ar" 4 1 forward
	dt_wreg "$id" "$ar" 6 1 reload
	[ "${BW[$id]["aed"]}" = 1 ] && on=1
	if [ "$on" = 1 ]; then
		dt_textdraw "$id" "$ar" 9 $((w - 9)) "${BW[$id]["abuf"]}" "${BW[$id]["acur"]}" 1
	else
		u=
		[ -n "$t" ] && u := web url "$t" 2> /dev/null
		[ "$u" = about:blank ] && u=
		console pen "$DT_INK" "$DT_WELL"
		lab := str pad "${u:0:$((w - 9))}" $((w - 9))
		console put -p "w$id" "$ar" 9 "$lab"
	fi
	dt_wreg "$id" "$ar" 9 $((w - 9)) addr
}

# The page, from row pt for ph rows, with a scroll bar in its last column;
# the status line under it.
fn bw_body(int id, t, int h, int w, int pt, int ph) {
	local st bwm tt now sc pw=$((w - 1))
	local -a sv

	if [ -n "${BW[$id]["err"]}" ] || [ -z "$t" ]; then
		console pen "$DT_DIM" "$DT_FACE"
		console put -p "w$id" $((pt + 1)) 2 "${BW[$id]["err"]:-Type an address above.}"
		bw_status "$id" "$h" "$w" ""
		return 0
	fi
	if [ "${BW[$id]["sized"]}" != "$ph $pw" ]; then
		web size "$t" "$ph" "$pw" 2> /dev/null
		BW[$id]["sized"]="$ph $pw"
	fi
	# A page that changes on its own is drawn as it changes (Gitea #289):
	# the tab on show has the browser say when it repaints, and only that
	# one, so a tab not shown -- or a window hidden, see browser_idle --
	# costs nothing.
	if [ "${BW[$id]["live"]}" != "$t" ]; then
		[ -n "${BW[$id]["live"]}" ] &&
			web set "${BW[$id]["live"]}" live off 2> /dev/null
		web set "$t" live on 2> /dev/null
		BW[$id]["live"]=$t
	fi
	# Pixels where the pictures setting asks for them and the terminal can
	# paint them: the page is then the page, with no text layer of its own
	# (ADR 0037), so nothing is drawn over it. Set once per tab, and again
	# when the setting changes.
	bw_drawmode
	bwm=$BW_DRAWN
	if [ "${BW[$id]["pixels"]}" != "$t $bwm" ]; then
		web mode "$t" "$bwm" 2> /dev/null
		BW[$id]["pixels"]="$t $bwm"
	fi
	web poll > /dev/null 2>&1
	bw_heard
	st=
	web loading "$t" 2> /dev/null && st=loading
	if [ "$bwm" = text ]; then
		bw_text "$id" "$t" "$ph" "$w" "$pt"
		[ "$st" = loading ] && dt_want 400
		bw_status "$id" "$h" "$w" "$st"
		command -v dt_retitle > /dev/null && {
			tt := web title "$t" 2> /dev/null
			tt := dt_wintitle Browser "$tt"
			dt_retitle "$id" "$tt"
		}
		return 0
	fi
	# Rendered when the page has changed, but no more often than a
	# terminal's output is drawn (DT_TERMMS): a page animating flat out
	# would otherwise be read and sent on every frame there is.
	now := dt_ms
	if [ "${BW[$id]["drawn"]}" != "$t" ]; then
		web render "$t" 2> /dev/null && BW[$id]["drawn"]=$t
		BW[$id]["rat"]=$now
	elif web dirty "$t" 2> /dev/null; then
		if [ $((now - ${BW[$id]["rat"]:-0})) -ge "${DT_TERMMS:-70}" ]; then
			web render "$t" 2> /dev/null
			BW[$id]["rat"]=$now
		else
			dt_want $((${BW[$id]["rat"]:-0} + ${DT_TERMMS:-70} - now))
		fi
	fi
	web draw "$t" "$pt" 1 -p "w$id" 2> /dev/null
	# The page's own scroll bar, in the column kept for it (Gitea #292).
	sc := web scroll "$t" 2> /dev/null
	read -ra sv <<< "$sc"
	if [ "${sv[1]:-0}" -gt "${sv[2]:-0}" ] && [ "${sv[2]:-0}" -gt 0 ]; then
		BW[$id]["sbt"]=${sv[1]}
		BW[$id]["sbv"]=${sv[2]}
		dt_scrollbar "$id" "$pt" "$w" "$ph" $((sv[1] / 16)) \
			$((sv[2] / 16)) $((sv[0] / 16)) page
	else
		BW[$id]["sbt"]=
	fi
	# A frame while it loads, and one more when the page turns out to be
	# newer than the render this frame just drew: web render's own round
	# trip pumps the pipe, so an event can arrive inside it, and a settled
	# page then sends nothing further to wake the desktop with (Gitea
	# #182). It cannot spin -- the frame it asks for renders, and asks
	# again only if another event lands inside that one.
	if [ "$st" = loading ]; then
		dt_want 400
	elif web dirty "$t" 2> /dev/null; then
		dt_want 30
	fi
	bw_status "$id" "$h" "$w" "$st"
	command -v dt_retitle > /dev/null && {
		tt := web title "$t" 2> /dev/null
		tt := dt_wintitle Browser "$tt"
		dt_retitle "$id" "$tt"
	}
}

# How a page is drawn now, into BW_DRAWN: text, pixels or cells. Follow is
# Control Panel > Pictures, pixels where it asks for them and the terminal
# can paint them; Half Blocks and Pixels say outright.
BW_DRAWN=cells
bw_drawmode() {
	BW_DRAWN=cells
	case $BW_MODE in
	text) BW_DRAWN=text ;;
	pixels) BW_DRAWN=pixels ;;
	half) ;;
	*)
		case $DT_IMGMODE in
		pixels | sixel) BW_DRAWN=pixels ;;
		auto | "") dt_imgpix && BW_DRAWN=pixels ;;
		esac
		;;
	esac
	return 0
}

# What the Control Panel says a page is drawn as now, for its Drawn Now row.
bw_drawnname() {
	bw_drawmode
	case $BW_DRAWN in
	text) ret "text only" ;;
	pixels) ret "pixels" ;;
	*) ret "half blocks" ;;
	esac
}

# The page's words, each link followed by its number in brackets, and the
# addresses after a record separator, one a line. Read with the page's own
# DOM -- the browser runs this whether or not the page may run scripts.
BW_READER="(()=>{const l=[],m=[];document.querySelectorAll('a[href]').forEach(a=>{if(!a.innerText.trim())return;l.push(a.href);const s=document.createElement('span');s.textContent='['+l.length+']';a.after(s);m.push(s)});const t=document.body?document.body.innerText:'';m.forEach(s=>s.remove());return t+String.fromCharCode(30)+l.join(String.fromCharCode(10))})()"

# Read the page again as text and wrap it to w columns, into BWX under the
# window: n lines, l<i> each, u<n> each link's address.
fn bw_textread(int id, t, int w) {
	local r body links line seg cut n=0 k=0 rs=$'\x1e'
	local -a ls us

	r := web eval "$t" "$BW_READER" 2> /dev/null || r=
	body=${r%%"$rs"*}
	links=
	[[ $r == *"$rs"* ]] && links=${r#*"$rs"}
	for k in "${!BWX[@]}"; do
		[[ $k == "$id:"* ]] && unset BWX["$k"]
	done
	mapfile -t ls <<< "$body"
	for line in "${ls[@]}"; do
		line=${line%$'\r'}
		while [ "${#line}" -gt "$w" ]; do
			seg=${line:0:$w}
			cut=${seg% *}
			[ "$cut" = "$seg" ] || [ -z "$cut" ] && cut=$seg
			BWX["$id:l$n"]=$cut
			n=$((n + 1))
			line=${line:${#cut}}
			line=${line# }
		done
		BWX["$id:l$n"]=$line
		n=$((n + 1))
	done
	BWX["$id:n"]=$n
	k=0
	mapfile -t us <<< "$links"
	for line in "${us[@]}"; do
		[ -n "$line" ] || continue
		k=$((k + 1))
		BWX["$id:u$k"]=$line
	done
	BW[$id]["tdone"]="$t $w"
}

# Text only: the page's words, scrolled from ttop, each [n] a link to click.
fn bw_text(int id, t, int ph, int w, int pt = 3) {
	local n top r=0 line rest pre num x vis=$((ph - 1)) tw=$((w - 2))

	if web dirty "$t" 2> /dev/null || [ "${BW[$id]["tdone"]}" != "$t $tw" ]; then
		web render "$t" 2> /dev/null
		bw_textread "$id" "$t" "$tw"
		BW[$id]["ttop"]=0
	fi
	n=${BWX["$id:n"]:-0}
	top := dt_scrollfit "${BW[$id]["ttop"]:-0}" "$n" "$vis"
	BW[$id]["ttop"]=$top
	BW[$id]["tvis"]=$vis
	console pen "$DT_INK" "$DT_FACE"
	while [ "$r" -lt "$vis" ]; do
		line=${BWX["$id:l$((top + r))"]-}
		console put -p "w$id" $((r + pt)) 2 "$line"
		rest=$line
		x=2
		while [[ $rest == *"["[0-9]*"]"* ]]; do
			pre=${rest%%"["[0-9]*}
			rest=${rest:${#pre}}
			num=${rest#"["}
			num=${num%%"]"*}
			if [[ $num == +([0-9]) ]] && [ -n "${BWX["$id:u$num"]+x}" ]; then
				console pen "$DT_ACTIVE" "$DT_FACE"
				console put -p "w$id" $((r + pt)) $((x + ${#pre})) "[$num]"
				dt_wreg "$id" $((r + pt)) $((x + ${#pre})) $((${#num} + 2)) "link:$num"
				console pen "$DT_INK" "$DT_FACE"
			fi
			x=$((x + ${#pre} + 1))
			rest=${rest:1}
		done
		r=$((r + 1))
	done
	[ "$n" -gt "$vis" ] && command -v dt_scrollbar > /dev/null &&
		dt_scrollbar "$id" 3 "$w" "$vis" "$n" "$vis" "$top" text
	return 0
}

# A scrollbar held and dragged (Gitea #298): the page's, counted in the
# sixteen-pixel steps it is drawn in, or the text view's, in lines.
fn browser_scroll(int id, key, int top) {
	local t=${BW[$id]["cur"]}

	case $key in
	page)
		[ -n "$t" ] && web eval "$t" "scrollTo(0,$((top * 16)))" \
			> /dev/null 2>&1
		;;
	text) BW[$id]["ttop"]=$top ;;
	esac
}

# Scroll the text a key's or a wheel's worth; status 1 for a key it does
# not take.
fn bw_textmove(int id, k) {
	local n=${BWX["$id:n"]:-0} vis top

	vis=${BW[$id]["tvis"]:-10}
	top := dt_scrollmove "$k" "${BW[$id]["ttop"]:-0}" "$n" "$vis" || return 1
	BW[$id]["ttop"]=$top
	return 0
}

# The bottom line: loading, or the page's address.
fn bw_status(int id, int h, int w, st = "") {
	local t

	if [ "$st" = loading ]; then
		t="Loading${GL[ellipsis]}"
	elif [ "$BW_MODE" = text ]; then
		t="Text only ${GL[dot]} f6 address ${GL[dot]} click a [number] to follow it"
	else
		t="f6 address ${GL[dot]} alt-b back ${GL[dot]} alt-f forward"
	fi
	t := str pad "${t:0:$w}" "$w"
	console pen "$DT_DIM" "$DT_FACE"
	console put -p "w$id" "$h" 1 "$t"
}

fn browser_key(int id, key) {
	local t=${BW[$id]["cur"]} r k

	if [ "${BW[$id]["aed"]}" = 1 ]; then
		case $key in
		enter) bw_goaddr "$id"; return 0 ;;
		escape | tab) BW[$id]["aed"]=; return 0 ;;
		esac
		r := dt_textkey "${BW[$id]["abuf"]}" "${BW[$id]["acur"]}" "$key" || return 1
		BW[$id]["abuf"]=${r% *}
		BW[$id]["acur"]=${r##* }
		return 0
	fi
	# Back and Forward are alt-b and alt-f: a window's own key is looked at
	# before the desktop's, so taking alt-left and alt-right meant the
	# arrows did something different here from everywhere else -- the
	# workspaces until 0.99.90, tiling after it. alt-b and alt-f are
	# readline's own word-back and word-forward, which is where the letters
	# come from, and they are the Browser's only while it has focus, so a
	# terminal keeps its own. Not alt-[ and alt-]: those cannot be bound at
	# all, since ESC [ and ESC ] are the CSI and OSC introducers and the
	# decoder consumes them -- measured, both time out rather than arrive.
	case $key in
	f6 | ctrl-l) bw_editaddr "$id"; return 0 ;;
	alt-b) [ -n "$t" ] && web back "$t" 2> /dev/null; return 0 ;;
	alt-f) [ -n "$t" ] && web forward "$t" 2> /dev/null; return 0 ;;
	f5) [ -n "$t" ] && web reload "$t" 2> /dev/null; return 0 ;;
	esac
	bw_drawmode
	if [ "$BW_DRAWN" = text ]; then
		bw_textmove "$id" "$key" && return 0
		[ "$key" = " " ] && bw_textmove "$id" pagedown && return 0
	fi
	for k in "${!DT_KEYS[@]}"; do
		[ "${DT_KEYS["$k"]}" = "$key" ] && return 1
	done
	# Tabs, with the keys every browser has (Gitea #292) -- after the
	# desktop's own, so a desktop shortcut on one of them still wins.
	case $key in
	ctrl-t) bw_newtab "$id"; return 0 ;;
	ctrl-w) [ -n "$t" ] && bw_closetab "$id" "$t"; return 0 ;;
	ctrl-pagedown) bw_steptab "$id" 1; return 0 ;;
	ctrl-pageup) bw_steptab "$id" -1; return 0 ;;
	esac
	[ -n "$t" ] || return 1
	bw_sndarm "$t"
	web key "$t" "$key" 2> /dev/null || return 1
	return 0
}

fn browser_click(int id, int r, int c, btn = "") {
	local tag t=${BW[$id]["cur"]}

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	tab:*)
		BW[$id]["cur"]=${tag#tab:}
		BW[$id]["sized"]=
		BW[$id]["aed"]=
		return 0
		;;
	close:*) bw_closetab "$id" "${tag#close:}"; return 0 ;;
	newtab) bw_newtab "$id"; return 0 ;;
	back) [ -n "$t" ] && web back "$t" 2> /dev/null; return 0 ;;
	forward) [ -n "$t" ] && web forward "$t" 2> /dev/null; return 0 ;;
	reload) [ -n "$t" ] && web reload "$t" 2> /dev/null; return 0 ;;
	addr) bw_editaddr "$id"; return 0 ;;
	link:*)
		[ -n "$t" ] && [ -n "${BWX["$id:u${tag#link:}"]+x}" ] &&
			web go "$t" "${BWX["$id:u${tag#link:}"]}" 2> /dev/null
		return 0
		;;
	esac
	BW[$id]["aed"]=
	bw_drawmode
	[ "$BW_DRAWN" = text ] && return 0
	local pt=${BW[$id]["pt"]:-3} ph=${BW[$id]["ph"]:-1}
	# The scroll bar's column: the page scrolled to where it was clicked.
	if [ -n "$t" ] && [ -n "${BW[$id]["sbt"]}" ] &&
	   [ "$c" = "${BW[$id]["w"]}" ] && [ "$r" -ge "$pt" ] &&
	   [ "$r" -lt $((pt + ph)) ]; then
		web eval "$t" "scrollTo(0,$(((r - pt) * (${BW[$id]["sbt"]} - ${BW[$id]["sbv"]}) / (ph > 1 ? ph - 1 : 1))))" \
			> /dev/null 2>&1
		return 0
	fi
	bw_sndarm "$t"
	[ -n "$t" ] && [ "$r" -ge "$pt" ] &&
		web click "$t" $((r - pt)) $((c - 1)) 2> /dev/null
	return 0
}

fn browser_wheel(int id, dir, int r = 0, int c = 0) {
	local t=${BW[$id]["cur"]}

	[ -n "$t" ] || return 0
	bw_drawmode
	if [ "$BW_DRAWN" = text ]; then
		local top

		top := dt_scrollmove "$dir" "${BW[$id]["ttop"]:-0}" \
			"${BWX["$id:n"]:-0}" "${BW[$id]["tvis"]:-10}" "$DT_SCROLLWHEEL"
		BW[$id]["ttop"]=$top
		return 0
	fi
	case $dir in
	up) web wheel "$t" -3 2> /dev/null ;;
	down) web wheel "$t" 3 2> /dev/null ;;
	esac
	return 0
}

# Copy: what is selected in the address while it is being typed, else what
# is selected on the page, else the page's address. The address while it
# is typed was copied whole, there being no selection in a field until
# Gitea #295; with nothing selected in it there is nothing to copy.
fn browser_copy(int id) {
	local t=${BW[$id]["cur"]} s=

	if [ "${BW[$id]["aed"]}" = 1 ]; then
		s := dt_fieldsel || return 1
		ret "$s"
		return 0
	fi
	[ -n "$t" ] || return 1
	s := web eval "$t" "String(getSelection())" 2> /dev/null
	[ -n "$s" ] || s := web url "$t" 2> /dev/null
	ret "$s"
}

# Cut: what is selected in the address while it is being typed. A page is
# not the Browser's to cut from.
fn browser_cut(int id) {
	local s

	[ "${BW[$id]["aed"]}" = 1 ] || return 1
	s := dt_fieldsel || return 1
	browser_key "$id" backspace
	ret "$s"
}

fn browser_paste(int id, text, op = "") {
	local t=${BW[$id]["cur"]} r

	if [ "${BW[$id]["aed"]}" = 1 ]; then
		r := dt_textpaste "${BW[$id]["abuf"]}" "${BW[$id]["acur"]}" "$text"
		BW[$id]["abuf"]=${r% *}
		BW[$id]["acur"]=${r##* }
		return 0
	fi
	[ -n "$t" ] && web type "$t" "$text" 2> /dev/null
}

# --- bookmarks ----------------------------------------------------------------

# Every bookmark, titles into BW_MARKT and addresses into BW_MARKU.
bw_marks() {
	local t u

	BW_MARKT=()
	BW_MARKU=()
	[ -r "$BW_MARKS" ] || return 0
	while IFS=$'\t' read -r t u; do
		[ -n "$u" ] || continue
		BW_MARKT+=("$t")
		BW_MARKU+=("$u")
	done < "$BW_MARKS"
}

# Keep the page shown as a bookmark.
fn bw_mark(int id) {
	local t=${BW[$id]["cur"]} u tt

	[ -n "$t" ] || return 0
	u := web url "$t" 2> /dev/null
	tt := web title "$t" 2> /dev/null
	[ -n "$u" ] && [ "$u" != about:blank ] || return 0
	mkdir -p "${BW_MARKS%/*}" 2> /dev/null
	printf '%s\t%s\n' "${tt:-$u}" "$u" >> "$BW_MARKS" ||
		{ dt_notep high "Cannot write %s" "${BW_MARKS##*/}"; return 1; }
	dt_notep low "Bookmarked %s" "${tt:-$u}"
}

# Take the page shown out of the bookmarks.
fn bw_unmark(int id) {
	local t=${BW[$id]["cur"]} u i out=

	[ -n "$t" ] || return 0
	u := web url "$t" 2> /dev/null
	bw_marks
	i=0
	while [ "$i" -lt "${#BW_MARKU[@]}" ]; do
		[ "${BW_MARKU[$i]}" = "$u" ] ||
			out+="${BW_MARKT[$i]}"$'\t'"${BW_MARKU[$i]}"$'\n'
		i=$((i + 1))
	done
	printf '%s' "$out" > "$BW_MARKS" 2> /dev/null
	dt_notep low "Bookmark removed"
}

fn bw_open(int id, url) {
	local t=${BW[$id]["cur"]}

	[ -n "$url" ] && url := bw_addr "$url"
	if [ -n "$t" ]; then
		bw_sndarm "$t"
		web go "$t" "$url" 2> /dev/null
	else
		bw_newtab "$id" "$url"
	fi
}

fn bw_back(int id) { [ -n "${BW[$id]["cur"]}" ] && web back "${BW[$id]["cur"]}" 2> /dev/null; return 0; }
fn bw_fwd(int id) { [ -n "${BW[$id]["cur"]}" ] && web forward "${BW[$id]["cur"]}" 2> /dev/null; return 0; }
fn bw_reload(int id) { [ -n "${BW[$id]["cur"]}" ] && web reload "${BW[$id]["cur"]}" 2> /dev/null; return 0; }

# File > Save as PDF: the page shown, printed the way the browser prints
# it, to a file chosen in the desktop's own save dialog -- in the downloads
# folder, named for the page's title.
fn bw_pdfask(int id) {
	local t=${BW[$id]["cur"]} nm d=$BW_DLDIR

	[ -n "$t" ] || return 0
	nm := web title "$t" 2> /dev/null
	nm=${nm//[\/:]/-}
	[ -d "$d" ] || d=$HOME
	dt_filepick save "Save as PDF" "PDF:*.pdf" "$d" "${nm:-page}.pdf" \
		bw_pdfsaved "$id"
}
fn bw_pdfsaved(id = "", path = "", type = "") {
	local t=${BW[$id]["cur"]}

	[ -n "$t" ] && [ -n "$path" ] || return 0
	case $path in *.pdf) ;; *) path="$path.pdf" ;; esac
	if web pdf "$t" "$path" 2> /dev/null; then
		dt_notep normal "Saved %s" "${path##*/}"
	else
		dt_notep high "The page could not be saved as a PDF"
	fi
}

browser_menus() {
	local id=$DT_FOCUS i=0 u= on=0

	dt_menu "File"
	dt_item "New Window" n dt_launch browser
	dt_item "New Tab" t bw_newtab "$id"
	dt_rowaccel ctrl-t
	dt_item "Open Location${GL[ellipsis]}" l bw_editaddr "$id"
	if [ -n "${BW[$id]["cur"]}" ]; then
		dt_item "Save as PDF${GL[ellipsis]}" p bw_pdfask "$id"
	else
		dt_dim "Save as PDF${GL[ellipsis]}"
	fi
	dt_sep
	if [ -n "${BW[$id]["cur"]}" ]; then
		dt_item "Close Tab" c bw_closetab "$id" "${BW[$id]["cur"]}"
	else
		dt_dim "Close Tab"
	fi
	dt_rowaccel ctrl-w
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	dt_menu "Go"
	dt_item "Back" b bw_back "$id"
	dt_item "Forward" f bw_fwd "$id"
	dt_item "Reload" r bw_reload "$id"
	dt_item "Home" h bw_open "$id" "$BW_HOME"
	dt_sep
	dt_item "Next Tab" n bw_steptab "$id" 1
	dt_rowaccel ctrl-pagedown
	dt_item "Previous Tab" p bw_steptab "$id" -1
	dt_rowaccel ctrl-pageup
	dt_menu "Bookmarks"
	bw_marks
	[ -n "${BW[$id]["cur"]}" ] && u := web url "${BW[$id]["cur"]}" 2> /dev/null
	while [ "$i" -lt "${#BW_MARKU[@]}" ]; do
		[ "${BW_MARKU[$i]}" = "$u" ] && on=1
		i=$((i + 1))
	done
	if [ "$on" = 1 ]; then
		dt_item "Remove Bookmark" r bw_unmark "$id"
	else
		dt_item "Add Bookmark" a bw_mark "$id"
	fi
	[ "${#BW_MARKU[@]}" -gt 0 ] && dt_sep
	i=0
	while [ "$i" -lt "${#BW_MARKU[@]}" ] && [ "$i" -lt 30 ]; do
		dt_item "${BW_MARKT[$i]:0:40}" "" bw_open "$id" "${BW_MARKU[$i]}"
		i=$((i + 1))
	done
}
