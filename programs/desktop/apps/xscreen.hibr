#!/usr/bin/env hibr
#
# xscreen -- X11 programs in windows (Gitea #290, #291): Firefox, GTK and Qt
# programs, and anything else that speaks X11, run on the desktop. Each
# window starts an Xvfb of its own, a virtual X server that draws the screen
# into a file it maps, and the xscr module maps the same file and puts the
# screen into the window -- as pixels where the terminal can place them,
# half blocks where it cannot. Keys, clicks, drags, the wheel and paste go
# to it through XTEST; the screen is drawn only when the server says it
# changed (DAMAGE), so an idle or hidden one costs nothing.
#
# The programs are a list Control Panel > X Screen keeps -- a name, a
# command, how its window behaves and how it is drawn -- and each one is an
# entry under Applications > X Screen, opening a window titled for it and,
# once the program names its own window, `Name [its title]`. The app itself
# is hidden: an empty screen with nothing on it is nothing to choose.
#
# How a program's window behaves:
#   fit    the module is the screen's window manager, keeps the program's
#          window exactly the hibr window's size in pixels and follows a
#          resize; only that corner of the screen is sent, so a small window
#          is a small picture. The screen is Largest Screen in size, and a
#          window larger than that is the screen, scaled.
#   fixed  a screen of Fixed Size, scaled into the window with its shape.
#   own    the same, with no window manager of the module's, for a program
#          that is one -- two cannot share a screen.
#
# What it cannot do yet: hover with no button pressed (the desktop does not
# ask the terminal for every movement), keys outside the server's US
# keyboard map, and the clipboard between the X screen and the desktop.

strict


app xscreen "X11 programs in windows of their own" 1.5
# modules: xscr
# part: control-panel/xscreenset.hibr
command -v dt_app > /dev/null &&
	dt_app xscreen "X Screen" 26 90 many "▣" "" hidden
command -v dt_keepstate > /dev/null && dt_keepstate xscreen XS

declare -gA XS
XS_SIZE="${XS_SIZE-1280x800}"
XS_MAX="${XS_MAX-1920x1080}"
XS_CLOSEEND="${XS_CLOSEEND-0}"
command -v dt_keep > /dev/null && dt_keep XS_SIZE XS_MAX XS_CLOSEEND

# The programs, as the file holds them: a name, a command, a window, a
# picture and what happens when it ends (Gitea #308: default, close or
# keep -- default is Close When It Ends), a tab between, each a line; the
# five arrays are that file read. The fifth was added after, so a line
# without one reads as default; an older desktop reading a line with one
# takes the picture and the fifth together and falls back to follow.
XS_LIST="${XS_LIST-${XDG_DATA_HOME:-$HOME/.local/share}/hibr/xscreen.tsv}"
XSP_NAME=()
XSP_CMD=()
XSP_WIN=()
XSP_PIC=()
XSP_END=()

# Read the list. A line with a field missing is passed over; no field is
# ever written empty, since a tab is IFS whitespace and an empty middle
# field would shift the rest.
xs_load() {
	local n c w p e

	XSP_NAME=()
	XSP_CMD=()
	XSP_WIN=()
	XSP_PIC=()
	XSP_END=()
	[ -r "$XS_LIST" ] || return 0
	while IFS=$'\t' read -r n c w p e; do
		[ -n "$n" ] && [ -n "$c" ] || continue
		case $w in fit | fixed | own) ;; *) w=fit ;; esac
		case $p in follow | half | pixels) ;; *) p=follow ;; esac
		case $e in default | close | keep) ;; *) e=default ;; esac
		XSP_NAME+=("$n")
		XSP_CMD+=("$c")
		XSP_WIN+=("$w")
		XSP_PIC+=("$p")
		XSP_END+=("$e")
	done < "$XS_LIST"
	return 0
}

# Write the list back, through a temporary file and a rename.
xs_save() {
	local i tmp="$XS_LIST.$$"

	mkdir -p "${XS_LIST%/*}" 2> /dev/null
	{
		for i in "${!XSP_NAME[@]}"; do
			printf '%s\t%s\t%s\t%s\t%s\n' "${XSP_NAME[$i]}" "${XSP_CMD[$i]}" \
				"${XSP_WIN[$i]}" "${XSP_PIC[$i]}" "${XSP_END[$i]:-default}"
		done
	} > "$tmp" && command mv -f -- "$tmp" "$XS_LIST"
}

# Put every program on the menu, under Applications > X Screen, taking off
# whatever was there: called when the app loads and whenever the list
# changes.
xs_register() {
	local i

	dt_has dt_appvia || return 0
	dt_appunvia xscreen
	for i in "${!XSP_NAME[@]}"; do
		dt_appvia "xscreen:$i" "${XSP_NAME[$i]}" xscreen \
			"${XSP_NAME[$i]}" "Applications/X Screen"
	done
	return 0
}

# Read the list again and put it on the menu: what the pane calls after
# every change.
xs_reload() {
	xs_load
	xs_register
}

xs_load
xs_register

# Take away the screen folders a desktop that is no longer running left
# behind -- one that crashed or was killed never closed its windows, and
# each holds a screen in memory-backed storage. A folder is named for the
# desktop's pid, which is how one still in use is told apart.
xs_sweep() {
	local d p

	for d in "${XDG_RUNTIME_DIR:-/tmp}"/hibr-xscreen-*; do
		[ -d "$d" ] || continue
		p=${d##*/hibr-xscreen-}
		p=${p%%-*}
		case $p in *[!0-9]* | "") continue ;; esac
		kill -0 "$p" 2> /dev/null && continue
		command rm -rf -- "$d"
	done
	return 0
}

# A display number nothing else has: the first from 20 up with no socket.
xs_free() {
	local n=20

	while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ]; do
		n=$((n + 1))
	done
	ret "$n"
}

# Start a program on the window's screen, as a job of this shell so the
# shell reaps it, its pid kept so closing the window can end it. The
# environment goes through env as words, not as assignments, which a strict
# file would read as globals being made.
fn xs_run(int id, cmd) {
	local n=${XS[$id]["n"]}
	local -a e

	[ -n "$n" ] && [ -n "$cmd" ] || return 1
	e=("DISPLAY=:$n" "GDK_BACKEND=x11" "QT_QPA_PLATFORM=xcb")
	env -u WAYLAND_DISPLAY "${e[@]}" /bin/sh -c "$cmd" > /dev/null 2>&1 &
	XS[$id]["pids"]="${XS[$id]["pids"]} $!"
	return 0
}

# The server is the module's to start and end (xscr start), not a job of
# this shell's: the module ends it when the shell goes, so quitting the
# desktop takes the screen and the programs on it with it, where a job
# would run on after the desktop had gone.
fn xscreen_open(int id, arg = "") {
	local n dir srv= i k=-1 sz

	for i in "${!XSP_NAME[@]}"; do
		[ "${XSP_NAME[$i]}" = "$arg" ] && { k=$i; break; }
	done
	if [ "$k" -lt 0 ]; then
		XS[$id]["err"]="No such program -- add one in Control Panel > X Screen"
		return 0
	fi
	XS[$id]["name"]=${XSP_NAME[$k]}
	XS[$id]["run"]=${XSP_CMD[$k]}
	XS[$id]["win"]=${XSP_WIN[$k]}
	XS[$id]["pic"]=${XSP_PIC[$k]}
	XS[$id]["end"]=${XSP_END[$k]:-default}
	if ! command -v Xvfb > /dev/null; then
		XS[$id]["err"]="X Screen needs Xvfb -- install the xvfb package"
		return 0
	fi
	need xscr 2> /dev/null || {
		XS[$id]["err"]="The xscr module is not installed"
		return 0
	}
	sz=$XS_SIZE
	[ "${XS[$id]["win"]}" = fit ] && sz=$XS_MAX
	xs_sweep
	n := xs_free
	dir="${XDG_RUNTIME_DIR:-/tmp}/hibr-xscreen-$$-$id"
	mkdir -p "$dir" 2> /dev/null
	srv := xscr start "$n" "$sz" "$dir" 2> /dev/null
	XS[$id]["n"]=$n
	XS[$id]["dir"]=$dir
	XS[$id]["srv"]=$srv
	XS[$id]["pids"]=
	XS[$id]["x"]=
	XS[$id]["err"]=
	XS[$id]["title"]=
	XS[$id]["fitwh"]=
	XS[$id]["t0"]=$EPOCHSECONDS
}

# Connect once the server is up: its socket and its screen file both
# there. Asked from _draw, so a slow start is a few frames of "Starting",
# never a wait. A fitted window's screen gets the module as its window
# manager first, so the program is fitted from its first frame.
fn xs_connect(int id) {
	local n=${XS[$id]["n"]} f="${XS[$id]["dir"]}/Xvfb_screen0" x fd

	[ -n "${XS[$id]["x"]}" ] && return 0
	[ -n "$n" ] || return 1
	[ -S "/tmp/.X11-unix/X$n" ] && [ -s "$f" ] || return 1
	x := xscr open "$n" "$f" "${XS[$id]["srv"]}" 2> /dev/null || return 1
	XS[$id]["x"]=$x
	fd := xscr fd "$x"
	XS[$id]["fd"]=$fd
	command -v console > /dev/null && console watch "$fd"
	if [ "${XS[$id]["win"]}" = fit ] && ! xscr manage "$x" 2> /dev/null; then
		XS[$id]["win"]=own
	fi
	[ -n "${XS[$id]["run"]}" ] && xs_run "$id" "${XS[$id]["run"]}"
	XS[$id]["run"]=
	return 0
}

# What a cell measures in the screen's pixels: the terminal's own when
# pixels are drawn, and 8 by 16 for half blocks, so a program fitted to a
# window is the size it would be at that window's size on a terminal.
XS_CW=8
XS_CH=16
fn xs_cell(int id) {
	local g
	local -a p

	XS_CW=8
	XS_CH=16
	[ "${XS[$id]["pix"]}" = 1 ] || return 0
	g := dt_imggfx
	read -ra p <<< "$g"
	[ "${p[1]:-0}" -gt 1 ] && XS_CW=${p[1]}
	[ "${p[2]:-0}" -gt 1 ] && XS_CH=${p[2]}
	return 0
}

# Where the screen sits in the window, its shape kept: in cells, from the
# body's h by w, into XS[id] r0 c0 rh rw.
fn xs_place(int id, int h, int w, int sw, int sh) {
	local cw=$XS_CW ch=$XS_CH rw rh

	[ "${XS[$id]["pix"]}" = 1 ] || { cw=1; ch=2; }
	rw=$w
	rh=$((rw * cw * sh / (sw * ch)))
	if [ "$rh" -gt "$h" ]; then
		rh=$h
		rw=$((rh * ch * sw / (sh * cw)))
	fi
	[ "$rw" -lt 1 ] && rw=1
	[ "$rh" -lt 1 ] && rh=1
	XS[$id]["r0"]=$((1 + (h - rh) / 2))
	XS[$id]["c0"]=$((1 + (w - rw) / 2))
	XS[$id]["rh"]=$rh
	XS[$id]["rw"]=$rw
}

fn xscreen_draw(int id, int h, int w, int row, int col) {
	local x sz sw sh m t fw fh crop=

	XS[$id]["h"]=$h
	XS[$id]["w"]=$w
	console pen "$DT_INK" "$DT_FACE"
	if [ -n "${XS[$id]["err"]}" ]; then
		dt_tput "$id" 2 2 "${XS[$id]["err"]}"
		return 0
	fi
	if ! xs_connect "$id"; then
		if [ $((EPOCHSECONDS - ${XS[$id]["t0"]:-0})) -gt 10 ]; then
			XS[$id]["err"]="Xvfb did not start"
		else
			t := dt_tr "Starting the X screen…"
			console put -p "w$id" 2 2 "$t"
			dt_want 200
		fi
		return 0
	fi
	x=${XS[$id]["x"]}
	sz := xscr size "$x"
	sw=${sz% *}
	sh=${sz#* }
	m=${XS[$id]["pic"]}
	[ "$m" = follow ] && m=${DT_IMGMODE:-auto}
	XS[$id]["pix"]=0
	case $m in
	pixels | sixel) XS[$id]["pix"]=1 ;;
	auto) dt_imgwill auto && XS[$id]["pix"]=1 ;;
	esac
	xs_cell "$id"
	# Fitted: the program is the window's size in pixels and the window
	# shows that corner of the screen 1:1. The size is sent again only
	# when it changes -- a resize, or a terminal with another cell size.
	if [ "${XS[$id]["win"]}" = fit ]; then
		fw=$((w * XS_CW))
		fh=$((h * XS_CH))
		if [ "$fw" -le "$sw" ] && [ "$fh" -le "$sh" ]; then
			if [ "${XS[$id]["fitwh"]}" != "$fw $fh" ]; then
				xscr fit "$x" "$fw" "$fh"
				XS[$id]["fitwh"]="$fw $fh"
			fi
			XS[$id]["r0"]=1
			XS[$id]["c0"]=1
			XS[$id]["rh"]=$h
			XS[$id]["rw"]=$w
			sw=$fw
			sh=$fh
			crop=-c
		fi
	fi
	[ -n "$crop" ] || xs_place "$id" "$h" "$w" "$sw" "$sh"
	XS[$id]["sw"]=$sw
	XS[$id]["sh"]=$sh
	m=half
	[ "${XS[$id]["pix"]}" = 1 ] && m=pixels
	xscr draw "$x" "${XS[$id]["r0"]}" "${XS[$id]["c0"]}" \
		"${XS[$id]["rh"]}" "${XS[$id]["rw"]}" -p "w$id" -m "$m" $crop \
		2> /dev/null
	xs_retitle "$id"
	XS[$id]["drew"]="${DT[$id]["h"]} ${DT[$id]["w"]} ${XS[$id]["pic"]} $DT_IMGMODE"
	XS[$id]["at"] := dt_ms
	return 0
}

# The window wears the program's name, and the program's own title beside
# it once it gives one.
fn xs_retitle(int id) {
	local t c

	t := xscr title "${XS[$id]["x"]}" 2> /dev/null
	[ "$t" = "${XS[$id]["title"]}" ] && [ -n "${XS[$id]["titled"]}" ] &&
		return 0
	XS[$id]["title"]=$t
	XS[$id]["titled"]=1
	c := dt_wintitle "${XS[$id]["name"]}" "$t"
	dt_retitle "$id" "$c"
}

# Clean while the screen has not changed and nothing about the window has:
# its size and how it is drawn. A screen that changes faster than
# DT_TERMMS -- an animation, a film -- is drawn at that rate and no faster,
# as a terminal's output is: the change is kept, and the frame is asked
# for when the period is up. The server says nothing more until the screen
# has been drawn, so a window waiting, hidden or minimised costs nothing.
# Whether the window's program has ended and the window is to close with it
# (Gitea #308): the program's own When It Ends, or for default Close When
# It Ends. Ended is every process it started gone *and* no window of it
# left on the screen -- a program whose first process forks and leaves has
# its window up still -- and not before the screen has had three seconds
# to show one. The server is asked about windows once a second at most.
fn xs_endcheck(int id) {
	local x=${XS[$id]["x"]} e=${XS[$id]["end"]:-default} p n

	case $e in
	close) ;;
	default) [ "$XS_CLOSEEND" = 1 ] || return 0 ;;
	*) return 0 ;;
	esac
	[ -n "$x" ] || return 0
	if [ $((EPOCHSECONDS - ${XS[$id]["t0"]:-$EPOCHSECONDS})) -lt 3 ]; then
		dt_want 1000
		return 0
	fi
	for p in ${XS[$id]["pids"]}; do
		kill -0 "$p" 2> /dev/null && return 0
	done
	if [ $((EPOCHSECONDS - ${XS[$id]["wat"]:-0})) -lt 1 ]; then
		dt_want 1000
		return 0
	fi
	XS[$id]["wat"]=$EPOCHSECONDS
	n := xscr windows "$x" 2> /dev/null
	[ "${n:-1}" -gt 0 ] && return 0
	dt_wantclose "$id"
}

fn xscreen_dirty(int id) {
	local x=${XS[$id]["x"]} st=0 now left

	[ -n "$x" ] || return 0
	xs_endcheck "$id"
	xscr poll "$x" 2> /dev/null || st=$?
	[ "$st" = 2 ] && { XS[$id]["err"]="The X screen has ended"; return 0; }
	if [ "$st" = 0 ]; then
		now := dt_ms
		left=$((${XS[$id]["at"]:-0} + ${DT_TERMMS:-70} - now))
		if [ "$left" -gt 0 ]; then
			dt_want "$left"
			return 1
		fi
		return 0
	fi
	[ "${XS[$id]["drew"]}" = "${DT[$id]["h"]} ${DT[$id]["w"]} ${XS[$id]["pic"]} $DT_IMGMODE" ] &&
		return 1
	return 0
}

# The server's messages are read whether or not the window is drawn, or its
# socket would wake the desktop for ever.
fn xscreen_idle(int id) {
	[ -n "${XS[$id]["x"]}" ] && xscr poll "${XS[$id]["x"]}" > /dev/null 2>&1
	xs_endcheck "$id"
	return 0
}

# A window cell to the X screen's pixel under it, into XS_PX and XS_PY;
# status 1 outside the screen.
XS_PX=0
XS_PY=0
fn xs_at(int id, int r, int c) {
	local r0=${XS[$id]["r0"]} c0=${XS[$id]["c0"]} rh=${XS[$id]["rh"]} rw=${XS[$id]["rw"]}

	[ -n "$r0" ] || return 1
	[ "$r" -ge "$r0" ] && [ "$r" -lt $((r0 + rh)) ] &&
		[ "$c" -ge "$c0" ] && [ "$c" -lt $((c0 + rw)) ] || return 1
	XS_PX=$(((2 * (c - c0) + 1) * ${XS[$id]["sw"]} / (2 * rw)))
	XS_PY=$(((2 * (r - r0) + 1) * ${XS[$id]["sh"]} / (2 * rh)))
	return 0
}

fn xscreen_key(int id, key) {
	local x=${XS[$id]["x"]}

	[ -n "$x" ] || return 1
	if [ "$DT_TERMKEEP" = 1 ] && dt_has dt_keyassigned &&
	   dt_keyassigned "$key"; then
		return 1
	fi
	xscr key "$x" "$key" 2> /dev/null
	return 0
}

# A press, a drag and a release, as the window manager hands them over:
# the button goes down where it was pressed and the pointer follows it.
fn xscreen_mouse(int id, act, btn, int r, int c, mods = "") {
	local x=${XS[$id]["x"]} b=1

	[ -n "$x" ] || return 0
	xs_at "$id" "$r" "$c" || return 0
	case $btn in middle) b=2 ;; right) b=3 ;; esac
	case ${act##*-} in
	press) xscr button "$x" press "$b" "$XS_PX" "$XS_PY" ;;
	release) xscr button "$x" release "$b" "$XS_PX" "$XS_PY" ;;
	drag) xscr move "$x" "$XS_PX" "$XS_PY" ;;
	esac
	return 0
}

fn xscreen_click(int id, int r, int c, btn = "") {
	return 0
}

fn xscreen_wheel(int id, dir, int r, int c) {
	local x=${XS[$id]["x"]}

	[ -n "$x" ] || return 0
	xs_at "$id" "$r" "$c" || return 0
	xscr wheel "$x" "$dir" "$XS_PX" "$XS_PY"
	return 0
}

# Text pasted into the window is typed into the screen.
fn xscreen_paste(int id, text, op = "") {
	[ -n "${XS[$id]["x"]}" ] && xscr type "${XS[$id]["x"]}" "$text"
	return 0
}

fn xscreen_close(int id) {
	local p fd=${XS[$id]["fd"]}

	[ -n "$fd" ] && command -v console > /dev/null && console unwatch "$fd"
	if [ -n "${XS[$id]["x"]}" ]; then
		xscr close "${XS[$id]["x"]}" 2> /dev/null
	elif [ -n "${XS[$id]["srv"]}" ]; then
		xscr stop "${XS[$id]["srv"]}" 2> /dev/null
	fi
	for p in ${XS[$id]["pids"]}; do
		kill "$p" 2> /dev/null
	done
	[ -n "${XS[$id]["dir"]}" ] && command rm -rf -- "${XS[$id]["dir"]}"
	unset "XS[$id]"
}

# Restart Desktop: the server and its programs are this shell's children
# and should run on across the exec; the connection does not, so it is made
# again on the first frame after, and the window manager taken up again.
fn xscreen_stash(int id, dir) {
	XS[$id]["x"]=
	XS[$id]["fd"]=
	return 0
}
fn xscreen_resume(int id) {
	XS[$id]["x"]=
	XS[$id]["fd"]=
	XS[$id]["run"]=
	XS[$id]["fitwh"]=
	return 0
}

xscreen_menus() {
	dt_menu "File"
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
}
