#!/usr/bin/env hibr
#
# screens -- programs in windows of their own (Gitea #493): one list of
# programs, each run on the engine it chooses.
#
#   X Screen        Xvfb on the CPU: X11 programs, the clipboard both ways,
#                   and a window that fits, is a fixed size or is the
#                   program's own. Needs no GPU. (Gitea #290, #291)
#   Wayland Screen  Blit's gamescope bridge on the GPU: X11 and Wayland
#                   programs, frames handed over by descriptor, real key
#                   presses and releases through Blit's input route. Its
#                   size is the window's and its rate the display's.
#                   (Gitea #486)
#
# Steam is on the list by itself wherever `steam` is installed: Big Picture
# on Wayland Screen with Steam's integration, every key to it, and the
# pointer left free, since gamescope's picture carries no pointer and Blit
# hides its own while it is held. Changed in the pane, it is kept as any
# other program is.
#
# X Screen runs Firefox, GTK and Qt programs, and anything else that speaks
# X11. Each window starts an Xvfb of its own, a virtual X server that draws
# the screen
# into a file it maps, and the xscr module maps the same file and puts the
# screen into the window -- as pixels where the terminal can place them,
# half blocks where it cannot. Keys, clicks, drags, the wheel and paste go
# to it through XTEST; the screen is drawn only when the server says it
# changed (DAMAGE), so an idle or hidden one costs nothing. What a program
# copies -- its own Copy, ctrl-c in Firefox -- comes back as the desktop's
# clipboard (Gitea #424), and the desktop's Copy takes the X selection.
#
# The programs are a list Control Panel > Screens keeps -- a name, a
# command, its engine, how its window behaves and how it is drawn -- and
# each one is an entry under Applications > Screens, opening a window titled
# for it and, once an X program names its own window, `Name [its title]`.
# The app itself is hidden: an empty screen is nothing to choose. The list
# is still the file X Screen kept, xscreen.tsv, and a program's engine is
# one more of its options (engine=wayland), so every program X Screen had
# is an X Screen program here and the file still reads in X Screen.
#
# Its names are scn_ and SCN, never X Screen's xs_ and XS: X Screen and the
# Steam window may still be installed beside it until they are removed, and
# two files defining one name would each replace the other's. Only the
# settings are shared, XS_* and the pane's, on purpose: they are the same
# settings, and dt_keep keeps a name once.
#
# How a program's window behaves:
#   fit    the module is the screen's window manager, keeps the program's
#          window exactly the hibr window's size in pixels and follows a
#          resize; only that corner of the screen is sent, so a small window
#          is a small picture. The screen is Largest Screen in size, and a
#          window larger than that is the screen, scaled.
#   fixed  a screen of Fixed Size, scaled into the window with its shape.
#   own    the same, with no window manager of the module's, for a program
#          that is one -- two cannot share a screen.
#
# The pointer follows the mouse with no button held whenever Control Panel
# > Mouse > Hover is on (Gitea #404); a program may take every key, and may
# hold the pointer for relative motion, each in its own dialog.
#
# What X Screen cannot do yet: keys outside the server's US keyboard map,
# and a paste that is not typed -- a paste is the text typed into the
# program.
#
# Wayland Screen: the bridge (blit-gamescope) runs gamescope with the
# program inside it and sends every picture as a frame by descriptor; in a
# window it is given the frames module's socket in place of Blit's own, so
# the frames go through the console onto the picture this window places and
# on to every display's Blit. Input never passes through the desktop: the
# bridge asks Blit for an input route to gamescope, which this window turns
# on while it has the keys (`_focus`). The window's size when it starts is
# gamescope's for the session; a resize afterwards is Blit scaling the
# picture, since gamescope is never restarted under a running program.

strict


app screens "Programs in windows of their own, on X Screen or Wayland Screen" 3.0
# modules: xscr
# part: control-panel/screensset.hibr
command -v dt_app > /dev/null &&
	dt_app screens "Screens" 26 90 many "▣" "" hidden
command -v dt_keepstate > /dev/null && dt_keepstate screens SCN

declare -gA SCN
XS_SIZE="${XS_SIZE-1280x800}"
XS_MAX="${XS_MAX-1920x1080}"
XS_CLOSEEND="${XS_CLOSEEND-0}"
command -v dt_keep > /dev/null && dt_keep XS_SIZE XS_MAX XS_CLOSEEND

# What every program's screen gets unless the program says otherwise
# (Gitea #404): frames a second (follow is Frames For Output), the
# background colour painted on the root (default leaves Xvfb's own), the
# pointer Xvfb draws, its dots per inch, whether it stays up after its last
# client goes, which of six extensions it offers, and anything else for
# Xvfb as typed. A program keeps its own in SCNP_OPT, "key=value;..." with
# only what differs from these, and its extra flags in SCNP_EXTRA.
XS_FPS="${XS_FPS-follow}"
XS_BG="${XS_BG-default}"
XS_CURSOR="${XS_CURSOR-1}"
XS_DPI="${XS_DPI-default}"
XS_NORESET="${XS_NORESET-0}"
XS_XINERAMA="${XS_XINERAMA-1}"
XS_RENDER="${XS_RENDER-1}"
XS_COMPOSITE="${XS_COMPOSITE-1}"
XS_DBE="${XS_DBE-1}"
XS_XVIDEO="${XS_XVIDEO-1}"
XS_GLX="${XS_GLX-1}"
XS_EXTRA="${XS_EXTRA-}"
# And how the program is reached: every key while its window has the focus,
# the desktop's shortcuts with them, Release Pointer still leaving; and the
# pointer held for relative motion, as a game wants, from a click in; and
# the program's own pointer, drawn by its server, shown alone over the
# window where hovering is on, with the desktop's own hidden there.
XS_KEYS="${XS_KEYS-0}"
XS_REL="${XS_REL-0}"
XS_OWNPTR="${XS_OWNPTR-1}"
command -v dt_keep > /dev/null && dt_keep XS_FPS XS_BG XS_CURSOR XS_DPI \
	XS_NORESET XS_XINERAMA XS_RENDER XS_COMPOSITE XS_DBE XS_XVIDEO XS_GLX XS_EXTRA \
	XS_KEYS XS_REL XS_OWNPTR
# The option keys a program may set, each with the variable holding its
# default; the extensions with the name Xvfb knows each by.
declare -gA SCN_OPTVAR SCN_EXTNAME
SCN_OPTVAR=([fps]=XS_FPS [size]=XS_SIZE [bg]=XS_BG [cursor]=XS_CURSOR
	[dpi]=XS_DPI [noreset]=XS_NORESET [xinerama]=XS_XINERAMA
	[render]=XS_RENDER [composite]=XS_COMPOSITE [dbe]=XS_DBE
	[xvideo]=XS_XVIDEO [glx]=XS_GLX [keys]=XS_KEYS [rel]=XS_REL
	[ownptr]=XS_OWNPTR)
SCN_EXTNAME=([xinerama]=XINERAMA [render]=RENDER [composite]=Composite
	[dbe]=DOUBLE-BUFFER [xvideo]=XVideo [glx]=GLX)
SCN_EXTS=(xinerama render composite dbe xvideo glx)

# The programs, as the file holds them: a name, a command, a window, a
# picture and what happens when it ends (Gitea #308: default, close or
# keep -- default is Close When It Ends), a tab between, each a line; the
# five arrays are that file read. The fifth was added after, so a line
# without one reads as default; an older desktop reading a line with one
# takes the picture and the fifth together and falls back to follow.
SCN_LIST="${SCN_LIST-${XDG_DATA_HOME:-$HOME/.local/share}/hibr/xscreen.tsv}"
SCNP_NAME=()
SCNP_CMD=()
SCNP_WIN=()
SCNP_PIC=()
SCNP_END=()
SCNP_OPT=()
SCNP_EXTRA=()
# 1 for the row the app puts on the list itself, which is not in the file
# until it is changed: Steam, where steam is installed.
SCNP_VIRT=()

# The command the Steam row runs, and a session or a test may name another
# bridge to run it under.
SCN_STEAM=${SCN_STEAM:-steam -gamepadui}
SCN_BRIDGE=${SCN_BRIDGE:-}

# Read the list. A line with a field missing is passed over; no field is
# ever written empty, since a tab is IFS whitespace and an empty middle
# field would shift the rest.
scn_load() {
	SCNP_NAME=()
	SCNP_CMD=()
	SCNP_WIN=()
	SCNP_PIC=()
	SCNP_END=()
	SCNP_OPT=()
	SCNP_EXTRA=()
	SCNP_VIRT=()
	[ -r "$SCN_LIST" ] && scn_read
	scn_steamrow
	return 0
}

# The file's lines into the arrays.
scn_read() {
	local n c w p e o x

	while IFS=$'\t' read -r n c w p e o x; do
		[ -n "$n" ] && [ -n "$c" ] || continue
		case $w in fit | fixed | own) ;; *) w=fit ;; esac
		case $p in follow | half | pixels) ;; *) p=follow ;; esac
		case $e in default | close | keep) ;; *) e=default ;; esac
		SCNP_NAME+=("$n")
		SCNP_CMD+=("$c")
		SCNP_WIN+=("$w")
		SCNP_PIC+=("$p")
		SCNP_END+=("$e")
		[ "$o" = - ] && o=
		[ "$x" = - ] && x=
		SCNP_OPT+=("$o")
		SCNP_EXTRA+=("$x")
		SCNP_VIRT+=(0)
	done < "$SCN_LIST"
	return 0
}

# Steam's row, last, where steam is installed and no program is already
# Steam -- called so, or running what this row runs, so the row changed and
# renamed in the pane does not bring it back beside itself: Wayland Screen
# with Steam's integration, every key to it, and the pointer free.
scn_steamrow() {
	local i

	command -v steam > /dev/null 2>&1 || return 0
	for i in "${!SCNP_NAME[@]}"; do
		[ "${SCNP_NAME[$i]}" = Steam ] && return 0
		[ "${SCNP_CMD[$i]}" = "$SCN_STEAM" ] && return 0
	done
	SCNP_NAME+=(Steam)
	SCNP_CMD+=("$SCN_STEAM")
	SCNP_WIN+=(fit)
	SCNP_PIC+=(follow)
	SCNP_END+=(default)
	SCNP_OPT+=("engine=wayland;steam=1;keys=1;rel=0")
	SCNP_EXTRA+=("")
	SCNP_VIRT+=(1)
	return 0
}

# Write the list back, through a temporary file and a rename.
scn_save() {
	local i tmp="$SCN_LIST.$$"

	mkdir -p "${SCN_LIST%/*}" 2> /dev/null
	{
		for i in "${!SCNP_NAME[@]}"; do
			[ "${SCNP_VIRT[$i]:-0}" = 1 ] && continue
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${SCNP_NAME[$i]}" "${SCNP_CMD[$i]}" \
				"${SCNP_WIN[$i]}" "${SCNP_PIC[$i]}" "${SCNP_END[$i]:-default}" \
				"${SCNP_OPT[$i]:--}" "${SCNP_EXTRA[$i]:--}"
		done
	} > "$tmp" && command mv -f -- "$tmp" "$SCN_LIST"
}

# Put every program on the menu, under Applications > Screens, taking off
# whatever was there: called when the app loads and whenever the list
# changes.
scn_register() {
	local i

	dt_has dt_appvia || return 0
	dt_appunvia screens
	for i in "${!SCNP_NAME[@]}"; do
		dt_appvia "screens:$i" "${SCNP_NAME[$i]}" screens \
			"${SCNP_NAME[$i]}" "Applications/Screens"
	done
	return 0
}

# A program's own value for an option key, or default when it has none.
fn scn_popt(int k, key) {
	local o=";${SCNP_OPT[$k]};" v

	case $o in
	*";$key="*) v=${o#*";$key="}; ret "${v%%;*}" ;;
	*) ret default ;;
	esac
}

# What an option comes to for program k: its own, or the pane's default.
fn scn_optval(int k, key) {
	local v vn=${SCN_OPTVAR["$key"]}

	v := scn_popt "$k" "$key"
	[ "$v" = default ] && v=${!vn}
	ret "$v"
}

# Set or clear (default) program k's own value for a key.
fn scn_setopt(int k, key, val) {
	local out= f
	local -a parts

	IFS=';' read -ra parts <<< "${SCNP_OPT[$k]}"
	for f in "${parts[@]}"; do
		[ -n "$f" ] || continue
		[ "${f%%=*}" = "$key" ] && continue
		out="$out;$f"
	done
	[ "$val" = default ] || out="$out;$key=$val"
	SCNP_OPT[$k]=${out#;}
	return 0
}

# The Xvfb flags program k's screen starts with, into SCN_ARGS.
declare -ga SCN_ARGS
fn scn_args(int k) {
	local v e
	local -a x

	SCN_ARGS=()
	v := scn_optval "$k" cursor
	[ "$v" = 0 ] && SCN_ARGS+=(-nocursor)
	v := scn_optval "$k" dpi
	[ "$v" = default ] || SCN_ARGS+=(-dpi "$v")
	v := scn_optval "$k" noreset
	[ "$v" = 1 ] && SCN_ARGS+=(-noreset)
	for e in "${SCN_EXTS[@]}"; do
		v := scn_optval "$k" "$e"
		[ "$v" = 0 ] && SCN_ARGS+=(-extension "${SCN_EXTNAME["$e"]}")
	done
	read -ra x <<< "$XS_EXTRA ${SCNP_EXTRA[$k]}"
	SCN_ARGS+=("${x[@]}")
	return 0
}

# Read the list again and put it on the menu: what the pane calls after
# every change.
scn_reload() {
	scn_load
	scn_register
}

scn_load
scn_register

# Take away the screen folders a desktop that is no longer running left
# behind -- one that crashed or was killed never closed its windows, and
# each holds a screen in memory-backed storage. A folder is named for the
# desktop's pid, which is how one still in use is told apart.
scn_sweep() {
	local d p

	for d in "${XDG_RUNTIME_DIR:-/tmp}"/hibr-screens-*; do
		[ -d "$d" ] || continue
		p=${d##*/hibr-screens-}
		p=${p%%-*}
		case $p in *[!0-9]* | "") continue ;; esac
		kill -0 "$p" 2> /dev/null && continue
		command rm -rf -- "$d"
	done
	return 0
}

# A display number nothing else has: the first from 20 up with no socket.
scn_free() {
	local n=20

	while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ]; do
		n=$((n + 1))
	done
	ret "$n"
}

# Start a program on the window's screen, as a job of this shell so the
# shell reaps it, its pid kept so closing the window can end it. The
# environment goes through env as words, not as assignments, which a strict
# file would read as globals being made.
fn scn_run(int id, cmd) {
	local n=${SCN[$id]["n"]}
	local -a e

	[ -n "$n" ] && [ -n "$cmd" ] || return 1
	e=("DISPLAY=:$n" "GDK_BACKEND=x11" "QT_QPA_PLATFORM=xcb")
	env -u WAYLAND_DISPLAY "${e[@]}" /bin/sh -c "$cmd" > /dev/null 2>&1 &
	SCN[$id]["pids"]="${SCN[$id]["pids"]} $!"
	return 0
}

# --- Wayland Screen ---------------------------------------------------------

# The bridge to start: the one named, then the one on the path, then where
# the Blit package keeps it. Status 1 when there is none.
scn_bridge() {
	local b

	if [ -n "$SCN_BRIDGE" ]; then
		ret "$SCN_BRIDGE"
		return 0
	fi
	if b := command -v blit-gamescope 2> /dev/null; then
		ret "$b"
		return 0
	fi
	if [ -x /usr/lib/blit/bin/blit-gamescope ]; then
		ret /usr/lib/blit/bin/blit-gamescope
		return 0
	fi
	return 1
}

# Where a Wayland Screen's bridge writes its log, and what it printed
# before its own log was open.
scn_wlog() {
	ret "${XDG_STATE_HOME:-$HOME/.local/state}/hibr/screens.log"
}

# A new Wayland Screen window: a socket for the bridge's frames, every key
# when the program takes them, and the bridge itself started at the first
# drawing, when the window's size is known.
fn scn_wopen(int id, int k) {
	local x n sock tok b e v

	SCN[$id]["eng"]=wayland
	SCN[$id]["err"]=
	SCN[$id]["pid"]=
	SCN[$id]["drew"]=
	SCN[$id]["seen"]=
	SCN[$id]["t0"]=
	SCN[$id]["steam"] := scn_popt "$k" steam
	SCN[$id]["keys"] := scn_optval "$k" keys
	SCN[$id]["rel"] := scn_optval "$k" rel
	if ! b := scn_bridge; then
		e := dt_tr "Wayland Screen needs Blit's gamescope bridge: install the blit-gamescope package"
		SCN[$id]["err"]=$e
		return 0
	fi
	SCN[$id]["bridge"]=$b
	if ! need frames 2> /dev/null || ! x := frames serve 2> /dev/null; then
		e := dt_tr "This display cannot show another program's frames"
		SCN[$id]["err"]=$e
		return 0
	fi
	read -r n sock tok <<< "$x"
	SCN[$id]["fn"]=$n
	SCN[$id]["sock"]=$sock
	SCN[$id]["tok"]=$tok
	[ "${SCN[$id]["keys"]}" = 1 ] && dt_keysall "$id" on
	return 0
}

# A refresh rate in whole hertz, rounded: 59.997 is 60. Nothing for a value
# that is not a positive number.
fn scn_round(v) {
	local n f

	[[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
	n=${v%%.*}
	f=${v#"$n"}
	f=${f#.}
	n=$((10#$n))
	case ${f:0:1} in [5-9]) n=$((n + 1)) ;; esac
	[ "$n" -gt 0 ] || return 1
	ret "$n"
}

# The refresh rate of the display the desktop is shown on, from Blit's own
# API with what Blit gives the desktop's session (BLIT_SERVER_PORT,
# BLIT_API_TOKEN, BLIT_PANE_ID, Blit ADR 0055): the pane, then the pane's
# display, then that display's mode. With no pane to go by, the fastest
# display. Nothing when Blit does not answer, and the bridge keeps its own
# default -- a rate is passed only when it is known. It runs once, when the
# window first draws, so each request is bounded to a second and a Blit that
# does not answer the first is not asked a second time: a wedged Blit costs
# the launch one second, never a frozen desktop. DAV_CODE is the dav
# module's own, declared here since a strict file creates no globals.
DAV_CODE=${DAV_CODE-}
fn scn_hz() {
	local port=${BLIT_SERVER_PORT:-} tok=${BLIT_API_TOKEN:-} pane=${BLIT_PANE_ID:-}
	local HIBR_DAV_TIMEOUT=1 r disp= i v hz best=0
	local -A top dsp

	[[ $port =~ ^[0-9]+$ ]] && [ -n "$tok" ] || return 1
	need dav 2> /dev/null || return 1
	if [ -n "$pane" ]; then
		r := dav request -H "Authorization: Bearer $tok" GET "http://127.0.0.1:$port/v1/topology" 2> /dev/null || r=
		case ${DAV_CODE:-0} in 0 | 000) return 1 ;; esac
		if [ -n "$r" ] && json parse top "$r" 2> /dev/null; then
			i=0
			while [ -n "${top["panes"][$i]["id"]-}" ]; do
				if [ "${top["panes"][$i]["id"]}" = "$pane" ]; then
					disp=${top["panes"][$i]["display_id"]-}
					break
				fi
				i=$((i + 1))
			done
		fi
	fi
	r := dav request -H "Authorization: Bearer $tok" GET "http://127.0.0.1:$port/v1/displays" 2> /dev/null || return 1
	[ -n "$r" ] && json parse dsp "$r" 2> /dev/null || return 1
	i=0
	while [ -n "${dsp["displays"][$i]["id"]-}" ]; do
		v=${dsp["displays"][$i]["active_mode"]["refresh_hz"]-}
		if hz := scn_round "$v"; then
			if [ -n "$disp" ]; then
				if [ "${dsp["displays"][$i]["id"]}" = "$disp" ]; then
					ret "$hz"
				fi
			elif [ "$hz" -gt "$best" ]; then
				best=$hz
			fi
		fi
		i=$((i + 1))
	done
	[ -z "$disp" ] && [ "$best" -gt 0 ] || return 1
	ret "$best"
}

# Start the bridge for a content rectangle of h by w cells: gamescope's
# output is that many pixels, which is also its pointer's coordinate space.
# Its log goes to a file of its own -- the bridge writes it there itself
# with --log, and anything it prints before that goes to the same file --
# never to a descriptor the desktop watches: every line there would wake the
# desktop and draw a frame, many a second while a game runs. The pty is
# only so that closing the window hangs the bridge up (-x), and so nothing
# watches it. A command with nothing for a shell in it is passed as its
# words, as the Steam window always passed Steam; anything else -- quotes,
# a variable, an assignment in front -- goes through /bin/sh, as X Screen's
# commands do.
fn scn_wstart(int id, int h, int w) {
	local g cw=0 ch=0 kind p e hz b=${SCN[$id]["bridge"]} c=${SCN[$id]["run"]} log
	local -a run cmd

	log := scn_wlog
	g := console gfx 2> /dev/null
	read -r kind cw ch <<< "$g"
	[ "${cw:-0}" -gt 0 ] || cw=8
	[ "${ch:-0}" -gt 0 ] || ch=16
	case $c in
	*[\'\"\$\;\|\&\<\>\`\\\(\)\*\?\~=]*) run=(/bin/sh -c "$c") ;;
	*) read -ra run <<< "$c" ;;
	esac
	mkdir -p "${log%/*}" 2> /dev/null
	cmd=("$HIBR" -c 'exec "$@" >> "$0" 2>&1' "$log"
	     env "BLIT_FRAME_SOCKET=${SCN[$id]["sock"]}"
	     "BLIT_FRAME_TOKEN=${SCN[$id]["tok"]}" "$b" --no-place)
	[ "${SCN[$id]["steam"]}" = 1 ] && cmd+=(--steam)
	cmd+=(-W $((w * cw)) -H $((h * ch)))
	if hz := scn_hz; then
		cmd+=(-r "$hz")
	fi
	cmd+=(--log "$log")
	cmd+=(-- "${run[@]}")
	SCN[$id]["t0"]=$EPOCHSECONDS
	need pty 2> /dev/null
	# fork: once, the bridge itself, on the window's first drawing
	if ! p := pty spawn -x -r "$h" -c "$w" "${cmd[@]}" 2> /dev/null; then
		e := dt_tr "%s could not be started" "${SCN[$id]["name"]}"
		SCN[$id]["err"]=$e
		return 1
	fi
	SCN[$id]["pid"]=$p
	return 0
}

# What the frames have done so far -- connected, frames, rgb and input, as
# the frames module says them -- into SCN_I_*.
SCN_I_CONNECTED=0
SCN_I_FRAMES=0
SCN_I_RGB=0
SCN_I_INPUT=none
fn scn_winfo(int id) {
	local i kv
	local -a f

	SCN_I_CONNECTED=0
	SCN_I_FRAMES=0
	SCN_I_RGB=0
	SCN_I_INPUT=none
	[ -n "${SCN[$id]["fn"]}" ] || return 0
	i := frames info "${SCN[$id]["fn"]}" 2> /dev/null
	read -ra f <<< "$i"
	for kv in "${f[@]}"; do
		case $kv in
		"connected="*) SCN_I_CONNECTED=${kv#*=} ;;
		"frames="*) SCN_I_FRAMES=${kv#*=} ;;
		"rgb="*) SCN_I_RGB=${kv#*=} ;;
		"input="*) SCN_I_INPUT=${kv#*=} ;;
		esac
	done
	return 0
}

# Draw: the picture where the frames are, or a line saying why not yet.
# The body starts at row 1, column 1 inside the frame, and at 0, 0 when the
# window has none -- in full screen, whose body is the whole pane.
fn scn_wdraw(int id, int h, int w) {
	local t o=1

	[ "${DT[$id]["chrome"]-}" = none ] && o=0
	if [ -z "${SCN[$id]["err"]}" ] && [ -z "${SCN[$id]["pid"]}" ]; then
		scn_wstart "$id" "$h" "$w"
	fi
	scn_wdrain "$id"
	scn_winfo "$id"
	SCN[$id]["seen"]="$SCN_I_CONNECTED $((SCN_I_FRAMES > 0)) $SCN_I_RGB $SCN_I_INPUT ${SCN[$id]["err"]}"
	if [ -z "${SCN[$id]["err"]}" ] && [ -n "${SCN[$id]["fn"]}" ] &&
	   frames place "${SCN[$id]["fn"]}" "w$id" "$o" "$o" "$h" "$w" 2> /dev/null; then
		SCN[$id]["drew"]="${DT[$id]["h"]} ${DT[$id]["w"]}"
		return 0
	fi
	SCN[$id]["drew"]=
	if [ -n "${SCN[$id]["err"]}" ]; then
		t=${SCN[$id]["err"]}
	elif [ "$SCN_I_CONNECTED" = 1 ]; then
		t := dt_tr "Waiting for %s's first picture" "${SCN[$id]["name"]}"
	else
		t := dt_tr "Starting %s" "${SCN[$id]["name"]}"
	fi
	console pen "$DT_DIM" "$DT_FACE"
	console put -p "w$id" $(((h + 1) / 2)) $(((w - ${#t}) / 2 + 1)) "$t"
	return 0
}

# Drawn again only when what it shows can have changed: the first frame,
# the bridge connecting or going, a picture it has to draw itself, the
# input route's state, or the window's size. Frames themselves pass in the
# console without the desktop drawing anything.
fn scn_wdirty(int id) {
	scn_winfo "$id"
	[ "${SCN[$id]["seen"]}" = "$SCN_I_CONNECTED $((SCN_I_FRAMES > 0)) $SCN_I_RGB $SCN_I_INPUT ${SCN[$id]["err"]}" ] || return 0
	[ "${SCN[$id]["drew"]}" = "${DT[$id]["h"]} ${DT[$id]["w"]}" ] && return 1
	[ -z "${SCN[$id]["drew"]}" ] && [ -n "${SCN[$id]["seen"]}" ] && return 1
	return 0
}

# Whether the bridge is still running, from the drawing and from `_idle`
# both, since a drawn window is never idle and a hidden one is never drawn;
# its socket closing is what wakes the desktop to ask. Anything it printed
# before its own log was open is drained so the pty never fills. When it
# has ended the window closes, as When It Ends says -- but not in its first
# three seconds, which is a program that never started, and says so.
fn scn_wdrain(int id) {
	local p=${SCN[$id]["pid"]} out e end=${SCN[$id]["end"]:-default} log

	[ -n "$p" ] || return 0
	out := pty drain "$p" 0 2> /dev/null
	pty alive "$p" 2> /dev/null && return 0
	[ -n "${SCN[$id]["err"]}" ] && return 0
	if [ $((EPOCHSECONDS - ${SCN[$id]["t0"]:-0})) -lt 3 ]; then
		log := scn_wlog
		e := dt_tr "%s ended as it started -- its log is %s" "${SCN[$id]["name"]}" "$log"
		SCN[$id]["err"]=$e
		dt_want 30
		return 0
	fi
	case $end in
	close) dt_wantclose "$id"; return 0 ;;
	default) [ "$XS_CLOSEEND" = 1 ] && { dt_wantclose "$id"; return 0; } ;;
	esac
	e := dt_tr "%s has ended" "${SCN[$id]["name"]}"
	SCN[$id]["err"]=$e
	dt_want 30
	return 0
}

# Keys to the Program, for the focused window: on, it takes every key but
# Release Pointer, Full Screen and Leave Full Screen; off, the desktop's
# shortcuts work over it again.
scn_keystoggle() {
	local id=$DT_FOCUS

	[ -n "$id" ] || return 0
	if [ "${DT[$id]["keysall"]-}" = 1 ]; then
		dt_keysall "$id" off
	else
		dt_keysall "$id" on
	fi
	return 0
}

# --- X Screen ---------------------------------------------------------------

# The server is the module's to start and end (xscr start), not a job of
# this shell's: the module ends it when the shell goes, so quitting the
# desktop takes the screen and the programs on it with it, where a job
# would run on after the desktop had gone.
fn screens_open(int id, arg = "") {
	local n dir srv= i k=-1 sz v cur

	for i in "${!SCNP_NAME[@]}"; do
		[ "${SCNP_NAME[$i]}" = "$arg" ] && { k=$i; break; }
	done
	if [ "$k" -lt 0 ]; then
		SCN[$id]["err"]="No such program -- add one in Control Panel > X Screen"
		return 0
	fi
	SCN[$id]["name"]=${SCNP_NAME[$k]}
	SCN[$id]["run"]=${SCNP_CMD[$k]}
	SCN[$id]["win"]=${SCNP_WIN[$k]}
	SCN[$id]["pic"]=${SCNP_PIC[$k]}
	SCN[$id]["end"]=${SCNP_END[$k]:-default}
	SCN[$id]["eng"]=x
	v := scn_popt "$k" engine
	if [ "$v" = wayland ]; then
		scn_wopen "$id" "$k"
		return 0
	fi
	if ! command -v Xvfb > /dev/null; then
		SCN[$id]["err"]="X Screen needs Xvfb -- install the xvfb package"
		return 0
	fi
	need xscr 2> /dev/null || {
		SCN[$id]["err"]="The xscr module is not installed"
		return 0
	}
	sz := scn_optval "$k" size
	[ "${SCN[$id]["win"]}" = fit ] && sz=$XS_MAX
	v := scn_optval "$k" fps
	SCN[$id]["ms"]=
	[ "$v" = follow ] || SCN[$id]["ms"]=$((1000 / v))
	SCN[$id]["bg"] := scn_optval "$k" bg
	SCN[$id]["keys"] := scn_optval "$k" keys
	SCN[$id]["rel"] := scn_optval "$k" rel
	v := scn_optval "$k" ownptr
	cur := scn_optval "$k" cursor
	[ "$v" = 1 ] && [ "$cur" != 0 ] && dt_pointer "$id" none
	scn_args "$k"
	scn_sweep
	n := scn_free
	dir="${XDG_RUNTIME_DIR:-/tmp}/hibr-screens-$$-$id"
	mkdir -p "$dir" 2> /dev/null
	srv := xscr start "$n" "$sz" "$dir" "${SCN_ARGS[@]}" 2> /dev/null
	SCN[$id]["n"]=$n
	SCN[$id]["dir"]=$dir
	SCN[$id]["srv"]=$srv
	SCN[$id]["pids"]=
	SCN[$id]["x"]=
	SCN[$id]["err"]=
	SCN[$id]["title"]=
	SCN[$id]["fitwh"]=
	SCN[$id]["t0"]=$EPOCHSECONDS
}

# Connect once the server is up: its socket and its screen file both
# there. Asked from _draw, so a slow start is a few frames of "Starting",
# never a wait. A fitted window's screen gets the module as its window
# manager first, so the program is fitted from its first frame.
fn scn_connect(int id) {
	local n=${SCN[$id]["n"]} f="${SCN[$id]["dir"]}/Xvfb_screen0" x fd

	[ -n "${SCN[$id]["x"]}" ] && return 0
	[ -n "$n" ] || return 1
	[ -S "/tmp/.X11-unix/X$n" ] && [ -s "$f" ] || return 1
	x := xscr open "$n" "$f" "${SCN[$id]["srv"]}" 2> /dev/null || return 1
	SCN[$id]["x"]=$x
	SCN[$id]["cgen"]=0
	fd := xscr fd "$x"
	SCN[$id]["fd"]=$fd
	command -v console > /dev/null && console watch "$fd"
	if [ "${SCN[$id]["win"]}" = fit ] && ! xscr manage "$x" 2> /dev/null; then
		SCN[$id]["win"]=own
	fi
	scn_paint "$id"
	[ -n "${SCN[$id]["run"]}" ] && scn_run "$id" "${SCN[$id]["run"]}"
	SCN[$id]["run"]=
	return 0
}

# The background a program asked for, painted on its screen's root: a
# name or #rrggbb, or the desktop's own face colour; default leaves Xvfb's.
fn scn_paint(int id) {
	local c=${SCN[$id]["bg"]} x=${SCN[$id]["x"]}

	case $c in
	default | "") return 0 ;;
	black) c="#000000" ;;
	white) c="#ffffff" ;;
	grey) c="#808080" ;;
	desktop) c=${DT_FACE:-#000000} ;;
	esac
	xscr root "$x" "$c" 2> /dev/null
	return 0
}

# Whether a server has ended: no process, or one exited and not yet reaped.
fn scn_srvgone(int p) {
	local a b st

	[ -r "/proc/$p/stat" ] || return 0
	read -r a b st _ < "/proc/$p/stat" 2> /dev/null || return 0
	[ "$st" = Z ]
}

# Why the server is not there: Xvfb's own first complaint, as it wrote it.
fn scn_why(int id) {
	local f="${SCN[$id]["dir"]}/xvfb.err" l

	[ -s "$f" ] || { ret "Xvfb did not start"; return 0; }
	read -r l < "$f"
	ret "Xvfb did not start: $l"
}

# What a cell measures in the screen's pixels: the terminal's own when
# pixels are drawn, and 8 by 16 for half blocks, so a program fitted to a
# window is the size it would be at that window's size on a terminal.
SCN_CW=8
SCN_CH=16
fn scn_cell(int id) {
	local g
	local -a p

	SCN_CW=8
	SCN_CH=16
	[ "${SCN[$id]["pix"]}" = 1 ] || return 0
	g := dt_imggfx
	read -ra p <<< "$g"
	[ "${p[1]:-0}" -gt 1 ] && SCN_CW=${p[1]}
	[ "${p[2]:-0}" -gt 1 ] && SCN_CH=${p[2]}
	return 0
}

# Where the screen sits in the window, its shape kept: in cells, from the
# body's h by w, into SCN[id] r0 c0 rh rw.
fn scn_place(int id, int h, int w, int sw, int sh) {
	local cw=$SCN_CW ch=$SCN_CH rw rh

	[ "${SCN[$id]["pix"]}" = 1 ] || { cw=1; ch=2; }
	rw=$w
	rh=$((rw * cw * sh / (sw * ch)))
	if [ "$rh" -gt "$h" ]; then
		rh=$h
		rw=$((rh * ch * sw / (sh * cw)))
	fi
	[ "$rw" -lt 1 ] && rw=1
	[ "$rh" -lt 1 ] && rh=1
	SCN[$id]["r0"]=$((1 + (h - rh) / 2))
	SCN[$id]["c0"]=$((1 + (w - rw) / 2))
	SCN[$id]["rh"]=$rh
	SCN[$id]["rw"]=$rw
}

fn screens_draw(int id, int h, int w, int row, int col) {
	local x sz sw sh m t fw fh crop=

	SCN[$id]["h"]=$h
	SCN[$id]["w"]=$w
	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		scn_wdraw "$id" "$h" "$w"
		return 0
	fi
	console pen "$DT_INK" "$DT_FACE"
	if [ -n "${SCN[$id]["err"]}" ]; then
		dt_tput "$id" 2 2 "${SCN[$id]["err"]}"
		return 0
	fi
	if ! scn_connect "$id"; then
		if [ $((EPOCHSECONDS - ${SCN[$id]["t0"]:-0})) -gt 10 ] ||
		   { [ -n "${SCN[$id]["srv"]}" ] && [ $((EPOCHSECONDS - ${SCN[$id]["t0"]:-0})) -ge 1 ] &&
		     [ -s "${SCN[$id]["dir"]}/xvfb.err" ] && ! [ -S "/tmp/.X11-unix/X${SCN[$id]["n"]}" ] &&
		     scn_srvgone "${SCN[$id]["srv"]}"; }; then
			SCN[$id]["err"] := scn_why "$id"
		else
			t := dt_tr "Starting the X screen…"
			console put -p "w$id" 2 2 "$t"
			dt_want 200
		fi
		return 0
	fi
	x=${SCN[$id]["x"]}
	sz := xscr size "$x"
	sw=${sz% *}
	sh=${sz#* }
	m=${SCN[$id]["pic"]}
	[ "$m" = follow ] && m=${DT_IMGMODE:-auto}
	SCN[$id]["pix"]=0
	case $m in
	pixels | sixel) SCN[$id]["pix"]=1 ;;
	auto) dt_imgwill auto && SCN[$id]["pix"]=1 ;;
	esac
	scn_cell "$id"
	# Fitted: the program is the window's size in pixels and the window
	# shows that corner of the screen 1:1. The size is sent again only
	# when it changes -- a resize, or a terminal with another cell size.
	if [ "${SCN[$id]["win"]}" = fit ]; then
		fw=$((w * SCN_CW))
		fh=$((h * SCN_CH))
		if [ "$fw" -le "$sw" ] && [ "$fh" -le "$sh" ]; then
			if [ "${SCN[$id]["fitwh"]}" != "$fw $fh" ]; then
				xscr fit "$x" "$fw" "$fh"
				SCN[$id]["fitwh"]="$fw $fh"
			fi
			SCN[$id]["r0"]=1
			SCN[$id]["c0"]=1
			SCN[$id]["rh"]=$h
			SCN[$id]["rw"]=$w
			sw=$fw
			sh=$fh
			crop=-c
		fi
	fi
	[ -n "$crop" ] || scn_place "$id" "$h" "$w" "$sw" "$sh"
	SCN[$id]["sw"]=$sw
	SCN[$id]["sh"]=$sh
	m=half
	[ "${SCN[$id]["pix"]}" = 1 ] && m=pixels
	xscr draw "$x" "${SCN[$id]["r0"]}" "${SCN[$id]["c0"]}" \
		"${SCN[$id]["rh"]}" "${SCN[$id]["rw"]}" -p "w$id" -m "$m" $crop \
		2> /dev/null
	scn_retitle "$id"
	SCN[$id]["drew"]="${DT[$id]["h"]} ${DT[$id]["w"]} ${SCN[$id]["pic"]} $DT_IMGMODE"
	SCN[$id]["at"] := dt_ms
	return 0
}

# The window wears the program's name, and the program's own title beside
# it once it gives one.
fn scn_retitle(int id) {
	local t c

	t := xscr title "${SCN[$id]["x"]}" 2> /dev/null
	[ "$t" = "${SCN[$id]["title"]}" ] && [ -n "${SCN[$id]["titled"]}" ] &&
		return 0
	SCN[$id]["title"]=$t
	SCN[$id]["titled"]=1
	c := dt_wintitle "${SCN[$id]["name"]}" "$t"
	dt_retitle "$id" "$c"
}

# Clean while the screen has not changed and nothing about the window has:
# its size and how it is drawn. A screen that changes faster than
# DT_TERMMS -- an animation, a film -- is drawn at that rate and no faster,
# as a terminal's output is: the change is kept, and the frame is asked
# for when the period is up. The server says nothing more until the screen
# has been drawn, so a window waiting, hidden or minimised costs nothing.
# Whether the window's program has ended and the window is to close with it
# (Gitea #308): the program's own When It Ends, or for default Close When
# It Ends. Ended is every process it started gone *and* no window of it
# left on the screen -- a program whose first process forks and leaves has
# its window up still -- and not before the screen has had three seconds
# to show one. The server is asked about windows once a second at most.
fn scn_endcheck(int id) {
	local x=${SCN[$id]["x"]} e=${SCN[$id]["end"]:-default} p n

	case $e in
	close) ;;
	default) [ "$XS_CLOSEEND" = 1 ] || return 0 ;;
	*) return 0 ;;
	esac
	[ -n "$x" ] || return 0
	if [ $((EPOCHSECONDS - ${SCN[$id]["t0"]:-$EPOCHSECONDS})) -lt 3 ]; then
		dt_want 1000
		return 0
	fi
	for p in ${SCN[$id]["pids"]}; do
		kill -0 "$p" 2> /dev/null && return 0
	done
	if [ $((EPOCHSECONDS - ${SCN[$id]["wat"]:-0})) -lt 1 ]; then
		dt_want 1000
		return 0
	fi
	SCN[$id]["wat"]=$EPOCHSECONDS
	n := xscr windows "$x" 2> /dev/null
	[ "${n:-1}" -gt 0 ] && return 0
	dt_wantclose "$id"
}

fn screens_dirty(int id) {
	local x=${SCN[$id]["x"]} st=0 now left

	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		scn_wdirty "$id"
		return
	fi
	[ -n "$x" ] || return 0
	scn_endcheck "$id"
	xscr poll "$x" 2> /dev/null || st=$?
	[ "$st" = 2 ] && { SCN[$id]["err"]="The X screen has ended"; return 0; }
	scn_clipin "$id"
	if [ "$st" = 0 ]; then
		now := dt_ms
		left=$((${SCN[$id]["at"]:-0} + ${SCN[$id]["ms"]:-${DT_TERMMS:-70}} - now))
		if [ "$left" -gt 0 ]; then
			dt_want "$left"
			return 1
		fi
		return 0
	fi
	[ "${SCN[$id]["drew"]}" = "${DT[$id]["h"]} ${DT[$id]["w"]} ${SCN[$id]["pic"]} $DT_IMGMODE" ] &&
		return 1
	return 0
}

# The server's messages are read whether or not the window is drawn, or its
# socket would wake the desktop for ever.
fn screens_idle(int id) {
	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		scn_wdrain "$id"
		return 0
	fi
	if [ -n "${SCN[$id]["x"]}" ]; then
		xscr poll "${SCN[$id]["x"]}" > /dev/null 2>&1
		scn_clipin "$id"
	fi
	scn_endcheck "$id"
	return 0
}

# What a program copied comes to the desktop's clipboard (Gitea #424): the
# module fetches CLIPBOARD whenever it takes a new owner, and a new
# generation is put on the desktop's clipboard as a copy from this window,
# so it reaches the terminal it runs on and every Paste. Never what the
# desktop already holds, and nothing while a paste into this window is
# being typed -- a program that copies what it is given would otherwise
# hand the paste back, and the partial texts on the way to it, as copies.
SCN_PASTEMS=1500
fn scn_clipin(int id) {
	local x=${SCN[$id]["x"]} g t now

	[ -n "$x" ] || return 0
	g := xscr clipgen "$x" 2> /dev/null
	[ -n "$g" ] && [ "$g" != "${SCN[$id]["cgen"]}" ] || return 0
	SCN[$id]["cgen"]=$g
	t := xscr clip "$x" 2> /dev/null || return 0
	[ -n "$t" ] && [ "$t" != "$DT_CLIP" ] || return 0
	now := dt_ms
	[ $((now - ${SCN[$id]["pat"]:-0})) -lt "$SCN_PASTEMS" ] && return 0
	dt_clipset "$t" copy text
	dt_notep low "Copied %s characters" "${#t}"
	dt_want 10
	return 0
}

# A window cell to the X screen's pixel under it, into SCN_PX and SCN_PY;
# status 1 outside the screen.
SCN_PX=0
SCN_PY=0
fn scn_at(int id, int r, int c) {
	local r0=${SCN[$id]["r0"]} c0=${SCN[$id]["c0"]} rh=${SCN[$id]["rh"]} rw=${SCN[$id]["rw"]} o fx=500 fy=500

	[ -n "$r0" ] || return 1
	[ "$r" -ge "$r0" ] && [ "$r" -lt $((r0 + rh)) ] &&
		[ "$c" -ge "$c0" ] && [ "$c" -lt $((c0 + rw)) ] || return 1
	# Where in the cell, in thousandths, from the terminal's pixel when it
	# reports one and the middle otherwise (#370): an X program wants a
	# pixel, and a cell of the window is several of the screen's.
	if dt_has dt_cellpx; then
		o := dt_cellpx "$id" "$r" "$c" 1000 1000
		read -r fx fy <<< "$o"
	fi
	SCN_PX=$((((c - c0) * 1000 + fx) * ${SCN[$id]["sw"]} / (1000 * rw)))
	SCN_PY=$((((r - r0) * 1000 + fy) * ${SCN[$id]["sh"]} / (1000 * rh)))
	return 0
}

fn screens_key(int id, key) {
	local x=${SCN[$id]["x"]}

	# Release Pointer always leaves, so a window can never keep the
	# keyboard or the pointer from the desktop.
	dt_has dt_keyis && dt_keyis ptrrelease "$key" && return 1
	dt_has dt_keyis && dt_keyis fsleave "$key" && return 1
	# On Wayland Screen every key the desktop hands over is the program's,
	# which Blit has already given it: taken here so nothing else acts on
	# it, unless the program leaves the desktop its shortcuts.
	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		if [ "${SCN[$id]["keys"]}" != 1 ] && [ "$DT_TERMKEEP" = 1 ] &&
		   dt_has dt_keyassigned && dt_keyassigned "$key"; then
			return 1
		fi
		return 0
	fi
	[ -n "$x" ] || return 1
	if [ "${SCN[$id]["keys"]}" != 1 ] && [ "$DT_TERMKEEP" = 1 ] &&
	   dt_has dt_keyassigned && dt_keyassigned "$key"; then
		return 1
	fi
	xscr key "$x" "$key" 2> /dev/null
	return 0
}

# A press, a drag and a release, as the window manager hands them over:
# the button goes down where it was pressed and the pointer follows it.
fn screens_mouse(int id, act, btn, int r, int c, mods = "") {
	local x=${SCN[$id]["x"]} b=1

	# Wayland Screen: a click holds the pointer when the program wants it
	# held, as a game does -- never focus alone, and Release Pointer gives it
	# back. Everything else reaches the program through Blit's own route.
	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		[ "${act##*-}" = press ] && [ "${SCN[$id]["rel"]}" = 1 ] &&
			[ -n "${SCN[$id]["drew"]}" ] && dt_has dt_pointerlock &&
			dt_pointerlock "$id" on
		return 0
	fi
	[ -n "$x" ] || return 0
	case $btn in middle) b=2 ;; right) b=3 ;; esac
	# Held for relative motion: the pointer's moves come as offsets (r is
	# dy, c is dx), and its buttons press where the X pointer already is.
	case ${act##*-} in
	unlock) SCN[$id]["held"]=; return 0 ;;
	rel) xscr rel "$x" "$c" "$r" 2> /dev/null; return 0 ;;
	esac
	if [ "${SCN[$id]["held"]}" = 1 ]; then
		case ${act##*-} in
		press) xscr press "$x" press "$b" ;;
		release) xscr press "$x" release "$b" ;;
		esac
		return 0
	fi
	scn_at "$id" "$r" "$c" || return 0
	if [ "${SCN[$id]["rel"]}" = 1 ] && [ "${act##*-}" = press ] &&
	   dt_has dt_pointerlock && dt_pointerlock "$id" on; then
		SCN[$id]["held"]=1
		xscr move "$x" "$SCN_PX" "$SCN_PY"
		xscr press "$x" press "$b"
		return 0
	fi
	case ${act##*-} in
	press) xscr button "$x" press "$b" "$SCN_PX" "$SCN_PY" ;;
	release) xscr button "$x" release "$b" "$SCN_PX" "$SCN_PY" ;;
	drag) xscr move "$x" "$SCN_PX" "$SCN_PY" ;;
	esac
	return 0
}

# The pointer moved over the window with no button held (Hover on): the
# X pointer follows it, so a program's own hover, menus and tooltips work.
# The same position twice sends nothing.
fn screens_hover(int id, int r, int c) {
	local x=${SCN[$id]["x"]}

	[ -n "$x" ] && [ "$r" -ge 0 ] || return 0
	[ "${SCN[$id]["held"]}" = 1 ] && return 0
	scn_at "$id" "$r" "$c" || return 0
	[ "${SCN[$id]["at:p"]}" = "$SCN_PX $SCN_PY" ] && return 0
	SCN[$id]["at:p"]="$SCN_PX $SCN_PY"
	xscr move "$x" "$SCN_PX" "$SCN_PY"
	return 0
}

fn screens_click(int id, int r, int c, btn = "") {
	return 0
}

fn screens_wheel(int id, dir, int r, int c) {
	local x=${SCN[$id]["x"]}

	[ -n "$x" ] || return 0
	scn_at "$id" "$r" "$c" || return 0
	xscr wheel "$x" "$dir" "$SCN_PX" "$SCN_PY"
	return 0
}

# Text pasted into the window is typed into the screen, and the moment
# kept, so that nothing the program copies while it is typed comes back.
fn screens_paste(int id, text, op = "") {
	[ -n "${SCN[$id]["x"]}" ] || return 0
	SCN[$id]["pat"] := dt_ms
	xscr type "${SCN[$id]["x"]}" "$text"
	return 0
}

# The desktop's Copy with this window in front: the X selection made most
# recently -- what is highlighted with the mouse, or what the program
# itself last copied -- fetched from its owner now, and the program's
# last copy when that owner does not answer.
fn screens_copy(int id) {
	local x=${SCN[$id]["x"]} t=

	[ -n "$x" ] || return 1
	t := xscr clip "$x" last -f 2> /dev/null || t=
	[ -n "$t" ] || t := xscr clip "$x" 2> /dev/null || t=
	[ -n "$t" ] || return 1
	ret "$t"
}

# The keys reach a Wayland Screen's program through Blit's input route,
# which follows this.
fn screens_focus(int id, on) {
	[ "${SCN[$id]["eng"]}" = wayland ] && [ -n "${SCN[$id]["fn"]}" ] || return 0
	frames input "${SCN[$id]["fn"]}" "$on" 2> /dev/null
	return 0
}

# Closing the window ends its program: X Screen's server and what runs on
# it, and Wayland Screen's bridge, which is on a pty only this window holds
# and is hung up with it.
fn screens_close(int id) {
	local p fd=${SCN[$id]["fd"]}

	[ -n "${SCN[$id]["pid"]}" ] && pty close "${SCN[$id]["pid"]}" 2> /dev/null
	[ "${SCN[$id]["eng"]}" = wayland ] && [ -n "${SCN[$id]["fn"]}" ] && frames stop "${SCN[$id]["fn"]}" 2> /dev/null
	[ -n "$fd" ] && command -v console > /dev/null && console unwatch "$fd"
	if [ -n "${SCN[$id]["x"]}" ]; then
		xscr close "${SCN[$id]["x"]}" 2> /dev/null
	elif [ -n "${SCN[$id]["srv"]}" ]; then
		xscr stop "${SCN[$id]["srv"]}" 2> /dev/null
	fi
	for p in ${SCN[$id]["pids"]}; do
		kill "$p" 2> /dev/null
	done
	[ -n "${SCN[$id]["dir"]}" ] && command rm -rf -- "${SCN[$id]["dir"]}"
	unset "SCN[$id]"
}

# Restart Desktop: the server and its programs are this shell's children
# and should run on across the exec; the connection does not, so it is made
# again on the first frame after, and the window manager taken up again.
fn screens_stash(int id, dir) {
	SCN[$id]["x"]=
	SCN[$id]["fd"]=
	SCN[$id]["cgen"]=
	return 0
}
fn screens_resume(int id) {
	local e

	# A bridge is hung up by the exec, its pty being close-on-exec, and its
	# frames socket goes with the old process: the program has gone.
	if [ "${SCN[$id]["eng"]}" = wayland ]; then
		SCN[$id]["pid"]=
		SCN[$id]["fn"]=
		e := dt_tr "Restart Desktop ended %s -- open it again" "${SCN[$id]["name"]}"
		SCN[$id]["err"]=$e
		return 0
	fi
	SCN[$id]["x"]=
	SCN[$id]["fd"]=
	SCN[$id]["run"]=
	SCN[$id]["fitwh"]=
	return 0
}

screens_menus() {
	local on=0 id=$DT_FOCUS

	dt_menu "File"
	dt_item "Close Window" w dt_close_focused
	dt_editmenu
	[ -n "$id" ] && [ "${SCN[$id]["eng"]-}" = wayland ] || return 0
	[ "${DT[$id]["keysall"]-}" = 1 ] && on=1
	dt_menu "Program"
	dt_mark "Keys to the Program" k "$on" scn_keystoggle
}
