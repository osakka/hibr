# mirrors -- the desktop state an app's own process is sent, and how (ADR
# 0050): DT_RTDOOR is each mirror's door (tools/appstate.py says what each
# means), and dt_rtdeclare declares, in an app's own process, every name
# it is sent today, so a strict file can be given them. Generated by
# tools/appstate.py --write from the state survey; never edited by hand.
# interface: shared

declare -gA DT_RTDOOR=([CS_CLICKC]=call [CS_HIDE]=save [CS_MOD_ALL]=registry [CS_MOD_ORD]=registry [CS_ORDER]=save [CS_SHADOW]=save [CS_SHOW]=save [CS_SIDE]=save [DRW]=registry [DT]=window [DT_ACTIVE]=save [DT_AKEY]=registry [DT_AKEYORDER]=registry [DT_APPKEY]=save [DT_APPMODE]=save [DT_APPS]=registry [DT_BAD]=save [DT_BAND]=save [DT_BANDPCT]=save [DT_BANDS]=save [DT_BAR]=save [DT_BARGAP]=save [DT_BARI]=registry [DT_BARICON]=save [DT_BARORDER]=save [DT_BARREAD]=registry [DT_BARSHADOW]=save [DT_BARTIME]=save [DT_BARTRANS]=save [DT_BARWCOL]=registry [DT_BELLICON]=save [DT_BELLICONS]=registry [DT_BIDI]=save [DT_BTBAR]=save [DT_BTKIND]=save [DT_BTNL]=registry [DT_BTNON]=save [DT_BTNORDER]=save [DT_BTNS]=save [DT_BTNSHADOW]=save [DT_BTNSTYLE]=save [DT_BUNDLEEXT]=registry [DT_CH]=registry [DT_CHECKS]=save [DT_CHORDER]=registry [DT_CLIPKEEP]=save [DT_CLIPMAX]=save [DT_COLOURS]=save [DT_COLS]=hot [DT_CONFJ]=kept [DT_CURSOR]=save [DT_CURSOR_BLINK]=save [DT_CYCLE]=save [DT_DAVSAVE]=save [DT_DAVTIMEOUT]=save [DT_DBLACTION]=save [DT_DESKICON]=save [DT_DIGITS]=save [DT_DIM]=save [DT_DISKS]=save [DT_DISPNAMES]=hot [DT_DLGBTN]=save [DT_DLGBTNS]=save [DT_DLGC]=answer [DT_DLGH]=answer [DT_DLGR]=answer [DT_DLGW]=answer [DT_DND]=call [DT_DOT]=save [DT_DRAGKEY]=save [DT_DRAGMOD]=save [DT_DRAWSKIP]=save [DT_EDGERESIZE]=save [DT_FACE]=save [DT_FILMDETAIL]=save [DT_FOCUS]=hot [DT_FOCUSHOVER]=save [DT_FRAME]=save [DT_FULLEND]=save [DT_FULLENDS]=save [DT_FULLON]=save [DT_GLYPH]=save [DT_GLYPHSET]=save [DT_GOOD]=save [DT_HADJ]=save [DT_HANDLERS]=registry [DT_HCAL]=save [DT_HERE]=hello [DT_HIGHLIGHT]=save [DT_HOSTMARK]=gone [DT_HOT]=save [DT_HOVER]=save [DT_ICONBG]=save [DT_ICONPENS]=save [DT_ICONS]=save [DT_IDLE]=save [DT_IME]=hot [DT_IMGCOMP]=save [DT_IMGDETAIL]=save [DT_IMGEDITS]=save [DT_IMGFD]=save [DT_IMGMODE]=save [DT_INFO]=save [DT_INK]=save [DT_KB]=registry [DT_KBCUR]=hot [DT_KBLOC]=registry [DT_KBLOCAL]=save [DT_KBN]=registry [DT_KBRES]=registry [DT_KEYBASE]=call [DT_KEYCODE]=call [DT_KEYMODS]=call [DT_KEYORDER]=registry [DT_KEYPHASE]=call [DT_KEYS]=save [DT_LANG]=hot [DT_LIVEMS]=save [DT_LOCKAFTER]=save [DT_LOCKWHERE]=save [DT_LOG]=save [DT_MENUBOLD]=save [DT_MENUMARK]=save [DT_MENUMAX]=save [DT_MIRROR]=save [DT_MOVEMODE]=save [DT_MSHADOW]=save [DT_NATCH]=call [DT_NATCW]=call [DT_NATFOCUS]=save [DT_NATFOCUSES]=call [DT_NATIVE]=save [DT_NATREMEMBER]=save [DT_NATX11]=save [DT_NETBAR]=save [DT_NETKIND]=save [DT_NETRULE]=save [DT_NEWON]=save [DT_NOTECOLOUR]=save [DT_NOTECOLOURS]=registry [DT_NOTECOUNT]=save [DT_NOTEFRAME]=save [DT_NOTEHIST]=registry [DT_NOTEHMAX]=save [DT_NOTEHMIN]=save [DT_NOTELEVELS]=registry [DT_NOTELIST]=save [DT_NOTEMS]=save [DT_NOTEPOS]=save [DT_NOTEWHERE]=save [DT_NOTEWMAX]=save [DT_NOTEWMIN]=save [DT_NOTE_NEXT]=registry [DT_OPENERORDER]=registry [DT_OPENERS]=registry [DT_OPENVERBS]=registry [DT_OPENWITH]=save [DT_OVLIST]=registry [DT_OWLIST]=registry [DT_PADJ]=save [DT_PASR]=save [DT_PATHAN]=save [DT_PATHANF]=save [DT_PBAR]=save [DT_PBEFORE]=save [DT_PHASEWIN]=call [DT_PKRES]=registry [DT_PLACE]=save [DT_PLACES]=registry [DT_PLAT]=save [DT_PLON]=save [DT_PMETHOD]=save [DT_PNOTE]=save [DT_PRIMARY_COL]=hot [DT_PRIMARY_H]=hot [DT_PRIMARY_W]=hot [DT_PROGAUTO]=save [DT_PRULE]=save [DT_PSTRIP]=save [DT_PWBAR]=save [DT_PWCRIT]=save [DT_PWCRITDO]=save [DT_PWLEVEL]=save [DT_PWLOW]=save [DT_PX]=call [DT_PY]=call [DT_RESTORED]=hot [DT_ROWS]=hot [DT_SAVER]=save [DT_SAVERIDLE]=save [DT_SBLIST]=registry [DT_SCROLLWHEEL]=save [DT_SELINK]=save [DT_SHADOW]=save [DT_SHADOWINK]=save [DT_SHADOWSHAPE]=save [DT_SHADOWSHAPES]=save [DT_SHADOW_PCT]=save [DT_SHOTDIR]=save [DT_SHOTFMT]=save [DT_SHOTLAST]=save [DT_SNDBAR]=save [DT_SNDKIND]=save [DT_SNDLEVEL]=save [DT_SNDSTEP]=save [DT_STANDBYAUTO]=save [DT_SWITCHER]=save [DT_SWMS]=save [DT_SWSKIP]=save [DT_TERMBAR]=save [DT_TERMCTRL]=save [DT_TERMHERE]=save [DT_TERMKEEP]=save [DT_TERMMS]=save [DT_THEMECHECKS]=save [DT_TILEMAIN]=save [DT_TIPMS]=save [DT_TIPS]=save [DT_TITLE]=save [DT_TITLEALIGN]=save [DT_TITLEBAR]=save [DT_TITLEBARS]=save [DT_TITLEINK]=save [DT_TITLEKEY]=save [DT_TRASH]=registry [DT_TRASHN]=hot [DT_TREELINES]=save [DT_TREESTYLE]=save [DT_UPNEW]=hot [DT_UPSESSION]=hot [DT_VER]=hello [DT_VWA]=registry [DT_VWCLEAR]=save [DT_VWERR]=registry [DT_VWITEMS]=registry [DT_VWJOB]=registry [DT_VWSYNC]=save [DT_VWSYNCED]=registry [DT_WALL]=save [DT_WALLBAD]=save [DT_WALLIMG]=save [DT_WALLIMGMODE]=save [DT_WALLMODE]=save [DT_WALLTRIED]=save [DT_WARN]=save [DT_WEEKSTART]=save [DT_WELL]=save [DT_WINTRANS]=save [DT_WS]=hot [DT_WSN]=save [DT_ZOOMFILL]=save [DT_ZOOMFILLS]=save [MB_CTXID]=call [MB_CTXWHO]=call [MB_CX]=call [MB_CY]=call [SV_LIST]=registry [VW_SESSION]=registry [WP_GLYPHS]=save [WP_MODES]=save [WS_ALIGNS]=save [WS_FRAMES]=save [WS_STYLES]=save)
# The fields of a window's record installables read: what an app's own
# process is sent of its own windows (the window door).
DT_RTWINF=(app bg chrome col fg h noshadow row sticky title w)
# Which of them are maps, sent entry by entry.
declare -gA DT_RTMAP=([DRW]=1 [DT]=1 [DT_AKEY]=1 [DT_APPKEY]=1 [DT_APPS]=1 [DT_BARI]=1 [DT_CH]=1 [DT_CONFJ]=1 [DT_HANDLERS]=1 [DT_KB]=1 [DT_KEYS]=1 [DT_NOTEHIST]=1 [DT_OPENERS]=1 [DT_OPENVERBS]=1 [DT_VWA]=1)

# The names sent today, declared in an app's own process: called by the
# runtime alone, before its hello.
dt_rtdeclare() {
	declare -g CS_HIDE CS_ORDER CS_SHADOW CS_SHOW CS_SIDE DT_ACTIVE DT_APPMODE DT_BAD
	declare -g DT_BAND DT_BANDPCT DT_BANDS DT_BAR DT_BARGAP DT_BARICON DT_BARORDER DT_BARSHADOW
	declare -g DT_BARTIME DT_BARTRANS DT_BELLICON DT_BIDI DT_BTBAR DT_BTKIND DT_BTNON DT_BTNORDER
	declare -g DT_BTNS DT_BTNSHADOW DT_BTNSTYLE DT_CHECKS DT_CLIPKEEP DT_CLIPMAX DT_COLOURS DT_COLS
	declare -g DT_CURSOR DT_CURSOR_BLINK DT_CYCLE DT_DAVSAVE DT_DAVTIMEOUT DT_DBLACTION DT_DESKICON DT_DIGITS
	declare -g DT_DIM DT_DISKS DT_DISPNAMES DT_DLGBTN DT_DLGBTNS DT_DOT DT_DRAGKEY DT_DRAGMOD
	declare -g DT_DRAWSKIP DT_EDGERESIZE DT_FACE DT_FILMDETAIL DT_FOCUS DT_FOCUSHOVER DT_FRAME DT_FULLEND
	declare -g DT_FULLENDS DT_FULLON DT_GLYPH DT_GLYPHSET DT_GOOD DT_HADJ DT_HCAL DT_HERE
	declare -g DT_HIGHLIGHT DT_HOT DT_HOVER DT_ICONBG DT_ICONPENS DT_ICONS DT_IDLE DT_IME
	declare -g DT_IMGCOMP DT_IMGDETAIL DT_IMGEDITS DT_IMGFD DT_IMGMODE DT_INFO DT_INK DT_KBCUR
	declare -g DT_KBLOCAL DT_LANG DT_LIVEMS DT_LOCKAFTER DT_LOCKWHERE DT_LOG DT_MENUBOLD DT_MENUMARK
	declare -g DT_MENUMAX DT_MIRROR DT_MOVEMODE DT_MSHADOW DT_NATFOCUS DT_NATIVE DT_NATREMEMBER DT_NATX11
	declare -g DT_NETBAR DT_NETKIND DT_NETRULE DT_NEWON DT_NOTECOLOUR DT_NOTECOUNT DT_NOTEFRAME DT_NOTEHMAX
	declare -g DT_NOTEHMIN DT_NOTELIST DT_NOTEMS DT_NOTEPOS DT_NOTEWHERE DT_NOTEWMAX DT_NOTEWMIN DT_OPENWITH
	declare -g DT_PADJ DT_PASR DT_PATHAN DT_PATHANF DT_PBAR DT_PBEFORE DT_PLACE DT_PLAT
	declare -g DT_PLON DT_PMETHOD DT_PNOTE DT_PRIMARY_COL DT_PRIMARY_H DT_PRIMARY_W DT_PROGAUTO DT_PRULE
	declare -g DT_PSTRIP DT_PWBAR DT_PWCRIT DT_PWCRITDO DT_PWLEVEL DT_PWLOW DT_RESTORED DT_ROWS
	declare -g DT_SAVER DT_SAVERIDLE DT_SCROLLWHEEL DT_SELINK DT_SHADOW DT_SHADOWINK DT_SHADOWSHAPE DT_SHADOWSHAPES
	declare -g DT_SHADOW_PCT DT_SHOTDIR DT_SHOTFMT DT_SHOTLAST DT_SNDBAR DT_SNDKIND DT_SNDLEVEL DT_SNDSTEP
	declare -g DT_STANDBYAUTO DT_SWITCHER DT_SWMS DT_SWSKIP DT_TERMBAR DT_TERMCTRL DT_TERMHERE DT_TERMKEEP
	declare -g DT_TERMMS DT_THEMECHECKS DT_TILEMAIN DT_TIPMS DT_TIPS DT_TITLE DT_TITLEALIGN DT_TITLEBAR
	declare -g DT_TITLEBARS DT_TITLEINK DT_TITLEKEY DT_TRASHN DT_TREELINES DT_TREESTYLE DT_UPNEW DT_UPSESSION
	declare -g DT_VER DT_VWCLEAR DT_VWSYNC DT_WALL DT_WALLBAD DT_WALLIMG DT_WALLIMGMODE DT_WALLMODE
	declare -g DT_WALLTRIED DT_WARN DT_WEEKSTART DT_WELL DT_WINTRANS DT_WS DT_WSN DT_ZOOMFILL
	declare -g DT_ZOOMFILLS WP_GLYPHS WP_MODES WS_ALIGNS WS_FRAMES WS_STYLES
	declare -gA DT DT_APPKEY DT_KEYS
	return 0
}
