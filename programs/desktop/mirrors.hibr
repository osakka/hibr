# mirrors -- the desktop state an app's own process is sent, and how (ADR
# 0050): DT_RTDOOR is each mirror's door (tools/appstate.py says what each
# means), and dt_rtdeclare declares, in an app's own process, every name
# it is sent today, so a strict file can be given them. Generated by
# tools/appstate.py --write from the state survey; never edited by hand.
# interface: shared

declare -gA DT_RTDOOR=([CS_CLICKC]=call [CS_HIDE]=save [CS_MOD_ALL]=registry [CS_MOD_ORD]=answer [CS_ORDER]=save [CS_SHADOW]=save [CS_SHOW]=save [CS_SIDE]=save [DRW]=registry [DT]=window [DT_ACTIVE]=save [DT_AKEY]=registry [DT_AKEYORDER]=registry [DT_APPKEY]=save [DT_APPMODE]=save [DT_APPS]=registry [DT_BAD]=save [DT_BAND]=save [DT_BANDPCT]=save [DT_BANDS]=save [DT_BAR]=save [DT_BARGAP]=save [DT_BARI]=registry [DT_BARICON]=save [DT_BARORDER]=save [DT_BARREAD]=answer [DT_BARSHADOW]=save [DT_BARTIME]=save [DT_BARTRANS]=save [DT_BARWCOL]=call [DT_BELLICON]=save [DT_BELLICONS]=hello [DT_BIDI]=save [DT_BTBAR]=save [DT_BTKIND]=save [DT_BTNL]=answer [DT_BTNON]=save [DT_BTNORDER]=save [DT_BTNS]=save [DT_BTNSHADOW]=save [DT_BTNSTYLE]=save [DT_BUNDLEEXT]=registry [DT_CH]=registry [DT_CHECKS]=save [DT_CHORDER]=registry [DT_CLIPKEEP]=save [DT_CLIPMAX]=save [DT_COLOURS]=save [DT_COLS]=hot [DT_CONFJ]=kept [DT_CURSOR]=save [DT_CURSOR_BLINK]=save [DT_CYCLE]=save [DT_DAVSAVE]=save [DT_DAVTIMEOUT]=save [DT_DBLACTION]=save [DT_DESKICON]=save [DT_DIGITS]=save [DT_DIM]=save [DT_DISKS]=save [DT_DISPNAMES]=hot [DT_DLGBTN]=save [DT_DLGBTNS]=save [DT_DLGC]=answer [DT_DLGH]=answer [DT_DLGR]=answer [DT_DLGW]=answer [DT_DND]=call [DT_DOT]=save [DT_DRAGKEY]=save [DT_DRAGMOD]=save [DT_DRAWSKIP]=save [DT_EDGERESIZE]=save [DT_FACE]=save [DT_FILMDETAIL]=save [DT_FOCUS]=hot [DT_FOCUSHOVER]=save [DT_FRAME]=save [DT_FULLEND]=save [DT_FULLENDS]=save [DT_FULLON]=save [DT_GLYPH]=save [DT_GLYPHSET]=save [DT_GOOD]=save [DT_HADJ]=save [DT_HANDLERS]=registry [DT_HCAL]=save [DT_HERE]=hello [DT_HIGHLIGHT]=save [DT_HOSTMARK]=gone [DT_HOT]=save [DT_HOVER]=save [DT_ICONBG]=save [DT_ICONPENS]=save [DT_ICONS]=save [DT_IDLE]=save [DT_IME]=hot [DT_IMGCOMP]=save [DT_IMGDETAIL]=save [DT_IMGEDITS]=save [DT_IMGFD]=save [DT_IMGMODE]=save [DT_INFO]=save [DT_INK]=save [DT_KB]=registry [DT_KBCUR]=hot [DT_KBLOC]=registry [DT_KBLOCAL]=save [DT_KBN]=registry [DT_KBRES]=registry [DT_KEYBASE]=call [DT_KEYCODE]=call [DT_KEYMODS]=call [DT_KEYORDER]=hello [DT_KEYPHASE]=call [DT_KEYS]=save [DT_LANG]=hot [DT_LIVEMS]=save [DT_LOCKAFTER]=save [DT_LOCKWHERE]=save [DT_LOG]=save [DT_MENUBOLD]=save [DT_MENUMARK]=save [DT_MENUMAX]=save [DT_MIRROR]=save [DT_MOVEMODE]=save [DT_MSHADOW]=save [DT_NATCH]=call [DT_NATCW]=call [DT_NATFOCUS]=save [DT_NATFOCUSES]=call [DT_NATIVE]=save [DT_NATREMEMBER]=save [DT_NATX11]=save [DT_NETBAR]=save [DT_NETKIND]=save [DT_NETRULE]=save [DT_NEWON]=save [DT_NOTECOLOUR]=save [DT_NOTECOLOURS]=hello [DT_NOTECOUNT]=save [DT_NOTEFRAME]=save [DT_NOTEHIST]=registry [DT_NOTEHIST_ORDER]=registry [DT_NOTEHMAX]=save [DT_NOTEHMIN]=save [DT_NOTELEVELS]=hello [DT_NOTELIST]=save [DT_NOTEMS]=save [DT_NOTEPOS]=save [DT_NOTEWHERE]=save [DT_NOTEWMAX]=save [DT_NOTEWMIN]=save [DT_OPENERORDER]=registry [DT_OPENERS]=registry [DT_OPENVERBS]=registry [DT_OPENWITH]=save [DT_OVLIST]=answer [DT_OWLIST]=answer [DT_PADJ]=save [DT_PASR]=save [DT_PATHAN]=save [DT_PATHANF]=save [DT_PBAR]=save [DT_PBEFORE]=save [DT_PHASEWIN]=call [DT_PKRES]=registry [DT_PLACE]=save [DT_PLACES]=hello [DT_PLAT]=save [DT_PLON]=save [DT_PMETHOD]=save [DT_PNOTE]=save [DT_PRIMARY_COL]=hot [DT_PRIMARY_H]=hot [DT_PRIMARY_W]=hot [DT_PROGAUTO]=save [DT_PRULE]=save [DT_PSTRIP]=save [DT_PWBAR]=save [DT_PWCRIT]=save [DT_PWCRITDO]=save [DT_PWLEVEL]=save [DT_PWLOW]=save [DT_PX]=call [DT_PY]=call [DT_RESTORED]=hot [DT_ROWS]=hot [DT_SAVER]=save [DT_SAVERIDLE]=save [DT_SBLIST]=registry [DT_SCROLLWHEEL]=save [DT_SELINK]=save [DT_SHADOW]=save [DT_SHADOWINK]=save [DT_SHADOWSHAPE]=save [DT_SHADOWSHAPES]=save [DT_SHADOW_PCT]=save [DT_SHOTDIR]=save [DT_SHOTFMT]=save [DT_SHOTLAST]=save [DT_SNDBAR]=save [DT_SNDKIND]=save [DT_SNDLEVEL]=save [DT_SNDSTEP]=save [DT_STANDBYAUTO]=save [DT_SWITCHER]=save [DT_SWMS]=save [DT_SWSKIP]=save [DT_TERMBAR]=save [DT_TERMCTRL]=save [DT_TERMHERE]=save [DT_TERMKEEP]=save [DT_TERMMS]=save [DT_THEMECHECKS]=save [DT_TILEMAIN]=save [DT_TIPMS]=save [DT_TIPS]=save [DT_TITLE]=save [DT_TITLEALIGN]=save [DT_TITLEBAR]=save [DT_TITLEBARS]=save [DT_TITLEINK]=save [DT_TITLEKEY]=save [DT_TRASH]=hello [DT_TRASHN]=hot [DT_TREELINES]=save [DT_TREESTYLE]=save [DT_UPNEW]=hot [DT_UPSESSION]=hot [DT_VER]=hello [DT_VWA]=registry [DT_VWCLEAR]=save [DT_VWERR]=registry [DT_VWITEMS]=registry [DT_VWJOB]=registry [DT_VWSYNC]=save [DT_VWSYNCED]=registry [DT_WALL]=save [DT_WALLBAD]=save [DT_WALLIMG]=save [DT_WALLIMGMODE]=save [DT_WALLMODE]=save [DT_WALLTRIED]=save [DT_WARN]=save [DT_WEEKSTART]=save [DT_WELL]=save [DT_WINTRANS]=save [DT_WS]=hot [DT_WSN]=save [DT_ZOOMFILL]=save [DT_ZOOMFILLS]=save [MB_CTXID]=call [MB_CTXWHO]=call [MB_CX]=call [MB_CY]=call [SV_LIST]=registry [VW_SESSION]=registry [WP_GLYPHS]=save [WP_MODES]=save [WS_ALIGNS]=save [WS_FRAMES]=save [WS_STYLES]=save)
# The fields of a window's record installables read: what an app's own
# process is sent of its own windows (the window door).
DT_RTWINF=(app bg chrome col fg h noshadow row sticky title w)
# Who reads each registry, as the kind folder sees the file ("*": the
# app interface does, so every process); every installable the survey
# read, so one it did not is sent every registry but a secret; the
# secrets; and a record's fields that move with input or a frame, left
# out of what is sent.
declare -gA DT_RTAUD=([CS_MOD_ALL]="control-panel/control-strip.hibr" [DRW]="*" [DT_AKEY]="*" [DT_AKEYORDER]="control-panel/shortcuts.hibr" [DT_APPS]="*" [DT_BARI]="control-panel/menubar.hibr menubar/keyboard.hibr menubar/tray.hibr" [DT_BUNDLEEXT]="apps/files.hibr control-panel/filetypes.hibr" [DT_CH]="system/clipboard.hibr" [DT_CHORDER]="control-panel/cliphist.hibr system/clipboard.hibr" [DT_HANDLERS]="control-panel/filetypes.hibr" [DT_KB]="*" [DT_KBLOC]="control-panel/language.hibr" [DT_KBN]="menubar/keyboard.hibr" [DT_KBRES]="control-panel/shortcuts.hibr" [DT_NOTEHIST]="control-panel/notifications.hibr system/notifications.hibr" [DT_NOTEHIST_ORDER]="control-panel/notifications.hibr system/notifications.hibr" [DT_OPENERORDER]="control-panel/filetypes.hibr" [DT_OPENERS]="control-panel/filetypes.hibr" [DT_OPENVERBS]="apps/files.hibr" [DT_PKRES]="menubar/network.hibr" [DT_SBLIST]="control-panel/displays.hibr" [DT_VWA]="apps/vault.hibr control-panel/vaultset.hibr" [DT_VWERR]="apps/vault.hibr control-panel/vaultset.hibr" [DT_VWITEMS]="apps/vault.hibr" [DT_VWJOB]="apps/vault.hibr control-panel/vaultset.hibr" [DT_VWSYNCED]="apps/vault.hibr control-panel/vaultset.hibr" [SV_LIST]="control-panel/screensaver.hibr" [VW_SESSION]="apps/vault.hibr control-panel/vaultset.hibr")
declare -gA DT_RTKNOWN=([apps/Accessories/calc.hibr]=1 [apps/Accessories/camera.hibr]=1 [apps/Accessories/clock.hibr]=1 [apps/Accessories/imgview.hibr]=1 [apps/Accessories/prayer.hibr]=1 [apps/Accessories/puzzle.hibr]=1 [apps/Accessories/quran.hibr]=1 [apps/Accessories/stickies.hibr]=1 [apps/Development/coding.hibr]=1 [apps/Games/boxer.hibr]=1 [apps/Games/bricks.hibr]=1 [apps/Games/mines.hibr]=1 [apps/Games/snake.hibr]=1 [apps/Internet/browser.hibr]=1 [apps/Internet/mail.hibr]=1 [apps/Office/dbase.hibr]=1 [apps/Office/diagram.hibr]=1 [apps/Office/pdfr.hibr]=1 [apps/Office/sheet.hibr]=1 [apps/Office/write.hibr]=1 [apps/Sound & Video/audio.hibr]=1 [apps/Sound & Video/video.hibr]=1 [apps/archives.hibr]=1 [apps/boxerplay.hibr]=1 [apps/calendar.hibr]=1 [apps/contacts.hibr]=1 [apps/files.hibr]=1 [apps/switchboard.hibr]=1 [apps/term.hibr]=1 [apps/vault.hibr]=1 [apps/wiretap.hibr]=1 [control-panel/abouthibr.hibr]=1 [control-panel/aboutme.hibr]=1 [control-panel/adminaccess.hibr]=1 [control-panel/appearance.hibr]=1 [control-panel/arabizi.hibr]=1 [control-panel/archiveset.hibr]=1 [control-panel/audioset.hibr]=1 [control-panel/blit.hibr]=1 [control-panel/bluetooth.hibr]=1 [control-panel/boxerset.hibr]=1 [control-panel/browserset.hibr]=1 [control-panel/camset.hibr]=1 [control-panel/cliphist.hibr]=1 [control-panel/control-strip.hibr]=1 [control-panel/datetime.hibr]=1 [control-panel/desktop.hibr]=1 [control-panel/displays.hibr]=1 [control-panel/filesview.hibr]=1 [control-panel/filetypes.hibr]=1 [control-panel/language.hibr]=1 [control-panel/loginmgr.hibr]=1 [control-panel/longwire.hibr]=1 [control-panel/mailset.hibr]=1 [control-panel/menubar.hibr]=1 [control-panel/menuedit.hibr]=1 [control-panel/mouse.hibr]=1 [control-panel/network.hibr]=1 [control-panel/networks.hibr]=1 [control-panel/notes.hibr]=1 [control-panel/notifications.hibr]=1 [control-panel/pictures.hibr]=1 [control-panel/pimset.hibr]=1 [control-panel/pnotes.hibr]=1 [control-panel/power.hibr]=1 [control-panel/prayerset.hibr]=1 [control-panel/screensaver.hibr]=1 [control-panel/screenshots.hibr]=1 [control-panel/sheetset.hibr]=1 [control-panel/shortcuts.hibr]=1 [control-panel/sound.hibr]=1 [control-panel/taskmgr.hibr]=1 [control-panel/terminal.hibr]=1 [control-panel/trayset.hibr]=1 [control-panel/vaultset.hibr]=1 [control-panel/versions.hibr]=1 [control-panel/videoset.hibr]=1 [control-panel/wallpaper.hibr]=1 [control-panel/wallset.hibr]=1 [control-panel/webapps.hibr]=1 [control-panel/windows.hibr]=1 [control-panel/wiretap.hibr]=1 [control-strip/cursor.hibr]=1 [control-strip/longwire.hibr]=1 [control-strip/nextprayer.hibr]=1 [control-strip/power.hibr]=1 [control-strip/shadow.hibr]=1 [control-strip/theme.hibr]=1 [control-strip/wallpaper.hibr]=1 [control-strip/wiretap.hibr]=1 [control-strip/workspaces.hibr]=1 [longwire-switchboard.hibr]=1 [longwire.hibr]=1 [menubar/audiobar.hibr]=1 [menubar/bluetooth.hibr]=1 [menubar/keyboard.hibr]=1 [menubar/longwire.hibr]=1 [menubar/network.hibr]=1 [menubar/power.hibr]=1 [menubar/prayer.hibr]=1 [menubar/sound.hibr]=1 [menubar/tray.hibr]=1 [menubar/wiretap.hibr]=1 [savers/classicmac.hibr]=1 [savers/clock.hibr]=1 [savers/matrix.hibr]=1 [savers/mystify.hibr]=1 [savers/pipes.hibr]=1 [savers/toasters.hibr]=1 [system/about.hibr]=1 [system/catalogue.hibr]=1 [system/clipboard.hibr]=1 [system/modman.hibr]=1 [system/notifications.hibr]=1 [system/screenshot.hibr]=1 [system/tasks.hibr]=1 [video-bilibili.hibr]=1 [video-bilibilitv.hibr]=1 [video-tubi.hibr]=1 [video-youtube.hibr]=1 [videocore.hibr]=1 [wiretap.hibr]=1)
declare -gA DT_RTSECRET=([DT_VWITEMS]=1 [VW_SESSION]=1)
declare -gA DT_RTSKIP=([DT_BARI]="c w")
# Which of them are maps or lists, each sent whole, as JSON.
declare -gA DT_RTMAP=([CS_MOD_ALL]=1 [CS_MOD_ORD]=1 [DRW]=1 [DT]=1 [DT_AKEY]=1 [DT_AKEYORDER]=1 [DT_APPKEY]=1 [DT_APPS]=1 [DT_BANDS]=1 [DT_BARI]=1 [DT_BARREAD]=1 [DT_BELLICONS]=1 [DT_BTNL]=1 [DT_BTNS]=1 [DT_CH]=1 [DT_CHORDER]=1 [DT_CONFJ]=1 [DT_DISPNAMES]=1 [DT_DLGBTNS]=1 [DT_FULLENDS]=1 [DT_HANDLERS]=1 [DT_ICONPENS]=1 [DT_KB]=1 [DT_KEYORDER]=1 [DT_KEYS]=1 [DT_NATFOCUSES]=1 [DT_NOTECOLOURS]=1 [DT_NOTEHIST]=1 [DT_NOTEHIST_ORDER]=1 [DT_NOTELEVELS]=1 [DT_OPENERORDER]=1 [DT_OPENERS]=1 [DT_OPENVERBS]=1 [DT_OVLIST]=1 [DT_OWLIST]=1 [DT_PLACES]=1 [DT_SBLIST]=1 [DT_SHADOWSHAPES]=1 [DT_TITLEBARS]=1 [DT_VWA]=1 [DT_VWITEMS]=1 [DT_ZOOMFILLS]=1 [SV_LIST]=1 [WP_GLYPHS]=1 [WP_MODES]=1 [WS_ALIGNS]=1 [WS_FRAMES]=1 [WS_STYLES]=1)

# The names sent today, declared in an app's own process: called by the
# runtime alone, before its hello.
dt_rtdeclare() {
	declare -g CS_HIDE CS_ORDER CS_SHADOW CS_SHOW CS_SIDE DT_ACTIVE DT_APPMODE DT_BAD
	declare -g DT_BAND DT_BANDPCT DT_BAR DT_BARGAP DT_BARICON DT_BARORDER DT_BARSHADOW DT_BARTIME
	declare -g DT_BARTRANS DT_BELLICON DT_BIDI DT_BTBAR DT_BTKIND DT_BTNON DT_BTNORDER DT_BTNSHADOW
	declare -g DT_BTNSTYLE DT_BUNDLEEXT DT_CHECKS DT_CLIPKEEP DT_CLIPMAX DT_COLOURS DT_COLS DT_CURSOR
	declare -g DT_CURSOR_BLINK DT_CYCLE DT_DAVSAVE DT_DAVTIMEOUT DT_DBLACTION DT_DESKICON DT_DIGITS DT_DIM
	declare -g DT_DISKS DT_DLGBTN DT_DOT DT_DRAGKEY DT_DRAGMOD DT_DRAWSKIP DT_EDGERESIZE DT_FACE
	declare -g DT_FILMDETAIL DT_FOCUS DT_FOCUSHOVER DT_FRAME DT_FULLEND DT_FULLON DT_GLYPH DT_GLYPHSET
	declare -g DT_GOOD DT_HADJ DT_HCAL DT_HERE DT_HIGHLIGHT DT_HOT DT_HOVER DT_ICONBG
	declare -g DT_ICONS DT_IDLE DT_IME DT_IMGCOMP DT_IMGDETAIL DT_IMGEDITS DT_IMGFD DT_IMGMODE
	declare -g DT_INFO DT_INK DT_KBCUR DT_KBLOC DT_KBLOCAL DT_KBN DT_KBRES DT_LANG
	declare -g DT_LIVEMS DT_LOCKAFTER DT_LOCKWHERE DT_LOG DT_MENUBOLD DT_MENUMARK DT_MENUMAX DT_MIRROR
	declare -g DT_MOVEMODE DT_MSHADOW DT_NATFOCUS DT_NATIVE DT_NATREMEMBER DT_NATX11 DT_NETBAR DT_NETKIND
	declare -g DT_NETRULE DT_NEWON DT_NOTECOLOUR DT_NOTECOUNT DT_NOTEFRAME DT_NOTEHMAX DT_NOTEHMIN DT_NOTELIST
	declare -g DT_NOTEMS DT_NOTEPOS DT_NOTEWHERE DT_NOTEWMAX DT_NOTEWMIN DT_OPENWITH DT_PADJ DT_PASR
	declare -g DT_PATHAN DT_PATHANF DT_PBAR DT_PBEFORE DT_PKRES DT_PLACE DT_PLAT DT_PLON
	declare -g DT_PMETHOD DT_PNOTE DT_PRIMARY_COL DT_PRIMARY_H DT_PRIMARY_W DT_PROGAUTO DT_PRULE DT_PSTRIP
	declare -g DT_PWBAR DT_PWCRIT DT_PWCRITDO DT_PWLEVEL DT_PWLOW DT_RESTORED DT_ROWS DT_SAVER
	declare -g DT_SAVERIDLE DT_SCROLLWHEEL DT_SELINK DT_SHADOW DT_SHADOWINK DT_SHADOWSHAPE DT_SHADOW_PCT DT_SHOTDIR
	declare -g DT_SHOTFMT DT_SHOTLAST DT_SNDBAR DT_SNDKIND DT_SNDLEVEL DT_SNDSTEP DT_STANDBYAUTO DT_SWITCHER
	declare -g DT_SWMS DT_SWSKIP DT_TERMBAR DT_TERMCTRL DT_TERMHERE DT_TERMKEEP DT_TERMMS DT_THEMECHECKS
	declare -g DT_TILEMAIN DT_TIPMS DT_TIPS DT_TITLE DT_TITLEALIGN DT_TITLEBAR DT_TITLEINK DT_TITLEKEY
	declare -g DT_TRASH DT_TRASHN DT_TREELINES DT_TREESTYLE DT_UPNEW DT_UPSESSION DT_VER DT_VWCLEAR
	declare -g DT_VWERR DT_VWJOB DT_VWSYNC DT_VWSYNCED DT_WALL DT_WALLBAD DT_WALLIMG DT_WALLIMGMODE
	declare -g DT_WALLMODE DT_WALLTRIED DT_WARN DT_WEEKSTART DT_WELL DT_WINTRANS DT_WS DT_WSN
	declare -g DT_ZOOMFILL VW_SESSION
	declare -gA DRW DT DT_AKEY DT_APPKEY DT_APPS DT_BARI DT_CH DT_HANDLERS
	declare -gA DT_KB DT_KEYS DT_NOTEHIST DT_OPENERS DT_OPENVERBS DT_VWA
	declare -ga CS_MOD_ALL DT_AKEYORDER DT_BANDS DT_BELLICONS DT_BTNS DT_CHORDER DT_DISPNAMES DT_DLGBTNS
	declare -ga DT_FULLENDS DT_ICONPENS DT_KEYORDER DT_NOTECOLOURS DT_NOTEHIST_ORDER DT_NOTELEVELS DT_OPENERORDER DT_PLACES
	declare -ga DT_SBLIST DT_SHADOWSHAPES DT_TITLEBARS DT_VWITEMS DT_ZOOMFILLS SV_LIST WP_GLYPHS WP_MODES
	declare -ga WS_ALIGNS WS_FRAMES WS_STYLES
	return 0
}
