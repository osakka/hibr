#!/usr/bin/env hibr
#
# pictures -- the Control Panel pane for how a picture is drawn: half
# blocks, the same in grey, the character ramp, or real pixels where the
# terminal can place them. One setting reaches every picture the desktop
# draws -- the Image Viewer, the wallpaper, Mail's pictures, the film player
# and the browser -- since each passes DT_IMGMODE to the module that draws
# it.
#
# What the terminal can do is shown beside it, because the honest answer is
# "it depends on your terminal", and it names the protocol in force: the
# kitty graphics protocol or sixel, each needing the terminal to say what a
# cell measures (ADR 0037). Which of the two is not a choice -- no terminal
# does both well, and kitty does not do sixel at all -- so the setting says
# Pixels and the console picks.

strict


app pictures "The Control Panel pane for how a picture is drawn" 1.5.3
command -v cp_pane > /dev/null && cp_pane pictures "Pictures" "▦"

CP_IMGMODES=(auto half mono ascii pixels)
# Three states, because the two kinds of picture want opposite answers: a
# wallpaper sits behind text and is re-sent to every client that attaches,
# where a film's frame and a page are the thing being looked at. Automatic
# is each kind's own answer; the other two are one rule for everything, for
# a link that cannot carry full frames (Gitea #228).
CP_IMGDETAILS=(auto full half)
# A film's frames on their own (0.99.403): Full by default, the owner's
# choice, since a film is what is being looked at; Half is a quarter of the
# bytes a frame, for a link that cannot carry it.
CP_FILMDETAILS=(full half)
CP_IMGCOMPS=(zlib png off)
CP_IMGEDITS=(auto off)
# Colours: how many every display is sent (Gitea #353).
CP_DEPTHS=(auto 24 256 16)

# Each setting is the window manager's (wm/wallpaper.hibr), declared and
# kept there, and what it does to the console follows from dt_set there.

fn cp_set_imgdetail(int? id = "", value = "") {
	local v=auto

	case $value in
	full | half) v=$value ;;
	esac
	dt_set DT_IMGDETAIL "$v"
}

fn cp_set_filmdetail(int? id = "", value = "") {
	local v=full

	[ "$value" = half ] && v=half
	dt_set DT_FILMDETAIL "$v"
}

# What that setting is called in the list, with what it does rather than
# only its name: "Automatic" alone says nothing about which pictures are
# halved, and a value with no unit is what let Redraw Skip mean nothing
# for 155 releases.
fn cp_detailname(m) {
	case $m in
	full) ret "Full (every picture)" ;;
	half) ret "Half (every picture)" ;;
	*) ret "Automatic (wallpaper half, the rest full)" ;;
	esac
}
fn cp_filmname(m) {
	[ "$m" = half ] && { ret "Half"; return 0; }
	ret "Full"
}
# Automatic or off, in words.
fn cp_autoname(m) {
	[ "$m" = off ] && { ret "Off"; return 0; }
	ret "Automatic"
}

# How a still picture's payload is compressed before it is sent (Gitea
# #129). Zlib is the default and PNG is smaller again -- see the note in
# mods/console/cn.h for why the smaller one is not the default: a terminal
# that takes f=24 and not f=100 draws nothing and cannot say so.
fn cp_set_imgcomp(int? id = "", value = "") {
	local v=zlib

	case $value in
	png | off) v=$value ;;
	esac
	dt_set DT_IMGCOMP "$v"
}

# Whether a picture that changed only in part goes out as that part,
# edited into the one on the terminal (Gitea #404): Automatic where every
# display says it can, Off for a whole picture every time it changes.
fn cp_set_imgedits(int? id = "", value = "") {
	local v=auto

	[ "$value" = off ] && v=off
	dt_set DT_IMGEDITS "$v"
}

# Whether a window's picture goes to Blit by descriptor rather than through
# the terminal (Blit ADR 0202): Automatic on a Blit session that offers it,
# and inside hold only where every display can take it; Off for the
# terminal every time.
fn cp_set_imgfd(int? id = "", value = "") {
	local v=auto

	[ "$value" = off ] && v=off
	dt_set DT_IMGFD "$v"
}

fn cp_set_depth(int? id = "", value = "") {
	local v=auto

	case $value in
	24 | 256 | 16) v=$value ;;
	esac
	dt_set DT_COLOURS "$v"
}

# The name a colour depth has in the list.
fn cp_depthname(m) {
	case $m in
	24) ret "24-bit" ;;
	256 | 16) ret "$m" ;;
	*) ret "Automatic" ;;
	esac
}

# The name that setting has in the list.
fn cp_compname(m) {
	case $m in
	png) ret "PNG" ;;
	off) ret "Off" ;;
	*) ret "Zlib" ;;
	esac
}

# The name a mode has in the list, and the mode a name stands for.
fn cp_imgname(m) {
	case $m in
	half) ret "Half Blocks" ;;
	mono) ret "Grey Blocks" ;;
	ascii) ret "Characters" ;;
	pixels | sixel) ret "Pixels" ;;
	*) ret "Automatic" ;;
	esac
}

fn cp_set_imgmode(int? id = "", value = "") {
	local v=auto

	case $value in
	half | mono | ascii | pixels) v=$value ;;
	esac
	dt_set DT_IMGMODE "$v"
}

fn pictures_rows(int w) {
	local n=0 v term g kind cw ch

	case $DT_IMGMODE in
	half | mono | ascii | pixels) v=$DT_IMGMODE ;;
	sixel) v=pixels ;;
	*) v=auto ;;
	esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Draw Pictures As"; CP[$w][$n]["key"]=mode
	cp_choice "$w" "$n" "$v" cp_set_imgmode "${CP_IMGMODES[@]}"
	CP[$w][$n]["vname"]=cp_imgname; n=$((n + 1))
	g := dt_imggfx
	read -r kind cw ch <<< "$g"
	# In its own variable, not in v: it used to be worked out into v and
	# then overwritten by the detail row's value two lines later, so the
	# This Terminal row read "Half" or "Full" -- what the terminal can
	# actually do had never once been shown there.
	if [ "$kind" = sixel ] || [ "$kind" = kitty ]; then
		term := dt_tr "%s pixels, a cell is %s by %s" "$kind" "$cw" "$ch"
	elif [ "$cw" = 0 ]; then
		term := dt_tr "blocks only: it does not say what a cell measures"
	else
		term := dt_tr "blocks only: it does not draw pixels"
	fi
	v=auto
	case $DT_IMGDETAIL in full | half) v=$DT_IMGDETAIL ;; esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Picture Detail"; CP[$w][$n]["key"]=imgdetail
	cp_choice "$w" "$n" "$v" cp_set_imgdetail "${CP_IMGDETAILS[@]}"
	CP[$w][$n]["vname"]=cp_detailname; n=$((n + 1))
	v=full
	[ "$DT_FILMDETAIL" = half ] && v=half
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Film Detail"; CP[$w][$n]["key"]=filmdetail
	cp_choice "$w" "$n" "$v" cp_set_filmdetail "${CP_FILMDETAILS[@]}"
	CP[$w][$n]["vname"]=cp_filmname; n=$((n + 1))
	v=zlib
	case $DT_IMGCOMP in png | off) v=$DT_IMGCOMP ;; esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Compress Pictures"; CP[$w][$n]["key"]=imgcomp
	cp_choice "$w" "$n" "$v" cp_set_imgcomp "${CP_IMGCOMPS[@]}"
	CP[$w][$n]["vname"]=cp_compname; n=$((n + 1))
	v=auto
	[ "$DT_IMGEDITS" = off ] && v=off
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Partial Updates"; CP[$w][$n]["key"]=imgedits
	cp_choice "$w" "$n" "$v" cp_set_imgedits "${CP_IMGEDITS[@]}"
	CP[$w][$n]["vname"]=cp_autoname; n=$((n + 1))
	v=auto
	[ "$DT_IMGFD" = off ] && v=off
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Frames to Blit"; CP[$w][$n]["key"]=imgfd
	cp_choice "$w" "$n" "$v" cp_set_imgfd "${CP_IMGEDITS[@]}"
	CP[$w][$n]["vname"]=cp_autoname; n=$((n + 1))
	v=auto
	case ${DT_COLOURS:-auto} in 24 | 256 | 16) v=$DT_COLOURS ;; esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Colours"; CP[$w][$n]["key"]=depth
	cp_choice "$w" "$n" "$v" cp_set_depth "${CP_DEPTHS[@]}"
	CP[$w][$n]["vname"]=cp_depthname; n=$((n + 1))
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="This Terminal"
	CP[$w][$n]["val"]=$term; n=$((n + 1))
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Automatic Means"
	v := cp_imgname half
	dt_imgpix && v := cp_imgname pixels
	CP[$w][$n]["val"]=$v; n=$((n + 1))
	ret "$n"
}



