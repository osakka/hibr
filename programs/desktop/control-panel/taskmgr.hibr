#!/usr/bin/env hibr
#
# taskmgr -- the Control Panel pane for Task Manager: how often it rescans,
# whether its list has a scrollbar, and the order a new window starts in.
# Its rows appear only once Task Manager itself is loaded, the same way the
# Terminal pane's wait for the terminal.

strict


app taskmgr "The Control Panel pane for Task Manager" 1.0
command -v cp_pane > /dev/null && cp_pane taskmgr "Task Manager" "⚙"

CP_TKTICKS=(500 1000 2000 3000 5000 10000)
CP_TKDIRS=(desc asc)

# The filter is kept as a plain word and shown as a phrase, so the pane
# reads the way the Task menu's own Show submenu does.
fn cp_tkfiltername(f) {
	case $f in
	mine) ret "Mine" ;;
	desktop) ret "This Desktop" ;;
	*) ret "Everyone" ;;
	esac
}

# Chosen here it goes through the app, so an open Task Manager reads the
# process table again and says in its title what it is showing; with the
# pane loaded on its own there is nothing to tell, and the setting is all
# there is to set.
fn cp_set_tkfilter(int? id = "", value = "") {
	local f=everyone

	case $value in
	Mine | mine) f=mine ;;
	"This Desktop" | desktop) f=desktop ;;
	esac
	if command -v tasks_filterset > /dev/null; then
		tasks_filterset "$f"
		return 0
	fi
	dt_set TK_FILTER "$f"
}

fn cp_set_tasks(int? id = "", int? value = "") { dt_set TK_SCANMS "$value"; }
fn cp_set_tksort(int? id = "", value = "") { dt_set TK_SORTBY "$value"; }
fn cp_set_tkdir(int? id = "", value = "") { dt_set TK_SORTDIR "$value"; }

fn taskmgr_rows(int w) {
	local n=0

	[ -n "$TK_SCANMS" ] || { cp_absent "$w" "Task Manager"; ret 1; }
	if [ -n "$TK_SCANMS" ]; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Refresh"; CP[$w][$n]["key"]=tasksrefresh
		cp_choice "$w" "$n" "$TK_SCANMS" cp_set_tasks "${CP_TKTICKS[@]}"
		CP[$w][$n]["vname"]=cp_ms
		n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Scrollbar"
		CP[$w][$n]["wtype"]=bool
		CP[$w][$n]["val"]=off; [ "$TK_BAR" = 1 ] && CP[$w][$n]["val"]=on
		CP[$w][$n]["key"]=tkbar; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sort By"; CP[$w][$n]["key"]=tksort
		cp_choice "$w" "$n" "$TK_SORTBY" cp_set_tksort "${TK_COLS[@]}"
		n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Order"; CP[$w][$n]["key"]=tkdir
		cp_choice "$w" "$n" "$TK_SORTDIR" cp_set_tkdir "${CP_TKDIRS[@]}"
		n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Show"; CP[$w][$n]["key"]=tkfilter
		cp_choice "$w" "$n" "${TK_FILTER:-everyone}" cp_set_tkfilter "${TK_FILTERS[@]}"
		CP[$w][$n]["vname"]=cp_tkfiltername
		n=$((n + 1))
	fi
	ret "$n"
}

fn taskmgr_do(int w, k, int dir) {
	case $k in
	tkbar) cp_toggle TK_BAR ;;
	esac
	return 0
}

