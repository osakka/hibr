#!/usr/bin/env hibr
#
# tube -- the Control Panel pane for the YouTube app: how the picture is
# drawn, the quality YouTube's player is asked to fetch, whether the next
# video plays by itself, and forgetting what was watched. Named tube, not
# youtube, because the app owns the youtube_ prefix. Frames a second and
# colour detail are there only with an engine whose video is played here
# (`web caps` lists tap): WebKit plays the page at its own rate, and the
# window draws what it has.

strict


app tube "The Control Panel pane for the YouTube app" 2.5
command -v cp_pane > /dev/null && cp_pane tube "YouTube" "▶" app

# follow is Control Panel > Pictures, which is the one setting meant to
# reach every picture the desktop draws; the rest say outright.
TB_MODES=(follow half ascii mono pixels)
# The qualities are the YouTube app's own list (YT_QUALITIES, with yt_qnorm for
# a setting saved under an older name): one source, so the pane, the app's menu
# and its bar say the same words. Nothing here repeats them.
declare -g TB_Q=
TB_FPS=(10 15 24 30)
TB_DETAIL=(0 1 2 3)

# Whether the engine's video is played here: `web caps` lists tap.
fn tb_tap() {
	local c

	need web 2> /dev/null || return 1
	c := web caps 2> /dev/null
	case " $c " in *" tap "*) return 0 ;; esac
	return 1
}

fn cp_set_ytmode(int? id = "", value = "") { YT_MODE=$value; cp_save; }

# The current quality as the app's list says it, into TB_Q.
fn tb_qcur() {
	TB_Q=$YT_QUALITY
	dt_has yt_qnorm && TB_Q := yt_qnorm "$YT_QUALITY"
	return 0
}
fn cp_set_ytquality(int? id = "", value = "") {
	YT_QUALITY=$value
	cp_save
	dt_needs youtube yt_qapply && yt_qapply
	return 0
}
fn cp_set_ytfps(int? id = "", int? value = "") { YT_FPS=$value; cp_save; }
fn cp_set_ytdetail(int? id = "", int? value = "") { YT_DETAIL=$value; cp_save; }

fn tube_rows(int w) {
	local n=0 md

	dt_has youtube_draw || { cp_absent "$w" YouTube; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Picture"
	CP[$w][$n]["val"]="$YT_MODE"; CP[$w][$n]["key"]=mode
	n=$((n + 1))
	if [ "$YT_MODE" = follow ]; then
		md := yt_drawmode
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Drawn Now"
		CP[$w][$n]["val"]=$md; n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Quality Fetched"
	tb_qcur
	CP[$w][$n]["val"]="$TB_Q"; CP[$w][$n]["key"]=quality
	n=$((n + 1))
	if tb_tap; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Frames a Second"
		CP[$w][$n]["val"]="$YT_FPS"; CP[$w][$n]["key"]=fps
		n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Colour Detail"
		CP[$w][$n]["val"]="$YT_DETAIL"; CP[$w][$n]["key"]=detail
		n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Show Captions"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${YT_CAPTIONS:-0}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_CAPTIONS; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Play Next Automatically"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$YT_AUTONEXT" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_AUTONEXT; n=$((n + 1))
	CP[$w][$n]["kind"]=set
	CP[$w][$n]["text"]="Keep the Screen Saver Away While Playing"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${YT_SAVERHOLD:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_SAVERHOLD; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mini Player Shadow"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${YT_MINISHADOW:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_MINISHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mini Player Sticky"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${YT_MINISTICKY:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=YT_MINISTICKY; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Clear History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=histclear
	n=$((n + 1))
	ret "$n"
}

fn tube_do(int? w = "", k = "", int? dir = "") {
	local v

	case $k in
	mode) v := cp_next "$YT_MODE" "$dir" "${TB_MODES[@]}"; YT_MODE=$v ;;
	quality) tb_qcur; v := cp_next "$TB_Q" "$dir" "${YT_QUALITIES[@]}"; YT_QUALITY=$v ;;
	fps) v := cp_next "$YT_FPS" "$dir" "${TB_FPS[@]}"; YT_FPS=$v ;;
	detail) v := cp_next "$YT_DETAIL" "$dir" "${TB_DETAIL[@]}"; YT_DETAIL=$v ;;
	YT_AUTONEXT | YT_SAVERHOLD | YT_CAPTIONS) cp_toggle "$k" ;;
	YT_MINISHADOW | YT_MINISTICKY)
		cp_toggle "$k"
		dt_needs youtube yt_miniapply && yt_miniapply
		;;
	histclear) dt_needs youtube yt_histclear && yt_histclear ;;
	esac
	cp_save
}

fn tube_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	mode) dt_droplist "$w" "$r" "$c" cp_set_ytmode "${TB_MODES[@]}" ;;
	quality) dt_droplist "$w" "$r" "$c" cp_set_ytquality "${YT_QUALITIES[@]}" ;;
	fps) dt_droplist "$w" "$r" "$c" cp_set_ytfps "${TB_FPS[@]}" ;;
	detail) dt_droplist "$w" "$r" "$c" cp_set_ytdetail "${TB_DETAIL[@]}" ;;
	esac
}
