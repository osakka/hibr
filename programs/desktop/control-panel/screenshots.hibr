#!/usr/bin/env hibr
#
# screenshots -- the dialog that types the screenshot folder, and the
# choices for the Desktop pane's screenshot rows (wm/shot.hibr takes them).
# They are rows of Desktop rather than a pane of their own because the
# Control Panel's list of panes does not scroll and is full.

strict

SH_FMTS=(ansi html text)
SH_STARTS=(screen window area)

fn cp_set_shotfmt(int? id = "", value = "") { DT_SHOTFMT=$value; cp_save; }
fn cp_set_shotlast(int? id = "", value = "") { DT_SHOTLAST=$value; cp_save; }

# The folder, typed: the desktop's one-line question (wm/ask.hibr).
shd_dialog() {
	dt_ask "Screenshot Folder" "Folder:" "$DT_SHOTDIR" shd_set \
		"Made if it is not there; ~ is your home."
}

# Keep the folder if it is one, or can be made; refused, the question stays
# open with what was typed.
fn shd_set(d, int id) {
	case $d in "~") d=$HOME ;; "~/"*) d="$HOME/${d#"~/"}" ;; esac
	if [ -z "$d" ]; then
		dt_notep low "A folder is needed"
		return 1
	fi
	if [ ! -d "$d" ] && ! mkdir -p "$d" 2> /dev/null; then
		dt_notep high "%s cannot be made" "$d"
		return 1
	fi
	DT_SHOTDIR=$d
	cp_save
	return 0
}
