#!/usr/bin/env hibr
#
# language -- the Control Panel pane for Language & Region (Gitea #526): the
# system's language, which programs speak and the desktop's own words follow
# wherever hibr has a catalogue (#68, ADR 0032), and its region, the formats
# programs write dates, numbers, money, measures and paper in, each of which
# may be set on its own. They are the system's, one source of truth: read
# from it and changed through localectl, which asks for an administrator
# (wm/locale.hibr). Below them, how the desktop itself shows right-to-left
# text and digits.

strict


app language "The system's language and region, and how the desktop shows them" 1.0.4
command -v cp_pane > /dev/null && cp_pane language "Language & Region" "A"
# The pane's own dialog, named so the application menu reads "Add a
# Language" rather than its prefix.
command -v dt_app > /dev/null && dt_app locadd "Add a Language" 16 56 "" "" fixed hidden

declare -ga CP_BIDIS CP_LOCN
CP_MIRRORS=(auto on off)
CP_DIGITS=(Western Arabic-Indic)
# The formats a region sets.
CP_LOCCATS=(LC_TIME LC_NUMERIC LC_MONETARY LC_MEASUREMENT LC_PAPER)

# Ordering right-to-left text: who does it (ADR 0031). Automatic asks the
# terminal and says in brackets what it settled on, since the wrong one
# makes Arabic read left to right rather than fail outright.
CP_BIDIS=("Automatic" "hibr" "The Terminal")

# What the ordering setting shows, with what automatic settled on.
cp_bidiname() {
	local on

	case $DT_BIDI in
	on) ret "hibr" ;;
	off) ret "The Terminal" ;;
	esac
	on := dt_bidion
	[ "$on" = 1 ] && ret "Automatic (hibr)"
	ret "Automatic (the terminal)"
}

# Choose who orders right-to-left text.
fn cp_set_bidi(int? id = "", value = "") {
	case $value in
	hibr) DT_BIDI=on ;;
	"The Terminal") DT_BIDI=off ;;
	*) DT_BIDI=auto ;;
	esac
	dt_langapply
	cp_save
}

# Mirror the layout: auto (with the language), on or off.
fn cp_set_mirror(int? id = "", value = "") {
	DT_MIRROR=$value
	dt_langapply
	cp_save
}

# Western or Arabic-Indic digits.
fn cp_set_digits(int? id = "", value = "") {
	DT_DIGITS=western
	[ "$value" = Arabic-Indic ] && DT_DIGITS=arabic
	cp_save
}

# Every locale this system has, by name, into CP_LOCN.
cp_locnames() {
	local l

	CP_LOCN=()
	for l in "${DT_LOCLIST[@]}"; do
		CP_LOCN+=("${DT_LOCNAMES["$l"]}")
	done
}

# The region: the locale most of the formats are in, a format the system
# does not set being LANG's.
cp_locregion() {
	local c v best= bn=0 n
	local -A cnt

	for c in "${CP_LOCCATS[@]}"; do
		v=${DT_LOC["$c"]:-${DT_LOC["LANG"]:-${LANG-}}}
		cnt["$v"]=$((${cnt["$v"]:-0} + 1))
	done
	for c in "${CP_LOCCATS[@]}"; do
		v=${DT_LOC["$c"]:-${DT_LOC["LANG"]:-${LANG-}}}
		n=${cnt["$v"]}
		[ "$n" -gt "$bn" ] && { best=$v; bn=$n; }
	done
	ret "$best"
}

# Choose the language by its name: LANG.
fn cp_set_loclang(int? id = "", value = "") {
	local l

	l := dt_locbyname "$value"
	dt_locset "LANG=$l"
}

# Choose the region by its name: every format at once.
fn cp_set_locregion(int? id = "", value = "") {
	local l c
	local -a a

	l := dt_locbyname "$value"
	for c in "${CP_LOCCATS[@]}"; do
		a+=("$c=$l")
	done
	dt_locset "${a[@]}"
}

# One format on its own, or back to the region's.
fn cp_locfmt(cat, value) {
	local l

	if [ "$value" = "Same as Region" ]; then
		l := cp_locregion
	else
		l := dt_locbyname "$value"
	fi
	dt_locset "$cat=$l"
}
fn cp_set_loc_LC_TIME(int? id = "", value = "") { cp_locfmt LC_TIME "$value"; }
fn cp_set_loc_LC_NUMERIC(int? id = "", value = "") { cp_locfmt LC_NUMERIC "$value"; }
fn cp_set_loc_LC_MONETARY(int? id = "", value = "") { cp_locfmt LC_MONETARY "$value"; }
fn cp_set_loc_LC_MEASUREMENT(int? id = "", value = "") { cp_locfmt LC_MEASUREMENT "$value"; }
fn cp_set_loc_LC_PAPER(int? id = "", value = "") { cp_locfmt LC_PAPER "$value"; }

fn language_rows(int w) {
	local n=0 nm c v r

	command -v dt_locinfostart > /dev/null && dt_locinfostart
	if [ -n "${LC_ALL-}" ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="LC_ALL Overrides These"
		CP[$w][$n]["val"]=$LC_ALL; n=$((n + 1))
	fi
	nm := dt_locname "${DT_LOC["LANG"]:-${LANG-}}"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Language"
	CP[$w][$n]["val"]="$nm"; CP[$w][$n]["key"]=loclang; n=$((n + 1))
	r := cp_locregion
	nm := dt_locname "$r"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Region"
	CP[$w][$n]["val"]="$nm"; CP[$w][$n]["key"]=locregion; n=$((n + 1))
	if [ "${DT_LOCINFO-}" = ok ] && [ "${#DT_LOCLIST[@]}" = 0 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="No Other Languages Installed"
		CP[$w][$n]["val"]=""; n=$((n + 1))
	fi
	# Making one the system does not have (part two of #526), where the
	# system can be changed at all.
	if command -v localectl > /dev/null && command -v dt_locinstall > /dev/null; then
		CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Add a Language${GL[ellipsis]}"
		CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=locadd; n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Formats"; n=$((n + 1))
	# Each format's row, its label written out so the catalogue has it.
	for c in "${CP_LOCCATS[@]}"; do
		v=${DT_LOCEX["$c"]-}
		[ -n "$v" ] || v := dt_locname "${DT_LOC["$c"]:-$r}"
		CP[$w][$n]["kind"]=set; CP[$w][$n]["val"]=$v; CP[$w][$n]["key"]="loc:$c"
		case $c in
		LC_TIME) CP[$w][$n]["text"]="Dates & Times" ;;
		LC_NUMERIC) CP[$w][$n]["text"]="Numbers" ;;
		LC_MONETARY) CP[$w][$n]["text"]="Currency" ;;
		LC_MEASUREMENT) CP[$w][$n]["text"]="Measurement" ;;
		LC_PAPER) CP[$w][$n]["text"]="Paper" ;;
		esac
		n=$((n + 1))
	done
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Right-to-Left"; n=$((n + 1))
	nm := cp_bidiname
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Order Right-to-Left Text"
	CP[$w][$n]["val"]="$nm"; CP[$w][$n]["key"]=bidi; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mirror Layout"
	CP[$w][$n]["val"]="$DT_MIRROR"; CP[$w][$n]["key"]=mirror; n=$((n + 1))
	nm=Western
	[ "$DT_DIGITS" = arabic ] && nm=Arabic-Indic
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Digits"
	CP[$w][$n]["val"]="$nm"; CP[$w][$n]["key"]=digits; n=$((n + 1))
	# Typing through an input method away from Blit (Gitea #543): the same
	# choice the bar's item and Next Keyboard make, one variable for all
	# three. On Blit the list is Blit's, chosen in its own Keyboard pane.
	# And whether the bar's keyboard item names the keyboard beside its
	# glyph, where that item is installed.
	if [ "${DT_KBLOC-}" = 1 ] || dt_has dt_kbbar; then
		CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Typing"; n=$((n + 1))
	fi
	if [ "${DT_KBLOC-}" = 1 ]; then
		nm := cp_imename
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Input Method"
		CP[$w][$n]["val"]="$nm"; CP[$w][$n]["key"]=imekb; n=$((n + 1))
	fi
	if dt_has dt_kbbar; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Keyboard Name on Menu Bar"
		CP[$w][$n]["wtype"]=bool
		CP[$w][$n]["val"]=off; [ "${DT_KBNAME:-1}" = 1 ] && CP[$w][$n]["val"]=on
		CP[$w][$n]["key"]=DT_KBNAME; n=$((n + 1))
	fi
	ret "$n"
}

# The keyboard the desktop's own list is on, by name: the one whose method
# is DT_KBLOCAL, the first (the terminal's own) when none is.
cp_imename() {
	local i

	for ((i = 1; i < DT_KBN; i++)); do
		if [ "${DT_KB[$i]["variant"]-}" = "$DT_KBLOCAL" ]; then
			ret "${DT_KB[$i]["name"]}"
			return 0
		fi
	done
	ret "${DT_KB[0]["name"]-}"
}

# Every keyboard in the desktop's own list, by name, into CP_IMEN.
declare -ga CP_IMEN=()
cp_imenames() {
	local i

	CP_IMEN=()
	for ((i = 0; i < DT_KBN; i++)); do
		CP_IMEN+=("${DT_KB[$i]["name"]}")
	done
}

# Choose a keyboard of the desktop's own list by its name.
fn cp_set_imekb(int? id = "", value = "") {
	local i

	for ((i = 0; i < DT_KBN; i++)); do
		if [ "${DT_KB[$i]["name"]}" = "$value" ]; then
			dt_kbset "$i"
			return 0
		fi
	done
	return 0
}

fn language_do(int? w = "", k = "", int? dir = "") {
	local v nm r

	case $k in
	locadd)
		locadd_dialog
		return 0
		;;
	loclang | locregion | loc:*)
		cp_locnames
		[ "${#CP_LOCN[@]}" -gt 0 ] || {
			dt_notep low "No other languages are installed on this computer"
			return 0
		}
		case $k in
		loclang) nm := dt_locname "${DT_LOC["LANG"]:-${LANG-}}" ;;
		*) r := cp_locregion; nm := dt_locname "${DT_LOC["${k#loc:}"]:-$r}" ;;
		esac
		v := cp_next "$nm" "$dir" "${CP_LOCN[@]}"
		case $k in
		loclang) cp_set_loclang "" "$v" ;;
		locregion) cp_set_locregion "" "$v" ;;
		*) cp_locfmt "${k#loc:}" "$v" ;;
		esac
		return 0
		;;
	bidi)
		nm := cp_bidiname
		case $nm in Automatic*) nm=Automatic ;; esac
		v := cp_next "$nm" "$dir" "${CP_BIDIS[@]}"
		cp_set_bidi "" "$v"
		return 0
		;;
	mirror)
		v := cp_next "$DT_MIRROR" "$dir" "${CP_MIRRORS[@]}"
		cp_set_mirror "" "$v"
		return 0
		;;
	DT_KBNAME)
		cp_toggle DT_KBNAME
		dt_kbshow
		return 0
		;;
	digits)
		nm=Western
		[ "$DT_DIGITS" = arabic ] && nm=Arabic-Indic
		v := cp_next "$nm" "$dir" "${CP_DIGITS[@]}"
		cp_set_digits "" "$v"
		return 0
		;;
	imekb)
		cp_imenames
		nm := cp_imename
		v := cp_next "$nm" "$dir" "${CP_IMEN[@]}"
		cp_set_imekb "" "$v"
		return 0
		;;
	esac
	cp_save
}

fn language_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	loclang)
		cp_locnames
		dt_droplist "$w" "$r" "$c" cp_set_loclang "${CP_LOCN[@]}"
		;;
	locregion)
		cp_locnames
		dt_droplist "$w" "$r" "$c" cp_set_locregion "${CP_LOCN[@]}"
		;;
	loc:*)
		cp_locnames
		dt_droplist "$w" "$r" "$c" "cp_set_loc_${k#loc:}" "Same as Region" "${CP_LOCN[@]}"
		;;
	bidi) dt_droplist "$w" "$r" "$c" cp_set_bidi "${CP_BIDIS[@]}" ;;
	mirror) dt_droplist "$w" "$r" "$c" cp_set_mirror "${CP_MIRRORS[@]}" ;;
	digits) dt_droplist "$w" "$r" "$c" cp_set_digits "${CP_DIGITS[@]}" ;;
	imekb)
		cp_imenames
		dt_droplist "$w" "$r" "$c" cp_set_imekb "${CP_IMEN[@]}"
		;;
	esac
}

# --- Add a Language: every locale the system can make and has not ---------

declare -gA LOCA
LOCA_HIT=()

# Open the dialog, and read the list it shows if it has not been.
locadd_dialog() {
	local h=16 w=56 r c rid

	dt_locsupstart
	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	rid := dt_new "Add a Language" "$h" "$w" "$r" "$c" locadd
	LOCA[$rid]["buf"]=
	LOCA[$rid]["cur"]=0
	LOCA[$rid]["sel"]=0
	LOCA[$rid]["top"]=0
	LOCA[$rid]["focus"]=text
}

# The locales matching the filter, into LOCA_HIT: a substring of the name,
# either case.
fn locadd_match(int id) {
	local q l n

	q := str lower "${LOCA[$id]["buf"]}"
	LOCA_HIT=()
	for l in "${DT_LOCSUP[@]}"; do
		n := str lower "${DT_LOCSUPN["$l"]}"
		case $n in *"$q"*) LOCA_HIT+=("$l") ;; esac
	done
}

fn locadd_draw(int id, int h, int w, ...rest) {
	local vis n sel top r i t f=${LOCA[$id]["focus"]} on=0

	dt_wclear "$id"
	[ "$DT_LOCSUPRD" = ok ] || dt_want 100
	locadd_match "$id"
	n=${#LOCA_HIT[@]}
	vis=$((h - 4))
	sel=${LOCA[$id]["sel"]}
	top=${LOCA[$id]["top"]}
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	LOCA[$id]["sel"]=$sel
	LOCA[$id]["top"]=$top
	[ "$f" = text ] && on=1
	console pen "$DT_INK" "$DT_FACE"
	dt_tput "$id" 1 2 "Find:"
	dt_textdraw "$id" 1 8 $((w - 10)) "${LOCA[$id]["buf"]}" "${LOCA[$id]["cur"]}" "$on"
	if [ "$DT_LOCSUPRD" != ok ]; then
		dt_tput "$id" 3 2 "Reading the languages this computer can add${GL[ellipsis]}"
	elif [ "$n" = 0 ]; then
		dt_tput "$id" 3 2 "No language to add matches"
	fi
	r=0
	while [ "$r" -lt "$vis" ]; do
		i=$((top + r))
		t=
		[ "$i" -lt "$n" ] && t=${DT_LOCSUPN["${LOCA_HIT[$i]}"]}
		t := str pad " $t" $((w - 4))
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			console pen "$DT_SELINK" "$DT_ACTIVE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		[ "$i" -lt "$n" ] && console put -p "w$id" $((r + 2)) 2 "$t"
		dt_wreg "$id" $((r + 2)) 2 $((w - 4)) "row$i"
		r=$((r + 1))
	done
	dt_dlgbtns "$id" "$h" "$w" "$f" ok "Add${GL[ellipsis]}" cancel Cancel
}

# Add the highlighted locale: it asks for an administrator, in a terminal
# window, so no test ever takes the step past the command it builds.
fn locadd_set(int id) {
	local l

	locadd_match "$id"
	l=${LOCA_HIT[${LOCA[$id]["sel"]}]-}
	[ -z "$l" ] && { dt_notep low "No language to add matches"; return 0; }
	dt_del "$id"
	dt_locinstall "$l"
}

fn locadd_click(int? id = "", int? r = "", int? c = "", btn = "") {
	local tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	row*) LOCA[$id]["sel"]=${tag#row}; LOCA[$id]["focus"]=text ;;
	ok) locadd_set "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

fn locadd_key(int id, key) {
	local res f=${LOCA[$id]["focus"]} d onb=1

	[ "$f" = text ] && onb=0
	if d := dt_focuskey "$key" "$onb"; then
		LOCA[$id]["focus"] := dt_focus "$f" "$d" text ok cancel
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	up) LOCA[$id]["sel"]=$((LOCA[$id]["sel"] - 1)); return 0 ;;
	down) LOCA[$id]["sel"]=$((LOCA[$id]["sel"] + 1)); return 0 ;;
	enter)
		if [ "$f" = cancel ]; then dt_del "$id"; else locadd_set "$id"; fi
		return 0
		;;
	esac
	[ "$f" = text ] || return 0
	res := dt_textkey "${LOCA[$id]["buf"]}" "${LOCA[$id]["cur"]}" "$key" ||
		return 1
	LOCA[$id]["buf"]=${res% *}
	LOCA[$id]["cur"]=${res##* }
	LOCA[$id]["sel"]=0
	LOCA[$id]["top"]=0
	return 0
}

fn locadd_close(int id) {
	unset "LOCA[$id]"
}
