#!/usr/bin/env hibr
#
# mouse -- the Control Panel pane for what the mouse does to a window: whether
# a plain side resizes it as well as a corner, whether a modifier click
# anywhere in its body moves it and which modifier, and what a double click
# on its title bar does, whether a dragged window follows by its outline
# or whole, how far one notch of the wheel scrolls, and whether and how soon a
# tooltip shows. wm/input.hibr reads
# the window settings and every scrolling window the wheel's; this pane only
# changes the DT_* settings.

strict


app mouse "The Control Panel pane for what the mouse does to a window" 1.7.1
command -v cp_pane > /dev/null && cp_pane mouse "Mouse" "◎" hardware

MS_DRAGKEYS=(alt ctrl shift)
MS_MOVEMODES=(outline solid)
MS_DBLACTIONS=(zoom min close none)
# Hover: whether the desktop hears the pointer move with no button held.
# Auto is on where a display reports the pointer in pixels by itself.
MS_HOVERS=(auto on off)
DT_HOVER="${DT_HOVER-auto}"
# Wheel Scrolls' choices, as DT_SCROLLWHEEL keeps them and as the row shows
# them: one notch of the wheel, in rows, in every window that scrolls.
MS_WHEELV=(1 2 3 5 8)
MS_WHEELL=("1 row" "2 rows" "3 rows" "5 rows" "8 rows")
DT_SCROLLWHEEL="${DT_SCROLLWHEEL-3}"
# Tooltip Delay's choices, as DT_TIPMS keeps them and as the row shows them:
# how long the pointer rests on a glyph before its tooltip shows.
MS_TIPV=(300 600 1000 1500 2500)
MS_TIPL=("300 ms" "600 ms" "1 second" "1.5 seconds" "2.5 seconds")
DT_TIPMS="${DT_TIPMS-600}"

fn cp_set_dragkey(int? id = "", value = "") { dt_set DT_DRAGKEY "$value"; }
fn cp_set_titlekey(int? id = "", value = "") { dt_set DT_TITLEKEY "$value"; }
fn cp_set_movemode(int? id = "", value = "") { dt_set DT_MOVEMODE "$value"; }
fn cp_set_dblaction(int? id = "", value = "") { dt_set DT_DBLACTION "$value"; }
fn cp_set_hover(int? id = "", value = "") { dt_set DT_HOVER "$value"; }

# A number of rows a wheel notch scrolls, in words.
fn ms_wheelname(v) {
	local i=0

	while [ "$i" -lt "${#MS_WHEELV[@]}" ]; do
		[ "${MS_WHEELV[$i]}" = "$v" ] && { ret "${MS_WHEELL[$i]}"; return 0; }
		i=$((i + 1))
	done
	ret "$v rows"
}

# A tooltip's delay, in words.
fn ms_tipname(v) {
	local i=0

	while [ "$i" -lt "${#MS_TIPV[@]}" ]; do
		[ "${MS_TIPV[$i]}" = "$v" ] && { ret "${MS_TIPL[$i]}"; return 0; }
		i=$((i + 1))
	done
	ret "$v ms"
}

fn cp_set_tipms(int? id = "", int value = 600) { dt_set DT_TIPMS "$value"; }
fn cp_set_wheel(int? id = "", int value = 3) { dt_set DT_SCROLLWHEEL "$value"; }

fn mouse_rows(int w) {
	local n=0

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Edge Resize"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_EDGERESIZE" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_EDGERESIZE; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Modifier Drag"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_DRAGMOD" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_DRAGMOD; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Drag Modifier"; CP[$w][$n]["key"]=dragkey
	cp_choice "$w" "$n" "$DT_DRAGKEY" cp_set_dragkey "${MS_DRAGKEYS[@]}"
	n=$((n + 1))
	# Held with a click on a window's title, its own menu -- Files' path.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Title Menu Modifier"; CP[$w][$n]["key"]=titlekey
	cp_choice "$w" "$n" "$DT_TITLEKEY" cp_set_titlekey "${MS_DRAGKEYS[@]}"
	n=$((n + 1))
	# How a window follows the mouse when it is moved or resized: by its
	# outline until it is let go, or whole at every step.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Drag Windows"; CP[$w][$n]["key"]=movemode
	cp_choice "$w" "$n" "${DT_MOVEMODE:-outline}" cp_set_movemode "${MS_MOVEMODES[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Titlebar Click"; CP[$w][$n]["key"]=dblaction
	cp_choice "$w" "$n" "$DT_DBLACTION" cp_set_dblaction "${MS_DBLACTIONS[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Wheel Scrolls"; CP[$w][$n]["key"]=wheel
	cp_choice "$w" "$n" "${DT_SCROLLWHEEL:-3}" cp_set_wheel "${MS_WHEELV[@]}"
	CP[$w][$n]["vname"]=ms_wheelname; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Hover"; CP[$w][$n]["key"]=hover
	cp_choice "$w" "$n" "${DT_HOVER:-auto}" cp_set_hover "${MS_HOVERS[@]}"
	n=$((n + 1))
	# Focus follows the pointer, without raising, where hovering is on.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Focus Follows Mouse"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_FOCUSHOVER" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_FOCUSHOVER; n=$((n + 1))
	# What a glyph does, said when the pointer rests on it.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tooltips"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TIPS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TIPS; n=$((n + 1))
	# How long the pointer rests before a tooltip shows.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tooltip Delay"; CP[$w][$n]["key"]=tipms
	cp_choice "$w" "$n" "${DT_TIPMS:-600}" cp_set_tipms "${MS_TIPV[@]}"
	CP[$w][$n]["vname"]=ms_tipname; n=$((n + 1))
	ret "$n"
}

fn mouse_do(int w, k, int dir) {
	local v=1

	case $k in
	DT_EDGERESIZE | DT_DRAGMOD | DT_FOCUSHOVER | DT_TIPS)
		[ "${!k}" = 1 ] && v=0
		dt_set "$k" "$v"
		;;
	esac
}

