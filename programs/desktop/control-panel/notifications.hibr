#!/usr/bin/env hibr
#
# notifications -- the Control Panel pane for the corner-stacked notes
# dt_note/dt_notify draw, and the read-only history behind them.
#
# The pane's own id is "notify", not "notifications" -- the hidden app
# that opens the history window (apps/notifications.hibr) is already
# "notifications", and dt_new looks up its lifecycle hooks purely by
# name (<id>_draw, <id>_open, <id>_drop...); sharing one id between a
# pane and a window would make this pane's own dropdown handler,
# <id>_drop, answer to dt_new's drag-and-drop hook for that window
# instead -- same trap as ft_open once was, from the other direction.
# wallpaper.hibr's own pane id (wallpick, not wallpaper) is this same
# choice made before.

strict


app notify "The Control Panel pane for the corner-stacked notes" 1.2
command -v cp_pane > /dev/null && cp_pane notify "Notifications" "◉"

CP_NOTEPOS=(top-right top-left bottom-right bottom-left)
# The primary display, where the bar is, or every display (Gitea #280).
CP_NOTEWHERE=(primary every)
CP_NOTETICKS=(1000 1500 2500 4000 6000 10000)
# A note's box, border included (Gitea #227): the widths in columns and the
# heights in rows a note may be, from the smallest it is drawn at to the
# largest before it is cut and marked.
CP_NOTEWIDTHS=(16 20 24 32 40 52 64 80 100)
CP_NOTEHEIGHTS=(3 4 5 6 8 10 12 16)

fn cp_set_notepos(int? id = "", value = "") { DT_NOTEPOS=$value; cp_save; }
fn cp_set_notewhere(int? id = "", value = "") { DT_NOTEWHERE=$value; cp_save; }
fn cp_set_notems(int? id = "", int? value = "") { DT_NOTEMS=$value; cp_save; }
fn cp_set_notecount(int? id = "", value = "") { DT_NOTECOUNT=$value; cp_save; }
fn cp_set_notelist(int? id = "", value = "") { DT_NOTELIST=$value; cp_save; }

# What one sender's notes do, as the five choices a row offers: as their
# priority says (the three rules above), everything, kept quiet -- listed
# and counted, never popped up -- popped up only, or nothing at all. The
# panel under the bell sets the three one at a time; a pattern of them no
# choice names reads as "custom" here and is left alone until one is picked.
CP_NOTEAPPS=(auto all quiet popup off)
declare -ga CP_NOTEFROM
fn cp_noteapp(from) {
	case ${DT_NOTEAPP["$from"]:-- - -} in
	"- - -") ret auto ;;
	"1 1 1") ret all ;;
	"0 1 1") ret quiet ;;
	"1 0 0") ret popup ;;
	"0 0 0") ret off ;;
	*) ret custom ;;
	esac
}
fn cp_set_noteapp(from, v) {
	case $v in
	auto) unset DT_NOTEAPP["$from"] ;;
	all) DT_NOTEAPP["$from"]="1 1 1" ;;
	quiet) DT_NOTEAPP["$from"]="0 1 1" ;;
	popup) DT_NOTEAPP["$from"]="1 0 0" ;;
	off) DT_NOTEAPP["$from"]="0 0 0" ;;
	esac
	cp_save
}
# A dropdown's callback is handed the id and the value, so the sender it
# was opened for waits here.
CP_NOTEPICK=
fn cp_set_noteapp1(int? id = "", value = "") {
	[ -n "$CP_NOTEPICK" ] && cp_set_noteapp "$CP_NOTEPICK" "$value"
}
# The senders a row is shown for: every one with a choice of its own, and
# every one in the history, the desktop's own first.
cp_notefrom() {
	local hid f
	local -A seen

	CP_NOTEFROM=()
	for f in Desktop "${!DT_NOTEAPP[@]}"; do
		[ -n "${seen["$f"]-}" ] && continue
		seen["$f"]=1
		CP_NOTEFROM+=("$f")
	done
	for hid in "${DT_NOTEHIST_ORDER[@]}"; do
		f=${DT_NOTEHIST[$hid]["from"]:-Desktop}
		[ -n "${seen["$f"]-}" ] && continue
		seen["$f"]=1
		CP_NOTEFROM+=("$f")
	done
}

# A size, with the smallest and the largest of a pair kept in order: moving
# one past the other moves the other with it, so the two can never describe
# a box that cannot be drawn.
fn cp_set_notesize(which, int v) {
	case $which in
	notewmin) DT_NOTEWMIN=$v; [ "$DT_NOTEWMAX" -lt "$v" ] && DT_NOTEWMAX=$v ;;
	notewmax) DT_NOTEWMAX=$v; [ "$DT_NOTEWMIN" -gt "$v" ] && DT_NOTEWMIN=$v ;;
	notehmin) DT_NOTEHMIN=$v; [ "$DT_NOTEHMAX" -lt "$v" ] && DT_NOTEHMAX=$v ;;
	notehmax) DT_NOTEHMAX=$v; [ "$DT_NOTEHMIN" -gt "$v" ] && DT_NOTEHMIN=$v ;;
	esac
	cp_save
}
fn cp_set_notewmin(int? id = "", int? value = "") { cp_set_notesize notewmin "$value"; }
fn cp_set_notewmax(int? id = "", int? value = "") { cp_set_notesize notewmax "$value"; }
fn cp_set_notehmin(int? id = "", int? value = "") { cp_set_notesize notehmin "$value"; }
fn cp_set_notehmax(int? id = "", int? value = "") { cp_set_notesize notehmax "$value"; }

# Empties the in-memory-only history log -- what is currently stacked and
# showing is untouched, since that lives in DT_NOTEQ, a separate array.
cp_clearhist() {
	local hid

	dt_notep low "History cleared"
	for hid in "${DT_NOTEHIST_ORDER[@]}"; do
		unset "DT_NOTEHIST[$hid]"
	done
	DT_NOTEHIST_ORDER=()
	DT_NOTEUNSEEN=0
}

fn notify_rows(int w) {
	local n=0 i

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Position"
	CP[$w][$n]["val"]="$DT_NOTEPOS"; CP[$w][$n]["key"]=notepos
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Show On"
	CP[$w][$n]["val"]="$DT_NOTEWHERE"; CP[$w][$n]["key"]=notewhere
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Timeout"
	CP[$w][$n]["val"]="$DT_NOTEMS ms"; CP[$w][$n]["key"]=notems
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Count From"
	CP[$w][$n]["val"]="$DT_NOTECOUNT"; CP[$w][$n]["key"]=notecount
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="List From"
	CP[$w][$n]["val"]="$DT_NOTELIST"; CP[$w][$n]["key"]=notelist
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Smallest Width"
	CP[$w][$n]["val"] := dt_tr "%s columns" "$DT_NOTEWMIN"
	CP[$w][$n]["key"]=notewmin
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Largest Width"
	CP[$w][$n]["val"] := dt_tr "%s columns" "$DT_NOTEWMAX"
	CP[$w][$n]["key"]=notewmax
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Smallest Height"
	CP[$w][$n]["val"] := dt_tr "%s rows" "$DT_NOTEHMIN"
	CP[$w][$n]["key"]=notehmin
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Largest Height"
	CP[$w][$n]["val"] := dt_tr "%s rows" "$DT_NOTEHMAX"
	CP[$w][$n]["key"]=notehmax
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="View History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=history
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Clear History"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=clearhist
	n=$((n + 1))
	cp_notefrom
	for i in "${!CP_NOTEFROM[@]}"; do
		CP[$w][$n]["kind"]=set
		CP[$w][$n]["text"] := dt_tr "From %s" "${CP_NOTEFROM[$i]}"
		CP[$w][$n]["val"] := cp_noteapp "${CP_NOTEFROM[$i]}"
		CP[$w][$n]["key"]=app$i
		n=$((n + 1))
	done
	ret "$n"
}

fn notify_do(int? w = "", k = "", int? dir = "") {
	local v f

	case $k in
	notepos) v := cp_next "$DT_NOTEPOS" "$dir" "${CP_NOTEPOS[@]}"
	         DT_NOTEPOS=$v ;;
	notewhere) v := cp_next "$DT_NOTEWHERE" "$dir" "${CP_NOTEWHERE[@]}"
	         DT_NOTEWHERE=$v ;;
	notems) v := cp_next "$DT_NOTEMS" "$dir" "${CP_NOTETICKS[@]}"
	        DT_NOTEMS=$v ;;
	notecount) v := cp_next "$DT_NOTECOUNT" "$dir" "${DT_NOTELEVELS[@]}"
	        DT_NOTECOUNT=$v ;;
	notelist) v := cp_next "$DT_NOTELIST" "$dir" "${DT_NOTELEVELS[@]}"
	        DT_NOTELIST=$v ;;
	app[0-9]*)
		f=${CP_NOTEFROM[${k#app}]-}
		[ -n "$f" ] || return 0
		v := cp_noteapp "$f"
		v := cp_next "$v" "$dir" "${CP_NOTEAPPS[@]}"
		cp_set_noteapp "$f" "$v"
		;;
	notewmin) v := cp_next "$DT_NOTEWMIN" "$dir" "${CP_NOTEWIDTHS[@]}"
	        cp_set_notesize notewmin "$v" ;;
	notewmax) v := cp_next "$DT_NOTEWMAX" "$dir" "${CP_NOTEWIDTHS[@]}"
	        cp_set_notesize notewmax "$v" ;;
	notehmin) v := cp_next "$DT_NOTEHMIN" "$dir" "${CP_NOTEHEIGHTS[@]}"
	        cp_set_notesize notehmin "$v" ;;
	notehmax) v := cp_next "$DT_NOTEHMAX" "$dir" "${CP_NOTEHEIGHTS[@]}"
	        cp_set_notesize notehmax "$v" ;;
	history) dt_has notifications_draw && dt_launch notifications ;;
	clearhist) cp_clearhist ;;
	esac
	cp_save
}

fn notify_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	notepos) dt_droplist "$w" "$r" "$c" cp_set_notepos "${CP_NOTEPOS[@]}" ;;
	notewhere) dt_droplist "$w" "$r" "$c" cp_set_notewhere "${CP_NOTEWHERE[@]}" ;;
	notems) dt_droplist "$w" "$r" "$c" cp_set_notems "${CP_NOTETICKS[@]}" ;;
	notecount) dt_droplist "$w" "$r" "$c" cp_set_notecount \
		"${DT_NOTELEVELS[@]}" ;;
	notelist) dt_droplist "$w" "$r" "$c" cp_set_notelist \
		"${DT_NOTELEVELS[@]}" ;;
	app[0-9]*)
		[ -n "${CP_NOTEFROM[${k#app}]-}" ] || return 0
		dt_droplist "$w" "$r" "$c" cp_set_noteapp1 "${CP_NOTEAPPS[@]}"
		CP_NOTEPICK=${CP_NOTEFROM[${k#app}]}
		;;
	notewmin) dt_droplist "$w" "$r" "$c" cp_set_notewmin "${CP_NOTEWIDTHS[@]}" ;;
	notewmax) dt_droplist "$w" "$r" "$c" cp_set_notewmax "${CP_NOTEWIDTHS[@]}" ;;
	notehmin) dt_droplist "$w" "$r" "$c" cp_set_notehmin "${CP_NOTEHEIGHTS[@]}" ;;
	notehmax) dt_droplist "$w" "$r" "$c" cp_set_notehmax "${CP_NOTEHEIGHTS[@]}" ;;
	esac
}
