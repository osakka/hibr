#!/usr/bin/env hibr
#
# desktop -- the Control Panel pane for the bare desktop: which icons sit
# on it, how many workspaces it has, whether Cycle goes through this one's
# windows or every one's, how often a busy screen is redrawn, and how
# screenshots are taken and where they go.

strict


app desktop "The Control Panel pane for the bare desktop" 1.5
command -v cp_pane > /dev/null && cp_pane desktop "Desktop" "▣"

DK_CYCLES=(workspace all)

fn cp_set_cycle(int? id = "", value = "") { DT_CYCLE=$value; cp_save; }

# The window switcher's pause (Gitea #391), as DT_SWMS keeps it and as the
# row shows it.
DK_SWV=(400 700 1000 1500)
DK_SWL=("400 ms" "700 ms" "1 second" "1.5 seconds")

# Switcher Pause as the row shows it.
fn dk_swlabel() {
	local i=0

	while [ "$i" -lt "${#DK_SWV[@]}" ]; do
		[ "${DK_SWV[$i]}" = "${DT_SWMS:-700}" ] && ret "${DK_SWL[$i]}" && return 0
		i=$((i + 1))
	done
	ret "${DT_SWMS:-700} ms"
}

fn cp_set_swms(int? id = "", value = "") {
	local i=0

	while [ "$i" -lt "${#DK_SWL[@]}" ]; do
		[ "${DK_SWL[$i]}" = "$value" ] && DT_SWMS=${DK_SWV[$i]}
		i=$((i + 1))
	done
	cp_save
}

# Not in the Switcher as the row shows it: the apps' own names, or none.
fn dk_skiplabel() {
	local a out=
	local -a l

	read -ra l <<< "$DT_SWSKIP"
	for a in "${l[@]}"; do
		out="${out:+$out, }${DT_APPS[$a]["title"]:-$a}"
	done
	ret "${out:-none}"
}

# Every app, a bullet beside the ones the switcher passes over; choosing
# one puts it on the list or takes it off.
fn dk_skipdrop(int w, int r, int c) {
	local a m
	local -a v

	DK_SKIPOF=()
	for a in "${!DT_APPS[@]}"; do
		[ -n "${DT_APPS[$a]["title"]}" ] || continue
		m=" "
		case " $DT_SWSKIP " in *" $a "*) m=${GL[bullet]} ;; esac
		v+=("$m ${DT_APPS[$a]["title"]}")
		DK_SKIPOF+=("$a")
	done
	dt_droplist "$w" "$r" "$c" cp_set_skip "${v[@]}"
}
declare -ga DK_SKIPOF

fn cp_set_skip(int? id = "", value = "") {
	local a t=${value:2} out= x
	local -a l

	for a in "${DK_SKIPOF[@]}"; do
		[ "${DT_APPS[$a]["title"]}" = "$t" ] || continue
		read -ra l <<< "$DT_SWSKIP"
		case " $DT_SWSKIP " in
		*" $a "*) for x in "${l[@]}"; do [ "$x" = "$a" ] || out="$out $x"; done ;;
		*) out="$DT_SWSKIP $a" ;;
		esac
		DT_SWSKIP=${out# }
		break
	done
	cp_save
}

fn desktop_rows(int w) {
	local n=0 d=$DT_SHOTDIR sk

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icons"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_ICONS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_ICONS; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Disk Icons"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_DISKS" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_DISKS; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icon Background"
	CP[$w][$n]["val"] := cp_iconbglabel
	CP[$w][$n]["key"]=iconbg; n=$((n + 1))
	# The rubber band a drag across empty space draws (Gitea #383).
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Rubber Band"
	CP[$w][$n]["val"] := cp_bandlabel
	CP[$w][$n]["key"]=band; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Band Intensity"
	CP[$w][$n]["after"]="(${DT_BANDPCT:-30}%)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=${DT_BANDPCT:-30}; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=100
	CP[$w][$n]["key"]=bandpct; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Workspaces ($DT_WSN)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$DT_WSN; CP[$w][$n]["min"]=1; CP[$w][$n]["max"]=9
	CP[$w][$n]["key"]=wsn; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Cycle Windows On"
	CP[$w][$n]["val"]="$DT_CYCLE"; CP[$w][$n]["key"]=cycle
	n=$((n + 1))
	# Cycle opens the window list and steps through it (Gitea #391).
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Window Switcher"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_SWITCHER:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SWITCHER; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Switcher Pause"
	CP[$w][$n]["val"] := dk_swlabel
	CP[$w][$n]["key"]=swms; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Not in the Switcher"
	CP[$w][$n]["val"] := dk_skiplabel
	CP[$w][$n]["key"]=swskip; n=$((n + 1))
	# The number with what it counts, the same as Frames For Output's own
	# `(70ms)` on the next row. `Redraw Skip (1)` cannot be read: 1 could
	# be a count of frames skipped or a mode, and that is not a small
	# thing here -- the ambiguity is what let its own off-by-one live (the
	# loop compared against `DT_DRAWSKIP - 1`, so the shipped default of 1
	# skipped none and the label was wrong rather than the mechanism), and
	# it is what later made a saved 1 impossible to tell from a chosen one
	# without reading the history of the default (Gitea #212).
	case ${DT_DRAWSKIP:-0} in
	0) sk=none ;;
	1) sk="1 frame" ;;
	*) sk="$DT_DRAWSKIP frames" ;;
	esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Redraw Skip ($sk)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$DT_DRAWSKIP; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=9
	CP[$w][$n]["key"]=drawskip; n=$((n + 1))
	CP[$w][$n]["kind"]=set
	CP[$w][$n]["text"]="Frames For Output (${DT_TERMMS}ms)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$DT_TERMMS; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=200
	CP[$w][$n]["key"]=termms; n=$((n + 1))
	CP[$w][$n]["kind"]=set
	if [ "${DT_LIVEMS:-0}" -gt 0 ]; then
		CP[$w][$n]["text"]="Frames For Video (${DT_LIVEMS}ms)"
	else
		CP[$w][$n]["text"]="Frames For Video (as output)"
	fi
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=${DT_LIVEMS:-0}; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=100
	CP[$w][$n]["key"]=livems; n=$((n + 1))
	[ "${d#"$HOME"/}" != "$d" ] && d="~/${d#"$HOME"/}"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Screenshot Format"
	CP[$w][$n]["val"]="$DT_SHOTFMT"; CP[$w][$n]["key"]=shotfmt
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Screenshot Starts On"
	CP[$w][$n]["val"]="$DT_SHOTLAST"; CP[$w][$n]["key"]=shotlast
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Screenshots In: $d"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=shotdir
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Open Screenshots"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=shotopen
	n=$((n + 1))
	ret "$n"
}

fn desktop_do(int w, k, int dir) {
	local v

	case $k in
	DT_ICONS | DT_DISKS | DT_SWITCHER)
		cp_toggle "$k"
		command -v dt_deskscan > /dev/null && dt_deskscan
		;;
	wsn) dt_wsset $((DT_WSN + dir)) ;;
	iconbg)
		v := cp_iconbglabel
		v := cp_next "$v" "$dir" "${CP_ICONBGL[@]}"
		cp_set_iconbg "" "$v"
		return 0
		;;
	cycle) v := cp_next "$DT_CYCLE" "$dir" "${DK_CYCLES[@]}"
		DT_CYCLE=$v ;;
	swms)
		v := dk_swlabel
		v := cp_next "$v" "$dir" "${DK_SWL[@]}"
		cp_set_swms "" "$v"
		return 0
		;;
	swskip) return 0 ;;
	band)
		v := cp_bandlabel
		v := cp_next "$v" "$dir" "${CP_BANDL[@]}"
		cp_set_band "" "$v"
		return 0
		;;
	bandpct) cp_bandpct $((${DT_BANDPCT:-30} + dir * 10)) ;;
	shotfmt) v := cp_next "$DT_SHOTFMT" "$dir" "${SH_FMTS[@]}"
		DT_SHOTFMT=$v ;;
	shotlast) v := cp_next "$DT_SHOTLAST" "$dir" "${SH_STARTS[@]}"
		DT_SHOTLAST=$v ;;
	shotdir) dt_has shd_dialog && shd_dialog ;;
	shotopen)
		[ -d "$DT_SHOTDIR" ] || mkdir -p "$DT_SHOTDIR" 2> /dev/null
		dt_has files_draw && dt_launch files "$DT_SHOTDIR"
		;;
	drawskip)
		v=$((DT_DRAWSKIP + dir))
		[ "$v" -lt 0 ] && v=0
		[ "$v" -gt 9 ] && v=9
		DT_DRAWSKIP=$v
		;;
	termms)
		v=$((DT_TERMMS + dir * 10))
		[ "$v" -lt 0 ] && v=0
		[ "$v" -gt 200 ] && v=200
		DT_TERMMS=$v
		;;
	livems)
		v=$((${DT_LIVEMS:-0} + dir * 5))
		[ "$v" -lt 0 ] && v=0
		[ "$v" -gt 100 ] && v=100
		DT_LIVEMS=$v
		;;
	esac
	cp_save
}

# Rubber Band's choices, as the row shows them and as DT_BAND keeps them.
CP_BANDV=(frame dashed solid translucent)
CP_BANDL=("Single Frame" "Dashed" "Solid" "Translucent")

fn cp_bandlabel() {
	local i=0

	while [ "$i" -lt "${#CP_BANDV[@]}" ]; do
		[ "${CP_BANDV[$i]}" = "${DT_BAND:-frame}" ] && ret "${CP_BANDL[$i]}" && return 0
		i=$((i + 1))
	done
	ret "${CP_BANDL[0]}"
}

fn cp_set_band(int? id = "", value = "") {
	local i=0

	while [ "$i" -lt "${#CP_BANDL[@]}" ]; do
		[ "${CP_BANDL[$i]}" = "$value" ] && DT_BAND=${CP_BANDV[$i]}
		i=$((i + 1))
	done
	cp_save
}

fn cp_bandpct(int v) {
	[ "$v" -lt 0 ] && v=0
	[ "$v" -gt 100 ] && v=100
	DT_BANDPCT=$v
	cp_save
	return 0
}

# A slider set where its track is clicked.
fn desktop_slide(int w, k, int value) {
	case $k in
	bandpct) cp_bandpct "$value" ;;
	termms) DT_TERMMS=$value; cp_save ;;
	livems) DT_LIVEMS=$value; cp_save ;;
	esac
	return 0
}

# Icon Background's choices, as the row shows them and as DT_ICONBG keeps
# them (Gitea #349).
CP_ICONBGV=(transparent solid)
CP_ICONBGL=("Transparent" "Solid")

fn cp_iconbglabel() {
	[ "$DT_ICONBG" = solid ] && ret "Solid" && return 0
	ret "Transparent"
}

fn cp_set_iconbg(int? id = "", value = "") {
	local i=0

	while [ "$i" -lt "${#CP_ICONBGL[@]}" ]; do
		[ "${CP_ICONBGL[$i]}" = "$value" ] && DT_ICONBG=${CP_ICONBGV[$i]}
		i=$((i + 1))
	done
	DT_FORCEONCE=1
	cp_save
}

fn desktop_drop(int w, int r, int c, k) {
	case $k in
	cycle) dt_droplist "$w" "$r" "$c" cp_set_cycle "${DK_CYCLES[@]}" ;;
	swms) dt_droplist "$w" "$r" "$c" cp_set_swms "${DK_SWL[@]}" ;;
	swskip) dk_skipdrop "$w" "$r" "$c" ;;
	iconbg) dt_droplist "$w" "$r" "$c" cp_set_iconbg "${CP_ICONBGL[@]}" ;;
	band) dt_droplist "$w" "$r" "$c" cp_set_band "${CP_BANDL[@]}" ;;
	shotfmt) dt_has cp_set_shotfmt &&
		dt_droplist "$w" "$r" "$c" cp_set_shotfmt "${SH_FMTS[@]}" ;;
	shotlast) dt_has cp_set_shotlast &&
		dt_droplist "$w" "$r" "$c" cp_set_shotlast "${SH_STARTS[@]}" ;;
	esac
}
