# control-panel/trayset -- Control Panel > Tray Icons: the tray's levers
# (Gitea #505), a part of menubar/tray, so it comes and goes with it.
# Whether the desktop is the tray at all, how an icon is drawn, what a left
# click does, how many icons before the rest go under an arrow, and, for
# every program that has put up an icon, whether it is shown, hidden, or
# shown even while it says it is idle -- in the order the bar shows them,
# moved by a drag or by Shift and an arrow.
#
# Its name is not the bar item's: a pane named after an app's prefix would
# find that app's own callbacks.

strict

app trayset "The Control Panel pane for programs' tray icons" 1.1
command -v cp_pane > /dev/null && cp_pane trayset "Tray Icons" "▤"

CP_TRAYSIZES=(picture letter)
# How large a program's picture is drawn, as a part of the bar's height: its
# own shape kept and centred in its two cells, never cut or stretched.
CP_TRAYICONS=(50 60 70 80 90 100)
CP_TRAYCLICKS=(activate menu)
CP_TRAYMAXES=(0 3 5 8 12)
CP_TRAYSHOWS=(shown hidden always)

# The programs the pane lists: the bar's own order first, then every other
# program seen this session or named in a setting.
fn trayset_progs() {
	local id
	local -a out=() ids
	local -A had=()

	IFS=$'\t' read -ra ids <<< "${DT_TRAYORDER-}"
	for id in "${ids[@]}"; do
		[ -n "$id" ] && [ -z "${had["$id"]+x}" ] && { out+=("$id"); had["$id"]=1; }
	done
	for id in "${!TRAY_SEEN[@]}"; do
		[ -z "${had["$id"]+x}" ] && { out+=("$id"); had["$id"]=1; }
	done
	IFS=$'\t' read -ra ids <<< "${DT_TRAYHIDE-}${DT_TRAYHIDE:+$'\t'}${DT_TRAYALWAYS-}"
	for id in "${ids[@]}"; do
		[ -n "$id" ] && [ -z "${had["$id"]+x}" ] && { out+=("$id"); had["$id"]=1; }
	done
	TRAYSET_IDS=("${out[@]}")
}
TRAYSET_IDS=()

# Whether a program is shown, hidden or always shown.
fn trayset_show(id) {
	if dt_trayin "${DT_TRAYHIDE-}" "$id"; then
		ret hidden
	elif dt_trayin "${DT_TRAYALWAYS-}" "$id"; then
		ret always
	else
		ret shown
	fi
}

# A tab-separated list without a word, or with it added.
fn trayset_list(list, word, int add) {
	local x out=
	local -a w

	IFS=$'\t' read -ra w <<< "$list"
	for x in "${w[@]}"; do
		[ -n "$x" ] && [ "$x" != "$word" ] && out+="${out:+$'\t'}$x"
	done
	[ "$add" = 1 ] && out+="${out:+$'\t'}$word"
	ret "$out"
}

fn trayset_rows(int w) {
	local n=0 id v

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tray Icons on the Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_TRAY:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=on
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icons"; CP[$w][$n]["key"]=size
	cp_choice "$w" "$n" "${DT_TRAYSIZE:-picture}" trayset_setsize "${CP_TRAYSIZES[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icon Size"; CP[$w][$n]["key"]=icon
	cp_choice "$w" "$n" "${DT_TRAYICON:-70}" trayset_seticon "${CP_TRAYICONS[@]}"
	CP[$w][$n]["vname"]=trayset_iconname
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Left Click"; CP[$w][$n]["key"]=click
	cp_choice "$w" "$n" "${DT_TRAYCLICK:-activate}" trayset_setclick "${CP_TRAYCLICKS[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Icons Before the Arrow"; CP[$w][$n]["key"]=max
	cp_choice "$w" "$n" "${DT_TRAYMAX:-0}" trayset_setmax "${CP_TRAYMAXES[@]}"
	CP[$w][$n]["vname"]=trayset_maxname
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Programs"
	n=$((n + 1))
	trayset_progs
	if [ "${#TRAYSET_IDS[@]}" = 0 ]; then
		CP[$w][$n]["kind"]=info
		CP[$w][$n]["text"]="A program is listed here once it has put up an icon"
		n=$((n + 1))
		ret "$n"
		return 0
	fi
	for id in "${TRAYSET_IDS[@]}"; do
		CP[$w][$n]["kind"]=set
		CP[$w][$n]["text"]=${TRAY_SEEN["$id"]:-$id}
		v := trayset_show "$id"
		cp_choice "$w" "$n" "$v" trayset_setprog "${CP_TRAYSHOWS[@]}"
		CP[$w][$n]["sarg"]=$id
		CP[$w][$n]["key"]="prog:$id"
		CP[$w][$n]["ord"]=tray; CP[$w][$n]["oname"]=$id
		n=$((n + 1))
	done
	CP[$w][$n]["kind"]=info
	CP[$w][$n]["text"]="Drag, or Shift and an arrow"
	n=$((n + 1))
	ret "$n"
}

# The programs in a new order, as the bar shows them from now on.
fn trayset_order(int w, g, ...names) {
	local id out=

	for id in "${names[@]}"; do
		out+="${out:+$'\t'}$id"
	done
	DT_TRAYORDER=$out
	cp_save
	dt_has dt_traybar && dt_traybar
}

# The bar shows what was just chosen at once, and it is kept.
trayset_apply() {
	cp_save
	dt_has dt_traybar && dt_traybar
	return 0
}

# What each row's choice sets: the panel calls these from the row's list,
# for a click and for the arrows alike. Named set-, since trayset_click
# would be the pane's own click callback.
fn trayset_setsize(int w, v) { DT_TRAYSIZE=$v; trayset_apply; }
fn trayset_setclick(int w, v) { DT_TRAYCLICK=$v; trayset_apply; }
fn trayset_setmax(int w, v) { DT_TRAYMAX=$v; trayset_apply; }
fn trayset_seticon(int w, v) { DT_TRAYICON=$v; trayset_apply; }

# A picture's size as the part of the bar's height it takes.
fn trayset_iconname(v) { ret "$v%"; }

# How many icons before the arrow, in words: none held back is "all".
fn trayset_maxname(v) {
	[ "$v" = 0 ] && { ret all; return 0; }
	ret "$v"
}

# One program shown, hidden, or shown even while it says it is idle.
fn trayset_setprog(int w, v, id) {
	local hid=0 alw=0

	[ "$v" = hidden ] && hid=1
	[ "$v" = always ] && alw=1
	DT_TRAYHIDE := trayset_list "${DT_TRAYHIDE-}" "$id" "$hid"
	DT_TRAYALWAYS := trayset_list "${DT_TRAYALWAYS-}" "$id" "$alw"
	trayset_apply
}

fn trayset_do(int? w = "", k = "", int? dir = "") {
	local v

	case $k in
	on)
		v=1
		[ "${DT_TRAY:-1}" = 1 ] && v=0
		dt_has dt_trayset && dt_trayset "$v"
		;;
	esac
	return 0
}
