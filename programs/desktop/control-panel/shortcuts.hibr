#!/usr/bin/env hibr
#
# shortcuts -- the Control Panel pane for every shortcut in one list: the
# desktop's own actions, then a launch shortcut for any app. Activating a
# row captures its next key; the ✕ beside a key, or delete or backspace on
# its row, clears it. wm/keys.hibr does all of it -- including asking
# before taking a key another action has. Every key the desktop acts on is
# here, the menu bar's, Copy's, Cut's and Paste's included.
# A key two actions share, which only a settings file edited by hand can
# arrange, is marked ⚠ on both. Above them all, Shortcut Key: which
# modifiers the desktop's own chords use (DT_MOD, Gitea #326) -- Alt,
# Super or Alt, or Super -- every row then showing what to press.

strict


app shortcuts "The Control Panel pane for every shortcut in one list" 1.3
command -v cp_pane > /dev/null && cp_pane shortcuts "Shortcuts" "⌘"

# Shortcut Key's three choices, as the pane shows them and as DT_MOD
# keeps them. Ctrl+Alt is not one: the desktop already has chords on
# ctrl-alt, and those would land on the same keys as the mod ones.
SC_MODLABELS=("Alt" "Super or Alt" "Super")
SC_MODVALS=("alt" "super alt" "super")

# What DT_MOD is called in the pane.
fn shortcuts_modlabel() {
	local i=0

	while [ "$i" -lt "${#SC_MODVALS[@]}" ]; do
		[ "${SC_MODVALS[$i]}" = "${DT_MOD:-alt}" ] && ret "${SC_MODLABELS[$i]}" && return 0
		i=$((i + 1))
	done
	ret "Alt"
}

fn cp_set_dtmod(int? id = "", value = "") {
	local i=0

	while [ "$i" -lt "${#SC_MODLABELS[@]}" ]; do
		[ "${SC_MODLABELS[$i]}" = "$value" ] && DT_MOD=${SC_MODVALS[$i]}
		i=$((i + 1))
	done
	DT_MENUIN=
	cp_save
}

fn shortcuts_do(int w, k, int dir) {
	local v

	[ "$k" = DT_MOD ] || return 0
	v := shortcuts_modlabel
	v := cp_next "$v" "$dir" "${SC_MODLABELS[@]}"
	cp_set_dtmod "" "$v"
}

fn shortcuts_drop(int w, int r, int c, k) {
	[ "$k" = DT_MOD ] || return 0
	dt_droplist "$w" "$r" "$c" cp_set_dtmod "${SC_MODLABELS[@]}"
}

# Every key in use, normalised once, and who holds it: " owner owner ".
# Asking dt_keyshared row by row compared each key with every other, 46 by
# 46, normalising both each time -- 35 of the pane's 39 ms on every frame
# it was open, which under load was a stall (ADR 0049).
declare -gA SC_OWN

# Fill SC_OWN from every desktop action, app key and app action.
shortcuts_owners() {
	local a k

	SC_OWN=()
	for a in "${DT_KEYORDER[@]}"; do
		[ -n "${DT_KEYS["$a"]}" ] || continue
		k := dt_keynorm "${DT_KEYS["$a"]}"
		SC_OWN["$k"]+=" $a"
	done
	for a in "${!DT_APPKEY[@]}"; do
		[ -n "${DT_APPKEY["$a"]}" ] || continue
		k := dt_keynorm "${DT_APPKEY["$a"]}"
		SC_OWN["$k"]+=" app:$a"
	done
	for a in "${DT_AKEYORDER[@]}"; do
		[ -n "${DT_AKEY["$a"]}" ] || continue
		k := dt_keynorm "${DT_AKEY["$a"]}"
		SC_OWN["$k"]+=" act:$a"
	done
	return 0
}

# Whether what shares its key with another action, by dt_keyowner's own
# rule: two apps' own actions may share a key, since only the focused
# app's acts, and one app's two may not.
fn shortcuts_shared(what) {
	local k o e
	local -a os

	k := dt_keyof "$what"
	[ -n "$k" ] || return 1
	k := dt_keynorm "$k"
	read -ra os <<< "${SC_OWN["$k"]}"
	for o in "${os[@]}"; do
		[ "$o" = "$what" ] && continue
		case $what:$o in
		act:*:act:*)
			e=${what#act:}
			o=${o#act:}
			[ "${e%%:*}" = "${o%%:*}" ] && return 0
			;;
		*) return 0 ;;
		esac
	done
	return 1
}

# One row for an action: its label, marked if its key is shared.
fn shortcuts_row(int w, int n, what) {
	local l

	l := dt_keylabel "$what"
	shortcuts_shared "$what" && l="$l ${GL[warn]}"
	CP[$w][$n]["kind"]=key
	CP[$w][$n]["text"]=$l
	CP[$w][$n]["val"] := dt_keyof "$what"
	CP[$w][$n]["val"] := dt_keyshow "${CP[$w][$n]["val"]}"
	CP[$w][$n]["key"]=$what
}

fn shortcuts_rows(int w) {
	local n=0 a names nl last

	shortcuts_owners
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shortcut Key"
	CP[$w][$n]["val"] := shortcuts_modlabel
	CP[$w][$n]["key"]=DT_MOD; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Desktop"; n=$((n + 1))
	for a in "${DT_KEYORDER[@]}"; do
		shortcuts_row "$w" "$n" "$a"
		n=$((n + 1))
	done
	names := dt_appnames
	if [ -n "$names" ]; then
		CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Apps"; n=$((n + 1))
		read -ra nl <<< "$names"
		for a in "${nl[@]}"; do
			shortcuts_row "$w" "$n" "app:$a"
			n=$((n + 1))
		done
	fi
	# Each app's own actions, under the app's name: they act only while
	# its window has the focus.
	last=
	# A desktop older than 0.99.371 has no app actions to list.
	command -v dt_appaction > /dev/null || ret "$n"
	for a in "${DT_AKEYORDER[@]}"; do
		if [ "${a%%:*}" != "$last" ]; then
			last=${a%%:*}
			CP[$w][$n]["kind"]=head
			CP[$w][$n]["text"]="${DT_APPS["$last"]["title"]:-$last}"
			n=$((n + 1))
		fi
		shortcuts_row "$w" "$n" "act:$a"
		n=$((n + 1))
	done
	ret "$n"
}
