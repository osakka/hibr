#!/usr/bin/env hibr
#
# shortcuts -- the Control Panel pane for every shortcut in one list: the
# desktop's own actions, then a launch shortcut for any app, then each
# app's own actions. A shortcut is the chords it is written as (ADR 0057):
# activating a row captures its next key as its only one; its + captures
# one more beside those it has; the ✕ beside a key, or delete or backspace
# on its row, clears them. wm/keys.hibr does all of it -- including asking
# before taking a key another action has, and refusing one Blit keeps for
# itself, which are listed last. Every key the desktop acts on is here, the
# menu bar's, Copy's, Cut's and Paste's included. A key two actions share,
# which only a settings file edited by hand can arrange, is marked ⚠ on
# both. Use Super Instead of Alt, and back, rewrite the list once.

strict


app shortcuts "The Control Panel pane for every shortcut in one list" 1.3.3
command -v cp_pane > /dev/null && cp_pane shortcuts "Shortcuts" "⌘"

fn shortcuts_do(int w, k, int dir) {
	# How keys reach a terminal window, folded in from the Keyboard pane
	# there was (Gitea #531): the desktop's shortcuts there or not, and
	# ctrl with a letter always the program's.
	case $k in
	DT_TERMKEEP | DT_TERMCTRL)
		cp_toggle "$k"
		cp_save
		;;
	sc:super) dt_keyswap alt super ;;
	sc:alt) dt_keyswap super alt ;;
	esac
	DT_MENUIN=
	return 0
}

# Every chord in use, normalised once, and who holds it: each owner after a
# tab, since a program's name may have spaces in it (Gitea #533).
# Asking dt_keyshared row by row compared each key with every other, 46 by
# 46, normalising both each time -- 35 of the pane's 39 ms on every frame
# it was open, which under load was a stall (ADR 0049).
declare -gA SC_OWN

# Add each of a shortcut's chords to SC_OWN under who.
fn shortcuts_own(list, who) {
	local c k
	local -a cs

	read -ra cs <<< "$list"
	for c in "${cs[@]}"; do
		k := dt_keynorm "$c"
		SC_OWN["$k"]+="	$who"
	done
}

# Fill SC_OWN from every desktop action, app key and app action.
shortcuts_owners() {
	local a

	SC_OWN=()
	for a in "${DT_KEYORDER[@]}"; do
		shortcuts_own "${DT_KEYS["$a"]-}" "$a"
	done
	# A key saved for an app that is not here -- removed, or a row the
	# pane once made from part of a name -- has no row, and holds nothing.
	for a in "${!DT_APPKEY[@]}"; do
		[ -n "${DT_APPS["$a"]["title"]-}" ] || continue
		shortcuts_own "${DT_APPKEY["$a"]}" "app:$a"
	done
	for a in "${DT_AKEYORDER[@]}"; do
		shortcuts_own "${DT_AKEY["$a"]}" "act:$a"
	done
	return 0
}

# Whether any of what's chords is held by another action, by dt_keyowner's
# own rule: two apps' own actions may share a key, since only the focused
# app's acts, and one app's two may not.
fn shortcuts_shared(what) {
	local k c o e
	local -a cs os

	k := dt_keyof "$what"
	read -ra cs <<< "$k"
	for c in "${cs[@]}"; do
		k := dt_keynorm "$c"
		IFS=$'\t' read -ra os <<< "${SC_OWN["$k"]-}"
		for o in "${os[@]}"; do
			[ "$o" = "$what" ] && continue
			case $what:$o in
			act:*:act:*)
				e=${what#act:}
				o=${o#act:}
				[ "${e%%:*}" = "${o%%:*}" ] && return 0
				;;
			*) return 0 ;;
			esac
		done
	done
	return 1
}

# One row for an action: its label, marked if a key of its is shared, and
# its chords.
fn shortcuts_row(int w, int n, what) {
	local l

	l := dt_keylabel "$what"
	shortcuts_shared "$what" && l="$l ${GL[warn]}"
	CP[$w][$n]["kind"]=key
	CP[$w][$n]["text"]=$l
	CP[$w][$n]["val"] := dt_keyof "$what"
	CP[$w][$n]["key"]=$what
}

# The chords Blit keeps for itself, as it said them (KEYBOARD reserved):
# the console switch on one row, anything else -- the stop chord -- on its
# own. Shown so a person knows why such a key cannot be taken.
fn shortcuts_blit(int w, int n) {
	local c f=0 rest=
	local -a cs

	read -ra cs <<< "${DT_KBRES-}"
	[ "${#cs[@]}" -gt 0 ] || ret "$n"
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Blit Keeps These"; n=$((n + 1))
	for c in "${cs[@]}"; do
		case $c in
		ctrl-alt-f[0-9] | ctrl-alt-f1[0-2]) f=1 ;;
		*) rest="$rest $c" ;;
		esac
	done
	if [ "$f" = 1 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Switch Console"
		CP[$w][$n]["val"]="ctrl-alt-f1…f12"; n=$((n + 1))
	fi
	read -ra cs <<< "$rest"
	for c in "${cs[@]}"; do
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Kept by Blit"
		CP[$w][$n]["val"]=$c; n=$((n + 1))
	done
	ret "$n"
}

fn shortcuts_rows(int w) {
	local n=0 a names last

	shortcuts_owners
	# What a key is and types -- a role, a layout, the repeat -- is Blit's
	# Keyboard pane's; this one is what combinations do (Gitea #531).
	if [ -n "${BLIT_SERVER_PORT-}" ]; then
		CP[$w][$n]["kind"]=head
		CP[$w][$n]["text"]="What a key is and types: Blit Keyboard"
		n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Use Super Instead of Alt"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=sc:super; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Use Alt Instead of Super"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=sc:alt; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Terminals"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shortcuts in Terminals"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TERMKEEP" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TERMKEEP; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Terminals Keep Ctrl+A-Z"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_TERMCTRL" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_TERMCTRL; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Desktop"; n=$((n + 1))
	for a in "${DT_KEYORDER[@]}"; do
		shortcuts_row "$w" "$n" "$a"
		n=$((n + 1))
	done
	names := dt_appnames
	if [ -n "$names" ]; then
		CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Apps"; n=$((n + 1))
		for a in "${DT_APPNAMEV[@]}"; do
			shortcuts_row "$w" "$n" "app:$a"
			n=$((n + 1))
		done
	fi
	# Each app's own actions, under the app's name: they act only while
	# its window has the focus.
	last=
	for a in "${DT_AKEYORDER[@]}"; do
		if [ "${a%%:*}" != "$last" ]; then
			last=${a%%:*}
			CP[$w][$n]["kind"]=head
			CP[$w][$n]["text"]="${DT_APPS["$last"]["title"]:-$last}"
			n=$((n + 1))
		fi
		shortcuts_row "$w" "$n" "act:$a"
		n=$((n + 1))
	done
	n := shortcuts_blit "$w" "$n"
	ret "$n"
}
