#!/usr/bin/env hibr
#
# notes -- the Control Panel pane for Stickies: the colour a new note
# starts in, whether every note opens with the desktop, whether notes are
# on every workspace, and the way to a
# new note or to all of them. Named notes, not stickies, which is the desk
# accessory's own prefix.

strict


app notes "The Control Panel pane for Stickies" 1.1
command -v cp_pane > /dev/null && cp_pane notes "Stickies" "▤" app

fn cp_set_stickycolor(int? id = "", value = "") { dt_set DT_STICKYCOLOR "$value"; }

fn notes_rows(int w) {
	local n=0

	[ "${#ST_COLORS[@]}" -gt 0 ] || { cp_absent "$w" Stickies; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="New Notes Are"; CP[$w][$n]["key"]=stickycolor
	cp_choice "$w" "$n" "$DT_STICKYCOLOR" cp_set_stickycolor "${ST_COLORS[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Open Notes at Start"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_STICKYSTART" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_STICKYSTART; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Notes on Every Workspace"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_STICKYALL" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_STICKYALL; n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="New Note"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=stickynew
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Show All Notes"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=stickyall
	n=$((n + 1))
	ret "$n"
}

fn notes_do(int? w = "", k = "", int? dir = "") {
	case $k in

	DT_STICKYSTART) cp_toggle "$k" ;;
	DT_STICKYALL) dt_needs stickies st_allws &&
		st_allws $((1 - ${DT_STICKYALL:-0})) ;;
	stickynew) dt_needs stickies st_new && st_new ;;
	stickyall) dt_needs stickies stickies_launch && stickies_launch ;;
	esac
	return 0
}

