#!/usr/bin/env hibr
#
# power -- the Control Panel pane called Power (Gitea #365): each battery's
# charge, whether it is charging, the time left and its health; the power
# item on the menu bar, the note at a low charge and what happens at a
# critical one; and Sleep, Hibernate, Restart and Shut Down. It acts through
# menubar/power.hibr, and its rows for a battery are there only where there is
# one.
#
# needs: menubar/power

strict

app power "The Control Panel pane for the battery and the computer's power" 3.2.1
command -v cp_pane > /dev/null && cp_pane power "Power" "↯" hardware

PW_LOWS=(off 5 10 15 20 25)
PW_CRITS=(3 5 8 10)
PW_CRITDOS=(nothing suspend hibernate poweroff)
DT_PWBAR="${DT_PWBAR-1}"
DT_PWLOW="${DT_PWLOW-10}"
DT_PWCRIT="${DT_PWCRIT-5}"
DT_PWCRITDO="${DT_PWCRITDO-nothing}"

fn cp_set_pwlow(int? id = "", value = "") { dt_set DT_PWLOW "$value"; }
fn cp_set_pwcrit(int? id = "", value = "") { dt_set DT_PWCRIT "$value"; }
fn cp_set_pwcritdo(int? id = "", value = "") { dt_set DT_PWCRITDO "$value"; }
# A battery level in words.
fn cp_pwpct(v) {
	[ "$v" = off ] && { ret off; return 0; }
	ret "$v%"
}

fn power_rows(int w) {
	local n=0 v

	# Without the menu bar item, which reads the batteries, there is only
	# the computer itself to offer (Gitea #392).
	if ! dt_has dt_pwtick; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Menu Bar Item"
		CP[$w][$n]["val"]="not installed"; n=$((n + 1))
		n := cp_pwmachine "$w" "$n"
		ret "$n"
		return 0
	fi
	dt_pwread
	if [ "${DT_PW["n"]:-0}" -gt 0 ]; then
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Battery"
		v := dt_pwsays
		CP[$w][$n]["val"] := dt_tr "%s%% charged, %s" "${DT_PW["pct"]:-?}" "$v"
		n=$((n + 1))
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Power"
		if [ "${DT_PW["ac"]}" = 1 ]; then
			CP[$w][$n]["val"] := dt_tr "plugged in"
		else
			CP[$w][$n]["val"] := dt_tr "the battery"
		fi
		n=$((n + 1))
		if [ -n "${DT_PW["health"]}" ]; then
			CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Health"
			CP[$w][$n]["val"] := dt_tr "%s%% of what it held new" "${DT_PW["health"]}"
			n=$((n + 1))
		fi
		[ "${DT_PW["n"]}" -gt 1 ] && {
			CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Batteries"
			CP[$w][$n]["val"]=${DT_PW["n"]}; n=$((n + 1))
		}
	else
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Battery"
		CP[$w][$n]["val"] := dt_tr "none found"; n=$((n + 1))
	fi
	# On the bar with or without a battery (the owner, 2026-10-27): the
	# power symbol where there is none.
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Menu Bar"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Power on Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_PWBAR:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_PWBAR; n=$((n + 1))
	if [ "${DT_PW["n"]:-0}" -gt 0 ]; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Level on Menu Bar"
		CP[$w][$n]["wtype"]=bool
		CP[$w][$n]["val"]=off; [ "${DT_PWLEVEL:-1}" = 1 ] && CP[$w][$n]["val"]=on
		CP[$w][$n]["key"]=DT_PWLEVEL; n=$((n + 1))
		CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Battery"; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Low Battery Note"; CP[$w][$n]["key"]=low
		cp_choice "$w" "$n" "${DT_PWLOW:-10}" cp_set_pwlow "${PW_LOWS[@]}"
		CP[$w][$n]["vname"]=cp_pwpct; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Critical Battery"; CP[$w][$n]["key"]=crit
		cp_choice "$w" "$n" "${DT_PWCRIT:-5}" cp_set_pwcrit "${PW_CRITS[@]}"
		CP[$w][$n]["vname"]=cp_pwpct; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="On Critical Battery"; CP[$w][$n]["key"]=critdo
		cp_choice "$w" "$n" "${DT_PWCRITDO:-nothing}" cp_set_pwcritdo "${PW_CRITDOS[@]}"
		n=$((n + 1))
	fi
	n := cp_pwmachine "$w" "$n"
	ret "$n"
}

# The computer's own rows: Sleep, Hibernate where logind can, Restart and
# Shut Down -- the platform's (wm/machine.hibr), so there whatever else is.
fn cp_pwmachine(int w, int n) {
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Computer"; n=$((n + 1))
	if dt_pwlocal; then
		CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Sleep"
		CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=suspend; n=$((n + 1))
		if [ "${DT_PW["hib"]}" = 1 ]; then
			CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Hibernate"
			CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=hibernate; n=$((n + 1))
		fi
		CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Restart"
		CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=reboot; n=$((n + 1))
		CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Shut Down"
		CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=poweroff; n=$((n + 1))
	else
		CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Sleep, Restart, Shut Down"
		CP[$w][$n]["val"] := dt_tr "only on the computer's own screen"
		n=$((n + 1))
	fi
	ret "$n"
}

fn power_do(int w, k, int dir) {
	local v=1

	case $k in
	suspend | hibernate | reboot | poweroff)
		dt_pwdo "$k"
		return 0
		;;
	esac
	dt_has dt_pwtick || return 0
	case $k in
	DT_PWBAR | DT_PWLEVEL)
		[ "${!k}" = 1 ] && v=0
		dt_set "$k" "$v"
		dt_pwbar
		;;
	esac
}

