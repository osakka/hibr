#!/usr/bin/env hibr
#
# sound -- the Control Panel pane for the machine's sound (Gitea #306): the
# output and the input used, each one's level and mute, how far a key or
# a wheel notch moves the volume, and whether the speaker is on the menu
# bar. The keys themselves are rows in Shortcuts. Everything here acts
# through wm/sound.hibr, which says what kind of sound this machine has:
# a server PipeWire or PulseAudio answers for, or ALSA's mixer.

strict

app sound "The Control Panel pane for the machine's sound" 1.1
command -v cp_pane > /dev/null && cp_pane sound "Sound" "♪" hardware

SN_KINDS=(Auto PulseAudio PipeWire ALSA None)

fn cp_set_sndkind(int? id = "", value = "") {
	DT_SNDKIND=$value
	cp_save
	dt_sndagain
}
fn cp_set_sndout(int? id = "", value = "") {
	local nm

	nm := dt_sndname out "$value"
	dt_sndout "$nm"
}
fn cp_set_sndin(int? id = "", value = "") {
	local nm

	nm := dt_sndname in "$value"
	dt_sndin "$nm"
}

# Where the sound server's name is said: what it calls itself, or that
# there is none.
fn sound_rows(int w) {
	local n=0 d v

	[ -n "${DT_SND["kind"]}" ] || dt_sndstart
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Sound System"
	CP[$w][$n]["val"]=${DT_SNDKIND:-Auto}; CP[$w][$n]["key"]=kind
	n=$((n + 1))
	CP[$w][$n]["kind"]=info; CP[$w][$n]["text"]="Sound Server"
	case ${DT_SND["kind"]} in
	pulse | pw | alsa) CP[$w][$n]["val"]=${DT_SND["server"]:-${DT_SND["kind"]}} ;;
	*)
		if [ -n "${DT_SND["why"]}" ]; then
			CP[$w][$n]["val"] := dt_tr "%s is not answering" "${DT_SND["why"]}"
		else
			CP[$w][$n]["val"] := dt_tr "none found"
		fi
		;;
	esac
	n=$((n + 1))
	case ${DT_SND["kind"]} in
	pulse | pw | alsa) ;;
	*) ret "$n"; return 0 ;;
	esac
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Output"; n=$((n + 1))
	d := dt_snddesc out "${DT_SND["out"]}"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Device"
	CP[$w][$n]["val"]=$d; CP[$w][$n]["key"]=out; n=$((n + 1))
	v=${DT_SND["vol"]:-0}
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Volume ($v%)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$v; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=100
	CP[$w][$n]["key"]=vol; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mute"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_SND["mute"]}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=mute; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Input"; n=$((n + 1))
	d := dt_snddesc in "${DT_SND["in"]}"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Device"
	CP[$w][$n]["val"]=$d; CP[$w][$n]["key"]=in; n=$((n + 1))
	v=${DT_SND["ivol"]:-0}
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Level ($v%)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$v; CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=100
	CP[$w][$n]["key"]=ivol; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Mute"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_SND["imute"]}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=imute; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Desktop"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Volume on Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_SNDBAR:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SNDBAR; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Level on Menu Bar"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "${DT_SNDLEVEL:-1}" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SNDLEVEL; n=$((n + 1))
	v=${DT_SNDSTEP:-5}
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Volume Step ($v%)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$v; CP[$w][$n]["min"]=1; CP[$w][$n]["max"]=20
	CP[$w][$n]["key"]=step; n=$((n + 1))
	ret "$n"
}

fn sound_do(int w, k, int dir) {
	local v i=0 cur

	case $k in
	kind)
		v := cp_next "${DT_SNDKIND:-Auto}" "$dir" "${SN_KINDS[@]}"
		cp_set_sndkind "" "$v"
		return 0
		;;
	vol) dt_sndvol $((${DT_SND["vol"]:-0} + dir * ${DT_SNDSTEP:-5})) ;;
	ivol) dt_sndivol $((${DT_SND["ivol"]:-0} + dir * ${DT_SNDSTEP:-5})) ;;
	mute) dt_sndmute ;;
	imute) dt_sndimute ;;
	DT_SNDBAR | DT_SNDLEVEL) cp_toggle "$k"; dt_sndbar ;;
	step)
		v=$((${DT_SNDSTEP:-5} + dir))
		[ "$v" -lt 1 ] && v=1
		[ "$v" -gt 20 ] && v=20
		DT_SNDSTEP=$v
		;;
	out | in)
		cur := dt_snddesc "$k" "${DT_SND["$k"]}"
		if [ "$k" = out ]; then
			v := cp_next "$cur" "$dir" "${DT_SNDOD[@]}"
			cp_set_sndout "" "$v"
		else
			v := cp_next "$cur" "$dir" "${DT_SNDID[@]}"
			cp_set_sndin "" "$v"
		fi
		;;
	esac
	cp_save
}

fn sound_slide(int w, k, int value) {
	case $k in
	vol) dt_sndvol "$value" ;;
	ivol) dt_sndivol "$value" ;;
	step) DT_SNDSTEP=$value; cp_save ;;
	esac
}

fn sound_drop(int w, int r, int c, k) {
	case $k in
	kind) dt_droplist "$w" "$r" "$c" cp_set_sndkind "${SN_KINDS[@]}" ;;
	out) dt_droplist "$w" "$r" "$c" cp_set_sndout "${DT_SNDOD[@]}" ;;
	in) dt_droplist "$w" "$r" "$c" cp_set_sndin "${DT_SNDID[@]}" ;;
	esac
}
