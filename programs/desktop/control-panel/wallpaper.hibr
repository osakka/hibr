#!/usr/bin/env hibr
#
# wallpaper -- browse for an image, preview it in real colour (fitted to
# its own aspect ratio, not stretched), apply it as the desktop's
# wallpaper, also in full colour. A dialog window of its own, opened from
# Control Panel > Wallpaper's "Image…" row, the same way Date & Time opens its
# time zone picker. See wp_preview for how the preview itself is drawn
# straight into this window's own pane.
# The folder side is the desktop's own Open dialog's (wm/filepick.hibr):
# fp_go reads a folder into FP under this window's id, folders first and
# then only the files of the type asked for, and fp_path names an entry.
# It was the Files app's folder model until 0.99.228, which made a core
# setting need an application the package does not ship (Gitea #265,
# ADR 0046). Only the drawing is this file's own -- the picker's list is a
# strip beside a fitted picture, not the dialog's layout.
#
# The window's own prefix is wallpick, not wallpaper: control-strip's
# own wallpaper.hibr already defines wallpaper_draw/_click for its glyph
# cycler, and the two would silently redefine each other's functions if
# this one used the same prefix -- a function defined twice replaces the
# first with no error at all. Their display names both say "Wallpaper"
# on purpose; they live in different parts of the UI and do different
# things (a plain glyph there, an image here), the same way two apps can
# each have their own File menu.
strict

declare -gA WPK

# What the img module decodes: PNG and JPEG, as the extensions fp_go
# filters on -- img itself goes by a file's first bytes, but a picker lists
# names, and offering a file that fails the moment it is reached is worse
# than not offering it.
WPK_TYPES="Images:png jpg jpeg"

# Where the picker starts: wherever it was left, or failing that wherever
# the current wallpaper image already lives, or failing that home. Kept
# across restarts the same way CP_THEME is, through dt_keep.
WPK_DIR=
command -v dt_keep > /dev/null && dt_keep WPK_DIR

# The image or the Mode for the display Control Panel > Wallpaper has
# chosen, when that pane is here to say (Gitea #284), or All Displays'.
fn wp_cur(field) {
	local v

	if command -v cp_wdget > /dev/null; then
		v := cp_wdget "$field"
		ret "$v"
	fi
	case $field in
	img) ret "$DT_WALLIMG" ;;
	*) ret "$DT_WALLMODE" ;;
	esac
}

# And set one, for that display.
fn wp_put(field, value = "") {
	if command -v cp_wdset > /dev/null; then
		cp_wdset "$field" "$value"
		return 0
	fi
	case $field in
	img) DT_WALLIMG=$value; DT_WALLBAD= ;;
	*) DT_WALLMODE=$value ;;
	esac
}

# Open the picker in a window of its own, over the Control Panel.
wp_dialog() {
	local h=20 w=64 r c

	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	dt_new "Wallpaper" "$h" "$w" "$r" "$c" wallpick
}

fn wallpick_open(int id, arg = "") {
	WPK[$id]["focus"]=list
}

fn wallpick_close(int id) {
	unset "WPK[$id]" "FP[$id]"
}

# Start in the folder the picker was last left in -- run on the first
# frame, once _draw has laid out the preview box the fit is worked out for.
# A folder that has gone since it was kept starts at home instead: fp_go
# leaves the folder unset when it cannot open one, and _draw calls this
# while it is unset, so a missing one would be a note on every frame.
fn wp_init(int id) {
	local d=$WPK_DIR img

	img := wp_cur img
	if [ -z "$d" ] && [ -n "$img" ]; then
		d=${img%/*}
		[ "$d" = "$img" ] && d=.
	fi
	[ "$d" = . ] && d=$PWD
	[ -d "$d" ] && [ -r "$d" ] || d=${HOME:-/}
	FP[$id]["types"]=$WPK_TYPES
	FP[$id]["ti"]=0
	WPK[$id]["last"]=-1
	fp_go "$id" "$d" || fp_go "$id" /
	WPK[$id]["previewfor"]=
}

# Whether an entry is a folder, the one above included.
fn wp_isdir(int id, int i) {
	case ${FP[$id]["k$i"]} in dir | up) return 0 ;; esac
	return 1
}

# Change directory and remember it, so the picker starts here next time --
# shared by backspace, entering a directory from the keyboard, and a
# double-click on one from the mouse, so all three ways in keep it current.
# dir is an entry's name, or .. for the folder above.
fn wp_goto(int id, dir) {
	local d=${FP[$id]["dir"]}

	if [ "$dir" = .. ]; then
		d=${d%/*}
	else
		d="${d%/}/$dir"
	fi
	fp_go "$id" "$d" || return 0
	WPK[$id]["last"]=-1
	WPK_DIR=${FP[$id]["dir"]}
	command -v dt_save > /dev/null && dt_save
	wp_refresh "$id"
}

# The previewed file is drawn as a real colour image, straight into this
# window's own pane (img draw -p, DP_API_VER 3) -- not a grayscale
# density-ramp render captured into text any more. A raw, un-paned draw
# straight at screen coordinates was tried here once and pulled after it
# corrupted the display applying a new wallpaper while this pane's own
# preview was also open; img draw -p is the real fix for that, added to
# the console and img modules themselves -- it clips and translates the
# same way console put -p already does for text, so this needs no more
# care than any other window's own content does, and no reading of the
# window manager's own position table.
fn wp_preview(int id, path) {
	dt_has img || need img > /dev/null 2>&1
	dt_has img || return 1
	WPK[$id]["previewfor"]=$path
	return 0
}

# Reload the preview for whatever is selected now, or clear it -- called
# after anything that can move the selection: a directory change starts
# clear (nothing there yet makes sense to preview), a plain up/down only
# updates it when it actually lands on an image. Reads its own sizing
# from WPK[$id], laid out fresh by _draw every frame before this could
# ever run from a key or a click.
fn wp_refresh(int id) {
	local sel path

	sel=${FP[$id]["sel"]}
	if [ "$sel" -ge "${FP[$id]["n"]:-0}" ] || wp_isdir "$id" "$sel"; then
		WPK[$id]["previewfor"]=
		return 0
	fi
	path := fp_path "$id" "$sel"
	if wp_preview "$id" "$path"; then
		wp_fitcache "$id" "$path" "${WPK[$id]["prevh"]}" "${WPK[$id]["prevw"]}"
	else
		WPK[$id]["previewfor"]=
	fi
}

# The rows/cols to hand img draw so the image keeps its own aspect ratio
# rather than being stretched to fill the whole preview box, and the
# offset within the box that centres it (a letterbox, top/bottom or
# left/right depending which way the box and the image disagree).
#
# img draw's own cell is one column wide but two source pixel rows tall
# (the upper/lower half-block trick that doubles its vertical resolution),
# so a visually square unit of the box is one column by *half* a row --
# cols/rows must equal 2*sw/sh, not sw/sh, or an image whose own ratio is
# right would still come out stretched.
#
# Cached on the path and the box size together, so a frame where neither
# changed reads the last answer instead of asking img size -- a full
# decode with no result but the two numbers -- again for nothing; img
# draw's own cache (keyed the same way) already saves the same repeat for
# the actual pixels.
fn wp_fitcache(int id, path, int boxr, int boxc) {
	local sw sh out fitr fitc

	if [ "${WPK[$id]["fitfor"]}" = "$path" ] &&
	   [ "${WPK[$id]["fitboxr"]}" = "$boxr" ] &&
	   [ "${WPK[$id]["fitboxc"]}" = "$boxc" ]; then
		return 0
	fi
	fitr=$boxr
	fitc=$boxc
	out := img size "$path"
	if [ -n "$out" ]; then
		sw=${out% *}
		sh=${out#* }
		if [ "$sw" -gt 0 ] && [ "$sh" -gt 0 ]; then
			fitc=$boxc
			fitr=$((fitc * sh / (2 * sw)))
			if [ "$fitr" -gt "$boxr" ]; then
				fitr=$boxr
				fitc=$((fitr * 2 * sw / sh))
			fi
			[ "$fitc" -lt 1 ] && fitc=1
			[ "$fitr" -lt 1 ] && fitr=1
			[ "$fitc" -gt "$boxc" ] && fitc=$boxc
			[ "$fitr" -gt "$boxr" ] && fitr=$boxr
		fi
	fi
	WPK[$id]["fitfor"]=$path
	WPK[$id]["fitboxr"]=$boxr
	WPK[$id]["fitboxc"]=$boxc
	WPK[$id]["fitr"]=$fitr
	WPK[$id]["fitc"]=$fitc
	WPK[$id]["fitoffr"]=$(((boxr - fitr) / 2))
	WPK[$id]["fitoffc"]=$(((boxc - fitc) / 2))
}

# The list and preview fill everything but the last two rows, which hold
# the Apply and Close buttons and their shadow.
fn wallpick_draw(int id, int h, int w, int row, int col) {
	local listw prevw prevx prevh vis moderow i r n top sel t path bx=1
	local wh=$h

	dt_wclear "$id"
	h=$((h - 1))

	listw=$(((w - 3) * 2 / 5))
	[ "$listw" -lt 16 ] && listw=16
	prevx=$((bx + listw + 2))
	prevw=$((w - listw - 3))
	prevh=$((h - 4))
	vis=$((h - 3))
	moderow=$((h - 2))
	WPK[$id]["listw"]=$listw
	WPK[$id]["bx"]=$bx
	WPK[$id]["prevw"]=$prevw
	WPK[$id]["prevx"]=$prevx
	WPK[$id]["prevh"]=$prevh
	WPK[$id]["vis"]=$vis
	WPK[$id]["moderow"]=$moderow

	if [ -z "${FP[$id]["dir"]}" ]; then
		wp_init "$id"
		wp_refresh "$id"
	fi

	console pen "$DT_IDLE" "$DT_FACE"
	r=1
	while [ "$r" -le $((h - 1)) ]; do
		console put -p "w$id" "$r" $((bx + listw + 1)) "${GL[vline]}"
		r=$((r + 1))
	done

	console pen "$DT_ACTIVE" "$DT_FACE" bold
	t=${FP[$id]["dir"]}
	[ ${#t} -gt "$listw" ] && t="${GL[ellipsis]}${t: -$((listw - 1))}"
	t := str pad "$t" "$listw"
	console put -p "w$id" 1 "$bx" "$t"

	n=${FP[$id]["n"]}
	top=${FP[$id]["top"]}
	sel=${FP[$id]["sel"]}
	i=$top
	r=2
	while [ "$r" -le $((h - 2)) ]; do
		if [ "$i" -lt "$n" ]; then
			t=${FP[$id]["e$i"]}
			wp_isdir "$id" "$i" && t="$t/"
			[ ${#t} -gt "$listw" ] && t="${t:0:$listw}"
			t := str pad "$t" "$listw"
		else
			t := str pad "" "$listw"
		fi
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ] &&
		   [ "${WPK[$id]["focus"]}" = list ]; then
			console pen "$DT_SELINK" "$DT_ACTIVE" bold
		elif [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			console pen "$DT_ACTIVE" "$DT_FACE" bold
		else
			console pen "$DT_INK" "$DT_FACE"
		fi
		console put -p "w$id" "$r" "$bx" "$t"
		i=$((i + 1))
		r=$((r + 1))
	done
	console pen "$DT_IDLE" "$DT_FACE"
	t="$((sel + 1)) of $n"
	t := str pad "$t" "$listw"
	console put -p "w$id" $((h - 1)) "$bx" "$t"

	console pen "$DT_INK" "$DT_FACE"
	path=${WPK[$id]["previewfor"]}
	r=1
	while [ "$r" -le "$prevh" ]; do
		t := str pad "" "$prevw"
		console put -p "w$id" "$r" "$prevx" "$t"
		r=$((r + 1))
	done
	if [ -n "$path" ]; then
		img draw "$path" $((${WPK[$id]["fitoffr"]} + 1)) \
			$((prevx + ${WPK[$id]["fitoffc"]})) \
			"${WPK[$id]["fitr"]}" "${WPK[$id]["fitc"]}" \
			-p "w$id" 2> /dev/null
	else
		console pen "$DT_IDLE" "$DT_FACE"
		t="Select an image"
		[ ${#t} -gt "$prevw" ] && t="${t:0:$prevw}"
		console put -p "w$id" 1 "$prevx" "$t"
	fi

	console pen "$DT_INK" "$DT_FACE"
	t := wp_cur mode
	t="Mode: ${t^} ${GL[sdown]}"
	t := str pad "$t" "$prevw"
	console put -p "w$id" "$moderow" "$prevx" "$t"
	dt_wreg "$id" "$moderow" "$prevx" "$prevw" mode
	dt_dlgbtns "$id" "$wh" "$w" "${WPK[$id]["focus"]}" ok Apply cancel Close
}

# Tab moves between the list and the buttons; enter on a button does it,
# on the list enters a folder or applies an image; escape closes.
fn wallpick_key(int id, key) {
	local n vis top sel f=${WPK[$id]["focus"]} d onb=1

	[ "$f" = list ] && onb=0
	if d := dt_focuskey "$key" "$onb"; then
		WPK[$id]["focus"] := dt_focus "$f" "$d" list ok cancel
		return 0
	fi
	case $key in
	escape) dt_del "$id"; return 0 ;;
	enter)
		case $f in
		ok) wp_apply "$id"; return 0 ;;
		cancel) dt_del "$id"; return 0 ;;
		esac
		;;
	esac
	[ "$f" = list ] || return 0
	n=${FP[$id]["n"]}
	sel=${FP[$id]["sel"]}
	top=${FP[$id]["top"]}
	case $key in
	up) sel=$((sel - 1)) ;;
	down) sel=$((sel + 1)) ;;
	m)
		local i cm
		cm := wp_cur mode
		for i in "${!WP_MODES[@]}"; do
			[ "${WP_MODES[$i]}" = "$cm" ] && break
		done
		wp_setmode "$id" "${WP_MODES[$(((i + 1) % ${#WP_MODES[@]}))]}"
		return 0
		;;
	backspace)
		wp_goto "$id" ..
		return 0
		;;
	enter)
		if wp_isdir "$id" "$sel"; then
			wp_goto "$id" "${FP[$id]["e$sel"]}"
		else
			wp_apply "$id"
		fi
		return 0
		;;
	*) return 1 ;;
	esac
	[ "$sel" -lt 0 ] && sel=0
	[ "$sel" -ge "$n" ] && sel=$((n - 1))
	FP[$id]["sel"]=$sel
	vis=${WPK[$id]["vis"]}
	[ "$sel" -lt "$top" ] && top=$sel
	[ "$sel" -ge $((top + vis)) ] && top=$((sel - vis + 1))
	FP[$id]["top"]=$top
	wp_refresh "$id"
	return 0
}

# A custom-drawn pane (its own wallpick_draw, not the generic row list)
# has to define this itself, the same way it defines wallpick_key --
# panel_wheel only falls back to its own generic top/n/vis scrolling for
# a pane with no _draw of its own. Missing here meant the wheel simply
# did nothing over the picker at all, reported live. Scrolls the view
# only, same as files_wheel; the selection does not follow, the same as
# the arrow keys' own up/down already leave it when they scroll without
# crossing it.
fn wallpick_wheel(int id, dir, r = "", c = "") {
	local top

	top=${FP[$id]["top"]}
	top := dt_scrollmove "$dir" "$top" "${FP[$id]["n"]}" \
		"${WPK[$id]["vis"]}" "$DT_SCROLLWHEEL" || return 0
	FP[$id]["top"]=$top
	wp_refresh "$id"
}

# Called by dt_droplist's own popup with (id, value) -- id is unused, the
# same "cb id value" shape every dropdown here uses, since the value alone
# is enough to set a desktop-wide mode.
fn wp_setmode(int? id = "", value = "") {
	wp_put mode "$value"
	command -v dt_save > /dev/null && dt_save
}

# Set the currently previewed file as the wallpaper, always in full
# colour -- shared by a click on the button and enter on an already-
# previewed file, so there is a keyboard way to finish this, not only a
# mouse one.
fn wp_apply(int id) {
	[ -n "${WPK[$id]["previewfor"]}" ] || return 0
	wp_put img "${WPK[$id]["previewfor"]}"
	command -v dt_save > /dev/null && dt_save
	command -v dt_note > /dev/null && dt_notep low "Wallpaper set"
}

# A click selects a row; a second click on the same, already-selected row
# either enters the directory or applies the image -- the same
# select-then-activate convention panel.hibr's own generic row list and
# files.hibr's own file list both already use, tracked the same way:
# WPK[$id]["last"] (reset to -1 on every directory change, so a
# stale index from the old listing can never falsely count as a repeat).
fn wallpick_click(int id, int r, int c, btn = "") {
	local bx=${WPK[$id]["bx"]} listw=${WPK[$id]["listw"]} n i tag

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	ok) wp_apply "$id"; return 0 ;;
	cancel) dt_del "$id"; return 0 ;;
	mode)
		dt_droplist "$id" "$r" "$c" wp_setmode "${WP_MODES[@]}"
		return 0
		;;
	esac
	WPK[$id]["focus"]=list
	[ "$c" -ge "$bx" ] || return 0
	[ "$c" -lt $((bx + listw)) ] || return 0
	[ "$r" -lt 2 ] && return 0
	n=${FP[$id]["n"]}
	i=$((FP[$id]["top"] + r - 2))
	[ "$i" -ge "$n" ] && return 0
	if [ "$i" = "${FP[$id]["sel"]}" ] && [ "$i" = "${WPK[$id]["last"]}" ]; then
		if wp_isdir "$id" "$i"; then
			wp_goto "$id" "${FP[$id]["e$i"]}"
		else
			wp_apply "$id"
		fi
		return 0
	fi
	FP[$id]["sel"]=$i
	WPK[$id]["last"]=$i
	wp_refresh "$id"
}
