#!/usr/bin/env hibr
#
# abouthibr -- the Control Panel pane for About This Computer: how often its CPU and
# memory figures are read again. Named abouthibr, not about, because the
# app's own about_draw would otherwise be taken for this pane's body.

strict


app abouthibr "The Control Panel pane for About This Computer" 1.0
command -v cp_pane > /dev/null && cp_pane abouthibr "About This Computer" "ⓘ"

CP_ABTICKS=(1000 2000 3000 5000 10000)
fn cp_set_about(int? id = "", int? value = "") { dt_set AB_SLOWMS "$value"; }

fn abouthibr_rows(int w) {
	[ -n "$AB_SLOWMS" ] || { cp_absent "$w" "About This Computer"; ret 1; }
	CP[$w][0]["kind"]=set; CP[$w][0]["text"]="Refresh"; CP[$w][0]["key"]=about
	cp_choice "$w" 0 "$AB_SLOWMS" cp_set_about "${CP_ABTICKS[@]}"
	CP[$w][0]["vname"]=cp_ms
	ret 1
}
