#!/usr/bin/env hibr
#
# archiveset -- the Control Panel pane for archives: which format Compress
# writes, what Extract Here makes, and whether the folder opens afterwards.
# It belongs to the archives extension and goes with it.

strict

app archiveset "The Control Panel pane for archives" 1.0
command -v cp_pane > /dev/null && cp_pane archiveset "Archives" "▤" app

# The extension's own, repeated so the pane can set them with it not loaded.
DT_ARCFORMAT="${DT_ARCFORMAT-tar.gz}"
DT_ARCFOLDER="${DT_ARCFOLDER-smart}"
DT_ARCOPEN="${DT_ARCOPEN-0}"
command -v dt_keep > /dev/null && dt_keep DT_ARCFORMAT DT_ARCFOLDER DT_ARCOPEN

AS_FOLDERS=("Smart Folder" "New Folder")

fn as_foldername(v) {
	case $v in always) ret "New Folder" ;; *) ret "Smart Folder" ;; esac
}

fn cp_set_arcformat(int? id = "", value = "") { DT_ARCFORMAT=$value; cp_save; }
fn cp_set_arcfolder(int? id = "", value = "") {
	DT_ARCFOLDER=smart
	[ "$value" = "New Folder" ] && DT_ARCFOLDER=always
	cp_save
}

fn archiveset_rows(int w) {
	local n=0 v

	dt_has arc_formats || { cp_absent "$w" Archives; ret 1; }
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Compress To"
	CP[$w][$n]["val"]="$DT_ARCFORMAT"; CP[$w][$n]["key"]=arcformat
	n=$((n + 1))
	v := as_foldername "$DT_ARCFOLDER"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Extract Here Makes"
	CP[$w][$n]["val"]="$v"; CP[$w][$n]["key"]=arcfolder
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Open Folder Afterwards"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_ARCOPEN" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_ARCOPEN; n=$((n + 1))
	ret "$n"
}

fn archiveset_do(int? w = "", k = "", int? dir = "") {
	local v

	case $k in
	arcformat)
		dt_needs archives arc_formats && arc_formats
		v := cp_next "$DT_ARCFORMAT" "$dir" "${ARC_FORMATS[@]}"
		DT_ARCFORMAT=$v
		;;
	arcfolder)
		v := as_foldername "$DT_ARCFOLDER"
		v := cp_next "$v" "$dir" "${AS_FOLDERS[@]}"
		cp_set_arcfolder "" "$v"
		return 0
		;;
	DT_ARCOPEN) cp_toggle "$k" ;;
	esac
	cp_save
}

fn archiveset_drop(int? w = "", int? r = "", int? c = "", k = "") {
	case $k in
	arcformat)
		dt_needs archives arc_formats && arc_formats
		dt_droplist "$w" "$r" "$c" cp_set_arcformat "${ARC_FORMATS[@]}"
		;;
	arcfolder) dt_droplist "$w" "$r" "$c" cp_set_arcfolder "${AS_FOLDERS[@]}" ;;
	esac
}
