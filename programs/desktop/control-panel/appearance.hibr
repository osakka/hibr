#!/usr/bin/env hibr
#
# appearance -- the Control Panel pane for how the desktop looks: the
# theme (the whole look at once), the colour scheme, the glyphs and trees,
# the shadows, and how dialog buttons look. The menu bar has a pane of its
# own since 0.99.356 (menubar.hibr, Gitea #396), its look and its items. The
# wallpaper has a pane of its own since 0.99.246 (wallset.hibr, Gitea
# #284), though a theme still carries one and applies it here. A theme
# or a colour scheme sets the variables the window manager already reads
# every frame, so a change shows on the next one, in every window at once.

strict


app appearance "The Control Panel pane for how the desktop looks" 2.17.2
command -v cp_pane > /dev/null && cp_pane appearance "Appearance" "◐"

CP_THEME="${CP_THEME-classic}"
CP_COLOURS="${CP_COLOURS-midnight}"
command -v dt_keep > /dev/null && dt_keep CP_THEME CP_COLOURS

# How an on/off choice is drawn: what the theme suggests, a box, a knob, a
# block, a tick or Blit's capsule -- see DT_CHECKS in wm/settings.hibr.
CP_CHECKS=(theme box knob block tick capsule)
fn cp_set_checks(int? id = "", value = "") { dt_set DT_CHECKS "$value"; }
fn cp_set_baricon(int? id = "", value = "") { dt_set DT_BARICON "$value"; }
fn cp_set_deskicon(int? id = "", value = "") { dt_set DT_DESKICON "$value"; }

# A colour scheme is a JSON file (lib/colours.hibr says what is in one).
# 55 is a soft shadow on a dark face; a light face needs much less of a
# cut, which is why paper's is 90. The person's own folder is searched
# first, so a file there replaces the bundled one of that name -- and their
# themes folder after it, where every colour file lived before 0.99.33 --
# then the data folder `catalogue install` writes into, so a scheme of your own
# shadows a fetched one of the same name and an update cannot overwrite
# your copy, which is the order every one of the desktop's scan lists
# keeps (`DT_APPDIRS` is the shape). Without that entry a colour scheme
# could be published and installed and the pane would never see it, which
# is what 0.99.186 shipped (Gitea #224).
# The machine's own goes above the person's own data folder and below
# ~/.config, which is why these two are built rather than appended to:
# an administrator's install is authoritative and a user does not
# override it, and appending would have put it last where nothing would
# ever read it (ADR 0045).
cp_syscol=
command -v dt_sysdir > /dev/null && cp_syscol := dt_sysdir colours
CP_COLOURDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/colours"
	"${XDG_CONFIG_HOME:-$HOME/.config}/hibr/themes"
	${cp_syscol:+"$cp_syscol"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/colours"
	"$DT_HERE/colours")
CP_COLOURLIST=()
# What a scheme is, and cp_colourread, live in lib/colours.hibr, which
# the login screen reads too (Gitea #389). A desktop has loaded it
# already (dt_libs); a fixture that sources this pane alone has not.
[ -n "${CO_LIBDONE-}" ] || . "$DT_HERE/lib/colours.hibr"

# Every colour scheme in CP_COLOURDIRS, the first of each name winning,
# sorted. A file in the old themes folder that is a theme, not colours, is
# simply not one.
fn cp_colourlist() {
	local d f n

	CP_COLOURLIST=()
	unset CP_CO
	declare -gA CP_CO
	for d in "${CP_COLOURDIRS[@]}"; do
		for f in "$d"/*.json; do
			[ -r "$f" ] || continue
			n=${f##*/}
			n=${n%.json}
			[ -n "${CP_CO["$n"]["wall"]+x}" ] && continue
			cp_colourread "$n" "$f" && CP_COLOURLIST+=("$n")
		done
	done
	arr sort CP_COLOURLIST
}
cp_colourlist

# Apply a colour scheme: the window manager reads these every frame, so it
# shows on the next one, everywhere. A theme passes the rest of what it
# sets as more name and value pairs, so the whole look is one change.
fn cp_colours(t, ...more) {
	[ -n "${CP_CO["$t"]["wall"]+x}" ] || return 1
	dt_set CP_COLOURS "$t" \
		DT_WALL "${CP_CO["$t"]["wall"]}" \
		DT_DOT "${CP_CO["$t"]["dot"]}" \
		DT_BAR "${CP_CO["$t"]["bar"]}" \
		DT_ACTIVE "${CP_CO["$t"]["active"]}" \
		DT_IDLE "${CP_CO["$t"]["idle"]}" \
		DT_FACE "${CP_CO["$t"]["face"]}" \
		DT_INK "${CP_CO["$t"]["ink"]}" \
		DT_SHADOW_PCT "${CP_CO["$t"]["shadow"]}" \
		DT_DIM "${CP_CO["$t"]["dim"]}" \
		DT_SELINK "${CP_CO["$t"]["selink"]}" \
		DT_GOOD "${CP_CO["$t"]["good"]}" \
		DT_WARN "${CP_CO["$t"]["warn"]}" \
		DT_BAD "${CP_CO["$t"]["bad"]}" \
		DT_INFO "${CP_CO["$t"]["info"]}" \
		DT_WELL "${CP_CO["$t"]["well"]}" \
		DT_THEMECHECKS "${CP_CO["$t"]["checks"]}" \
		DT_TITLE "${CP_CO["$t"]["titlebar"]}" \
		DT_TITLEINK "${CP_CO["$t"]["titleink"]}" \
		DT_HIGHLIGHT "${CP_CO["$t"]["highlight"]}" \
		DT_SHADOWINK "${CP_CO["$t"]["shadowink"]:-#000000}" \
		DT_HOT "${CP_CO["$t"]["hot"]}" \
		"${more[@]}"
	return 0
}

# A theme is the whole look, also a JSON file, one to a theme: the colour
# scheme it uses ("colours", by name, the one key it must have), and
# whatever else it sets -- the wallpaper glyph and an image ("wallpaper",
# "image", "mode"; an image's path relative to the theme's own folder, so
# a theme can carry its picture), the window frame, title bar, buttons,
# which there are and the title's alignment ("frame", "titlebar", "buttons",
# "layout", "align"), checkboxes, dialog buttons and the glyph set ("checks",
# "dialog", "glyphs"), the four shadows ("windowshadow", "menushadow",
# "barshadow", "buttonshadow", true or false) and the shape they are cast
# in ("shadowshape": half, cols or thin). What it leaves out takes the
# desktop's default, so a theme always looks the same, whatever came
# before it. Each value must be one the setting can take, or the file is
# left out whole, like a colour file. Applying one sets each of these
# settings, which can still be changed one by one afterwards. The person's
# own folder is searched first, and Save Current Look as Theme writes
# there; then the data folder `catalogue install` writes into, then the bundled
# one -- the same order every scan list keeps, and the reason a theme's
# own picture has to land *beside* its JSON rather than under it, since
# `image` is read from the folder the theme was found in (Gitea #224).
cp_systh=
command -v dt_sysdir > /dev/null && cp_systh := dt_sysdir themes
CP_THEMEDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/themes"
	${cp_systh:+"$cp_systh"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/themes"
	"$DT_HERE/themes")
CP_THEMES=()
declare -gA CP_TH
declare -gA CP_THDEF
CP_THDEF["wallpaper"]=${WP_GLYPHS[0]}; CP_THDEF["image"]=; CP_THDEF["mode"]=stretch
CP_THDEF["frame"]=single; CP_THDEF["titlebar"]=line; CP_THDEF["buttons"]=brackets
# A tree is decoration the same way the window buttons are, so a theme
# carries it too: a theme that draws its windows one way and leaves every
# tree in the desktop looking like the one before it is half a theme.
CP_THDEF["tree"]=plus; CP_THDEF["treelines"]=1
CP_THDEF["layout"]="title max min close"; CP_THDEF["align"]=left; CP_THDEF["checks"]=theme
CP_THDEF["dialog"]=filled; CP_THDEF["glyphs"]=unicode
CP_THDEF["windowshadow"]=1; CP_THDEF["menushadow"]=1
CP_THDEF["barshadow"]=1; CP_THDEF["buttonshadow"]=1; CP_THDEF["shadowshape"]=half
CP_THDEF["wintrans"]=0; CP_THDEF["bartrans"]=0
CP_THDEF["band"]=frame; CP_THDEF["bandpct"]=30

# Whether a value is one of a list.
# A theme's "layout" is the buttons shown and the title, in order, so
# "close title max" is close to its left and zoom to its right.
fn cp_layoutok(v) {
	local x t=
	local -a a

	read -ra a <<< "$v"
	for x in "${a[@]}"; do
		cp_oneof "$x" "${DT_BTNS[@]}" || return 1
		[ "$x" = title ] && t=1
	done
	[ -n "$t" ]
}

# The list as a theme says it: the title and the buttons switched on.
fn cp_layout() {
	local k out=

	dt_btnlist
	for k in "${DT_BTNL[@]}"; do
		dt_btnhidden "$k" || out+="${out:+ }$k"
	done
	ret "$out"
}

fn cp_oneof(v, ...vals) {
	local x

	for x in "${vals[@]}"; do [ "$x" = "$v" ] && return 0; done
	return 1
}

# Read one theme file into CP_TH[name], or refuse it whole.
fn cp_themeread(n, f) {
	local j k v
	local -A got

	json parse j < "$f" 2> /dev/null || return 1
	v=${j["colours"]-}
	[ -n "$v" ] && [ -z "${v//[A-Za-z0-9._-]/}" ] || return 1
	got["colours"]=$v
	for k in "${!CP_THDEF[@]}"; do
		v=${j["$k"]-${CP_THDEF["$k"]}}
		case $k in
		wallpaper) cp_oneof "$v" "${WP_GLYPHS[@]}" || return 1 ;;
		mode) cp_oneof "$v" "${WP_MODES[@]}" || return 1 ;;
		# bar is what none was called until 0.99.324, and curved was a
		# frame in 0.99.324 only: a theme installed then still says
		# them, and a file refused whole would drop out of the list on
		# every desktop that has it. Both are no border; the title bar
		# they drew is put back below, once every field is read.
		frame) case $v in bar | curved) v=none ;; esac
		       cp_oneof "$v" "${WS_FRAMES[@]}" || return 1 ;;
		titlebar) cp_oneof "$v" "${DT_TITLEBARS[@]}" || return 1 ;;
		buttons) cp_oneof "$v" "${WS_STYLES[@]}" || return 1 ;;
		tree) cp_oneof "$v" "${DT_TREESTYLES[@]}" || return 1 ;;
		layout) cp_layoutok "$v" || return 1 ;;
		align) cp_oneof "$v" "${WS_ALIGNS[@]}" || return 1 ;;
		checks) cp_oneof "$v" "${CP_CHECKS[@]}" || return 1 ;;
		dialog) cp_oneof "$v" "${DT_DLGBTNS[@]}" || return 1 ;;
		shadowshape) cp_oneof "$v" "${DT_SHADOWSHAPES[@]}" || return 1 ;;
		glyphs) cp_oneof "$v" "${DT_GLYPHSETS[@]}" || return 1 ;;
		band) cp_oneof "$v" "${DT_BANDS[@]}" || return 1 ;;
		wintrans | bartrans | bandpct)
			case $v in '' | *[!0-9]*) return 1 ;; esac
			[ ${#v} -le 3 ] && [ "$v" -le 100 ] || return 1
			;;
		treelines | *shadow)
			case $v in
			true | 1) v=1 ;;
			false | 0) v=0 ;;
			*) return 1 ;;
			esac
			;;
		image)
			case $v in
			"") ;;
			"~/"*) v=$HOME/${v#"~/"} ;;
			/*) ;;
			*) v=${f%/*}/$v ;;
			esac
			;;
		esac
		got["$k"]=$v
	done
	case ${j["frame"]-} in
	curved) got["titlebar"]=curved ;;
	bar) [ -n "${j["titlebar"]-}" ] || got["titlebar"]=solid ;;
	esac
	for k in "${!got[@]}"; do
		CP_TH["$n"]["$k"]=${got["$k"]}
	done
}

# Every theme in CP_THEMEDIRS, the first of each name winning, sorted. A
# colour file in the person's themes folder, left from before themes and
# colours were apart, is not a theme and is skipped.
fn cp_themes() {
	local d f n

	CP_THEMES=()
	unset CP_TH
	declare -gA CP_TH
	for d in "${CP_THEMEDIRS[@]}"; do
		for f in "$d"/*.json; do
			[ -r "$f" ] || continue
			n=${f##*/}
			n=${n%.json}
			[ -n "${CP_TH["$n"]["colours"]+x}" ] && continue
			cp_themeread "$n" "$f" && CP_THEMES+=("$n")
		done
	done
	arr sort CP_THEMES
}
cp_themes

# Apply a theme: its colours and every setting it carries, as one change.
# Its layout is the buttons in the order it names, the title among them;
# a button it does not name goes after them, switched off.
fn cp_theme(t) {
	local x l ord on= g

	[ -n "${CP_TH["$t"]["colours"]+x}" ] || return 1
	[ -n "${CP_CO["${CP_TH["$t"]["colours"]}"]["wall"]+x}" ] || return 1
	l=${CP_TH["$t"]["layout"]}
	ord=$l
	for x in "${DT_BTNS[@]}"; do
		case " $l " in
		*" $x "*) [ "$x" = title ] || on+="${on:+ }$x" ;;
		*) ord+=" $x" ;;
		esac
	done
	g=${CP_TH["$t"]["glyphs"]}
	dt_wallretry
	cp_colours "${CP_TH["$t"]["colours"]}" \
		CP_THEME "$t" \
		DT_GLYPH "${CP_TH["$t"]["wallpaper"]}" \
		DT_WALLIMG "${CP_TH["$t"]["image"]}" \
		DT_WALLMODE "${CP_TH["$t"]["mode"]}" \
		DT_FRAME "${CP_TH["$t"]["frame"]}" \
		DT_TITLEBAR "${CP_TH["$t"]["titlebar"]}" \
		DT_BTNSTYLE "${CP_TH["$t"]["buttons"]}" \
		DT_TREESTYLE "${CP_TH["$t"]["tree"]}" \
		DT_TREELINES "${CP_TH["$t"]["treelines"]}" \
		DT_BTNORDER "$ord" \
		DT_BTNON "$on" \
		DT_TITLEALIGN "${CP_TH["$t"]["align"]}" \
		DT_CHECKS "${CP_TH["$t"]["checks"]}" \
		DT_DLGBTN "${CP_TH["$t"]["dialog"]}" \
		DT_SHADOW "${CP_TH["$t"]["windowshadow"]}" \
		DT_MSHADOW "${CP_TH["$t"]["menushadow"]}" \
		DT_BARSHADOW "${CP_TH["$t"]["barshadow"]}" \
		DT_BTNSHADOW "${CP_TH["$t"]["buttonshadow"]}" \
		DT_SHADOWSHAPE "${CP_TH["$t"]["shadowshape"]}" \
		DT_BAND "${CP_TH["$t"]["band"]}" \
		DT_BANDPCT "${CP_TH["$t"]["bandpct"]}" \
		DT_WINTRANS "${CP_TH["$t"]["wintrans"]}" \
		DT_BARTRANS "${CP_TH["$t"]["bartrans"]}" \
		DT_GLYPHSET "$g"
	dt_treespec
	return 0
}

# A text as a JSON string.
fn cp_jstr(t) {
	t=${t//\\/\\\\}
	t=${t//\"/\\\"}
	ret "\"$t\""
}

# Write the look as it is now as a theme file -- the colour scheme by name,
# and every other setting a theme carries -- and list it.
fn cp_themewrite(path) {
	local n img b vn l

	n=${path##*/}
	n=${n%.json}
	[ -n "$n" ] && [ -z "${n//[A-Za-z0-9._ -]/}" ] || { dt_notep high "A theme's name is letters, digits, spaces, dots and dashes"; return 1; }
	mkdir -p "${path%/*}" 2> /dev/null
	img := cp_jstr "$DT_WALLIMG"
	l := cp_layout
	{
		printf '{\n'
		printf '  "colours": "%s",\n' "${CP_COLOURS:-midnight}"
		printf '  "wallpaper": "%s",\n' "$DT_GLYPH"
		printf '  "image": %s,\n' "$img"
		printf '  "mode": "%s",\n' "$DT_WALLMODE"
		printf '  "frame": "%s",\n' "$DT_FRAME"
		printf '  "titlebar": "%s",\n' "$DT_TITLEBAR"
		printf '  "buttons": "%s",\n' "$DT_BTNSTYLE"
		printf '  "tree": "%s",\n' "$DT_TREESTYLE"
		printf '  "treelines": %s,\n' \
			"$([ "$DT_TREELINES" = 1 ] && echo true || echo false)"
		printf '  "layout": "%s",\n' "$l"
		printf '  "align": "%s",\n' "$DT_TITLEALIGN"
		printf '  "checks": "%s",\n' "$DT_CHECKS"
		printf '  "dialog": "%s",\n' "$DT_DLGBTN"
		printf '  "shadowshape": "%s",\n' "$DT_SHADOWSHAPE"
		printf '  "glyphs": "%s",\n' "$DT_GLYPHSET"
		printf '  "wintrans": %s,\n' "${DT_WINTRANS:-0}"
		printf '  "bartrans": %s,\n' "${DT_BARTRANS:-0}"
		printf '  "band": "%s",\n' "${DT_BAND:-frame}"
		printf '  "bandpct": %s,\n' "${DT_BANDPCT:-30}"
		for b in windowshadow:DT_SHADOW menushadow:DT_MSHADOW barshadow:DT_BARSHADOW; do
			vn=${b#*:}
			if [ "${!vn}" = 1 ]; then printf '  "%s": true,\n' "${b%%:*}"; else printf '  "%s": false,\n' "${b%%:*}"; fi
		done
		if [ "$DT_BTNSHADOW" = 1 ]; then printf '  "buttonshadow": true\n'; else printf '  "buttonshadow": false\n'; fi
		printf '}\n'
	} > "$path" || { dt_notep high "Could not write %s" "${path##*/}"; return 1; }
	cp_themes
	dt_set CP_THEME "$n"
	dt_notep low "Saved the look as the theme %s" "$n"
}

# Save Current Look as Theme: a name, asked with the file dialog, in the
# person's own themes folder.
cp_themesave() {
	local d=${CP_THEMEDIRS[0]}

	mkdir -p "$d" 2> /dev/null
	dt_filepick save "Save Current Look as Theme" "Themes:*.json" "$d" "My Theme.json" cp_themesaved ""
}
fn cp_themesaved(id = "", path = "", type = "") {
	[ -n "$path" ] || return 0
	[[ $path == *.json ]] || path+=.json
	cp_themewrite "$path"
}

fn cp_set_theme(int id, value) { cp_theme "$value"; }
fn cp_set_colours(int id, value) { cp_colours "$value"; }

# Whether the look now is the theme t as it was applied: its colours and
# every setting it carries.
fn cp_lookis(t) {
	local l

	[ -n "${CP_TH["$t"]["colours"]+x}" ] || return 1
	l := cp_layout
	[ "$CP_COLOURS" = "${CP_TH["$t"]["colours"]}" ] &&
	[ "$DT_GLYPH" = "${CP_TH["$t"]["wallpaper"]}" ] &&
	[ "$DT_WALLIMG" = "${CP_TH["$t"]["image"]}" ] &&
	[ "$DT_WALLMODE" = "${CP_TH["$t"]["mode"]}" ] &&
	[ "$DT_FRAME" = "${CP_TH["$t"]["frame"]}" ] &&
	[ "$DT_TITLEBAR" = "${CP_TH["$t"]["titlebar"]}" ] &&
	[ "$DT_BTNSTYLE" = "${CP_TH["$t"]["buttons"]}" ] &&
	[ "$DT_TREESTYLE" = "${CP_TH["$t"]["tree"]}" ] &&
	[ "$DT_TREELINES" = "${CP_TH["$t"]["treelines"]}" ] &&
	[ "$l" = "${CP_TH["$t"]["layout"]}" ] &&
	[ "$DT_TITLEALIGN" = "${CP_TH["$t"]["align"]}" ] &&
	[ "$DT_CHECKS" = "${CP_TH["$t"]["checks"]}" ] &&
	[ "$DT_DLGBTN" = "${CP_TH["$t"]["dialog"]}" ] &&
	[ "$DT_GLYPHSET" = "${CP_TH["$t"]["glyphs"]}" ] &&
	[ "$DT_SHADOW" = "${CP_TH["$t"]["windowshadow"]}" ] &&
	[ "$DT_MSHADOW" = "${CP_TH["$t"]["menushadow"]}" ] &&
	[ "$DT_BARSHADOW" = "${CP_TH["$t"]["barshadow"]}" ] &&
	[ "$DT_BTNSHADOW" = "${CP_TH["$t"]["buttonshadow"]}" ] &&
	[ "$DT_SHADOWSHAPE" = "${CP_TH["$t"]["shadowshape"]}" ] &&
	[ "${DT_WINTRANS:-0}" = "${CP_TH["$t"]["wintrans"]}" ] &&
	[ "${DT_BARTRANS:-0}" = "${CP_TH["$t"]["bartrans"]}" ]
}

# Whether a theme is one of the person's own, which can be renamed and
# deleted; a bundled one cannot.
fn cp_themeown(t) {
	[ -n "$t" ] && [ -f "${CP_THEMEDIRS[0]}/$t.json" ]
}

# The Theme row's buttons: Save when the look is no longer the theme's,
# Rename and Delete for a theme of the person's own.
cp_themebtns() {
	local b=

	cp_lookis "$CP_THEME" || b="themesave:Save"
	cp_themeown "$CP_THEME" && b+=" themerename:Rename themedel:Delete"
	ret "${b# }"
}

# Rename a theme of the person's own: a new name, asked with the file
# dialog in the same folder.
cp_themerename() {
	cp_themeown "$CP_THEME" || return 0
	dt_filepick save "Rename Theme" "Themes:*.json" "${CP_THEMEDIRS[0]}" "$CP_THEME.json" cp_themerenamed ""
}
fn cp_themerenamed(id = "", path = "", type = "") {
	local n old="${CP_THEMEDIRS[0]}/$CP_THEME.json"

	[ -n "$path" ] || return 0
	[[ $path == *.json ]] || path+=.json
	n=${path##*/}
	n=${n%.json}
	[ -n "$n" ] && [ -z "${n//[A-Za-z0-9._ -]/}" ] || { dt_notep high "A theme's name is letters, digits, spaces, dots and dashes"; return 1; }
	[ "$path" = "$old" ] && return 0
	if [ -e "$path" ]; then
		dt_notep high "There is a theme called %s already" "$n"
		return 1
	fi
	command mv -- "$old" "$path" 2> /dev/null || { dt_notep high "Could not rename %s" "$CP_THEME"; return 1; }
	cp_themes
	dt_set CP_THEME "$n"
	dt_notep low "Renamed the theme to %s" "$n"
}

# Delete a theme of the person's own, after asking. A bundled theme of the
# same name, which theirs replaced, is back afterwards.
cp_themedelask() {
	cp_themeown "$CP_THEME" || return 0
	DT_T := dt_tr "Delete the theme %s? The look stays as it is now." "$CP_THEME"
	dt_confirm "$DT_T" cp_themedel
}
cp_themedel() {
	local n=$CP_THEME

	cp_themeown "$n" || return 0
	command rm -f -- "${CP_THEMEDIRS[0]}/$n.json"
	cp_themes
	if [ -z "${CP_TH["$n"]["colours"]+x}" ]; then
		dt_set CP_THEME ""
	fi
	dt_notep low "Deleted the theme %s" "$n"
}

# A tree's own marks: a look, which is why they are here beside the
# theme and the glyph set rather than under Windows, where they first
# went. A theme carries them too (`tree`, `treelines`), the same as it
# carries the window buttons.
fn cp_set_treestyle(int? id = "", value = "") { dt_set DT_TREESTYLE "$value"; }
fn cp_set_treelines(int? id = "", value = "") {
	case $value in 0) ;; *) value=1 ;; esac
	dt_set DT_TREELINES "$value"
}
CP_TREELINES=(1 0)
fn cp_treelinename(v) {
	case $v in 0) ret "Off" ;; *) ret "On" ;; esac
}

fn appearance_rows(int w) {
	local n=0 g b v

	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Look"; n=$((n + 1))
	# A look that is no theme's is "(your own)", which no theme is called,
	# so none in the list is ticked.
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Theme"; CP[$w][$n]["key"]=theme
	cp_choice "$w" "$n" "${CP_THEME:-(your own)}" cp_set_theme "${CP_THEMES[@]}"
	b := cp_themebtns
	CP[$w][$n]["btns"]=$b
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Colours"; CP[$w][$n]["key"]=colours
	cp_choice "$w" "$n" "$CP_COLOURS" cp_set_colours "${CP_COLOURLIST[@]}"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Glyphs"; CP[$w][$n]["key"]=glyphset
	cp_choice "$w" "$n" "$DT_GLYPHSET" cp_set_glyphset "${DT_GLYPHSETS[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tree Style"; CP[$w][$n]["key"]=treestyle
	cp_choice "$w" "$n" "$DT_TREESTYLE" cp_set_treestyle "${DT_TREESTYLES[@]}"
	n=$((n + 1))
	v=1
	[ "$DT_TREELINES" = 0 ] && v=0
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tree Rules"; CP[$w][$n]["key"]=treelines
	cp_choice "$w" "$n" "$v" cp_set_treelines "${CP_TREELINES[@]}"
	CP[$w][$n]["vname"]=cp_treelinename
	n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Shadows"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Windows"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_SHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_SHADOW; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menus"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_MSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_MSHADOW; n=$((n + 1))
	v=half
	case $DT_SHADOWSHAPE in cols | thin) v=$DT_SHADOWSHAPE ;; esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Shadow Shape"; CP[$w][$n]["key"]=shadowshape
	cp_choice "$w" "$n" "$v" cp_set_shadowshape "${CP_SHADOWV[@]}"
	CP[$w][$n]["vname"]=cp_shadowname; n=$((n + 1))
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Controls"; n=$((n + 1))
	# Blit's icons, wherever Blit's glyph set is what draws them.
	if [ "$DT_GLYPHSET" = blit ]; then
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Menu Bar Icons"; CP[$w][$n]["key"]=baricon
		cp_choice "$w" "$n" "$DT_BARICON" cp_set_baricon "${DT_ICONPENS[@]}"; n=$((n + 1))
		CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Desktop and Files Icons"; CP[$w][$n]["key"]=deskicon
		cp_choice "$w" "$n" "$DT_DESKICON" cp_set_deskicon "${DT_ICONPENS[@]}"; n=$((n + 1))
	fi
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Checkboxes"; CP[$w][$n]["key"]=checks
	cp_choice "$w" "$n" "$DT_CHECKS" cp_set_checks "${CP_CHECKS[@]}"
	CP[$w][$n]["dims"] := dt_chromeoff "${CP_CHECKS[@]}"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Dialog Buttons"; CP[$w][$n]["key"]=dlgbtn
	cp_choice "$w" "$n" "$DT_DLGBTN" cp_set_dlgbtn "${DT_DLGBTNS[@]}"
	CP[$w][$n]["dims"] := dt_chromeoff "${DT_DLGBTNS[@]}"
	CP[$w][$n]["vname"]=dt_chromename; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Button Shadow"
	CP[$w][$n]["wtype"]=bool
	CP[$w][$n]["val"]=off; [ "$DT_BTNSHADOW" = 1 ] && CP[$w][$n]["val"]=on
	CP[$w][$n]["key"]=DT_BTNSHADOW; n=$((n + 1))
	# Whether programs are told the desktop is light or dark (wm/appmode).
	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Programs"; n=$((n + 1))
	v=follow
	case $DT_APPMODE in light | dark) v=$DT_APPMODE ;; esac
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Light or Dark"; CP[$w][$n]["key"]=appmode
	cp_choice "$w" "$n" "$v" cp_set_appmode "${CP_APPMODEV[@]}"
	CP[$w][$n]["vname"]=cp_appmodename; n=$((n + 1))
	ret "$n"
}

# Light or Dark's choices, as the row shows them and as DT_APPMODE keeps
# them.
CP_APPMODEV=(follow light dark)

fn cp_appmodename(v) {
	case $v in
	light) ret "Light" ;;
	dark) ret "Dark" ;;
	*) ret "Follow the Desktop" ;;
	esac
}

fn cp_set_appmode(int? id = "", value = "") {
	case $value in
	light | dark) ;;
	*) value=follow ;;
	esac
	dt_set DT_APPMODE "$value"
	dt_want 30
}

# Save, Rename and Delete from the keyboard, on the Theme row: s, r, d.
fn appearance_key(int w, key) {
	local i=${PW[$w]["sel"]} b

	[ "${CP[$w][$i]["key"]}" = theme ] || return 1
	b=" ${CP[$w][$i]["btns"]} "
	case $key in
	s) [[ $b == *" themesave:"* ]] || return 1; cp_themesave ;;
	r) [[ $b == *" themerename:"* ]] || return 1; cp_themerename ;;
	d) [[ $b == *" themedel:"* ]] || return 1; cp_themedelask ;;
	*) return 1 ;;
	esac
	return 0
}

fn appearance_do(int w, k, int dir) {
	case $k in
	themesave) cp_themesave; return 0 ;;
	themerename) cp_themerename; return 0 ;;
	themedel) cp_themedelask; return 0 ;;
	DT_SHADOW | DT_MSHADOW | DT_BTNSHADOW) cp_toggle "$k" ;;
	esac
}


fn cp_set_dlgbtn(int? id = "", value = "") { dt_set DT_DLGBTN "$value"; }

# Shadow Shape's choices, as the row shows them and as DT_SHADOWSHAPE keeps
# them (Gitea #340).
CP_SHADOWV=("${DT_SHADOWSHAPES[@]}")
fn cp_shadowname(v) {
	[ "$v" = cols ] && { ret "Two Columns"; return 0; }
	[ "$v" = thin ] && { ret "Thin"; return 0; }
	ret "Half Block"
}

fn cp_set_shadowshape(int? id = "", value = "") {
	dt_set DT_SHADOWSHAPE "$value"
}

# The glyph set takes effect at once: every name in GL, and the frames.
fn cp_set_glyphset(int? id = "", value = "") {
	dt_set DT_GLYPHSET "$value"
}
