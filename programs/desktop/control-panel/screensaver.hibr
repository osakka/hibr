#!/usr/bin/env hibr
#
# screensaver -- the Control Panel pane for the screen saver
# (wm/saver.hibr): which one, or one at random, how many idle minutes
# before it starts, whether it locks the screen (wm/lock.hibr) once it has
# run a while, and a look at it now.

strict


app screensaver "The Control Panel pane for the screen saver" 1.1.1
command -v cp_pane > /dev/null && cp_pane screensaver "Screen Saver" "◌"

SS_IDLES=(0 1 2 5 10 15 30 60)
SS_LOCKS=(never 0 1 2 5 10 15 30 60)
SS_LOCKWHERE=(primary every)
SS_NAMES=()

# The choices: random, then every saver there is.
ss_names() {
	SS_NAMES=(random)
	dt_has dt_saverload || return 0
	dt_saverload
	SS_NAMES+=("${SV_LIST[@]}")
}

fn cp_set_saver(int? id = "", value = "") { dt_set DT_SAVER "$value"; }
fn cp_set_saveridle(int? id = "", int value = 0) { dt_set DT_SAVERIDLE "$value"; }

# The minutes in words: none is never, for the saver; for the lock none is
# never and nought is at once.
fn ss_idlename(v) {
	[ "$v" = 0 ] && { ret never; return 0; }
	ret "$v"
}
fn ss_lockname(v) {
	[ "$v" = 0 ] && { ret "at once"; return 0; }
	ret "$v"
}

fn cp_set_lockwhere(int? id = "", value = "") { dt_set DT_LOCKWHERE "$value"; }

fn cp_set_saverlock(int? id = "", value = "") {
	[ "$value" = never ] && value=
	dt_set DT_LOCKAFTER "$value"
}

fn screensaver_rows(int w) {
	local n=0

	dt_has dt_saverstart || { cp_absent "$w" "The screen saver"; ret 1; }
	ss_names
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Screen Saver"; CP[$w][$n]["key"]=saver
	cp_choice "$w" "$n" "$DT_SAVER" cp_set_saver "${SS_NAMES[@]}"; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Start After (minutes)"; CP[$w][$n]["key"]=idle
	cp_choice "$w" "$n" "${DT_SAVERIDLE:-0}" cp_set_saveridle "${SS_IDLES[@]}"
	CP[$w][$n]["vname"]=ss_idlename; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Lock After (minutes)"; CP[$w][$n]["key"]=lock
	cp_choice "$w" "$n" "${DT_LOCKAFTER:-never}" cp_set_saverlock "${SS_LOCKS[@]}"
	CP[$w][$n]["vname"]=ss_lockname; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Password Box On"; CP[$w][$n]["key"]=lockwhere
	cp_choice "$w" "$n" "${DT_LOCKWHERE:-primary}" cp_set_lockwhere "${SS_LOCKWHERE[@]}"
	n=$((n + 1))
	CP[$w][$n]["kind"]=action; CP[$w][$n]["text"]="Preview"
	CP[$w][$n]["val"]=""; CP[$w][$n]["key"]=preview; n=$((n + 1))
	ret "$n"
}

fn screensaver_do(int? w = "", k = "", int? dir = "") {
	case $k in
	preview) dt_saverstart preview ;;
	esac
}

