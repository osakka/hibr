#!/usr/bin/env hibr
#
# windows -- the Control Panel pane for how a window looks and where a new
# one goes: its frame, where its title sits, which glyphs the buttons are
# drawn with, the Title Bar Buttons list -- each button on or off, and on
# which side of the title -- Placement, what Zoom fills
# -- the window's own display or every display (Gitea #286) -- and how wide
# a tiled workspace's main window is. How the mouse moves, resizes and double-clicks one is the
# Mouse pane's. Every value here is read by wm/frame.hibr; this pane only
# ever changes the DT_* settings, never the drawing itself.

strict


app windows "The Control Panel pane for how a window looks and where it opens" 1.8
command -v cp_pane > /dev/null && cp_pane windows "Windows" "▭"

fn cp_set_frame(int? id = "", value = "") { DT_FRAME=$value; cp_save; }
fn cp_set_titlebar(int? id = "", value = "") { DT_TITLEBAR=$value; cp_save; }
fn cp_set_align(int? id = "", value = "") { DT_TITLEALIGN=$value; cp_save; }
fn cp_set_btnstyle(int? id = "", value = "") { DT_BTNSTYLE=$value; cp_save; }
fn cp_set_place(int? id = "", value = "") { DT_PLACE=$value; cp_save; }
fn cp_set_zoomfill(int? id = "", value = "") { DT_ZOOMFILL=$value; cp_save; }
fn cp_set_fullend(int? id = "", value = "") { DT_FULLEND=$value; cp_save; }
# How much of a picture wallpaper shows through a window, in tens.
fn cp_wintrans(int v) {
	[ "$v" -lt 0 ] && v=0
	[ "$v" -gt 100 ] && v=100
	DT_WINTRANS=$(((v + 5) / 10 * 10))
	cp_save
	return 0
}

fn windows_rows(int w) {
	local n=0 v

	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Frame"
	CP[$w][$n]["val"]="$DT_FRAME"; CP[$w][$n]["key"]=frame; n=$((n + 1))
	v := dt_chromename "$DT_TITLEBAR"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Title Bar"
	CP[$w][$n]["val"]="$v"; CP[$w][$n]["key"]=titlebar; n=$((n + 1))
	v := dt_chromename "$DT_BTNSTYLE"
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Window Buttons"
	CP[$w][$n]["val"]="$v"; CP[$w][$n]["key"]=btnstyle
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Title"
	CP[$w][$n]["val"]="$DT_TITLEALIGN"; CP[$w][$n]["key"]=align
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="See Through"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]="${DT_WINTRANS:-0}"
	CP[$w][$n]["min"]=0; CP[$w][$n]["max"]=100
	CP[$w][$n]["after"]="(${DT_WINTRANS:-0}%)"
	CP[$w][$n]["key"]=wintrans; n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Placement"
	CP[$w][$n]["val"]="$DT_PLACE"; CP[$w][$n]["key"]=place
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Zoom Fills"
	CP[$w][$n]["val"]="$DT_ZOOMFILL"; CP[$w][$n]["key"]=zoomfill
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Full Screen Ends"
	CP[$w][$n]["val"]="$DT_FULLEND"; CP[$w][$n]["key"]=fullend
	n=$((n + 1))
	CP[$w][$n]["kind"]=set; CP[$w][$n]["text"]="Tiled Main"
	CP[$w][$n]["after"]="($DT_TILEMAIN%)"
	CP[$w][$n]["wtype"]=slider
	CP[$w][$n]["val"]=$((DT_TILEMAIN / 10)); CP[$w][$n]["min"]=3
	CP[$w][$n]["max"]=7
	CP[$w][$n]["key"]=tilemain; n=$((n + 1))
	n := windows_btnrows "$w" "$n"
	ret "$n"
}

# The Title Bar Buttons list, from row n: a switch for each button in
# DT_BTNORDER's order, and the Title row between them, which is what says
# left from right.
fn windows_btnrows(int w, int n) {
	local k t

	CP[$w][$n]["kind"]=head; CP[$w][$n]["text"]="Title Bar Buttons"
	n=$((n + 1))
	dt_btnlist
	for k in "${DT_BTNL[@]}"; do
		CP[$w][$n]["ord"]=btn; CP[$w][$n]["oname"]=$k
		CP[$w][$n]["key"]="wbtn:$k"
		if [ "$k" = title ]; then
			CP[$w][$n]["kind"]=action
			CP[$w][$n]["text"]="Title (Left Above, Right Below)"
			CP[$w][$n]["val"]=""
			n=$((n + 1))
			continue
		fi
		CP[$w][$n]["kind"]=set; CP[$w][$n]["wtype"]=bool
		case $k in
		close) CP[$w][$n]["text"]="Close" ;;
		shade) CP[$w][$n]["text"]="Shade" ;;
		max) CP[$w][$n]["text"]="Zoom" ;;
		min) CP[$w][$n]["text"]="Minimise" ;;
		full) CP[$w][$n]["text"]="Full Screen" ;;
		sticky) CP[$w][$n]["text"]="Sticky" ;;
		esac
		CP[$w][$n]["val"]=on
		dt_btnhidden "$k" && CP[$w][$n]["val"]=off
		n=$((n + 1))
	done
	CP[$w][$n]["kind"]=info
	CP[$w][$n]["text"]="Drag, or Shift and an arrow"
	n=$((n + 1))
	ret "$n"
}

# One button of the list on or off.
fn windows_btntoggle(k) {
	local x out=
	local -a a

	read -ra a <<< "$DT_BTNON"
	for x in "${a[@]}"; do
		[ "$x" = "$k" ] || out+="${out:+ }$x"
	done
	dt_btnhidden "$k" && out+="${out:+ }$k"
	DT_BTNON=$out
}

# The list's new order, from a drag or shift and an arrow.
fn windows_order(int w, g, ...names) {
	DT_BTNORDER="${names[*]}"
	cp_save
}

fn windows_do(int w, k, int dir) {
	local v fl
	local -a fa

	case $k in
	frame) fl := dt_chromeavail "${WS_FRAMES[@]}"
	       DT_POPDIMNEXT=()
	       read -ra fa <<< "$fl"
	       v := cp_next "$DT_FRAME" "$dir" "${fa[@]}"
	       DT_FRAME=$v ;;
	titlebar) fl := dt_chromeavail "${DT_TITLEBARS[@]}"
	          DT_POPDIMNEXT=()
	          read -ra fa <<< "$fl"
	          v := cp_next "$DT_TITLEBAR" "$dir" "${fa[@]}"
	          DT_TITLEBAR=$v ;;
	align) v := cp_next "$DT_TITLEALIGN" "$dir" "${WS_ALIGNS[@]}"
	       DT_TITLEALIGN=$v ;;
	btnstyle) fl := dt_chromeavail "${WS_STYLES[@]}"
	          DT_POPDIMNEXT=()
	          read -ra fa <<< "$fl"
	          v := cp_next "$DT_BTNSTYLE" "$dir" "${fa[@]}"
	          DT_BTNSTYLE=$v ;;
	place) v := cp_next "$DT_PLACE" "$dir" "${DT_PLACES[@]}"
	       DT_PLACE=$v ;;
	zoomfill) v := cp_next "$DT_ZOOMFILL" "$dir" "${DT_ZOOMFILLS[@]}"
	          DT_ZOOMFILL=$v ;;
	fullend) v := cp_next "$DT_FULLEND" "$dir" "${DT_FULLENDS[@]}"
	         DT_FULLEND=$v ;;
	wbtn:title) return 0 ;;
	wbtn:*) windows_btntoggle "${k#wbtn:}" ;;
	wintrans) cp_wintrans $(((${DT_WINTRANS:-0} + 5) / 10 * 10 + dir * 10))
		return 0 ;;
	tilemain)
		v=$((DT_TILEMAIN + dir * 10))
		[ "$v" -lt 30 ] && v=30
		[ "$v" -gt 70 ] && v=70
		DT_TILEMAIN=$v
		dt_tile
		;;
	esac
	cp_save
}

# The tiled main pane's share, set where its track is clicked. Its own
# value is in tens, which is why this multiplies: the track has eleven
# positions and this setting has five.
fn windows_slide(int w, k, int value) {
	case $k in
	wintrans) cp_wintrans "$value" ;;
	tilemain)
		DT_TILEMAIN=$((value * 10))
		[ "$DT_TILEMAIN" -lt 30 ] && DT_TILEMAIN=30
		[ "$DT_TILEMAIN" -gt 70 ] && DT_TILEMAIN=70
		dt_tile
		cp_save
		;;
	esac
	return 0
}

fn windows_drop(int w, int r, int c, k) {
	case $k in
	frame) dt_chromeavail "${WS_FRAMES[@]}"
	       dt_droplist "$w" "$r" "$c" cp_set_frame "${WS_FRAMES[@]}" ;;
	titlebar) dt_chromeavail "${DT_TITLEBARS[@]}"
	          DT_POPNAMENEXT=dt_chromename
	          dt_droplist "$w" "$r" "$c" cp_set_titlebar "${DT_TITLEBARS[@]}" ;;
	place) dt_droplist "$w" "$r" "$c" cp_set_place "${DT_PLACES[@]}" ;;
	zoomfill) dt_droplist "$w" "$r" "$c" cp_set_zoomfill "${DT_ZOOMFILLS[@]}" ;;
	fullend) dt_droplist "$w" "$r" "$c" cp_set_fullend "${DT_FULLENDS[@]}" ;;
	align) dt_droplist "$w" "$r" "$c" cp_set_align "${WS_ALIGNS[@]}" ;;
	btnstyle) dt_chromeavail "${WS_STYLES[@]}"
		DT_POPNAMENEXT=dt_chromename
		dt_droplist "$w" "$r" "$c" cp_set_btnstyle "${WS_STYLES[@]}" ;;
	esac
}
