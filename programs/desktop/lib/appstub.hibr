#!/usr/bin/env hibr
#
# appstub -- what a hosted app's terminal window runs (wm/isolate.hibr): it
# asks the desktop's app host, over its socket, to fork a copy of itself
# onto this terminal for one app, and lives exactly as long as that copy.
# The host has parsed the window manager once; each app is a fork of it, so
# what it parsed is shared rather than parsed again (ADR 0050). This script
# parses almost nothing itself.
#
#   hibr appstub.hibr SOCKET APPFILE PREFIX TITLE ACKFILE

as_sock=$1
as_file=$2
as_prefix=$3
as_title=$4
as_ack=$5
as_tty := tty
# The host may still be starting -- it parses the window manager first --
# so its socket is waited for, a tenth of a second at a time, for five.
as_z=
for ((as_try = 0; as_try < 50; as_try++)); do
	exec {as_e}>&2 2> /dev/null
	exec {as_z}<> "/dev/unix/$as_sock"
	exec 2>&$as_e {as_e}>&-
	[ -n "$as_z" ] && break
	sleep 0.1
done
[ -n "$as_z" ] || { echo "appstub: no app host at $as_sock" >&2; exit 1; }
printf '%s\t%s\t%s\t%s\t%s\n' "$as_tty" "$as_file" "$as_prefix" "$as_title" "$as_ack" >&$as_z
as_pid=
read -r as_pid <&$as_z || exit 1
# This terminal's resizes and hangups are the app's: it is not this
# terminal's session, so the kernel tells this process and not it.
trap 'kill -WINCH "$as_pid" 2> /dev/null' WINCH
trap 'kill -HUP "$as_pid" 2> /dev/null; exit 0' HUP TERM
while :; do
	read -r as_l <&$as_z
	as_st=$?
	[ "$as_st" -gt 128 ] && continue
	[ "$as_st" = 0 ] || break
done
exit 0
