#!/usr/bin/env hibr
#
# apphost -- apps run by a desktop of their own, in processes of their own,
# for another desktop to show in windows (wm/isolate.hibr, ADR 0050's
# prototype). Started by the desktop; nothing here is for a person to run.
#
#   hibr apphost.hibr APPFILE PREFIX TITLE ACKFILE
#       one app, this process, on the terminal it was started on
#   hibr apphost.hibr --zygote SOCKET PARENTPID
#       the window manager parsed once, then a fork of this process for
#       each app asked for on SOCKET (lib/appstub.hibr asks) -- so what was
#       parsed is shared by every app rather than parsed again for each;
#       gone when the desktop PARENTPID is

strict

declare -g HS_PID="" hs_sock="" hs_parent="" HS_LFD="" HS_C=""
# Everything that says this process is the real desktop, or is being
# watched by a harness, belongs to the desktop showing it.
unset HIBR_HOLD DT_SUPERVISED DT_RESTORE HIBR_TESTIDLE
DT_SUPERVISE=off
need console || exit 1
# The desktop's own folder, from the desktop that started this one: a path
# made from this file's place is only right in the shipped tree.
. "${DT_HERE:?the desktop that starts an app host says where it is}/desktop.hibr"
DT_HOSTED=1

# Run one app on this process's standard input and output, which are its
# terminal, until it ends.
hs_run() {
	local hs_file=$1 hs_prefix=$2 hs_title=$3 hs_ack=$4 hs_id hs_k hs_b
	local -a hs_before=("${DT_KEEP[@]}")

	# The app is sourced in here, so every name this function holds has
	# the hs_ prefix: an app's own top level would otherwise write into it.
	DT_HOSTACK=$hs_ack
	DT_HOSTTOK=${hs_ack##*/}
	. "$hs_file"
	# What the app keeps is what dt_keep added while it loaded: those go
	# up to the desktop showing it when it saves.
	for hs_k in "${DT_KEEP[@]}"; do
		for hs_b in "${hs_before[@]}"; do
			[ "$hs_b" = "$hs_k" ] && continue 2
		done
		DT_HOSTKEEPS+=("$hs_k")
		DT_HOSTKSENT["$hs_k"]=${!hs_k-}
	done
	dt_hostopen || return 1
	dt_log "isolated: hosting $hs_prefix, pid ${HS_PID:-$$}"
	hs_id := dt_new "$hs_title" 10 40 1 1 "$hs_prefix"
	DT_HOSTWIN=$hs_id
	dt_fullscreen "$hs_id" on
	dt_run
	console close
	return 0
}

# One app asked for on connection fd: the stub's terminal, the app, and
# this process's own pid sent back, which is how the stub forwards it a
# resize. The connection stays open for the app's life, so the stub ends
# when it does.
hs_child() {
	local fd=$1 line tty file prefix title ack fs ft

	read -r line <&$fd || exit 1
	IFS=$'\t' read -r tty file prefix title ack fs ft <<< "$line"
	# Pictures by descriptor to the desktop showing it, when it gave a
	# frame socket: kitty is then certain, and the console sends the
	# pixels there and only the placement down the terminal.
	if [ -n "$fs" ]; then
		export BLIT_FRAME_SOCKET=$fs BLIT_FRAME_TOKEN=$ft HIBR_GFX=kitty
	fi
	read -r HS_PID _ < /proc/self/stat
	printf '%s\n' "$HS_PID" >&$fd
	exec 0<> "$tty" 1>&0
	DT_HOSTCONN=$fd
	hs_run "$file" "$prefix" "$title" "$ack"
	exit 0
}

if [ "$1" = --zygote ]; then
	hs_sock=$2
	hs_parent=$3
	rm -f "$hs_sock" 2> /dev/null
	listen -b "$hs_sock" HS_LFD || exit 1
	printf '%s\n' "$$" > "$hs_sock.pid"
	dt_log "isolated: app host ready, pid $$, the window manager parsed once"
	while kill -0 "$hs_parent" 2> /dev/null; do
		accept -t 2 "$HS_LFD" HS_C || continue
		( exec {HS_LFD}>&-; hs_child "$HS_C" ) &
		exec {HS_C}>&-
	done
	rm -f "$hs_sock" "$hs_sock.pid" 2> /dev/null
	exit 0
fi
hs_run "$1" "$2" "$3" "$4"
