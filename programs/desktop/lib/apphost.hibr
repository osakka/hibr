#!/usr/bin/env hibr
#
# apphost -- apps run by a desktop of their own, in processes of their own,
# for another desktop to show in windows (wm/isolate.hibr, ADR 0050's
# prototype). Started by the desktop; nothing here is for a person to run.
#
#   hibr apphost.hibr APPFILE PREFIX TITLE ACKFILE
#       one app, this process, on the terminal it was started on
#   hibr apphost.hibr --zygote SOCKET PARENTPID
#       the window manager parsed once, then a fork of this process for
#       each app asked for on SOCKET (lib/appstub.hibr asks) -- so what was
#       parsed is shared by every app rather than parsed again for each;
#       gone when the desktop PARENTPID is

# Everything that says this process is the real desktop, or is being
# watched by a harness, belongs to the desktop showing it.
unset HIBR_HOLD DT_SUPERVISED DT_RESTORE HIBR_TESTIDLE
DT_SUPERVISE=off
need console || exit 1
. "${BASH_SOURCE%/*}/../desktop.hibr"
DT_HOSTED=1

# Run one app on this process's standard input and output, which are its
# terminal, until it ends.
hs_run() {
	local file=$1 prefix=$2 title=$3 ack=$4 id

	DT_HOSTACK=$ack
	. "$file"
	dt_hostopen || return 1
	dt_log "isolated: hosting $prefix, pid ${HS_PID:-$$}"
	id := dt_new "$title" 10 40 1 1 "$prefix"
	dt_fullscreen "$id" on
	dt_run
	console close
	return 0
}

# One app asked for on connection fd: the stub's terminal, the app, and
# this process's own pid sent back, which is how the stub forwards it a
# resize. The connection stays open for the app's life, so the stub ends
# when it does.
hs_child() {
	local fd=$1 line tty file prefix title ack

	read -r line <&$fd || exit 1
	IFS=$'\t' read -r tty file prefix title ack <<< "$line"
	read -r HS_PID _ < /proc/self/stat
	printf '%s\n' "$HS_PID" >&$fd
	exec 0<> "$tty" 1>&0
	hs_run "$file" "$prefix" "$title" "$ack"
	exit 0
}

if [ "$1" = --zygote ]; then
	hs_sock=$2
	hs_parent=$3
	rm -f "$hs_sock" 2> /dev/null
	listen -b "$hs_sock" HS_LFD || exit 1
	dt_log "isolated: app host ready, pid $$, the window manager parsed once"
	while kill -0 "$hs_parent" 2> /dev/null; do
		accept -t 2 "$HS_LFD" HS_C || continue
		( exec {HS_LFD}>&-; hs_child "$HS_C" ) &
		exec {HS_C}>&-
	done
	rm -f "$hs_sock" 2> /dev/null
	exit 0
fi
hs_run "$1" "$2" "$3" "$4"
