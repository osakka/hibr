#!/usr/bin/env hibr
#
# lib/ctl -- desktop ctl: ask a running desktop something, or have it do
# something, through its control socket (wm/ctl.hibr), and print the JSON
# it answers. The status is 0 for {"ok":true...}, 1 for an error the
# desktop gave, 2 when there is no desktop to ask.
#
#     desktop ctl displays
#     desktop ctl windows
#     desktop ctl session
#     desktop ctl move ID DISPLAY
#     desktop ctl resize ID HEIGHT WIDTH
#     desktop ctl focus ID
#     desktop ctl signedin
#     desktop ctl -j '{"op":"windows"}'
#
# Which desktop: --session NAME, else the held session this shell runs in,
# else "desktop"; --socket PATH names the socket itself.

strict

opt .             "talk to a running desktop's control socket"
opt -s --session  session str  "Which held session"
opt -S --socket   socket str   "The control socket itself"
opt -j --json     json str     "Send this request as it is"
args "$@"

fn ctl_num(v) {
	[[ $v =~ ^[0-9]+$ ]] && { ret "$v"; return 0; }
	echo "desktop ctl: $v is not a number" >&2
	exit 2
}

fn ctl_str(t) {
	t=${t//\\/\\\\}
	t=${t//\"/\\\"}
	ret "\"$t\""
}

req=$json
if [ -z "$req" ]; then
	op=${1-}
	case $op in
	displays | windows | session | rescan | state | signedin)
		req="{\"op\":\"$op\"}" ;;
	stats)
		case ${2-} in
		reset) req='{"op":"stats","reset":true}' ;;
		stop) req='{"op":"stats","stop":true}' ;;
		*) req='{"op":"stats"}' ;;
		esac
		;;
	move)
		[ $# -eq 3 ] || { echo "usage: desktop ctl move ID DISPLAY" >&2; exit 2; }
		i := ctl_num "$2"
		d := ctl_str "$3"
		req="{\"op\":\"move\",\"id\":$i,\"display\":$d}"
		;;
	resize)
		[ $# -eq 4 ] || { echo "usage: desktop ctl resize ID HEIGHT WIDTH" >&2; exit 2; }
		i := ctl_num "$2"
		h := ctl_num "$3"
		w := ctl_num "$4"
		req="{\"op\":\"resize\",\"id\":$i,\"h\":$h,\"w\":$w}"
		;;
	focus | raise)
		[ $# -eq 2 ] || { echo "usage: desktop ctl $op ID" >&2; exit 2; }
		i := ctl_num "$2"
		req="{\"op\":\"$op\",\"id\":$i}"
		;;
	*)
		echo "usage: desktop ctl displays|windows|session|rescan|state|signedin|stats [reset|stop]|move|resize|focus ..." >&2
		exit 2
		;;
	esac
fi
p=$socket
if [ -z "$p" ]; then
	n=$session
	[ -n "$n" ] || n=${HIBR_HOLD##*/}
	p=${TMPDIR:-/tmp}/hibr-ctl-$UID/${n:-desktop}.ctl
fi
fd=
# A desktop that is listening but no longer accepting -- wedged, or stopped
# mid-frame -- leaves a connect waiting for as long as anybody will wait, and
# `catalogue remove` asks this question before it removes an app, so it hung for
# two minutes on a desktop nothing was wrong with except that one (Gitea
# #180). The answer below is already bounded (`read -t 5`); this bounds the
# connect. It is exported rather than set as a prefix, because `exec` with
# only redirections takes an assignment prefix permanently anyway -- and the
# whole life of this client is one connect, so there is nothing else here for
# it to reach.
export HIBR_CONNTIMEO=${HIBR_CONNTIMEO:-2000}
if [ -S "$p" ]; then
	exec {err}>&2 2> /dev/null
	exec {fd}<>"/dev/unix/$p" || fd=
	exec 2>&"$err" {err}>&-
fi
if [ -z "$fd" ]; then
	# Two different things, and the socket file tells them apart as far as
	# anything here can: no file at all is "there is no desktop", while a
	# file nothing accepted on is either a desktop that has stopped
	# answering or a socket left behind by one that has gone. Saying which
	# would mean reading the connect's own errno, and the connection has to
	# land in *this* shell, so it cannot be captured from a subshell.
	if [ -S "$p" ]; then
		echo "desktop ctl: nothing accepted a connection at $p within ${HIBR_CONNTIMEO}ms -- the desktop there has stopped answering, or the socket is left over from one that has gone" >&2
	else
		echo "desktop ctl: no desktop is listening at $p" >&2
	fi
	nm=${p##*/}
	nm=${nm%.ctl}
	if need hold 2> /dev/null && hl=$(hold list 2> /dev/null) && [[ $'\n'$hl == *$'\n'"$nm"[[:space:]]* ]]; then
		echo "desktop ctl: session $nm is held and running, but has no control socket -- its reason is in the desktop's log (${XDG_STATE_HOME:-$HOME/.local/state}/hibr/desktop.log, lines starting 'desktop: control socket')" >&2
	fi
	exit 2
fi
send "$fd" "$req"
answer=
read -r -t 5 answer <&"$fd"
exec {fd}>&-
if [ -z "$answer" ]; then
	echo "desktop ctl: the desktop did not answer" >&2
	exit 2
fi
printf '%s\n' "$answer"
[[ $answer == '{"ok":true'* ]]
