#!/usr/bin/env hibr
#
# panel -- Control Panel: a picker of panes down the left, the selected
# pane's own content on the right, System 7's Control Panels folder shape.
# Each pane is an ordinary hibr file that registers itself with cp_pane;
# this file only hosts them and draws the window list, which is not a
# pane, just always there.
#
# Run on its own it does nothing -- there is no pane to show without a
# desktop around it, unlike calc or panel's own former self.
#
# platform: every Control Panel pane calls this file's cp_save, cp_next,
# cp_toggle and cp_absent, so it is part of the desktop and not something
# installed apart from it -- a copy at another version would be the
# framework every pane runs on, mismatched with the panes (Gitea #262).
# The catalogue refuses to publish a file that says this, and
# tests/deps.py treats what it defines as the desktop's own.

strict

app panel "Control Panel, a picker of panes, and the window list" 1.5

command -v dt_app > /dev/null && dt_app panel "Control Panel" 26 70 once "≡"

# Where to find panes beyond the bundled ones -- an array, so a session can
# add its own the same way DT_APPDIRS already works for apps. The bundled
# panes live in programs/desktop/control-panel and are added by the session that
# wants them, the same way programs/desktop/apps is added to DT_APPDIRS: nothing
# here reaches for them on its own.
cp_sysd=
command -v dt_sysdir > /dev/null && cp_sysd := dt_sysdir control-panel
# The machine's scope sits **above** the person's own: an app an
# administrator installed for everybody is authoritative and a user
# does not override it (ADR 0045). Only ~/.config, which is a file
# somebody wrote by hand rather than anything a catalogue placed,
# is read before it. Empty on a hibr with no system scope, and a
# scan already skips a folder that is not there.
CP_PANEDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/control-panel"
	${cp_sysd:+"$cp_sysd"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/control-panel")

declare -gA CP_PANES
CP_PANE_LIST=()
declare -gA CPSRC

# Register a pane: name, title, icon, and which group it is listed under --
# system (the default) for the desktop's own settings, app for one app's.
# A pane defines either <name>_rows
# (and usually <name>_do, and <name>_drop if any row is a dropdown) for
# the common row-list shape every pane below uses, or a body of its own --
# a world map does not fit two columns of text -- with <name>_draw id h w
# bx (bx is the body's own left column, since it shares the window with
# the pane list on its left) and <name>_click id row col, in the same
# w$id coordinates _draw used, no translation to undo. Either shape may
# also define <name>_key and, for the body shape, <name>_wheel. A body
# pane whose content needs more than a click -- something dragged on a
# canvas, not a row picked from a list -- also defines <name>_mouse id
# act button row col: press, drag and release, the same w$id coordinates
# and the same shape a window's own _mouse already has (displays.hibr's
# rectangles are the first to use it). Return 1 from a press to decline
# it -- panel_mouse then falls through to <name>_click for that same
# press, exactly as if _mouse did not exist; only a press it actually
# accepts (return 0) ever sees the drag or the release that follows it.
fn cp_pane(pane, title, icon, group = "system") {
	CP_PANES[$pane]["title"]="$title"
	CP_PANES[$pane]["icon"]="${icon:-◆}"
	CP_PANES[$pane]["group"]=$group
	CP_PANES[$pane]["src"]="${DT_LOADING-}"
	CP_PANE_LIST+=("$pane")
	dt_hookown "${pane}_"
}

# Load every pane in the folders, then sort the list -- the desktop's own
# panes first, then the apps', each by title without regard to case, the
# same trick dt_appnames uses -- so the picker's own order does not depend
# on load order or filenames, just on what a pane calls itself.
cp_panes() {
	local d f b l
	local -a all

	for d in "${CP_PANEDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			[ -n "${CPSRC["$b"]}" ] && continue
			CPSRC["$b"]=$f
			DT_LOADING=$f
			. "$f"
			DT_LOADING=
		done
	done
	for b in "${CP_PANE_LIST[@]}"; do
		l := str lower "${CP_PANES[$b]["title"]}"
		case ${CP_PANES[$b]["group"]} in
		hardware) all+=("0 $l	$b") ;;
		app) all+=("2 $l	$b") ;;
		*) all+=("1 $l	$b") ;;
		esac
	done
	arr sort all
	CP_PANE_LIST=()
	for l in "${all[@]}"; do CP_PANE_LIST+=("${l#*	}"); done
}

# Read the pane folders again, for dt_rescan (Gitea #267): a pane whose
# file has gone leaves the list, a new one joins it, and one whose file
# changed is marked rather than sourced again -- the same three answers
# the desktop gives for its apps, as "added removed changed". Each open
# Control Panel is put back on the pane it was showing, by name, because
# the list is sorted again and an index kept from before would name
# another pane.
cp_rescan() {
	local d f b w p i k before added gone=0 changed=0 t
	local -A win keep
	local -a list

	for w in "${!PW[@]}"; do
		keep["$w"] := panel_pane "$w"
	done
	for d in "${CP_PANEDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			[ -n "${win["$b"]}" ] || win["$b"]=$f
		done
	done
	for b in "${!CPSRC[@]}"; do
		f=${CPSRC["$b"]}
		w=${win["$b"]}
		if [ -z "$w" ]; then
			list=()
			for p in "${CP_PANE_LIST[@]}"; do
				if [ "${CP_PANES[$p]["src"]}" = "$f" ]; then
					for k in "${!CP_PANES[$p][@]}"; do
						CP_GONE[$p]["$k"]=${CP_PANES[$p]["$k"]}
					done
					unset CP_PANES["$p"]
				else
					list+=("$p")
				fi
			done
			CP_PANE_LIST=("${list[@]}")
			dt_unload "$f"
			CP_GONEB["$b"]=$f
			unset CPSRC["$b"]
			gone=$((gone + 1))
		elif [ "$w" != "$f" ] || dt_scanold "$f"; then
			[ -n "${DT_STALE["$f"]+x}" ] && continue
			t=
			for p in "${CP_PANE_LIST[@]}"; do
				[ "${CP_PANES[$p]["src"]}" = "$f" ] && t=${CP_PANES[$p]["title"]}
			done
			dt_stale "$f" "${t:-${b%.hibr}}"
			changed=$((changed + 1))
		fi
	done
	# A pane that went and is back is given its registration again and
	# marked, as dt_rescan does for an app, never sourced a second time.
	for b in "${!win[@]}"; do
		[ -z "${CPSRC["$b"]}" ] && [ -n "${CP_GONEB["$b"]}" ] || continue
		f=${CP_GONEB["$b"]}
		unset CP_GONEB["$b"]
		CPSRC["$b"]=$f
		t=
		for p in "${!CP_GONE[@]}"; do
			[ "${CP_GONE[$p]["src"]}" = "$f" ] || continue
			for k in "${!CP_GONE[$p][@]}"; do
				CP_PANES[$p]["$k"]=${CP_GONE[$p]["$k"]}
			done
			unset CP_GONE["$p"]
			CP_PANE_LIST+=("$p")
			t=${CP_PANES[$p]["title"]}
		done
		dt_reinstate "$f"
		dt_stale "$f" "${t:-${b%.hibr}}"
		changed=$((changed + 1))
	done
	before=${#CPSRC[@]}
	cp_panes
	added=$((${#CPSRC[@]} - before))
	for w in "${!keep[@]}"; do
		i=0
		for p in "${CP_PANE_LIST[@]}"; do
			if [ "$p" = "${keep["$w"]}" ]; then
				PW[$w]["pane"]=$i
				break
			fi
			i=$((i + 1))
		done
	done
	ret "$added $gone $changed"
}

# What cp_rescan kept of a pane whose file went, and that file's path.
declare -gA CP_GONE
declare -gA CP_GONEB

# How wide the pane list is, and how much is left for the selected pane's
# own content once the divider is taken out of it too. The divider can be
# dragged (widgets/split.hibr), and where it was left is kept.
CP_DIVCOL="${CP_DIVCOL-19}"
command -v dt_keep > /dev/null && dt_keep CP_DIVCOL

fn panel_open(int w, arg) {
	PW[$w]["pane"]=0
	PW[$w]["side"]=list
	PW[$w]["sel"]=0
	PW[$w]["top"]=0
	PW[$w]["vis"]=1
	PW[$w]["last"]=-1
	PW[$w]["ltop"]=0
	PW[$w]["lseen"]=-1
	[ -n "$arg" ] && panel_goto "$w" "$arg"
	return 0
}

# Show the pane named, as a click on it in the list would; one that is not
# there leaves the selection where it is.
fn panel_goto(int w, pane) {
	local i=0 n

	for n in "${CP_PANE_LIST[@]}"; do
		if [ "$n" = "$pane" ]; then
			PW[$w]["pane"]=$i
			PW[$w]["side"]=pane
			PW[$w]["sel"]=0
			PW[$w]["top"]=0
			PW[$w]["last"]=-1
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

# The selected pane's name, clamped to what is actually registered -- a
# pane can vanish between frames if whatever provided it stops (nothing
# does today, but the window list already assumes apps can close under it).
fn panel_pane(int w) {
	local i

	i=${PW[$w]["pane"]}
	[ "${#CP_PANE_LIST[@]}" -eq 0 ] && { ret ""; return 0; }
	[ "$i" -ge "${#CP_PANE_LIST[@]}" ] && i=0
	ret "${CP_PANE_LIST[$i]}"
}

# The panes a search finds, as their indices: a pane whose title has the
# text in it, or one with a row that does -- "wallpaper" finds Appearance.
# Worked out again only when the text changes, since asking every pane
# for its rows is not free; each pane's rows are built under a window id
# no window has, and thrown away.
fn panel_filter(int id) {
	local q i=0 n k t hit out= scratch=999999

	q := dt_searchq "$id"

	q=${q,,}
	[ "${PW[$id]["mq"]}" = "$q" ] && [ -n "${PW[$id]["mq"]+x}" ] && return 0
	PW[$id]["mq"]=$q
	PW[$id]["all"]=
	for n in "${CP_PANE_LIST[@]}"; do
		hit=0
		if [ -z "$q" ]; then
			hit=1
		else
			t=${CP_PANES[$n]["title"]}
			case $DT_LANG in ?*) t := dt_tr "$t" ;; esac
			[[ ${t,,} == *"$q"* ]] && hit=1
			if [ "$hit" = 0 ] && ! dt_has "${n}_draw" && dt_has "${n}_rows"; then
				unset "CP[$scratch]"
				k := dt_prefixfn "$n" rows "$scratch"
				CP_ROWOWNER[$scratch]=${DT_HOOKOWNER["${n}_"]-}
				while [ "$k" -gt 0 ]; do
					k=$((k - 1))
					cp_rowhas "$scratch" "$k" "$q" && { hit=1; break; }
				done
				unset "CP[$scratch]"
			fi
		fi
		[ "$hit" = 1 ] && out="$out $i"
		i=$((i + 1))
	done
	PW[$id]["m"]=${out# }
}

# Whether pane index i is among what the search found.
fn panel_shown(int id, int i) {
	[[ " ${PW[$id]["m"]} " == *" $i "* ]]
}

fn panel_draw(int id, int h, int w, int row, int col) {
	local i n r t lw side pane bx bw g sel at=0 lt vis on lx=0 dv srows ic iw
	local -a lines m

	dt_wclear "$id"
	lw := dt_split CP_DIVCOL "$w" 8
	PW[$id]["lw"]=$lw
	# Mirrored, the pane is first and the list after the divider, at the right.
	dv=$lw
	case $DT_MIRRORON in 1) dv=$((w - lw + 1)); lx=$dv ;; esac
	PW[$id]["dv"]=$dv
	PW[$id]["w"]=$w
	side=${PW[$id]["side"]}
	pane := panel_pane "$id"

	# The list is its rows -- a heading for each group, then its panes --
	# scrolled on its own, apart from the pane beside it: the selected
	# pane is brought into view when the selection moves, and otherwise
	# the wheel puts the list where it likes.
	panel_filter "$id"
	read -ra m <<< "${PW[$id]["m"]}"
	if [ "${#m[@]}" -gt 0 ] && ! panel_shown "$id" "${PW[$id]["pane"]}"; then
		PW[$id]["pane"]=${m[0]}
		PW[$id]["sel"]=0
		PW[$id]["top"]=0
		PW[$id]["last"]=-1
		pane := panel_pane "$id"
	fi
	# No box of its own: the search is the desktop's one search now
	# (widgets/search.hibr), drawn on this window's bottom row only
	# once `/` has asked for it, so the list keeps the row it used to
	# spend on a permanently empty `Search…`.
	srows := dt_searchrows "$id"
	# Drawn here rather than at the end: this function returns early
	# when nothing matches the search, and a search bar that vanishes
	# exactly when the search found nothing is the one moment it is
	# most needed.
	dt_searchdraw "$id" "$h" "$w"
	sel=${PW[$id]["pane"]}
	lt=${PW[$id]["ltop"]:-0}
	vis=$((h - srows))
	i=0
	g=
	for n in "${CP_PANE_LIST[@]}"; do
		if ! panel_shown "$id" "$i"; then
			i=$((i + 1))
			continue
		fi
		if [ "${CP_PANES[$n]["group"]}" != "$g" ]; then
			g=${CP_PANES[$n]["group"]}
			lines+=("h:$g")
		fi
		[ "$i" = "$sel" ] && at=${#lines[@]}
		lines+=("p:$i")
		i=$((i + 1))
	done
	if [ "$sel" != "${PW[$id]["lseen"]}" ]; then
		PW[$id]["lseen"]=$sel
		lt := dt_scrollfit "$lt" "${#lines[@]}" "$vis" "$at"
		# The first pane sits under a heading, so bringing its own
		# line into view would leave that heading above the top.
		[ "$sel" = 0 ] && lt=0
	else
		lt := dt_scrollfit "$lt" "${#lines[@]}" "$vis"
	fi
	PW[$id]["ltop"]=$lt
	PW[$id]["lvis"]=$vis
	PW[$id]["ln"]=${#lines[@]}
	r=1
	while [ "$r" -le $((h - srows)) ]; do
		t=${lines[$((lt + r - 1))]}
		case $t in
		h:*)
			console pen "$DT_DIM" "$DT_FACE" bold
			case ${t#h:} in
			hardware) t=Hardware ;;
			app) t=Apps ;;
			*) t=Desktop ;;
			esac
			t := str pad "$t" $((lw - 3))
			t=${t:0:$((lw - 3))}
			console put -p "w$id" "$r" $((lx + 2)) "$t"
			;;
		p:*)
			i=${t#p:}
			n=${CP_PANE_LIST[$i]}
			if [ "$n" = "$pane" ]; then
				if [ "$side" = list ]; then
					console pen "$DT_SELINK" "$DT_ACTIVE" bold
				else
					console pen "$DT_ACTIVE" "$DT_FACE" bold
				fi
			else
				dt_hotpen "$id" "pane:$i" "$DT_INK" "$DT_FACE"
			fi
			t=${CP_PANES[$n]["title"]}
			case $DT_LANG in ?*) t := dt_tr "$t" ;; esac
			# The icon a cell of its own and the name after it, so an
			# icon that is a letter of a right-to-left script cannot
			# turn the row round (Gitea #548).
			ic=${CP_PANES[$n]["icon"]}
			iw := str width "$ic"
			[ "$iw" -gt 0 ] || iw=1
			t := str pad "$t" $((lw - 5 - iw))
			t=${t:0:$((lw - 5 - iw))}
			console put -p "w$id" "$r" $((lx + 2)) " "
			console put -p "w$id" "$r" $((lx + 3)) "$ic"
			console put -p "w$id" "$r" $((lx + 3 + iw)) " $t"
			dt_wreg "$id" "$r" $((lx + 1)) $((lw - 1)) "pane:$i"
			;;
		*)
			console pen "$DT_INK" "$DT_FACE"
			t := str repeat " " "$lw"
			console put -p "w$id" "$r" "$lx" "$t"
			;;
		esac
		r=$((r + 1))
	done
	dt_splitbar "$id" "$dv" 1 "$h" "${PW[$id]["split"]:-0}"
	# The list's own bar, on the divider rather than over the list, so the
	# titles keep every column -- beside the rows the list draws, 1 to vis.
	# It started at row 2 from when the search sat above the list (0.99.4),
	# and went on doing so after the search moved below it, so its last
	# cell was the window's bottom border (Gitea #314).
	dt_scrollbar "$id" 1 "$dv" "$vis" "${#lines[@]}" "$vis" "$lt" list 1
	if [ "${#lines[@]}" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		t="Nothing found"
		console put -p "w$id" 2 $((lx + 2)) "${t:0:$((lw - 3))}"
		return 0
	fi

	[ -z "$pane" ] && return 0
	# A column clear on each side of the divider: the list keeps one
	# before it, and the pane starts one after it, rather than a heading
	# or a list in the pane touching the divider while the list stands
	# off it -- which read as the divider sitting a column too far right.
	bx=$((lw + 2))
	bw=$((w - lw - 2))
	case $DT_MIRRORON in 1) bx=2 ;; esac
	# A pane its own process drew here before goes when another is shown
	# (wm/rtkinds.hibr): one lookup for every other panel.
	[ -z "${DT_RVX["p$id"]+x}" ] || dt_rvpaneseen "$id" "$pane"
	if dt_has "${pane}_draw"; then
		dt_prefixfn "$pane" draw "$id" $((h - 1 - srows)) "$bw" "$bx"
	else
		cp_rowsdraw "$id" "$pane" $((h - 1 - srows)) "$bw" "$bx"
	fi
}

# A scrollbar held and dragged (Gitea #298): the pane list's, or the pane's.
fn panel_scroll(int id, key, int top) {
	case $key in
	list) PW[$id]["ltop"]=$top ;;
	body) PW[$id]["top"]=$top ;;
	esac
}

# Move the selection within the pane list, or within the selected pane's
# own rows, whichever has the arrows right now -- skipping headings in a
# row list, and wrapping at either end in the pane list, the way the hibr
# menu's own items already do.
fn panel_move(int w, int d) {
	local i n

	if [ "${PW[$w]["side"]}" = list ]; then
		n=${#CP_PANE_LIST[@]}
		[ "$n" -lt 1 ] && return 0
		[ -n "${PW[$w]["m"]}" ] || return 0
		i=${PW[$w]["pane"]}
		while :; do
			i=$(((i + d + n) % n))
			panel_shown "$w" "$i" && break
		done
		PW[$w]["pane"]=$i
		PW[$w]["sel"]=0
		PW[$w]["top"]=0
		PW[$w]["last"]=-1
		return 0
	fi
	cp_rowsmove "$w" "$d"
}

fn panel_find(int w) {
	dt_searchopen "$w"
	PW[$w]["side"]=list
	return 0
}

fn panel_key(int w, key) {
	local pane

	# The search first, wherever the keyboard is: `/` opens it and the
	# keys go into it while it is open, the same in this window as in
	# every other. It used to be type-to-find in the list -- any letter
	# added to a query -- which is a good picker and a seventh way of
	# searching, and the seventh was the problem.
	if dt_searchkey "$w" "$key"; then
		PW[$w]["side"]=list
		return 0
	fi
	if [ "${PW[$w]["side"]}" = list ]; then
		case $key in
		" " | tab | right | enter)
			[ -n "${PW[$w]["m"]}" ] && PW[$w]["side"]=pane ;;
		up) panel_move "$w" -1 ;;
		down) panel_move "$w" 1 ;;
		*) return 1 ;;
		esac
		return 0
	fi

	if [ "$key" = tab ]; then
		PW[$w]["side"]=list
		return 0
	fi

	pane := panel_pane "$w"
	if [ -n "$pane" ] && dt_has "${pane}_draw"; then
		if dt_has "${pane}_key"; then
			dt_prefixfn "$pane" key "$w" "$key"
			return $?
		fi
		return 1
	fi

	cp_rowskey "$w" "$pane" "$key"
}

# A click in the pane list selects a pane and moves focus there; a click
# in the selected pane's own body works the way it always did -- select,
# a second click (or enter) activates, and a click on a dropdown's own
# cell opens the real popup, through the pane's own <name>_drop.
# Whether column c of window w is in the pane list, on its side of the divider.
fn panel_inlist(int w, int c) {
	case $DT_MIRRORON in
	1) [ "$c" -gt "${PW[$w]["dv"]:-$CP_DIVCOL}" ] ;;
	*) [ "$c" -lt "${PW[$w]["lw"]:-$CP_DIVCOL}" ] ;;
	esac
}

fn panel_click(int w, int r, int c, btn = "") {
	local pane tag

	# Before the list/pane split, because the search bar runs the
	# window's whole width and a click on its right half is not a
	# click in the list.
	tag := dt_hit "$w" "$r" "$c"
	if [ "$tag" = dtsearch ]; then
		dt_searchopen "$w"
		PW[$w]["side"]=list
		return 0
	fi
	if panel_inlist "$w" "$c"; then
		tag := dt_hit "$w" "$r" "$c"
		case $tag in pane:*) ;; *) return 0 ;; esac
		PW[$w]["pane"]=${tag#pane:}
		PW[$w]["side"]=list
		PW[$w]["sel"]=0
		PW[$w]["top"]=0
		PW[$w]["last"]=-1
		return 0
	fi
	pane := panel_pane "$w"
	[ -z "$pane" ] && return 0
	PW[$w]["side"]=pane
	if dt_has "${pane}_draw"; then
		dt_has "${pane}_click" && dt_prefixfn "$pane" click "$w" "$r" "$c"
		return 0
	fi
	cp_rowsclick "$w" "$pane" "$r" "$c"
}

# Forward press/drag/release to whichever pane is selected, when it has
# its own _mouse -- for a pane whose content needs more than a click, a
# rectangle dragged on a canvas rather than a row picked from a list.
# dt_new wires up a window's own _mouse to take over every press for that
# window, ahead of the plain click path this file has always used, so
# without this an ordinary pane click would never reach panel_click again
# the moment any one pane defined _mouse. A press is only ever offered to
# the selected pane's own _mouse when it lands in the body, past the pane
# list's own column, and only while it accepts -- return 1 (a miss, not
# its own rectangle say) falls straight through to panel_click exactly as
# if _mouse did not exist, so an ordinary pane is untouched either way.
# Drag and release go only where a press was actually accepted, and only
# for the one window that accepted it -- CP_MDRAG is keyed by window id,
# never a bare global, for the same reason every other per-window pane
# state here is.
declare -gA CP_MDRAG

fn panel_mouse(int id, act, button, int r, int c, mods) {
	local pane

	if [ "${PW[$id]["split"]}" = 1 ]; then
		case $DT_MIRRORON in 1) c=$((${PW[$id]["w"]:-40} - c + 1)) ;; esac
		dt_splitmove CP_DIVCOL "$c" "${PW[$id]["w"]:-40}" 8
		if [ "$act" = release ]; then
			PW[$id]["split"]=
			cp_save
		fi
		return 0
	fi
	if [ "$act" = press ]; then
		CP_MDRAG[$id]=
		CP_MSLIDE[$id]=
		CP_MORD[$id]=
		if [ "$c" = "${PW[$id]["dv"]:-${PW[$id]["lw"]}}" ] && [ "$r" -ge 1 ]; then
			PW[$id]["split"]=1
			return 0
		fi
		# A press on a row that can be moved is held until it is known
		# whether it is a drag (widgets/rows.hibr).
		if ! panel_inlist "$id" "$c" && cp_rowspress "$id" "$r" "$c"; then
			return 0
		fi
		pane := panel_pane "$id"
		if ! panel_inlist "$id" "$c" && [ -n "$pane" ] &&
		   dt_has "${pane}_mouse" &&
		   dt_prefixfn "$pane" mouse "$id" press "$button" "$r" "$c"; then
			CP_MDRAG[$id]=$pane
			return 0
		fi
		panel_click "$id" "$r" "$c"
		return 0
	fi
	cp_rowsdrag "$id" "$act" "$r" "$c" && return 0
	pane=${CP_MDRAG[$id]}
	[ -n "$pane" ] && dt_prefixfn "$pane" mouse "$id" "$act" "$button" "$r" "$c"
	[ "$act" = release ] && CP_MDRAG[$id]=
}

fn panel_wheel(int? w = "", dir = "", int? r = "", int? c = "") {
	local top pane

	# Each side scrolls on its own, whichever the pointer is over.
	if [ -n "$c" ] && panel_inlist "$w" "$c"; then
		top=${PW[$w]["ltop"]:-0}
		top := dt_scrollmove "$dir" "$top" "${PW[$w]["ln"]:-0}" \
			"${PW[$w]["lvis"]:-1}" "$DT_SCROLLWHEEL" || return 0
		PW[$w]["ltop"]=$top
		return 0
	fi
	pane := panel_pane "$w"
	if [ -n "$pane" ] && dt_has "${pane}_draw"; then
		dt_has "${pane}_wheel" && dt_prefixfn "$pane" wheel "$w" "$dir"
		return 0
	fi
	cp_rowswheel "$w" "$dir"
}

# What it can show depends entirely on which panes got sourced before this
# ran, which is nothing at all for the bare file -- an honest answer, not
# a fabricated one, the same as calc's own CLI mode only working because
# arithmetic is self-contained here and this is not.
if [ -z "$DT_ROWS" ]; then
	if [ "${#CP_PANE_LIST[@]}" -eq 0 ]; then
		echo "no panes registered"
	else
		echo "panes: ${CP_PANE_LIST[*]}"
	fi
fi
