#!/usr/bin/env hibr
#
# catalogue -- Applications: the catalogue in a window. `apps` is the whole
# implementation and this is a window around it, the way the Vault
# accessory is a window around `vw` -- anything one can do the other can,
# because there is only one of them (Gitea #219).
#
# It reads `apps -j`, never the columns `apps` prints for a person: the
# command answers JSON for exactly this, so the window and the command
# read one answer instead of one parsing the other's layout. Parsing a
# layout is how a window comes to disagree with its own command.
#
# Every fetch is a **job**: `apps install` is seconds of network, and a
# desktop that stops drawing while it waits is a desktop that looks
# broken. The job writes its status to a file and the next frame picks it
# up, the shape wm/remote.hibr uses for transfers. Polled from `_draw`
# *and* `_idle`, because a window nobody is looking at still has a job
# running in it.

strict

app catalogue "The application catalogue: browse, install, update and remove" 2.0

# Not called "Applications": the hibr menu already has a submenu of that
# name -- every app you can open -- and two rows called the same thing on
# one menu is a menu nobody can learn.
command -v dt_app > /dev/null && dt_app catalogue "Catalogue" 24 88 once "⌘"

declare -gA CAT
CAT_JOBS=
# The detail pane's prose, wrapped into lines by catalogue_draw so it can
# be scrolled -- a list the drawing passes to itself, declared here
# because a strict file's globals are declared at file level.
CAT_DLINES=()
# Where the divider between the list and the detail sits, kept so it
# is where it was left. State rather than a choice anybody makes in
# the Control Panel, which is why it is named in 540-examples' own
# list of those beside CP_DIVCOL and DIA_SPLIT.
CAT_SPLIT="${CAT_SPLIT-}"
command -v dt_keep > /dev/null && dt_keep CAT_SPLIT
CAT_N=0
CAT_LIVE=0
CAT_READY=

# Somewhere for a job's output and status, once a session.
fn cat_ready() {
	[ -n "$CAT_READY" ] && return 0
	CAT_JOBS="${XDG_CACHE_HOME:-$HOME/.cache}/hibr/catalogue-jobs"
	command rm -rf -- "$CAT_JOBS" 2> /dev/null
	command mkdir -p -- "$CAT_JOBS" 2> /dev/null || return 1
	CAT_READY=1
	return 0
}

# Start one: the command runs in the background with its output and its
# errors in files of their own, and the next frame reads the status.
fn cat_job(int id, what, then, ...cmd) {
	local n

	cat_ready || { dt_note "Cannot make a folder for jobs"; return 1; }
	CAT_N=$((CAT_N + 1))
	n=$CAT_N
	CAT[$id]["job"]["$n"]["what"]=$what
	CAT[$id]["job"]["$n"]["then"]=$then
	(
		dt_jobname "apps:$what"
		"${cmd[@]}" > "$CAT_JOBS/$n.out" 2> "$CAT_JOBS/$n.err"
		printf '%s\n' "$?" > "$CAT_JOBS/$n.st"
	) &
	CAT_LIVE=$((CAT_LIVE + 1))
	CAT[$id]["busy"]=$what
	dt_want 120
	return 0
}

# Hand every finished job to its callback. Costs one test while none is
# running, which is the usual state.
fn cat_poll(int id) {
	local n st then what
	local -a done

	[ "$CAT_LIVE" -gt 0 ] || return 0
	# Ask for the frame that will look again. `cat_job` asks for one 120
	# ms out, and a job that is not finished by then would never be
	# collected: nothing else re-arms, so the window sits on "working"
	# for ever while its answer waits in a file. This is the trap this
	# desktop records about `dt_want` -- one frame is all it asks for --
	# and the condition here is sound, because it stops the moment
	# CAT_LIVE reaches zero rather than asking "am I the kind of thing
	# that sometimes needs a frame".
	dt_want 120
	for n in "${!CAT[$id]["job"][@]}"; do
		[ -s "$CAT_JOBS/$n.st" ] || continue
		read -r st < "$CAT_JOBS/$n.st"
		then=${CAT[$id]["job"]["$n"]["then"]}
		what=${CAT[$id]["job"]["$n"]["what"]}
		done+=("$n")
		CAT_LIVE=$((CAT_LIVE - 1))
		CAT[$id]["busy"]=
		# Marked done before the callback runs, or a callback that
		# starts the next job sees this one still live -- the trap
		# Mail's own poll was written with.
		unset CAT[$id]["job"]["$n"]
		"$then" "$id" "$st" "$n" "$what"
		dt_want 60
	done
	return 0
}

# What a job printed, and what it complained about.
fn cat_out(int n) {
	[ -r "$CAT_JOBS/$n.out" ] || { ret ""; return 0; }
	ret "$CAT_JOBS/$n.out"
}

fn cat_why(int n) {
	local l=

	[ -s "$CAT_JOBS/$n.err" ] && read -r l < "$CAT_JOBS/$n.err"
	l=${l#apps: }
	ret "${l:-it did not say why}"
}

# --- reading the catalogue -------------------------------------------

fn cat_reload(int id) {
	CAT[$id]["loading"]=1
	cat_job "$id" list cat_loaded catalogue list -j
	return 0
}

# The index as the command answered it. Every fact in its own field, so
# nothing here works out from a sentence what the command already knew.
fn cat_loaded(int id, int st, int n, what = "") {
	local f k i=0 why p
	local -A j

	CAT[$id]["loading"]=
	f := cat_out "$n"
	if [ "$st" != 0 ]; then
		why := cat_why "$n"
		CAT[$id]["err"]=$why
		CAT[$id]["n"]=0
		return 0
	fi
	# It succeeded and what came back is not JSON, which has one likely
	# cause worth naming: a `catalogue` older than this window, where
	# `-j` is not a flag and is read as the text to search for. Saying
	# "it did not say why" there is true and useless -- it said plenty,
	# just not in JSON. (The command was called `apps` until 0.99.195,
	# and one that old is exactly the case this message is for.)
	if [ -z "$f" ] || ! json parse j < "$f" 2> /dev/null; then
		CAT[$id]["err"] := dt_tr "The catalogue command did not answer JSON. It may be older than this window."
		CAT[$id]["n"]=0
		return 0
	fi
	CAT[$id]["err"]=
	# The kinds this window groups by are the kinds the answer holds,
	# in `apps`' own declared order when it sends one (`AP_KINDS`, in
	# `list -j` since 0.99.194). It keeps no list of its own to fall
	# behind -- which it did: `mods` arrived in `apps` in 0.99.191 and
	# could not be shown here until 0.99.194, because the list was
	# written out in two places and one of them was changed.
	#
	# An older `apps` sends no `kinds`, and the fallback is the
	# entries themselves, first seen first shown. That is the same set
	# -- a kind with nothing in it is left out of the rows either way
	# -- so all the declared order buys is that the groups come in the
	# order the catalogue's own page uses rather than the index's.
	# Deriving it is what makes an old `apps` show a list rather than
	# an empty window with no error in it.
	CAT_KINDS=()
	for k in "${!j["kinds"][@]}"; do
		CAT_KINDS+=("$k")
	done
	for k in "${!j["entries"][@]}"; do
		CAT[$id]["e"][$i]["id"]=${j["entries"]["$k"]["id"]}
		CAT[$id]["e"][$i]["name"]=${j["entries"]["$k"]["name"]}
		CAT[$id]["e"][$i]["title"]=${j["entries"]["$k"]["title"]}
		CAT[$id]["e"][$i]["version"]=${j["entries"]["$k"]["version"]}
		CAT[$id]["e"][$i]["installed"]=${j["entries"]["$k"]["installed"]}
		# Where it is, which is not the same question as whether the
		# catalogue placed it: the shipped package is nobody's
		# install, so this window drew an unticked row for four
		# themes and twelve colours that were on disk (Gitea #254).
		# Empty from a catalogue older than 0.99.212, which then
		# behaves exactly as it did.
		CAT[$id]["e"][$i]["where"]=${j["entries"]["$k"]["where"]}
		CAT[$id]["e"][$i]["update"]=${j["entries"]["$k"]["update"]}
		CAT[$id]["e"][$i]["about"]=${j["entries"]["$k"]["about"]}
		CAT[$id]["e"][$i]["kind"]=${j["entries"]["$k"]["kind"]}
		# What the command has said in its own columns since
		# 0.99.197 and this window could not see, so a copy that can
		# never run looked exactly like a working one (Gitea #244).
		CAT[$id]["e"][$i]["defunct"]=${j["entries"]["$k"]["defunct"]}
		CAT[$id]["e"][$i]["shadows"]=${j["entries"]["$k"]["shadows"]}
		CAT[$id]["e"][$i]["np"]=${#j["entries"]["$k"]["parts"][@]}
		for p in "${!j["entries"]["$k"]["parts"][@]}"; do
			CAT[$id]["e"][$i]["parts"]["$p"]=${j["entries"]["$k"]["parts"]["$p"]}
		done
		i=$((i + 1))
	done
	CAT[$id]["n"]=$i
	cat_kindsfrom "$id"
	cat_filter "$id"
	cat_first "$id"
	return 0
}

# Onto the first entry rather than the first heading, so the detail pane
# has something in it: a pane that is blank until you press down reads as
# a pane that is broken. Asked when the window loads and again after
# every search, which is the same moment for the same reason -- a search
# that narrows to one app should show you that app.
fn cat_first(int id) {
	if [ "${CAT[$id]["sel"]:-0}" = 0 ] && [ "${CAT[$id]["m"]:-0}" -gt 1 ] &&
	   [ "${CAT[$id]["r"][0]["t"]}" = kind ] &&
	   [ "${CAT[$id]["r"][1]["t"]}" = entry ]; then
		CAT[$id]["sel"]=1
	fi
	return 0
}

# The kinds the catalogue holds, in the order `apps` declares them --
# filled by cat_load from the answer, never written out here. What stays
# this window's own is what each kind is *called*, which is a word on a
# screen rather than a fact about the catalogue, and a kind added later
# shows under its own short name until somebody gives it one.
CAT_KINDS=()

# Any kind an entry claims that the answer's own list did not name, put
# on the end in the order they were read. This is the whole of what an
# `apps` too old to send `kinds` gets, and it is also the guard for the
# other direction: an index holding a kind the installed `apps` has
# never heard of would otherwise be fetched, counted and shown nowhere.
fn cat_kindsfrom(int id) {
	local i n k s seen

	n=${CAT[$id]["n"]:-0}
	i=0
	while [ "$i" -lt "$n" ]; do
		k=${CAT[$id]["e"][$i]["kind"]}
		i=$((i + 1))
		[ -n "$k" ] || continue
		seen=
		for s in "${CAT_KINDS[@]}"; do
			[ "$s" = "$k" ] && { seen=1; break; }
		done
		[ -n "$seen" ] || CAT_KINDS+=("$k")
	done
	return 0
}

fn cat_kindname(k) {
	case $k in
	apps) ret "Applications" ;;
	system) ret "Desktop" ;;
	control-panel) ret "Control Panel" ;;
	control-strip) ret "Control Strip" ;;
	savers) ret "Screen savers" ;;
	themes) ret "Themes" ;;
	colours) ret "Colour schemes" ;;
	lang) ret "Languages" ;;
	mods) ret "Modules" ;;
	*) ret "$k" ;;
	esac
}

# The rows on screen: a heading per kind that has anything, and the
# entries under it when it is open. Eighty-four in one flat list is a
# wall, and the kinds are the structure the catalogue already has.
#
# A search opens every kind that matches, because a match hidden inside a
# collapsed group is a search that answers "nothing" while holding
# something -- the one behaviour a tree must not have.
fn cat_filter(int id) {
	local i n q m=0 hay k ki shown
	local -a cnt

	n=${CAT[$id]["n"]:-0}
	q := dt_searchq "$id"
	CAT[$id]["shown"]=0
	for ki in "${!CAT_KINDS[@]}"; do
		k=${CAT_KINDS[$ki]}
		# Which of this kind survive the search, counted first so the
		# heading can say how many and an empty kind can be left out
		# altogether.
		shown=0
		i=0
		while [ "$i" -lt "$n" ]; do
			if [ "${CAT[$id]["e"][$i]["kind"]}" = "$k" ]; then
				if [ -z "$q" ]; then
					shown=$((shown + 1))
				else
					hay="${CAT[$id]["e"][$i]["id"]} ${CAT[$id]["e"][$i]["title"]} ${CAT[$id]["e"][$i]["about"]}"
					case ${hay,,} in
					*"${q,,}"*) shown=$((shown + 1)) ;;
					esac
				fi
			fi
			i=$((i + 1))
		done
		[ "$shown" -gt 0 ] || continue
		# Entries, not rows: the status line says "1 of 84" and a row
		# count would include the headings and say "2 of 84" for one
		# match.
		CAT[$id]["shown"]=$((${CAT[$id]["shown"]:-0} + shown))
		CAT[$id]["r"][$m]["t"]=kind
		CAT[$id]["r"][$m]["k"]=$k
		CAT[$id]["r"][$m]["cnt"]=$shown
		m=$((m + 1))
		# Open by the person's own choice, or by a search having
		# found something in here.
		if [ -z "$q" ] && [ "${CAT[$id]["open"]["$k"]}" != 1 ]; then
			continue
		fi
		i=0
		local lastrow=
		while [ "$i" -lt "$n" ]; do
			if [ "${CAT[$id]["e"][$i]["kind"]}" = "$k" ]; then
				hay="${CAT[$id]["e"][$i]["id"]} ${CAT[$id]["e"][$i]["title"]} ${CAT[$id]["e"][$i]["about"]}"
				if [ -z "$q" ] || [[ ${hay,,} == *"${q,,}"* ]]; then
					CAT[$id]["r"][$m]["t"]=entry
					CAT[$id]["r"][$m]["e"]=$i
					CAT[$id]["r"][$m]["last"]=0
					lastrow=$m
					m=$((m + 1))
				fi
			fi
			i=$((i + 1))
		done
		# Which row ends this branch, so the tree can draw its
		# corner there rather than another tee. Recorded as the
		# rows are made, because the loop above is the only place
		# that knows which of them came last.
		[ -n "$lastrow" ] && CAT[$id]["r"][$lastrow]["last"]=1
	done
	CAT[$id]["m"]=$m
	[ "${CAT[$id]["sel"]:-0}" -ge "$m" ] && CAT[$id]["sel"]=$((m > 0 ? m - 1 : 0))
	return 0
}

# The entry the selection is on, or nothing when it is on a heading --
# which is what makes the buttons fall back to Refresh there rather than
# offering to install a kind.
fn cat_at(int id) {
	local m sel

	# A bare `return 1` for each miss, never `ret ""` before it: `ret`
	# ends the function on the spot with status 0, so the return after
	# one never runs and every caller's `|| e=` was dead. The slot is
	# already cleared by `:=` before the call, so there is nothing to
	# put back.
	m=${CAT[$id]["m"]:-0}
	[ "$m" -gt 0 ] || return 1
	sel=${CAT[$id]["sel"]:-0}
	[ "$sel" -lt "$m" ] || return 1
	[ "${CAT[$id]["r"][$sel]["t"]}" = entry ] || return 1
	ret "${CAT[$id]["r"][$sel]["e"]}"
	return 0
}

# Open or shut the kind the selection is on, or the kind an entry belongs
# to when the selection is on one -- left on an entry goes to its heading,
# which is what a tree does everywhere else.
fn cat_fold(int id, how) {
	local sel k e

	sel=${CAT[$id]["sel"]:-0}
	[ "${CAT[$id]["m"]:-0}" -gt 0 ] || return 1
	if [ "${CAT[$id]["r"][$sel]["t"]}" = kind ]; then
		k=${CAT[$id]["r"][$sel]["k"]}
	else
		e=${CAT[$id]["r"][$sel]["e"]}
		k=${CAT[$id]["e"][$e]["kind"]}
		# From an entry, left means "take me to the heading", and
		# only a second left shuts it.
		if [ "$how" = shut ]; then
			while [ "$sel" -gt 0 ]; do
				sel=$((sel - 1))
				[ "${CAT[$id]["r"][$sel]["t"]}" = kind ] && break
			done
			CAT[$id]["sel"]=$sel
			return 0
		fi
	fi
	# Enter on a leaf is not "install it": a key that installs software
	# by being the obvious key to press is a key somebody presses by
	# accident. It is unhandled there, so the desktop gets it.
	[ "$how" = toggle ] && [ "${CAT[$id]["r"][$sel]["t"]}" != kind ] && return 1
	case $how in
	open) CAT[$id]["open"]["$k"]=1 ;;
	shut) CAT[$id]["open"]["$k"]=0 ;;
	*) [ "${CAT[$id]["open"]["$k"]}" = 1 ] &&
		CAT[$id]["open"]["$k"]=0 || CAT[$id]["open"]["$k"]=1 ;;
	esac
	cat_filter "$id"
	return 0
}

# --- the window -------------------------------------------------------

fn catalogue_open(int id, arg = "") {
	CAT[$id]["sel"]=0
	CAT[$id]["top"]=0
	dt_searchclear "$id"
	# Applications open and the rest shut: the structure is visible at a
	# glance and the group most people came for is already there, where
	# everything open is the wall this tree exists to avoid and
	# everything shut is a window that looks empty.
	CAT[$id]["open"]["apps"]=1
	cat_reload "$id"
	return 0
}

fn catalogue_close(int id) {
	unset CAT["$id"]
	dt_searchfree "$id"
	return 0
}

fn catalogue_idle(int id) {
	cat_poll "$id"
	return 0
}

# Two columns: what there is on the left, what the selected one says about
# itself on the right. The prose is the app's own, out of the index, which
# is why this reads better than a package synopsis -- somebody wrote it
# about their own app.
fn catalogue_draw(int id, int h, int w, int row, int col) {
	local n m sel top vis i r e idw listw dw line t mark st about blank
	local srows q
	local -a words

	dt_wclear "$id"
	cat_poll "$id"
	# The divider is the person's, dragged where they want it
	# (widgets/split.hibr) -- and it is the list's scrollbar as well,
	# because a scrollbar's track is the same vertical line a divider
	# is: one column doing both rather than two columns side by side.
	listw := dt_split CAT_SPLIT "$w" 16 40
	# One column short of the room left, always: the detail has a
	# scrollbar of its own when the prose is longer than the pane, and
	# a text width that changed as you moved between entries would
	# reflow every line for the sake of one column.
	dw=$((w - listw - 4))
	m=${CAT[$id]["m"]:-0}
	n=${CAT[$id]["n"]:-0}
	# The search takes the window's own bottom row, and only while
	# there is one (widgets/search.hibr): nothing is drawn until `/`,
	# so a window nobody is searching keeps the row for its list.
	srows := dt_searchrows "$id"
	vis=$((h - 3 - srows))
	[ "$vis" -lt 1 ] && vis=1

	# What this is a list of, and how much of it is shown.
	console pen "$DT_DIM" "$DT_FACE"
	if [ -n "${CAT[$id]["busy"]}" ]; then
		t := dt_tr "working: %s" "${CAT[$id]["busy"]}"
	elif [ -n "${CAT[$id]["loading"]}" ]; then
		t := dt_tr "reading the catalogue"
	elif q := dt_searchq "$id"; [ -n "$q" ]; then
		t := dt_tr "%s of %s" "${CAT[$id]["shown"]:-0}" "$n"
	else
		t := dt_tr "%s in the catalogue" "$n"
	fi
	# On the buttons' own row, right-aligned, which is where a status
	# belongs and the one row nothing else reaches: it used to share
	# row 1 with the search field, and when the search left (it draws
	# nothing until asked, widgets/search.hibr) that row went to the
	# list's headings -- where the detail pane's own blanking wiped the
	# count on every frame.
	#
	# Right-aligned inside a field of its own width, and the field is
	# padded: `dt_wclear` clears a window's clickable *regions*, not its
	# cells, so a shorter line drawn where a longer one was leaves the
	# tail of the old one on screen -- which is why this read
	# "working: list" long after the work had finished.
	CAT[$id]["status"]=$t

	if [ -n "${CAT[$id]["err"]}" ]; then
		console pen "$DT_BAD" "$DT_FACE"
		console put -p "w$id" 2 2 "${CAT[$id]["err"]}"
		dt_buttons "$id" $((h - 1)) 2 "" asrefresh Refresh
		return 0
	fi

	sel=${CAT[$id]["sel"]:-0}
	top=${CAT[$id]["top"]:-0}
	top := dt_scrollfit "$top" "$m" "$vis" "$sel"
	CAT[$id]["top"]=$top
	CAT[$id]["vis"]=$vis

	# The headings share row 1 with the count, which is where the
	# search field used to be: the row is free now that the search
	# draws nothing until it is asked for, and giving it back to the
	# list is the whole point of that choice.
	console pen "$DT_INK" "$DT_FACE" bold
	t := dt_tr "ITEM"
	console put -p "w$id" 1 2 "$t"
	t := dt_tr "VERSION"
	console put -p "w$id" 1 $((listw - ${#t} + 1)) "$t"

	i=$top
	r=2
	idw=$((listw - 14))
	[ "$idw" -lt 10 ] && idw=10
	while [ "$r" -lt $((2 + vis)) ]; do
		if [ "$i" -lt "$m" ]; then
			if [ "${CAT[$id]["r"][$i]["t"]}" = kind ]; then
				# A heading: which way it folds, what it is
				# called, and how many are under it -- the
				# count is why a shut group is still worth
				# reading.
				local kk kn kopen=0
				kk=${CAT[$id]["r"][$i]["k"]}
				kn := cat_kindname "$kk"
				kn := dt_tr "$kn"
				if [ "${CAT[$id]["open"]["$kk"]}" = 1 ] ||
				   [ -n "$q" ]; then
					kopen=1
				fi
				# A branch at the root: the widget decides
				# what an open and a shut one look like, and
				# the setting decides which marks those are
				# (widgets/tree.hibr).
				mark := dt_treepre 0 1 "$kopen" 0 ""
				# The count sits against the name, in
				# brackets, rather than out at the list's
				# right edge: a branch has no version, and a
				# lone number right-aligned in the column the
				# versions below it fill reads as one however
				# far from the heading it is put. `(21)` next
				# to `Applications` can only be a count.
				# The brackets are drawn here and are not
				# part of any catalogue key -- punctuation is
				# not translatable, and `%s (%d)` would be a
				# string with no words in it.
				local cnt=${CAT[$id]["r"][$i]["cnt"]}
				t := dt_cut "$kn" $((listw - 7 - ${#cnt}))
				line="$mark $t ($cnt)"
				if [ "$i" = "$sel" ] && ! dt_searchon "$id"; then
					console pen "$DT_SELINK" "$DT_ACTIVE" bold
				elif [ "$i" = "$sel" ]; then
					console pen "$DT_INK" "$DT_WELL" bold
				else
					console pen "$DT_ACTIVE" "$DT_FACE" bold
				fi
			else
				local lead
				e=${CAT[$id]["r"][$i]["e"]}
				mark=" "
				[ -n "${CAT[$id]["e"][$e]["installed"]}" ] && mark="${GL[check]}"
				# A tick means "you have this", so the
				# package's own copy earns one too -- what
				# differs is the line beside it, which says
				# where it came from (Gitea #254).
				case ${CAT[$id]["e"][$e]["where"]} in
				shipped | system) mark="${GL[check]}" ;;
				esac
				[ "${CAT[$id]["e"][$e]["update"]}" = 1 ] && mark="${GL[reload]}"
				# A copy the machine also has is read second
				# and can never run, which is worth more than
				# a tick: the mark that means "look at this"
				# rather than the one that means "you have
				# it" (Gitea #244).
				[ "${CAT[$id]["e"][$e]["defunct"]}" = 1 ] &&
					mark="${GL[warn]}"
				# A leaf one level in, joined to its branch by
				# the widget -- a tee, or a corner for the
				# last of them. By its own name rather than
				# its id: the kind is the line above it, so
				# repeating it in every row is noise.
				lead := dt_treelead 1 \
					"${CAT[$id]["r"][$i]["last"]:-0}" "0"
				t := dt_cut "${CAT[$id]["e"][$e]["name"]}" "$idw"
				t := str pad "$lead$mark $t" $((listw - 8))
				# The right-hand column says **which scope**
				# rather than a version, for anything that is
				# not the person's own: a tick alone made
				# twenty-one apps they installed and
				# sixty-four the package shipped look
				# identical, which is what they asked about
				# (Gitea #254). The same three words the
				# command line uses, so there is one
				# vocabulary rather than two.
				local vcol=${CAT[$id]["e"][$e]["version"]}
				case ${CAT[$id]["e"][$e]["where"]} in
				shipped) vcol := dt_tr "shipped" ;;
				system) vcol := dt_tr "system" ;;
				esac
				line="$t$vcol"
				if [ "$i" = "$sel" ] && ! dt_searchon "$id"; then
					console pen "$DT_SELINK" "$DT_ACTIVE"
				elif [ "$i" = "$sel" ]; then
					console pen "$DT_INK" "$DT_WELL"
				else
					console pen "$DT_INK" "$DT_FACE"
				fi
			fi
			t := str pad "$line" "$listw"
			console put -p "w$id" "$r" 1 "$t"
		else
			# Past the end of the list, and still written: a
			# window's cells are not cleared between frames, so a
			# list that shrinks -- which is what a search does --
			# leaves the rows it no longer has on screen as
			# ghosts of themselves.
			t := str repeat " " "$listw"
			console put -p "w$id" "$r" 1 "$t"
		fi
		i=$((i + 1))
		r=$((r + 1))
	done

	# A rule between the two, because without one the detail's own
	# heading sits on the same row as ITEM and VERSION and reads as a
	# third column of the list rather than the top of a second pane.
	dt_splitbar "$id" $((listw + 1)) 1 $((h - 2 - srows)) \
		"${CAT[$id]["drag"]:-0}"
	dt_scrollbar "$id" 2 $((listw + 1)) "$vis" "$m" "$vis" "$top"

	# The detail: what this one says about itself. Blanked first, for
	# the same reason the list rows are: a shorter entry after a longer
	# one would otherwise be read against the tail of the one before.
	blank := str repeat " " "$dw"
	r=1
	while [ "$r" -lt $((h - 1 - srows)) ]; do
		console put -p "w$id" "$r" $((listw + 3)) "$blank"
		r=$((r + 1))
	done
	e := cat_at "$id" || e=
	if [ -n "$e" ]; then
		console pen "$DT_ACTIVE" "$DT_FACE" bold
		t := dt_cut "${CAT[$id]["e"][$e]["title"]}" "$dw"
		console put -p "w$id" 1 $((listw + 3)) "$t"
		console pen "$DT_DIM" "$DT_FACE"
		st=${CAT[$id]["e"][$e]["id"]}
		t := dt_cut "$st" "$dw"
		console put -p "w$id" 2 $((listw + 3)) "$t"
		if [ "${CAT[$id]["e"][$e]["update"]}" = 1 ]; then
			t := dt_tr "installed %s, %s available" \
				"${CAT[$id]["e"][$e]["installed"]}" \
				"${CAT[$id]["e"][$e]["version"]}"
		elif [ -n "${CAT[$id]["e"][$e]["installed"]}" ]; then
			t := dt_tr "installed %s" "${CAT[$id]["e"][$e]["installed"]}"
		elif [ "${CAT[$id]["e"][$e]["where"]}" = shipped ]; then
			t := dt_tr "shipped with hibr"
		elif [ "${CAT[$id]["e"][$e]["where"]}" = system ]; then
			t := dt_tr "installed on this machine for everyone"
		else
			t := dt_tr "version %s" "${CAT[$id]["e"][$e]["version"]}"
		fi
		# What the columns of `catalogue installed` say, which this
		# window showed none of until 0.99.202: a copy that can
		# never run, one that hides the shipped copy, and what the
		# entry brought with it (Gitea #244).
		if [ "${CAT[$id]["e"][$e]["defunct"]}" = 1 ]; then
			st := dt_tr "the machine has this, and its copy is read first"
			t="$t -- $st"
		elif [ "${CAT[$id]["e"][$e]["shadows"]}" = 1 ]; then
			st := dt_tr "shadows the one hibr ships"
			t="$t -- $st"
		fi
		if [ "${CAT[$id]["e"][$e]["np"]:-0}" -gt 0 ]; then
			st := dt_trn "${CAT[$id]["e"][$e]["np"]}" \
				"%s file with it" "%s files with it" \
				"${CAT[$id]["e"][$e]["np"]}"
			t="$t, $st"
		fi
		t := dt_cut "$t" "$dw"
		console put -p "w$id" 3 $((listw + 3)) "$t"
		console pen "$DT_INK" "$DT_FACE"
		# Paragraph by paragraph, keeping the blank line between: an
		# `about` is the app's own one-line summary and then the
		# paragraph from its header, and running the two together
		# reads as one garbled sentence. The newlines inside a
		# paragraph are flattened because `read -ra` of a here-string
		# reads **one line** -- without that the detail showed the
		# first line and silently dropped the rest.
		# Wrapped into lines first and drawn from `dtop`, rather
		# than drawn as it is read: prose longer than the pane used
		# to be cut off with nothing saying so, and a reader cannot
		# scroll what was never laid out. The bar on the right says
		# there is more, and the wheel over this half moves it.
		local para dtop dvis dn
		CAT_DLINES=()
		while IFS= read -r para; do
			if [ -z "$para" ]; then
				CAT_DLINES+=("")
				continue
			fi
			read -ra words <<< "$para"
			line=
			for t in "${words[@]}"; do
				if [ $((${#line} + ${#t} + 1)) -gt "$dw" ]; then
					CAT_DLINES+=("$line")
					line=$t
				else
					line="${line:+$line }$t"
				fi
			done
			[ -n "$line" ] && CAT_DLINES+=("$line")
		done <<< "${CAT[$id]["e"][$e]["about"]}"
		dn=${#CAT_DLINES[@]}
		dvis=$((h - 7 - srows))
		[ "$dvis" -lt 1 ] && dvis=1
		CAT[$id]["dvis"]=$dvis
		CAT[$id]["dn"]=$dn
		dtop=${CAT[$id]["dtop"]:-0}
		dtop := dt_scrollfit "$dtop" "$dn" "$dvis"
		CAT[$id]["dtop"]=$dtop
		r=5
		i=0
		while [ "$i" -lt "$dvis" ]; do
			line=${CAT_DLINES[$((dtop + i))]-}
			line := str pad "$line" "$dw"
			console put -p "w$id" "$r" $((listw + 3)) "$line"
			r=$((r + 1))
			i=$((i + 1))
		done
		[ "$dn" -gt "$dvis" ] &&
			dt_scrollbar "$id" 5 $((w - 1)) "$dvis" "$dn" \
				"$dvis" "$dtop"
	fi
	cat_btns "$id" $((h - srows)) "$w"
	console pen "$DT_DIM" "$DT_FACE"
	cat_right "$id" $((h - 1 - srows)) "$w" 34 "${CAT[$id]["status"]}"
	dt_searchdraw "$id" "$h" "$w"
	return 0
}

# A line right-aligned in a field of fixed width, padded so that whatever
# was there before is written over. Nothing clears a window's cells
# between frames -- only what a frame writes is replaced -- so every
# varying piece of text here is drawn over its own full width.
fn cat_right(int id, int r, int w, int fw, text) {
	local tw pad s=""

	tw := str width "$text"
	pad=$((fw - tw))
	[ "$pad" -lt 0 ] && pad=0
	[ "$pad" -gt 0 ] && s := str repeat " " "$pad"
	console put -p "w$id" "$r" $((w - fw - 1)) "$s$text"
	return 0
}

# **One button, and it flips.** Install when you do not have it,
# Uninstall when you do: the same place, the same key, saying what
# pressing it will do rather than offering two of which one is always
# wrong. Update is a second button only while there is one to take --
# it is a different act from either, and it is not always there.
fn cat_btns(int id, int h, int w) {
	local e

	# A pair is **tag then label**, which is the order dt_buttons reads:
	# it compares the tag against the focus and translates the label.
	e := cat_at "$id" || {
		dt_buttons "$id" $((h - 1)) 2 "" asrefresh Refresh
		return 0
	}
	if [ "${CAT[$id]["e"][$e]["update"]}" = 1 ]; then
		dt_buttons "$id" $((h - 1)) 2 "" asupdate Update \
			asgo Uninstall asread "Read It" asrefresh Refresh
	elif [ -n "${CAT[$id]["e"][$e]["installed"]}" ]; then
		dt_buttons "$id" $((h - 1)) 2 "" asgo Uninstall \
			asread "Read It" asrefresh Refresh
	else
		dt_buttons "$id" $((h - 1)) 2 "" asgo Install \
			asread "Read It" asrefresh Refresh
	fi
	return 0
}

# What that one button does, by what the selected entry is. The key `i`
# and the App menu's own row go through here too, so the three ways of
# asking cannot drift apart.
fn cat_go(int id) {
	local e

	e := cat_at "$id" || { dt_note "Nothing is selected"; return 0; }
	if [ -n "${CAT[$id]["e"][$e]["installed"]}" ]; then
		cat_act "$id" remove
	else
		cat_act "$id" install
	fi
	return 0
}

# --- doing things -----------------------------------------------------

# Each of these starts a job and returns at once. The callback says what
# happened and reloads, so the list tells the truth afterwards rather
# than what it believed before.
fn cat_act(int id, what, ...rest) {
	local e wid

	e := cat_at "$id" || { dt_note "Nothing is selected"; return 0; }
	[ -z "${CAT[$id]["busy"]}" ] || { dt_note "Still working"; return 0; }
	wid=${CAT[$id]["e"][$e]["id"]}
	CAT[$id]["on"]=$wid
	case $what in
	install) cat_job "$id" "install $wid" cat_acted catalogue install "$wid" ;;
	update) cat_job "$id" "update $wid" cat_acted catalogue update "$wid" ;;
	remove) cat_job "$id" "remove $wid" cat_acted catalogue remove "$wid" ;;
	esac
	return 0
}

fn cat_acted(int id, int st, int n, what = "") {
	local why

	# The value alone, with no sentence around it: what `apps` said, and
	# what was asked of it. A bare "%s" as a format would put "%s" in the
	# catalogue as a key, and a key with no words in it is one no
	# translation can differ from.
	if [ "$st" != 0 ]; then
		why := cat_why "$n"
		dt_notep high "$why"
	else
		dt_note "$what"
	fi
	cat_reload "$id"
	return 0
}

fn cat_install(int id) { cat_act "$id" install; }
fn cat_update(int id) { cat_act "$id" update; }
fn cat_remove(int id) { cat_act "$id" remove; }

fn cat_refresh(int id) {
	[ -z "${CAT[$id]["busy"]}" ] || return 0
	cat_job "$id" refresh cat_refreshed catalogue refresh
	return 0
}

fn cat_refreshed(int id, int st, int n, what = "") {
	cat_reload "$id"
	return 0
}

# Read it before you run it, which is the thing a catalogue of **scripts**
# can offer and a package manager cannot: the bundle is fetched, verified
# against the index exactly as an install verifies it, and opened in Write
# without being placed anywhere.
fn cat_read(int id) {
	local e wid

	e := cat_at "$id" || { dt_note "Nothing is selected"; return 0; }
	[ -z "${CAT[$id]["busy"]}" ] || { dt_note "Still working"; return 0; }
	wid=${CAT[$id]["e"][$e]["id"]}
	CAT[$id]["on"]=$wid
	cat_job "$id" "read $wid" cat_readit catalogue show "$wid"
	return 0
}

fn cat_readit(int id, int st, int n, what = "") {
	local f why dest

	if [ "$st" != 0 ]; then
		why := cat_why "$n"
		dt_notep high "$why"
		return 0
	fi
	f := cat_out "$n"
	[ -s "$f" ] || { dt_note "There was nothing to read"; return 0; }
	# Copied out of the job's own folder, which the next job would
	# overwrite, and named after what it is so the window's title says
	# so.
	dest="${XDG_CACHE_HOME:-$HOME/.cache}/hibr/${CAT[$id]["on"]//\//-}"
	command cp -f "$f" "$dest" 2> /dev/null ||
		{ dt_note "Cannot keep a copy to read"; return 0; }
	# Opened the way the desktop opens anything, so whatever the person
	# has set for a `.hibr` is what they get -- naming an editor here
	# would be this window having an opinion about their handlers.
	dt_openfile "$dest"
	return 0
}

# --- keys and clicks --------------------------------------------------

# `/` and the Edit menu's Find both come here, which is the whole of this
# window's search now: widgets/search.hibr holds the text, the keys and
# the bar, and this only re-filters when they change something.
fn catalogue_find(int id) {
	dt_searchopen "$id"
	return 0
}

fn catalogue_key(int id, key) {
	local r q0 q1

	q0 := dt_searchq "$id"
	if dt_searchkey "$id" "$key"; then
		q1 := dt_searchq "$id"
		if [ "$q0" != "$q1" ]; then
			CAT[$id]["sel"]=0
			CAT[$id]["top"]=0
			cat_filter "$id"
			cat_first "$id"
		fi
		return 0
	fi
	case $key in
	right) cat_fold "$id" open; return 0 ;;
	left) cat_fold "$id" shut; return 0 ;;
	enter | " ") cat_fold "$id" toggle || return 1; return 0 ;;
	i) cat_go "$id"; return 0 ;;
	u) cat_update "$id"; return 0 ;;
	x) cat_remove "$id"; return 0 ;;
	r) cat_read "$id"; return 0 ;;
	f5) cat_refresh "$id"; return 0 ;;
	esac
	r := dt_scrollmove "$key" "${CAT[$id]["top"]:-0}" "${CAT[$id]["m"]:-0}" \
			   "${CAT[$id]["vis"]:-1}" || return 1
	CAT[$id]["top"]=$r
	case $key in
	up) [ "${CAT[$id]["sel"]:-0}" -gt 0 ] &&
		CAT[$id]["sel"]=$((${CAT[$id]["sel"]} - 1)) ;;
	down) [ "${CAT[$id]["sel"]:-0}" -lt $((${CAT[$id]["m"]:-0} - 1)) ] &&
		CAT[$id]["sel"]=$((${CAT[$id]["sel"]} + 1)) ;;
	esac
	# A different entry's prose starts at its own beginning, not where
	# the last one was left.
	CAT[$id]["dtop"]=0
	return 0
}

# A press on the divider begins a drag of it; anything else is an
# ordinary click. An app with a `_mouse` never gets `_click`, so this
# passes on what it does not want, the shape panel_mouse and fpick_mouse
# already use.
fn catalogue_mouse(int id, act, btn, int r, int c, mods = "") {
	local listw

	listw := dt_split CAT_SPLIT "${DT[$id]["w"]:-80}" 16 40
	case $act in
	press)
		if [ "$c" = $((listw + 1)) ]; then
			CAT[$id]["drag"]=1
			return 0
		fi
		CAT[$id]["drag"]=
		catalogue_click "$id" "$r" "$c" "$btn"
		;;
	drag)
		[ "${CAT[$id]["drag"]}" = 1 ] || return 0
		dt_splitmove CAT_SPLIT $((c - 1)) "${DT[$id]["w"]:-80}" 16
		;;
	release) CAT[$id]["drag"]= ;;
	esac
	return 0
}

fn catalogue_click(int id, int r, int? c = "", btn = "") {
	local tag i

	tag := dt_hit "$id" "$r" "$c" && {
		case $tag in
		dtsearch) dt_searchopen "$id" ;;
		asgo) cat_go "$id" ;;
		asupdate) cat_update "$id" ;;
		asread) cat_read "$id" ;;
		asrefresh) cat_refresh "$id" ;;
		esac
		return 0
	}
	if [ "$r" -ge 2 ]; then
		i=$((${CAT[$id]["top"]:-0} + r - 2))
		if [ "$i" -lt "${CAT[$id]["m"]:-0}" ]; then
			dt_searchshut "$id"
			CAT[$id]["dtop"]=0
			# A click on a heading folds it, which is what a
			# click on a heading does everywhere; a click on one
			# already selected folds it too, rather than doing
			# nothing twice.
			if [ "${CAT[$id]["r"][$i]["t"]}" = kind ]; then
				CAT[$id]["sel"]=$i
				cat_fold "$id" toggle
			else
				CAT[$id]["sel"]=$i
			fi
		fi
	fi
	return 0
}

# The wheel moves whichever half it is over: the list on the left, the
# entry's own prose on the right. A window cut in two scrolls in two.
fn catalogue_wheel(int id, dir, int? r = "", int? c = "") {
	local t listw

	listw := dt_split CAT_SPLIT "${DT[$id]["w"]:-80}" 16 40
	if [ -n "$c" ] && [ "$c" -gt $((listw + 1)) ]; then
		t := dt_scrollmove "$dir" "${CAT[$id]["dtop"]:-0}" \
				   "${CAT[$id]["dn"]:-0}" \
				   "${CAT[$id]["dvis"]:-1}" || return 1
		CAT[$id]["dtop"]=$t
		return 0
	fi
	t := dt_scrollmove "$dir" "${CAT[$id]["top"]:-0}" "${CAT[$id]["m"]:-0}" \
			   "${CAT[$id]["vis"]:-1}" || return 1
	CAT[$id]["top"]=$t
	return 0
}

# No argument: the window manager calls `<app>_menus` with none and the
# app reads the focused window itself, which is what every other app here
# does. Declared with one, this refused every call -- and a declared
# function that refuses an argument never runs its body, so the *whole
# frame* died and the window drew nothing at all.
catalogue_menus() {
	local id=$DT_FOCUS
	local e got=

	# The row says what choosing it will do, the same as the button
	# does, because they are the same act: a menu offering both
	# Install and Uninstall is a menu where one of the two is always
	# the wrong one to read. Written as two calls with a literal each
	# rather than one with a variable, because a label that is a
	# variable cannot be found by `tools/strings.py` and would not be
	# in the catalogue to translate (Gitea #202).
	e := cat_at "$id" && [ -n "${CAT[$id]["e"][$e]["installed"]}" ] && got=1

	dt_menu "File"
	dt_item "Refresh" r cat_refresh "$id"
	dt_sep
	dt_item "Close" c dt_wantclose "$id"
	dt_end
	dt_editmenu
	dt_menu "App"
	if [ -n "$got" ]; then
		dt_item "Uninstall" i cat_go "$id"
	else
		dt_item "Install" i cat_go "$id"
	fi
	dt_item "Update" u cat_update "$id"
	dt_sep
	dt_item "Read It" e cat_read "$id"
	dt_end
	return 0
}
