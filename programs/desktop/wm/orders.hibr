# wm/orders -- the lists a person arranges, as they stand: the menu
# bar's items, the Control Strip's modules and the title bar's buttons, each
# in its saved order with what is missing put back. Each reads only what the
# desktop shares (the saved orders, what is installed), so an app's process
# -- a Control Panel pane -- works it out on its copy.
#
# Part of the app interface (ADR 0050): interface.hibr sources it, in the
# desktop and in every app's own process, so it acts on nothing the
# desktop alone owns. It only defines functions and sets state.
# interface: shared

strict

# Every module loaded, in CS_ORDER's order, into CS_MOD_ORD: the ones it
# names first, then the rest as their files came.
declare -ga CS_MOD_ORD
cs_ordered() {
	local m
	local -a want

	CS_MOD_ORD=()
	read -ra want <<< "${CS_ORDER-}"
	for m in "${want[@]}"; do
		case " ${CS_MOD_ALL[*]-} " in *" $m "*) ;; *) continue ;; esac
		case " ${CS_MOD_ORD[*]-} " in *" $m "*) continue ;; esac
		CS_MOD_ORD+=("$m")
	done
	for m in "${CS_MOD_ALL[@]}"; do
		case " ${CS_MOD_ORD[*]-} " in *" $m "*) continue ;; esac
		CS_MOD_ORD+=("$m")
	done
}

# The Title Bar Buttons list as it stands, into DT_BTNL: the saved order with
# anything it does not know taken out and anything it lacks put back, so a
# list saved before a button existed still offers it.
declare -ga DT_BTNL
fn dt_btnlist() {
	local k
	local -a a

	DT_BTNL=()
	read -ra a <<< "$DT_BTNORDER"
	for k in "${a[@]}"; do
		case " ${DT_BTNS[*]} " in
		*" $k "*) case " ${DT_BTNL[*]} " in *" $k "*) ;; *) DT_BTNL+=("$k") ;; esac ;;
		esac
	done
	for k in "${DT_BTNS[@]}"; do
		case " ${DT_BTNL[*]} " in *" $k "*) ;; *) DT_BTNL+=("$k") ;; esac
	done
}

# The items in the order dt_barilay places them -- nearest the notification
# icon first -- into DT_BARSEQ. DT_BARORDER names items in the order they
# read across the bar, and a name no item has is passed over, so with it
# empty the bar is exactly as it was before there was a setting (Gitea
# #341). Since #396 it may name the clock, the notification icon and the
# workspace numbers too, and a pinned item it names leaves its pin for the
# place the order gives it; DT_BARNAMED says which those are. One it does
# not name -- an item installed after the order was chosen -- goes after
# the last ordinary item it names, which is where it would have gone with
# the clock and the icon still pinned.
declare -ga DT_BARSEQ
DT_BARNAMED=
dt_barseq() {
	local nm i p ins=-1 fp=-1
	local -a want ok un rd

	read -ra want <<< "${DT_BARORDER-}"
	for nm in "${want[@]}"; do
		case " ${DT_BARIN[*]} " in *" $nm "*) ;; *) continue ;; esac
		p=${DT_BARI["$nm"]["pin"]-}
		[ "$p" = 1 ] && continue
		case " ${ok[*]-} " in *" $nm "*) continue ;; esac
		if [ -z "$p" ]; then
			ins=$((${#ok[@]} + 1))
		elif [ "$fp" = -1 ] && [ "${p#-}" = "$p" ]; then
			fp=${#ok[@]}
		fi
		ok+=("$nm")
	done
	[ "$ins" = -1 ] && ins=$fp
	[ "$ins" = -1 ] && ins=${#ok[@]}
	DT_BARNAMED=" ${ok[*]-} "
	i=$((${#DT_BARIN[@]} - 1))
	while [ "$i" -ge 0 ]; do
		nm=${DT_BARIN[$i]}
		i=$((i - 1))
		[ -n "${DT_BARI["$nm"]["pin"]-}" ] && continue
		case $DT_BARNAMED in *" $nm "*) ;; *) un+=("$nm") ;; esac
	done
	i=0
	while [ "$i" -lt "$ins" ]; do
		rd+=("${ok[$i]}")
		i=$((i + 1))
	done
	rd+=("${un[@]}")
	while [ "$i" -lt "${#ok[@]}" ]; do
		rd+=("${ok[$i]}")
		i=$((i + 1))
	done
	DT_BARSEQ=()
	i=$((${#rd[@]} - 1))
	while [ "$i" -ge 0 ]; do
		DT_BARSEQ+=("${rd[$i]}")
		i=$((i - 1))
	done
}

# The bar's items in the order they are laid out from the outer end inwards:
# the pinned ones by their place, every ordinary one in DT_BARSEQ's order,
# then those pinned beyond them.
declare -ga DT_BARLAY
dt_barlist() {
	local nm p i top=0

	for nm in "${DT_BARIN[@]}"; do
		p=${DT_BARI["$nm"]["pin"]-}
		[ -n "$p" ] || continue
		[ "${p#-}" -gt "$top" ] && top=${p#-}
	done
	DT_BARLAY=()
	dt_barseq
	for ((i = 1; i <= top; i++)); do
		for nm in "${DT_BARIN[@]}"; do
			[ "${DT_BARI["$nm"]["pin"]-}" = "$i" ] || continue
			case $DT_BARNAMED in *" $nm "*) continue ;; esac
			DT_BARLAY+=("$nm")
		done
	done
	DT_BARLAY+=("${DT_BARSEQ[@]}")
	for ((i = 1; i <= top; i++)); do
		for nm in "${DT_BARIN[@]}"; do
			[ "${DT_BARI["$nm"]["pin"]-}" = "-$i" ] || continue
			case $DT_BARNAMED in *" $nm "*) continue ;; esac
			DT_BARLAY+=("$nm")
		done
	done
}

# The items as they read across the bar, into DT_BARREAD, for the list a
# person orders them in: every one but the application menu, which keeps
# its corner (Gitea #396), the hidden ones where they would be.
declare -ga DT_BARREAD
dt_barreading() {
	local i nm

	dt_barlist
	DT_BARREAD=()
	i=$((${#DT_BARLAY[@]} - 1))
	while [ "$i" -ge 0 ]; do
		nm=${DT_BARLAY[$i]}
		i=$((i - 1))
		[ "${DT_BARI["$nm"]["pin"]-}" = 1 ] && continue
		DT_BARREAD+=("$nm")
	done
}
