# wm/rtkinds -- the other things an installable draws, drawn by its own
# process (ADR 0050, the view kinds): a Control Panel pane in the panel's
# window, a Control Strip module in its slot of the strip, and a screen
# saver on the screen. Each is a view of the spine's (wm/rtview.hibr) of
# another kind, on the same cells channel and the same `view` line -- `pane`
# (NAME p$ID, the panel's window pane w$ID and the body's rectangle in it),
# `strip` (NAME s$NAME, the screen and its slot), `saver` (NAME v, the
# screen) -- and its input is a `call` by name, so no verb is added. A
# process is the installable's file's, started by its file (dt_rthostk):
# the seam already names such an installable by its file (DT_HOOKOWNER), so
# the connection is that file's, as a window's is its app's. Its prefixes
# are hosted from the moment it is started, so it is never drawn in this
# process meanwhile: the seam (dt_prefixfn) sends what it would have
# called, and dt_has answers from what the process said it has. Only a test
# session listens (dt_rtlisten), so in a real session each branch on DT_RVP
# or DT_RVX is one empty lookup.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Each hosted prefix's request connection, empty while its process is being
# started; its file; and the callbacks carried for it, as " KIND... ".
# DT_RVP itself is the seam's (wm/seam.hibr), DT_RVFN dt_has's
# (wm/names.hibr).
declare -gA DT_RVPC DT_RVPF DT_RVPK
# Each view of these kinds by name: its connection (empty once let go here
# and to be bound again where it is next drawn), generation, the place and
# words it was last bound with, whether its kept cells changed since they
# were last shown, and whose it is (its prefix).
declare -gA DT_RVX DT_RVXGEN DT_RVXARGS DT_RVXDIRTY DT_RVXP

# The callbacks each kind carries, its others said once and left out: a
# pane's body is drawn, clicked, scrolled, typed into and pressed in; a
# strip module drawn and clicked; a saver begun and stepped. A pane's rows,
# a module's _shown and the rest are asks or another track's.
declare -gA DT_RVCARRY=([pane]=" draw click wheel key mouse rows " [strip]=" draw click " [saver]=" start frame ")

# The file who stands for: an app's, or who itself when it is a file -- a
# pane, a strip module or a saver started by its file. Answered with ret.
fn dt_rvsrc(who = "") {
	if [[ $who == */* ]]; then
		ret "$who"
	else
		ret "${DT_APPS["$who"]["src"]-}"
	fi
}

# Whether file f is who's own -- an app's or a file's process -- its file
# or one of its parts (a bundle is one process, ADR 0050): the one answer
# every guard on another installable's thing asks.
fn dt_rvmine(who = "", f = "") {
	local m p

	m := dt_rvsrc "$who"
	[ -n "$f" ] && [ -n "$m" ] || return 1
	[ "$f" = "$m" ] && return 0
	p := dt_rtpartfiles "$m" || return 1
	[[ $'\n'$p$'\n' == *$'\n'"$f"$'\n'* ]]
}

# Whether app is who's own: who itself, or an app its file registers.
fn dt_rvappof(who, app = "") {
	[ -n "$app" ] || return 1
	[ "$app" = "$who" ] && return 0
	[[ $who == */* ]] && [ "${DT_APPS["$app"]["src"]-}" = "$who" ]
}

# Whether f is a file the desktop registered an installable from.
fn dt_rvinst(f) {
	local p

	dt_has cp_pane && for p in "${!CP_PANES[@]}"; do
		[ "${CP_PANES[$p]["src"]-}" = "$f" ] && return 0
	done
	dt_has cs_module && for p in "${!CS_MODS[@]}"; do
		[ "${CS_MODS[$p]["src"]-}" = "$f" ] && return 0
	done
	dt_has sv_saver && for p in "${!SV[@]}"; do
		[ "${SV[$p]["src"]-}" = "$f" ] && return 0
	done
	for p in "${DT_BARIN[@]}"; do
		[ "${DT_BARI["$p"]["src"]-}" = "$f" ] && return 0
	done
	for p in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$p]["src"]-}" = "$f" ] && return 0
	done
	return 1
}

# Start the process of the file that registers a pane, a strip module or a
# saver, by kind and name -- a test session's only, as dt_rthost is -- and
# host every pane, module and saver of that file from now on. Answered with
# the launch, as dt_rthost answers.
fn dt_rthostk(kind, name) {
	local f= p t

	case $kind in
	pane) dt_has cp_pane && f=${CP_PANES["$name"]["src"]-} ;;
	strip) dt_has cs_module && f=${CS_MODS["$name"]["src"]-} ;;
	saver) dt_saverload && f=${SV["$name"]["src"]-} ;;
	esac
	[ -n "$f" ] || { dt_log "app runtime: no $kind $name with a file to start"; return 1; }
	dt_rthostf "$f" && ret -k
}

# Start the process of file f, or of the app whose bundle has f as a part
# (a bundle is one process): every pane, module, saver and bar item of it
# hosted from now on. Answered with the launch.
fn dt_rthostf(f) {
	local a t

	if a := dt_rvpartof "$f"; then
		t := dt_rthost "$a" || return 1
		ret "$t"
		return 0
	fi
	dt_rtlisten || return 1
	dt_rvpendfile "$f"
	t := dt_rtspawn "$f" "$f" "$DT_HERE/runtime.hibr" "$f" "$f"
	ret "$t"
}

# The app whose bundle declares file f a part, answered with ret; status 1
# when none does.
fn dt_rvpartof(f) {
	local a s p

	for a in "${!DT_APPS[@]}"; do
		s=${DT_APPS[$a]["src"]-}
		[ -n "$s" ] && [ "$s" != "$f" ] || continue
		p := dt_rtpartfiles "$s" || continue
		[[ $'\n'$p$'\n' == *$'\n'"$f"$'\n'* ]] && { ret "$a"; return 0; }
	done
	return 1
}

# Every pane, strip module, saver and bar item file f registers, hosted by
# a process being started: never drawn here from now.
fn dt_rvpendfile(f) {
	local p

	dt_has cp_pane && for p in "${!CP_PANES[@]}"; do
		[ "${CP_PANES[$p]["src"]-}" = "$f" ] && dt_rvxpend "$p" pane "$f"
	done
	dt_has cs_module && for p in "${!CS_MODS[@]}"; do
		[ "${CS_MODS[$p]["src"]-}" = "$f" ] && dt_rvxpend "$p" strip "$f"
	done
	dt_has sv_saver && for p in "${!SV[@]}"; do
		[ "${SV[$p]["src"]-}" = "$f" ] && dt_rvxpend "$p" saver "$f"
	done
	for p in "${DT_BARIN[@]}"; do
		[ "${DT_BARI["$p"]["src"]-}" = "$f" ] && DT_RVB["$p"]=
	done
	dt_rvhookoff "$f"
	return 0
}

# The bar hooks a hosted file registered here run in its own process from
# now (the runtime runs them each pass), never as a call a frame: taken off
# the desktop's list, by file, and put back when that process goes.
declare -gA DT_RVHOOKS
fn dt_rvhookoff(f) {
	local h
	local -a keep=()

	for h in "${DT_BARHOOKS[@]}"; do
		if [ "${DT_BARHOOKSRC["$h"]-}" = "$f" ]; then
			DT_RVHOOKS["$h"]=$f
		else
			keep+=("$h")
		fi
	done
	DT_BARHOOKS=("${keep[@]}")
}
fn dt_rvhookback(f = "") {
	local h

	[ -n "$f" ] || return 0
	for h in "${!DT_RVHOOKS[@]}"; do
		[ "${DT_RVHOOKS["$h"]}" = "$f" ] || continue
		unset DT_RVHOOKS["$h"]
		DT_BARHOOKS+=("$h")
	done
	return 0
}

# The pop-up prefixes a process said it has (`has PREFIX popdraw ...`, sent
# as it opens one), by prefix: its connection.
declare -gA DT_RVPOP

# A hosted item's pop-up, where dt_popdraw would have run its own: the
# screen at the pop-up's rectangle (NAME o$NAME, ARGS NAME FN), shown whole
# over the face just painted.
fn dt_rvbpop(nm, fn, int r, int col, int h, int w) {
	dt_rvxbind "o$nm" "b:$nm" "${DT_RVB["$nm"]}" - "$r" "$col" "$h" "$w" pop "$nm" "$fn" || return 0
	dt_rvxshow "o$nm" -a
}

# An app's own file and every part of its bundle, hosted by its process
# being started (dt_rthost).
fn dt_rvpendapp(app) {
	local s=${DT_APPS["$app"]["src"]-} p
	local -a fs

	[ -n "$s" ] || return 0
	dt_rvpendfile "$s"
	p := dt_rtpartfiles "$s" || return 0
	mapfile -t fs <<< "$p"
	for p in "${fs[@]}"; do
		[ -z "$p" ] || dt_rvpendfile "$p"
	done
	return 0
}

# A prefix hosted by a process being started: never drawn here from now.
fn dt_rvxpend(p, kind, f) {
	DT_RVP["$p"]=$kind
	DT_RVPC["$p"]=
	DT_RVPF["$p"]=$f
	DT_RVPK["$p"]=" "
}

# A launch that never said hello (dt_rtlaunches): the prefixes and bar
# items it was to host are this desktop's again.
fn dt_rvxvoid(f = "") {
	local p
	for p in "${!DT_RVB[@]}"; do
		[ -z "${DT_RVB["$p"]}" ] && dt_rvmine "$f" "${DT_BARI["$p"]["src"]-}" || continue
		dt_log "app runtime: bar item $p was to be drawn by $f's process, which did not start"
		unset DT_RVB["$p"]
	done

	for p in "${!DT_RVP[@]}"; do
		[ -z "${DT_RVPC["$p"]-}" ] && dt_rvmine "$f" "${DT_RVPF["$p"]-}" || continue
		dt_log "app runtime: $p was to be drawn by $f's process, which did not start"
		unset DT_RVP["$p"] DT_RVPC["$p"] DT_RVPF["$p"] DT_RVPK["$p"]
	done
	for p in "${!DT_RVHOOKS[@]}"; do
		dt_rvmine "$f" "${DT_RVHOOKS["$p"]}" || continue
		unset DT_RVHOOKS["$p"]
		DT_BARHOOKS+=("$p")
	done
	return 0
}

# `has PREFIX KIND...` from connection c for a pane, a strip module or a
# saver of who's own (its file, or a part of its bundle): carried from now
# on, and drawn at the next frame. Status 1 when p is none of the three of
# who's. One drawn by another process already stays that one's: a part two
# bundles carry (pimset, Calendar's and Contacts') is drawn by the first to
# say it has it, said once for the other.
fn dt_rvkinds_in(int c, who, p, ...kinds) {
	local k= f h=" " src

	if dt_has cp_pane && dt_rvmine "$who" "${CP_PANES["$p"]["src"]-}"; then
		k=pane
		src=${CP_PANES["$p"]["src"]}
	elif dt_has cs_module && dt_rvmine "$who" "${CS_MODS["$p"]["src"]-}"; then
		k=strip
		src=${CS_MODS["$p"]["src"]}
	elif dt_has sv_saver && dt_rvmine "$who" "${SV["$p"]["src"]-}"; then
		k=saver
		src=${SV["$p"]["src"]}
	fi
	if [ -z "$k" ]; then
		# A pop-up's prefix (dt_baripop), from a process that has an item
		# on the bar: what it has of the three is carried.
		[[ " ${kinds[*]} " == *" popdraw "* ]] || return 1
		for f in "${!DT_RVB[@]}"; do
			[ "${DT_RVB["$f"]}" = "$c" ] && k=pop
		done
		[ -n "$k" ] || return 1
		for f in popdraw popmouse popkey; do
			[[ " ${kinds[*]} " != *" $f "* ]] || DT_RVFN["${p}_$f"]=1
		done
		DT_RVPOP["$p"]=$c
		return 0
	fi
	if [ -n "${DT_RVPC["$p"]-}" ] && [ "${DT_RVPC["$p"]}" != "$c" ] && [ -n "${DT_RTC["${DT_RVPC["$p"]}"]+x}" ]; then
		dt_rvonce "two:$p:$c" "app runtime: $who's process has $k $p too, which ${DT_RTC["${DT_RVPC["$p"]}"]}'s draws; it stays there"
		return 0
	fi
	for f in "${kinds[@]}"; do
		if [ "$k:$f" = pane:rows ]; then
			# A rows pane, which its process draws and works with the
			# panel's own rows (widgets/rows.hibr): said so it is given
			# the scrollbar's column too, and never called for its rows.
			h+="$f "
		elif [[ ${DT_RVCARRY["$k"]} == *" $f "* ]]; then
			DT_RVFN["${p}_$f"]=1
			h+="$f "
		else
			dt_rvonce "has:$p:$f" "app runtime: ${p}_$f is not carried yet (ADR 0050); the $k has none"
		fi
	done
	DT_RVP["$p"]=$k
	DT_RVPC["$p"]=$c
	DT_RVPF["$p"]=$src
	DT_RVPK["$p"]=$h
	dt_want 0
	return 0
}

# A call through the seam to a hosted prefix (dt_prefixfn, prefix, what, the
# function it names and its words): its drawing shown from its cells, its
# input sent as a call -- a tell, or a key or a press numbered as an ask,
# which the desktop never waits for -- and anything not carried said once.
# While its process is being started nothing is drawn and nothing sent.
dt_rvpfn() {
	local p=$1 what=$2 k=${DT_RVP["$1"]} c=${DT_RVPC["$1"]-} x

	shift 3
	if [ -z "$c" ]; then
		dt_rvonce "early:$p:$what" "app runtime: $k $p was given $what before its process said what it has; not sent"
		[ "$what" = shown ]
		return
	fi
	case $k:$what in
	pane:draw) dt_rvxpane "$p" "$@" ;;
	strip:draw) dt_rvxstrip "$p" "$@" ;;
	saver:start) dt_rvxsaver "$p" "$@" ;;
	saver:frame)
		[ -z "${DT_RVXDIRTY[v]+x}" ] || dt_rvxshow v
		return 0
		;;
	pane:click | pane:wheel | strip:click)
		dt_rvxinput "$p" "$k" "${1-}"
		x := dt_rvkinput "$c" kcall "$k:$p:$what"
		dt_rvxsend "$c" "$x" "${p}_$what" "$@"
		;;
	pane:key)
		if dt_rvwithheld "${2-}"; then
			dt_log "hosted: key ${2-} withheld, the desktop's"
			return 1
		fi
		x := dt_rvkinput "$c" pkey "pane:$p:key"
		dt_rvxinput "$p" "$k" "${1-}"
		dt_rvxsend "$c" "$x" "${p}_key" "$@"
		;;
	pane:mouse)
		dt_rvxinput "$p" "$k" "${1-}"
		if [ "${2-}" != press ]; then
			dt_rvxsend "$c" 0 "${p}_mouse" "$@"
			return 0
		fi
		x := dt_rvkinput "$c" pmouse "$p:${1-}:${4-}:${5-}"
		dt_rvxsend "$c" "$x" "${p}_mouse" "$@"
		;;
	strip:shown)
		dt_rvonce "ask:$p:$what" "app runtime: ${p}_$what is asked, which is not carried yet (ADR 0050); the module shows"
		return 0
		;;
	*)
		dt_rvonce "ask:$p:$what" "app runtime: ${p}_$what of the $k is not carried yet (ADR 0050)"
		return 1
		;;
	esac
}

# One call by name into a hosted prefix's process: `call SEQ - NAME
# WORDS...`, what changed sent first, so it reads the desktop as it stands.
fn dt_rvxsend(int c, int seq, name, ...words) {
	local x

	dt_rtpass force
	x := dt_rtline call "$seq" - "$name" "${words[@]}"
	dt_rtsay "$c" "$x"
}

# The person's own input to a pane, a module, a bar item or a pop-up,
# numbered as an ask, as a window's is (dt_rvinput): "KIND TAG DEADLINE T0
# ON WAIT FLAGS C", ON and WAIT its process's processor and run-queue time
# then, so one past DT_HOLDMS is judged a stall by the rule a window's is
# (dt_rvklate) -- the same budget, measured from outside. Answered with ret.
fn dt_rvkinput(int c, kind, tag) {
	local p=${DT_RTCPID["$c"]-} on=0 wt=0 now=${EPOCHREALTIME/./}

	DT_RVSEQ=$((DT_RVSEQ + 1))
	[ -z "$p" ] || read -r on wt _ 2> /dev/null < "/proc/$p/schedstat" || { on=0; wt=0; }
	DT_RVASK[$DT_RVSEQ]="$kind $tag $((now / 1000 + DT_HOLDMS)) $now $on $wt - $c"
	ret "$DT_RVSEQ"
}

# Such an input s past its time, each pass until it is answered: a stall
# once what its process spent on it reaches DT_HOLDMS, said once as a
# `held:` line naming the process and what it was given -- which fails a
# suite, as a window's does. Nothing is done to the process for it; one
# that has gone takes its inputs with it.
fn dt_rvklate(s, int now) {
	local kind tag t0 on wt fl c p on2 wt2 ms el who

	read -r kind tag _ t0 on wt fl c <<< "${DT_RVASK["$s"]}"
	if [ -z "$c" ] || [ -z "${DT_RTC["$c"]+x}" ] || [ "${DT_RTC["$c"]}" = - ]; then
		unset DT_RVASK["$s"]
		return 0
	fi
	[[ $fl != *h* ]] || return 0
	el=$((now - t0 / 1000))
	p=${DT_RTCPID["$c"]-}
	on2=$on
	wt2=$wt
	[ -z "$p" ] || read -r on2 wt2 _ 2> /dev/null < "/proc/$p/schedstat" || { on2=$on; wt2=$wt; }
	if [ "$DT_HOLDBY" = cpu ]; then
		ms=$(((on2 - on) / 1000000))
	else
		ms=$((el - (wt2 - wt) / 1000000))
	fi
	[ "$ms" -ge "$DT_HOLDMS" ] || return 0
	who=${DT_RTC["$c"]}
	DT_RVASK["$s"]="$kind $tag $((t0 / 1000 + DT_HOLDMS)) $t0 $on $wt ${fl}h $c"
	dt_log "held: input:$who has not answered the person's input to $tag for $ms ms (a stall is $DT_HOLDMS ms)"
	return 0
}

# The person's own input to a view: its cells channel is input until the
# app's next frame end, so the echo is drawn when it comes. A pane's view
# is its panel window's (w is the window), a module's its own.
fn dt_rvxinput(p, kind, w = "") {
	local n

	case $kind in
	pane) n="p$w" ;;
	*) n="s$p" ;;
	esac
	[ -z "${DT_RVX["$n"]-}" ] || console cells input "$n"
}

# A press a hosted pane's _mouse declined, answered: what the panel does
# with a press its pane does not want -- the click it would have been
# (panel_mouse), the panel's own, which tells the pane's _click in turn.
fn dt_rvxpress(id, st = "") {
	local p w r c

	[ "$st" = 1 ] || return 0
	IFS=: read -r p w r c <<< "$id"
	dt_iswin "$w" && dt_has panel_click || return 0
	CP_MDRAG[$w]=
	panel_click "$w" "$r" "$c"
	dt_want 0
}

# Bind a view of these kinds, or bind it again when its place or words
# changed, telling its process `view NAME GEN H W KIND ARGS...`. A screen
# view that would cover another's place -- a module moved onto where
# another still is -- lets the others on the screen go first; each is bound
# again where it is next drawn, and since nothing of it is kept here then,
# its process is asked for all of it again (`again NAME`), or it would send
# only what changed since it last drew. Status 1 while there is no cells
# channel.
fn dt_rvxbind(name, p, c, pane, int r, int col, int h, int w, ...args) {
	local fd a x new=

	[ -n "$c" ] || return 1
	fd=${DT_RTCELLS["$c"]-}
	[ -n "$fd" ] || return 1
	a="$pane $r $col $h $w ${args[*]}"
	[ "${DT_RVX["$name"]-}" = "$c" ] && [ "${DT_RVXARGS["$name"]-}" = "$a" ] && return 0
	[ "${DT_RVX["$name"]-}" = "$c" ] || new=1
	DT_RVXGEN["$name"]=$((${DT_RVXGEN["$name"]:-0} + 1))
	if ! console cells own "$fd" "$name" "${DT_RVXGEN["$name"]}" "$pane" "$r" "$col" "$h" "$w" 2> /dev/null; then
		case $pane in - | bar) dt_rvxscreen "$name" "$pane" ;; esac
		if ! console cells own "$fd" "$name" "${DT_RVXGEN["$name"]}" "$pane" "$r" "$col" "$h" "$w"; then
			dt_log "app runtime: $name of $p could not be bound"
			return 1
		fi
	fi
	DT_RVX["$name"]=$c
	DT_RVXARGS["$name"]=$a
	DT_RVXP["$name"]=$p
	DT_RVXDIRTY["$name"]=1
	dt_rtpass force
	x := dt_rtline view "$name" "${DT_RVXGEN["$name"]}" "$h" "$w" "${args[@]}"
	dt_rtsay "$c" "$x"
	if [ -n "$new" ]; then
		x := dt_rtline again "$name"
		dt_rtsay "$c" "$x"
	fi
	return 0
}

# Let every view on the screen (or the bar) go here but one, each to be
# bound again where it is next drawn; its process keeps drawing it and is
# never told. The bar is drawn again for those on it.
fn dt_rvxscreen(but = "", pane = "-") {
	local n c fd

	[ "$pane" != bar ] || DT_BARWAS=
	for n in "${!DT_RVX[@]}"; do
		[ "$n" != "$but" ] && [[ ${DT_RVXARGS["$n"]-} == "$pane "* ]] || continue
		c=${DT_RVX["$n"]}
		fd=${DT_RTCELLS["$c"]-}
		[ -z "$fd" ] || console cells drop "$fd" "$n"
		DT_RVX["$n"]=
		unset DT_RVXARGS["$n"]
	done
	return 0
}

# Show a view's kept cells: those that changed, or all of them (-a) over a
# face just painted.
fn dt_rvxshow(name, all = "") {
	[ -n "${DT_RVX["$name"]-}" ] || return 0
	console cells show "$name" $all
	unset DT_RVXDIRTY["$name"]
	return 0
}

# A hosted pane's body, where panel_draw would have run its _draw: the
# panel's window w$ID, from row 1 and the body's left column bx, h by w,
# shown whole over the face the panel painted. The pane's own code writes
# into w$ID at those columns, so its view's origin is 1, bx.
fn dt_rvxpane(p, int id, int h, int w, int bx) {
	local n="p$id" oc=$bx vw=$w

	[ -z "${DT_RVXP["$n"]-}" ] || [ "${DT_RVXP["$n"]}" = "$p" ] || dt_rvxforget "$n"
	# A rows pane's scrollbar is the column past its rows, at the left
	# mirrored (cp_rowsdraw): its view takes that column in.
	if [[ ${DT_RVPK["$p"]-} == *" rows "* ]]; then
		vw=$((w + 1))
		[ "$DT_MIRRORON" != 1 ] || oc=$((bx - 1))
	fi
	dt_rvxbind "$n" "$p" "${DT_RVPC["$p"]-}" "w$id" 1 "$oc" "$h" "$vw" pane "$id" "$p" 1 "$oc" "$bx" \
		"${PW[$id]["side"]:-list}" || {
		dt_rvonce "pend:$n" "app runtime: pane $p waits for its process's cells; its face meanwhile"
		return 0
	}
	# The window it is drawn in is that process's to read (DT's rtpane),
	# so a dialog its pane opens is placed over it (dt_dlgat), as in-process.
	[ "${DT[$id]["rtpane"]-}" = "${DT_RTC["${DT_RVPC["$p"]}"]-}" ] ||
		DT[$id]["rtpane"]=${DT_RTC["${DT_RVPC["$p"]}"]-}
	dt_rvxshow "$n" -a
}

# A hosted module's slot of the strip, where dt_stripdraw would have run
# its _draw: one row of the module's width at the strip's row and column,
# shown whole over the strip just painted, lit while the pointer is over
# it as the strip lights it.
fn dt_rvxstrip(p, int row, int col) {
	local n="s$p" hv=0

	[ "${CS_MOD_LIST[${DT_HOTSTRIP:--1}]-}" = "$p" ] && [ -n "${DT_HOTSTRIP-}" ] && hv=1
	dt_rvxbind "$n" "$p" "${DT_RVPC["$p"]-}" - "$row" "$col" 1 "${CS_MODS["$p"]["w"]:-1}" strip "$p" "$hv" || return 0
	dt_rvxshow "$n" -a
}

# A hosted saver beginning, where sv_begin would have run its _start: the
# whole screen, which the modules' slots give up while it runs, shown over
# the screen sv_begin cleared; its frames show what changed.
fn dt_rvxsaver(p, int rows, int cols) {
	dt_rvxscreen v
	dt_rvxbind v "$p" "${DT_RVPC["$p"]-}" - 0 0 "$rows" "$cols" saver "$p" || return 0
	dt_rvxshow v -a
}

# A view goes: the panel showing another pane or closing, the saver
# stopping. Its process is told, and one left with no view ends by itself,
# or DT_RTENDSECS later.
fn dt_rvxforget(name) {
	local c=${DT_RVX["$name"]-} fd i p x

	unset DT_RVX["$name"] DT_RVXGEN["$name"] DT_RVXARGS["$name"] DT_RVXDIRTY["$name"] DT_RVXP["$name"]
	[[ $name != p* ]] || ! dt_iswin "${name#p}" || unset DT["${name#p}"]["rtpane"]
	[ -n "$c" ] || return 0
	fd=${DT_RTCELLS["$c"]-}
	[ -z "$fd" ] || console cells drop "$fd" "$name"
	if [ -n "${DT_RTC["$c"]+x}" ]; then
		x := dt_rtline forget "$name"
		dt_rtsay "$c" "$x"
	fi
	for i in "${!DT_RVC[@]}" "${!DT_RVX[@]}" "${!DT_RVB[@]}"; do
		[ "${DT_RVC[$i]-}" = "$c" ] || [ "${DT_RVX["$i"]-}" = "$c" ] || [ "${DT_RVB["$i"]-}" = "$c" ] && return 0
	done
	p=${DT_RTCPID["$c"]-}
	[ -z "$p" ] || DT_RTENDPID["$p"]=$((${EPOCHREALTIME/./} / 1000 + DT_RTENDSECS * 1000))
	return 0
}

# The panel showing a pane in window id: a view of another pane there goes.
fn dt_rvpaneseen(int id, pane = "") {
	[ "${DT_RVXP["p$id"]-}" = "$pane" ] || dt_rvxforget "p$id"
}

# A request connection going: its prefixes are this desktop's again -- until
# the crash track gives the person the choice (ADR 0050, Decision 7) -- and
# its views are let go, said in the log.
fn dt_rvxdrop(int c) {
	local p n f
	local -a ks

	for p in "${!DT_RVP[@]}"; do
		[ "${DT_RVPC["$p"]-}" = "$c" ] || continue
		dt_log "app runtime: the process drawing ${DT_RVP["$p"]} $p has gone"
		read -ra ks <<< "${DT_RVPK["$p"]}"
		for f in "${ks[@]}"; do
			unset DT_RVFN["${p}_$f"]
		done
		unset DT_RVP["$p"] DT_RVPC["$p"] DT_RVPF["$p"] DT_RVPK["$p"]
	done
	for n in "${!DT_RVX[@]}"; do
		[ "${DT_RVX["$n"]}" = "$c" ] || continue
		[ -z "${DT_RTCELLS["$c"]-}" ] || console cells drop "${DT_RTCELLS["$c"]}" "$n"
		unset DT_RVX["$n"] DT_RVXGEN["$n"] DT_RVXARGS["$n"] DT_RVXDIRTY["$n"] DT_RVXP["$n"]
	done
	# Its bar items go off the bar, as an ended app's windows close, an
	# open pop-up of one with it; its bar hooks are this desktop's again.
	for n in "${!DT_RVB[@]}"; do
		[ "${DT_RVB["$n"]}" = "$c" ] || continue
		unset DT_RVB["$n"]
		dt_log "app runtime: the process of bar item $n has gone; the item goes"
		[ "$DT_POPITEM" != "$n" ] || dt_popclose
		dt_rvhookback "${DT_BARI["$n"]["src"]-}"
		dt_baritem "$n" ""
	done
	for p in "${!DT_RVPOP[@]}"; do
		[ "${DT_RVPOP["$p"]}" = "$c" ] || continue
		unset DT_RVPOP["$p"] DT_RVFN["${p}_popdraw"] DT_RVFN["${p}_popmouse"] DT_RVFN["${p}_popkey"]
	done
	dt_want 0
	return 0
}

# The strip's list made again (cs_relist): a module its own process draws
# that is no longer on it goes, as a window goes when it closes.
dt_rvxstrips() {
	local n

	for n in "${!DT_RVX[@]}"; do
		[[ $n == s* ]] && [ -n "${DT_RVXP["$n"]-}" ] || continue
		[[ " ${CS_MOD_LIST[*]-} " == *" ${DT_RVXP["$n"]} "* ]] || dt_rvxforget "$n"
	done
	return 0
}

# A menu bar item its own process puts on the bar, by name: its request
# connection, empty while that process is being started. Its text, its
# command and every other change come as told requests (dt_baritem and the
# rest), each the process's own item only (dt_rvbmine); a drawn one's cells
# as a view, `bar` (NAME b$NAME, the bar's pane at the item's slot, ARGS
# NAME FN C HV); its press, command, wheel, switch and stop as calls, by the
# word the bar's seam calls fold in (${DT_RVB[$nm]+dt_rvbfn ROLE "$nm"}).
declare -gA DT_RVB

# Whether a bar item a process names is its own, as a change told by that
# process: one it put there, or one its file registered. A new one becomes
# that process's from now. Refused and said otherwise, and the item stays.
fn dt_rvbmine(name, what) {
	local o=${DT_BARI["$name"]["owner"]-}

	if [ -n "$o" ]; then
		o := dt_rvsrc "$o"
		if ! dt_rvmine "$DT_CALLER" "$o"; then
			dt_log "refused: $what: ${DT_CALLER:-an app} named the bar item $name, which is not its own"
			return 1
		fi
	fi
	DT_RVB["$name"]=$DT_RTFROM
	return 0
}

# A call from the bar's seam to an item its own process draws (ROLE, the
# item, the function it names, its words): its drawing shown from its
# cells; a press numbered as an ask the desktop never waits for, taken at
# once and, declined, the item's own command after it (bar:press); its
# command a request the desktop runs as the item's when it names one, a
# call to the process otherwise; the wheel, its switch and its stop told.
# While its process is being started nothing is drawn and nothing sent.
dt_rvbfn() {
	local role=$1 nm=$2 c=${DT_RVB["$2"]-} x

	shift 2
	if [ -z "$c" ]; then
		dt_rvonce "early:b$nm:$role" "app runtime: bar item $nm was given $role before its process said anything; not sent"
		[ "$role" != press ]
		return
	fi
	case $role in
	draw) dt_rvbdraw "$nm" "$@" ;;
	popdraw) dt_rvbpop "$nm" "$@" ;;
	popkey)
		# Taken at once, as a pane's key is: the pop-up is up and the key
		# was its; Escape closed it before it was offered.
		[ -z "${DT_RVX["o$nm"]-}" ] || console cells input "o$nm"
		x := dt_rvkinput "$c" kcall "pop:$nm:key"
		dt_rvxsend "$c" "$x" "$@"
		;;
	press)
		x := dt_rvkinput "$c" bpress "$nm:${2-left}"
		[ -z "${DT_RVX["b$nm"]-}" ] || console cells input "b$nm"
		dt_rvxsend "$c" "$x" "$@"
		;;
	do)
		if [ -n "${DT_RTALLOW["${1-}"]+x}" ] || [ -n "${DT_RTASK["${1-}"]+x}" ]; then
			DT_RTFROM=$c "$@"
			return
		fi
		dt_rvxsend "$c" 0 "$@"
		;;
	*) dt_rvxsend "$c" 0 "$@" ;;
	esac
}

# A press a hosted item's own handler declined, answered: its command runs,
# as the bar does with a press an item does not want.
fn dt_rvbpress(id, st = "") {
	local nm=${id%%:*}

	[ "$st" = 1 ] && [ -n "${DT_BARI["$nm"]["text"]+x}" ] || return 0
	dt_barido "$nm" "${id#*:}"
	dt_want 0
}

# A hosted item's drawing, where dt_barilay would have run its own: the
# bar's pane at the item's slot, its width the one laid out, shown whole
# over the bar just painted; lit while the pointer is over it.
fn dt_rvbdraw(nm, fn, int c, hv = 0) {
	local w=${DT_BARI["$nm"]["w"]:-0}

	[ "$w" -gt 0 ] || return 0
	dt_rvxbind "b$nm" "b:$nm" "${DT_RVB["$nm"]}" bar 0 $((c - ${DT_PRIMARY_COL:-0})) 1 "$w" bar "$nm" "$fn" "$c" "$hv" || return 0
	dt_rvxshow "b$nm" -a
}

# Start the process of the file that put a bar item there -- a test
# session's, as dt_rthostk is -- and host every item of that file from now.
fn dt_rthostb(name) {
	local f=${DT_BARI["$name"]["src"]-}

	[ -n "$f" ] || { dt_log "app runtime: no bar item $name with a file to start"; return 1; }
	dt_rthostf "$f" && ret -k
}
