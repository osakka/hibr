# wm/fullscreen -- a window taking every cell of its display (Gitea #405):
# no bar, no frame, no shadow, no Control Strip, for a game or a film. Zoom
# fills the display below the bar and keeps the window's frame; this is the
# rest of the way.
#
#   dt_fullscreen ID on|off|toggle
#
# The window's app is told whenever it changes, by the desktop as well as
# by itself, through an optional <app>_fullscreen ID on|off, and an app asks
# with dt_isfull. A display has one full-screen window at most. It ends when
# the window goes, when the saver or the lock comes up, and on the desktop's
# own Leave Full Screen key (Control Panel > Shortcuts), which no window can
# take -- as Release Pointer is for the pointer lock. Full Screen Ends says
# what else does (Control Panel > Windows): on click, the window losing the
# focus or any menu coming up; on shortcut, only a menu of the bar's while
# the window covers the display the bar is on, since that is the way back to
# the bar. While a window covers the bar's display the bar and the Control
# Strip stay away, and a note of high or urgent priority is one line along
# its bottom edge, the rest not drawn over it.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The windows in full screen, oldest first.
declare -ga DT_FULLS=()
# The one covering the display the bar is on, or empty.
DT_FULLBAR=

# Whether a window is in full screen.
fn dt_isfull(id) {
	local x

	for x in "${DT_FULLS[@]}"; do
		[ "$x" = "$id" ] && return 0
	done
	return 1
}

# Take a window off the list.
fn dt_fulltake(id) {
	local x
	local -a keep=()

	for x in "${DT_FULLS[@]}"; do
		[ "$x" = "$id" ] || keep+=("$x")
	done
	DT_FULLS=("${keep[@]}")
}

# Work out which window covers the bar's display. The bar's pane is the one
# above everything, and the console writes a top pane's cells only through
# it, so it steps down while a window has that display. The window is
# raised, never made top: a top pane takes cells only through itself, and a
# module that draws its half-block picture at absolute coordinates -- retro,
# xscr, media, web -- then drew nothing at all (hibr-boxer's report).
dt_fullbar() {
	local id was=$DT_FULLBAR

	DT_FULLBAR=
	for id in "${DT_FULLS[@]}"; do
		[ "${DT[$id]["row"]}" = "${DT_PRIMARY_ROW:-0}" ] &&
			[ "${DT[$id]["col"]}" = "${DT_PRIMARY_COL:-0}" ] && DT_FULLBAR=$id
	done
	[ "$DT_FULLBAR" = "$was" ] && return 0
	if [ -n "$DT_FULLBAR" ]; then
		console pane top bar off 2> /dev/null
	else
		DT_BARWAS=
		console pane top bar 2> /dev/null
	fi
	return 0
}

# The whole of the display a window is on, bar row included, into DTW_R,
# DTW_C, DTW_H and DTW_W.
fn dt_fullrect(int id) {
	local cr cc dsp dr dc drows dcols dgx

	cr=$((${DT[$id]["row"]} + ${DT[$id]["h"]} / 2))
	cc=$((${DT[$id]["col"]} + ${DT[$id]["w"]} / 2))
	DTW_R=${DT_PRIMARY_ROW:-0}
	DTW_C=${DT_PRIMARY_COL:-0}
	DTW_H=${DT_PRIMARY_H:-$DT_ROWS}
	DTW_W=${DT_PRIMARY_W:-$DT_COLS}
	for dsp in "${DT_DISPLAYS[@]}"; do
		IFS=' ' read -r dr dc drows dcols dgx <<< "$dsp"
		if [ "$cr" -ge "$dr" ] && [ "$cr" -lt $((dr + drows)) ] &&
		   [ "$cc" -ge "$dc" ] && [ "$cc" -lt $((dc + dcols)) ]; then
			DTW_R=$dr
			DTW_C=$dc
			DTW_H=$drows
			DTW_W=$dcols
			break
		fi
	done
	return 0
}

# Tell the window's app, when it asks to be told.
fn dt_fulltell(int id, how) {
	local ap=${DT[$id]["app"]}

	[ -n "$ap" ] && dt_has "${ap}_fullscreen" && "${ap}_fullscreen" "$id" "$how"
	return 0
}

# Put a window full screen, or back as it was, or the other one.
fn dt_fullscreen(int id, how) {
	local x

	[ -n "${DT[$id]["app"]+x}" ] || return 1
	case $how in
	toggle) if dt_isfull "$id"; then how=off; else how=on; fi ;;
	on | off) ;;
	*) return 2 ;;
	esac
	if [ "$how" = off ]; then
		dt_isfull "$id" && dt_fullend "$id"
		return 0
	fi
	dt_isfull "$id" && return 0
	[ -n "${DT[$id]["shaded"]-}" ] && dt_shade "$id"
	dt_fullrect "$id"
	for x in "${DT_FULLS[@]}"; do
		if [ "$DT_FULLEND" != shortcut ] ||
		   [ "${DT[$x]["row"]} ${DT[$x]["col"]}" = "$DTW_R $DTW_C" ]; then
			dt_fullend "$x"
		fi
	done
	DT[$id]["fsr"]=${DT[$id]["row"]}
	DT[$id]["fsc"]=${DT[$id]["col"]}
	DT[$id]["fsh"]=${DT[$id]["h"]}
	DT[$id]["fsw"]=${DT[$id]["w"]}
	DT[$id]["fschrome"]=${DT[$id]["chrome"]}
	DT[$id]["fsshadow"]=${DT[$id]["noshadow"]}
	DT_FULLS+=("$id")
	DT[$id]["chrome"]=none
	DT[$id]["noshadow"]=1
	DT_FOCUS=$id
	dt_fullfit "$id"
	DT_MENUIN=
	DT_FORCEONCE=1
	dt_fulltell "$id" on
	return 0
}

# The Full Screen key and the Window menu's row: the focused window, on or
# off. Whether it may is the caller's, as for Zoom: a fixed-size app may not.
dt_full_focused() { [ -n "$DT_FOCUS" ] && dt_fullscreen "$DT_FOCUS" toggle; }

# Size the full-screen window to its display again, as the display is now.
fn dt_fullfit(int id) {
	dt_fullrect "$id"
	DT[$id]["row"]=$DTW_R
	DT[$id]["col"]=$DTW_C
	DT[$id]["h"]=$DTW_H
	DT[$id]["w"]=$DTW_W
	console pane "w$id" "$DTW_R" "$DTW_C" "$DTW_H" "$DTW_W"
	[ "$DT_FOCUS" = "$id" ] && console pane raise "w$id"
	dt_fullbar
	return 0
}

# Put a full-screen window back where it was, with its frame, and say so.
fn dt_fullend(int id) {
	dt_fulltake "$id"
	DT_FORCEONCE=1
	DT_MENUIN=
	[ -n "${DT[$id]["app"]+x}" ] || { dt_fullbar; return 0; }
	DT[$id]["row"]=${DT[$id]["fsr"]}
	DT[$id]["col"]=${DT[$id]["fsc"]}
	DT[$id]["h"]=${DT[$id]["fsh"]}
	DT[$id]["w"]=${DT[$id]["fsw"]}
	DT[$id]["chrome"]=${DT[$id]["fschrome"]}
	DT[$id]["noshadow"]=${DT[$id]["fsshadow"]}
	dt_hidden "$id" || dt_away "$id" ||
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}" 2> /dev/null
	dt_fullbar
	dt_fulltell "$id" off
	return 0
}

# Every full-screen window back, for a restart.
dt_fullendall() {
	while [ "${#DT_FULLS[@]}" != 0 ]; do
		dt_fullend "${DT_FULLS[0]}"
	done
}

# The Leave Full Screen key: the focused window, or else the newest.
dt_fullleave() {
	if dt_isfull "$DT_FOCUS"; then
		dt_fullend "$DT_FOCUS"
	else
		dt_fullend "${DT_FULLS[${#DT_FULLS[@]} - 1]}"
	fi
}

# Whether a window has stopped being able to say it has its display.
fn dt_fullover(int id) {
	[ -n "$DT_SAVING$DT_LOCKED" ] && return 0
	dt_hidden "$id" && return 0
	dt_away "$id" && return 0
	if [ "$DT_FULLEND" = shortcut ]; then
		[ "$DT_FULLBAR" = "$id" ] && [ "$MB_OPEN" != -1 ] &&
			[ "${MB[$MB_OPEN]["bar"]}" = 1 ] && return 0
		return 1
	fi
	[ "$DT_FOCUS" != "$id" ] || [ "$MB_OPEN" != -1 ] || [ -n "$DT_POP" ]
}

# End full screen where a window can no longer be said to have the screen
# -- the same moments the pointer lock ends -- and follow a display that
# changed size. Asked once a pass, outside any drawing.
dt_fullcheck() {
	local id

	for id in "${DT_FULLS[@]}"; do
		if [ -z "${DT[$id]["app"]+x}" ]; then
			dt_fulltake "$id"
			DT_FORCEONCE=1
			continue
		fi
		if dt_fullover "$id"; then
			dt_fullend "$id"
			continue
		fi
		dt_fullrect "$id"
		[ "$DTW_R $DTW_C $DTW_H $DTW_W" = "${DT[$id]["row"]} ${DT[$id]["col"]} ${DT[$id]["h"]} ${DT[$id]["w"]}" ] ||
			dt_fullfit "$id"
	done
	dt_fullbar
	return 0
}

# Notes while a window is full screen: the newest of high or urgent
# priority as one line along the display's bottom edge, and the rest left
# to expire undrawn, the queue kept as dt_note_draw keeps it.
dt_fullnote() {
	local id now age t= keep_id=
	local -a keep

	now := dt_ms
	for id in "${DT_NOTEQ_ORDER[@]}"; do
		age=$((now - ${DT_NOTEQ[$id]["created"]}))
		if [ "$age" -ge "$DT_NOTEMS" ]; then
			unset "DT_NOTEQ[$id]"
			continue
		fi
		keep+=("$id")
		dt_want $((DT_NOTEMS - age))
		case ${DT_NOTEQ[$id]["prio"]} in high | urgent) keep_id=$id ;; esac
	done
	[ "${#keep[@]}" = "${#DT_NOTEQ_ORDER[@]}" ] || DT_FORCEONCE=1
	DT_NOTEQ_ORDER=("${keep[@]}")
	[ -n "$keep_id" ] || return 0
	# Through the window's own pane, above everything it covers.
	t := dt_cut " ${DT_NOTEQ[$keep_id]["text"]} " "${DT[$DT_FULLBAR]["w"]}"
	console pen "$DT_SELINK" "$DT_ACTIVE"
	console fill -p "w$DT_FULLBAR" $((${DT[$DT_FULLBAR]["h"]} - 1)) 0 1 "${DT[$DT_FULLBAR]["w"]}" " "
	console put -p "w$DT_FULLBAR" $((${DT[$DT_FULLBAR]["h"]} - 1)) 0 "$t"
	return 0
}
