# wm/bar -- the menu bar's own contents on the right: its items, which since
# Gitea #392 are the application menu, the clock, the notification icon and
# the workspace numbers too, each a file in menubar/.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The bar clock's own strftime format, chosen in Date & Time. The clock is
# an item (menubar/clock.hibr), so a wider format moves everything beyond
# it along and the clicks follow, rather than overrunning the application
# menu.
DT_BARTIME="${DT_BARTIME-%H:%M}"

# Cells between the dot, the clock and the application menu, 1 to 4. The
# default, 2, is the rhythm the menu titles on the left already have from
# the space either side of each name.
DT_BARGAP="${DT_BARGAP-2}"

# The notification icon in the bar, by name -- see dt_bellglyph. flag is
# the default because it is not an emoji: every monospace font has it, one
# cell wide. The bell is, and a terminal without an emoji font draws it as
# an empty box, or counts it one cell wide and pushes the clock along.
DT_BELLICON="${DT_BELLICON-flag}"
DT_BELLICONS=(flag bell note mail dot diamond star)
# The rectangle the bar's own pane was last made for, so it is made once and
# then only when the screen changes shape. A pane is a name and a rectangle
# with no cells of its own; what it buys here is that the bar's cells become
# the bar's -- the wallpaper paints behind it rather than over it, so a frame
# that changes nothing on the bar need not draw it (Gitea #161).
#
# The columns everything stores -- MB[i]["x"], MB_AX, every item's
# DT_BARI[name]["c"] -- stay ABSOLUTE, because that is what a mouse report carries and
# what every hit test already compares against. The pane's origin is
# subtracted at the `put`, in one place (dt_barput), and nowhere else.
DT_BARPANE=
# What the bar drew last, as one string of everything it reads. Compared to
# decide whether this frame need draw it at all -- the shape dt_alone uses
# for the windows' geometry and dt_clocktext for the clock, one level up.
DT_BARWAS=

# Where the bar's items are found (Gitea #392), read in the same order as
# every other scan list (ADR 0045): a file of your own in ~/.config first,
# then the machine's scope, then what the catalogue placed for you, and
# what hibr ships last -- desktop.hibr appends that one itself, so a
# desktop that loads no session still has its clock and its menus.
dt_barsys=
command -v dt_sysdir > /dev/null && dt_barsys := dt_sysdir menubar
DT_BARDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/menubar"
	${dt_barsys:+"$dt_barsys"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/menubar")
unset dt_barsys
# Which file each item file's name was taken from, the first scope to have
# it winning, as an app's is.
declare -gA DT_BARSRC

dt_menubar() {
	local d f b

	for d in "${DT_BARDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			[ -n "${DT_BARSRC["$b"]}" ] && continue
			DT_BARSRC["$b"]=$f
			DT_LOADING=$f
			. "$f"
			DT_LOADING=
		done
	done
}

# A file of menubar/ that went while the desktop ran: what it registered,
# kept for the day it comes back, as cs_rescan keeps a strip module's.
declare -gA DT_BARGONEB
declare -gA DT_BARGONEH

# Read the item folders again, for dt_rescan (Gitea #267, #392), with the
# same three answers as the other loaders: "added removed changed". An item
# whose file went is taken off the bar and what it ran is stopped -- its
# hooks, its tickers and its own stop -- and one that changed is marked,
# never sourced a second time.
dt_barrescan() {
	local d f b w nm h before gone=0 changed=0 t
	local -A win
	local -a keep

	# The shipped folder last, which holds the window manager's own items
	# whether or not a session listed it.
	for d in "${DT_BARDIRS[@]}" "$DT_HERE/menubar"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			[ -n "${win["$b"]}" ] || win["$b"]=$f
		done
	done
	for b in "${!DT_BARSRC[@]}"; do
		f=${DT_BARSRC["$b"]}
		w=${win["$b"]}
		if [ -z "$w" ]; then
			for nm in "${DT_BARIN[@]}"; do
				[ "${DT_BARI["$nm"]["src"]-}" = "$f" ] || continue
				h=${DT_BARI["$nm"]["stop"]-}
				[ -n "$h" ] && dt_has "$h" && "$h"
				dt_baritem "$nm" ""
			done
			keep=()
			t=
			for h in "${DT_BARHOOKS[@]}"; do
				if [ "${DT_BARHOOKSRC["$h"]-}" = "$f" ]; then
					t="$t${t:+ }$h"
				else
					keep+=("$h")
				fi
			done
			DT_BARHOOKS=("${keep[@]}")
			DT_BARGONEH["$b"]=$t
			dt_has dt_tickoff && dt_tickoff "$f"
			DT_BARGONEB["$b"]=$f
			unset DT_BARSRC["$b"]
			gone=$((gone + 1))
		elif [ "$w" != "$f" ] || dt_scanold "$f"; then
			[ -n "${DT_STALE["$f"]+x}" ] && continue
			dt_stale "$f" "${b%.hibr}"
			changed=$((changed + 1))
		fi
	done
	# One that went and is back runs again, and is marked: what it
	# stopped when it went is only started anew by a restart.
	for b in "${!win[@]}"; do
		[ -z "${DT_BARSRC["$b"]}" ] && [ -n "${DT_BARGONEB["$b"]}" ] || continue
		f=${DT_BARGONEB["$b"]}
		unset DT_BARGONEB["$b"]
		DT_BARSRC["$b"]=$f
		read -ra keep <<< "${DT_BARGONEH["$b"]-}"
		for h in "${keep[@]}"; do dt_barhook "$h"; done
		unset DT_BARGONEH["$b"]
		dt_has dt_tickon && dt_tickon "$f"
		dt_stale "$f" "${b%.hibr}"
		changed=$((changed + 1))
	done
	before=${#DT_BARSRC[@]}
	dt_menubar
	DT_BARWAS=
	ret "$((${#DT_BARSRC[@]} - before)) $gone $changed"
}

# The bar items that are the window manager's own -- a file of menubar/
# whose header says `# platform:` -- from the shipped folder, after any of
# the same name a person's scope already gave.
dt_menuplat() {
	local f b l pl

	for f in "$DT_HERE"/menubar/*.hibr; do
		[ -r "$f" ] || continue
		b=${f##*/}
		[ -n "${DT_BARSRC["$b"]}" ] && continue
		pl=
		while IFS= read -r l; do
			case $l in "# platform:"*) pl=1; break ;; "#"*) ;; *) break ;; esac
		done < "$f"
		[ -n "$pl" ] || continue
		DT_BARSRC["$b"]=$f
		DT_LOADING=$f
		. "$f"
		DT_LOADING=
	done
	return 0
}

# Items an app has put on the bar, left of the notification icon.
#
# **What a bar item is for, which is the question Gitea #160 had to answer
# before anything was built:** a Control Strip module is a glyph and a
# click, and where it sits is the *person's* choice -- they drag the strip
# about. A bar item is **a state that changes**, laid out by the bar beside
# the clock, where a person's eye already goes for "what is going on":
# messages waiting, a sync in flight, a vault left unlocked. If what an app
# wants is a button, it wants cs_module.
#
# The text is a value the app *sets when it changes*, never a callback the
# bar asks per frame. That is not a style preference: the bar is composed on
# every frame it draws, so a callback would be a per-frame cost that grows
# with the number of apps installed -- and worse, it is the dt_want trap in
# a new hat, since an app computing its own text per frame has no way to say
# "nothing changed". Setting an item clears the bar's gate, so the next
# frame draws and the frames after it do not.
#
# ["text"] is what is drawn, ["cmd"] the words to run when it is clicked
# (kept as words, not a string -- a value with a space in it reached its
# callback as two arguments the last time this desktop joined them), and
# ["c"]/["w"] where it landed, filled in as it is drawn, for dt_barihit to
# resolve a click against. The order is registration order, which puts the
# first app to ask nearest the clock.
declare -gA DT_BARI
declare -ga DT_BARIN
DT_CONFIRM=
DT_CONFIRM_CMD=
DT_CONFIRM_FOCUS=
DT_ROWS=24
DT_COLS=80

# Put an item on the bar, or change what it says. An empty text takes it
# off: an app with nothing to report should show nothing, not a blank gap,
# and "set it to empty" is one call rather than two.
#
# Clears the bar's gate, which is the whole of what an app has to think
# about: call this when the thing changes and the bar draws once.
fn dt_baritem(name, text = "", ...cmd) {
	local i=0 n=${#DT_BARIN[@]}

	[ -n "$name" ] || return 1
	while [ "$i" -lt "$n" ]; do
		[ "${DT_BARIN[$i]}" = "$name" ] && break
		i=$((i + 1))
	done
	if [ "$i" = "$n" ]; then
		DT_BARIN+=("$name")
		# Which file put it there, so a rescan that finds the file gone
		# can take it off again (dt_barrescan).
		DT_BARI["$name"]["src"]=${DT_LOADING-}
	fi
	DT_BARI["$name"]["text"]=$text
	DT_BARI["$name"]["argc"]=${#cmd[@]}
	i=0
	while [ "$i" -lt "${#cmd[@]}" ]; do
		DT_BARI["$name"]["a$i"]=${cmd[$i]}
		i=$((i + 1))
	done
	DT_BARWAS=
	return 0
}

# What an item is called where a person chooses its place on the bar
# (Control Panel > Appearance > Item Order): set by its owner beside its
# dt_baritem, so nothing else keeps a list of who puts what on the bar
# (Gitea #341).
fn dt_barilabel(name, label) {
	DT_BARI["$name"]["label"]=$label
}

# The items in the order dt_barilay places them -- nearest the notification
# icon first -- into DT_BARSEQ. DT_BARORDER names items in the order they
# read across the bar; one it does not name follows in the order it
# registered, and a name no item has is passed over, so with it empty the
# bar is exactly as it was before there was a setting (Gitea #341).
declare -ga DT_BARSEQ
dt_barseq() {
	local nm i
	local -a want rd

	read -ra want <<< "${DT_BARORDER-}"
	for nm in "${want[@]}"; do
		case " ${DT_BARIN[*]} " in *" $nm "*) ;; *) continue ;; esac
		[ -n "${DT_BARI["$nm"]["pin"]-}" ] && continue
		case " ${rd[*]-} " in *" $nm "*) continue ;; esac
		rd+=("$nm")
	done
	i=$((${#DT_BARIN[@]} - 1))
	while [ "$i" -ge 0 ]; do
		nm=${DT_BARIN[$i]}
		[ -n "${DT_BARI["$nm"]["pin"]-}" ] && { i=$((i - 1)); continue; }
		case " ${want[*]-} " in *" $nm "*) ;; *) rd+=("$nm") ;; esac
		i=$((i - 1))
	done
	DT_BARSEQ=()
	i=$((${#rd[@]} - 1))
	while [ "$i" -ge 0 ]; do
		DT_BARSEQ+=("${rd[$i]}")
		i=$((i - 1))
	done
}

# Open an item's menu beneath it, built by <who>_context: at the first row
# under the bar and the item's own column. An item never works out a row of
# its own -- the bar is on the primary, which in a stacked union is not at
# the top, and the sound menu given row 1 opened on the display above the
# bar (owner, 2026-10-19). tests/540-examples.t refuses a literal row.
fn dt_barmenu(name, who, id = "") {
	local r

	r := dt_ptop
	dt_context_open "$who" "$id" "$r" "${DT_BARI["$name"]["c"]:-${DT_PRIMARY_COL:-0}}"
}

# What the wheel over an item runs, given up or down; an item with none
# lets the wheel go on to whatever is under the bar.
fn dt_bariwheel(name, fn) {
	DT_BARI["$name"]["wheel"]=$fn
}

# What a right click on an item runs, its words kept as words; an item
# with none runs the same thing for either button.
fn dt_bariright(name, ...cmd) {
	local i=0

	DT_BARI["$name"]["rargc"]=${#cmd[@]}
	while [ "$i" -lt "${#cmd[@]}" ]; do
		DT_BARI["$name"]["r$i"]=${cmd[$i]}
		i=$((i + 1))
	done
}


# A small panel of an item's own beneath it -- the speaker's volume slider
# (Gitea #310) -- placed as an item's menu is, at the first row under the
# bar and the item's own column, kept on the primary. It is drawn over the
# finished frame like a menu and goes like one: a press outside it, escape,
# or any key its owner has no use for. Its owner offers <who>_popdraw (row,
# column, height, width, all on the screen), <who>_popmouse (an action --
# press, drag, release, or up and down for the wheel -- and a row and column inside
# the panel, counted from 0) and, if it takes keys, <who>_popkey.
DT_POP=
DT_POPITEM=
DT_POPR=0
DT_POPC=0
DT_POPH=0
DT_POPW=0
DT_POPHELD=
fn dt_baripop(name, who, int h, int w) {
	dt_popat "$name" "$who" "${DT_BARI["$name"]["c"]:-${DT_PRIMARY_COL:-0}}" \
		"$h" "$w"
}

# Open who's panel h by w beneath the bar at column c, kept on the primary,
# for the bar thing called name -- an item, or the notification icon, which
# is the desktop's own and no item (Gitea #373's sibling: the bell's panel).
# A second call for the same owner closes it.
fn dt_popat(name, who, int c, int h, int w) {
	local r pl pr pbot

	if [ "$DT_POP" = "$who" ]; then
		dt_popclose
		return 0
	fi
	dt_mclose
	r := dt_ptop
	pbot := dt_pbot
	pl=${DT_PRIMARY_COL:-0}
	pr=$((pl + ${DT_PRIMARY_W:-$DT_COLS}))
	[ $((c + w)) -gt "$pr" ] && c=$((pr - w))
	[ "$c" -lt "$pl" ] && c=$pl
	[ $((r + h)) -gt "$pbot" ] && h=$((pbot - r))
	DT_POP=$who
	DT_POPITEM=$name
	DT_POPR=$r
	DT_POPC=$c
	DT_POPH=$h
	DT_POPW=$w
	DT_POPHELD=
	dt_want 10
}

fn dt_popclose() {
	[ -n "$DT_POP" ] || return 0
	DT_POP=
	DT_POPITEM=
	DT_POPHELD=
	dt_want 10
}

# Whether screen row r, column c is inside the open panel.
fn dt_pophit(int r, int c) {
	[ -n "$DT_POP" ] || return 1
	[ "$r" -ge "$DT_POPR" ] && [ "$r" -lt $((DT_POPR + DT_POPH)) ] &&
		[ "$c" -ge "$DT_POPC" ] && [ "$c" -lt $((DT_POPC + DT_POPW)) ]
}

# Tell the owner about the mouse, at screen row r, column c.
fn dt_popmouse(act, int r, int c) {
	"${DT_POP}_popmouse" "$act" $((r - DT_POPR)) $((c - DT_POPC))
	dt_want 10
}

# Draw the open panel, with a shadow as a menu has one, -s so a panel drawn
# on every frame it stays open is not darker each time.
dt_popdraw() {
	[ -n "$DT_POP" ] || return 0
	if ! dt_has "${DT_POP}_popdraw"; then
		DT_POP=
		return 0
	fi
	[ "$DT_MSHADOW" = 1 ] &&
		dt_castshadow "$DT_POPR" "$DT_POPC" "$DT_POPH" "$DT_POPW"
	console pen "$DT_INK" "$DT_FACE"
	console fill "$DT_POPR" "$DT_POPC" "$DT_POPH" "$DT_POPW" " "
	"${DT_POP}_popdraw" "$DT_POPR" "$DT_POPC" "$DT_POPH" "$DT_POPW"
}

# Which item is at column c on the bar, if any. A bare `return 1` on a
# miss and no `ret ""`: ret ends the function, so the caller of a `:=`
# would see status 0 and the slot's last value -- the trap dt_mhit's own
# comment records.
fn dt_barihit(int c) {
	local nm

	for nm in "${DT_BARIN[@]}"; do
		[ -n "${DT_BARI["$nm"]["w"]}" ] || continue
		[ "${DT_BARI["$nm"]["w"]}" -gt 0 ] || continue
		[ "$c" -ge "${DT_BARI["$nm"]["c"]}" ] &&
		[ "$c" -lt $((DT_BARI["$nm"]["c"] + DT_BARI["$nm"]["w"])) ] &&
			{ ret "$nm"; return 0; }
	done
	return 1
}

# Run what an item was registered with, its words as words -- or, for a
# right click, what dt_bariright gave it, when it gave anything.
fn dt_barido(name, btn = "") {
	local i=0 n=${DT_BARI["$name"]["argc"]:-0} p=a
	local -a a

	if [ "$btn" = right ] && [ "${DT_BARI["$name"]["rargc"]:-0}" -gt 0 ]; then
		n=${DT_BARI["$name"]["rargc"]}
		p=r
	fi
	[ "$n" -gt 0 ] || return 0
	while [ "$i" -lt "$n" ]; do
		a+=("${DT_BARI["$name"]["$p$i"]}")
		i=$((i + 1))
	done
	"${a[@]}"
}

# The places on the bar an item may pin itself to, rather than take its turn
# in DT_BARORDER (Gitea #392): the four that were the bar's own until then --
# the application menu, the clock, the notification icon and the workspace
# numbers -- are items now, in files of menubar/ like anybody's, and pin is
# what keeps each where it has always been. A positive pin is counted from
# the outer end of the bar, 1 the application menu's own corner; a negative
# one sits beyond every ordinary item, -1 nearest them. An ordinary item is
# never pinned and is the only kind Item Order offers to move.
fn dt_baripin(name, int n) {
	DT_BARI["$name"]["pin"]=$n
}

# A width the item keeps whatever its text measures, and how many of those
# cells already count as the gap on the side facing the next item: the
# application menu keeps fourteen for a name of up to eleven columns, and
# its own leading space is one of the gap's.
fn dt_bariwide(name, int w, int adj = 0) {
	DT_BARI["$name"]["rw"]=$w
	DT_BARI["$name"]["gadj"]=$adj
}

# An item that draws itself rather than being its text under one pen: fn is
# given the column it landed at and whether the pointer is over it. The text
# is still what is measured, and what says whether there is anything to draw.
fn dt_baridraw(name, fn) {
	DT_BARI["$name"]["draw"]=$fn
}

# What a press on an item runs, given the button, the row and the absolute
# column -- for an item whose parts mean different things (the workspace
# numbers), or that opens something at the pointer. A status of 1 says it
# did not want this press, which then goes on to the bar's own menu.
fn dt_baripress(name, fn) {
	DT_BARI["$name"]["press"]=$fn
}

# What runs at the top of every frame's bar, before its gate: an item whose
# text follows the desktop's own state -- the clock's minute, the count of
# notes, the focused app's name -- keeps it here, and calls dt_baritem only
# when it changed, which is what clears the gate. These are the desktop's
# own, each reading a value already cached, which is what makes a per-frame
# call fair where the comment on DT_BARI refuses one for an app's text.
declare -ga DT_BARHOOKS
declare -gA DT_BARHOOKSRC
fn dt_barhook(fn) {
	case " ${DT_BARHOOKS[*]-} " in *" $fn "*) return 0 ;; esac
	DT_BARHOOKS+=("$fn")
	DT_BARHOOKSRC["$fn"]=${DT_LOADING-}
}

# What stops whatever an item keeps running -- a watcher on a program --
# when its file is taken away while the desktop runs.
fn dt_baristop(name, fn) {
	DT_BARI["$name"]["stop"]=$fn
}

# The bar's items in the order they are laid out from the outer end inwards:
# the pinned ones by their place, every ordinary one in DT_BARSEQ's order,
# then those pinned beyond them.
declare -ga DT_BARLAY
dt_barlist() {
	local nm p i top=0

	for nm in "${DT_BARIN[@]}"; do
		p=${DT_BARI["$nm"]["pin"]-}
		[ -n "$p" ] || continue
		[ "${p#-}" -gt "$top" ] && top=${p#-}
	done
	DT_BARLAY=()
	for ((i = 1; i <= top; i++)); do
		for nm in "${DT_BARIN[@]}"; do
			[ "${DT_BARI["$nm"]["pin"]-}" = "$i" ] && DT_BARLAY+=("$nm")
		done
	done
	dt_barseq
	for nm in "${DT_BARSEQ[@]}"; do
		[ -n "${DT_BARI["$nm"]["pin"]-}" ] && continue
		DT_BARLAY+=("$nm")
	done
	for ((i = 1; i <= top; i++)); do
		for nm in "${DT_BARIN[@]}"; do
			[ "${DT_BARI["$nm"]["pin"]-}" = "-$i" ] && DT_BARLAY+=("$nm")
		done
	done
}

# Lay every item out from the bar's outer end -- the right, or the left when
# mirrored -- and draw it, gap cells between each. The first is always
# placed; one after it that would reach the app menus' titles gives way, no
# width and so no click, exactly as the clock and the icon always did, and
# the next is tried against the same place.
fn dt_barilay(int gap) {
	local nm t iw c n=0 pc pw=0 pg=0 hv d

	pc=$((DT_PRIMARY_COL + ${DT_PRIMARY_W:-$DT_COLS}))
	case $DT_MIRRORON in 1) pc=$DT_PRIMARY_COL ;; esac
	MB_AX=-100000
	case $DT_MIRRORON in 1) ;; *) MB_AX=100000 ;; esac
	dt_barlist
	for nm in "${DT_BARLAY[@]}"; do
		t=${DT_BARI["$nm"]["text"]}
		DT_BARI["$nm"]["w"]=0
		[ -n "$t" ] || continue
		iw=${DT_BARI["$nm"]["rw"]-}
		[ -n "$iw" ] || iw := str width "$t"
		case $DT_MIRRORON in
		1)
			c=$pc
			[ "$n" -gt 0 ] && c=$((pc + pw + gap - pg))
			[ "$n" -gt 0 ] && [ $((c + iw)) -gt "$DT_MENUSTART" ] && continue
			;;
		*)
			c=$((pc - iw))
			[ "$n" -gt 0 ] && c=$((pc - gap + pg - iw))
			[ "$n" -gt 0 ] && [ "$c" -le "$DT_MENUEND" ] && continue
			;;
		esac
		DT_BARI["$nm"]["c"]=$c
		DT_BARI["$nm"]["w"]=$iw
		pc=$c
		pw=$iw
		pg=${DT_BARI["$nm"]["gadj"]:-0}
		n=$((n + 1))
		hv=0
		[ "$nm" = "$DT_HOVERBI" ] && hv=1
		d=${DT_BARI["$nm"]["draw"]-}
		if [ -n "$d" ]; then
			"$d" "$c" "$hv"
		else
			dt_bariput "$nm" "$c" "$t"
		fi
	done
	return 0
}

# One bar item, on the well colour while the pointer is over it.
fn dt_bariput(nm, int c, t) {
	if [ "$nm" = "$DT_HOVERBI" ]; then
		console pen "$DT_INK" "$DT_WELL"
		dt_barput "$c" "$t"
		console pen "$DT_INK" "$DT_BAR"
		return 0
	fi
	dt_barput "$c" "$t"
}

# Write into the bar's own pane, given an absolute column.
#
# One place does the subtraction, and it is the only thing in this file that
# knows the bar is paned: everything stored stays absolute, so dt_mhit,
# dt_wshit and the click handling in wm/input.hibr are untouched by the move.
fn dt_barput(int col, t) {
	console put -p bar 0 $((col - DT_PRIMARY_COL)) "$t"
}

# When the bar must be drawn again: anything it reads having changed. The
# clock is in here as the text it rendered, not as the time, so a frame
# inside the same minute is a frame the bar can be left alone on.
#
# Derived from the values rather than hooked into whatever sets them, like
# dt_alone's own signature -- so a setting added later cannot forget to say
# it changed. Nothing here is a cost worth caching: it is a string of about
# twenty variables, against the 0.19 ms of actually composing the row.
dt_barkey() {
	local k

	# Not MB_AX: the application menu's own item sets it as it is drawn,
	# so it is an answer of this drawing rather than something it reads.
	k="$MB_OPEN|$MB_PAR|$MB_APP|$MB_N|$DT_NOTEUNSEEN|$DT_UPNEW|$DT_UPAPPS|$DT_UPSESSION"
	k="$k|$DT_CLOCKWAS|$DT_WS|$DT_WSN|$DT_MIRRORON|$DT_PRIMARY_W"
	k="$k|$DT_PRIMARY_COL|$DT_PRIMARY_ROW|$DT_PRIMARY_H"
	k="$k|$DT_BARGAP|$DT_BELLICON|$DT_PBAR|$DT_MENUBOLD"
	k="$k|$DT_BARTIME|$DT_BARSHADOW|$DT_INK|$DT_BAR|$DT_ACTIVE|$DT_IDLE"
	k="$k|$DT_GLYPHSET|$DT_LANG|$DT_DIGITS|$DT_SHADOW_PCT|$DT_MENUIN"
	# The items are not in here: dt_baritem clears the gate itself, which
	# is one place rather than a join of every app's text on every frame.
	ret "$k"
}

# Put the bar's own pane on the primary's top row, when that has moved.
# Called by dt_bar, and by dt_size the moment the displays change (Gitea
# #353's sibling, the restart report): a frame draws the windows before the
# bar, and a bar pane still where the primary used to be -- the whole top
# row, before a display joined on the left -- is above everything, so the
# title row of a window now under its old place was blocked, then left
# blank once the bar moved, and stayed blank until something redrew it.
dt_barpane() {
	local w=${DT_PRIMARY_W:-$DT_COLS}

	if [ "$DT_BARPANE" != "$DT_PRIMARY_ROW $DT_PRIMARY_COL $w" ]; then
		console pane bar "$DT_PRIMARY_ROW" "$DT_PRIMARY_COL" 1 "$w"
		# Above everything: a window dragged over the bar, its shadow,
		# a menu or a picture goes under it, since the console writes
		# a top pane's cells only through the pane itself.
		console pane top bar
		DT_BARPANE="$DT_PRIMARY_ROW $DT_PRIMARY_COL $w"
		DT_BARWAS=
	fi
	return 0
}

# Draw the bar itself.
dt_bar() {
	local i=0 t line gap key hk w=${DT_PRIMARY_W:-$DT_COLS}

	# Its own pane, made once and then only when the screen changes shape.
	# cn_pset throws the pane-ownership map away on every call, so this is
	# gated rather than set every frame.
	# The primary display's own top row, which is 0 for every desktop
	# that is not part of a stacked union -- and was written as a literal
	# 0 until 0.99.205, with a comment saying the bar's row was the one
	# piece of its geometry that is not a variable. It is one now
	# (Gitea #240): a primary below a join starts partway down the union,
	# and a bar at row 0 there is a bar drawn on somebody else's display.
	dt_barpane
	# The shadow is cast before the gate, on every frame, because it falls
	# on the row *below* the bar -- outside the bar's own pane, so those
	# cells are not the bar's to keep. A window redrawing near them clears
	# the mark `console darken -s` left (any ordinary write does: cn_put
	# assigns the pen's attributes), and on a gated frame nothing would
	# put it back: the bar's shadow would vanish during a drag and come
	# back when the bar next drew. That is the shadow family of 0.99.82
	# and 0.99.84 for the third time, and the drag oracle caught it here
	# rather than a person seeing it flicker.
	#
	# -s: idempotent, so casting it on every frame cannot come out darker
	# each time. Pairing it to "a frame that painted the wallpaper"
	# instead made this very strip pulse once a second.
	# Across the whole width, so with no offset; Half Block makes it half
	# a row (Gitea #340).
	if [ "$DT_BARSHADOW" = 1 ]; then
		if [ "$DT_SHADOWSHAPE" != cols ] && [ "$DT_GLYPHSET" != ascii ]; then
			console darken -s -t $((DT_PRIMARY_ROW + 1)) "$DT_PRIMARY_COL" \
				1 "$w" "$DT_SHADOW_PCT"
		else
			console darken -s $((DT_PRIMARY_ROW + 1)) "$DT_PRIMARY_COL" \
				1 "$w" "$DT_SHADOW_PCT"
		fi
	fi
	# The items whose text follows the desktop's own state bring it up to
	# date first -- the clock's minute is part of the key through
	# DT_CLOCKWAS, and every other change clears the gate itself through
	# dt_baritem. Before the gate, never inside it: gating a drawing takes
	# with it whatever asks for the next frame from inside it, and the
	# clock's hook is the thing that wakes an idle desktop once a minute.
	for hk in "${DT_BARHOOKS[@]}"; do "$hk"; done
	key := dt_barkey
	# Two things can make the cells underneath wrong without anything in
	# that key moving -- a screen saver's own `console clear` outside the
	# frame loop, and an overlay that covered this row and has gone -- and
	# neither can be seen from here: dt_draw clears DT_BARWAS for both,
	# at the top of the frame, where the flags for them are still set.
	# DT_FORCEDRAW is the oracle's, which is what makes a wrong key here
	# something a test can catch rather than something a person notices.
	# Compared against 1, never tested for emptiness: its default is the
	# string "0", so `-z` is false for every desktop and the gate would
	# never have fired at all -- measured as the bar drawing on all four
	# of four identical frames. dt_wallkeep and dt_wantdraw both compare
	# it the same way; one reader doing it differently is one too many.
	if [ "$key" = "$DT_BARWAS" ] && [ "$DT_FORCEDRAW" != 1 ]; then
		return 0
	fi
	DT_BARWAS=$key

	# The bar's own colour shows what is under it through; an open title
	# or the one under the pointer, drawn in another, stays itself.
	console layer
	[ "${DT_BARTRANS:-0}" != 0 ] &&
		console translucent "$DT_BARTRANS" "$DT_BAR" "$DT_BAR"
	console pen "$DT_INK" "$DT_BAR"
	line := dt_rep "$w" " "
	dt_barput "$DT_PRIMARY_COL" "$line"

	DT_MENUEND=0
	DT_MENUSTART=$((DT_PRIMARY_COL + w))
	while [ "$i" -lt "$MB_N" ]; do
		if [ "${MB[$i]["bar"]}" != 1 ]; then
			i=$((i + 1))
			continue
		fi
		t=${MB[$i]["title"]}
		# MB[i]["tw"] is already how many columns this title occupies,
		# spaces and all -- dt_layout works it out. Measuring it a
		# second time here, and in characters, is how the two came to
		# disagree about a title holding a wide glyph.
		[ $((MB[$i]["x"] + MB[$i]["tw"])) -gt "$DT_MENUEND" ] &&
			DT_MENUEND=$((MB[$i]["x"] + MB[$i]["tw"]))
		[ "${MB[$i]["x"]}" -lt "$DT_MENUSTART" ] && DT_MENUSTART=${MB[$i]["x"]}
		if [ "$i" = "$MB_OPEN" ] || [ "$i" = "$MB_PAR" ]; then
			console pen "$DT_BAR" "$DT_ACTIVE" bold
		elif [ "$i" = "$DT_HOVERMT" ]; then
			console pen "$DT_INK" "$DT_WELL" bold
		elif [ "$i" = 0 ]; then
			console pen "$DT_ACTIVE" "$DT_BAR" bold
		elif [ "$DT_MENUBOLD" = 1 ]; then
			console pen "$DT_INK" "$DT_BAR" bold
		else
			console pen "$DT_INK" "$DT_BAR"
		fi
		dt_barput "${MB[$i]["x"]}" " $t "
		i=$((i + 1))
	done

	# DT_BARGAP cells between each item on the right -- the application
	# menu's own leading space is one of them.
	gap=${DT_BARGAP:-2}
	[ "$gap" -lt 1 ] && gap=1
	[ "$gap" -gt 4 ] && gap=4
	dt_barilay "$gap"
	[ "${DT_BARTRANS:-0}" != 0 ] && console translucent off
	return 0
}

# The glyph a notification icon name stands for -- its Nerd Font icon in
# the nerd and blit sets, which have one for each (Gitea #330), where the
# emoji bell is two cells in most fonts and the rest are text symbols.
fn dt_bellglyph(style) {
	case $DT_GLYPHSET in
	nerd | blit)
		case $style in
		bell) ret $'\uf0f3' ;;
		note) ret $'\uf001' ;;
		mail) ret $'\uf0e0' ;;
		dot) ret $'\uf111' ;;
		diamond) ret $'\uf219' ;;
		star) ret $'\uf005' ;;
		*) ret $'\uf024' ;;
		esac
		;;
	esac
	case $style in
	bell) ret "🔔" ;;
	note) ret "♪" ;;
	mail) ret "✉" ;;
	dot) ret "●" ;;
	diamond) ret "◆" ;;
	star) ret "✱" ;;
	*) ret "⚑" ;;
	esac
}

# A time in a strftime format, as the bar draws it: epoch seconds, or -1
# for now. Leading blanks go, so %l's space-padded hour does not leave a
# gap against the bell.
# The last answer and what it was for, because the bar asks for this on
# every frame and it can change at most once a second -- while the Hijri
# codes (ADR 0034) cost three module calls, 2.4 ms together, to say what
# changes once a day.
DT_CLOCKKEY=
DT_CLOCKWAS=

fn dt_clocktext(fmt, int when) {
	local out f=$fmt t=$when wd mo n s key

	[ "$t" -lt 0 ] && t=$EPOCHSECONDS
	# Everything the answer depends on, so a language, calendar or
	# adjustment change is not answered from a stale one.
	key="$t|$fmt|$DT_HCAL|$DT_HADJ|$DT_LANGON|$DT_DIGITS"
	if [ "$key" = "$DT_CLOCKKEY" ]; then
		ret "$DT_CLOCKWAS"
	fi
	# Names in the language chosen: the catalogue's, put in before
	# strftime sees the format, %% kept as it is.
	if [ -n "$DT_LANGON" ] && [[ $f == *%[AaBb]* ]]; then
		printf -v wd '%(%u %m)T' "$t"
		read -r wd mo <<< "$wd"
		mo=${mo#0}
		f=${f//%%/$'\001'}
		f=${f//%A/${DT_WDAYSA[$((wd - 1))]}}
		f=${f//%a/${DT_WDAYS[$((wd - 1))]}}
		f=${f//%B/${DT_MONTHS[$((mo - 1))]}}
		f=${f//%b/${DT_MONTHSB[$((mo - 1))]}}
		f=${f//$'\001'/%%}
	fi
	# The Hijri codes (ADR 0034): the hcal module's, in the calendar
	# chosen; with none chosen they say nothing. Only a format that has
	# one loads the module.
	case $f in
	*%i[demYBb]*)
		if [ "$DT_HCAL" != none ] && need hcal 2> /dev/null; then
			n=$DT_HCAL
			hcal info -c "$n" > /dev/null 2>&1 || n=civil
			if [ -n "$DT_LANGON" ] && [ "${#DT_HMONTHS[@]}" = 12 ]; then
				local IFS='|'
				s="${DT_HMONTHS[*]}"
				out := hcal format -c "$n" -a "$DT_HADJ" -n "$s" "$f" "$t" 2> /dev/null
			else
				out := hcal format -c "$n" -a "$DT_HADJ" "$f" "$t" 2> /dev/null
			fi
		else
			f=${f//%id/}; f=${f//%ie/}; f=${f//%im/}
			f=${f//%iY/}; f=${f//%iB/}; f=${f//%ib/}
			printf -v out "%($f)T" "$t"
		fi
		;;
	*) printf -v out "%($f)T" "$t" ;;
	esac
	while [ "${out:0:1}" = " " ]; do out=${out:1}; done
	[ "$DT_DIGITS" = arabic ] && out := dt_digits "$out"
	DT_CLOCKKEY=$key
	DT_CLOCKWAS=$out
	ret "$out"
}

# What to call the active application on the right of the bar.
dt_appname() {
	if [ -z "$MB_APP" ]; then
		ret "Desktop"
	elif [ -n "${DT_APPS[$MB_APP]["title"]}" ]; then
		ret "${DT_APPS[$MB_APP]["title"]}"
	else
		ret "$MB_APP"
	fi
}
