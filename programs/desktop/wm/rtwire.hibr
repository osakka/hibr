# wm/rtwire -- the wire between the desktop and an app's own process (ADR
# 0050): one line a message, its words separated by spaces, each word with
# %, space, tab, newline and carriage return written as %25, %20, %09, %0A
# and %0D, so any value crosses as one word; and the protocol's number,
# which the hello carries beside the hibr version.
#
# Part of the app interface (ADR 0050): interface.hibr sources it, in the
# desktop and in every app's own process, so it acts on nothing the
# desktop alone owns. It only defines functions and sets state.
# interface: shared

strict

# The protocol's number: a change to what crosses the wire changes it, and
# a process speaking another is refused at its hello. 8: a view's frame
# carries where its app's pictures are, `p SLOT ROW COL H W` and `x SLOT`
# (ADR 0050, "Pictures, by hold").
DT_RTPROTO=8

# The desktop's state shared with every app process that reads it (ADR
# 0050, one path): named once, in the file that owns it, with dt_share --
# a kept setting is shared by dt_keep itself. Nothing else says what an app
# is sent: the variable table tells the varwatch module whenever a shared
# variable changes (no writer marks anything), its shape travels with it,
# and who reads it comes from the parser (mirrors.hibr). -s marks a secret,
# never sent to a file the inventory has not read; -o FIELD a map whose
# entries each belong to the app their FIELD names, sent to that app alone
# -- given more than once, to each app any of those fields names.
declare -gA DT_SHARED DT_SHAREOWN
dt_share() {
	local sec= own= n

	while :; do
		case ${1-} in
		-s) sec=1; shift ;;
		-o) own+="${own:+ }$2"; shift 2 ;;
		*) break ;;
		esac
	done
	for n; do
		DT_SHARED["$n"]=$sec
		[ -z "$own" ] || DT_SHAREOWN["$n"]=$own
		# Shared once the desktop listens: watched from then on.
		[ -z "${DT_RTLFD-}" ] || varwatch add "$n" 2> /dev/null ||
			dt_log "app runtime: $n is shared and does not exist"
	done
	return 0
}
# A word as it crosses the wire.
fn dt_rtenc(v) {
	v=${v//%/%25}
	v=${v// /%20}
	v=${v//$'\t'/%09}
	v=${v//$'\n'/%0A}
	v=${v//$'\r'/%0D}
	ret "$v"
}

# A word as it arrived; a lone % is the empty word, which no value can
# otherwise be written as, since % itself is %25.
fn dt_rtdec(v) {
	[ "$v" = % ] && { ret ""; return 0; }
	v=${v//%20/ }
	v=${v//%09/$'\t'}
	v=${v//%0A/$'\n'}
	v=${v//%0D/$'\r'}
	v=${v//%25/%}
	ret "$v"
}

# What each connection has sent that is not yet a whole line, the
# connections with whole lines still waiting for the next pass, how many
# lines one pass carries -- so a flood holds nothing up -- and how long a
# line may grow with no end before its connection is let go.
declare -gA DT_RTBUF DT_RTMORE
DT_RTLINES="${DT_RTLINES-64}"
DT_RTLINEMAX="${DT_RTLINEMAX-1048576}"
# The whole lines the last dt_rtlines took, in the order they came.
DT_RTGOT=()

# The longest answer an edit gives, in characters as written on the wire
# (a space or % is three of them, a newline, tab, quote or backslash two):
# under the desktop's own DT_RTLINEMAX, which it reads a line to before
# letting the connection go. A longer copy is refused with a note, and a
# cut is measured first and then not made, so nothing is lost and the
# connection stays (runtime.hibr's dt_rtedit).
DT_RTEDITMAX="${DT_RTEDITMAX-1040000}"

# Read what is waiting on fd, never waiting (recv -p), and take up to
# DT_RTLINES whole lines into DT_RTGOT; the rest waits for the next pass,
# which reads nothing new until they are taken (DT_RTMORE). One reader for
# the desktop's end and an app's. Status 1 when the other end has gone, 2
# when a line has passed DT_RTLINEMAX with no end.
fn dt_rtlines(int fd) {
	local b x n=0

	DT_RTGOT=()
	if [ -z "${DT_RTMORE["$fd"]+x}" ]; then
		recv -p "$fd" b 2> /dev/null || return 1
		DT_RTBUF["$fd"]+=$b
	fi
	unset DT_RTMORE["$fd"]
	while [[ ${DT_RTBUF["$fd"]} == *$'\n'* ]]; do
		if [ "$n" -ge "$DT_RTLINES" ]; then
			DT_RTMORE["$fd"]=1
			break
		fi
		x=${DT_RTBUF["$fd"]%%$'\n'*}
		DT_RTBUF["$fd"]=${DT_RTBUF["$fd"]#*$'\n'}
		DT_RTGOT+=("$x")
		n=$((n + 1))
	done
	[ "${#DT_RTBUF["$fd"]}" -le "$DT_RTLINEMAX" ] || return 2
	return 0
}

# A message's words, every one encoded, as the line that carries them.
fn dt_rtline(...w) {
	local x e line=

	for x in "${w[@]}"; do
		e := dt_rtenc "$x"
		line+="${line:+ }${e:-%}"
	done
	ret "$line"
}
