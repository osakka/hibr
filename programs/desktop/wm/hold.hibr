# wm/hold -- staying detachable: running under hold, coming back to a
# session, and the displays attached to one.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Detach only works when the desktop is a held session.  A session calls
# dt_autohold once, before dt_open, to make sure it always is: if it is not
# already held, this restarts it -- the same command, the same arguments --
# inside one, under a free name, and attaches to it right here, so from the
# terminal it looks exactly like the desktop just starting.  This process
# then takes on whatever the held one ends with, and the desktop nothing
# else has changed about runs there instead.
#
# It does nothing, quietly, wherever holding cannot make sense -- no hold
# module, no real terminal to attach from -- or if starting one fails for any
# reason, so a session that calls it is never worse off than one that does
# not: Detach stays dimmed and the desktop opens here as it always did.
#
# A name already running is left alone unless resume asks for it -- coming
# back to the same desktop should be something a session's own --resume
# flag says plainly, not something a bare rerun does on its own guess.
#
# --join is a different terminal's own request to attach beside an already
# running one, at the union's current width -- another monitor for the same
# desktop, not a session of its own, so it never starts or resumes one: a
# name not already running is an error, the same as --resume without a name
# to resume is. There is no lock between reading the current width and
# attaching at it, so two terminals joining at the same instant can land on
# the same offset -- narrow in practice (this is a person typing a command
# in each terminal, not a burst of them), and not solved here.

# Every session name already in use, space separated.
dt_holdnames() {
	local lst line out=

	lst := hold list
	while IFS= read -r line; do
		[ -n "$line" ] && out="$out ${line%% *}"
	done <<< "$lst"
	ret "${out# }"
}

# This session's own line from `hold list`, or empty if it is not running.
fn dt_holdline(base) {
	local lst line

	lst := hold list
	while IFS= read -r line; do
		case $line in "$base "*) ret "$line"; return 0 ;; esac
	done <<< "$lst"
	ret ""
}

fn dt_autojoin(base, dname) {
	local line wxh cols

	line := dt_holdline "$base"
	if [ -z "$line" ]; then
		echo "$0: $base is not running -- start it first (plain" \
			"'desktop'), then --join from here" >&2
		exit 1
	fi
	wxh=${line##* }
	cols=${wxh#*x}
	if [ -n "$dname" ]; then
		hold attach -m -n "$dname" "$base" 0 "$cols"
	else
		hold attach -m "$base" 0 "$cols"
	fi
	exit $?
}

# Attach to this session, named for the control panel if asked to be --
# shared by a fresh `hold new`, --resume and --join, so all three ways of
# ending up attached leave the same name behind.
fn dt_holdattach(base, dname) {
	if [ -n "$dname" ]; then
		hold attach -n "$dname" "$base"
	else
		hold attach "$base"
	fi
	exit $?
}

fn dt_autohold(base, int resume, int join, dname, int standby = 0) {
	local base=${base:-desktop} have

	# HIBR_HOLD being set does not by itself mean this process already is
	# the held program: it is an ordinary environment variable, inherited
	# by anything a held terminal starts, and a shell attached to one
	# session running `desktop --session other` from inside it inherits
	# the *first* session's own HIBR_HOLD. Only the re-exec'd program this
	# same dt_autohold's own `hold new` starts has one naming $base -- the
	# server sets it right before spawning that program -- so that is the
	# actual check, not merely "is it set". Getting this wrong looks like
	# the desktop silently refusing to hold at all: Detach stays dimmed,
	# and `--resume other` later says it is not running, when what
	# actually happened is dt_autohold returned immediately, mistaking
	# some other session's own HIBR_HOLD for this one's.
	[ -n "$HIBR_HOLD" ] && [ "${HIBR_HOLD##*/}" = "$base" ] && return 0
	# A restart carries on in this process, wherever it was running.
	[ -n "$DT_RESTORE" ] && return 0
	[ -t 0 ] && [ -t 1 ] || return 0
	need hold || return 0
	[ "$standby" = 1 ] && dt_standby "$base" "$dname"
	[ "$join" = 1 ] && dt_autojoin "$base" "$dname"
	have := dt_holdnames
	case " $have " in
	*" $base "*)
		[ "$resume" = 1 ] && dt_holdattach "$base" "$dname"
		echo "$0: $base is already running -- add --resume to reattach," \
			"or run 'hold attach $base' directly" >&2
		exit 1
		;;
	esac
	hold new -d "$base" "${HIBR:-hibr}" "$0" "${DT_SELFARGS[@]}" || return 0
	dt_holdattach "$base" "$dname"
}

# Leave the desktop running and give the terminal back.  Only a desktop
# started with `hold new` can, which is why the item is dimmed otherwise and
# the key only says so -- dt_autohold is what makes that true from the moment
# this one opens.
dt_detach() {
	if [ -z "$HIBR_HOLD" ]; then
		dt_notep low "Not held -- nothing to detach from"
		return 1
	fi
	need hold && hold detach
}

# This session's own name, from HIBR_HOLD's own socket path -- what hold's
# subcommands that take an explicit session name (clients, move, drop,
# primary; detach and kill alone fall back to HIBR_HOLD with none) need.
# The Control Panel's own Displays pane is the one place that switches a
# display off; there is no menu-bar equivalent.
dt_holdsess() { ret "${HIBR_HOLD##*/}"; }

# Flash a display's own name in the middle of its own screen -- called
# with its row, col, rows and cols (hold clients's own coordinates), not
# just its name, so this does not have to ask hold clients again itself.
# Multi-monitor's own "which one is this" answer: a display drawn in the
# Control Panel's own picture is a small rectangle with a name in it, but
# a real screen has no such label on it anywhere -- this puts the same
# name directly onto the display it actually names, in the middle of its
# own real rows/cols, for whoever is looking at it to read.
DT_IDNAME=
DT_IDROW=0
DT_IDCOL=0
DT_IDROWS=0
DT_IDCOLS=0
DT_IDT=0
DT_IDMS=2000

fn dt_identify(name, int row, int col, int rows, int cols) {
	DT_IDNAME="$name"
	DT_IDROW=$row
	DT_IDCOL=$col
	DT_IDROWS=$rows
	DT_IDCOLS=$cols
	DT_IDT := dt_ms
	dt_want "$DT_IDMS"
}

dt_identify_draw() {
	local now w r c t

	[ -z "$DT_IDNAME" ] && return 0
	now := dt_ms
	if [ $((now - DT_IDT)) -ge "$DT_IDMS" ]; then
		DT_IDNAME=
		return 0
	fi
	w=$((${#DT_IDNAME} + 4))
	[ "$w" -gt "$DT_IDCOLS" ] && w=$DT_IDCOLS
	r=$((DT_IDROW + DT_IDROWS / 2))
	c=$((DT_IDCOL + (DT_IDCOLS - w) / 2))
	console pen "$DT_ACTIVE" "$DT_FACE" bold
	t := dt_rep $((w - 2)) "${GL[hline]}"
	console put "$r" "$c" "${GL[tl]}$t${GL[tr]}"
	console put $((r + 2)) "$c" "${GL[bl]}$t${GL[br]}"
	console pen "$DT_INK" "$DT_FACE" bold
	console put $((r + 1)) "$c" "${GL[vline]} ${DT_IDNAME:0:$((w - 4))} ${GL[vline]}"
	dt_want "$DT_IDMS"
}
