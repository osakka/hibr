# wm/frame -- drawing a window's frame: its border, its title, and the
# buttons in its title bar.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The three button-icon styles: which glyph and colour each of min, max
# and close gets, and what wraps the movable (3-button) or fixed
# (2-button) cluster. Fills BTN_K/BTN_G/BTN_C/BTN_DL/BTN_DR in the same
# left-to-right order dt_btn's own fixed offsets (1, 3, 5 or 1, 3) expect,
# so a fourth style is a branch here, never a change to dt_win or dt_btn.
fn dt_btnspec(style, int? fixed) {
	if [ "$fixed" = 1 ]; then BTN_K=(min close); else BTN_K=(min max close); fi
	case $style in
	circles)
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("${GL[circle]}" "${GL[circle]}"); BTN_C=("$DT_WARN" "$DT_BAD")
		else
			BTN_G=("${GL[circle]}" "${GL[circle]}" "${GL[circle]}")
			BTN_C=("$DT_WARN" "$DT_GOOD" "$DT_BAD")
		fi
		;;
	squares | diamonds | dashes)
		local g=${GL[square]}

		[ "$style" = diamonds ] && g=${GL[diamond]}
		[ "$style" = dashes ] && g=${GL[minus]}
		BTN_DL=" "; BTN_DR=" "
		if [ "$fixed" = 1 ]; then
			BTN_G=("$g" "$g"); BTN_C=("$DT_WARN" "$DT_BAD")
		else
			BTN_G=("$g" "$g" "$g")
			BTN_C=("$DT_WARN" "$DT_GOOD" "$DT_BAD")
		fi
		;;
	*)
		BTN_DL="${GL[teel]}"; BTN_DR="${GL[teer]}"
		if [ "$fixed" = 1 ]; then
			BTN_G=("_" "x"); BTN_C=("$DT_INK" "$DT_BAD")
		else
			BTN_G=("_" "${GL[box]}" "x")
			BTN_C=("$DT_INK" "$DT_INK" "$DT_BAD")
		fi
		;;
	esac
}

# dt_btnspec's own arrays, reordered left to right for the side the
# cluster actually docks to. min/max/close reads left to right on the
# right; mirrored on the left it reads close/max/min, so close is always
# the button nearest the window's own outer corner, whichever side that
# is -- the same relationship a real title bar keeps moved to either side.
fn dt_btnorder(style, int? fixed, side) {
	dt_btnspec "$style" "$fixed"
	[ "$side" != left ] && return 0
	if [ "$fixed" = 1 ]; then
		BTN_K=("${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[1]}" "${BTN_C[0]}")
	else
		BTN_K=("${BTN_K[2]}" "${BTN_K[1]}" "${BTN_K[0]}")
		BTN_G=("${BTN_G[2]}" "${BTN_G[1]}" "${BTN_G[0]}")
		BTN_C=("${BTN_C[2]}" "${BTN_C[1]}" "${BTN_C[0]}")
	fi
}

# The cluster dt_btnspec's own glyphs draw as one string -- always 5
# (fixed) or 7 (movable) characters, matching the offsets dt_btn already
# hit-tests, whatever style set the glyphs themselves.
dt_btnstr() {
	if [ ${#BTN_G[@]} = 3 ]; then
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]} ${BTN_G[2]}$BTN_DR"
	else
		ret "$BTN_DL${BTN_G[0]} ${BTN_G[1]}$BTN_DR"
	fi
}

# Draw one window: its face, then its app, then its frame over the top.
# A bare window: the window's own colour throughout, the app drawing in
# the same place as in a framed one, a strip along the top a shade darker
# -- darker still with focus -- with a close box at its left and the title
# faint beside it, and a grow mark in the corner.
fn dt_winbare(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} dr=${DT[$id]["draw"]}
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]}
	local bg=${DT[$id]["bg"]:-$DT_FACE} fg=${DT[$id]["fg"]:-$DT_INK} t pct=88

	console pen "$fg" "$bg"
	console fill "$wr" "$wc" "$h" "$w" " "
	DT_NOTEWIN=$id
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
	DT_NOTEWIN=
	console pen "$fg" "$bg"
	t := str repeat " " "$w"
	console put -p "w$id" 0 0 "$t"
	t=${DT[$id]["title"]}
	case $DT_LANG in ?*) t := dt_trtitle "$t" ;; esac
	[ ${#t} -gt $((w - 5)) ] && t="${t:0:$((w - 5))}"
	console put -p "w$id" 0 1 "${GL[cross]}"
	console pen "$fg" "$bg" dim
	console put -p "w$id" 0 3 "$t"
	[ "$DT_FOCUS" = "$id" ] && pct=78
	console darken "$wr" "$wc" 1 "$w" "$pct"
	if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" != 1 ]; then
		console pen "$fg" "$bg" dim
		console put -p "w$id" $((h - 1)) $((w - 1)) "${GL[grow]}"
	fi
}

# Which title-bar button is at column c of window id, if any -- for a bare
# window only its close box.
fn dt_btnat(int id, int c) {
	if [ "${DT_APPS[${DT[$id]["app"]}]["bare"]}" = 1 ]; then
		[ "$c" = 1 ] && ret close
		return 0
	fi
	dt_btn "${DT[$id]["w"]}" "$c" "${DT_APPS[${DT[$id]["app"]}]["fixed"]}"
}

# Whether this window can be left exactly as it is this frame: its app has
# to offer a _dirty and say nothing has changed, it has to be clear of every
# other window (dt_alone), and DT_FORCEDRAW has to be off -- which is how
# tests/desktop.py takes the same session both ways and compares the screen
# cell for cell. An app with no _dirty is always redrawn, so this can only
# ever be wrong for an app that went out of its way to say otherwise.
fn dt_clean(int id) {
	local ap=${DT[$id]["app"]}

	[ "$DT_FORCEDRAW" = 1 ] && return 1
	[ -n "$DT_FORCEONCE" ] && return 1
	[ -n "$ap" ] || return 1
	case " $DT_ALONE " in *" $id "*) ;; *) return 1 ;; esac
	dt_has "${ap}_dirty" || return 1
	"${ap}_dirty" "$id" && return 1
	return 0
}

# A window's shadow: the row under it and the two columns beside it, which is
# all of its own rectangle-shifted-down-and-right that the window does not
# then cover. Cast on every frame, with `-s`: darkening is multiplicative, so
# a shadow cast twice on the same cells comes out twice as dark, and `-s`
# makes the console leave a cell it has already shadowed alone. Any ordinary
# write clears that mark, so the wallpaper painting underneath -- or this
# window moving away -- gets its shadow cast afresh.
#
# Deciding instead *which frame may cast it* was tried for three releases and
# got the answer wrong three times: shadows under the bar and the menus
# pulsing once a second, the Control Strip blinking, and a sticky note's
# shadow flickering while a window moved. Nothing has to be kept in step now.
fn dt_shadow(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]}
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]}

	[ "$DT_SHADOW" = 1 ] || return 0
	console darken -s $((wr + h)) $((wc + 2)) 1 "$w" "$DT_SHADOW_PCT"
	[ "$h" -gt 1 ] &&
		console darken -s $((wr + 1)) $((wc + w)) $((h - 1)) 2 \
			"$DT_SHADOW_PCT"
	return 0
}

fn dt_win(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}
	local fixed=${DT_APPS[${DT[$id]["app"]}]["fixed"]} pc

	# Nothing about it has changed and nothing else touches it: its cells
	# are still on the screen from last frame, and the wallpaper painted
	# around them rather than over them. Its shadow is not inside its own
	# rectangle though, so a frame that painted the wallpaper wiped the
	# strip the shadow falls on and it has to be cast again -- without
	# redrawing a single cell of the window itself.
	if dt_clean "$id"; then
		dt_shadow "$id"
		return 0
	fi

	# Before any of the shapes below, because two of them return without
	# reaching the one further down -- and the clean path above casts it,
	# so a bare window had a shadow on the frames it was left alone and
	# none on the frames it was drawn. A sticky note is the only bare
	# window with a dirty flag of its own, so it was the only thing that
	# blinked: move any window, every sticky is drawn, every sticky loses
	# its shadow; let the screen settle, they are skipped and it comes
	# back. Reported as "the stickies' shadow blink when I move any
	# window, only them", and as shadows differing from one workspace to
	# the next, which is the same thing seen in a snapshot. Cast on every
	# frame and idempotent (`-s`), so casting it here for every shape
	# cannot darken anything twice.
	dt_shadow "$id"
	if [ "${DT_APPS[${DT[$id]["app"]}]["bare"]}" = 1 ]; then
		dt_winbare "$id"
		return 0
	fi
	# A window with no chrome at all (DT[id]["chrome"] = none): its app
	# draws every cell of it, rows and columns from 0, and the window
	# manager moves it by any press on it -- a mini player.
	if [ "${DT[$id]["chrome"]}" = none ]; then
		console pen "$DT_INK" "$DT_FACE"
		console fill "$wr" "$wc" "$h" "$w" " "
		DT_NOTEWIN=$id
		[ -n "$dr" ] && $dr "$id" "$h" "$w" "$wr" "$wc"
		DT_NOTEWIN=
		return 0
	fi

	# Only the strip that stays visible. The shadow is the window's own
	# rectangle moved a row down and two columns right, so all of it but
	# an L is painted over by the window's own face a few lines below --
	# and darkening what is about to be overwritten cost h by w cells a
	# window a frame, 4,648 of them for one terminal, against 193 for the
	# L. The result is the same cells: the row under the window, and the
	# two columns beside it. Cast above, before the shapes that return
	# early.
	[ "$DT_FOCUS" = "$id" ] && on=$DT_ACTIVE
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	DT_NOTEWIN=$id
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
	DT_NOTEWIN=

	# None is a blank frame, not no frame: the ring of border glyphs is
	# left undrawn -- no corners, no sides, no grow box -- but the title
	# and its buttons are still there, still clickable, exactly as under
	# single or double. Nothing about a window's controls ever depends on
	# whether its edge is drawn.
	if [ "$DT_FRAME" != none ]; then
		console pen "$on" "$DT_FACE"
		local tl=${DT_FRAMES[$DT_FRAME]["tl"]} tr=${DT_FRAMES[$DT_FRAME]["tr"]}
		local bl=${DT_FRAMES[$DT_FRAME]["bl"]} br=${DT_FRAMES[$DT_FRAME]["br"]}
		local fh=${DT_FRAMES[$DT_FRAME]["h"]} fv=${DT_FRAMES[$DT_FRAME]["v"]}
		local bar
		bar := dt_rep $((w - 2)) "$fh"
		console put -p "w$id" 0 0 "$tl$bar$tr"
		console put -p "w$id" $((h - 1)) 0 "$bl$bar$br"
		if [ "$DT_TITLEBAR" = solid ]; then
			bar := dt_rep "$w" " "
			console pen "$DT_SELINK" "$on"
			console put -p "w$id" 0 0 "$bar"
		fi
		console pen "$DT_INK" "$DT_FACE"
		# A fixed window keeps the plain corner the border just drew
		# instead of the grow box: no drag can resize it, so nothing
		# should invite one.
		[ "$fixed" != 1 ] &&
			console put -p "w$id" $((h - 1)) $((w - 1)) "${GL[grow]}"
		local r=1
		while [ "$r" -lt $((h - 1)) ]; do
			console put -p "w$id" "$r" 0 "$fv"
			console put -p "w$id" "$r" $((w - 1)) "$fv"
			r=$((r + 1))
		done
	fi

	local bs bc off i tbg=$DT_FACE tfg=$on bink=$DT_INK
	# A solid title bar is the frame's own colour, and everything on it --
	# the title, a button drawn in ink -- is drawn in DT_SELINK, the text
	# that reads on the accent.
	if [ "$DT_TITLEBAR" = solid ]; then
		tbg=$on
		tfg=$DT_SELINK
		bink=$DT_SELINK
		if [ "$DT_FRAME" = none ]; then
			local sb
			sb := dt_rep "$w" " "
			console pen "$DT_SELINK" "$on"
			console put -p "w$id" 0 0 "$sb"
		fi
	fi
	local side=$DT_BTNSIDE align=$DT_TITLEALIGN

	case $DT_MIRRORON in
	1)
		case $side in left) side=right ;; *) side=left ;; esac
		case $align in right) align=left ;; center) ;; *) align=right ;; esac
		;;
	esac
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$side"
	# A blank frame is blank throughout: the tick marks a style wraps its
	# cluster in are box-drawing glyphs too, and stay undrawn along with
	# the ring itself, even though the buttons they wrap keep working.
	{ [ "$DT_FRAME" = none ] || [ "$DT_TITLEBAR" = solid ]; } && { BTN_DL=" "; BTN_DR=" "; }
	bs := dt_btnstr
	if [ "$side" = left ]; then bc=1; else bc=$((w - 1 - ${#bs})); fi
	console pen "$bink" "$tbg"
	console put -p "w$id" 0 "$bc" "$bs"
	if [ "$fixed" = 1 ]; then off=(1 3); else off=(1 3 5); fi
	i=0
	while [ "$i" -lt ${#BTN_G[@]} ]; do
		if [ "${BTN_C[$i]}" != "$DT_INK" ]; then
			console pen "${BTN_C[$i]}" "$tbg" bold
			console put -p "w$id" 0 $((bc + ${off[$i]})) "${BTN_G[$i]}"
		fi
		i=$((i + 1))
	done

	# Room for the title is measured from the button cluster's own real
	# position and width, not a style's worst case -- a fixed window's
	# five-wide cluster leaves two columns more than a movable one's seven,
	# and a centred or right-aligned title has to land on the real
	# boundary or it reads as off-centre once anything narrower than the
	# widest cluster is in play.
	local t=${DT[$id]["title"]} tc0 room tc tmax

	case $DT_LANG in ?*) t := dt_trtitle "$t" ;; esac
	if [ "$side" = left ]; then
		tc0=$((bc + ${#bs}))
		room=$((w - 1 - tc0 - 4))
	else
		tc0=2
		room=$((bc - tc0 - 4))
	fi
	[ ${#t} -gt "$room" ] && t="${t:0:$room}"
	tmax=$((tc0 + room - ${#t}))
	case $align in
	# Centred on the bar's own full width, not on the room left over once
	# the button cluster is excluded -- centring in that remaining room
	# pushes the title away from the buttons by about half the cluster's
	# own width, which is exactly what reads as off-centre, and in the
	# opposite direction depending on which side the buttons are docked.
	# Still clamped into the same safe range the button cluster already
	# keeps clear, so a long title still cannot run into it.
	center) tc=$((1 + (w - 6 - ${#t}) / 2))
		[ "$tc" -lt "$tc0" ] && tc=$tc0
		[ "$tc" -gt "$tmax" ] && tc=$tmax ;;
	right)  tc=$tmax ;;
	*)      tc=$tc0 ;;
	esac
	local tdl="${GL[teel]}" tdr="${GL[teer]}"
	{ [ "$DT_FRAME" = none ] || [ "$DT_TITLEBAR" = solid ]; } && { tdl=" "; tdr=" "; }
	console pen "$tfg" "$tbg" bold
	console put -p "w$id" 0 "$tc" "$tdl $t $tdr"

	# Held down and still over the one that was pressed: the glyph alone
	# changes colour, no block behind it -- a grey one takes the theme's
	# accent, a coloured one (close's red, the traffic lights) a brighter
	# version of its own -- so a click looks like it did something before
	# whatever it does finishes happening, in the theme's own colours.
	if [ "$DT_BTNID" = "$id" ] && [ "$DT_BTNOVER" = 1 ]; then
		i=0
		while [ "$i" -lt ${#BTN_K[@]} ]; do
			if [ "${BTN_K[$i]}" = "$DT_BTNKIND" ]; then
				if [ "${BTN_C[$i]}" = "$DT_INK" ]; then
					pc=$DT_ACTIVE
					[ "$DT_TITLEBAR" = solid ] && pc=$DT_FACE
				else
					pc := dt_lighten "${BTN_C[$i]}" 45
				fi
				console pen "$pc" "$tbg" bold
				console put -p "w$id" 0 $((bc + ${off[$i]})) \
					"${BTN_G[$i]}"
			fi
			i=$((i + 1))
		done
	fi
}

# A #rrggbb colour moved pct of the way toward white; anything else as it
# came.
fn dt_lighten(c, int p) {
	local r g b

	match "$c" '^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$' ||
		{ ret "$c"; return 0; }
	r=$((16#${M[1]})); g=$((16#${M[2]})); b=$((16#${M[3]}))
	r=$((r + (255 - r) * p / 100))
	g=$((g + (255 - g) * p / 100))
	b=$((b + (255 - b) * p / 100))
	printf -v c '#%02x%02x%02x' "$r" "$g" "$b"
	ret "$c"
}

# Which title-bar button is at this column, if any.  fixed omits max, whose
# button is not drawn there either, so a click at its old column falls
# through to the window's body instead of hitting a button that is not there.
fn dt_btn(int w, int c, int? fixed) {
	local bc bw side=$DT_BTNSIDE

	case $DT_MIRRORON in 1) case $side in left) side=right ;; *) side=left ;; esac ;; esac
	if [ "$fixed" = 1 ]; then bw=5; else bw=7; fi
	if [ "$side" = left ]; then bc=1; else bc=$((w - 1 - bw)); fi
	dt_btnorder "$DT_BTNSTYLE" "$fixed" "$side"
	if [ "$fixed" = 1 ]; then
		case $((c - bc)) in
		1) ret "${BTN_K[0]}" ;;
		3) ret "${BTN_K[1]}" ;;
		*) ret "" ;;
		esac
		return 0
	fi
	case $((c - bc)) in
	1) ret "${BTN_K[0]}" ;;
	3) ret "${BTN_K[1]}" ;;
	5) ret "${BTN_K[2]}" ;;
	*) ret "" ;;
	esac
}
