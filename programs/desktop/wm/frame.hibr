# wm/frame -- drawing a window's frame: its border, its title, and the
# buttons in its title bar.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The button-icon styles: which glyph and colour each of close, shade, zoom
# (max) and min gets, and what wraps a cluster. Fills BTN_K/BTN_G/BTN_C/
# BTN_DL/BTN_DR with every kind this style can draw, in no order that
# matters: where one goes is the Title Bar Buttons list's (dt_chromebtns), so
# a further style is a branch here, never a change to dt_chrome. fixed leaves
# zoom and full screen out, and stuck is a sticky window, whose Sticky button
# says so. chalk and slate are Blit's boxes (Blit ADR 0210), drawn in the ink
# like the brackets and on any title bar, and a box Blit has no glyph for is
# not drawn; dt_chromecfg has made them brackets wherever Blit's glyphs are
# not in force.
fn dt_btnspec(style, int? fixed, int stuck = 0) {
	local g c=${GL[circle]}
	local -A gl ink

	case $style in
	chalk | slate)
		BTN_DL=" "; BTN_DR=" "
		gl=([close]="${GL["$style-close"]-}" [shade]="${GL["$style-shade"]-}"
		    [max]="${GL["$style-zoom"]-}" [min]="${GL["$style-min"]-}"
		    [full]="${GL["$style-full"]-}" [sticky]="${GL["$style-sticky"]-}")
		[ "$stuck" = 1 ] && gl["sticky"]="${GL["$style-sticky-on"]-}"
		ink=([close]="$DT_INK" [shade]="$DT_INK" [max]="$DT_INK" [min]="$DT_INK"
		     [full]="$DT_INK" [sticky]="$DT_INK")
		;;
	circles | squares | diamonds | dashes)
		g=$c
		[ "$style" = squares ] && g=${GL[square]}
		[ "$style" = diamonds ] && g=${GL[diamond]}
		[ "$style" = dashes ] && g=${GL[minus]}
		BTN_DL=" "; BTN_DR=" "
		gl=([close]="$g" [shade]="$g" [max]="$g" [min]="$g" [full]="$g" [sticky]="$g")
		ink=([close]="$DT_BAD" [shade]="$DT_INFO" [max]="$DT_GOOD" [min]="$DT_WARN"
		     [full]="$DT_ACTIVE" [sticky]="$DT_DIM")
		[ "$stuck" = 1 ] && ink["sticky"]="$DT_INK"
		;;
	*)
		BTN_DL="${GL[teel]}"; BTN_DR="${GL[teer]}"
		gl=([close]="x" [shade]="^" [max]="${GL[box]}" [min]="_" [full]="#" [sticky]=".")
		[ "$stuck" = 1 ] && gl["sticky"]="*"
		ink=([close]="$DT_BAD" [shade]="$DT_INK" [max]="$DT_INK" [min]="$DT_INK"
		     [full]="$DT_INK" [sticky]="$DT_INK")
		;;
	esac
	BTN_K=() BTN_G=() BTN_C=()
	for g in close shade max min full sticky; do
		[ -n "${gl["$g"]}" ] || continue
		[ "$fixed" = 1 ] && case $g in max | full) continue ;; esac
		BTN_K+=("$g") BTN_G+=("${gl["$g"]}") BTN_C+=("${ink["$g"]}")
	done
}

# The Title Bar Buttons list as it stands, into DT_BTNL: the saved order with
# anything it does not know taken out and anything it lacks put back, so a
# list saved before a button existed still offers it.
declare -ga DT_BTNL
fn dt_btnlist() {
	local k
	local -a a

	DT_BTNL=()
	read -ra a <<< "$DT_BTNORDER"
	for k in "${a[@]}"; do
		case " ${DT_BTNS[*]} " in
		*" $k "*) case " ${DT_BTNL[*]} " in *" $k "*) ;; *) DT_BTNL+=("$k") ;; esac ;;
		esac
	done
	for k in "${DT_BTNS[@]}"; do
		case " ${DT_BTNL[*]} " in *" $k "*) ;; *) DT_BTNL+=("$k") ;; esac
	done
}

# Whether the list has button k switched off.
fn dt_btnhidden(k) {
	case " title $DT_BTNON " in *" $k "*) return 1 ;; esac
	return 0
}

# Draw one window: its face, then its app, then its frame over the top.
# Its widget regions are forgotten just before its app draws, whichever
# shape it is: an app that never called dt_wclear itself -- the terminal,
# About, Task Manager and four more -- added a frame's worth to the list on
# every frame, 18 a frame for a terminal's scrollbar, so in a long session
# a press there walked tens of thousands of them before it could find the
# thumb, and every click in the window paid the same.
# A bare window: the window's own colour throughout, the app drawing in
# the same place as in a framed one, a strip along the top a shade darker
# -- darker still with focus -- with a close box at its left and the title
# faint beside it, and a grow mark in the corner.
fn dt_winbare(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} dr=${DT[$id]["draw"]}
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]}
	local bg=${DT[$id]["bg"]:-$DT_FACE} fg=${DT[$id]["fg"]:-$DT_INK} t pct=88

	console pen "$fg" "$bg"
	console fill "$wr" "$wc" "$h" "$w" " "
	DT_NOTEWIN=$id
	dt_wclear "$id"
	dt_fieldstale "$id"
	[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
	DT_NOTEWIN=
	console pen "$fg" "$bg"
	t := str repeat " " "$w"
	console put -p "w$id" 0 0 "$t"
	t=${DT[$id]["title"]}
	case $DT_LANG in ?*) t := dt_trtitle "$t" ;; esac
	[ ${#t} -gt $((w - 5)) ] && t="${t:0:$((w - 5))}"
	console put -p "w$id" 0 1 "${GL[cross]}"
	console pen "$fg" "$bg" dim
	console put -p "w$id" 0 3 "$t"
	[ "$DT_FOCUS" = "$id" ] && pct=78
	console darken "$wr" "$wc" 1 "$w" "$pct"
	if [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" != 1 ]; then
		console pen "$fg" "$bg" dim
		console put -p "w$id" $((h - 1)) $((w - 1)) "${GL[grow]}"
	fi
}

# The windows drawn so far this frame, bottom to top, each as "row col h w"
# with its shadow's strip counted in (dt_wintimed fills it). A window that
# overlaps another need be drawn only when one drawn before it -- under it
# -- overlaps it, since that one's cells have just been painted over its
# own; a window above it repainting touches nothing of it but the shadow it
# casts, which `console darken -s` casts only once on any cell (0.99.84).
# Drawing every window that overlaps any other, which this replaces, made a
# playing video redraw three terminals, the Browser and the Control Panel
# for each of its frames: 33 ms a frame and 92% of a core on the mini PC
# (Gitea #418).
DT_DRAWNR=()

# Whether a window drawn before this one this frame overlaps it.
fn dt_under(int id) {
	local ar=${DT[$id]["row"]} ac=${DT[$id]["col"]} ah aw x r c h w

	ah=$((DT[$id]["h"] + 1))
	aw=$((DT[$id]["w"] + 2))
	for x in "${DT_DRAWNR[@]}"; do
		read -r r c h w <<< "$x"
		[ $((ar < r + h && r < ar + ah && ac < c + w && c < ac + aw)) = 1 ] && return 0
	done
	return 1
}

# Which title-bar button is at column c of window id, if any: the one
# dt_chrome said it drew there when it last drew the window -- for a bare
# window only its close box.
fn dt_btnat(int id, int c) {
	local rec=${DT[$id]["btns"]-} e

	if [ "${DT_APPS[${DT[$id]["app"]}]["bare"]}" = 1 ]; then
		[ "$c" = 1 ] && ret close
		return 0
	fi
	while [ -n "$rec" ]; do
		e=${rec%% *}
		if [ "$e" = "$rec" ]; then rec=; else rec=${rec#* }; fi
		[ "${e%%:*}" = "$c" ] && { ret "${e#*:}"; return 0; }
	done
	ret ""
}

# Whether this window can be left exactly as it is this frame: its app has
# to offer a _dirty and say nothing has changed, no window drawn under it
# this frame may overlap it, shadow included (dt_under; any overlap at all
# drew it every frame before 0.99.410), and DT_FORCEDRAW has to be off -- which is how
# tests/desktop.py takes the same session both ways and compares the screen
# cell for cell. An app with no _dirty is always redrawn, so this can only
# ever be wrong for an app that went out of its way to say otherwise.
DT_WHY=
# DT_WHY says which answer it gave, for `desktop ctl stats` (drawn_why):
# the reason every window was drawn rather than left, counted per app.
fn dt_clean(int id) {
	local ap=${DT[$id]["app"]}

	[ "$DT_FORCEDRAW" = 1 ] && { DT_WHY=forcedraw; return 1; }
	[ -n "$DT_FORCEONCE" ] && { DT_WHY="full:${DT_FORCEBY:-other}"; return 1; }
	case $DT_FORCEWIN in *" $id "*) DT_WHY=moved; return 1 ;; esac
	[ -n "$ap" ] || { DT_WHY=noapp; return 1; }
	dt_hotmoved "$id" && { DT_WHY=hover; return 1; }
	case " $DT_ALONE " in *" $id "*) ;; *) dt_under "$id" && { DT_WHY=overlap; return 1; } ;; esac
	dt_has "${ap}_dirty" || { DT_WHY=nodirty; return 1; }
	"${ap}_dirty" "$id" && { DT_WHY=dirty; return 1; }
	DT_WHY=left
	return 0
}

# A window's shadow: the row under it and the two columns beside it, which is
# all of its own rectangle-shifted-down-and-right that the window does not
# then cover. Cast on every frame, with `-s`: darkening is multiplicative, so
# a shadow cast twice on the same cells comes out twice as dark, and `-s`
# makes the console leave a cell it has already shadowed alone. Any ordinary
# write clears that mark, so the wallpaper painting underneath -- or this
# window moving away -- gets its shadow cast afresh.
#
# Deciding instead *which frame may cast it* was tried for three releases and
# got the answer wrong three times: shadows under the bar and the menus
# pulsing once a second, the Control Strip blinking, and a sticky note's
# shadow flickering while a window moved. Nothing has to be kept in step now.
fn dt_shadow(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]}
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]}

	[ "$DT_SHADOW" = 1 ] || return 0
	# A window can do without one: YouTube's mini player, by a setting of
	# its own (Gitea #304).
	[ "${DT[$id]["noshadow"]}" = 1 ] && return 0
	dt_castshadow "$wr" "$wc" "$h" "$w"
}

# Whether Thin is a line the terminal draws (SGR 66, Blit ADR 0211) rather
# than an eighth block: on Blit's glyphs, which only Blit draws.
dt_shadowattr() {
	[ "$DT_SHADOWSHAPE" = thin ] && [ "$DT_GLYPHSET" = blit ]
}

# The shadow of a box -- a window, a menu, a pop-up, the Control Strip -- at
# row r and column c, h rows by w columns, cast only outside it, so the box
# may be drawn before it or after. Every shadow the desktop casts comes
# through here, so Shadow Shape reaches all of them (Gitea #340). Two
# Columns is a row below and two columns right; Half Block half a row below
# and one column right, as thick each way and thinner: a lower half block
# beside the box's top row, one column down its side, and an upper half
# block along the row under it. Thin is an eighth of a cell: a line down
# the left edge of the column beside the box, from a row below its top, and
# one along the top of the row under it, from a column in, the two meeting
# at the corner -- the shadow hugging the box. lim, when given, is the
# first column it must not reach -- the right edge of the display the box
# is on.
fn dt_castshadow(int r, int c, int h, int w, int? lim = "") {
	local p=$DT_SHADOW_PCT bw rw

	[ -n "$lim" ] || lim=$((c + w + 2))
	if dt_shadowattr; then
		# Beyond a box-drawn edge, flush: down the column right of it from
		# its first row, along the row under it from its first column,
		# and the corner beyond both.
		if [ $((c + w)) -lt "$lim" ]; then
			console shadow "$r" $((c + w)) 1 1 2 1 0 "$DT_SHADOWINK"
			[ "$h" -gt 1 ] && console shadow $((r + 1)) $((c + w)) $((h - 1)) 1 1 1 0 "$DT_SHADOWINK"
			console shadow $((r + h)) $((c + w)) 1 1 5 1 0 "$DT_SHADOWINK"
		fi
		bw=$((w - 1))
		[ $((c + 1 + bw)) -gt "$lim" ] && bw=$((lim - c - 1))
		console shadow $((r + h)) "$c" 1 1 4 1 0 "$DT_SHADOWINK"
		[ "$bw" -gt 0 ] && console shadow $((r + h)) $((c + 1)) 1 "$bw" 3 1 0 "$DT_SHADOWINK"
		return 0
	fi
	if [ "$DT_SHADOWSHAPE" = thin ] && [ "$DT_GLYPHSET" != ascii ]; then
		[ $((c + w)) -lt "$lim" ] && [ "$h" -gt 1 ] &&
			console darken -s -l $((r + 1)) $((c + w)) $((h - 1)) 1 "$p"
		bw=$((w - 1))
		[ $((c + 1 + bw)) -gt "$lim" ] && bw=$((lim - c - 1))
		[ "$bw" -gt 0 ] && console darken -s -u $((r + h)) $((c + 1)) 1 "$bw" "$p"
		return 0
	fi
	if [ "$DT_SHADOWSHAPE" != cols ] && [ "$DT_GLYPHSET" != ascii ]; then
		bw=$w
		[ $((c + 1 + bw)) -gt "$lim" ] && bw=$((lim - c - 1))
		if [ $((c + w)) -lt "$lim" ]; then
			console darken -s -b "$r" $((c + w)) 1 1 "$p"
			[ "$h" -gt 1 ] && console darken -s $((r + 1)) $((c + w)) $((h - 1)) 1 "$p"
		fi
		[ "$bw" -gt 0 ] && console darken -s -t $((r + h)) $((c + 1)) 1 "$bw" "$p"
		return 0
	fi
	bw=$w
	[ $((c + 2 + bw)) -gt "$lim" ] && bw=$((lim - c - 2))
	rw=2
	[ $((c + w + rw)) -gt "$lim" ] && rw=$((lim - c - w))
	[ "$bw" -gt 0 ] && console darken -s $((r + h)) $((c + 2)) 1 "$bw" "$p"
	[ "$rw" -gt 0 ] && [ "$h" -gt 1 ] && console darken -s $((r + 1)) $((c + w)) $((h - 1)) "$rw" "$p"
	return 0
}

# Whether a window is drawn with no border, Frame none: its title bar the
# only row of frame, and no border anywhere else -- so its content runs to
# its edge, and the app's own column 1 is the window's first. A bare window
# and one with no chrome draw every cell themselves already.
fn dt_capped(int id) {
	[ "$DT_FRAME" = none ] || return 1
	[ "${DT[$id]["chrome"]}" != none ] || return 1
	[ "${DT_APPS[${DT[$id]["app"]}]["bare"]}" != 1 ]
}

# The screen column a window's app counts its own columns from: the
# window's own, or one left of it under the bar frame.
fn dt_wapp(int id) {
	local c=${DT[$id]["col"]}

	dt_capped "$id" && c=$((c - 1))
	ret "$c"
}

# What the chrome's settings come to, worked out again only when one of
# them changes, since every window drawn asks. DT_CALIGN is how the title is
# aligned, mirrored for a right-to-left language. DT_CFRAME, DT_CTB and
# DT_CBTN are Frame, Title Bar and Window Buttons as they can be drawn:
# edge, chalk and slate need Blit's glyphs (Blit ADR 0210, 0214), and without
# them are single, line and brackets. DT_CFSET, DT_CTSET and DT_CBSET name the glyph
# set each of the three draws from when it is chalk or slate, and are empty
# otherwise -- each read by its own part's drawing and by nothing else.
# DT_CTS is 1 when the title bar is a filled row of the frame's colour. A
# change forces one full frame, so a window the change left undrawn does
# not keep its old buttons' places.
DT_CKEY=
DT_CALIGN=left
DT_CTS=0
DT_CFRAME=single
DT_CTB=line
DT_CBTN=brackets
DT_CFSET=
DT_CTSET=
DT_CBSET=
dt_chromecfg() {
	local k="$DT_BTNORDER|$DT_BTNON $DT_TITLEALIGN $DT_MIRRORON $DT_TITLEBAR $DT_FRAME $DT_BTNSTYLE ${GL[frame-left]-}${GL[chalk-stripe]-}${GL[slate-stripe]-}"

	[ "$k" = "$DT_CKEY" ] && return 0
	[ -n "$DT_CKEY" ] && DT_FORCEONCE=1
	DT_CKEY=$k
	DT_CALIGN=$DT_TITLEALIGN
	if [ "$DT_MIRRORON" = 1 ]; then
		case $DT_CALIGN in right) DT_CALIGN=left ;; center) ;; *) DT_CALIGN=right ;; esac
	fi
	DT_CFSET := dt_chromeset "$DT_FRAME"
	DT_CTSET := dt_chromeset "$DT_TITLEBAR"
	DT_CBSET := dt_chromeset "$DT_BTNSTYLE"
	DT_CFRAME=$DT_FRAME
	DT_CTB=$DT_TITLEBAR
	DT_CBTN=$DT_BTNSTYLE
	case $DT_CFRAME in
	edge) [ -n "$DT_CFSET" ] || DT_CFRAME=single ;;
	single | double | rounded | solid | none) ;;
	*) DT_CFRAME=single ;;
	esac
	[ "$DT_CFRAME" = edge ] || DT_CFSET=
	case $DT_CTB in chalk | slate) [ -n "$DT_CTSET" ] || DT_CTB=line ;; esac
	case $DT_CBTN in chalk | slate) [ -n "$DT_CBSET" ] || DT_CBTN=brackets ;; esac
	DT_CTS=0
	{ [ "$DT_CTB" != line ] || [ "$DT_CFRAME" = solid ]; } && DT_CTS=1
	return 0
}

# The glyph set a value of Frame, Title Bar, Window Buttons or Dialog
# Buttons draws from: chalk or slate while Blit's glyphs are in force;
# nothing for any other value, or without them.
fn dt_chromeset(v) {
	case $v in
	edge) [ -n "${GL[frame-left]-}" ] && ret edge ;;
	chalk) [ -n "${GL[chalk-stripe]-}" ] && ret chalk ;;
	slate) [ -n "${GL[slate-stripe]-}" ] && ret slate ;;
	esac
	ret ""
}

# Whether a value of Frame, Title Bar, Window Buttons, Dialog Buttons or a
# note's Frame can be drawn with the glyph set in use: curved needs a cell
# for a rounded top corner, and chalk and slate Blit's window glyphs
# (blit#140, Blit ADR 0210), which only Blit's own set has. Elsewhere they
# are drawn as the plain style, so a list shows them dimmed and the arrows
# step past them. The value is a setting's own word or a row's label.
fn dt_chromedrawable(v) {
	case ${v,,} in
	curved) [ "${GL[capl]}" != " " ] ;;
	edge) [ -n "${GL[frame-left]-}" ] ;;
	chalk) [ -n "${GL[chalk-stripe]-}" ] ;;
	slate) [ -n "${GL[slate-stripe]-}" ] ;;
	capsule) [ -n "${GL[capsule-on]-}" ] ;;
	*) return 0 ;;
	esac
}

# The values of a list that can be drawn, as words, and in DT_POPDIMNEXT
# the ones that cannot, for a dropdown to show dimmed.
fn dt_chromeavail(...vals) {
	local f
	local -a out=()

	DT_POPDIMNEXT=()
	for f in "${vals[@]}"; do
		if dt_chromedrawable "$f"; then out+=("$f"); else DT_POPDIMNEXT+=("$f"); fi
	done
	ret "${out[*]}"
}

# What a list calls one of Blit's two styles: what is stored is its name, and
# the row says the shape, since neither is a colour or a theme there.
fn dt_chromename(v) {
	case $v in
	chalk) ret flat ;;
	slate) ret embossed ;;
	esac
	ret "$v"
}

# The face of a box drawn as a window, see-through as the windows' are, for
# what is not a window and so has no pane the window manager fills.
fn dt_chromeface(int r, int c, int h, int w) {
	dt_chromein on
	console pen "$DT_INK" "$DT_FACE"
	console fill "$r" "$c" "$h" "$w" " "
	dt_chromein off
}

# The buttons a title bar carries, split by where they go, into DT_CBL and
# DT_CBR (kinds, left to right) with their glyphs and colours beside them
# in DT_CBLG/DT_CBLC and DT_CBRG/DT_CBRC: Window Buttons decides what they
# look like (dt_btnspec), and the Title Bar Buttons list which there are and
# on which side of the title, in its order, turned round whole for a mirrored
# layout. Whatever the title bar is drawn as. Worked out again only when the
# chrome's settings or the kind of window change, since every window drawn
# asks.
DT_CBL=() DT_CBR=() DT_CBLG=() DT_CBRG=() DT_CBLC=() DT_CBRC=()
DT_CBKEY=
fn dt_chromebtns(int fixed, int stuck = 0) {
	local i n j k="$DT_CKEY|$fixed|$stuck" right=
	local -a ord=()

	[ "$k" = "$DT_CBKEY" ] && return 0
	DT_CBKEY=$k
	DT_CBL=() DT_CBR=() DT_CBLG=() DT_CBRG=() DT_CBLC=() DT_CBRC=()
	dt_btnspec "$DT_CBTN" "$fixed" "$stuck"
	dt_btnlist
	n=${#DT_BTNL[@]}
	for ((i = 0; i < n; i++)); do
		if [ "$DT_MIRRORON" = 1 ]; then ord+=("${DT_BTNL[n - 1 - i]}"); else ord+=("${DT_BTNL[$i]}"); fi
	done
	for k in "${ord[@]}"; do
		if [ "$k" = title ]; then
			right=1
			continue
		fi
		dt_btnhidden "$k" && continue
		for ((j = 0; j < ${#BTN_K[@]}; j++)); do
			[ "${BTN_K[$j]}" = "$k" ] || continue
			if [ -n "$right" ]; then
				DT_CBR+=("$k") DT_CBRG+=("${BTN_G[$j]}") DT_CBRC+=("${BTN_C[$j]}")
			else
				DT_CBL+=("$k") DT_CBLG+=("${BTN_G[$j]}") DT_CBLC+=("${BTN_C[$j]}")
			fi
		done
	done
	return 0
}

# One Chalk or Slate title bar (Blit ADR 0210) across cols a to b of row r,
# from glyph set s: the stripes, the buttons in DT_CBL and DT_CBR at its two
# ends -- whatever Window Buttons made them -- and the title centred over
# it with a stripe that stops short each side of it. Its colours are the
# scheme's: Chalk is the face and the ink, Slate's bar is the title bar's
# colour `on` -- the focused title colour or the idle one, as a solid bar's
# is -- its lines the ink and its highlight, which is also its boxes' face,
# the scheme's own (DT_HIGHLIGHT) or else a lighter bar: the three roles
# Blit's glyphs take from a cell. Its title is framed, so the bar's own
# rows run under the letters. Inactive, it is the plain bar with the title
# in the dim colour and no buttons. With ends set, the cells either side of
# a and b are the bar's own ends (Blit ADR 0214), its stripes running into
# them, and on a plain bar the plain ends, a frame's cells on an older Blit.
# Answers the buttons' columns, "col:kind ...", counted from c0, and leaves
# the bar's colour in DT_CBARBG for the lighting of a button under the pointer.
DT_CBARBG=
DT_CBARLN=
fn dt_glyphbar(pane, int r, int a, int b, s, title, int act, on, int c0 = 0, int ends = 0) {
	local -a at=() ln=()
	local fg bg tfg fr n m ll rl st i x k q= rec= g hl

	[ -n "$pane" ] && at=(-p "$pane")
	if [ "$s" = chalk ]; then
		fg=$DT_INK bg=$DT_FACE tfg=$DT_INK fr=framed ln=("line=$DT_INK")
		[ "$act" = 1 ] || tfg=$DT_DIM
	else
		fg=$DT_INK bg=$on fr=framed-slate
		hl=$DT_HIGHLIGHT
		[ -n "$hl" ] || hl := dt_lighten "$bg" 60
		ln=("line=$hl")
		tfg=${DT_TITLEINK:-$DT_INK}
		[ "$act" = 1 ] || tfg=$DT_DIM
	fi
	DT_CBARBG=$bg
	DT_CBARLN=${ln[0]}
	n=${#title}
	console pen "$fg" "$bg" "${ln[@]}"
	if [ "$act" != 1 ]; then
		[ "$n" -gt $((b - a + 1)) ] && { title=${title:0:$((b - a + 1))}; n=${#title}; }
		g := dt_rep $((b - a + 1)) "${GL["$s-title"]}"
		if [ "$ends" = 1 ]; then
			console put "${at[@]}" "$r" $((a - 1)) "${GL["$s-title-end-plain-left"]:-${GL["frame-left"]}}$g${GL["$s-title-end-plain-right"]:-${GL["frame-right"]}}"
		else
			console put "${at[@]}" "$r" "$a" "$g"
		fi
		st=$((a + (b - a + 1 - n) / 2))
		[ "$n" -gt 0 ] && console pen "$tfg" "$bg" bold $fr "${ln[@]}" &&
			console put "${at[@]}" "$r" "$st" "$title"
		ret ""
		return 0
	fi
	ll=1 rl=1
	[ "${#DT_CBL[@]}" -gt 0 ] && ll=$((2 * ${#DT_CBL[@]} + 1))
	[ "${#DT_CBR[@]}" -gt 0 ] && rl=$((2 * ${#DT_CBR[@]} + 1))
	m=$((b - a + 1 - ll - rl))
	[ "$n" -gt $((m - 2)) ] && { n=$((m - 2)); [ "$n" -lt 0 ] && n=0; title=${title:0:$n}; }
	st=$((a + (b - a + 1 - n) / 2))
	[ "$st" -lt $((a + ll + 1)) ] && st=$((a + ll + 1))
	[ "$st" -gt $((b - rl - n)) ] && st=$((b - rl - n))
	# The left end: the stripe that stops at the frame, or the buttons with
	# a stripe stopping short of each and between them.
	if [ "${#DT_CBL[@]}" -gt 0 ]; then
		q=${GL["$s-stripe-to-box"]}
		for ((i = 0; i < ${#DT_CBL[@]}; i++)); do
			[ "$i" -gt 0 ] && q+=${GL["$s-stripe-between"]}
			q+=${DT_CBLG[$i]}
			rec+=" $((a + 2 * i + 1 - c0)):${DT_CBL[$i]}"
		done
		q+=${GL["$s-stripe-from-box"]}
	else
		q=${GL["$s-stripe"]}
	fi
	g := dt_rep $((st - 1 - a - ll)) "${GL["$s-stripe"]}"
	q+=$g${GL["$s-stripe-before-title"]}
	console put "${at[@]}" "$r" "$a" "$q"
	q=${GL["$s-stripe-after-title"]}
	g := dt_rep $((b - rl - st - n)) "${GL["$s-stripe"]}"
	q+=$g
	x=$((b - rl + 1))
	if [ "${#DT_CBR[@]}" -gt 0 ]; then
		q+=${GL["$s-stripe-to-box"]}
		for ((i = 0; i < ${#DT_CBR[@]}; i++)); do
			[ "$i" -gt 0 ] && q+=${GL["$s-stripe-between"]}
			q+=${DT_CBRG[$i]}
			rec+=" $((x + 2 * i + 1 - c0)):${DT_CBR[$i]}"
		done
		q+=${GL["$s-stripe-from-box"]}
	else
		q+=${GL["$s-stripe"]}
	fi
	console put "${at[@]}" "$r" $((st + n)) "$q"
	if [ "$ends" = 1 ]; then
		console put "${at[@]}" "$r" $((a - 1)) "${GL["$s-title-end-left"]}"
		console put "${at[@]}" "$r" $((b + 1)) "${GL["$s-title-end-right"]}"
	fi
	# A button of a colour of its own -- close's red, the traffic lights --
	# in that colour on the bar, as on any other title bar.
	for ((i = 0; i < ${#DT_CBL[@]}; i++)); do
		[ "${DT_CBLC[$i]}" != "$DT_INK" ] || continue
		console pen "${DT_CBLC[$i]}" "$bg" bold
		console put "${at[@]}" "$r" $((a + 2 * i + 1)) "${DT_CBLG[$i]}"
	done
	for ((i = 0; i < ${#DT_CBR[@]}; i++)); do
		[ "${DT_CBRC[$i]}" != "$DT_INK" ] || continue
		console pen "${DT_CBRC[$i]}" "$bg" bold
		console put "${at[@]}" "$r" $((x + 2 * i + 1)) "${DT_CBRG[$i]}"
	done
	if [ "$n" -gt 0 ]; then
		console pen "$tfg" "$bg" bold $fr "${ln[@]}"
		console put "${at[@]}" "$r" "$st" "$title"
	fi
	ret "${rec# }"
}

# The Edge frame (Blit ADR 0214) round rows r to r+h-1 and cols c to c+w-1:
# one line on the outer edge of its cells, in the ink, and the rest of each
# cell the window's face, which runs right out to the line. A glyph title
# bar's end cells then replace the two on the title row.
fn dt_glyphframe(pane, int r, int c, int h, int w) {
	local -a at=()
	local g

	[ -n "$pane" ] && at=(-p "$pane")
	console pen "$DT_INK" "$DT_FACE"
	if [ "$h" -gt 1 ]; then
		console fill "${at[@]}" "$r" "$c" $((h - 1)) 1 "${GL["frame-left"]}"
		console fill "${at[@]}" "$r" $((c + w - 1)) $((h - 1)) 1 "${GL["frame-right"]}"
	fi
	g := dt_rep $((w - 2)) "${GL["frame-bottom"]}"
	console put "${at[@]}" $((r + h - 1)) "$c" "${GL["frame-bottom-left"]}$g${GL["frame-bottom-right"]}"
}

# The colours a note is drawn in, by Note Colour (Control Panel >
# Notifications): theme, the colour scheme's face and ink with its well for
# a strip, or one of the colours a note may have of its own -- its face and
# strip, its text black -- the same few a sticky note offers. Into
# DT_NOTEBG, DT_NOTESTRIP and DT_NOTEFG.
declare -gA DT_NOTEFACES
DT_NOTEFACES["yellow"]="#fffaaf #f5e878"
DT_NOTEFACES["blue"]="#cde6ff #a5cdf5"
DT_NOTEFACES["green"]="#d2f5c8 #aae1a0"
DT_NOTEFACES["pink"]="#ffd7e6 #f5b4cd"
DT_NOTEFACES["lavender"]="#e6d7ff #cdb9f5"
DT_NOTEFACES["grey"]="#eeeeee #d7d7d7"
DT_NOTECOLOURS=(theme yellow blue green pink lavender grey)
DT_NOTEBG= DT_NOTESTRIP= DT_NOTEFG=
dt_notecolours() {
	local t=${DT_NOTEFACES["${DT_NOTECOLOUR:-theme}"]-}

	if [ -z "$t" ]; then
		DT_NOTEBG=$DT_FACE DT_NOTESTRIP=$DT_WELL DT_NOTEFG=$DT_INK
	else
		DT_NOTEBG=${t% *} DT_NOTESTRIP=${t#* } DT_NOTEFG="$DT_SHADOWINK"
	fi
}

# A resizable window's corner: Blit's own grow box on the Edge frame, in the
# title bar's style, where its hatch sits in the frame's two lines.
fn dt_chromegrow(pane, int r, int c, on) {
	local -a at=()
	local s=${DT_CTSET:-chalk} hl

	[ -n "$pane" ] && at=(-p "$pane")
	if [ -n "$DT_CFSET" ] && [ -n "${GL["$s-grow"]-}" ]; then
		hl=
		if [ "$s" = slate ]; then
			hl=$DT_HIGHLIGHT
			[ -n "$hl" ] || hl := dt_lighten "$on" 60
			hl="line=$hl"
		fi
		console pen "$DT_INK" "$DT_FACE" $hl
		console put "${at[@]}" "$r" "$c" "${GL["$s-grow"]}"
		return 0
	fi
	console put "${at[@]}" "$r" "$c" "${GL[grow]}"
}

# The chrome of everything drawn as a window -- a window, a note that
# follows the windows, the confirm box -- and the only code that draws it
# (#102): the border of the theme's frame, or none, the title bar, the
# title and the title bar's buttons. A window draws into its pane, rows and
# columns from 0; anything else at screen coordinates, with pane empty. on
# is the frame's colour, cap 1 for a box with no border (Frame none). fixed
# is empty for a box with no buttons, else 0 or 1 for a window that can or
# cannot be resized, and id the window, whose focus, pressed button and
# hovered button decide how they are lit. Answers where each button went,
# "col:kind ...", counted from c, which is what a press there is tested
# against: what is drawn is what is clickable, whatever the style and the
# placement.
fn dt_chrome(pane, int r, int c, int h, int w, title, on, int cap = 0, fixed = "", id = "") {
	local -a at=()
	local ts bar tl tr bl br fv tc0 room tc tmax lw=0 rw=0 rec= i k x g pc act=1
	local tink=${DT_TITLEINK:-$DT_SELINK} tbg=$DT_FACE tfg=$on tdl tdr bink=$DT_INK

	[ -n "$pane" ] && at=(-p "$pane")
	dt_chromecfg
	ts=$DT_CTS
	[ -n "$id" ] && [ "$DT_FOCUS" != "$id" ] && act=0
	if [ "$cap" = 0 ]; then
		if [ -n "$DT_CFSET" ]; then
			dt_glyphframe "$pane" "$r" "$c" "$h" "$w"
		elif [ "$DT_CFRAME" = solid ]; then
			console pen "$DT_SELINK" "$on"
			bar := dt_rep "$w" " "
			console put "${at[@]}" "$r" "$c" "$bar"
			console put "${at[@]}" $((r + h - 1)) "$c" "$bar"
			if [ "$h" -gt 2 ]; then
				console fill "${at[@]}" $((r + 1)) "$c" $((h - 2)) 1 " "
				console fill "${at[@]}" $((r + 1)) $((c + w - 1)) $((h - 2)) 1 " "
			fi
		elif [ -n "${DT_FRAMES[$DT_CFRAME]["tl"]+x}" ]; then
			tl=${DT_FRAMES[$DT_CFRAME]["tl"]} tr=${DT_FRAMES[$DT_CFRAME]["tr"]}
			bl=${DT_FRAMES[$DT_CFRAME]["bl"]} br=${DT_FRAMES[$DT_CFRAME]["br"]}
			fv=${DT_FRAMES[$DT_CFRAME]["v"]}
			bar := dt_rep $((w - 2)) "${DT_FRAMES[$DT_CFRAME]["h"]}"
			console pen "$on" "$DT_FACE"
			console put "${at[@]}" "$r" "$c" "$tl$bar$tr"
			console put "${at[@]}" $((r + h - 1)) "$c" "$bl$bar$br"
			# Each side one fill, not a put a row: a window's border
			# was two calls for every row it has.
			if [ "$h" -gt 2 ]; then
				console fill "${at[@]}" $((r + 1)) "$c" $((h - 2)) 1 "$fv"
				console fill "${at[@]}" $((r + 1)) $((c + w - 1)) $((h - 2)) 1 "$fv"
			fi
			console pen "$DT_INK" "$DT_FACE"
		fi
		# A fixed window keeps the plain corner the border just drew
		# instead of the grow box: no drag can resize it, so nothing
		# should invite one.
		[ "$fixed" = 0 ] && dt_chromegrow "$pane" $((r + h - 1)) $((c + w - 1)) "$on"
	fi
	if [ -n "$fixed" ]; then
		if [ "${DT[${pane#w}]["sticky"]-}" = 1 ]; then dt_chromebtns "$fixed" 1; else dt_chromebtns "$fixed"; fi
	fi
	# A Chalk or Slate title bar is its own row of glyphs, between the
	# frame's two columns when there are any, carrying the buttons Window
	# Buttons chose.
	if [ -n "$DT_CTSET" ]; then
		# A box with no buttons empties the shared lists, and so must
		# empty the cache that says they are current, or the next window
		# is handed none.
		[ -z "$fixed" ] && { DT_CBL=(); DT_CBR=(); DT_CBKEY=; }
		# Its own end cells, unless a drawn border's corners are there.
		g=0
		{ [ "$cap" = 1 ] || [ -n "$DT_CFSET" ]; } && g=1
		rec := dt_glyphbar "$pane" "$r" $((c + 1)) $((c + w - 2)) "$DT_CTSET" "$title" "$act" "$on" "$c" "$g"
		[ -n "$id" ] && { [ "$DT_BTNID" = "$id" ] || [ "${DT_HOVERBTN% *}" = "$id" ]; } &&
			dt_chromehot "$pane" "$r" "$c" "$id" "$rec" "$DT_CBARBG"
		ret "$rec"
		return 0
	fi
	# A filled title bar is the frame's own colour, and the title on it in
	# the title's ink. A curved one has its outer top corners rounded off,
	# in the bar's colour over whatever is behind, with a cell that has only
	# that corner cut -- which no ordinary font has: Blit's own (blit#140).
	# A glyph set without one leaves capl blank, and the ends are square.
	if [ "$ts" = 1 ]; then
		tbg=$on
		tfg=$tink
		bink=$tink
		bar := dt_rep "$w" " "
		console pen "$tink" "$on"
		console put "${at[@]}" "$r" "$c" "$bar"
		if [ "$DT_CTB" = curved ] && [ "${GL[capl]}" != " " ]; then
			console pen "$on" default
			console put "${at[@]}" "$r" "$c" "${GL[capl]}"
			console put "${at[@]}" "$r" $((c + w - 1)) "${GL[capr]}"
		fi
	fi
	# The buttons, a cluster at each end that has any: a style's tick
	# marks round each, which on a filled bar or with no border have no
	# line to sit on and stay undrawn, though the buttons keep working.
	if [ -n "$fixed" ]; then
		{ [ "$ts" = 1 ] || [ "$cap" = 1 ]; } && { BTN_DL=" "; BTN_DR=" "; }
		if [ "${#DT_CBL[@]}" -gt 0 ]; then
			g=$BTN_DL
			for ((i = 0; i < ${#DT_CBL[@]}; i++)); do
				[ "$i" -gt 0 ] && g+=" "
				g+=${DT_CBLG[$i]}
				rec+=" $((1 + 2 * i + 1)):${DT_CBL[$i]}"
			done
			g+=$BTN_DR
			lw=${#g}
			console pen "$bink" "$tbg"
			console put "${at[@]}" "$r" $((c + 1)) "$g"
		fi
		if [ "${#DT_CBR[@]}" -gt 0 ]; then
			g=$BTN_DL
			for ((i = 0; i < ${#DT_CBR[@]}; i++)); do
				[ "$i" -gt 0 ] && g+=" "
				g+=${DT_CBRG[$i]}
			done
			g+=$BTN_DR
			rw=${#g}
			x=$((w - 1 - rw))
			for ((i = 0; i < ${#DT_CBR[@]}; i++)); do
				rec+=" $((x + 2 * i + 1)):${DT_CBR[$i]}"
			done
			console pen "$bink" "$tbg"
			console put "${at[@]}" "$r" $((c + x)) "$g"
		fi
		# A coloured glyph -- close's red, the traffic lights -- in its
		# own colour on the bar.
		for ((i = 0; i < ${#DT_CBL[@]}; i++)); do
			[ "${DT_CBLC[$i]}" != "$DT_INK" ] || continue
			console pen "${DT_CBLC[$i]}" "$tbg" bold
			console put "${at[@]}" "$r" $((c + 2 + 2 * i)) "${DT_CBLG[$i]}"
		done
		for ((i = 0; i < ${#DT_CBR[@]}; i++)); do
			[ "${DT_CBRC[$i]}" != "$DT_INK" ] || continue
			console pen "${DT_CBRC[$i]}" "$tbg" bold
			console put "${at[@]}" "$r" $((c + w - rw + 2 * i)) "${DT_CBRG[$i]}"
		done
	fi
	# Room for the title is measured from the clusters' own real positions
	# and widths, not a style's worst case, so a centred or right-aligned
	# title lands on the real boundary.
	if [ "$lw" -gt 0 ]; then tc0=$((c + 1 + lw)); else tc0=$((c + 2)); fi
	if [ "$rw" -gt 0 ]; then room=$((c + w - 1 - rw - tc0 - 4)); else room=$((c + w - 1 - tc0 - 4)); fi
	[ "$room" -lt 0 ] && room=0
	[ ${#title} -gt "$room" ] && title="${title:0:$room}"
	tmax=$((tc0 + room - ${#title}))
	case $DT_CALIGN in
	# Centred on the bar's own full width, not on the room left once the
	# cluster is excluded -- which pushes the title away from the buttons
	# by half the cluster's width and reads as off-centre -- and clamped
	# into the room the clusters keep clear.
	center) tc=$((c + 1 + (w - 6 - ${#title}) / 2))
		[ "$tc" -lt "$tc0" ] && tc=$tc0
		[ "$tc" -gt "$tmax" ] && tc=$tmax ;;
	right)  tc=$tmax ;;
	*)      tc=$tc0 ;;
	esac
	tdl=${GL[teel]} tdr=${GL[teer]}
	{ [ "$ts" = 1 ] || [ "$cap" = 1 ]; } && { tdl=" "; tdr=" "; }
	console pen "$tfg" "$tbg" bold
	console put "${at[@]}" "$r" "$tc" "$tdl $title $tdr"
	rec=${rec# }
	[ -n "$id" ] && { [ "$DT_BTNID" = "$id" ] || [ "${DT_HOVERBTN% *}" = "$id" ]; } &&
		dt_chromehot "$pane" "$r" "$c" "$id" "$rec" "$tbg"
	ret "$rec"
}

# Light window id's pressed or hovered title bar button, from the columns
# dt_chrome recorded: held down and still over the one pressed, the glyph
# alone changes colour -- a grey one takes the theme's accent, a coloured
# one a brighter version of its own -- and under the pointer it is drawn in
# the hot colour, bold, nothing behind it (Gitea #370, #384). Every style
# lights the same way, on whatever bar it sits.
fn dt_chromehot(pane, int r, int c, id, rec, bg) {
	local -a at=()
	local want= held=0 e col kind g pc i k

	[ -n "$id" ] && [ -n "$rec" ] || return 0
	if [ "$DT_BTNID" = "$id" ] && [ "$DT_BTNOVER" = 1 ]; then
		want=$DT_BTNKIND held=1
	elif [ "${DT_HOVERBTN% *}" = "$id" ]; then
		want=${DT_HOVERBTN#* }
	fi
	[ -n "$want" ] || return 0
	[ -n "$pane" ] && at=(-p "$pane")
	while [ -n "$rec" ]; do
		e=${rec%% *}
		if [ "$e" = "$rec" ]; then rec=; else rec=${rec#* }; fi
		col=${e%%:*} kind=${e#*:}
		[ "$kind" = "$want" ] || continue
		for ((i = 0; i < ${#BTN_K[@]}; i++)); do
			[ "${BTN_K[$i]}" = "$kind" ] || continue
			g=${BTN_G[$i]}
			if [ "$held" = 1 ]; then
				if [ "${BTN_C[$i]}" = "$DT_INK" ]; then
					pc=$DT_ACTIVE
					[ "$DT_CTS" = 1 ] && pc=$DT_FACE
				else
					pc := dt_lighten "${BTN_C[$i]}" 45
				fi
			elif [ "$DT_CTS" = 1 ]; then
				pc := dt_lighten "$bg" 70
			else
				pc := dt_hotcolour
			fi
		done
		# Blit's boxes have a pressed look of their own, which is also
		# how one looks under the pointer, drawn in the bar's own pens.
		k=${kind/#max/zoom}
		if [ -n "$DT_CBSET" ] && [ -n "${GL["$DT_CBSET-$k-pressed"]-}" ]; then
			console pen "$DT_INK" "$bg" $DT_CBARLN
			console put "${at[@]}" "$r" $((c + col)) "${GL["$DT_CBSET-$k-pressed"]}"
			return 0
		fi
		console pen "$pc" "$bg" bold
		console put "${at[@]}" "$r" $((c + col)) "$g"
		return 0
	done
	return 0
}

# Turn on or off the see-through the windows' faces have, for what a
# what is drawn on a dt_chromeface.
fn dt_chromein(how) {
	[ "${DT_WINTRANS:-0}" != 0 ] || return 0
	if [ "$how" = on ]; then
		console translucent "$DT_WINTRANS" "$DT_FACE" "$DT_FACE"
	else
		console translucent off
	fi
}

# Everything a window's frame is drawn from: where it is and its size, the
# focus colour, the title, its title bar's buttons lit or held, and the
# theme's frame. The same signature twice means the frame on the screen is
# the frame this would draw.
fn dt_chromesig(int id) {
	local b=
	local f=0

	[ "$DT_FOCUS" = "$id" ] && f=1
	[ "${DT_HOVERBTN% *}" = "$id" ] && b="h${DT_HOVERBTN#* }"
	[ "$DT_BTNID" = "$id" ] && b="$b p$DT_BTNKIND$DT_BTNOVER"
	ret "${DT[$id]["row"]} ${DT[$id]["col"]} ${DT[$id]["h"]} ${DT[$id]["w"]} $f $b|${DT[$id]["title"]}|$DT_FRAME $DT_TITLEBAR $DT_BTNSTYLE $DT_BTNSIDE $DT_TITLEALIGN $DT_MIRRORON $DT_LANG ${DT[$id]["chrome"]} $DT_FACE $DT_INK $DT_SELINK $DT_IDLE $DT_ACTIVE ${DT_TITLE-} ${DT_TITLEINK-} ${DT_WINTRANS:-0}"
}

# Whether only a window's content needs drawing: everything dt_clean asks
# holds but the app's own dirty answer -- nothing else has drawn over the
# window -- its frame would come out exactly as it is, and its app says this
# draw repaints every cell inside the frame (<app>_paintsall), so the
# window's face need not be cleared under it. A terminal printing is the
# case: about half of what each of its frames cost was the face and the
# frame drawn again, unchanged.
fn dt_contentonly(int id) {
	local ap=${DT[$id]["app"]} s

	[ "$DT_FORCEDRAW" = 1 ] && return 1
	[ -n "$DT_FORCEONCE" ] && return 1
	case $DT_FORCEWIN in *" $id "*) return 1 ;; esac
	[ -n "$ap" ] && [ -n "${DT[$id]["csig"]}" ] || return 1
	dt_has "${ap}_paintsall" && "${ap}_paintsall" "$id" || return 1
	dt_hotmoved "$id" && return 1
	case " $DT_ALONE " in *" $id "*) ;; *) dt_under "$id" && return 1 ;; esac
	s := dt_chromesig "$id"
	[ "$s" = "${DT[$id]["csig"]}" ]
}

fn dt_win(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]} on=$DT_IDLE
	# A layer of its own: see-through shows what is under the window, and
	# never the window's own face under its own terminal. Named, so on a
	# frame the window under it is left alone its cells still show that
	# window rather than the wallpaper.
	console layer "w$id"
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} dr=${DT[$id]["draw"]}
	local fixed=${DT_APPS[${DT[$id]["app"]}]["fixed"]} cap=0

	# Rolled up to its title bar, its app is not drawn (dt_idle reads it).
	[ -n "${DT[$id]["shaded"]-}" ] && dr=

	# Nothing about it has changed and nothing else touches it: its cells
	# are still on the screen from last frame, and the wallpaper painted
	# around them rather than over them. Its shadow is not inside its own
	# rectangle though, so a frame that painted the wallpaper wiped the
	# strip the shadow falls on and it has to be cast again -- without
	# redrawing a single cell of the window itself.
	if dt_clean "$id"; then
		# Its shadow only on what no window covers: a window above it
		# that is left too keeps cells this shadow never marked, which
		# would darken and stay dark. Under it, nothing was drawn this
		# frame that touches it (dt_under), so those cells keep the
		# shadow already cast on them.
		console behind on
		dt_shadow "$id"
		console behind off
		return 0
	fi
	if dt_contentonly "$id"; then
		dt_hotmark "$id"
		unset WH["$id"]
		dt_shadow "$id"
		[ "${DT_WINTRANS:-0}" != 0 ] &&
			console translucent "$DT_WINTRANS" "$DT_FACE" "$DT_FACE"
		DT_NOTEWIN=$id
		dt_wclear "$id"
		dt_fieldstale "$id"
		if dt_capped "$id"; then
			console pane origin "w$id" 0 1
			[ -n "$dr" ] && $dr "$id" $((h - 1)) "$w" "$wr" "$wc"
			console pane origin "w$id" 0 0
		else
			[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
		fi
		[ "${DT_WINTRANS:-0}" != 0 ] && console translucent off
		DT_NOTEWIN=
		DT_STAT["r:contentonly"]=$((${DT_STAT["r:contentonly"]:-0} + 1))
		# The app may have changed what its frame shows while it drew --
		# a program's own title, the bell's mark on it -- after this was
		# decided: then the window is drawn whole now, frame and all.
		# Not left to the next frame, which its app's _dirty may well
		# call clean, and then nothing would ever draw the new title.
		local now
		now := dt_chromesig "$id"
		[ "$now" = "${DT[$id]["csig"]}" ] && return 0
	fi
	dt_hotmark "$id"
	# A list's lit rows are registered again as it draws them, whether or
	# not its app clears its own regions.
	unset WH["$id"]

	# Before any of the shapes below, because two of them return without
	# reaching the one further down -- and the clean path above casts it,
	# so a bare window had a shadow on the frames it was left alone and
	# none on the frames it was drawn. A sticky note is the only bare
	# window with a dirty flag of its own, so it was the only thing that
	# blinked: move any window, every sticky is drawn, every sticky loses
	# its shadow; let the screen settle, they are skipped and it comes
	# back. Reported as "the stickies' shadow blink when I move any
	# window, only them", and as shadows differing from one workspace to
	# the next, which is the same thing seen in a snapshot. Cast on every
	# frame and idempotent (`-s`), so casting it here for every shape
	# cannot darken anything twice.
	dt_shadow "$id"
	if [ "${DT_APPS[${DT[$id]["app"]}]["bare"]}" = 1 ]; then
		dt_winbare "$id"
		return 0
	fi
	# A window with no chrome at all (DT[id]["chrome"] = none): its app
	# draws every cell of it, rows and columns from 0, and the window
	# manager moves it by any press on it -- a mini player.
	if [ "${DT[$id]["chrome"]}" = none ]; then
		console pen "$DT_INK" "$DT_FACE"
		console fill "$wr" "$wc" "$h" "$w" " "
		DT_NOTEWIN=$id
		dt_wclear "$id"
		dt_fieldstale "$id"
		[ -n "$dr" ] && $dr "$id" "$h" "$w" "$wr" "$wc"
		DT_NOTEWIN=
		return 0
	fi

	# Only the strip that stays visible. The shadow is the window's own
	# rectangle moved a row down and two columns right, so all of it but
	# an L is painted over by the window's own face a few lines below --
	# and darkening what is about to be overwritten cost h by w cells a
	# window a frame, 4,648 of them for one terminal, against 193 for the
	# L. The result is the same cells: the row under the window, and the
	# two columns beside it. Cast above, before the shapes that return
	# early.
	# The focused frame and title bar are the scheme's own title colour
	# where it gives one, the accent where it does not.
	[ "$DT_FOCUS" = "$id" ] && on=${DT_TITLE:-$DT_ACTIVE}
	# The face and whatever the app draws on it in the face's own colour
	# show the wallpaper through; a selection or a field drawn in another
	# colour stays itself, and the frame drawn after is opaque.
	[ "${DT_WINTRANS:-0}" != 0 ] &&
		console translucent "$DT_WINTRANS" "$DT_FACE" "$DT_FACE"
	console pen "$DT_INK" "$DT_FACE"
	console fill "$wr" "$wc" "$h" "$w" " "
	DT_NOTEWIN=$id
	dt_wclear "$id"
	dt_fieldstale "$id"
	if dt_capped "$id"; then
		cap=1
		console pane origin "w$id" 0 1
		[ -n "$dr" ] && $dr "$id" $((h - 1)) "$w" "$wr" "$wc"
		console pane origin "w$id" 0 0
	else
		[ -n "$dr" ] && $dr "$id" $((h - 2)) $((w - 2)) "$wr" "$wc"
	fi
	[ "${DT_WINTRANS:-0}" != 0 ] && console translucent off
	DT_NOTEWIN=

	# The frame, the title bar, the title and the title bar's buttons are
	# dt_chrome's, the one drawer of everything that looks like a window;
	# it says where each button went, and a press is tested against that.
	local t=${DT[$id]["title"]}

	case $DT_LANG in ?*) t := dt_trtitle "$t" ;; esac
	DT[$id]["btns"] := dt_chrome "w$id" 0 0 "$h" "$w" "$t" "$on" "$cap" "${fixed:-0}" "$id"
	dt_has "${DT[$id]["app"]}_paintsall" && DT[$id]["csig"] := dt_chromesig "$id"
}

# A #rrggbb colour moved pct of the way toward white; anything else as it
# came.
fn dt_lighten(c, int p) {
	local r g b

	match "$c" '^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$' ||
		{ ret "$c"; return 0; }
	r=$((16#${M[1]})); g=$((16#${M[2]})); b=$((16#${M[3]}))
	r=$((r + (255 - r) * p / 100))
	g=$((g + (255 - g) * p / 100))
	b=$((b + (255 - b) * p / 100))
	printf -v c '#%02x%02x%02x' "$r" "$g" "$b"
	ret "$c"
}

# Which title-bar button is at this column, if any.  fixed omits max, whose
# button is not drawn there either, so a click at its old column falls
# through to the window's body instead of hitting a button that is not there.
