# wm/settings -- what the person using the desktop chooses -- keys, theme,
# wallpaper, cursor, shadows, frames and buttons -- and the settings file
# that keeps them: dt_keep, dt_load, dt_save.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Every key the desktop acts on, and every one can be changed -- in the
# Shortcuts pane, or here. Menu Bar, Copy, Cut and Paste are looked at
# before the focused window sees the key, so they work in every window;
# the rest only once the focused window has declined it. Quit has none by
# default: it is in the hibr menu, and one stray key should not end
# everything. Each is set only if a session has not set it first, like
# every other default here.
declare -gA DT_KEYS
# Which modifiers `mod` in a shortcut means (Gitea #326): `alt`, `super
# alt` -- either one -- or `super`. The desktop's own chords are written
# with it, so one choice in Control Panel > Shortcuts moves all of them,
# and nothing has to know which terminal a key came from: a display whose
# terminal can send super gets super, and every display still has alt.
# dt_keynorm is the one place it is read.
DT_MOD="${DT_MOD-alt}"
[ -n "${DT_KEYS["menu"]+x}" ] || DT_KEYS["menu"]="f10"
[ -n "${DT_KEYS["menu2"]+x}" ] || DT_KEYS["menu2"]="escape"
[ -n "${DT_KEYS["copy"]+x}" ] || DT_KEYS["copy"]="mod-c"
[ -n "${DT_KEYS["cut"]+x}" ] || DT_KEYS["cut"]="mod-x"
[ -n "${DT_KEYS["paste"]+x}" ] || DT_KEYS["paste"]="mod-v"
[ -n "${DT_KEYS["signin"]+x}" ] || DT_KEYS["signin"]="mod-l"
# Select All is one key in every window since 0.99.422, so it is a chord
# like Copy rather than ctrl-a, which a field and an app have their own
# uses for.
[ -n "${DT_KEYS["selectall"]+x}" ] || DT_KEYS["selectall"]="mod-a"
[ -n "${DT_KEYS["scrollup"]+x}" ] || DT_KEYS["scrollup"]="shift-pageup"
[ -n "${DT_KEYS["scrolldown"]+x}" ] || DT_KEYS["scrolldown"]="shift-pagedown"
[ -n "${DT_KEYS["snapleft"]+x}" ] || DT_KEYS["snapleft"]="mod-left"
[ -n "${DT_KEYS["snapright"]+x}" ] || DT_KEYS["snapright"]="mod-right"
[ -n "${DT_KEYS["snaptop"]+x}" ] || DT_KEYS["snaptop"]="ctrl-alt-up"
[ -n "${DT_KEYS["snapbottom"]+x}" ] || DT_KEYS["snapbottom"]="ctrl-alt-down"
# Zoom and Minimise on the vertical arrows since 0.99.265, the owner's
# choice; Snap Top and Bottom moved to ctrl-alt.
[ -n "${DT_KEYS["zoom"]+x}" ] || DT_KEYS["zoom"]="mod-up"
[ -n "${DT_KEYS["hide"]+x}" ] || DT_KEYS["hide"]="mod-down"
[ -n "${DT_KEYS["shade"]+x}" ] || DT_KEYS["shade"]=
# Full Screen for any window that may be zoomed (0.99.403, the owner's
# request on #405): one key for every app, the focused app's own first as
# every window key is, and the Leave Full Screen key below no window takes.
[ -n "${DT_KEYS["fullscreen"]+x}" ] || DT_KEYS["fullscreen"]="mod-enter"
[ -n "${DT_KEYS["snapcenter"]+x}" ] || DT_KEYS["snapcenter"]=
[ -n "${DT_KEYS["ws1"]+x}" ] || DT_KEYS["ws1"]="mod-1"
[ -n "${DT_KEYS["ws2"]+x}" ] || DT_KEYS["ws2"]="mod-2"
[ -n "${DT_KEYS["ws3"]+x}" ] || DT_KEYS["ws3"]="mod-3"
for dt_k in 4 5 6 7 8 9; do
	[ -n "${DT_KEYS["ws$dt_k"]+x}" ] || DT_KEYS["ws$dt_k"]=
done
[ -n "${DT_KEYS["wsnext"]+x}" ] || DT_KEYS["wsnext"]="ctrl-alt-right"
[ -n "${DT_KEYS["wsprev"]+x}" ] || DT_KEYS["wsprev"]="ctrl-alt-left"
[ -n "${DT_KEYS["tile"]+x}" ] || DT_KEYS["tile"]=
[ -n "${DT_KEYS["tilemain"]+x}" ] || DT_KEYS["tilemain"]=
[ -n "${DT_KEYS["close"]+x}" ] || DT_KEYS["close"]="mod-w"
[ -n "${DT_KEYS["quitapp"]+x}" ] || DT_KEYS["quitapp"]="mod-q"
# The one way a held pointer is given back from the keyboard (Gitea #379),
# whatever app holds it, and the one an app that hangs holding it cannot
# take: DOSBox's own chord, which Blit passes through like any other key.
[ -n "${DT_KEYS["ptrrelease"]+x}" ] || DT_KEYS["ptrrelease"]="ctrl-f10"
[ -n "${DT_KEYS["fsleave"]+x}" ] || DT_KEYS["fsleave"]="ctrl-f11"
[ -n "${DT_KEYS["detach"]+x}" ] || DT_KEYS["detach"]="ctrl-\\"
[ -n "${DT_KEYS["quit"]+x}" ] || DT_KEYS["quit"]=
[ -n "${DT_KEYS["cycle"]+x}" ] || DT_KEYS["cycle"]="mod-tab"
[ -n "${DT_KEYS["cycleback"]+x}" ] || DT_KEYS["cycleback"]="mod-shift-tab"
[ -n "${DT_KEYS["strip"]+x}" ] || DT_KEYS["strip"]="mod-s"
[ -n "${DT_KEYS["shot"]+x}" ] || DT_KEYS["shot"]="ctrl-alt-g"
# Draw the whole screen again. The desktop's own context menu has had
# `Refresh Desktop` since it existed, and `View > Refresh` with it -- but
# that bar is the **desktop's**, and with a window focused it is the
# app's, with no Refresh on it. So the one moment it is wanted -- a
# screen gone stale, where you cannot see what you are clicking, let
# alone right-click the wallpaper behind a window -- is the moment it
# cannot be reached. A key can be pressed blind. It wears the context
# menu's own name rather than a second one for the same act.
[ -n "${DT_KEYS["refresh"]+x}" ] || DT_KEYS["refresh"]="ctrl-alt-r"
[ -n "${DT_KEYS["lock"]+x}" ] || DT_KEYS["lock"]="ctrl-alt-l"
[ -n "${DT_KEYS["undo"]+x}" ] || DT_KEYS["undo"]="mod-z"
[ -n "${DT_KEYS["save"]+x}" ] || DT_KEYS["save"]="ctrl-s"
[ -n "${DT_KEYS["redo"]+x}" ] || DT_KEYS["redo"]="mod-y"
# The sound (Gitea #306): the + and - keys themselves, = being + unshifted,
# and 0 for nothing. A keyboard's own volume keys never reach a terminal.
[ -n "${DT_KEYS["volup"]+x}" ] || DT_KEYS["volup"]="mod-="
[ -n "${DT_KEYS["voldown"]+x}" ] || DT_KEYS["voldown"]="mod--"
[ -n "${DT_KEYS["mute"]+x}" ] || DT_KEYS["mute"]="mod-0"

# The defaults above, kept, so dt_load can put one back.
declare -gA DT_KEYDEF
for dt_k in "${!DT_KEYS[@]}"; do DT_KEYDEF["$dt_k"]=${DT_KEYS["$dt_k"]}; done
unset dt_k

# Any app can have a global shortcut of its own, assigned from Settings --
# most have none, which is the point: a game or About does not want to
# steal a key from every window just for existing. term and tasks ship with
# one, since those two are reached often enough from outside any app to be
# worth a default; nothing stops a script or Settings from giving the same
# to any other, or taking these away. Nothing happens if the named app was
# never sourced, the same way dt_launch always behaves for a name nothing
# registered. alt-ctrl-, not ctrl-alt-: an alt combination arrives as ESC
# followed by the plain control byte, and the console names that "alt-"
# then whatever the control byte itself is, in that order -- unlike a
# CSI-encoded key's modifiers, which are named ctrl- before alt-. escape is
# avoided here on purpose: alt-escape is indistinguishable from a plain
# escape in most terminals, since ESC is also how alt itself arrives.
declare -gA DT_APPKEY
DT_APPKEY[term]="alt-ctrl-t"
DT_APPKEY[tasks]="alt-ctrl-p"
DT_KEYCAP=
declare -A DT

DT_WALL="${DT_WALL-#0d1b2a}"
DT_DOT="${DT_DOT-#16324a}"
DT_BAR="${DT_BAR-#1b3a5c}"
DT_ACTIVE="${DT_ACTIVE-#63b3ed}"
DT_IDLE="${DT_IDLE-#4a5568}"
DT_FACE="${DT_FACE-#101820}"
DT_INK="${DT_INK-#cbd5e0}"
# Colour roles, beside the seven a theme always has: dim text, text drawn
# on the accent (a selection), good, warning and bad (the traffic-light
# buttons, an answer, an error), info, and a darker surface for keys and
# cells to sit in. A theme file may set any of them; these are what it
# gets when it does not -- the values every dark theme was drawn with.
DT_DIM="${DT_DIM-#718096}"
DT_SELINK="${DT_SELINK-#1a202c}"
# The focused title bar and its text, where a scheme gives them: empty means
# the accent and DT_SELINK, which is what every scheme had before. A scheme
# with a dark bar and a bright accent needs the two apart (Charcoal).
DT_TITLE="${DT_TITLE-}"
DT_TITLEINK="${DT_TITLEINK-}"
# The highlight a bevelled bar's lit edge and a box's face are drawn in --
# Slate's, through the cell's line colour (Blit ADR 0210) -- where a scheme
# gives one; empty means the title bar's colour, lightened.
DT_HIGHLIGHT="${DT_HIGHLIGHT-}"
# The colour of a shadow the terminal draws (SGR 66), a scheme's `shadowink`;
# black where it says nothing.
DT_SHADOWINK="${DT_SHADOWINK:-#000000}"
DT_GOOD="${DT_GOOD-#68d391}"
DT_WARN="${DT_WARN-#f6ad55}"
DT_BAD="${DT_BAD-#f56565}"
DT_INFO="${DT_INFO-#4fd1c5}"
DT_WELL="${DT_WELL-#2d3748}"
# The colour a button is filled with while it is what a press or enter will
# do -- under the pointer, or with the focus (Gitea #384). Empty, the
# default, is the accent made brighter: see dt_hotcolour.
DT_HOT="${DT_HOT-}"
DT_GLYPH="${DT_GLYPH-·}"

# A real image as the wallpaper instead of the repeated glyph, drawn by the
# img module (mods/img) if it can be loaded -- empty means the glyph, same
# as it always has been. Setting one and setting DT_GLYPH are mutually
# exclusive in the UI (Control Panel > Wallpaper's Pattern row, the strip's
# own wallpaper module) for the same reason a radio button only shows one
# choice at a time, but nothing stops a hand-edited config from having
# both; DT_WALLIMG wins when it does. DT_WALLTRIED is not a setting -- it
# just stops dt_wall from retrying `need img` every single frame once it is
# known not to load.
DT_WALLIMG="${DT_WALLIMG-}"
DT_WALLTRIED=
# Nor is DT_WALLBAD: a picture img could not draw, tried once and not
# again while it is still the wallpaper (Gitea #301).
DT_WALLBAD=

# How the wallpaper image fills the screen: stretch (ignore its own aspect
# ratio, the original and only behaviour), scale (fit entirely within the
# screen, keeping its own ratio, the glyph pattern showing through any
# letterboxed margin), zoom (fill the screen, keeping its own ratio, the
# overflow cropped), or center (its own native size, unscaled, centred,
# cropped or letterboxed as its size and the screen's disagree). Kept in
# the static DT_KEEP list below, not with dt_keep, since that function is
# not defined yet this early in the core file's own top-to-bottom run --
# dt_keep is for variables an app or pane declares after desktop.hibr has
# already loaded.
DT_WALLMODE="${DT_WALLMODE-stretch}"

# The cursor a new terminal starts with, until the program inside it asks
# for one of its own with DECSCUSR -- block, underline or bar.
DT_CURSOR="${DT_CURSOR-block}"

# Whether the cursor blinks. Off by default: a steady cursor is what the
# terminal module has always drawn, and blinking is a look, not a fix, so it
# stays opt-in. It is no longer free, and the comment here used to say it
# was: a focused terminal is redrawn twice a second to blink, where with it
# off a terminal nobody has typed into and whose program has written nothing
# is not redrawn at all (term_dirty).
DT_CURSOR_BLINK="${DT_CURSOR_BLINK-0}"

# A window's shadow, cast on whatever is under it. On by default, since it
# costs one console darken call per window and nothing when off.
DT_SHADOW="${DT_SHADOW-1}"

# The shape every shadow is cast in (Gitea #340): `half`, half a row below
# and one column right, drawn in half blocks -- as thick each way, since a
# cell is about twice as tall as it is wide, and thinner -- or `cols`, a row
# below and two columns right, as shadows were until 0.99.286 -- or `thin`,
# an eighth of a cell down the right and along the bottom, hugging what
# casts it. Half by default; a glyph set without block elements casts cols
# whatever this says. It is the one thing that decides a shadow's shape:
# no frame, title bar or theme changes it except by choosing this.
DT_SHADOWSHAPE="${DT_SHADOWSHAPE-half}"
DT_SHADOWSHAPES=(half cols thin)

# The order of the items on the menu bar's right -- the speaker, the
# network, Bluetooth, an app's own -- as names in the order they read
# across it (Control Panel > Menu Bar > Menu Bar Items, Gitea #341,
# #396). Empty is the order they registered in, as the bar always was;
# dt_barseq reads it.
DT_BARORDER="${DT_BARORDER-}"
# Items taken off the bar by the Menu Bar Items list, by name (Gitea
# #396); one with a switch of its own (dt_bariswitch) is not kept here.
DT_BARHIDE="${DT_BARHIDE-}"
# The hibr menu's mark: pen, the glyph set's own, hui, the badge Blit draws
# from 0.2.40, or mark, its monogram from 0.3.51 (Control Panel > Menu Bar >
# Menu Mark).
DT_MENUMARK="${DT_MENUMARK-pen}"

# The same, for an open menu -- a separate setting, since a menu is drawn
# far more often than a window is moved, and someone who wants one without
# the other should be able to say so.
DT_MSHADOW="${DT_MSHADOW-1}"

# A shadow under the menu bar, giving it a sense of sitting above the
# desktop -- its own setting rather than tied to DT_SHADOW or DT_MSHADOW,
# the same reasoning as both of those already have: it is drawn every
# frame the bar is (always), not just when a window moves or a menu opens.
DT_BARSHADOW="${DT_BARSHADOW-1}"
# Control Panel > Sound: the speaker on the menu bar, and how far a key or a
# wheel notch moves the volume, in percent.
# Which sound system: Auto takes the first that answers -- PulseAudio, then
# PipeWire, then ALSA -- and a named one is used or said not to answer.
DT_SNDKIND="${DT_SNDKIND-Auto}"
DT_SNDBAR="${DT_SNDBAR-1}"
DT_SNDLEVEL="${DT_SNDLEVEL-1}"
DT_SNDSTEP="${DT_SNDSTEP-5}"
# Control Panel > Network: which network system -- Auto takes NetworkManager,
# else iproute2's view of the default route -- and the item on the menu bar.
DT_NETKIND="${DT_NETKIND-Auto}"
DT_NETBAR="${DT_NETBAR-1}"
# Control Panel > Network > No Network Password: 1 once the
# desktop has installed its polkit rule for this person (Gitea #369).
DT_NETRULE="${DT_NETRULE-}"
# Control Panel > Power (Gitea #365): the battery on the menu bar, the
# charge a note warns at (or off), the charge that is critical, and what
# the desktop does then -- nothing, suspend, hibernate or poweroff, after a
# minute in which plugging in calls it off.
DT_PWBAR="${DT_PWBAR-1}"
# The battery's percentage beside its glyph on the bar, as the speaker's
# level is beside the speaker (Gitea #395).
DT_PWLEVEL="${DT_PWLEVEL-1}"
DT_PWLOW="${DT_PWLOW-10}"
DT_PWCRIT="${DT_PWCRIT-5}"
DT_PWCRITDO="${DT_PWCRITDO-nothing}"
# Control Panel > Mouse > Hover: whether the desktop hears the pointer move
# with no button held (Gitea #370) -- on, off, or Auto, which is on where a
# display reports the pointer in pixels by itself (Blit, kitty, foot) and off
# where it reports cells only, since there plain motion is the terminal's own.
DT_HOVER="${DT_HOVER-auto}"
# Control Panel > Bluetooth: which Bluetooth system -- Auto takes BlueZ when
# it has an adapter -- and the item on the menu bar.
DT_BTKIND="${DT_BTKIND-Auto}"
DT_BTBAR="${DT_BTBAR-1}"
# Control Panel > Menu Bar > Bold Menu Titles: an app's own menu titles
# on the bar -- File, Edit and the rest -- in bold. The hibr menu and the
# open menu are bold either way; nothing else on the bar changes.
DT_MENUBOLD="${DT_MENUBOLD-0}"
# The widest a menu may be, in columns, or 0 for as wide as its longest
# row (Gitea #324): Control Panel > Menu Bar > Menu Width.
DT_MENUMAX="${DT_MENUMAX-40}"

# A shadow under a dialog's buttons -- widgets/button.hibr draws it, and
# this is its own setting for the same reason each of the others is.
DT_BTNSHADOW="${DT_BTNSHADOW-1}"

# How a dialog's buttons are drawn: filled, a block of colour each, or
# brackets, [OK] on the window's face, filled only while it has focus -- the
# same width either way, so no dialog's layout moves when it changes -- or
# chalk or slate, Blit's capped buttons, a cap each end of a framed label
# (Blit ADR 0210), drawn as filled where Blit's glyphs are not in force.
# Only this setting draws a dialog's buttons; the title bar's are Window
# Buttons'.
DT_DLGBTN="${DT_DLGBTN-filled}"
DT_DLGBTNS=(filled brackets chalk slate)

# How much a shadow darkens what is under it -- console darken's own pct,
# kept per theme rather than as one constant. 55 (its builtin default)
# reads as a soft, barely-there shadow against a dark face like midnight's,
# because scaling an already-low RGB value down by 45% is a small absolute
# change -- but the same 45% off paper's near-white face lands on a flat
# medium grey, a hard-edged block rather than a shadow. Appearance's own
# cp_theme sets this alongside the other seven colours; unset here only
# matters before it is loaded at all.
DT_SHADOW_PCT="${DT_SHADOW_PCT-55}"

# What a double click on a title bar does -- zoom, minimise, close, or
# nothing. DT_DBLMS is how close together the two clicks have to land, and
# is not itself a setting: it is a threshold, not a preference.  DT_DBLID
# and DT_DBLT track the last title-bar click, to compare the next one
# against.
DT_DBLACTION="${DT_DBLACTION-zoom}"
DT_DBLMS=400
DT_DBLID=
DT_DBLT=0

# A window's own border: single or double lined, rounded, solid -- a ring
# of whole cells in the frame's colour -- or none, no border at all, the
# title bar the only row of frame and the content to the window's edge. A
# lined style is a table entry: DT_FRAMES[name] carries its own six glyphs,
# filled from the glyph set by dt_glyphs (wm/glyphs.hibr), so another is
# six lines there, not a change to dt_win. Until 0.99.324 none was a border
# left blank and bar was what none is now; 0.99.324's curved is a title bar
# since 0.99.327, below. edge is Blit's own window frame, a line on the
# outer edge of its cells with the window's face inside it (Blit ADR 0214):
# only while Blit's glyph set is chosen, single anywhere else. A frame draws
# the frame and nothing more: the shadow is Shadow Shape's.
DT_FRAME="${DT_FRAME-single}"
# How much of a picture wallpaper shows through a window's own face and
# through the menu bar, as a tint of that colour: 0 is the theme's colour and
# 100 the picture. A terminal has its own, which wins inside it.
DT_WINTRANS="${DT_WINTRANS-0}"
DT_BARTRANS="${DT_BARTRANS-0}"
WS_FRAMES=(single double rounded solid edge none)

# The title bar: a line, the title sitting in the frame's own top line as
# it always has (with no border, on the window's face); solid -- the whole
# top row a bar of the frame's colour (the accent when focused, idle
# otherwise) with the title and buttons drawn on it in DT_SELINK, as on the
# desktops of around 2001; or curved, that bar with its top corners
# rounded, where the glyph set has a cell for it (Blit's, U+100007 and
# U+100008, blit#140) -- anywhere else it is drawn as solid and the Control
# Panel shows it dimmed. chalk and slate are Blit's pinstriped bars (Blit
# ADR 0210), and line anywhere Blit's glyphs are not in force. A title bar
# draws the row and the title; the buttons on it are Window Buttons'.
DT_TITLEBAR="${DT_TITLEBAR-line}"
DT_TITLEBARS=(line solid curved chalk slate)

# Which buttons a title bar has and where (Title Bar Buttons): DT_BTNORDER
# reads left to right across the bar, title being the title's place, so what
# comes before it sits left of it and what comes after right, and DT_BTNON
# names those switched on, so a button added later starts off for everybody. Where the title sits in the room that leaves, and
# what the buttons look like (Window Buttons): the Windows-style brackets
# this shipped with, coloured
# circles, squares, diamonds or dashes, or Blit's chalk or slate close,
# shade and zoom boxes. dt_btnspec is the table for the third of these, the
# same shape cp_theme's own case statement already is for a theme.
DT_BTNS=(title close shade max min full sticky)
DT_BTNORDER="${DT_BTNORDER-title shade max min close}"
DT_BTNON="${DT_BTNON-max min close}"
DT_TITLEALIGN="${DT_TITLEALIGN-left}"
DT_BTNSTYLE="${DT_BTNSTYLE-brackets}"
# chalk and slate buttons are Blit's boxes, on any title bar, and brackets
# anywhere Blit's glyphs are not in force; a dialog's buttons are Dialog
# Buttons'.
WS_ALIGNS=(left center right)
WS_STYLES=(brackets circles squares diamonds dashes chalk slate)

# What Zoom fills: the display the window is on, or every display at once
# (Gitea #286). Control Panel > Windows > Zoom Fills.
DT_ZOOMFILL="${DT_ZOOMFILL-display}"
DT_ZOOMFILLS=(display every)
# When a full-screen window goes back (Full Screen Ends): click, on a click
# anywhere else or any other move of the focus, or shortcut, on the Leave
# Full Screen key, so a window keeps its display while you work on another.
DT_FULLEND="${DT_FULLEND-click}"
DT_FULLENDS=(click shortcut)
# Where a window going full screen goes (Gitea #514): window, the display
# it is on; pointer, the display under the mouse; or a display's own name.
# Control Panel > Displays > Full Screen On; one setting for every program.
DT_FULLON="${DT_FULLON-window}"

# How a wallpaper image is fitted to the screen -- see dt_wallfit.
WP_MODES=(stretch scale zoom center)
# And the glyphs the pattern may be: what Control Panel > Wallpaper offers
# and what a theme's "wallpaper" is checked against, so it lives here, with
# the window manager, rather than in either of those two panes.
WP_GLYPHS=("·" "░" "▒" "⋅" "+" "╱" "▞")

# How Blit's colour icons are drawn, in the menu bar and on the desktop and in
# Files: in their own colours, or auto, in the text's colour, or black or white
# (Blit ADR 0221). Blit draws each cell as it is told, so the two are apart.
DT_ICONPENS=(colour auto black white)
DT_BARICON="${DT_BARICON-colour}"
DT_DESKICON="${DT_DESKICON-colour}"

# How an on/off choice is drawn, wherever there is one: theme -- what the
# theme suggests (DT_THEMECHECKS, set when one is applied), a box when it
# says nothing -- box "[x]", knob "(  o)", block "[  #]", tick "[✓]", or Blit's
# capsule, a knob wherever Blit's glyphs are not in force. A box is Blit's own
# under a Chalk or Slate title bar: it follows the window, and is not a choice.
DT_CHECKS="${DT_CHECKS-theme}"
DT_THEMECHECKS="${DT_THEMECHECKS-}"

# Whether a plain side (not just a corner) resizes too -- one dimension,
# the opposite edge anchored. On by default; off leaves the four corners
# as the only way, the same as before this existed. There is no top edge
# of its own regardless: row wr is the title bar over its whole width, so
# the two top corners are the only way to resize from above a window,
# with this on or off.
DT_EDGERESIZE="${DT_EDGERESIZE-1}"
# Focus Follows Mouse: resting over a window gives it the keyboard, without
# raising it, where hovering is on; the desktop under the pointer keeps the
# last focus (Gitea #370). Off by default.
DT_FOCUSHOVER="${DT_FOCUSHOVER-0}"
# The rubber band's look (Gitea #383): a single frame, dashed, solid, or
# translucent at DT_BANDPCT percent. Control Panel > Desktop, and themes.
DT_BANDS=(frame dashed solid translucent)
DT_BAND="${DT_BAND-frame}"
DT_BANDPCT="${DT_BANDPCT-30}"
# Tooltips: what a glyph with no word beside it does, said once the pointer
# has rested on it for DT_TIPMS (Gitea #370). On by default.
DT_TIPS="${DT_TIPS-1}"
DT_TIPMS="${DT_TIPMS-600}"

# Move a window by holding a modifier and dragging anywhere in its body,
# not just its title bar -- on by default with alt, as most desktops do.
# It takes an alt-click away from the app under the pointer: when it
# fires, the window manager takes the click outright, before the app ever
# sees it -- there is no "the app declined it" convention anywhere else a
# click is dispatched, and this does not invent one just for itself.
DT_DRAGMOD="${DT_DRAGMOD-1}"
# How a window moves and resizes under the mouse: by its outline, drawn by
# the console over the screen until it is let go, which costs the outline's
# edge a step and no frame at all; or solid, drawn whole at every step.
DT_MOVEMODE="${DT_MOVEMODE-outline}"
DT_DRAGKEY="${DT_DRAGKEY-alt}"
# The modifier that, held with a click on a window's title, opens the
# title's own menu where its app has one -- Files' path, the folders above
# the one shown, as System 7's command-click did.
DT_TITLEKEY="${DT_TITLEKEY-alt}"

# Whether a terminal window gives the desktop's own chord shortcuts back --
# alt-tab cycling windows rather than reaching the program inside. On by
# default: only a chord or a function key someone has bound is taken, never
# a plain key, never ctrl with one letter (dt_keyassigned), and one window can still
# be told to pass everything (term_passall), for a desktop running inside.
DT_TERMKEEP="${DT_TERMKEEP-1}"

# Whether ctrl with a single letter always reaches the program in a
# terminal window, even when one is a desktop shortcut -- they are the
# control characters programs read: ctrl-c, a shell's ctrl-w, vi's ctrl-w
# windows. On by default; off, a shortcut on ctrl-w closes even a terminal.
DT_TERMCTRL="${DT_TERMCTRL-1}"

# A terminal window's scrollbar, on its right edge -- on by default, so the
# scrollback is visible as something there is. The terminal app keeps it.
DT_TERMBAR="${DT_TERMBAR-1}"

# How many consecutive drag reports dt_run lets go by before it actually
# redraws -- 0 skips none (today's behaviour, and the default): a drag
# itself is not slower for it, since every report still updates the
# window's own position, only the screen catches up less often, which
# trades a window looking like it hops rather than glides in exchange for
# dt_win drawing every open window's own full content less often. A
# press or a release always redraws regardless -- only a drag report can
# be skipped, and only while another one immediately follows it.
DT_DRAWSKIP="${DT_DRAWSKIP-0}"
# The shortest gap, in milliseconds, between two frames that nothing a
# person did asked for -- a program writing in a terminal window, or a
# timer. A frame redraws every window, the bar and the wallpaper, which at
# a large size is several milliseconds; a program that writes in small
# bursts (a spinner in a title, a session streaming its output) asks for
# one per burst, and three such programs had a real desktop drawing about
# seventy frames a second and spending half a core on it. 33 is thirty
# frames a second, which is smooth to watch; 0 turns the limit off and
# draws on every burst as before. A key or a mouse report is never held
# back by this, so nothing a person does feels slower.
DT_TERMMS="${DT_TERMMS-70}"
# The same for a window playing video, while one is on show (Gitea #397):
# 33 ms is thirty frames a second, and 0 holds video to DT_TERMMS as well.
DT_LIVEMS="${DT_LIVEMS-33}"

# Draw every window every frame, ignoring what an app's own _dirty says.
# Not a setting anybody chooses and deliberately not in DT_KEEP: it is the
# oracle for drawing only what changed, so a test can take the same session
# both ways and compare the screen cell for cell (tests/desktop.py).
DT_FORCEDRAW="${DT_FORCEDRAW-0}"
# What Cycle (alt-tab) goes through: the windows of this workspace, or of
# every workspace, going to whichever one the next window is on.
DT_CYCLE="${DT_CYCLE-workspace}"
# The window switcher (Gitea #391): Cycle and Cycle Back open the window
# list and step through it, and a pause of DT_SWMS milliseconds -- or any
# other key -- goes to the window it stands on. Off, Cycle raises the next
# window at once, as it always did. DT_SWSKIP is the apps it passes over,
# by name, a space between: Stickies by default, since a note is not a
# window anyone means to cycle to.
DT_SWITCHER="${DT_SWITCHER-1}"
DT_SWMS="${DT_SWMS-700}"
DT_SWSKIP="${DT_SWSKIP-stickies}"

# Settings are a script of the user's own, written by the desktop whenever
# one changes and read back at the next start: plain assignments, so it can
# be edited by hand and needs no format of its own.  An app that wants a
# variable of its own kept names it with dt_keep.
DT_CONF="${DT_CONF-${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desktop.json}"
declare -gA DT_CONFJ DT_CONFOUT
DT_KEEP=(DT_WALL DT_DOT DT_BAR DT_ACTIVE DT_IDLE DT_FACE DT_INK DT_GLYPH
	DT_DIM DT_SELINK DT_GOOD DT_WARN DT_BAD DT_INFO DT_WELL DT_HOT DT_TITLE DT_TITLEINK DT_HIGHLIGHT DT_SHADOWINK
	DT_WALLIMG DT_WALLMODE
	DT_ICONS DT_DISKS DT_ICONBG DT_CURSOR DT_CURSOR_BLINK DT_SHADOW
	DT_MSHADOW DT_BARSHADOW DT_DBLACTION DT_SHADOW_PCT CS_SIDE CS_YREL
	CS_COLLAPSED CS_LEN CS_SHADOW CS_SHOW CS_HIDE CS_ORDER
	DT_BARICON DT_DESKICON DT_FRAME DT_WINTRANS DT_BARTRANS DT_TITLEBAR DT_BTNORDER DT_BTNON DT_FULLEND DT_FULLON DT_TITLEALIGN DT_BTNSTYLE DT_CHECKS DT_THEMECHECKS DT_EDGERESIZE
	DT_DRAGMOD DT_DRAGKEY DT_TITLEKEY DT_MOVEMODE DT_DRAWSKIP DT_TERMMS DT_LIVEMS DT_CYCLE DT_NOTEMS DT_NOTEPOS DT_NOTEFRAME DT_NOTECOLOUR DT_NOTEWHERE DT_NOTECOUNT DT_NOTELIST DT_NOTEWMIN DT_NOTEWMAX DT_NOTEHMIN DT_NOTEHMAX DT_SHOTDIR DT_SHOTFMT DT_SHOTLAST DT_OPENWITH DT_TERMHERE DT_CLIPKEEP DT_CLIPMAX DT_BARTIME
	DT_BARGAP DT_BELLICON DT_BARORDER DT_BARHIDE DT_MENUMARK DT_BTNSHADOW DT_SHADOWSHAPE DT_DLGBTN DT_TERMKEEP DT_TERMCTRL DT_GLYPHSET DT_PLACE DT_WSN DT_TILEMAIN DT_STANDBYAUTO DT_ZOOMFILL
	DT_SNDKIND DT_SNDBAR DT_SNDLEVEL DT_SNDSTEP DT_MENUBOLD DT_MENUMAX DT_SCROLLWHEEL DT_NETKIND DT_NETBAR DT_NETRULE DT_PWBAR DT_PWLEVEL DT_PWLOW DT_PWCRIT DT_PWCRITDO DT_HOVER DT_FOCUSHOVER DT_TIPS DT_TIPMS DT_SWITCHER DT_SWMS DT_SWSKIP DT_BAND DT_BANDPCT DT_BTKIND DT_BTBAR DT_MOD)

# Where the desktop's stderr goes while it holds the screen, so an app's
# error message cannot scribble over the display, and the reason for a
# failure is still there to read after it.
DT_LOG="${DT_LOG-${XDG_STATE_HOME:-$HOME/.local/state}/hibr/desktop.log}"
DT_ERR=

# Keep these variables in the settings file too.
dt_keep() {
	local v k

	for v in "$@"; do
		for k in "${DT_KEEP[@]}"; do
			[ "$k" = "$v" ] && continue 2
		done
		DT_KEEP+=("$v")
		dt_keepload "$v"
	done
}

# Give a kept name its saved value. Only a name something has kept is ever
# set from the file, so the file cannot reach any other variable.
fn dt_keepload(v) {
	[ -n "${DT_CONFJ["settings"]["$v"]+x}" ] || return 0
	declare -g "$v=${DT_CONFJ["settings"]["$v"]}"
}

# Read the settings file, if there is one.  It runs after the session file
# has set its defaults, so what was chosen last time wins.
dt_load() {
	local v k i ext
	local -a argv

	unset DT_CONFJ
	declare -gA DT_CONFJ
	if [ -r "$DT_CONF" ] && ! json parse DT_CONFJ < "$DT_CONF" 2> /dev/null; then
		echo "desktop: $DT_CONF is not JSON, set aside as $DT_CONF.bad" >&2
		command mv -f -- "$DT_CONF" "$DT_CONF.bad"
		unset DT_CONFJ
		declare -gA DT_CONFJ
	fi
	for v in "${DT_KEEP[@]}"; do
		dt_keepload "$v"
	done
	for k in "${!DT_CONFJ["keys"][@]}"; do
		DT_KEYS["$k"]=${DT_CONFJ["keys"]["$k"]}
	done
	for k in "${!DT_CONFJ["appkeys"][@]}"; do
		DT_APPKEY["$k"]=${DT_CONFJ["appkeys"]["$k"]}
	done
	for k in "${!DT_CONFJ["akeys"][@]}"; do
		DT_AKEY["$k"]=${DT_CONFJ["akeys"]["$k"]}
	done
	for k in "${!DT_CONFJ["noteapps"][@]}"; do
		DT_NOTEAPP["$k"]=${DT_CONFJ["noteapps"]["$k"]}
	done
	for k in "${!DT_CONFJ["icons"][@]}"; do
		DT_ICONPOS["$k"]=${DT_CONFJ["icons"]["$k"]}
	done
	for k in "${!DT_CONFJ["displays"][@]}"; do
		dt_walldisp "$k" "${DT_CONFJ["displays"]["$k"]["img"]}" \
			"${DT_CONFJ["displays"]["$k"]["mode"]}" \
			"${DT_CONFJ["displays"]["$k"]["pic"]}"
	done
	for ext in "${!DT_CONFJ["handlers"][@]}"; do
		argv=()
		[ "${DT_CONFJ["handlers"]["$ext"]["term"]}" = 1 ] && argv=(term)
		for i in "${!DT_CONFJ["handlers"]["$ext"]["argv"][@]}"; do
			argv+=("${DT_CONFJ["handlers"]["$ext"]["argv"][$i]}")
		done
		dt_handler "$ext" "${argv[@]}"
	done
	dt_keydups
	dt_glyphs "$DT_GLYPHSET"
	return 0
}

# Write every kept variable back, through a temporary file and a rename,
# so a crash halfway through never leaves half a settings file. A setting
# nothing has kept yet this session, a pane not loaded, goes back as it came.
dt_save() {
	local v k n i s tmp=$DT_CONF.$$

	mkdir -p "${DT_CONF%/*}" 2> /dev/null || return 1
	unset DT_CONFOUT
	declare -gA DT_CONFOUT
	for k in "${!DT_CONFJ["settings"][@]}"; do
		DT_CONFOUT["settings"]["$k"]=${DT_CONFJ["settings"]["$k"]}
	done
	for v in "${DT_KEEP[@]}"; do
		[ -n "${!v+set}" ] && DT_CONFOUT["settings"]["$v"]=${!v}
	done
	for k in "${!DT_KEYS[@]}"; do
		DT_CONFOUT["keys"]["$k"]=${DT_KEYS["$k"]}
	done
	for k in "${!DT_APPKEY[@]}"; do
		DT_CONFOUT["appkeys"]["$k"]=${DT_APPKEY["$k"]}
	done
	for k in "${!DT_AKEY[@]}"; do
		DT_CONFOUT["akeys"]["$k"]=${DT_AKEY["$k"]}
	done
	for k in "${!DT_NOTEAPP[@]}"; do
		DT_CONFOUT["noteapps"]["$k"]=${DT_NOTEAPP["$k"]}
	done
	for k in "${!DT_ICONPOS[@]}"; do
		DT_CONFOUT["icons"]["$k"]=${DT_ICONPOS["$k"]}
	done
	for k in "${!DT_WALLDMODE[@]}"; do
		DT_CONFOUT["displays"]["$k"]["img"]=${DT_WALLDIMG["$k"]}
		DT_CONFOUT["displays"]["$k"]["mode"]=${DT_WALLDMODE["$k"]}
		DT_CONFOUT["displays"]["$k"]["pic"]=${DT_WALLDPIC["$k"]}
	done
	for k in "${!DT_HANDLERS[@]}"; do
		n=${DT_HANDLERS[$k]["n"]}
		DT_CONFOUT["handlers"]["$k"]["term"]=${DT_HANDLERS[$k]["term"]:-0}
		for ((i = 0; i < n; i++)); do
			DT_CONFOUT["handlers"]["$k"]["argv"][$i]=${DT_HANDLERS[$k][$i]}
		done
	done
	s := json emit DT_CONFOUT -p
	printf '%s\n' "$s" > "$tmp" && mv -f "$tmp" "$DT_CONF"
}
