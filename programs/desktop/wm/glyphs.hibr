	dt_bg ffolder_green file-folder-green-left file-folder-green-right
	dt_bg ffolder_amber file-folder-amber-left file-folder-amber-right
	# Kinds added later go one at a time, four colourways each (0.3.6).
	dt_bg fhome file-home-classic-left file-home-classic-right
