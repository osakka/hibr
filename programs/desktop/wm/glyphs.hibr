#!/usr/bin/env hibr
#
# wm/glyphs -- every character the desktop draws that is not plain text,
# by name: GL[vline] rather than a literal │ in the middle of a line of
# code. One place to read what a glyph is for, one place to change it, and
# a second set in plain ASCII for a terminal or a font that has none of
# them -- a Linux console, an old ssh client -- a third, nerd, for a
# terminal whose font is a Nerd Font, and a fourth, blit, for Blit's own
# fonts, which add colour icons of their own to Nerd's -- chosen by DT_GLYPHSET
# (Control Panel > Appearance > Glyphs).
#
# Written as $'\uXXXX', the character's code point, with its Unicode name
# beside it, so a line says what the character is even where the editor
# shows nothing. Named for what it is drawn as, not where: one shape has
# one plain-ASCII stand-in wherever it appears.
#
# Not here, on purpose: the icon an app or a pane chooses for itself (its
# dt_app or cp_pane line is the clearest place to read it), lists that are
# themselves choices of character (the wallpaper glyphs, the notification
# icons), and punctuation in prose ("Custom…", "moving — arrows").
#
# Part of the window manager; desktop.hibr sources it first, since the
# frame styles in settings are built from it.

strict

declare -gA GL
declare -gA DT_FRAMES
DT_GLYPHSET="${DT_GLYPHSET-unicode}"
DT_GLYPHSETS=(unicode ascii nerd blit)
# The set in force, exported so the shells a terminal window starts draw
# their prompt in it too: the prompt module's PROMPT[glyphs]=auto reads it
# (Gitea #360), since a program cannot ask a terminal which font it has.
export HIBR_GLYPHS="${HIBR_GLYPHS-}"

# Fill GL, and the frame styles drawn from it, with one set: unicode or
# ascii. Anything else is unicode.
fn dt_glyphs(set = "unicode") {
	HIBR_GLYPHS=$set
	# Names only the blit set fills, emptied first so that a set chosen
	# after it does not keep them: dt_netbars draws Blit's four Wi-Fi
	# levels whenever wifi4 has a glyph.
	GL["wifi1"]=; GL["wifi2"]=; GL["wifi3"]=; GL["wifi4"]=
	# And the battery and the speaker drawn as one picture a state, which
	# dt_pwbar and dt_sndbar use only when they are set.
	GL["batchg0"]=; GL["batchg1"]=; GL["batchg2"]=; GL["batchg3"]=
	GL["batchg4"]=; GL["batfull"]=
	GL["vol0"]=; GL["vol1"]=; GL["vol2"]=; GL["vol3"]=
	GL["huil"]=; GL["huir"]=
	# And longwire's telephone (its menu bar item and strip module), which
	# it draws with its own characters when these are empty.
	GL["phoneoff"]=; GL["phonewait"]=; GL["phoneon"]=; GL["phonering"]=
	GL["phoneoffc"]=; GL["phonewaitc"]=; GL["phoneonc"]=; GL["phoneringc"]=
	# Files' icons two columns wide in four colourways (Blit 0.3.4), each a
	# left and right pair; Files draws its own when these are empty.
	GL["ffolder"]=; GL["fdoc"]=; GL["ftext"]=; GL["fpdf"]=;
	GL["fimage"]=; GL["faudio"]=; GL["fvideo"]=; GL["farchive"]=;
	GL["fcode"]=; GL["fapp"]=; GL["fdisk"]=; GL["ftrash"]=;
	GL["ffolder_blue"]=; GL["fdoc_blue"]=; GL["ftext_blue"]=; GL["fpdf_blue"]=;
	GL["fimage_blue"]=; GL["faudio_blue"]=; GL["fvideo_blue"]=; GL["farchive_blue"]=;
	GL["fcode_blue"]=; GL["fapp_blue"]=; GL["fdisk_blue"]=; GL["ftrash_blue"]=;
	GL["ffolder_green"]=; GL["fdoc_green"]=; GL["ftext_green"]=; GL["fpdf_green"]=;
	GL["fimage_green"]=; GL["faudio_green"]=; GL["fvideo_green"]=; GL["farchive_green"]=;
	GL["fcode_green"]=; GL["fapp_green"]=; GL["fdisk_green"]=; GL["ftrash_green"]=;
	GL["ffolder_amber"]=; GL["fdoc_amber"]=; GL["ftext_amber"]=; GL["fpdf_amber"]=;
	GL["fimage_amber"]=; GL["faudio_amber"]=; GL["fvideo_amber"]=; GL["farchive_amber"]=;
	GL["fcode_amber"]=; GL["fapp_amber"]=; GL["fdisk_amber"]=; GL["ftrash_amber"]=;
	GL["fhome"]=; GL["fhome_blue"]=; GL["fhome_green"]=; GL["fhome_amber"]=
	GL["fboxer"]=; GL["fboxer_blue"]=; GL["fboxer_green"]=; GL["fboxer_amber"]=
	GL["fmd"]=; GL["fmd_blue"]=; GL["fmd_green"]=; GL["fmd_amber"]=
	GL["fsheet"]=; GL["fsheet_blue"]=; GL["fsheet_green"]=; GL["fsheet_amber"]=
	GL["fdiagram"]=; GL["fdiagram_blue"]=; GL["fdiagram_green"]=; GL["fdiagram_amber"]=
	GL["fslides"]=; GL["fslides_blue"]=; GL["fslides_green"]=; GL["fslides_amber"]=
	GL["ffont"]=; GL["ffont_blue"]=; GL["ffont_green"]=; GL["ffont_amber"]=
	GL["fweb"]=; GL["fweb_blue"]=; GL["fweb_green"]=; GL["fweb_amber"]=
	GL["fterm"]=; GL["fterm_blue"]=; GL["fterm_green"]=; GL["fterm_amber"]=
	GL["fsettings"]=; GL["fsettings_blue"]=; GL["fsettings_green"]=; GL["fsettings_amber"]=
	GL["fbundle"]=; GL["fbundle_blue"]=; GL["fbundle_green"]=; GL["fbundle_amber"]=
	GL["flink"]=; GL["flink_blue"]=; GL["flink_green"]=; GL["flink_amber"]=
	GL["fgit"]=; GL["fgit_blue"]=; GL["fgit_green"]=; GL["fgit_amber"]=
	GL["fconfig"]=; GL["fconfig_blue"]=; GL["fconfig_green"]=; GL["fconfig_amber"]=
	GL["flocal"]=; GL["flocal_blue"]=; GL["flocal_green"]=; GL["flocal_amber"]=
	GL["fsystem"]=; GL["fsystem_blue"]=; GL["fsystem_green"]=; GL["fsystem_amber"]=
	GL["fdesktop"]=; GL["fdesktop_blue"]=; GL["fdesktop_green"]=; GL["fdesktop_amber"]=
	GL["fdownloads"]=; GL["fdownloads_blue"]=; GL["fdownloads_green"]=; GL["fdownloads_amber"]=
	GL["fdocuments"]=; GL["fdocuments_blue"]=; GL["fdocuments_green"]=; GL["fdocuments_amber"]=
	GL["fmusic"]=; GL["fmusic_blue"]=; GL["fmusic_green"]=; GL["fmusic_amber"]=
	GL["fpictures"]=; GL["fpictures_blue"]=; GL["fpictures_green"]=; GL["fpictures_amber"]=
	GL["fvideos"]=; GL["fvideos_blue"]=; GL["fvideos_green"]=; GL["fvideos_amber"]=
	GL["fapps"]=; GL["fapps_blue"]=; GL["fapps_green"]=; GL["fapps_amber"]=
	GL["fgames"]=; GL["fgames_blue"]=; GL["fgames_green"]=; GL["fgames_amber"]=
	GL["frc"]=; GL["frc_blue"]=; GL["frc_green"]=; GL["frc_amber"]=
	GL["fhistory"]=; GL["fhistory_blue"]=; GL["fhistory_green"]=; GL["fhistory_amber"]=
	GL["fservice"]=; GL["fservice_blue"]=; GL["fservice_green"]=; GL["fservice_amber"]=
	GL["fkey"]=; GL["fkey_blue"]=; GL["fkey_green"]=; GL["fkey_amber"]=
	GL["fnetwork"]=; GL["fnetwork_blue"]=; GL["fnetwork_green"]=; GL["fnetwork_amber"]=
	GL["fcron"]=; GL["fcron_blue"]=; GL["fcron_green"]=; GL["fcron_amber"]=
	GL["freadme"]=; GL["freadme_blue"]=; GL["freadme_green"]=; GL["freadme_amber"]=
	GL["flicense"]=; GL["flicense_blue"]=; GL["flicense_green"]=; GL["flicense_amber"]=
	GL["flog"]=; GL["flog_blue"]=; GL["flog_green"]=; GL["flog_amber"]=
	GL["fkernel"]=; GL["fkernel_blue"]=; GL["fkernel_green"]=; GL["fkernel_amber"]=
	GL["fboot"]=; GL["fboot_blue"]=; GL["fboot_green"]=; GL["fboot_amber"]=
	GL["fc"]=; GL["fc_blue"]=; GL["fc_green"]=; GL["fc_amber"]=
	GL["fasm"]=; GL["fasm_blue"]=; GL["fasm_green"]=; GL["fasm_amber"]=
	GL["fmake"]=; GL["fmake_blue"]=; GL["fmake_green"]=; GL["fmake_amber"]=
	GL["fpatch"]=; GL["fpatch_blue"]=; GL["fpatch_green"]=; GL["fpatch_amber"]=
	GL["fjson"]=; GL["fjson_blue"]=; GL["fjson_green"]=; GL["fjson_amber"]=
	GL["fvector"]=; GL["fvector_blue"]=; GL["fvector_green"]=; GL["fvector_amber"]=
	GL["from"]=; GL["from_blue"]=; GL["from_green"]=; GL["from_amber"]=
	GL["febook"]=; GL["febook_blue"]=; GL["febook_green"]=; GL["febook_amber"]=
	GL["fexe"]=; GL["fexe_blue"]=; GL["fexe_green"]=; GL["fexe_amber"]=
	GL["fdisc"]=; GL["fdisc_blue"]=; GL["fdisc_green"]=; GL["fdisc_amber"]=
	GL["fpackage"]=; GL["fpackage_blue"]=; GL["fpackage_green"]=; GL["fpackage_amber"]=
	GL["flibrary"]=; GL["flibrary_blue"]=; GL["flibrary_green"]=; GL["flibrary_amber"]=
	GL["flock"]=; GL["flock_blue"]=; GL["flock_green"]=; GL["flock_amber"]=
	GL["fdatabase"]=; GL["fdatabase_blue"]=; GL["fdatabase_green"]=; GL["fdatabase_amber"]=
	GL["fusb"]=; GL["fusb_blue"]=; GL["fusb_green"]=; GL["fusb_amber"]=
	GL["fshare"]=; GL["fshare_blue"]=; GL["fshare_green"]=; GL["fshare_amber"]=
	# The hibr menu's own mark, U+270E in every set but blit's.
	GL["hibr"]=$'\u270e'      # LOWER RIGHT PENCIL
	if [ "$set" = ascii ]; then
		GL["hline"]="-"; GL["vline"]="|"
		GL["tl"]="+"; GL["tr"]="+"; GL["bl"]="+"; GL["br"]="+"
		GL["dhline"]="="; GL["dvline"]="|"
		GL["dtl"]="+"; GL["dtr"]="+"; GL["dbl"]="+"; GL["dbr"]="+"
		GL["rtl"]="."; GL["rtr"]="."; GL["rbl"]="'"; GL["rbr"]="'"
		GL["capl"]=" "; GL["capr"]=" "
		GL["diamond"]="*"; GL["minus"]="-"
		GL["teel"]="["; GL["teer"]="]"
		# A tree's own two, kept apart from the frame's tees so that
		# changing one cannot move the other: ascii has no corner.
		GL["ttee"]="+"; GL["tend"]="\`"
		GL["dashh"]="-"; GL["dashv"]=":"
		GL["grow"]="/"
		GL["block"]="#"; GL["light"]="."; GL["medium"]=":"
		GL["upper"]="="; GL["lower"]="_"
		GL["dot"]="."; GL["bullet"]="*"; GL["circle"]="o"; GL["grip"]="="
		GL["square"]="#"; GL["box"]="o"; GL["ring"]="@"
		GL["up"]="^"; GL["down"]="v"; GL["right"]=">"
		GL["sright"]=">"; GL["sleft"]="<"; GL["sdown"]="v"; GL["sup"]="^"
		GL["reload"]="@"; GL["plus"]="+"; GL["larr"]="<"; GL["rarr"]=">"
		GL["arrowup"]="^"; GL["hook"]=">"
		GL["file"]="-"; GL["folder"]="+"; GL["bundle"]="#"
		GL["folderbig"]="++"; GL["bundlebig"]="##"
		GL["power"]="pwr"
		GL["cross"]="x"; GL["xmark"]="x"; GL["check"]="*"; GL["tick"]="v"
		GL["sound"]="vol"; GL["soundoff"]="vol x"
		GL["wifi"]="wifi"; GL["wired"]="lan"; GL["netoff"]="net x"
		GL["bar1"]="."; GL["bar2"]=":"; GL["bar3"]="i"; GL["bar4"]="I"; GL["baroff"]="_"
		GL["secure"]="*"
		GL["bt"]="bt"; GL["btoff"]="bt x"
		GL["bat0"]="bat"; GL["bat1"]="bat"; GL["bat2"]="bat"
		GL["bat3"]="bat"; GL["bat4"]="bat"; GL["batchg"]="+"
		GL["batac"]="~"
		GL["star"]="*"; GL["flag"]="!"; GL["heart"]="*"; GL["warn"]="!"
		GL["unlocked"]="!"
		GL["task"]="[ ]"; GL["taskdone"]="[x]"; GL["pin"]="*"
		GL["newline"]="~"; GL["ellipsis"]="~"; GL["quote"]='"'; GL["dash"]="-"
		GL["fx"]="fx"
		GL["home"]="H"; GL["trash"]="u"; GL["trashfull"]="U"; GL["disk"]="D"
		GL["spark1"]="_"; GL["spark2"]="."; GL["spark3"]="-"
		GL["spark4"]=":"; GL["spark5"]="="; GL["spark6"]="+"
		GL["spark7"]="*"; GL["spark8"]="#"
	else
		GL["hline"]=$'─'     # BOX DRAWINGS LIGHT HORIZONTAL
		GL["vline"]=$'│'     # BOX DRAWINGS LIGHT VERTICAL
		GL["tl"]=$'┌'        # BOX DRAWINGS LIGHT DOWN AND RIGHT
		GL["tr"]=$'┐'        # BOX DRAWINGS LIGHT DOWN AND LEFT
		GL["bl"]=$'└'        # BOX DRAWINGS LIGHT UP AND RIGHT
		GL["br"]=$'┘'        # BOX DRAWINGS LIGHT UP AND LEFT
		GL["dhline"]=$'═'    # BOX DRAWINGS DOUBLE HORIZONTAL
		GL["dvline"]=$'║'    # BOX DRAWINGS DOUBLE VERTICAL
		GL["dtl"]=$'╔'       # BOX DRAWINGS DOUBLE DOWN AND RIGHT
		GL["rtl"]=$'╭'       # BOX DRAWINGS LIGHT ARC DOWN AND RIGHT
		GL["rtr"]=$'╮'       # BOX DRAWINGS LIGHT ARC DOWN AND LEFT
		GL["rbl"]=$'╰'       # BOX DRAWINGS LIGHT ARC UP AND RIGHT
		GL["rbr"]=$'╯'       # BOX DRAWINGS LIGHT ARC UP AND LEFT
		GL["capl"]=" "; GL["capr"]=" "
		GL["diamond"]=$'◆'   # BLACK DIAMOND
		GL["minus"]=$'━'     # BOX DRAWINGS HEAVY HORIZONTAL
		GL["dtr"]=$'╗'       # BOX DRAWINGS DOUBLE DOWN AND LEFT
		GL["dbl"]=$'╚'       # BOX DRAWINGS DOUBLE UP AND RIGHT
		GL["dbr"]=$'╝'       # BOX DRAWINGS DOUBLE UP AND LEFT
		GL["teel"]=$'┤'      # BOX DRAWINGS LIGHT VERTICAL AND LEFT
		GL["teer"]=$'├'      # BOX DRAWINGS LIGHT VERTICAL AND RIGHT
		GL["ttee"]=$'├'      # BOX DRAWINGS LIGHT VERTICAL AND RIGHT
		GL["tend"]=$'└'      # BOX DRAWINGS LIGHT UP AND RIGHT
		GL["dashh"]=$'┄'     # BOX DRAWINGS LIGHT TRIPLE DASH HORIZONTAL
		GL["dashv"]=$'┆'     # BOX DRAWINGS LIGHT TRIPLE DASH VERTICAL
		GL["grow"]=$'◢'      # BLACK LOWER RIGHT TRIANGLE
		GL["block"]=$'█'     # FULL BLOCK
		GL["light"]=$'░'     # LIGHT SHADE
		GL["medium"]=$'▒'    # MEDIUM SHADE
		GL["upper"]=$'▀'     # UPPER HALF BLOCK
		GL["lower"]=$'▄'     # LOWER HALF BLOCK
		GL["dot"]=$'·'       # MIDDLE DOT
		GL["bullet"]=$'•'    # BULLET
		GL["grip"]=$'≡'      # IDENTICAL TO
		GL["circle"]=$'●'    # BLACK CIRCLE
		GL["square"]=$'■'    # BLACK SQUARE
		GL["box"]=$'□'       # WHITE SQUARE
		GL["ring"]=$'◉'      # FISHEYE
		GL["up"]=$'▲'        # BLACK UP-POINTING TRIANGLE
		GL["down"]=$'▼'      # BLACK DOWN-POINTING TRIANGLE
		GL["right"]=$'▶'     # BLACK RIGHT-POINTING TRIANGLE
		GL["sright"]=$'▸'    # BLACK RIGHT-POINTING SMALL TRIANGLE
		GL["sleft"]=$'◂'     # BLACK LEFT-POINTING SMALL TRIANGLE
		GL["reload"]=$'\u21bb'  # CLOCKWISE OPEN CIRCLE ARROW
		GL["plus"]="+"
		GL["larr"]=$'\u2190'    # LEFTWARDS ARROW
		GL["rarr"]=$'\u2192'    # RIGHTWARDS ARROW
		GL["sdown"]=$'▾'     # BLACK DOWN-POINTING SMALL TRIANGLE
		GL["sup"]=$'▴'       # BLACK UP-POINTING SMALL TRIANGLE
		GL["arrowup"]=$'↑'   # UPWARDS ARROW
		GL["hook"]=$'↪'      # RIGHTWARDS ARROW WITH HOOK
		GL["file"]=$'▯'      # WHITE VERTICAL RECTANGLE
		GL["folder"]=$'▤'    # SQUARE WITH HORIZONTAL FILL
		GL["bundle"]=$'▣'    # WHITE SQUARE CONTAINING BLACK SMALL SQUARE, a folder that is one thing
		# Files' icon view: two of a shape that is one cell, where an
		# icon font's one glyph is a whole picture (dt_glyphsnerd).
		GL["folderbig"]=$'▤▤'
		GL["bundlebig"]=$'▣▣'
		GL["power"]=$'⏻'    # POWER SYMBOL: the computer, no battery
		GL["cross"]=$'✕'     # MULTIPLICATION X
		GL["xmark"]=$'✗'     # BALLOT X
		GL["check"]=$'✓'     # CHECK MARK
		GL["tick"]=$'✓'      # CHECK MARK, a checkbox's tick
		GL["sound"]=$'♪'     # EIGHTH NOTE, the speaker on the bar
		GL["soundoff"]=$'♪ ✕' # EIGHTH NOTE, MULTIPLICATION X: muted
		GL["wifi"]=""         # Wi-Fi is its signal bars alone, as nmcli draws it
		GL["wired"]=$'⇌'     # RIGHTWARDS HARPOON OVER LEFTWARDS HARPOON
		GL["netoff"]=$'✕'    # MULTIPLICATION X: no network
		GL["bar1"]=$'▂'; GL["bar2"]=$'▄'; GL["bar3"]=$'▆'; GL["bar4"]=$'█' # LOWER ONE QUARTER BLOCK .. FULL BLOCK
		GL["baroff"]=$'_'    # LOW LINE: a bar the signal does not reach
		GL["secure"]=$'⚿'    # SQUARED KEY: a network that asks for a password
		GL["bt"]=$'ᛒ'       # RUNIC LETTER BERKANAN BEORC BJARKAN B, Bluetooth's own
		GL["btoff"]=$'ᛒ ✕' # the same, MULTIPLICATION X: switched off
		# A battery's charge as a level: LOWER ONE EIGHTH BLOCK .. FULL BLOCK
		GL["bat0"]=$'\u2581'; GL["bat1"]=$'\u2582'; GL["bat2"]=$'\u2584'
		GL["bat3"]=$'\u2586'; GL["bat4"]=$'\u2588'
		GL["batchg"]=$'\u21af'  # DOWNWARDS ZIGZAG ARROW: charging
		GL["batac"]=$'\u2301'   # ELECTRIC ARROW: on mains, not charging
		GL["star"]=$'✱'      # HEAVY ASTERISK
		GL["task"]=$'☐'      # BALLOT BOX
		GL["taskdone"]=$'☑'  # BALLOT BOX WITH CHECK
		GL["pin"]=$'★'       # BLACK STAR
		GL["newline"]=$'⏎'   # RETURN SYMBOL
		GL["ellipsis"]=$'…'  # HORIZONTAL ELLIPSIS
		GL["quote"]=$'❝'     # HEAVY DOUBLE TURNED COMMA QUOTATION MARK ORNAMENT
		GL["fx"]=$'ƒx'    # LATIN SMALL LETTER F WITH HOOK, then x
		GL["dash"]=$'—'      # EM DASH
		GL["flag"]=$'⚑'      # BLACK FLAG
		GL["unlocked"]=$'\u26bf'  # SQUARED KEY
		GL["heart"]=$'♥'     # BLACK HEART SUIT
		GL["warn"]=$'⚠'      # WARNING SIGN
		GL["home"]=$'⌂'      # HOUSE
		GL["trash"]=$'▽'     # WHITE DOWN-POINTING TRIANGLE
		GL["trashfull"]=$'▼' # BLACK DOWN-POINTING TRIANGLE
		GL["disk"]=$'▥'      # SQUARE WITH VERTICAL FILL
		GL["spark1"]=$'▁'    # LOWER ONE EIGHTH BLOCK
		GL["spark2"]=$'▂'    # LOWER ONE QUARTER BLOCK
		GL["spark3"]=$'▃'    # LOWER THREE EIGHTHS BLOCK
		GL["spark4"]=$'▄'    # LOWER HALF BLOCK
		GL["spark5"]=$'▅'    # LOWER FIVE EIGHTHS BLOCK
		GL["spark6"]=$'▆'    # LOWER THREE QUARTERS BLOCK
		GL["spark7"]=$'▇'    # LOWER SEVEN EIGHTHS BLOCK
		GL["spark8"]=$'█'    # FULL BLOCK
	fi
	[ "$set" = nerd ] && dt_glyphsnerd
	if [ "$set" = blit ]; then
		dt_glyphsnerd
		dt_glyphsblit
	fi
	DT_FRAMES["single"]["tl"]=${GL["tl"]}; DT_FRAMES["single"]["tr"]=${GL["tr"]}
	DT_FRAMES["single"]["bl"]=${GL["bl"]}; DT_FRAMES["single"]["br"]=${GL["br"]}
	DT_FRAMES["single"]["h"]=${GL["hline"]}; DT_FRAMES["single"]["v"]=${GL["vline"]}
	DT_FRAMES["double"]["tl"]=${GL["dtl"]}; DT_FRAMES["double"]["tr"]=${GL["dtr"]}
	DT_FRAMES["double"]["bl"]=${GL["dbl"]}; DT_FRAMES["double"]["br"]=${GL["dbr"]}
	DT_FRAMES["double"]["h"]=${GL["dhline"]}; DT_FRAMES["double"]["v"]=${GL["dvline"]}
	DT_FRAMES["rounded"]["tl"]=${GL["rtl"]}; DT_FRAMES["rounded"]["tr"]=${GL["rtr"]}
	DT_FRAMES["rounded"]["bl"]=${GL["rbl"]}; DT_FRAMES["rounded"]["br"]=${GL["rbr"]}
	DT_FRAMES["rounded"]["h"]=${GL["hline"]}; DT_FRAMES["rounded"]["v"]=${GL["vline"]}
}
# The nerd set: unicode, with the names a Nerd Font has a real icon for --
# folders and files, home, disks, the trash, marks and flags -- taken from
# its Private Use Area, Font Awesome's code points that every Nerd Font
# carries. It draws only when the terminal's font is a Nerd Font, which no
# terminal can be asked, so it is chosen, never detected; a "Mono" variant
# keeps every icon one cell wide.
dt_glyphsnerd() {
	GL["sound"]=$'\uf028'     # nf-fa-volume_up
	GL["soundoff"]=$'\uf026'  # nf-fa-volume_off
	GL["wifi"]=$'\uf1eb'      # nf-fa-wifi
	GL["wired"]=$'\uf1e6'     # nf-fa-plug
	GL["netoff"]=$'\uf05e'    # nf-fa-ban
	GL["secure"]=$'\uf023'    # nf-fa-lock
	GL["bt"]=$'\uf293'        # nf-fa-bluetooth
	GL["btoff"]=$'\uf293 \uf00d' # nf-fa-bluetooth, nf-fa-times
	GL["bat0"]=$'\uf244'      # nf-fa-battery_empty
	GL["bat1"]=$'\uf243'      # nf-fa-battery_quarter
	GL["bat2"]=$'\uf242'      # nf-fa-battery_half
	GL["bat3"]=$'\uf241'      # nf-fa-battery_three_quarters
	GL["bat4"]=$'\uf240'      # nf-fa-battery_full
	GL["batchg"]=$'\uf0e7'    # nf-fa-bolt: charging
	GL["batac"]=$'\uf1e6'     # nf-fa-plug: on mains, not charging
	GL["folder"]=$'\uf07b'    # nf-fa-folder
	GL["bundle"]=$'\uf1b2'    # nf-fa-cube
	# One picture, not two of it side by side (the owner, on Blit).
	GL["folderbig"]=$'\uf07b'
	GL["bundlebig"]=$'\uf1b2'
	GL["power"]=$'\uf011'      # nf-fa-power_off
	GL["file"]=$'\uf15b'      # nf-fa-file
	GL["home"]=$'\uf015'      # nf-fa-home
	GL["disk"]=$'\uf0a0'      # nf-fa-hdd_o
	GL["trash"]=$'\uf014'     # nf-fa-trash_o
	GL["trashfull"]=$'\uf1f8' # nf-fa-trash
	GL["reload"]=$'\uf021'    # nf-fa-refresh
	GL["check"]=$'\uf00c'     # nf-fa-check
	GL["tick"]=$'\uf00c'      # nf-fa-check
	GL["cross"]=$'\uf00d'     # nf-fa-times
	GL["xmark"]=$'\uf00d'     # nf-fa-times
	GL["star"]=$'\uf005'      # nf-fa-star
	GL["flag"]=$'\uf024'      # nf-fa-flag
	GL["unlocked"]=$'\uf09c'  # nf-fa-unlock
	GL["heart"]=$'\uf004'     # nf-fa-heart
	GL["warn"]=$'\uf071'      # nf-fa-warning
	GL["pin"]=$'\uf08d'       # nf-fa-thumb_tack
	GL["task"]=$'\uf096'      # nf-fa-square_o
	GL["taskdone"]=$'\uf046'  # nf-fa-check_square_o
	GL["fx"]=$''       # nf-fa-calculator
}

# The blit set (Gitea #330): the nerd set, since Blit's own fonts carry the
# whole Nerd catalogue, and over it the originals Blit drew for hibr --
# intrinsic-colour icons one cell wide, at supplementary private-use code
# points that mean nothing in any other font (Blit's
# assets/fonts/icons/catalogue.json, docs/font-reference.md). Chosen, never
# detected, like nerd: a person on Blit's Retro or Modern profile picks it,
# and anywhere else the other three are what to pick. Choosing it is the one
# switch: everything Blit draws for hibr follows it -- the icons below and
# the Menu Bar pane's Menu Mark -- with no second condition of its own
# (the owner, 0.99.360). It wants a Blit as new as the hibr it runs; they
# ship together, and an older one draws its newest icons as blank cells.
dt_glyphsblit() {
	GL["hibr"]=$'\U00100001'   # Blit hibr-pen, the colour hibr menu mark
	GL["wifi1"]=$'\U00100002'  # Blit wifi-1, signal level 1 of 4
	GL["wifi2"]=$'\U00100003'  # Blit wifi-2
	GL["wifi3"]=$'\U00100004'  # Blit wifi-3
	GL["wifi4"]=$'\U00100005'  # Blit wifi-4
	GL["bt"]=$'\U00100006'     # Blit bluetooth, in its own colours
	GL["btoff"]=$'\U00100006 \uf00d' # the same, nf-fa-times
	# Blit bar-corner-left and -right (blit#140): a cell filled but for
	# its top-left or top-right corner, rounded -- a curved frame's title
	# bar meeting the window's content square below.
	GL["capl"]=$'\U00100007'
	GL["capr"]=$'\U00100008'
	# The battery and the speaker, one picture a state, the charge or the
	# level inside it (Blit 0.2.38, ADR 0196 there).
	GL["bat0"]=$'\U00100009'   # Blit battery-0
	GL["bat1"]=$'\U0010000A'   # Blit battery-1
	GL["bat2"]=$'\U0010000B'   # Blit battery-2
	GL["bat3"]=$'\U0010000C'   # Blit battery-3
	GL["bat4"]=$'\U0010000D'   # Blit battery-4
	GL["batchg0"]=$'\U0010000E' # Blit battery-0-charging
	GL["batchg1"]=$'\U0010000F' # Blit battery-1-charging
	GL["batchg2"]=$'\U00100010' # Blit battery-2-charging
	GL["batchg3"]=$'\U00100011' # Blit battery-3-charging
	GL["batchg4"]=$'\U00100012' # Blit battery-4-charging
	GL["batfull"]=$'\U00100013' # Blit battery-ac: on mains, not charging
	GL["vol0"]=$'\U00100014'   # Blit volume-0, muted
	GL["vol1"]=$'\U00100015'   # Blit volume-1
	GL["vol2"]=$'\U00100016'   # Blit volume-2
	GL["vol3"]=$'\U00100017'   # Blit volume-3
	# The hui mark (Blit 0.2.40, ADR 0197 there): one badge two cells
	# square, drawn as its left and its right half, written side by side
	# -- the hibr menu's mark where Menu Bar > Menu Mark asks for it.
	GL["huil"]=$'\U00100018'   # Blit hui-left
	GL["huir"]=$'\U00100019'   # Blit hui-right
	# The power symbol, in Blit's colours (0.2.41): the Power item on a
	# machine with no battery.
	GL["power"]=$'\U0010001A'  # Blit power
	# A telephone in four states (0.2.44), one column each, for longwire.
	GL["phoneoff"]=$'\U0010001B'  # Blit phone-off, an outline
	GL["phonewait"]=$'\U0010001C' # Blit phone-wait, dashed
	GL["phoneon"]=$'\U0010001D'   # Blit phone-on, filled
	GL["phonering"]=$'\U0010001E' # Blit phone-ring, with waves
	# And the classic rotary desk telephone (0.2.45), for longwire's Phone
	# Style: Classic.
	GL["phoneoffc"]=$'\U0010001F'  # Blit classic-off, an outline
	GL["phonewaitc"]=$'\U00100020' # Blit classic-wait, dashed
	GL["phoneonc"]=$'\U00100021'   # Blit classic-on, filled
	GL["phoneringc"]=$'\U00100022' # Blit classic-ring, with waves
	# Files' icons (0.3.4), two columns each, a left then right pair:
	# classic, blue, green and amber, each kind in the same order.
	GL["ffolder"]=$'\U00100033\U00100034' # Blit file-folder-classic
	GL["fdoc"]=$'\U00100035\U00100036' # Blit file-document-classic
	GL["ftext"]=$'\U00100037\U00100038' # Blit file-text-classic
	GL["fpdf"]=$'\U00100039\U0010003A' # Blit file-pdf-classic
