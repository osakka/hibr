#!/usr/bin/env hibr
#
# wm/restart -- Restart Desktop: the desktop replaces itself with whatever
# hibr is installed now, in the same process, and carries on where it was.
#
# Every window is kept under its own id: its place, size, workspace,
# whether it is minimised, the stacking order, which has focus, and the
# tiling. What is inside a window is the app's: an app names the maps it
# keeps a window's state in, `dt_keepstate stickies SW`, and the desktop
# saves that window's part of each as JSON and puts it back under the same
# id. An app holding something that cannot be written down -- a terminal's
# program, an open database -- also gives <app>_stash(id, dir), run before
# the maps are read, and <app>_resume(id), run after they are back -- names
# no other callback uses, so nothing that saves a file or sets the clock
# (dtf_save does) is ever called by mistake. An
# app with neither reopens fresh, in the same place.
#
# Programs in terminal windows do not stop: a pty's master descriptor is
# open without close-on-exec, and the program on it stays this process's
# child across exec, so the new desktop adopts each one (pty adopt, term
# adopt) with the screen and scrollback the old one saved. Nothing may close
# a terminal on the way out, or its program gets a hangup -- which is why
# this never goes through dt_close.
#
# A newer hibr installed under a running desktop is noticed without a
# fork: /proc/$$/exe still names the binary this process started from,
# which apt has replaced, so it stops being the same file as $HIBR. The
# desktop then offers the restart in a note; nothing happens until it is
# clicked.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

DT_RESTORE=${DT_RESTORE-}
# The session script this desktop runs, made absolute now: by the time of a
# restart the desktop may be in another directory.
DT_SELF0=$0
case $DT_SELF0 in /*) ;; *) DT_SELF0="$PWD/$DT_SELF0" ;; esac
DT_RESTORED=0
DT_INBASE=0
DT_RSDIR="${DT_LOG%/*}/restart"
DT_RSVER=1
DT_UPDT=0
DT_UPNOTED=
# Set while the hibr on disk is not the one running, cleared only by a
# restart -- which is a new process, so it starts empty by construction.
DT_UPNEW=
# console close -k exports this for the process the exec starts, which reads
# it on opening; declared keeping what came across the exec, never cleared
# here, since this file is read before the new console opens (Gitea #559).
declare -g HIBR_CNKEPT="${HIBR_CNKEPT-}"
declare -gA DT_KEEPSTATE
declare -gA DT_RS
# Each program a restart carries across the exec on a pty, as fd:pid -- what
# an app's _stash hands over with dt_rscarry, and what its _resume claims
# back with dt_rsclaim. One nobody claims is ended after the restore, the
# same as closing its window, rather than left running unseen.
DT_RSCARRY=()
DT_RSCLAIMED=()
# Set when a restart hands windows to their apps' fresh processes, which
# take up what was kept for them after the restore has ended (ADR 0050).
DT_RSHOSTED=

# A program an app's own process asks to carry or claims back is the
# desktop's child already (ADR 0050, mods/pty), carried by the desktop
# itself (`pty owned`) and claimed by the process asking for it by its pid,
# and the descriptor that process names is its own number, not the
# desktop's: from an app's process both are nothing to do.
fn dt_rscarry(int fd, int pid) {
	[ -z "${DT_RTFROM-}" ] || return 0
	DT_RSCARRY+=("$fd:$pid")
}

fn dt_rsclaim(int fd) {
	[ -z "${DT_RTFROM-}" ] || return 0
	DT_RSCLAIMED+=("$fd")
}

# End what crossed the exec and nothing took back.
dt_rsorphans() {
	local c fd p

	[ "${#DT_RSCARRY[@]}" -gt 0 ] || return 0
	need pty 2> /dev/null
	for c in "${DT_RSCARRY[@]}"; do
		fd=${c%%:*}
		case " ${DT_RSCLAIMED[*]} " in *" $fd "*) continue ;; esac
		dt_rslog "pty on fd $fd, pid ${c#*:}: no window took it back, ended"
		p := pty adopt "$fd" "${c#*:}" 2> /dev/null && pty close "$p"
	done
	DT_RSCARRY=()
	DT_RSCLAIMED=()
}

# An app's maps that hold a window's state under its id.
fn dt_keepstate(app, ...maps) {
	DT_KEEPSTATE["$app"]="${maps[*]}"
}

# Write everything down and exec the hibr installed now. Returns only if
# the exec failed, with the desktop put back as it was.
dt_restart() {
	local f="$DT_RSDIR/state.json"

	if [ ! -x "$HIBR" ] || [ ! -r "$DT_SELF0" ]; then
		dt_notep high "Cannot restart: no hibr at %s, or no %s" "${HIBR:-?}" "$DT_SELF0"
		dt_rsuncarry
		return 1
	fi
	[ -d "$DT_RSDIR" ] || mkdir -p "$DT_RSDIR" 2> /dev/null || {
		dt_notep high "Cannot restart: %s cannot be made" "$DT_RSDIR"
		dt_rsuncarry
		return 1
	}
	# A window drawn by its app's own process keeps its state there first
	# (ADR 0050): asked, never waited on -- the restart goes on when the
	# last answer comes, or DT_RVKEEPMS has passed (dt_rvkept).
	[ -z "$DT_RSKEEPING" ] || return 0
	if [ -z "$DT_RSKEPT" ] && dt_rvstashall "$DT_RSDIR"; then
		return 0
	fi
	DT_RSKEPT=
	# Full-screen windows go back to their own places first, so the state
	# keeps where they were and not the whole display.
	dt_fullendall
	# A crash snapshot still waiting is not worth a wait on a slow disk:
	# the restart's own state, written below, is what comes back.
	if dt_has dt_writedrop; then
		local snap
		snap := dt_snapfile
		dt_writedrop "$snap"
		dt_writeflush
	fi
	if ! dt_rswrite "$f" 1; then
		dt_notep high "Cannot restart: the state could not be written"
		dt_rsuncarry
		return 1
	fi
	dt_rslog "restarting into $HIBR: ${#DT[@]} windows kept in $f"
	# Here rather than any later: stderr is still this desktop's log at
	# this point, and after the `exec 2>&$DT_ERR` below it is the real
	# terminal, where a message would be drawn over the screen.
	dt_upsession || true
	dt_ctlclose
	dt_rtclose
	dt_hwstop
	# The screen and its pictures stay for the desktop the exec starts,
	# which takes them away in its first frame inside one synchronized
	# update: closed, every display showed no wallpaper for a second
	# (Gitea #559).
	console close -k
	if [ -n "$DT_ERR" ]; then
		exec 2>&"$DT_ERR"
		exec {DT_ERR}>&-
	fi
	export DT_RESTORE=$f
	DT_T0=$EPOCHREALTIME
	export DT_T0
	# A failed exec ends a script, as in bash; this one opens the desktop
	# again instead and says why.
	shopt -s execfail
	exec "$HIBR" "$DT_SELF0" "${DT_SELFARGS[@]}"
	shopt -u execfail
	export -n DT_RESTORE
	DT_RESTORE=
	dt_open
	dt_rsuncarry
	dt_notep high "Restart failed: %s would not run" "$HIBR"
	return 1
}

# What a restart keeps across its exec (ADR 0050), written into the state:
# the zygote, when its code is current, its channel crossing as an
# inheritable copy; each app process kept with it, by the launch it joins
# the restarted desktop with -- its app, pid and stamp, and its terminals'
# channel crossing the same way (DT_RSKEEPF, the old descriptor to the
# copy). Otherwise the zygote is one more of this desktop's children the
# desktop after it sees end (dt_rvcarried).
declare -gA DT_RSKEEPF
dt_rskeep() {
	local c t ap fd x j

	DT_RSKEEPF=()
	if [ -z "$DT_RSZKEEP" ] || [ -z "$DT_RTZFD" ]; then
		j := dt_rvpids
		json set DT_RS .hosts "$j" -s
		return 0
	fi
	exec {x}<&"$DT_RTZFD"
	DT_RSZDUP=$x
	json set DT_RS .zfd "$x"
	json set DT_RS .zpid "$DT_RTZPID"
	json set DT_RS .zstamp "$DT_RTZSTAMP" -s
	json parse DT_RS["kept"] "{}"
	for c in "${!DT_RSKEEPC[@]}"; do
		[ -n "${DT_RTC["$c"]+x}" ] || continue
		t=${DT_RSKEEPC["$c"]}
		ap=${DT_RTC["$c"]}
		json set DT_RS ".kept.$t.app" "$ap" -s
		json set DT_RS ".kept.$t.pid" "${DT_RTCPID["$c"]-}" -s
		json set DT_RS ".kept.$t.stamp" "${DT_RTCSTAMP["$c"]-}" -s
		json set DT_RS ".kept.$t.file" "${DT_APPS["$ap"]["src"]-}" -s
		for fd in "${!DT_RTPTYC[@]}"; do
			[ "${DT_RTPTYC["$fd"]}" = "$ap" ] || continue
			exec {x}<&"$fd"
			DT_RSKEEPF["$fd"]=$x
			json set DT_RS ".kept.$t.pty" "$x" -s
		done
	done
	return 0
}

# A restart that did not happen after its app processes were asked to stay
# (dt_rvstashall): each still connected is told it is not kept (`carry`
# naming nothing), so it ends with its desktop when that goes rather than
# waiting to join one that never comes; one whose connection the restart
# had already let go finds this desktop listening, is refused at once and
# ends (runtime.hibr's dt_rtrejoin). The copies made to cross the exec are
# closed.
DT_RSZDUP=
dt_rsuncarry() {
	local c x gone=

	for c in "${!DT_RSKEEPC[@]}"; do
		if [ -n "${DT_RTC["$c"]+x}" ]; then
			x := dt_rtline call 0 - carry ""
			dt_rtsay "$c" "$x"
		else
			gone=1
		fi
	done
	for x in "${DT_RSKEEPF[@]}" $DT_RSZDUP; do
		exec {x}>&-
	done
	[ "${#DT_RSKEEPC[@]}" = 0 ] || dt_rslog "restart did not happen: ${#DT_RSKEEPC[@]} app processes told they are not kept"
	DT_RSKEEPC=()
	DT_RSKEEPF=()
	DT_RSZDUP=
	DT_RSZKEEP=
	[ -z "$gone" ] || dt_rtlisten
	return 0
}

# Write the desktop down as dt_restore reads it. carry 1 is a restart: each
# app's _stash runs, and a terminal's program crosses the exec. carry 0 is a
# snapshot for after a crash or a stop, when nothing can cross: no _stash,
# and the file says so, so those windows reopen fresh.
fn dt_rswrite(f, int carry, why = "restart") {
	local id ap m j k l c n r w
	local -a ms

	k := console consumed
	l := dt_wpanes
	json parse DT_RS "{\"ver\":$DT_RSVER}"
	json set DT_RS .ws "$DT_WS"
	json set DT_RS .wsn "$DT_WSN"
	json set DT_RS .next "$DT_NEXT"
	json set DT_RS .focus "$DT_FOCUS" -s
	json set DT_RS .stack "$l" -s
	json set DT_RS .inbase $((DT_INBASE + k))
	DT_RSCARRY=()
	j := json get DT_WSORD . 2> /dev/null
	[ -n "$j" ] || j="{}"
	json parse DT_RS["wsord"] "$j"
	j := json get DT_TORD . 2> /dev/null
	[ -n "$j" ] || j="{}"
	json parse DT_RS["tord"] "$j"
	j := json get DT_TILED . 2> /dev/null
	[ -n "$j" ] || j="{}"
	json parse DT_RS["tiled"] "$j"
	json parse DT_RS["win"] "{}"
	json parse DT_RS["app"] "{}"
	json set DT_RS .fresh $((1 - carry))
	# Every window's place is in the union's own frame, which hold moves
	# as displays come and go (Gitea #257): which frame it was is part of
	# the place, or a window on a display that rejoins after this one
	# comes back counted from somewhere else.
	json set DT_RS .shift "${DT_SHIFTWAS:-}" -s
	json set DT_RS .why "$why" -s
	json parse DT_RS["hosted"] "{}"
	dt_wins
	for id in "${DT_WINS[@]}"; do
		ap=${DT[$id]["app"]}
		# Drawn by its app's own process: what it holds was kept by that
		# process (dt_rvstashall), and the window is said to be its, so
		# the desktop after the exec starts the app's process again and
		# hands the window to it to take up.
		if [ -n "${DT_RVC[$id]+x}" ]; then
			json set DT_RS ".hosted.$id" "$ap" -s
			# Its process kept, which still holds it (dt_rvstashall):
			# bound to it again, never opened or taken up.
			c=${DT_RVC[$id]}
			[ "$carry" = 1 ] && [ -n "$c" ] && [ -n "${DT_RSKEEPC["$c"]+x}" ] &&
				json set DT_RS ".keepw.$id" "${DT_RSKEEPC["$c"]}" -s
		elif [ "$carry" = 1 ] && [ -n "$ap" ] && dt_has "${ap}_stash"; then
			dt_appfn "$ap" "${ap}_stash" "$id" "$DT_RSDIR"
		fi
		j := json get DT ".$id"
		json parse DT_RS["win"]["$id"] "$j"
		# A full-screen window is written down as it goes back, so a desktop
		# that dies with one comes back with its frame and its own size.
		if dt_isfull "$id"; then
			json set DT_RS ".win.$id.row" "${DT[$id]["fsr"]}"
			json set DT_RS ".win.$id.col" "${DT[$id]["fsc"]}"
			json set DT_RS ".win.$id.h" "${DT[$id]["fsh"]}"
			json set DT_RS ".win.$id.w" "${DT[$id]["fsw"]}"
			json set DT_RS ".win.$id.chrome" "${DT[$id]["fschrome"]}" -s
			json set DT_RS ".win.$id.noshadow" "${DT[$id]["fsshadow"]}" -s
		fi
		[ -n "$ap" ] && [ -z "${DT_RVC[$id]+x}" ] || continue
		read -ra ms <<< "${DT_KEEPSTATE["$ap"]}"
		for m in "${ms[@]}"; do
			j := json get "$m" ".$id" 2> /dev/null || continue
			json parse DT_RS["app"]["$id"]["$m"] "$j"
		done
	done
	json set DT_RS .carry "${DT_RSCARRY[*]}" -s
	# The app processes this desktop started (ADR 0050), by pid: still its
	# children across the exec, so the desktop after it finds each by its
	# pid and sees it end (dt_rvcarried) rather than leaving it a zombie.
	if [ "$carry" = 1 ]; then
		dt_rskeep
		# And every terminal's program the desktop owns for an app's
		# process, "fd pid id chan rows cols app" a line: its master
		# crosses the exec, and the desktop after it holds it for the
		# process that held it, kept, or until that app's fresh process
		# asks for it by its pid.
		if [ -n "$DT_RTZPID" ] && command -v pty > /dev/null; then
			j := pty owned
			l=
			while read -r m n k c r w ap; do
				[ -n "$ap" ] || continue
				c=${DT_RSKEEPF["$c"]:--1}
				l+="$m $n $k $c $r $w $ap"$'\n'
			done <<< "$j"
			json set DT_RS .ptys "${l%$'\n'}" -s
		fi
	fi
	# Through a file of this process's own, then renamed: a desktop and
	# its supervisor stopped by one signal both write, and with one
	# name for both, one renamed it from under the other ("mv: cannot
	# stat ... .new"), and the windows were not written down at all.
	# The crash snapshot is written by a child, every DT_SNAPMS from the
	# frame loop, so a slow disk delays it and never a frame (0.99.546).
	# A restart or a stop is written here and now: the next desktop
	# reads it the moment this one has gone.
	if [ "$why" = crash ]; then
		local j
		j := json emit DT_RS 2> /dev/null || return 1
		dt_writelater "$f" "$j"$'\n'
		return 0
	fi
	json emit DT_RS > "$f.$$.new" 2> /dev/null && mv -f "$f.$$.new" "$f"
}

# A line in the desktop's log, the one place a restart can say what it did
# once the screen has been handed over.
fn dt_rslog(text) {
	dt_log "$text"
	[ -n "$DT_RSDEBUG" ] && echo "$text" >> "$DT_RSDEBUG"
	return 0
}

# Put back what dt_restart wrote, if this desktop was started by one.
# Called from dt_open, before a session file's own windows; DT_RESTORED
# tells a session file that would open some that they are already there.
dt_restore() {
	local f=$DT_RESTORE id ap m j p e t x k c r w
	local -a ms ps

	[ -n "$f" ] || return 0
	export -n DT_RESTORE
	DT_RESTORE=
	[ -r "$f" ] || return 0
	if ! json parse DT_RS < "$f" 2> "$f.err"; then
		read -r e < "$f.err"
		dt_rslog "could not read $f: ${e:-no reason given}; kept as $f.bad"
		mv -f "$f" "$f.bad" 2> /dev/null
		dt_notep high "Restarted, but the saved desktop could not be read -- see desktop.log"
		return 0
	fi
	read -ra DT_RSCARRY <<< "${DT_RS["carry"]}"
	if [ "${DT_RS["ver"]}" != "$DT_RSVER" ]; then
		dt_rslog "$f was saved as version ${DT_RS["ver"]:-none}, this reads $DT_RSVER; kept as $f.bad"
		mv -f "$f" "$f.bad" 2> /dev/null
		dt_rsorphans
		dt_notep high "Restarted, but the saved desktop is from another version"
		return 0
	fi
	DT_WSN=${DT_RS["wsn"]:-$DT_WSN}
	DT_WS=${DT_RS["ws"]:-1}
	DT_INBASE=${DT_RS["inbase"]:-0}
	j := json get DT_RS .wsord 2> /dev/null
	[ -n "$j" ] && [ "$j" != '""' ] && json parse DT_WSORD "$j"
	j := json get DT_RS .tord 2> /dev/null
	[ -n "$j" ] && [ "$j" != '""' ] && json parse DT_TORD "$j"
	j := json get DT_RS .tiled 2> /dev/null
	[ -n "$j" ] && [ "$j" != '""' ] && json parse DT_TILED "$j"
	# The terminals' programs the desktop owned for app processes (ADR
	# 0050): each held, by no process yet, until its app's fresh process
	# asks for it.
	# The zygote and the app processes kept (ADR 0050): the zygote's channel
	# taken up where the exec left it, and each kept process expected back
	# by the launch it was given, joining as a fresh one says hello.
	if [ -n "${DT_RS["zfd"]-}" ] && need zygote 2> /dev/null; then
		DT_RTZFD=${DT_RS["zfd"]}
		DT_RTZPID=${DT_RS["zpid"]}
		DT_RTZSTAMP=${DT_RS["zstamp"]-}
		DT_RTZOK=1
		command -v console > /dev/null && console watch -i "$DT_RTZFD" 2> /dev/null
		for t in "${!DT_RS["kept"][@]}"; do
			ap=${DT_RS["kept"]["$t"]["app"]}
			DT_RTLAUNCH["$t"]=$ap
			DT_RTLFILE["$t"]=${DT_RS["kept"]["$t"]["file"]-}
			DT_RTLTIME["$t"]=$EPOCHSECONDS
			DT_RTLPID["$t"]=${DT_RS["kept"]["$t"]["pid"]-}
			DT_RTLSTAMP["$t"]=${DT_RS["kept"]["$t"]["stamp"]-}
			DT_RTLKEPT["$t"]=1
			x=${DT_RS["kept"]["$t"]["pty"]-}
			[ -z "$x" ] || DT_RTPTYC["$x"]=$ap
			[ -z "$x" ] || ! command -v console > /dev/null || console watch -i "$x" 2> /dev/null
			# Its panes, modules, savers and bar items are its process's,
			# as when it was first started (wm/rtkinds.hibr).
			if [ -n "${DT_APPS["$ap"]["src"]-}" ]; then
				dt_rvpendapp "$ap"
			elif [ -n "${DT_RTLFILE["$t"]}" ]; then
				dt_rvpendfile "${DT_RTLFILE["$t"]}"
			fi
			dt_rslog "app process ${DT_RTLPID["$t"]:-?} ($ap) kept"
		done
		dt_rtlisten
	fi
	if [ -n "${DT_RS["ptys"]-}" ] && need pty 2> /dev/null; then
		while read -r m p k c r w e; do
			[ -n "$e" ] || continue
			pty adopt -o "$e" "$m" "$p" "$r" "$w" "$k" "$c" > /dev/null 2>&1 && DT_RTPTYN=1
		done <<< "${DT_RS["ptys"]}"
		# Listening is what serves them; each held by no process is kept
		# while a window names it (dt_rtptytick).
		DT_RTPTYLONE=1
		[ -z "$DT_RTPTYN" ] || dt_rtlisten
	fi
	for id in "${!DT_RS["win"][@]}"; do
		ap=${DT_RS["win"][$id]["app"]}
		if [ -n "$ap" ] && [ -z "${DT_APPS[$ap]["title"]}" ]; then
			dt_rslog "window $id: no app $ap any more, left closed"
			continue
		fi
		j := json get DT_RS ".win.$id"
		json parse DT["$id"] "$j"
		# A record with no size was never a window -- one saved before
		# 0.99.533 could carry such a ghost forward (Gitea #552).
		if ! dt_iswin "$id"; then
			dt_rslog "window $id: saved with no size, not a window, left out"
			unset "DT[$id]"
			continue
		fi
		# Drawn by its app's own process before (ADR 0050): that app is
		# started again in a fresh process, from this desktop's zygote,
		# and the window handed to it to take up once its view is bound --
		# or opened fresh, after a crash, when nothing was kept.
		if [ -n "${DT_RS["hosted"]["$id"]-}" ]; then
			if ! dt_rvhosted "$ap" && ! dt_rthost "$ap" > /dev/null; then
				dt_rslog "window $id ($ap): its app's process could not be started, left closed"
				unset "DT[$id]"
				continue
			fi
			dt_rvnew "$id" "$ap"
			dt_hooks "$id" "$ap"
			DT[$id]["autoclose"]=
			if [ -n "${DT_RS["keepw"]["$id"]-}" ]; then
				DT_RVHELD[$id]=1
			elif [ "${DT_RS["fresh"]}" = 1 ]; then
				DT_RVOPEN[$id]=
			else
				DT_RVRESUME[$id]=$DT_RSDIR
				DT_RSHOSTED=1
			fi
			dt_away "$id" || dt_hidden "$id" ||
				console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
					"${DT[$id]["h"]}" "${DT[$id]["w"]}"
			continue
		fi
		dt_hooks "$id" "$ap"
		DT[$id]["autoclose"]=
		dt_newcmdgone "$id"
		if [ "${DT_RS["fresh"]}" = 1 ] && [ -n "$ap" ] && dt_has "${ap}_stash"; then
			dt_rslog "window $id ($ap): what it held could not survive, opened fresh"
			[ -n "${DT[$id]["open"]}" ] && dt_appfn "${DT[$id]["app"]-}" ${DT[$id]["open"]} "$id" ""
		else
			read -ra ms <<< "${DT_KEEPSTATE["$ap"]}"
			for m in "${ms[@]}"; do
				j := json get DT_RS ".app.$id.$m" 2> /dev/null || continue
				json parse "$m[$id]" "$j"
			done
			if [ -n "$ap" ] && dt_has "${ap}_resume"; then
				dt_appfn "$ap" "${ap}_resume" "$id"
			elif [ "${#ms[@]}" = 0 ] && [ -n "${DT[$id]["open"]}" ]; then
				dt_appfn "${DT[$id]["app"]-}" ${DT[$id]["open"]} "$id" ""
			fi
		fi
		dt_away "$id" || dt_hidden "$id" ||
			console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
				"${DT[$id]["h"]}" "${DT[$id]["w"]}"
	done
	# The windows were saved in the union's frame as it stood then, and
	# hold has already said where it stands now: carry them across, the
	# way a display moving carries them. A display not back yet holds
	# its windows off the screen where it will be, and its rejoining
	# brings them back to where they were rather than onto the primary.
	m=${DT_RS["shift"]-}
	if [ -n "$m" ] && [ -n "$DT_SHIFTWAS" ] && [ "$m" != "$DT_SHIFTWAS" ]; then
		j=$DT_SHIFTWAS
		DT_SHIFTWAS=$m
		dt_shiftorigin "$j"
	fi
	read -ra ps <<< "${DT_RS["stack"]}"
	for p in "${ps[@]}"; do
		dt_iswin "${p#w}" || continue
		dt_away "${p#w}" || dt_hidden "${p#w}" || console pane raise "$p"
	done
	DT_NEXT=${DT_RS["next"]:-$DT_NEXT}
	id=${DT_RS["focus"]}
	if dt_iswin "$id"; then
		DT_FOCUS=$id
	else
		# The topmost *window* pane. Not simply the last of every
		# pane: since 0.99.129 the bar has one of its own, and taking
		# it here made DT_FOCUS the string "bar", which dt_intile then
		# refused as not an int -- once per frame, in the log, with
		# the tiling and the menus' own dimming wrong behind it.
		p := dt_wpanes
		p=${p##* }
		DT_FOCUS=${p#w}
	fi
	dt_tile
	dt_rsorphans
	read -ra ps <<< "${DT_RS["hosts"]-}"
	[ "${#ps[@]}" = 0 ] || dt_rvcarried "${ps[@]}"
	rm -f "$f" "$f.err" 2> /dev/null
	# What windows were carried in goes once each has been taken up
	# (dt_rvkept), when an app's process is to take one up.
	[ -n "$DT_RSHOSTED" ] || rm -f "$DT_RSDIR"/term-*.save 2> /dev/null
	DT_RESTORED=1
	dt_rslog "restored ${#DT[@]} windows from $f"
	case ${DT_RS["why"]} in
	crash) dt_notep high "The desktop stopped unexpectedly and was started again; its windows are back (see desktop.log)" ;;
	stop) dt_notep low "Reopened the windows from when the desktop was stopped" ;;
	*) dt_notep low "Restarted: hibr %s" "$HIBR_VERSION" ;;
	esac
}

# Whether the hibr this desktop runs has been replaced on disk since it
# started: a notification once, and a mark in the menu bar for as long as it
# stays true.
#
# It used to be the notification alone, and that is a control which lies by
# omission: a note times out in a couple of seconds, DT_UPNOTED then silences
# it for good, and a desktop goes on running an old image with nothing
# anywhere saying so. The owner's own desktop ran for eight hours on 0.99.83
# that way -- through a release that fixed a segfault it was dying of, and
# two that fixed what it was drawing -- and every bug reported in those hours
# was reported against code that had already been replaced on disk. The state
# is what matters, not the announcement, so DT_UPNEW is set while it is true
# and dt_bar shows it until a restart clears it.
# And the other half of the same honesty, which the first half got wrong by
# implication (Gitea #174). `hold` renders every client from its own
# emulator, and that emulator lives in the **server** process -- which keeps
# whatever modules it was started with for as long as the session lives. A
# Restart Desktop re-execs the desktop *inside* that server, so a fix in
# mods/hold, mods/term or mods/pty does not reach a running session at all,
# and the mark above actively says it will: the person restarts, the mark
# clears, and the old emulator is still there. That cost an afternoon
# diagnosing a wallpaper against a session painted by code from before the
# fix.
DT_UPSESSION=

# The pid of the hold server this desktop is running inside, by walking up
# the parents until one names itself one. Nothing else knows it: the session
# name is in HIBR_HOLD, but the server is a process, and `hold list` answers
# a client's pid rather than the server's.
#
# The same walk leaves two more answers behind. DT_HOLDPROG is the pid one
# step below the server, which is the session's own *program*: the
# supervisor where a held desktop has one (wm/recover.hibr), and the
# desktop itself where it does not -- and it is what `hold list` names.
# DT_HOLDHOPS is how far this process sits below the server, which is 1
# when it is the program and 2 when the supervisor is. Both are needed to
# ask "is this session mine": the pid ties the session's *name* to a
# process, and the hops tie that process to *this* one -- a desktop
# started from a terminal window inside another session inherits that
# session's HIBR_HOLD and sits three or four hops down, where every
# identity comparison on its own still agrees.
#
# /proc/<pid>/stat's own trap: the command is in brackets and may itself
# contain brackets, so it is read from the *last* `)`, and the state letter
# before the ppid is why a loop that skips fields by reading numbers gets
# nothing.
DT_HOLDPROG=
DT_HOLDHOPS=
dt_holdsrv() {
	local p=$$ prev=$$ line comm rest st ppid n=0

	DT_HOLDPROG=
	DT_HOLDHOPS=
	while [ "$n" -lt 8 ]; do
		read -r line 2> /dev/null < "/proc/$p/stat" || return 1
		comm=${line#*\(}
		comm=${comm%)*}
		rest=${line##*)}
		read -r st ppid _ <<< "$rest"
		case $comm in
		hold:*) DT_HOLDPROG=$prev; DT_HOLDHOPS=$n; ret "$p" ;;
		esac
		case $ppid in '' | 0 | 1) return 1 ;; esac
		prev=$p
		p=$ppid
		n=$((n + 1))
	done
	return 1
}

# Whether this session's own server is older than the hibr on disk. Compared
# the same way dt_updcheck compares the desktop's own image -- an -ef against
# $HIBR, since apt replaces the binary and the running one is then a deleted
# inode -- but asked of the server, which a restart cannot change.
dt_sessionold() {
	local srv

	[ -n "$HIBR_HOLD" ] && [ -n "$HIBR" ] || return 1
	srv := dt_holdsrv || return 1
	[ -e "/proc/$srv/exe" ] || return 1
	[ /proc/$srv/exe -ef "$HIBR" ] && return 1
	return 0
}

# Whether every module the resumed server would load again is still at the
# path it was mapped from. The ` (deleted)` the kernel appends to a replaced
# inode is stripped, because a replaced file is what apt and `make` leave
# behind and is the case this whole thing is for; a path with *nothing* at
# it is the one there is no way back from, since the exec has happened by
# the time `mod load` fails and the master closes with the image that
# failed. A `make clean` in a build tree is that case. Takes the maps file
# rather than a pid, so a test can hand it one.
fn dt_upmods(maps) {
	local line p ok=1

	[ -r "$maps" ] || return 1
	while read -r line; do
		case $line in
		*" /"*) ;;
		*) continue ;;
		esac
		p=/${line#* /}
		p=${p% (deleted)}
		case $p in
		*/pty.so | */term.so | */hold.so) [ -e "$p" ] || ok=0 ;;
		esac
	done < "$maps"
	[ "$ok" = 1 ] || return 1
	return 0
}

# Take this session's own server onto the hibr that is on disk now, which is
# the one thing a restart cannot do for itself: the desktop re-execs
# *inside* that server, so the modules every display is rendered through --
# hold, term, pty -- stay as old as the session however many times the
# desktop restarts (Gitea #198). Answers 0 when the session was upgraded.
#
# Four gates, and each one is a case where upgrading would be wrong rather
# than merely unnecessary:
#
#   nothing is stale, so an ordinary restart must not touch the session at
#   all -- which is almost every restart;
#
#   HIBR_HOLD names no session, so there is nothing to ask;
#
#   the session HIBR_HOLD names is not this desktop's own -- its program
#   (DT_HOLDPROG) must be this process or the supervisor above it, which is
#   DT_HOLDHOPS of 1 or 2. HIBR_HOLD is inherited by everything a held
#   terminal starts, so a desktop opened from a terminal window inside
#   another session would otherwise upgrade *that* session, which is
#   somebody else's: it names the same session and sits three hops down,
#   which is the only thing that tells them apart;
#
#   and a module the resumed server would load is missing, which is the
#   only failure here that cannot be recovered from.
# Every call here blocks: hold's own client dials its socket and waits for
# the answer with no timeout of its own (`hd_dial`, `hd_recv`), where the
# shell's `/dev/unix` has `HIBR_CONNTIMEO`. That is safe in *this* one
# place, and the reason is worth writing down rather than rediscovering: a
# wedged server is a server whose loop has stopped, and input reaches this
# function only through that same loop, so a restart cannot be asked for
# at all once it could hang. A caller from outside the session has no such
# argument, which is its own ticket.
fn dt_upsession() {
	local name r nm st p sz pid srv

	dt_sessionold || return 1
	name=${HIBR_HOLD##*/}
	[ -n "$name" ] || return 1
	srv := dt_holdsrv || return 1
	need hold 2> /dev/null || return 1
	r := hold list 2> /dev/null || return 1
	pid=
	while read -r nm st p sz; do
		[ "$nm" = "$name" ] && pid=$p
	done <<< "$r"
	[ -n "$pid" ] && [ "$pid" = "$DT_HOLDPROG" ] || return 1
	[ "${DT_HOLDHOPS:-9}" -le 2 ] || return 1
	if ! dt_upmods "/proc/$srv/maps"; then
		dt_rslog "session $name not upgraded: a module it maps is gone"
		return 1
	fi
	if ! hold upgrade "$name"; then
		dt_rslog "session $name could not be upgraded"
		return 1
	fi
	dt_rslog "session $name taken onto $HIBR"
	return 0
}

DT_UPMS=60000
dt_updcheck() {
	local t v

	dt_catrenew
	[ -e /proc/$$/exe ] && [ -n "$HIBR" ] || return 0
	# Once it is known, it is not news, so the check can be cheap and
	# often: one -ef test, and nothing else runs again.
	if [ -n "$DT_UPNEW" ]; then
		dt_want "$DT_UPMS"
		return 0
	fi
	dt_want "$DT_UPMS"
	[ $((EPOCHSECONDS - DT_UPDT)) -ge $((DT_UPMS / 1000)) ] || return 0
	DT_UPDT=$EPOCHSECONDS
	# Asked whatever the desktop's own image is, because the two are
	# independent: a restart makes the desktop current and leaves the
	# session exactly as old as it was, which is the case that misled.
	if [ -z "$DT_UPSESSION" ] && dt_sessionold; then
		DT_UPSESSION=1
		DT_MENUIN=
		# Say what to do. Naming only what will not work reads as a
		# failure to whoever has just done it: "I can no longer
		# restart successfully" was the report, against three
		# restarts that had each succeeded and kept every window
		# (Gitea #190). A restart re-execs the desktop *inside* this
		# server, so it can never replace the server's own image --
		# and until 0.99.159 the only remedy was to throw the session
		# away, which is what this sentence used to ask for. The
		# server can now replace its own image and take the session
		# with it, so the sentence names that instead (Gitea #198).
		# It names a *command* deliberately: wiring it into Restart
		# Desktop is one line and a decision about a live session,
		# which is the owner's to make rather than this code's.
		# dt_noteq rather than dt_notify, which would look the
		# finished sentence up in the catalogue: the format is the
		# key, which is what dt_tr's own arguments are for.
		t := dt_tr "this session still runs the older hibr: 'hold upgrade %s' takes it onto the new one without losing your windows or your terminals' programs. Restart Desktop cannot, since it re-execs the desktop inside this session" "${HIBR_HOLD##*/}"
		dt_noteq normal "$t"
		dt_want 10
	fi
	[ /proc/$$/exe -ef "$HIBR" ] && return 0
	[ -x "$HIBR" ] || return 0
	DT_UPNEW=1
	DT_MENUIN=
	[ -n "$DT_UPNOTED" ] && return 0
	DT_UPNOTED=1
	v=$("$HIBR" -c 'echo "$HIBR_VERSION"' 2> /dev/null)
	if [ -n "$v" ]; then
		t := dt_tr "hibr %s is installed -- click to restart the desktop" "$v"
	else
		t := dt_tr "a new hibr is installed -- click to restart the desktop"
	fi
	dt_notify "$t" dt_restart
	dt_want 10
}

# What the catalogue installed for this person, brought up to date the
# first time a desktop starts on a newer hibr than the last such update ran
# against (the owner's decision, 2026-11-20): every installed entry with a
# newer version for this hibr is updated without asking, a copy of the
# catalogue's that now hides a newer one hibr ships is taken away, and one
# note names each. Never at the person's cost -- offline, a failure or
# nothing newer is a line in the log at most, and the desktop runs on.
#
# The stamp is the hibr the last update ran against, one for the person
# rather than one a session, since what it updates is theirs; it is written
# only when the catalogue answered, so an offline start asks again at the
# next. With nothing in the ledger there is nothing to ask the network
# about, and the stamp is written with no job at all -- which is every
# session a suite starts.
[ -n "${LEDGER_LIBDONE-}" ] || . "$DT_HERE/lib/ledger.hibr"
DT_CATSTAMP="${DT_LOG%/*}/catalogue-hibr"
DT_CATASKED=

# Whether version a is newer than version b, field by field, with no fork.
fn dt_vernewer(a, b) {
	local -a x y
	local i=0 n p q

	IFS=. read -ra x <<< "$a"
	IFS=. read -ra y <<< "$b"
	n=${#x[@]}
	[ "${#y[@]}" -gt "$n" ] && n=${#y[@]}
	while [ "$i" -lt "$n" ]; do
		p=${x[$i]:-0}
		q=${y[$i]:-0}
		i=$((i + 1))
		[ "$p" = "$q" ] && continue
		case $p$q in
		*[!0-9]*) [[ $p > $q ]]; return ;;
		esac
		[ "$p" -gt "$q" ]
		return
	done
	return 1
}

# Say which hibr the catalogue's update last ran against.
dt_catstamp() {
	mkdir -p "${DT_CATSTAMP%/*}" 2> /dev/null
	printf '%s\n' "$HIBR_VERSION" > "$DT_CATSTAMP.$$" 2> /dev/null &&
		mv -f "$DT_CATSTAMP.$$" "$DT_CATSTAMP" 2> /dev/null
	return 0
}

# Start the update once, on the first pass of a desktop whose hibr is newer
# than the stamp.
dt_catrenew() {
	local v=

	[ -z "$DT_CATASKED" ] || return 0
	DT_CATASKED=1
	[ -n "${HIBR_VERSION-}" ] || return 0
	[ -r "$DT_CATSTAMP" ] && read -r v < "$DT_CATSTAMP"
	[ -n "$v" ] && ! dt_vernewer "$HIBR_VERSION" "$v" && return 0
	if [ ! -s "$CAT_USERDATA/$CAT_LEDGER" ]; then
		dt_catstamp
		return 0
	fi
	if ! command -v catalogue > /dev/null; then
		dt_log "after the upgrade to hibr $HIBR_VERSION: no catalogue command, so nothing installed was updated"
		return 0
	fi
	dt_job upgrade:catalogue "$HIBR_VERSION" dt_catrenewed catalogue -j update > /dev/null ||
		dt_log "after the upgrade to hibr $HIBR_VERSION: no folder for the catalogue's job"
	return 0
}

# Whether that update is in hand -- running, or its answer being read --
# while which a rescan leaves the saying to it, so the person is told once.
dt_catrenewing() {
	local n

	for n in "${!DTJ[@]}"; do
		[ "${DTJ[$n]["kind"]}" = upgrade:catalogue ] && return 0
	done
	return 1
}

# The update ended: one note naming what it did, and the stamp when the
# catalogue answered.
fn dt_catrenewed(int n, int st) {
	local f l t list= mine= v=${DTJ[$n]["tag"]} why=
	local -A r

	f := dt_jobfile "$n"
	if [ -r "$f" ]; then
		while IFS= read -r l; do
			r=()
			json parse r <<< "$l" 2> /dev/null || continue
			case ${r["op"]} in
			updated | shipped)
				list="$list${list:+, }${r["title"]} ${r["to"]}"
				;;
			replaced)
				t := dt_tr "%s, replaced by %s" "${r["title"]}" "${r["by"]}"
				list="$list${list:+, }$t"
				;;
			edited | yours)
				t := dt_tr "%s, a copy of your own, hides the %s hibr ships" "${r["title"]}" "${r["to"]}"
				mine="$mine${mine:+. }$t"
				;;
			changed)
				t := dt_tr "%s, changed by you, kept: the Catalogue updates it when you ask" "${r["title"]}"
				mine="$mine${mine:+. }$t"
				;;
			kept)
				dt_log "after the upgrade to hibr $v, ${r["id"]} was not updated: the catalogue's ${r["to"]} cannot run here"
				;;
			esac
		done < "$f"
	fi
	if [ "$st" = 0 ]; then
		dt_catstamp
	else
		f := dt_jobfile "$n" err
		[ -r "$f" ] && while IFS= read -r l; do [ -n "$l" ] && why=$l; done < "$f"
		dt_log "after the upgrade to hibr $v, the catalogue's update did not finish${why:+: $why}"
	fi
	dt_rescan > /dev/null
	if [ -n "$list" ]; then
		t := dt_tr "Updated for hibr %s: %s. Restart Desktop to run them" "$v" "$list"
		[ -n "$mine" ] && t="$t. $mine"
		dt_noteq normal "$t" dt_restart
	elif [ -n "$mine" ]; then
		dt_noteq normal "$mine"
	fi
	return 0
}

# What of this file's state every app process that reads it is sent (ADR
# 0050, wm/rtwire.hibr).
dt_share DT_RESTORED DT_UPNEW DT_UPSESSION
