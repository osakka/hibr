# wm/handlers -- what opens a file, by its extension.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# What opens a file, by its extension -- a script of the user's own
# registers one with dt_handler, the same idiom dt_app uses to register a
# window:
#
#     dt_handler jpg feh
#     dt_handler json term less
#
# "term" runs the program in a terminal window, for anything that reads a
# terminal itself -- an interpreter, a pager; without it the program is
# started detached, for anything that draws its own window outside the
# desktop, such as an image viewer or a media player, which must not be
# waited for or the desktop would hang until it closed. A name with no
# extension, or one nothing was registered for, still opens in a terminal
# with hvi, exactly as it always did.
declare -gA DT_HANDLERS

fn dt_handler(ext, ...rest) {
	local term=0 i=0 a

	shift
	if [ "$1" = term ]; then
		term=1
		shift
	fi
	DT_HANDLERS[$ext]["term"]=$term
	for a in "$@"; do
		DT_HANDLERS[$ext][$i]="$a"
		i=$((i + 1))
	done
	DT_HANDLERS[$ext]["n"]=$i
}

# Forget what opens a file of this extension: the File Types pane's Delete,
# and its Save when the extension was renamed.
fn dt_handlerdrop(ext) {
	[ -n "$ext" ] || return 0
	unset "DT_HANDLERS[$ext]"
}

# A handler's own argv, read by term_open once it is asked to run one
# instead of hvi: set right here, right before dt_launch term, so term.hibr
# never has to know this table exists.
DT_OPENCMD=()

# Set alongside DT_OPENCMD when the file being opened is itself the
# program -- an executable run directly, not through a registered
# handler's own interpreter -- so term.hibr knows not to append the
# path a second time as an argument, and to leave the window up on a
# clean exit so there is something to read rather than a flash and gone.
DT_OPENSELF=

# Set with DT_OPENSELF when what runs is an interactive shell -- Open
# Terminal Here -- whose window closes on a clean exit like any terminal's,
# since there is no output left to read once someone has typed exit.
DT_OPENSHELL=

# Run a registered handler on a path.
fn dt_runhandler(ext, path) {
	local n i=0

	n=${DT_HANDLERS[$ext]["n"]}
	DT_OPENCMD=()
	while [ "$i" -lt "$n" ]; do
		DT_OPENCMD+=("${DT_HANDLERS[$ext][$i]}")
		i=$((i + 1))
	done
	if [ "${DT_HANDLERS[$ext]["term"]}" = 1 ]; then
		dt_launch term "$path"
	else
		( "${DT_OPENCMD[@]}" "$path" >> "$DT_LOG" 2>&1 & )
		DT_OPENCMD=()
	fi
}

# Open a path: a folder in a file browser, a registered extension with its
# own handler, an executable run directly in a terminal, a picture in the
# image viewer if it is loaded, and anything
# else in a terminal with hvi, since every file a terminal can show is one
# it can edit. A user's own dt_handler for the same extension is checked
# first and wins, the same rule a file of your own replacing a bundled app
# already follows elsewhere. The executable bit is what decides run vs
# edit, not a second extension: a hibr desktop app that wants a window of
# its own belongs in DT_APPDIRS, where the hibr menu already finds it --
# sourcing an arbitrary double-clicked file into the running desktop, with
# every global that implies, is not a line this crosses.
DT_OPENPENDING=

# Run once the "unregistered extension" confirm below is answered yes --
# DT_OPENPENDING carries the path rather than the confirm command itself
# naming it, since dt_confirm's own callback is a bare word-split string
# and a path with a space in it would not survive that as an argument.
dt_openfile_confirmed() {
	dt_launch term "$DT_OPENPENDING"
	DT_OPENPENDING=
}

fn dt_openfile(path) {
	local ext

	dt_has dt_launched && dt_launched
	if [ -d "$path" ]; then
		if dt_isbundle "$path"; then
			dt_openwith "${DT_OWLIST[0]}" "$path"
		else
			dt_launch files "$path"
		fi
		return 0
	fi
	ext := dt_ext "$path"
	dt_openers "$path"
	if [ -n "$DT_OWCONF" ] && [ "${#DT_OWLIST[@]}" -gt 0 ]; then
		dt_openwith "${DT_OWLIST[0]}" "$path"
	elif [ -n "${DT_HANDLERS[$ext]["n"]}" ]; then
		dt_runhandler "$ext" "$path"
	elif [ -x "$path" ]; then
		DT_OPENCMD=("$path")
		DT_OPENSELF=1
		dt_launch term "$path"
	elif [ "${#DT_OWLIST[@]}" -gt 0 ] &&
	     [[ ${DT_OPENERS[${DT_OWLIST[0]}]["how"]} == @(app|browse) ]]; then
		dt_openwith "${DT_OWLIST[0]}" "$path"
	elif [ -n "${DT_APPS[term]["title"]}" ]; then
		DT_OPENPENDING=$path
		if [ -n "$ext" ]; then
			DT_T := dt_tr "Unregistered extension .%s -- open in hvi anyway?" "$ext"
			dt_confirm "$DT_T" \
				dt_openfile_confirmed
		else
			dt_confirm "No file type registered for this -- open in hvi anyway?" \
				dt_openfile_confirmed
		fi
	else
		dt_notep low "Nothing here opens %s" "${path##*/}"
	fi
}

# --- Open With ---------------------------------------------------------------
#
# What can open a file, for Files' Open With menu: every opener whose types
# take the file's extension, in the order DT_OPENWITH gives for that
# extension -- "png:imgview,hvi txt:hvi" -- or else in the order
# they were declared, a File Types handler for the extension first. The
# first is the default, what a double-click does; choosing another from
# Open With opens it there once and remembers nothing. Control Panel >
# File Types sets the list and the default for each type.
#
# What opens a file is declared, as data (ADR 0050): an app says which
# files it opens and the desktop -- or Files, on its own copy
# (wm/openfacts.hibr) -- decides from that alone, never asking the app. A
# type is a space-separated list of extensions, "*" for any file, "x" for
# one that may be run; what an app declares is what it can open now, so
# one whose programs decide it (Archives) declares again on every rescan
# (dt_onrescan). How it opens: app, given the path (dt_launch); edit, hvi
# in a terminal; run, the file itself in a terminal.
#
# Declared means there: what a file declared goes when the file is
# unloaded and comes back with it (dt_unload, dt_reinstate), and a
# declaring hook run again on a rescan replaces everything its file had
# declared -- in its place in the order, so a default does not move.
#
# An opener declared with `dir` after its app takes **folders** whose name
# ends in one of its extensions -- a bundle (Gitea #318): a folder that is
# really one thing, a game, a notebook, a photo library. Files shows such a
# folder as one item, a double click hands its path to the app, Open With
# lists the openers for it, and Show Contents still goes in, so a bundle is
# never opaque: it is a folder, and every program that reads folders reads
# it. An extension nobody declared is a plain folder.
#
#     dt_opener boxerplay "Boxer" "boxer" app boxerplay dir
#
# An opener whose how is `browse` goes in rather than opening: its app is
# a location's scheme (wm/locations.hibr), Files shows scheme://PATH as a
# folder, and its types are what that location can show. An extension of
# two words, `tar.gz`, is a type of its own.
#
#     dt_opener archives "Show Contents" "zip tar.gz" browse archive
declare -gA DT_OPENERS
DT_OPENERORDER=()
DT_OPENWITH="${DT_OPENWITH-}"
# Every extension a bundle opener names, space-separated, so a folder scan
# asks dt_isbundle only of a folder that could be one: worked out again
# from the openers whenever one is declared or goes.
DT_BUNDLEEXT=

# Which file declared something: the one loading, or the file of the app
# whose code is running (its own process, or a hook called for it).
fn dt_opensrc() {
	[ -n "${DT_LOADING-}" ] && ret "$DT_LOADING"
	ret "${DT_APPS["$DT_CALLER"]["src"]-$DT_CALLER}"
}

# Whether a declaration may name APP (ADR 0050): anything from the
# desktop's own code; from an app's own process only its own -- itself, an
# app its file or one of its bundle's parts registers, or for browse a
# location it registered -- so one app never names another's. An opener's
# own name is kept the same way (dt_opener), so none replaces another's.
fn dt_openmay(what, how, app) {
	local s m f

	[ -n "${DT_RTFROM-}" ] || return 0
	if [ "$how" = browse ]; then
		[ -n "$app" ] && [ "${DT_LOCAPP["$app"]-}" = "$DT_CALLER" ] && return 0
	elif [ -n "$app" ]; then
		[ "$app" = "$DT_CALLER" ] && return 0
		s=${DT_APPS["$app"]["src"]-}
		m=${DT_APPS["$DT_CALLER"]["src"]-}
		if [ -n "$s" ] && [ -n "$m" ]; then
			[ "$s" = "$m" ] && return 0
			if f := dt_rtpartfiles "$m"; then
				[[ $'\n'$f$'\n' == *$'\n'"$s"$'\n'* ]] && return 0
			fi
		fi
	fi
	dt_log "refused: ${DT_CALLER:-an app} declared $what for ${app:-no app}, which is not its own"
	return 1
}

fn dt_opener(name, title, types, how, app = "", kind = "") {
	local src

	dt_openmay "the opener $name" "$how" "$app" || return 1
	src := dt_opensrc
	if [ -n "${DT_RTFROM-}" ] && [ -n "${DT_OPENERS[$name]["title"]}" ] &&
	   [ "${DT_OPENERS[$name]["src"]-}" != "$src" ]; then
		dt_log "refused: ${DT_CALLER:-an app} declared the opener $name, which is another's"
		return 1
	fi
	[ -n "${DT_OPENERS[$name]["title"]}" ] || DT_OPENERORDER+=("$name")
	DT_OPENERS[$name]["title"]=$title
	DT_OPENERS[$name]["types"]=${types:+ $types }
	DT_OPENERS[$name]["was"]=
	DT_OPENERS[$name]["how"]=$how
	DT_OPENERS[$name]["app"]=$app
	DT_OPENERS[$name]["dir"]=0
	[ "$kind" = dir ] && DT_OPENERS[$name]["dir"]=1
	DT_OPENERS[$name]["src"]=$src
	dt_openbundles
}

# DT_BUNDLEEXT again, from the bundle openers declared now.
dt_openbundles() {
	local n out=

	for n in "${DT_OPENERORDER[@]}"; do
		[ "${DT_OPENERS[$n]["dir"]}" = 1 ] && out+=${DT_OPENERS[$n]["types"]}
	done
	DT_BUNDLEEXT=$out
}

# What else can be done to a file or a folder, besides Open and Open With
# (Gitea #318, #475): an app adds entries to the right-click menu of what
# has one of its extensions -- a list of them, or * for anything. A verb
# opens that app with the path, Boxer's Get Info for one game; or, with a
# function after the app, calls it with every path selected. A last
# letter is a test each path must pass for the verb to be offered: f a
# regular file, e there at all, d a folder, x one that may be run. The
# types are what the app can do now, so a verb that needs a program that is
# not there is declared for nothing and simply absent. Declared again by
# the same app with the same label, a verb is replaced in its place.
#
#     dt_openerverb boxer "Get Info..." boxerinfo
#     dt_openerverb "*" "Compress" archives arc_compress e
declare -gA DT_OPENVERBS
DT_OVN=0

fn dt_openerverb(ext, label, app, call = "", test = "") {
	local i=0 src

	case $test in
	"" | f | e | d | x) ;;
	*)
		dt_log "refused: dt_openerverb $label: '$test' is not a test (f, e, d or x)"
		return 1
		;;
	esac
	dt_openmay "the verb $label" app "$app" || return 1
	src := dt_opensrc
	while [ "$i" -lt "$DT_OVN" ]; do
		[ "${DT_OPENVERBS[$i]["app"]}" = "$app" ] &&
			[ "${DT_OPENVERBS[$i]["label"]}" = "$label" ] && break
		i=$((i + 1))
	done
	[ "$i" = "$DT_OVN" ] && DT_OVN=$((DT_OVN + 1))
	DT_OPENVERBS[$i]["ext"]=$ext
	DT_OPENVERBS[$i]["was"]=
	DT_OPENVERBS[$i]["label"]=$label
	DT_OPENVERBS[$i]["app"]=$app
	DT_OPENVERBS[$i]["call"]=$call
	DT_OPENVERBS[$i]["test"]=$test
	DT_OPENVERBS[$i]["owner"]=${DT_LOADING:-$DT_CALLER}
	DT_OPENVERBS[$i]["src"]=$src
	return 0
}

# Take away what a file declared -- its openers and its verbs -- each kept
# in its place in the order with nothing to open. With keep, what it said
# is kept to be put back by dt_openerback (a file unloaded by a rescan
# that may come back); without, it is gone until declared again (a rescan
# running its declaring hook again).
fn dt_openerdrop(src, int keep = 0) {
	local n i=0

	[ -n "$src" ] || return 0
	for n in "${DT_OPENERORDER[@]}"; do
		[ "${DT_OPENERS[$n]["src"]-}" = "$src" ] || continue
		[ "$keep" = 1 ] && DT_OPENERS[$n]["was"]=${DT_OPENERS[$n]["types"]}
		DT_OPENERS[$n]["types"]=
	done
	while [ "$i" -lt "$DT_OVN" ]; do
		if [ "${DT_OPENVERBS[$i]["src"]-}" = "$src" ]; then
			[ "$keep" = 1 ] && DT_OPENVERBS[$i]["was"]=${DT_OPENVERBS[$i]["ext"]}
			DT_OPENVERBS[$i]["ext"]=
		fi
		i=$((i + 1))
	done
	dt_openbundles
}

# Put back what dt_openerdrop kept for a file.
fn dt_openerback(src) {
	local n i=0

	[ -n "$src" ] || return 0
	for n in "${DT_OPENERORDER[@]}"; do
		[ "${DT_OPENERS[$n]["src"]-}" = "$src" ] && [ -n "${DT_OPENERS[$n]["was"]-}" ] || continue
		DT_OPENERS[$n]["types"]=${DT_OPENERS[$n]["was"]}
		DT_OPENERS[$n]["was"]=
	done
	while [ "$i" -lt "$DT_OVN" ]; do
		if [ "${DT_OPENVERBS[$i]["src"]-}" = "$src" ] && [ -n "${DT_OPENVERBS[$i]["was"]-}" ]; then
			DT_OPENVERBS[$i]["ext"]=${DT_OPENVERBS[$i]["was"]}
			DT_OPENVERBS[$i]["was"]=
		fi
		i=$((i + 1))
	done
	dt_openbundles
}

# Run a verb, by its number, on a selection.
fn dt_openverb(int n, ...paths) {
	local call=${DT_OPENVERBS[$n]["call"]}

	if [ -n "$call" ]; then
		dt_appfn "${DT_OPENVERBS[$n]["owner"]-}" "$call" "${paths[@]}"
	else
		dt_launch "${DT_OPENVERBS[$n]["app"]}" "${paths[0]}"
	fi
}

dt_opener hvi "Text Editor (hvi)" "*" edit
dt_opener run "Run in Terminal" "x" run

# Open a path with one opener, this once.
fn dt_openwith(name, path) {
	local ext ap

	ext := dt_ext "$path"
	case $name in
	handler) dt_runhandler "$ext" "$path"; return 0 ;;
	esac
	ap=${DT_OPENERS[$name]["app"]}
	case ${DT_OPENERS[$name]["how"]} in
	app) dt_launch "$ap" "$path" ;;
	browse) dt_launch files "$ap://$path" ;;
	edit) DT_OPENCMD=(); dt_launch term "$path" ;;
	run)
		DT_OPENCMD=("$path")
		DT_OPENSELF=1
		dt_launch term "$path"
		;;
	*) return 1 ;;
	esac
}

# Open a path with a command typed for it, this once, in a terminal: the
# command's words, then the path.
fn dt_openwithcmd(cmd, path) {
	local -a words

	read -ra words <<< "$cmd"
	[ "${#words[@]}" -gt 0 ] || return 1
	DT_OPENCMD=("${words[@]}")
	dt_launch term "$path"
}

# --- Open Terminal Here --------------------------------------------------------
#
# A terminal window whose shell starts in a folder. DT_TERMHERE is what it
# runs: "shell" for $SHELL, or a command's name.
DT_TERMHERE="${DT_TERMHERE-shell}"

fn dt_termhere(dir) {
	local sh=$DT_TERMHERE

	[ -d "$dir" ] || return 1
	[ "$sh" = shell ] && sh=${SHELL:-${HIBR:-hibr}}
	[ "$sh" = hibr ] && sh=${HIBR:-hibr}
	DT_OPENCMD=("${HIBR:-hibr}" -c 'cd -- "$1" && exec "$2"' termhere "$dir" "$sh")
	DT_OPENSELF=1
	DT_OPENSHELL=1
	dt_launch term "$dir"
}

# What of this file's state every app process that reads it is sent (ADR
# 0050, wm/rtwire.hibr).
dt_share DT_BUNDLEEXT DT_HANDLERS DT_OPENERORDER DT_OPENERS DT_OPENVERBS DT_OVN
