#!/usr/bin/env hibr
#
# wm/ime -- typing through an input method in the desktop's own text (Gitea
# #543). The methods are hibr-ime's (`ime`, a module of its own package):
# keys go in, and out come the text held under the caret, the preedit, and
# the text committed. Which method types is the keyboard's choice: the
# current keyboard's variant, when the ime module has a method of that
# name. Blit names Arabic (Arabizi) `arabizi`, and converts in program
# windows itself; the desktop converts in its own one-line fields, its
# textareas and its terminal windows. No method is named in this tree.
#
# A key reaches the method only where it is about to become text: the field
# widget, the textarea and the terminal window ask dt_imekey, never the
# desktop's key dispatch, so a game's letters, a menu's and a dialog's
# answers are never held. A field drawn as a secret (a password) never
# asks. One engine is enough, since one place has the keys; what it holds
# belongs to the window it was typed in, and is committed there -- typed
# into that window's _key -- when the keys move away or the keyboard
# changes, before anything else is drawn.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.
# interface: shared

strict

# The method typing now, its engine, and the keyboard it was chosen for.
DT_IME=
DT_IMEH=
DT_IMEKB=
# What the last key left: the preedit, the text it committed and whether
# the key itself then passes to the caller.
DT_IMEPRE=
DT_IMEC=
DT_IMEP=
# The window and the place in it the held text belongs to: a field's
# "id row col", "tb ID" for a textarea, "term" for a terminal window.
DT_IMEWIN=
DT_IMEAT=
# Set while the desktop types into a window for itself -- committing held
# text, an undo, a paste -- so those keys go straight to the text.
DT_IMEBY=
# Whether the ime module is there (1, 0, or not yet asked), and the methods
# that would not open, so neither is asked again every frame.
DT_IMEMOD=
DT_IMEBAD=
# Teaching a word (hibr-ime #1): the box asking what it reads as, the word
# as typed and its method, and -- since the box's own field types through
# an engine of its own -- the engine that holds the word, with its preedit,
# window and place, set aside until the box is answered.
DT_IMETBOX=
DT_IMETLAT=
DT_IMETM=
DT_IMETH=
DT_IMETPRE=
DT_IMETWIN=
DT_IMETAT=
# The chords last told to Blit as an input method's (dt_imekeysend).
DT_IMEKSENT=-

# The method the current keyboard names, or status 1: its variant, when the
# ime module has a method of that name that opens.
fn dt_imemethod() {
	local v

	[ "${DT_KBCUR:--1}" -ge 0 ] || return 1
	v=${DT_KB[$DT_KBCUR]["variant"]-}
	[ -n "$v" ] || return 1
	case " $DT_IMEBAD " in *" $v "*) return 1 ;; esac
	if [ -z "$DT_IMEMOD" ]; then
		DT_IMEMOD=0
		need ime 2> /dev/null && DT_IMEMOD=1
	fi
	[ "$DT_IMEMOD" = 1 ] || return 1
	ret "$v"
}

# Once a frame, before anything is drawn: the method follows the keyboard,
# and text held for a window that no longer has the keys is committed there.
dt_imecheck() {
	local m= h k=

	# The keyboard as it stands; nothing to do while it has not moved and
	# nothing is held for a window that lost the keys.
	[ "${DT_KBCUR:--1}" -ge 0 ] && k="$DT_KBCUR ${DT_KB[$DT_KBCUR]["variant"]-}"
	if [ "$k" = "$DT_IMEKB" ]; then
		[ -n "$DT_IMEPRE" ] && [ "$DT_FOCUS" != "$DT_IMEWIN" ] && dt_imedone
		return 0
	fi
	DT_IMEKB=$k
	m := dt_imemethod || m=
	if [ "$m" != "$DT_IME" ]; then
		# A word being taught goes back to its own engine first, which is
		# the one committed and closed below; the box, answered later,
		# still teaches the method it was asked for.
		dt_imeback
		dt_imedone
		[ -n "$DT_IMEH" ] && dt_imeclose
		DT_IME=
		DT_IMEH=
		if [ -n "$m" ]; then
			if h := dt_imeopen "$m"; then
				DT_IME=$m
				DT_IMEH=$h
				dt_log "ime: typing through $m"
			else
				DT_IMEBAD+=" $m"
				dt_notep low "The %s input method is not installed" "$m"
			fi
		fi
	fi
	[ -n "$DT_IMEPRE" ] && [ "$DT_FOCUS" != "$DT_IMEWIN" ] && dt_imedone
	return 0
}

# Commit whatever is held into the window it was typed in, as typing, and
# hold nothing; a window that has gone loses it.
dt_imedone() {
	local c win=$DT_IMEWIN cb

	[ -n "$DT_IMEPRE" ] && [ -n "$DT_IMEH" ] || { DT_IMEPRE=; return 0; }
	DT_IMEPRE=
	c := dt_imeflush || return 0
	[ -n "$c" ] && [ -n "$win" ] && cb=${DT[$win]["key"]-} || return 0
	[ -n "$cb" ] || return 0
	dt_imetype "$win" "$cb" "$c"
}

# Type text into window id's _key cb a character at a time, past the method.
fn dt_imetype(id, cb, text) {
	local i=0

	DT_IMEBY=1
	while [ "$i" -lt "${#text}" ]; do
		dt_wincall "$id" "$cb" "${text:$i:1}" || true
		i=$((i + 1))
	done
	DT_IMEBY=
	dt_want 10
}

# Hand a key typed into the focused window's text to the method, from at,
# the place it is typed in. Status 1 when no method takes it, and the caller
# does what it always did; otherwise DT_IMEC is the text to put in first and
# DT_IMEP is 1 when the caller then acts on the key itself. A key with no
# character of its own is the caller's while nothing is held.
fn dt_imekey(key, at) {
	[ -n "$DT_IME" ] && [ -z "$DT_IMEBY" ] && [ -n "$DT_FOCUS" ] || return 1
	[ "${#key}" = 1 ] || [ -n "$DT_IMEPRE" ] || return 1
	if [ -n "$DT_IMEPRE" ] && [ "$DT_IMEAT" != "$at" ]; then
		dt_imedone
		[ "${#key}" = 1 ] || return 1
	fi
	dt_imefeed "$key" || return 1
	DT_IMEWIN=$DT_FOCUS
	DT_IMEAT=$at
	dt_want 10
	return 0
}

# Next Spelling, Previous Spelling and Teach Word, while a word is held for
# the focused window; status 1 for any other key and whenever nothing is
# held, so the key goes on to the window as it always did.
fn dt_imeaction(k) {
	[ -n "$DT_IMEPRE" ] && [ -n "$DT_IMEH" ] && [ -z "$DT_IMEBY" ] &&
		[ -n "$DT_FOCUS" ] && [ "$DT_FOCUS" = "$DT_IMEWIN" ] || return 1
	if dt_keyis imecycle "$k"; then
		dt_imespell 1
	elif dt_keyis imeback "$k"; then
		dt_imespell -1
	elif dt_keyis imeteach "$k"; then
		dt_imeteach
	else
		return 1
	fi
	dt_want 10
	return 0
}

# Teach Word: ask what the word being typed reads as, in a box whose field
# types through an engine of its own, the word's own set aside meanwhile.
dt_imeteach() {
	local lat pre h t

	[ -z "$DT_IMETBOX" ] || return 0
	lat := dt_imeword || lat=
	if [ -z "$lat" ]; then
		dt_notep low "Teach Word teaches the word being typed"
		return 0
	fi
	pre := dt_imeread "$lat" || pre=
	if ! h := dt_imeopen "$DT_IME"; then
		dt_notep low "The %s input method would not open" "$DT_IME"
		return 0
	fi
	DT_IMETLAT=$lat
	DT_IMETM=$DT_IME
	DT_IMETH=$DT_IMEH
	DT_IMETPRE=$DT_IMEPRE
	DT_IMETWIN=$DT_IMEWIN
	DT_IMETAT=$DT_IMEAT
	DT_IMEH=$h
	DT_IMEPRE=
	DT_IMEWIN=
	DT_IMEAT=
	t := dt_tr "%s reads as" "$lat"
	DT_IMETBOX := dt_ask "Teach Word" "$t" "$pre" dt_imetaught \
		"From now on, wherever you type it." "" 54 dt_imeuntaught
}

# The box answered: teach the word, then commit it where it was typed, now
# reading as taught. Status 1 keeps the box open, saying why.
fn dt_imetaught(text, int id) {
	local c lat=$DT_IMETLAT

	# Whatever the box's own engine still holds belongs to the answer.
	if [ -n "$DT_IMEPRE" ] && [ -n "$DT_IMETH" ]; then
		c := dt_imeflush || c=
		text=$text$c
		DT_IMEPRE=
	fi
	if [ -z "$text" ] || ! dt_imelearn "$DT_IMETM" "$lat" "$text"; then
		dt_notep low "A word is taught as one word, with no spaces"
		return 1
	fi
	DT_IMETBOX=
	dt_imeback
	if [ -n "$DT_IMEPRE" ]; then
		DT_IMEPRE := dt_imepreedit || DT_IMEPRE=
		dt_imedone
	fi
	dt_notep low "%s is %s from now on" "$lat" "$text"
	return 0
}

# The box closed unanswered: the word is held as it was.
fn dt_imeuntaught(int id) {
	DT_IMETBOX=
	dt_imeback
}

# The word's own engine back, the box's closed; nothing when none is aside.
dt_imeback() {
	[ -n "$DT_IMETH" ] || return 0
	dt_imeclose
	DT_IMEH=$DT_IMETH
	DT_IMEPRE=$DT_IMETPRE
	DT_IMEWIN=$DT_IMETWIN
	DT_IMEAT=$DT_IMETAT
	DT_IMETH=
	DT_IMETPRE=
	DT_IMETWIN=
	DT_IMETAT=
	return 0
}

# Tell Blit which chords are an input method's in programs' windows: the
# first of each action's that Blit can spell. Said when it changed, and
# again until a Blit has heard it.
dt_imekeysend() {
	local an ch k out
	local -a w ow=()

	for an in imecycle imeback imeteach; do
		read -ra w <<< "${DT_KEYS["$an"]-}"
		for k in "${w[@]}"; do
			ch := dt_keepchord "$k"
			[ -n "$ch" ] || continue
			ow+=("${an#ime}=$ch")
			break
		done
	done
	out="${ow[*]}"
	[ "$out" = "$DT_IMEKSENT" ] && return 0
	console imekeys "${ow[@]}" 2> /dev/null && DT_IMEKSENT=$out
	return 0
}

# The module itself, in these calls and nowhere else, so a test can stand in
# for hibr-ime: an engine opened for method m, its handle the answer.
fn dt_imeopen(m) {
	local h

	h := ime open "$m" 2> /dev/null || return 1
	ret "$h"
}

# The engine closed.
dt_imeclose() {
	ime close "$DT_IMEH" 2> /dev/null
	return 0
}

# Everything the engine holds, committed.
dt_imeflush() {
	local c

	c := ime flush "$DT_IMEH" 2> /dev/null || return 1
	ret "$c"
}

# One key fed to the engine: DT_IMEC, DT_IMEP and DT_IMEPRE as it answers.
fn dt_imefeed(key) {
	local r

	r := ime feed "$DT_IMEH" "$key" 2> /dev/null || return 1
	DT_IMEC=${RET[0]}
	DT_IMEP=${RET[1]}
	DT_IMEPRE=${RET[2]}
}

# The word moved to its next spelling (step 1) or the one before (-1).
fn dt_imespell(int step) {
	local r

	r := ime cycle "$DT_IMEH" "$step" 2> /dev/null || return 1
	DT_IMEPRE=${RET[0]}
}

# The word being typed, as typed.
dt_imeword() {
	local w

	w := ime word "$DT_IMEH" 2> /dev/null || return 1
	ret "$w"
}

# What latin reads as on its own, to start the box from.
fn dt_imeread(lat) {
	local t

	t := ime convert "$DT_IME" "$lat" 2> /dev/null || return 1
	ret "$t"
}

# What the engine holds, as it would commit it now.
dt_imepreedit() {
	local t

	t := ime preedit "$DT_IMEH" 2> /dev/null || return 1
	ret "$t"
}

# Teach method m that lat reads as text, in the person's own layer.
fn dt_imelearn(m, lat, text) {
	ime teach "$m" "$lat" "$text" 2> /dev/null
}

# The preedit held for place at of window id, or status 1.
fn dt_imepre(int id, at) {
	[ -n "$DT_IMEPRE" ] && [ "$DT_IMEWIN" = "$id" ] && [ "$DT_IMEAT" = "$at" ] || return 1
	ret "$DT_IMEPRE"
}
