#!/usr/bin/env hibr
#
# wm/filepick -- the Open and Save dialog any app can use: a folder's
# contents, folders first, filtered by the kind of file the app works
# with, a preview of what is selected, and for Save a name to give it.
#
#   dt_filepick mode title types dir name callback for
#
# mode is open or save; types is "Label:ext ext|Label:ext|All files:*",
# the first the one shown first; dir is where to start (the last folder
# this app used, when it has used one); name is the starting name for
# save; the callback is run as `callback for path type`, the path chosen
# and the label of the type it was chosen under -- which is how an Export
# knows which format to write. Open, Save As and Export in every app are
# this one dialog.
#
# oncancel, when given, is run once as `oncancel for` when the dialog ends
# without a choice -- Cancel, escape, its window closed, or the caller
# closing it -- so an app holding something open for the answer (a
# download, a half-written file) can let it go (Gitea #375). The dialog's
# window id is handed back with ret, so a caller can close it with dt_del.
#
# Arrows move, enter opens a folder or chooses a file, backspace goes up a
# folder, ~ goes home; tab moves between the list, the name, the type and
# the buttons. A name typed with a / in it is a path, from here or from /.
# Saving over a file that is there asks first, and a name with no
# extension gets the type's first.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

command -v dt_app > /dev/null && dt_app fpick "Open" 20 76 "" "" fixed hidden

declare -gA FP
# Each record goes to the app it belongs to alone: a dialog's to the app
# that asked for it, a picker's own to its window's app (ADR 0050).
dt_share -o owner FP
declare -gA DT_FPLAST
DT_FPPEND=

fn dt_filepick(mode, title, types, dir, name, callback, for, oncancel = "") {
	local h=20 w=76 r c rid

	dt_dlgat "$h" "$w"
	r=$DT_DLGR c=$DT_DLGC h=$DT_DLGH w=$DT_DLGW
	[ -n "${DT_FPLAST["$callback"]}" ] && [ -d "${DT_FPLAST["$callback"]}" ] &&
		[ -z "$dir" ] && dir=${DT_FPLAST["$callback"]}
	[ -d "$dir" ] || dir=${HOME:-/}
	rid := dt_new "$title" "$h" "$w" "$r" "$c" fpick
	FP[$rid]["mode"]=$mode
	FP[$rid]["types"]=$types
	FP[$rid]["ti"]=0
	FP[$rid]["cb"]=$callback
	FP[$rid]["for"]=$for
	FP[$rid]["oncancel"]=$oncancel
	FP[$rid]["owner"]=$DT_CALLER
	FP[$rid]["buf"]=$name
	FP[$rid]["cur"]=${#name}
	FP[$rid]["focus"]=list
	[ "$mode" = save ] && FP[$rid]["focus"]=name
	fp_go "$rid" "$dir"
	ret "$rid"
}

# The extensions of the type chosen now, space-separated, or *.
fn fp_exts(int id) {
	local -a ts
	local t

	IFS='|' read -ra ts <<< "${FP[$id]["types"]}"
	t=${ts[${FP[$id]["ti"]}]}
	ret "${t#*:}"
}

# The labels of the types, for the dropdown.
fn fp_labels(int id) {
	local -a ts
	local t out=

	IFS='|' read -ra ts <<< "${FP[$id]["types"]}"
	for t in "${ts[@]}"; do
		out="$out|${t%%:*}"
	done
	ret "${out#|}"
}

# Go to a folder: said at once whether it can be opened, and read in a job
# (fp_ls), so a folder of thousands holds nothing up -- /tmp's 6,900 held
# the desktop 357 ms when it was read here (Gitea #606). Until all of it
# has landed ["job"] names the job and the list holds what has; a listing
# asked for meanwhile supersedes it, and one that lands late is dropped
# there. An empty name is the root: it is what `${dir%/*}` makes of a
# folder like /home, and going up from one used to say "Cannot open the
# folder" and stay put.
fn fp_go(int id, d) {
	local e job pre

	fp_own "$id"
	[ -n "$d" ] || d=/
	while [ "${#d}" -gt 1 ] && [ "${d%/}" != "$d" ]; do d=${d%/}; done
	if [ ! -d "$d" ] || [ ! -r "$d" ]; then
		dt_notep high "Cannot open the folder %s" "$d"
		return 1
	fi
	dt_jobdir || return 1
	fp_unfeed "$id"
	FP_LSN=$((FP_LSN + 1))
	pre=$DTJ_DIR/fpls$FP_LSN
	e := fp_exts "$id"
	job := dt_job fpick "$id" fp_landed fp_ls "$d" "$e" "$pre" || return 1
	DTJ[$job]["pre"]=$pre
	FP[$id]["dir"]=$d
	FP[$id]["job"]=$job
	FP[$id]["pre"]=$pre
	FP[$id]["n"]=0
	FP[$id]["sel"]=0
	FP[$id]["top"]=0
	FP[$id]["pv"]=
	FP[$id]["pc"]=
	return 0
}

# Every listing's files are named by this count, never by a window, whose
# number a new window may take while an old listing is still being read.
FP_LSN=0
# How many records a file of a listing holds, and so how many are taken
# into the list in one pass of the loop: about 4 ms of it.
FP_CHUNK=512
# How many windows are taking a listing in, for fp_feedtick.
FP_FEEDS=0

# The job's side: a folder's folders, then its files with one of the
# extensions (or * for any), as kind TAB name records ended by NULs, since a
# name may hold a newline, FP_CHUNK of them to a file pre.0, pre.1 ...; what
# it prints is how many files. Nothing here reads FP: it is a child's copy.
fn fp_ls(d, exts, pre) {
	local f nm e ok c=0
	local -a ex rec

	read -ra ex <<< "$exts"
	if [ "$d" = / ]; then
		d=
	else
		rec=(up ..)
	fi
	for f in "$d"/*/; do
		[ -d "$f" ] || continue
		nm=${f%/}
		rec+=(dir "${nm##*/}")
		[ "${#rec[@]}" -lt $((FP_CHUNK * 2)) ] && continue
		printf '%s\t%s\0' "${rec[@]}" > "$pre.$c"
		c=$((c + 1))
		rec=()
	done
	for f in "$d"/*; do
		nm=${f##*/}
		if [ "$exts" != "*" ]; then
			ok=
			for e in "${ex[@]}"; do
				case ${nm,,} in *."$e") ok=1; break ;; esac
			done
			[ -n "$ok" ] || continue
		fi
		[ -f "$f" ] || continue
		rec+=(file "$nm")
		[ "${#rec[@]}" -lt $((FP_CHUNK * 2)) ] && continue
		printf '%s\t%s\0' "${rec[@]}" > "$pre.$c"
		c=$((c + 1))
		rec=()
	done
	if [ "${#rec[@]}" -gt 0 ]; then
		printf '%s\t%s\0' "${rec[@]}" > "$pre.$c"
		c=$((c + 1))
	fi
	printf '%s\n' "$c"
	return 0
}

# A listing's files from number from on, gone.
fn fp_rmls(pre, int from, int to) {
	[ -n "$pre" ] || return 0
	while [ "$from" -lt "$to" ]; do
		rm -f "$pre.$from"
		from=$((from + 1))
	done
	return 0
}

# The job has ended: its listing is fed to the window from now on, one file
# a pass, unless the window has gone or asked for another folder since,
# when its files go.
fn fp_landed(int n, int st) {
	local id=${DTJ[$n]["tag"]} pre=${DTJ[$n]["pre"]-} f c=

	f := dt_jobfile "$n"
	read -r c 2> /dev/null < "$f"
	[[ $c =~ ^[0-9]+$ ]] || c=0
	if [ "${FP[$id]["job"]-}" != "$n" ]; then
		fp_rmls "$pre" 0 "$c"
		return 0
	fi
	FP[$id]["nch"]=$c
	FP[$id]["ch"]=0
	FP[$id]["feed"]=1
	FP_FEEDS=$((FP_FEEDS + 1))
	fp_feed "$id"
	[ "$FP_FEEDS" -gt 0 ] && command -v dt_want > /dev/null && dt_want 1
	return 0
}

# One file of a window's listing into its list; after the last, what was
# pressed while it was read, in order, and the window's own word that it
# has landed, when it asked for one (fp_set listed).
fn fp_feed(int id) {
	local pre=${FP[$id]["pre"]} j=${FP[$id]["ch"]} i=${FP[$id]["n"]} r k own
	local -a a q

	if [ "$j" -lt "${FP[$id]["nch"]}" ]; then
		mapfile -d '' -t a 2> /dev/null < "$pre.$j"
		rm -f "$pre.$j"
		for r in "${a[@]}"; do
			FP[$id]["k$i"]=${r%%$'\t'*}
			FP[$id]["e$i"]=${r#*$'\t'}
			i=$((i + 1))
		done
		j=$((j + 1))
		FP[$id]["n"]=$i
		FP[$id]["ch"]=$j
	fi
	[ "$j" -lt "${FP[$id]["nch"]}" ] && return 0
	FP[$id]["feed"]=
	FP[$id]["job"]=
	FP[$id]["pre"]=
	FP_FEEDS=$((FP_FEEDS - 1))
	[ "${FP[$id]["mode"]-}" = open ] && fp_takesel "$id"
	if [ -n "${FP[$id]["q"]-}" ]; then
		mapfile -t q <<< "${FP[$id]["q"]}"
		FP[$id]["q"]=
		for k in "${q[@]}"; do
			[ -n "${FP[$id]["dir"]+x}" ] || break
			fpick_key "$id" "$k"
		done
	fi
	own=${FP[$id]["owner"]-}
	[ -n "${FP[$id]["listed"]-}" ] && dt_appfn "$own" "${FP[$id]["listed"]}" "$id"
	return 0
}

# Each pass: the next file of every listing being taken in, and a frame
# asked for while any is. One comparison while none is.
fp_feedtick() {
	local id c=0

	[ "$FP_FEEDS" -gt 0 ] || return 0
	for id in "${!FP[@]}"; do
		[ -n "${FP[$id]["feed"]-}" ] || continue
		fp_feed "$id"
		[ -n "${FP[$id]["feed"]-}" ] && c=$((c + 1))
	done
	FP_FEEDS=$c
	[ "$c" -gt 0 ] && command -v dt_want > /dev/null && dt_want 1
	return 0
}

command -v dt_ticker > /dev/null && dt_ticker fp_feedtick

# A window's listing being taken in, given up: its files that are left, gone.
fn fp_unfeed(int id) {
	[ -n "${FP[$id]["feed"]-}" ] || return 0
	fp_rmls "${FP[$id]["pre"]}" "${FP[$id]["ch"]}" "${FP[$id]["nch"]}"
	FP[$id]["feed"]=
	FP_FEEDS=$((FP_FEEDS - 1))
	return 0
}

# A record not yet anybody's is its window's app's.
fn fp_own(int id) {
	[ -n "${FP[$id]["owner"]+x}" ] || FP[$id]["owner"]=${DT[$id]["app"]-}
	return 0
}

# A window that draws a folder of its own (the wallpaper picker) sets the
# fields of its record fp_go reads here, and nothing else: types, ti, the
# one of them chosen, and listed, its own function called as `listed id`
# once a folder has landed. Its selection and scroll are its own. Every
# pair is checked before any is set.
fn fp_set(int id, ...pairs) {
	local i k v

	if [ "${#pairs[@]}" = 0 ] || (( ${#pairs[@]} % 2 )); then
		dt_log "refused: fp_set: a field with no value"
		return 2
	fi
	for ((i = 0; i < ${#pairs[@]}; i += 2)); do
		k=${pairs[$i]}
		v=${pairs[$((i + 1))]}
		case $k in
		types) ;;
		listed)
			if [[ ! $v =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
				dt_log "refused: fp_set: $k is not a function's name: $v"
				return 1
			fi
			;;
		ti)
			if [[ ! $v =~ ^[0-9]+$ ]]; then
				dt_log "refused: fp_set: $k is not a number: $v"
				return 1
			fi
			;;
		*)
			dt_log "refused: fp_set: $k is not a field it sets"
			return 1
			;;
		esac
	done
	fp_own "$id"
	for ((i = 0; i < ${#pairs[@]}; i += 2)); do
		FP[$id]["${pairs[$i]}"]=${pairs[$((i + 1))]}
	done
	return 0
}

# Forget such a window's record when it closes; a dialog's is
# fpick_close's to forget.
fn fp_drop(int id) {
	[ -n "${FP[$id]["mode"]+x}" ] && return 0
	fp_unfeed "$id"
	unset FP["$id"]
	return 0
}

# The selected entry's full path.
fn fp_path(int id, int i) {
	local d=${FP[$id]["dir"]}

	[ "$d" = / ] && d=
	ret "$d/${FP[$id]["e$i"]}"
}

# In Open, the name field follows the selection when it is a file.
fn fp_takesel(int id) {
	local i=${FP[$id]["sel"]}

	[ "${FP[$id]["k$i"]}" = file ] || return 0
	FP[$id]["buf"]=${FP[$id]["e$i"]}
	FP[$id]["cur"]=${#FP[$id]["buf"]}
}

# Where the dialog's divider sits once it has been dragged, kept; until
# then a little over half the window is the list.
FP_LISTW="${FP_LISTW-}"
command -v dt_keep > /dev/null && dt_keep FP_LISTW

fn fpick_draw(int id, int h, int w, int row, int col) {
	local lw vis=$((h - 6)) n=${FP[$id]["n"]} sel top i r
	local t d f=${FP[$id]["focus"]} on lab glyph pw m=0 lx=1
	local -a labs

	lw := dt_split FP_LISTW $((w - 1)) 20 $((w * 11 / 20 + 1))
	lw=$((lw - 1))
	FP[$id]["lw"]=$lw
	FP[$id]["w"]=$w
	# Mirrored, every column c is drawn at w - c: the list at the right,
	# the preview at the left.
	case $DT_MIRRORON in 1) m=1; lx=$((w - lw + 1)) ;; esac
	dt_wclear "$id"
	d=${FP[$id]["dir"]}
	d=${d/#$HOME/\~}
	console pen "$DT_DIM" "$DT_FACE"
	lab := dt_tr "In:"
	if [ "$m" = 1 ]; then
		dt_tput "$id" 1 $((w - 1 - ${#lab})) "In:"
	else
		dt_tput "$id" 1 2 "In:"
	fi
	console pen "$DT_INK" "$DT_FACE" bold
	t="$d"
	[ ${#t} -gt $((w - 8)) ] && t="${GL[ellipsis]}${t:$((${#t} - w + 9))}"
	if [ "$m" = 1 ]; then
		on := str width "$t"
		console put -p "w$id" 1 $((w - 2 - ${#lab} - on)) "$t"
	else
		console put -p "w$id" 1 6 "$t"
	fi
	FP[$id]["vis"]=$vis
	sel=${FP[$id]["sel"]}
	top=${FP[$id]["top"]}
	top := dt_scrollview "$top" "${FP[$id]["n"]:-0}" "$vis" "$sel" \
		"${FP[$id]["seen"]-}"
	FP[$id]["seen"]=$sel
	FP[$id]["top"]=$top
	r=0
	while [ "$r" -lt "$vis" ]; do
		i=$((top + r))
		t=
		if [ "$i" -lt "$n" ]; then
			case ${FP[$id]["k$i"]} in
			up) glyph="${GL[up]:-^}" ;;
			dir) glyph="${GL[folder]:-+}" ;;
			*) glyph="${GL[file]:--}" ;;
			esac
			t="$glyph ${FP[$id]["e$i"]}"
			[ "${FP[$id]["k$i"]}" = dir ] && t="$t/"
			[ "$m" = 1 ] && t="${t#"$glyph "} $glyph"
		elif [ "$i" = "$n" ] && [ -n "${FP[$id]["job"]-}" ]; then
			t=${GL[ellipsis]}
		fi
		if [ "$m" = 1 ]; then
			t := dt_rpad "${t:0:$((lw - 2))}" $((lw - 2))
		else
			t := str pad "${t:0:$((lw - 2))}" $((lw - 2))
		fi
		if [ "$i" = "$sel" ] && [ "$i" -lt "$n" ]; then
			if [ "$f" = list ]; then
				console pen "$DT_SELINK" "$DT_ACTIVE"
			else
				console pen "$DT_INK" "$DT_WELL"
			fi
		elif [ "$i" -lt "$n" ] && { [ "${FP[$id]["k$i"]}" = dir ] ||
		     [ "${FP[$id]["k$i"]}" = up ]; }; then
			console pen "$DT_WARN" "$DT_FACE"
		elif [ "$i" -lt "$n" ]; then
			console pen "$DT_INK" "$DT_FACE"
		else
			console pen "$DT_DIM" "$DT_FACE"
		fi
		if [ "$m" = 1 ]; then
			console put -p "w$id" $((r + 2)) "$lx" "$t "
		else
			console put -p "w$id" $((r + 2)) 1 " $t"
		fi
		dt_wreg "$id" $((r + 2)) "$lx" $((lw - 1)) "row$i"
		r=$((r + 1))
	done
	pw=$((w - lw - 3))
	if [ "$m" = 1 ]; then
		dt_scrollbar "$id" 2 $((w - lw)) "$vis" "$n" "$vis" "$top" list
		dt_splitbar "$id" $((w - lw - 1)) 2 "$vis" "${FP[$id]["split"]:-0}"
		fp_preview "$id" 2 1 "$vis" "$pw"
	else
		dt_scrollbar "$id" 2 "$lw" "$vis" "$n" "$vis" "$top" list
		dt_splitbar "$id" $((lw + 1)) 2 "$vis" "${FP[$id]["split"]:-0}"
		fp_preview "$id" 2 $((lw + 3)) "$vis" "$pw"
	fi
	on=0
	[ "$f" = name ] && on=1
	console pen "$DT_INK" "$DT_FACE"
	if [ "$m" = 1 ]; then
		console put -p "w$id" $((h - 3)) $((w - 6)) "Name:"
		dt_textdraw "$id" $((h - 3)) "$lx" $((lw - 9)) "${FP[$id]["buf"]}" "${FP[$id]["cur"]}" "$on"
		dt_wreg "$id" $((h - 3)) "$lx" $((lw - 9)) name
		console pen "$DT_INK" "$DT_FACE"
		console put -p "w$id" $((h - 3)) $((w - lw - 7)) "Type:"
	else
		console put -p "w$id" $((h - 3)) 2 "Name:"
		dt_textdraw "$id" $((h - 3)) 9 $((lw - 9)) "${FP[$id]["buf"]}" "${FP[$id]["cur"]}" "$on"
		dt_wreg "$id" $((h - 3)) 9 $((lw - 9)) name
		console pen "$DT_INK" "$DT_FACE"
		console put -p "w$id" $((h - 3)) $((lw + 3)) "Type:"
	fi
	lab := fp_labels "$id"
	IFS='|' read -ra labs <<< "$lab"
	if [ "$f" = type ]; then
		console pen "$DT_SELINK" "$DT_ACTIVE"
	else
		console pen "$DT_INK" "$DT_FACE"
	fi
	on=$((lw + 9))
	[ "$m" = 1 ] && on=2
	dt_wdrop "$id" $((h - 3)) "$on" $((pw - 7)) "${labs[${FP[$id]["ti"]}]}" type
	lab=Open
	[ "${FP[$id]["mode"]}" = save ] && lab=Save
	dt_dlgbtns "$id" "$h" "$w" "$f" ok "$lab" cancel Cancel
}

# Where a picture goes in an h by w preview, keeping its shape: rows, cols
# and the offsets that centre it, into FP[id]["fit"] as four words. A cell
# is one column by two of the picture's rows, so cols/rows is 2*sw/sh.
# Kept for the path and the box, since img size decodes the whole file.
fn fp_picfit(int id, p, int h, int w) {
	local key="$p|$h|$w" out sw sh fr=$h fc=$w

	[ "${FP[$id]["fitfor"]}" = "$key" ] && return 0
	out := img size "$p" 2> /dev/null
	sw=${out% *}
	sh=${out#* }
	if [ "${sw:-0}" -gt 0 ] 2> /dev/null && [ "${sh:-0}" -gt 0 ] 2> /dev/null; then
		fr=$((w * sh / (2 * sw)))
		fc=$w
		if [ "$fr" -gt "$h" ]; then
			fr=$h
			fc=$((h * 2 * sw / sh))
		fi
		[ "$fr" -lt 1 ] && fr=1
		[ "$fc" -lt 1 ] && fc=1
		[ "$fc" -gt "$w" ] && fc=$w
	fi
	FP[$id]["fitfor"]=$key
	FP[$id]["fit"]="$fr $fc $(((h - fr) / 2)) $(((w - fc) / 2))"
}

# What is selected, beside the list: a picture drawn as one, a text file's
# first lines, a folder's count, or what kind of file it is. A picture's
# bytes were read as text, and a PNG's header carries none of the control
# bytes the test looked for, so About Me's picker drew it as rows of
# random characters (Gitea #302).
fn fp_preview(int id, int r0, int c0, int h, int w) {
	local i=${FP[$id]["sel"]} p k r=0 line n=0 head
	local -a lines fit ents

	k=${FP[$id]["k$i"]}
	p := fp_path "$id" "$i"
	while [ "$r" -lt "$h" ]; do
		line := str repeat " " "$w"
		console pen "$DT_INK" "$DT_FACE"
		console put -p "w$id" $((r0 + r)) "$c0" "$line"
		r=$((r + 1))
	done
	[ "$i" -lt "${FP[$id]["n"]:-0}" ] || return 0
	if [ "$k" = dir ] || [ "$k" = up ]; then
		# Counted once for the highlighted folder, as the text below is
		# read once for a file: counted on every frame, 43,793 entries
		# in /tmp cost 324 ms a frame (Gitea #358). A listing starts
		# the count again, as it does the text.
		if [ "${FP[$id]["pc"]}" != "$p" ]; then
			ents=("$p"/*)
			n=${#ents[@]}
			[ "$n" = 1 ] && [ ! -e "${ents[0]}" ] && n=0
			FP[$id]["pc"]=$p
			FP[$id]["pcn"]=$n
		fi
		n=${FP[$id]["pcn"]}
		console pen "$DT_DIM" "$DT_FACE"
		dt_tput "$id" "$r0" "$c0" "Folder, %s items" "$n"
		return 0
	fi
	# Only a plain file is opened to look at: a FIFO or a device under the
	# cursor would block the whole desktop in the read.
	if [ ! -f "$p" ]; then
		console pen "$DT_DIM" "$DT_FACE"
		dt_tput "$id" "$r0" "$c0" "Not text"
		return 0
	fi
	case ${p,,} in
	*.png | *.jpg | *.jpeg)
		if { dt_has img || need img > /dev/null 2>&1; } && dt_has img; then
			fp_picfit "$id" "$p" "$h" "$w"
			read -ra fit <<< "${FP[$id]["fit"]}"
			img draw "$p" $((r0 + fit[2])) $((c0 + fit[3])) "${fit[0]}" \
				"${fit[1]}" -p "w$id" 2> /dev/null && return 0
		fi
		console pen "$DT_DIM" "$DT_FACE"
		dt_tput "$id" "$r0" "$c0" "Picture"
		return 0
		;;
	esac
	if [ "${FP[$id]["pv"]}" != "$p" ]; then
		FP[$id]["pv"]=$p
		FP[$id]["pvn"]=0
		# A NUL in the first 4 kB is binary: a line is cut at its first
		# NUL when read, so the bytes after one are never looked at.
		if read -r -d '' -n 4096 head < "$p" 2> /dev/null &&
		   [ "${#head}" -lt 4096 ]; then
			FP[$id]["pvn"]=-1
		elif [ -r "$p" ]; then
			readarray -n "$h" -t lines < "$p" 2> /dev/null
		fi
		for line in "${lines[@]}"; do
			case $line in *[$'\001'-$'\010'$'\016'-$'\032'$'\034'-$'\037'$'\177']*) FP[$id]["pvn"]=-1; break ;; esac
			FP[$id]["pv${FP[$id]["pvn"]}"]=${line//$'\t'/    }
			FP[$id]["pvn"]=$((FP[$id]["pvn"] + 1))
		done
	fi
	if [ "${FP[$id]["pvn"]}" = -1 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		dt_tput "$id" "$r0" "$c0" "Not text"
		return 0
	fi
	r=0
	console pen "$DT_DIM" "$DT_FACE"
	while [ "$r" -lt "${FP[$id]["pvn"]}" ]; do
		line=${FP[$id]["pv$r"]}
		console put -p "w$id" $((r0 + r)) "$c0" "${line:0:$w}"
		r=$((r + 1))
	done
	[ "${FP[$id]["pvn"]}" = 0 ] && dt_tput "$id" "$r0" "$c0" "(empty)"
	return 0
}

# Enter, or Open/Save: a folder is gone into; a file, or a name, chosen.
fn fp_choose(int id) {
	local i=${FP[$id]["sel"]} k p b=${FP[$id]["buf"]} e
	local -a ex

	k=
	[ "$i" -lt "${FP[$id]["n"]:-0}" ] && k=${FP[$id]["k$i"]}
	if [ "${FP[$id]["focus"]}" = list ] && { [ "$k" = dir ] || [ "$k" = up ]; }; then
		if [ "$k" = up ]; then
			fp_go "$id" "${FP[$id]["dir"]%/*}"
			[ -n "${FP[$id]["dir"]}" ] || fp_go "$id" /
		else
			p := fp_path "$id" "$i"
			fp_go "$id" "$p"
		fi
		return 0
	fi
	[ -n "$b" ] || { [ "$k" = file ] && b=${FP[$id]["e$i"]}; }
	[ -n "$b" ] || return 0
	case $b in
	"~") p=$HOME ;;
	"~/"*) p="$HOME/${b#"~/"}" ;;
	/*) p=$b ;;
	*) p="${FP[$id]["dir"]%/}/$b" ;;
	esac
	if [ -d "$p" ]; then
		FP[$id]["buf"]=
		FP[$id]["cur"]=0
		fp_go "$id" "$p"
		return 0
	fi
	if [ "${FP[$id]["mode"]}" = open ]; then
		if [ ! -f "$p" ]; then
			dt_notep low "There is no file %s" "${p##*/}"
			return 0
		fi
		fp_done "$id" "$p"
		return 0
	fi
	e := fp_exts "$id"
	read -ra ex <<< "$e"
	if [ "$e" != "*" ]; then
		case ${p##*/} in
		*.*) ;;
		*) p="$p.${ex[0]}" ;;
		esac
	fi
	if [ ! -d "${p%/*}" ]; then
		dt_notep low "There is no folder %s" "${p%/*}"
		return 0
	fi
	if [ -e "$p" ]; then
		DT_FPPEND="$id"$'\t'"$p"
		DT_T := dt_tr "%s is there already. Replace it?" "${p##*/}"
		dt_confirm "$DT_T" fp_replace
		return 0
	fi
	fp_done "$id" "$p"
}

fp_replace() {
	local id=${DT_FPPEND%%$'\t'*} p=${DT_FPPEND#*$'\t'}

	DT_FPPEND=
	[ -n "${FP[$id]["cb"]}" ] && fp_done "$id" "$p"
}

# Hand the path to whoever asked, and close.
fn fp_done(int id, p) {
	local cb=${FP[$id]["cb"]} for=${FP[$id]["for"]} own=${FP[$id]["owner"]-} lab
	local -a labs

	lab := fp_labels "$id"
	IFS='|' read -ra labs <<< "$lab"
	lab=${labs[${FP[$id]["ti"]}]}
	DT_FPLAST["$cb"]=${p%/*}
	FP[$id]["oncancel"]=
	dt_del "$id"
	dt_appfn "$own" "$cb" "$for" "$p" "$lab"
}

# A key pressed while the folder is still being read is kept for when it
# lands, in order: arrows, enter, tab and anything typed act on the list or
# after it. Escape acts now, and so does a chord the dialog leaves to the
# desktop -- unless something is kept already, which it must not overtake.
fn fp_early(int id, key) {
	[ -n "${FP[$id]["job"]-}" ] || return 1
	case $key in
	escape) return 1 ;;
	up | down | left | right | pageup | pagedown | home | end | enter | \
	tab | shift-tab | btab | backspace | delete) ;;
	*) [ "${#key}" = 1 ] || [ -n "${FP[$id]["q"]-}" ] || return 1 ;;
	esac
	FP[$id]["q"]=${FP[$id]["q"]:+${FP[$id]["q"]}$'\n'}$key
	return 0
}

fn fpick_key(int id, key) {
	local f=${FP[$id]["focus"]} sel=${FP[$id]["sel"]} n=${FP[$id]["n"]} d res
	local vis=${FP[$id]["vis"]:-10} i k

	fp_early "$id" "$key" && return 0
	case $key in
	escape) dt_del "$id"; return 0 ;;
	tab | shift-tab | btab)
		d=1
		[ "$key" = tab ] || d=-1
		FP[$id]["focus"] := dt_focus "$f" "$d" list name type ok cancel
		return 0
		;;
	enter)
		case $f in
		cancel) dt_del "$id" ;;
		type) fp_type "$id" 1 ;;
		*) fp_choose "$id" ;;
		esac
		return 0
		;;
	esac
	case $f in
	list)
		case $key in
		up) [ "$sel" -gt 0 ] && FP[$id]["sel"]=$((sel - 1)) ;;
		down) [ "$sel" -lt $((n - 1)) ] && FP[$id]["sel"]=$((sel + 1)) ;;
		pageup) FP[$id]["sel"]=$((sel - vis)); [ "${FP[$id]["sel"]}" -lt 0 ] && FP[$id]["sel"]=0 ;;
		pagedown) FP[$id]["sel"]=$((sel + vis)); [ "${FP[$id]["sel"]}" -ge "$n" ] && FP[$id]["sel"]=$((n - 1)) ;;
		home) FP[$id]["sel"]=0 ;;
		end) FP[$id]["sel"]=$((n - 1)) ;;
		backspace | left)
			fp_go "$id" "${FP[$id]["dir"]%/*}"
			[ -n "${FP[$id]["dir"]}" ] || fp_go "$id" /
			;;
		right)
			[ "${FP[$id]["k$sel"]}" = dir ] && fp_choose "$id"
			;;
		"~") fp_go "$id" "$HOME" ;;
		/)
			FP[$id]["focus"]=name
			FP[$id]["buf"]=/
			FP[$id]["cur"]=1
			return 0
			;;
		*)
			# A letter goes to the next entry beginning with it.
			[ "${#key}" = 1 ] && [ "$n" -gt 0 ] || return 1
			i=$(((sel + 1) % n))
			k=0
			while [ "$k" -lt "$n" ]; do
				if [ "${FP[$id]["e$i"]:0:1}" = "$key" ] ||
				   [ "${FP[$id]["e$i"]:0:1}" = "${key,,}" ] ||
				   [ "${FP[$id]["e$i"]:0:1}" = "${key^^}" ]; then
					FP[$id]["sel"]=$i
					break
				fi
				i=$(((i + 1) % n))
				k=$((k + 1))
			done
			;;
		esac
		[ "${FP[$id]["mode"]}" = open ] && fp_takesel "$id"
		return 0
		;;
	name)
		res := dt_textkey "${FP[$id]["buf"]}" "${FP[$id]["cur"]}" "$key" ||
			return 1
		FP[$id]["buf"]=${res% *}
		FP[$id]["cur"]=${res##* }
		return 0
		;;
	type)
		case $key in
		up | left) fp_type "$id" -1 ;;
		down | right | " ") fp_type "$id" 1 ;;
		*) return 1 ;;
		esac
		return 0
		;;
	ok | cancel)
		case $key in
		left | right | up | down)
			d=1
			case $key in left | up) d=-1 ;; esac
			FP[$id]["focus"] := dt_focus "$f" "$d" list name type ok cancel
			;;
		esac
		return 0
		;;
	esac
	return 1
}

# The next type, or the one before, and the folder read again for it.
fn fp_type(int id, int d) {
	local -a ts
	local n

	IFS='|' read -ra ts <<< "${FP[$id]["types"]}"
	n=${#ts[@]}
	FP[$id]["ti"]=$(((FP[$id]["ti"] + d + n) % n))
	fp_go "$id" "${FP[$id]["dir"]}"
}

fn fp_settype(int? id = "", value = "") {
	local -a ts
	local i=0

	IFS='|' read -ra ts <<< "${FP[$id]["types"]}"
	while [ "$i" -lt "${#ts[@]}" ]; do
		[ "${ts[$i]%%:*}" = "$value" ] && FP[$id]["ti"]=$i
		i=$((i + 1))
	done
	fp_go "$id" "${FP[$id]["dir"]}"
}

FP_LASTCLICK=
# A press on the divider drags it; anything else is a click.
fn fpick_mouse(int id, act, btn, int r, int c, mods = "") {
	if [ "${FP[$id]["split"]}" = 1 ]; then
		[ "$DT_MIRRORON" = 1 ] && c=$((${FP[$id]["w"]:-40} - c))
		dt_splitmove FP_LISTW "$c" $((${FP[$id]["w"]:-40} - 1)) 20
		if [ "$act" = release ]; then
			FP[$id]["split"]=
			command -v dt_save > /dev/null && dt_save
		fi
		return 0
	fi
	[ "$act" = press ] || return 0
	local dv=$((${FP[$id]["lw"]:-0} + 1))

	[ "$DT_MIRRORON" = 1 ] && dv=$((${FP[$id]["w"]:-0} - ${FP[$id]["lw"]:-0} - 1))
	if [ "$c" = "$dv" ] && [ "$r" -ge 2 ] &&
	   [ "$r" -lt $((2 + ${FP[$id]["vis"]:-0})) ]; then
		FP[$id]["split"]=1
		return 0
	fi
	fpick_click "$id" "$r" "$c" "$btn"
}

fn fpick_click(int id, int r, int c, btn = "") {
	local tag now i lab
	local -a labs

	tag := dt_hit "$id" "$r" "$c"
	case $tag in
	row*)
		i=${tag#row}
		[ "$i" -lt "${FP[$id]["n"]}" ] || return 0
		FP[$id]["focus"]=list
		now := dt_ms
		if [ "${FP[$id]["sel"]}" = "$i" ] &&
		   [ "${FP_LASTCLICK%%:*}" = "$id-$i" ] &&
		   [ $((now - ${FP_LASTCLICK#*:})) -lt 500 ]; then
			FP_LASTCLICK=
			fp_choose "$id"
			return 0
		fi
		FP_LASTCLICK="$id-$i:$now"
		FP[$id]["sel"]=$i
		[ "${FP[$id]["mode"]}" = open ] && fp_takesel "$id"
		;;
	name) FP[$id]["focus"]=name ;;
	type)
		FP[$id]["focus"]=type
		lab := fp_labels "$id"
		IFS='|' read -ra labs <<< "$lab"
		DT_POPCURNEXT=${labs[${FP[$id]["ti"]:-0}]-}
		dt_droplist "$id" "$r" "$c" fp_settype "${labs[@]}"
		;;
	ok) fp_choose "$id" ;;
	cancel) dt_del "$id" ;;
	esac
	return 0
}

fn fpick_wheel(int id, dir, int r = 0, int c = 0) {
	local top

	top := dt_scrollmove "$dir" "${FP[$id]["top"]:-0}" "${FP[$id]["n"]:-0}" \
		"${FP[$id]["vis"]:-1}" "$DT_SCROLLWHEEL" || return 1
	FP[$id]["top"]=$top
	return 0
}

# The list's scrollbar held and dragged (Gitea #298).
fn fpick_scroll(int id, key, int top) { FP[$id]["top"]=$top; }

fn fpick_copy(int id) {
	local p

	p := fp_path "$id" "${FP[$id]["sel"]}"
	ret "$p"
}

fn fpick_close(int id) {
	local oc=${FP[$id]["oncancel"]} for=${FP[$id]["for"]} own=${FP[$id]["owner"]-}

	fp_unfeed "$id"
	unset FP["$id"]
	[ -n "$oc" ] && dt_appfn "$own" "$oc" "$for"
	return 0
}
