# wm/wallpaper -- the desktop's own background: a glyph, or an image fitted
# to the screen.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_WALLR=0
DT_WALLC=0
DT_WALLH=0
DT_WALLW=0

# How a picture is drawn, everywhere the desktop draws one: auto takes
# pixels where the terminal can place them (the kitty graphics protocol, or
# sixel) and half blocks where it cannot, and the rest say outright. dt_imgm
# is what every caller passes to `img draw -m`, so one setting reaches the
# viewer, the wallpaper, Mail's pictures, the film player and the browser.
# The value is `pixels`; a settings file written before 0.99.76 says `sixel`
# and means the same thing, which is why nothing migrates it.
DT_IMGMODE="${DT_IMGMODE-auto}"
dt_keep DT_IMGMODE
DT_IMGARG=()

# How the wallpaper itself is drawn: follow, the Pictures setting above, or
# half, ascii, mono or pixels of its own -- the same five YouTube's player
# offers, so a wallpaper in half blocks no longer means every picture in
# half blocks (Gitea #275). Control Panel > Wallpaper >
# Picture. Pixels on a display whose terminal cannot show them is still
# half blocks there (#258): this says what is wanted, dt_wallpixon where it
# can be had.
DT_WALLIMGMODE="${DT_WALLIMGMODE-follow}"
dt_keep DT_WALLIMGMODE

# The mode the wallpaper is drawn in now, in DT_IMGMODE's own words.
dt_wallimgmode() {
	case $DT_WALLIMGMODE in
	follow | "") ret "${DT_IMGMODE:-auto}" ;;
	*) ret "$DT_WALLIMGMODE" ;;
	esac
}

# What the wallpaper comes to on this terminal: pixels, or the cell mode it
# is drawn in -- for the Drawn Now row, as YouTube's player has.
dt_walldrawn() {
	local m

	m := dt_wallimgmode
	case $m in
	pixels | sixel) ret pixels ;;
	half | mono | ascii) ret "$m" ;;
	esac
	dt_imgpix && ret pixels
	ret half
}

# How many pixels the wallpaper is sent with. A picture under the text is
# the one every attaching client is handed in full, and at 232x71 with an
# 8x16 cell that is 1856x1136x3 raw -- 8.04 MB of base64, free on a local
# terminal and thirteen seconds of an ssh session at 5 Mbit/s (Gitea #129).
# Half is 2.01 MB and the terminal scales it back up, which is what a
# background wants rather than what a picture being looked at wants.
#
# "Nothing else is affected" is what this said, and it was wrong: the
# console's own condition halved every picture whose caller had not chosen
# a palette, which is the media module's every frame -- so a video was
# always sent at a quarter of the area the cells cover and kitty upscaled
# it, which is what "pixels still look like blocks" was (Gitea #228). The
# setting is three-state now and named for what it governs: `auto` is each
# kind's own answer, and `full`/`half` are one rule for everything, for a
# link that cannot carry full frames.
DT_IMGDETAIL="${DT_IMGDETAIL-auto}"
dt_keep DT_IMGDETAIL

# And how a still picture's payload is compressed before it is sent, which
# dt_open hands to `console imgcomp` (Gitea #129). Declared **here** as well
# as in the Pictures pane, which is where the setter lives, for the reason
# DT_IMGDETAIL is: the pane is loaded from CP_PANEDIRS and the window
# manager is not, so a desktop whose control-panel folder is missing -- a
# half-finished install -- would leave this empty, and `console imgcomp ""`
# does not do nothing: with an empty argument the verb *answers*, printing
# the mode straight at the terminal underneath the console's own cell
# drawing. A default the window manager owns cannot be absent.
DT_IMGCOMP="${DT_IMGCOMP-zlib}"
dt_keep DT_IMGCOMP

# The -m argument for the mode chosen, as an array since it is two words or
# none, and a strict file cannot split a string into them. mode is the
# Pictures setting unless a caller names another -- the wallpaper names
# its own.
fn dt_imgm(mode = "") {
	local m=${mode:-$DT_IMGMODE}

	DT_IMGARG=()
	case $m in
	auto | "") ;;
	*) DT_IMGARG=(-m "$m") ;;
	esac
	return 0
}

# What the terminal can do with a picture: "kitty 10 20", "sixel 8 16" or
# "none 0 0". Which protocol is the console's business, not an app's: an app
# asks dt_imgpix whether there are pixels to be had at all.
dt_imggfx() {
	local g

	if ! command -v console > /dev/null; then
		ret "none 0 0"
	fi
	g := console gfx 2> /dev/null || g="none 0 0"
	ret "$g"
}

# Whether this terminal places pixels, whichever protocol it speaks.
#
# The cell size is part of the question, not decoration. `console gfx`
# names the protocol from the terminal whether or not a size is to be had,
# so it answers `kitty 0 0` for one that speaks kitty and says nothing
# about its cells -- and this read the first word alone and called that
# "yes, pixels". `img draw`'s own gate is `cw > 1 && chh > 1`, so the two
# disagreed exactly there, and this is the side that was wrong: `dt_wall`
# blanked the rectangle it was about to put a bitmap in and img then drew
# cells into it, and the Browser and the YouTube player were each told to
# place pixels that cannot be placed (Gitea #211). One question, one rule,
# and the rule belongs to the module that draws.
dt_imgpix() {
	local g w h
	local -a p

	g := dt_imggfx
	read -ra p <<< "$g"
	w=${p[1]:-0}
	h=${p[2]:-0}
	case $w$h in *[!0-9]*) return 1 ;; esac
	case ${p[0]} in
	kitty | sixel) [ "$w" -gt 1 ] && [ "$h" -gt 1 ] && return 0 ;;
	esac
	return 1
}

# Whether a picture drawn now will be real pixels rather than cells: the
# setting says so outright, or it says auto and the terminal can. What a
# caller needs when the two cases want different cells around the picture --
# the wallpaper blanks what it is about to put a bitmap over.
fn dt_imgwill(mode = "") {
	case ${mode:-$DT_IMGMODE} in
	pixels | sixel) return 0 ;;
	auto | "") dt_imgpix && return 0 ;;
	esac
	return 1
}

# The row/col/h/w to hand img draw for DT_WALLMODE, in DT_WALLR/C/H/W --
# the same "cols must be 2*sw/sh, not sw/sh" cell-aspect correction
# wallpaper.hibr's own preview already uses, since img draw's own cell is
# one column wide but two source pixel rows tall. The *display* crops
# whatever falls outside the screen to it, scaling only the part that shows
# -- cropped, not squashed, which is what these two modes mean -- so zoom
# and center can freely come out larger than the screen or with a negative
# row/col and nothing here needs to clamp for it. That was not true until
# 0.99.95: cn_image refused such a rectangle outright and img fell back to
# half-block cells, so neither mode had ever been pixels on any terminal
# (Gitea #117). A pane's own edge still refuses, which is why nothing here
# draws the wallpaper through one.
#
# Cached on the image, the mode and the screen size together, since this
# runs every frame: a frame where none of the three changed reads the last
# answer instead of asking img size -- a full decode with no result but
# two numbers -- again for nothing.
# Cached on the image alone, because that is the only expensive part:
# `img size` is a full decode to learn two numbers. The arithmetic below
# is free, so it is done per display rather than cached -- a desktop
# spanning two panes fits the picture to each of them, and one cached
# answer keyed on "the screen size" would thrash between them (#238).
# One answer per image, since each display may show its own (Gitea #284)
# and one cached answer would be asked again for every display every frame.
declare -gA DT_WALLSRC
DT_WALLSRCW=0
DT_WALLSRCH=0

# The picture's own pixel size, asked once per image.
fn dt_wallsrc() {
	local out

	if [ -z "${DT_WALLSRC["$DT_WALLIMG"]+x}" ]; then
		out := img size "$DT_WALLIMG"
		DT_WALLSRC["$DT_WALLIMG"]=${out:-0 0}
	fi
	out=${DT_WALLSRC["$DT_WALLIMG"]}
	DT_WALLSRCW=${out% *}
	DT_WALLSRCH=${out#* }
	return 0
}

# A wallpaper of a display's own (Gitea #284): its image, Mode and Picture,
# the same kinds of value as DT_WALLIMG, DT_WALLMODE and DT_WALLIMGMODE,
# kept by the display's name -- the part before any #, so two displays
# from one machine, which dt_dispfree calls laptop and laptop#2, share
# one. A display with no record follows those three, which is what All
# Displays in Control Panel > Wallpaper sets. An empty image is the
# pattern, as it is for DT_WALLIMG. Written to the settings file by
# dt_save as dt_walldisp lines; room for more fields later.
declare -gA DT_WALLDIMG DT_WALLDMODE DT_WALLDPIC

# One display's record, as the settings file says it.
fn dt_walldisp(name, img = "", mode = "", pic = "") {
	DT_WALLDIMG["$name"]=$img
	DT_WALLDMODE["$name"]=${mode:-stretch}
	DT_WALLDPIC["$name"]=${pic:-follow}
}

# Put the wallpaper settings in force for the display called name: its own
# record if it has one, otherwise gi, gm and gp -- the settings every
# display follows, which dt_wall keeps aside while it walks the displays.
fn dt_walluse(name = "", gi = "", gm = "", gp = "") {
	local k=${name%%#*}

	DT_WALLIMG=$gi
	DT_WALLMODE=$gm
	DT_WALLIMGMODE=$gp
	[ -n "$k" ] || return 0
	[ -n "${DT_WALLDMODE["$k"]+x}" ] || return 0
	DT_WALLIMG=${DT_WALLDIMG["$k"]}
	DT_WALLMODE=${DT_WALLDMODE["$k"]}
	DT_WALLIMGMODE=${DT_WALLDPIC["$k"]}
	return 0
}

fn dt_wallfit(int dr, int dc, int drows, int dcols) {
	local sw sh fitr fitc

	if [ "$DT_WALLMODE" = stretch ]; then
		DT_WALLR=$dr
		DT_WALLC=$dc
		DT_WALLH=$drows
		DT_WALLW=$dcols
		return 0
	fi
	DT_WALLR=$dr
	DT_WALLC=$dc
	DT_WALLH=$drows
	DT_WALLW=$dcols
	dt_wallsrc
	sw=$DT_WALLSRCW
	sh=$DT_WALLSRCH
	[ "$sw" -gt 0 ] && [ "$sh" -gt 0 ] || return 0
	if [ "$DT_WALLMODE" = center ]; then
		fitc=$sw
		fitr=$((sh / 2))
	else
		fitc=$dcols
		fitr=$((fitc * sh / (2 * sw)))
		if [ "$DT_WALLMODE" = scale ] && [ "$fitr" -gt "$drows" ]; then
			fitr=$drows
			fitc=$((fitr * 2 * sw / sh))
		elif [ "$DT_WALLMODE" = zoom ] && [ "$fitr" -lt "$drows" ]; then
			fitr=$drows
			fitc=$((fitr * 2 * sw / sh))
		fi
	fi
	[ "$fitc" -lt 1 ] && fitc=1
	[ "$fitr" -lt 1 ] && fitr=1
	DT_WALLH=$fitr
	DT_WALLW=$fitc
	DT_WALLR=$((dr + (drows - fitr) / 2))
	DT_WALLC=$((dc + (dcols - fitc) / 2))
	return 0
}

# Everything that decides what the wallpaper's own cells should hold: what
# it paints, and everything that gets drawn on top of it and can go away
# again -- when one does, those cells are the wallpaper's once more and have
# to be painted back. The windows are in it through dt_alone's own
# signature, which carries every window's rectangle and the look.
fn dt_wallsig() {
	local s

	s="$DT_WALLIMG|$DT_WALLMODE|$DT_IMGMODE|$DT_WALLIMGMODE|$DT_GLYPH|$DT_WALL|$DT_DOT"
	# The displays too: the wallpaper, the bar and the icons are confined
	# to the primary one, so a display joining or leaving, or the primary
	# moving between them, changes every cell of it.
	s="$s|$DT_ICONS|$DI_SCANT|$DT_ROWS|$DT_COLS|$DT_WS|$DT_MIRRORON"
	s="$s|$DT_PRIMARY_COL|$DT_PRIMARY_W|$DT_PRIMARY_ROW|$DT_PRIMARY_H"
	# And every display with what it draws, so one whose terminal's
	# answer arrives, or changes, is painted the right way at once --
	# and by name, with every display's own wallpaper (Gitea #284), so a
	# change to one of them paints it.
	s="$s|${DT_DISPLAYS[*]}|${DT_DISPNAMES[*]}"
	s="$s|${!DT_WALLDMODE[*]}|${DT_WALLDIMG[*]}|${DT_WALLDMODE[*]}|${DT_WALLDPIC[*]}"
	s="$s|$MB_OPEN|$MB_CTXWHO|$DT_DND|$DT_DNDR|$DT_DNDN|$DT_DNDG"
	s="$s|${#DT_NOTEQ_ORDER[@]}|$DT_IDNAME|$DT_BLANK|${#DT_BLANKR[@]}"
	s="$s|$DT_CONFIRM|$DT_SHOT|$DT_SAVING|$DT_LOCKED"
	s="$s|$CS_COLLAPSED|$CS_SIDEX|$CS_SCROLL|${#CS_MOD_LIST[@]}"
	s="$s|$DT_ALONEFOR"
	ret "$s"
}

# A picture drawn under the text is kept only while its caller places it again,
# so the frame that stops placing it is the frame it goes -- and a wallpaper
# that is only being left alone would vanish and come back a second later,
# taking every shadow cast on the cells it covers with it (Gitea #112). So a
# frame that paints nothing still says the picture is wanted.
#
# `img keep`, never `img draw`: draw falls back to half blocks whenever pixels
# cannot be placed -- which is every `center` and `zoom` wallpaper, since the
# rectangle those fit lies partly off the screen and the display refuses it
# (Gitea #117) -- and those blocks are cells written at absolute coordinates,
# which on this path, outside `console behind on`, would land on top of every
# window and stay there until something else made them dirty. keep draws
# nothing whatever happens, and fails when there was nothing to keep.
#
# Every display the last paint placed pixels on, not only the last one:
# keeping one rectangle let the console retire the others on every frame
# that only kept the wallpaper, and the first display's picture was
# deleted and sent again over and over -- ten times in six seconds -- which
# is a primary going black (Gitea #258).
#
# Each with the picture and mode it was placed with, which since a display
# may have a wallpaper of its own (Gitea #284) is not always the session's.
DT_WALLPIX=()
DT_WALLPIXI=()
DT_WALLPIXM=()
fn dt_wallkeep() {
	local i r c h w

	dt_has img || return 0
	[ "${#DT_WALLPIX[@]}" -gt 0 ] || return 0
	for i in "${!DT_WALLPIX[@]}"; do
		IFS=' ' read -r r c h w <<< "${DT_WALLPIX[$i]}"
		dt_imgm "${DT_WALLPIXM[$i]}"
		img keep "${DT_WALLPIXI[$i]}" "$r" "$c" "$h" "$w" \
			"${DT_IMGARG[@]}" || true
	done
	return 0
}

# Whether the wallpaper goes to a display as pixels: when a picture drawn
# now would be pixels at all, and that display's own terminal draws the
# protocol the session draws in. A display that draws another, or none, or
# has not said, gets half blocks instead -- hold sends it no bitmap, and a
# picture's cells waiting for one would be a black rectangle (Gitea #258).
# `self` is a desktop that is not held, whose one display is the
# console's own terminal; `unasked` is a display attached before displays
# were asked, which hold goes on sending pictures as it did before, so it
# follows the session's own answer the same way (Gitea #274).
fn dt_wallpixon(gx) {
	local g m

	m := dt_wallimgmode
	dt_imgwill "$m" || return 1
	case $gx in
	self | unasked) return 0 ;;
	kitty | sixel)
		g := dt_imggfx
		[ "${g%% *}" = "$gx" ]
		return
		;;
	esac
	return 1
}

# The img draw arguments for half blocks where pixels are not to be had:
# the chosen cell mode when the setting names one, half blocks otherwise.
fn dt_wallcells() {
	local m

	m := dt_wallimgmode
	case $m in
	half | mono | ascii) DT_WALLCARG=(-m "$m") ;;
	*) DT_WALLCARG=(-m half) ;;
	esac
}
DT_WALLCARG=()

# Paint the wallpaper.  The bar is drawn afterwards, over the windows, so a
# drop-down menu covers them.
dt_wall() {
	local drawn= sig ms dsp dr dc drows dcols dgx wm gi gm gp i=0 p
	local -a plain

	# The icons' own rescan, and the frame it asks for, happen whether or
	# not anything is painted: inside the gate below they would stop the
	# first time the wallpaper was left alone, and a mounted disk would
	# never appear again while Control Panel still said Icons were on.
	if [ "$DT_ICONS" = 1 ]; then
		[ $((EPOCHSECONDS - DI_SCANT)) -ge 5 ] && dt_deskscan
		dt_want 5000
	fi
	# Nothing it paints has changed, and nothing drawn over it has gone:
	# its cells are still on the screen, because every window paints
	# inside its own rectangle and this paints behind them. Painted at
	# least once a second regardless, so anything the signature does not
	# know about cannot be seen for longer than that.
	sig := dt_wallsig
	ms := dt_ms
	if [ "$sig" = "$DT_WALLFOR" ] && [ "$DT_FORCEDRAW" != 1 ] &&
	   [ -n "$DT_NOOVERLAP" ] &&
	   [ -z "$DT_FORCEONCE" ] && [ $((ms - DT_WALLMS)) -lt 1000 ]; then
		dt_wallkeep
		return 0
	fi
	DT_WALLFOR=$sig
	DT_WALLMS=$ms

	# Paint around the windows, not over them. Nothing visible changes --
	# every window is drawn after this and covers its own cells anyway --
	# but it is what lets a window nobody redrew be left alone, and it
	# reaches the picture too, since the img module draws through the same
	# put. The cells a window used to cover are outside every pane the
	# moment it moves, so they are repainted here with no damage to track;
	# and a note or a menu that has gone had its cells outside the windows
	# as well.
	console behind on
	DT_WALLPIX=()
	DT_WALLPIXI=()
	DT_WALLPIXM=()
	# One picture per attached display, not one across the union. hold
	# forwards a picture only to a client whose rectangle **contains**
	# it, because a bitmap cannot be clipped -- so a single wallpaper
	# spanning two stacked panes was contained by neither and reached
	# neither (Gitea #238). Fitted to each display, each one is contained
	# by construction, and that rule stays true rather than being
	# reversed. And each display's own picture, mode and Picture where
	# it has a wallpaper of its own (Gitea #284): the session's three are
	# kept aside and put back once every display is drawn.
	#
	# Not held, or one display: exactly one placement, the same as before.
	gi=$DT_WALLIMG
	gm=$DT_WALLMODE
	gp=$DT_WALLIMGMODE
	for dsp in "${DT_DISPLAYS[@]}"; do
		IFS=' ' read -r dr dc drows dcols dgx <<< "$dsp"
		dt_walluse "${DT_DISPNAMES[$i]-}" "$gi" "$gm" "$gp"
		i=$((i + 1))
		if [ -n "$DT_WALLIMG" ] && ! dt_has img &&
		   [ -z "$DT_WALLTRIED" ]; then
			DT_WALLTRIED=1
			need img
		fi
		if [ -z "$DT_WALLIMG" ] || ! dt_has img ||
		   [ "$DT_WALLIMG" = "$DT_WALLBAD" ]; then
			plain+=("$dr $dc $drows $dcols")
			continue
		fi
		case $DT_WALLMODE in
		scale | center)
			console pen "$DT_DOT" "$DT_WALL"
			console fill "$dr" "$dc" "$drows" "$dcols" "$DT_GLYPH"
			;;
		esac
		wm := dt_wallimgmode
		dt_imgm "$wm"
		dt_wallcells
		dt_wallfit "$dr" "$dc" "$drows" "$dcols"
		# A display that cannot show the session's pixels gets half
		# blocks in its own rectangle (Gitea #258).
		if ! dt_wallpixon "$dgx"; then
			if img draw "$DT_WALLIMG" "$DT_WALLR" "$DT_WALLC" \
				"$DT_WALLH" "$DT_WALLW" "${DT_WALLCARG[@]}"; then
				drawn=1
			else
				dt_wallbad
				plain+=("$dr $dc $drows $dcols")
			fi
			continue
		fi
		# Where a picture of real pixels is going, the cells it covers
		# are blanked with no colours of their own first: a bitmap
		# writes no cells, so last frame's text would stay on top of
		# it -- and a cell with a background colour paints over a
		# picture the terminal composites below the text, which is how
		# a kitty wallpaper would be invisible under the very fill that
		# used to stand in for it.
		if dt_imgwill "$wm"; then
			console pen default default
			console fill "$DT_WALLR" "$DT_WALLC" "$DT_WALLH" \
				"$DT_WALLW" " "
		fi
		# -u: text is drawn over the wallpaper in this same frame --
		# the bar, every window, the icons -- and a picture that owns
		# its cells would be dropped before it was ever sent (ADR
		# 0037, Gitea #104).
		if img draw "$DT_WALLIMG" "$DT_WALLR" "$DT_WALLC" \
			"$DT_WALLH" "$DT_WALLW" "${DT_IMGARG[@]}" -u; then
			drawn=1
			DT_WALLPIX+=("$DT_WALLR $DT_WALLC $DT_WALLH $DT_WALLW")
			DT_WALLPIXI+=("$DT_WALLIMG")
			DT_WALLPIXM+=("$wm")
		else
			dt_wallbad
			plain+=("$dr $dc $drows $dcols")
		fi
	done
	DT_WALLIMG=$gi
	DT_WALLMODE=$gm
	DT_WALLIMGMODE=$gp
	# The pattern: across everything when no picture went anywhere, as
	# it always was, and otherwise on each display that has none.
	console pen "$DT_DOT" "$DT_WALL"
	if [ -z "$drawn" ]; then
		console fill 0 0 "$DT_ROWS" "$DT_COLS" "$DT_GLYPH"
	else
		for p in "${plain[@]}"; do
			IFS=' ' read -r dr dc drows dcols <<< "$p"
			console fill "$dr" "$dc" "$drows" "$dcols" "$DT_GLYPH"
		done
	fi
	# The icons are the desktop's too, and a window covers them whether
	# they were painted under it or skipped, so this stays inside the
	# behind-the-panes mode. Its rescan is above, outside the gate.
	[ "$DT_ICONS" = 1 ] && dt_icondraw
	console behind off
}

# A picture that would not draw -- gone, unreadable, or a file img cannot
# decode -- is said so once and not tried again while it is still the
# wallpaper, where it was tried on every frame that painted: a theme's
# picture left behind by a package that stopped shipping it filled one
# desktop's log with 135,170 lines of it (Gitea #301). Choosing another
# picture, or the same one again, tries afresh.
dt_wallbad() {
	[ "$DT_WALLBAD" = "$DT_WALLIMG" ] && return 0
	DT_WALLBAD=$DT_WALLIMG
	dt_note "Cannot show the wallpaper picture %s" "${DT_WALLIMG##*/}"
	# Raised in the middle of a frame, after the notes were drawn: an idle
	# desktop would draw no other to show it in.
	dt_want 30
}

# Right-click on the bare desktop.
DT_WALLGLYPHS=("·" "░" "▒" "⋅" "+")

# What the wallpaper was last painted for, and when. It used to say whether
# this frame painted it as well (DT_WALLDREW), which the Control Strip read
# to know its own cells had been painted over; the strip draws on every
# frame since 0.99.97 and nothing else ever read it, so it is gone.
DT_WALLFOR=
DT_WALLMS=0

dt_wallnext() {
	local i=0 g

	for g in "${DT_WALLGLYPHS[@]}"; do
		i=$((i + 1))
		[ "$g" = "$DT_GLYPH" ] && break
	done
	DT_GLYPH=${DT_WALLGLYPHS[$((i % ${#DT_WALLGLYPHS[@]}))]}
	dt_save
}
