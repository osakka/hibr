# wm/keys -- shortcuts: what each action is called, capturing a new key for
# one, clearing one, and never letting two actions hold the same key.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_KEYPEND_WHAT=
DT_KEYPEND_KEY=
DT_KEYPEND_FROM=

# The desktop's own actions, in the order the Shortcuts pane lists them,
# and what each is called there. Their keys are DT_KEYS, in
# wm/settings.hibr, and every one can be changed or cleared; an app's
# launch shortcut is DT_APPKEY, keyed by the app's name. Nothing the
# desktop does is on a key that is not in one of the two.
DT_KEYORDER=(menu start save undo redo copy cut paste selectall signin scrollup scrolldown
	move resize zoom fullscreen hide shade snapleft snapright snaptop snapbottom snapcenter ws1 ws2 ws3 ws4 ws5 ws6
	ws7 ws8 ws9 wsnext wsprev tile tilemain close quitapp cycle cycleback strip shot
	refresh lock context winmenu volup voldown mute kbdnext
	ptrrelease fsleave detach quit)
declare -gA DT_KEYNAME
DT_KEYNAME["menu"]="Menu Bar"
DT_KEYNAME["start"]="Start Menu"
DT_KEYNAME["save"]="Save"
DT_KEYNAME["undo"]="Undo"
DT_KEYNAME["redo"]="Redo"
DT_KEYNAME["copy"]="Copy"
DT_KEYNAME["cut"]="Cut"
DT_KEYNAME["paste"]="Paste"
DT_KEYNAME["selectall"]="Select All"
DT_KEYNAME["signin"]="Fill Sign-In"
DT_KEYNAME["scrollup"]="Terminal Page Back"
DT_KEYNAME["scrolldown"]="Terminal Page On"
DT_KEYNAME["zoom"]="Zoom"
DT_KEYNAME["fullscreen"]="Full Screen"
DT_KEYNAME["hide"]="Minimise"
DT_KEYNAME["shade"]="Shade"
DT_KEYNAME["snapleft"]="Snap Left"
DT_KEYNAME["snapright"]="Snap Right"
DT_KEYNAME["snaptop"]="Snap Top"
DT_KEYNAME["snapbottom"]="Snap Bottom"
DT_KEYNAME["snapcenter"]="Center"
for dt_k in 1 2 3 4 5 6 7 8 9; do DT_KEYNAME["ws$dt_k"]="Workspace $dt_k"; done
unset dt_k
DT_KEYNAME["wsnext"]="Next Workspace"
DT_KEYNAME["wsprev"]="Previous Workspace"
DT_KEYNAME["tile"]="Tile Workspace"
DT_KEYNAME["tilemain"]="Make Main"
DT_KEYNAME["close"]="Close Window"
DT_KEYNAME["quitapp"]="Quit Application"
DT_KEYNAME["volup"]="Volume Up"
DT_KEYNAME["voldown"]="Volume Down"
DT_KEYNAME["mute"]="Mute"
DT_KEYNAME["kbdnext"]="Next Keyboard"

# Two actions on one chord is silent: dt_keyed asks about each in a fixed
# order, so the first of them fires and the other simply never does. A saved
# settings file and a migration that moved only part of what it meant to is
# how that happens, so it is said in the log at load rather than fixed here
# -- which of the two should move is the person's, and the Shortcuts pane is
# where they move it.
fn dt_keydups() {
	local an v
	local -A dt_seen=()

	for an in "${DT_KEYORDER[@]}"; do
		[ -n "${DT_KEYS["$an"]+x}" ] || continue
		[ -n "${DT_KEYS["$an"]}" ] || continue
		v := dt_keynorm "${DT_KEYS["$an"]}"
		if [ -n "${dt_seen["$v"]+x}" ]; then
			printf -v v '%s and %s are both on %s; %s wins' \
				"${DT_KEYNAME["${dt_seen["$v"]}"]}" \
				"${DT_KEYNAME["$an"]}" "${DT_KEYS["$an"]}" \
				"${DT_KEYNAME["${dt_seen["$v"]}"]}"
			dt_log "$v"
		else
			dt_seen["$v"]=$an
		fi
	done
	return 0
}
DT_KEYNAME["ptrrelease"]="Release Pointer"
DT_KEYNAME["fsleave"]="Leave Full Screen"
DT_KEYNAME["detach"]="Detach"
DT_KEYNAME["quit"]="Quit"
DT_KEYNAME["cycle"]="Cycle Windows"
DT_KEYNAME["cycleback"]="Cycle Windows Back"
DT_KEYNAME["strip"]="Control Strip"
DT_KEYNAME["shot"]="Screenshot"
DT_KEYNAME["refresh"]="Refresh Desktop"
DT_KEYNAME["lock"]="Lock Screen"
DT_KEYNAME["move"]="Move Window"
DT_KEYNAME["resize"]="Resize Window"
DT_KEYNAME["context"]="Context Menu"

DT_KEYNAME["winmenu"]="Window Menu"

# A chord in one canonical modifier order, ctrl then alt then shift,
# whatever order it named them in -- an alt combination arrives as ESC
# followed by the plain control byte, and is named "alt-" then whatever
# that byte is, in that order; a CSI-encoded one (some terminals report
# a modified plain key this way too, not only function keys and arrows)
# is named "ctrl-" before "alt-". Comparing shortcuts by this instead of
# by the exact string is what makes alt-ctrl-t and ctrl-alt-t the same
# shortcut regardless of which encoding a real keypress happened to take
# -- a user typing what looks like the natural chord should not have to
# know or care which one their own terminal uses.
#
# A shortcut is the chords it is written as (ADR 0057): there is no
# placeholder modifier. A chord naming a modifier this does not know --
# `mod-c`, from before 0.99.509 -- comes back as itself after a `?`, which
# no key pressed ever is, so it matches nothing rather than a plain c.
fn dt_keynorm(k) {
	local base=$k mods= out= c=0 a=0 s=0 u=0 w
	local -a ws

	# A key that is itself a minus -- `-`, Volume Down's `mod--` -- ends
	# in one: taking what follows the last dash made it no key at all,
	# which matched every action left unbound, Quit among them.
	case $k in
	*-) base=-; mods=${k%-}; mods=${mods%-} ;;
	*-*) base=${k##*-}; mods=${k%-"$base"} ;;
	esac
	# The space bar arrives as itself, " ", and is written `space` in a
	# binding (Window Menu's alt-space): one name for both.
	[ "$base" = " " ] && base=space
	IFS=- read -ra ws <<< "$mods"
	for w in "${ws[@]}"; do
		case $w in
		ctrl) c=1 ;;
		alt) a=1 ;;
		shift) s=1 ;;
		super) u=1 ;;
		"") ;;
		*) ret "?$k"; return 0 ;;
		esac
	done
	# A terminal with no kitty keyboard sends alt-shift-l as ESC L, which
	# reads as alt with a capital: the same key, so the same name.
	if [ "$a" = 1 ]; then
		case $base in [A-Z]) s=1; base=${base,,} ;; esac
	fi
	[ "$c" = 1 ] && out="${out}ctrl-"
	[ "$a" = 1 ] && out="${out}alt-"
	[ "$s" = 1 ] && out="${out}shift-"
	[ "$u" = 1 ] && out="${out}super-"
	ret "$out$base"
}

# Whether a key, already through dt_keynorm, is one of a shortcut's chords
# -- a shortcut being one chord or several, space-separated (ADR 0057).
fn dt_keyin(list, knorm) {
	local c n
	local -a cs

	[ -n "$list" ] && [ -n "$knorm" ] || return 1
	read -ra cs <<< "$list"
	for c in "${cs[@]}"; do
		n := dt_keynorm "$c"
		[ "$n" = "$knorm" ] && return 0
	done
	return 1
}

# A shortcut as a person presses it: its chords, or, short, the first of
# them alone, which is what a menu has room for.
fn dt_keyshow(k, short = "") {
	local -a cs

	[ -n "$short" ] || { ret "$k"; return 0; }
	read -ra cs <<< "$k"
	ret "${cs[0]-}"
}

# Whether a key is one of the desktop's own shortcuts -- an action's, or an
# app's launch key -- and a chord or a function key: a window that takes
# every key may give these back, and a plain key never, since a terminal
# that cannot receive q or tab cannot be used. With DT_TERMCTRL on, as it
# is by default, ctrl with a single letter is not given back either: those
# are the control characters programs read -- ctrl-c, a shell's ctrl-w
# deleting a word, vi's ctrl-w window commands -- so ctrl-w closes any
# window but a terminal's, where it reaches the program.
fn dt_keyassigned(key) {
	local knorm an v

	case $key in
	ctrl-* | alt-* | super-* | shift-f[0-9]* | f[0-9]* | button[0-9]* | shift-button[0-9]*) ;;
	*) return 1 ;;
	esac
	if [ "$DT_TERMCTRL" = 1 ]; then
		case $key in ctrl-[a-z]) return 1 ;; esac
	fi
	knorm := dt_keynorm "$key"
	for an in "${!DT_KEYS[@]}"; do
		dt_keyin "${DT_KEYS["$an"]}" "$knorm" && return 0
	done
	for an in "${!DT_APPKEY[@]}"; do
		dt_keyin "${DT_APPKEY["$an"]}" "$knorm" && return 0
	done
	return 1
}

# An app's own actions on keys (Gitea #402): what Files' Show Hidden Files
# is on, listed in the Shortcuts pane under the app and changed there like
# any other, and acted on only while the app's window has the focus. They
# are never in dt_keyassigned, so a terminal window keeps every one of them
# -- alt-. is a shell's last argument there, and Files' hidden files here.
# Keyed "app:action"; DT_AKEY is saved with the rest.
declare -gA DT_AKEY DT_AKEYNAME
DT_AKEYORDER=()

# Declare one: the app, the action, what the pane calls it, and the key it
# has until somebody changes it.
fn dt_appaction(app, act, name, key = "") {
	local k="$app:$act"

	case " ${DT_AKEYORDER[*]} " in
	*" $k "*) ;;
	*) DT_AKEYORDER+=("$k") ;;
	esac
	DT_AKEYNAME["$k"]=$name
	[ -n "${DT_AKEY["$k"]+x}" ] || DT_AKEY["$k"]=$key
	return 0
}

# Whether key is what an app's action is on.
fn dt_akeyis(app, act, key) {
	local b

	[ -n "${DT_AKEY["$app:$act"]}" ] || return 1
	b := dt_keynorm "$key"
	dt_keyin "${DT_AKEY["$app:$act"]}" "$b"
}

# The key an app's action is on, empty for none; dt_rowaccel shows it.
fn dt_akeyof(app, act) {
	ret "${DT_AKEY["$app:$act"]}"
}

# Launch whichever app, if any, has key as its own shortcut -- the general
# form the desktop's fixed actions are not: any number of apps, not a few
# of them by name in a case statement.
fn dt_appkeyed(key) {
	local an knorm

	knorm := dt_keynorm "$key"
	for an in "${!DT_APPKEY[@]}"; do
		if dt_keyin "${DT_APPKEY["$an"]}" "$knorm"; then
			dt_launch "$an"
			return 0
		fi
	done
}

# What an action is called: "app:term" is the Terminal app's launch, and
# anything else is one of the desktop's own.
fn dt_keylabel(what) {
	case $what in
	app:*) ret "${DT_APPS["${what#app:}"]["title"]:-${what#app:}}" ;;
	act:*) ret "${DT_AKEYNAME["${what#act:}"]:-${what#act:}}" ;;
	*) ret "${DT_KEYNAME["$what"]:-$what}" ;;
	esac
}

# Whether a key is plain: no modifier and not a function key. A plain key
# of a shortcut's is never taken before the focused window has declined it
# (Menu Bar's Escape), as a terminal is never denied one (dt_keyassigned).
fn dt_keyplain(key) {
	case $key in
	ctrl-* | alt-* | super-* | shift-* | f[0-9]* | super | button[0-9]*) return 1 ;;
	esac
	return 0
}

# Whether a key is one that moves around the Control Panel and answers a
# dialog -- an arrow, enter, tab, space, backspace, delete, home, end, page
# up or down, unmodified. A shortcut cannot have one: the Shortcuts pane
# takes the very next key after a row is activated, so the arrow pressed to
# move on became the shortcut, and Menu Bar on the right arrow took every
# arrow away from every window (0.77-0.79). With a modifier any of them is
# fine -- alt-left is a shortcut, left is how you get about.
fn dt_keynav(key) {
	case $key in
	up | down | left | right | enter | tab | shift-tab | " " | space | \
	backspace | delete | home | end | pageup | pagedown | escape)
		return 0 ;;
	esac
	return 1
}

# Whether key is one of action's chords, compared in canonical order; an
# action with no key matches nothing.
fn dt_keyis(what, key) {
	local b

	[ -n "${DT_KEYS["$what"]}" ] || return 1
	b := dt_keynorm "$key"
	dt_keyin "${DT_KEYS["$what"]}" "$b"
}

# A bound chord as Blit's `INPUT keep` spells it: ctrl, alt, shift, super
# in that order, then the key (Gitea #530). Nothing for a key the desktop
# does not keep from a program -- the same test native_key asks,
# dt_keyassigned's -- nor for one the desktop cannot read (`?`).
fn dt_keepchord(k) {
	local n base mods c a s u out=

	case $k in
	ctrl-* | alt-* | super-* | shift-f[0-9]* | f[0-9]*) ;;
	# A mouse's own buttons, back, forward and the rest (Gitea #540),
	# bound with or without a modifier: kept, Blit sends them to the
	# desktop and to no program. A Blit that cannot read them refuses the
	# set and keeps its last, and the console or hold says it again
	# without them.
	button[89] | button1[01] | shift-button*) ;;
	super) ret super; return 0 ;;
	*) ret ""; return 0 ;;
	esac
	if [ "$DT_TERMCTRL" = 1 ]; then
		case $k in ctrl-[a-z]) ret ""; return 0 ;; esac
	fi
	n := dt_keynorm "$k"
	case $n in "?"*) ret ""; return 0 ;; esac
	base=$n
	mods=
	case $n in
	*-) base=-; mods=${n%-}; mods=${mods%-} ;;
	*-*) base=${n##*-}; mods=${n%-"$base"} ;;
	esac
	[ "$base" = menukey ] && base=menu
	# Only a key Blit can spell: one it cannot -- a shifted symbol, a
	# letter beyond US -- would have the whole set refused, so it is left
	# out, and kept only from terminal windows.
	case $base in
	[a-z0-9] | "\`" | "-" | "=" | "[" | "]" | "\\" | ";" | "'" | "," | "." | "/") ;;
	f[1-9] | f1[0-9] | f2[0-4]) ;;
	# Buttons as X numbers them; 4 to 7 are the wheel and never kept, and
	# left and right only with a modifier.
	button[1-3] | button[89] | button1[01]) ;;
	up | down | left | right | home | end | pageup | pagedown | insert) ;;
	delete | tab | enter | space | escape | backspace | print | menu) ;;
	*) ret ""; return 0 ;;
	esac
	# dt_keynorm already writes the modifiers in Blit's order.
	[ -n "$mods" ] && out="$mods-"
	ret "$out$base"
}

# Tell Blit the chords the desktop keeps from programs' windows (Gitea
# #530): every bound action and app key that is a chord or a function key,
# so F10 or Alt+W act once, on the desktop, and not in Firefox as well.
# The whole set each time; said only when it changed. Where there is no
# Blit the console says so and nothing comes of it.
DT_KEEPSENT=
dt_keepsend() {
	local an k ch out=
	local -A seen=()
	local -a w

	# Each of a shortcut's chords, which a list may have several of
	# (ADR 0057).
	for an in "${!DT_KEYS[@]}"; do
		read -ra w <<< "${DT_KEYS["$an"]}"
		for k in "${w[@]}"; do
			ch := dt_keepchord "$k"
			[ -n "$ch" ] && [ -z "${seen["$ch"]+x}" ] || continue
			seen["$ch"]=1
			out="$out $ch"
		done
	done
	for an in "${!DT_APPKEY[@]}"; do
		read -ra w <<< "${DT_APPKEY["$an"]}"
		for k in "${w[@]}"; do
			ch := dt_keepchord "$k"
			[ -n "$ch" ] && [ -z "${seen["$ch"]+x}" ] || continue
			seen["$ch"]=1
			out="$out $ch"
		done
	done
	out=${out# }
	[ "$out" = "$DT_KEEPSENT" ] && return 0
	read -ra w <<< "$out"
	# Kept as said only once it went: at startup the way to a held
	# session's displays is not open yet, and dt_size asks again.
	console keep "${w[@]}" 2> /dev/null && DT_KEEPSENT=$out
	return 0
}

# The key an action has now, empty for none.
fn dt_keyof(what) {
	case $what in
	app:*) ret "${DT_APPKEY["${what#app:}"]}" ;;
	act:*) ret "${DT_AKEY["${what#act:}"]}" ;;
	*) ret "${DT_KEYS["$what"]}" ;;
	esac
}

# Give an action a key, its only one, or with an empty one take its keys
# away, and keep it. An empty one is saved as empty, not left out, so a
# shortcut that ships with a default stays cleared across a restart.
fn dt_keyset(what, key) {
	[ -n "$key" ] && key := dt_keynorm "$key"
	dt_keyput "$what" "$key"
}

# Store what's whole list of chords and keep it.
fn dt_keyput(what, list) {
	case $what in
	app:*) DT_APPKEY["${what#app:}"]=$list ;;
	act:*) DT_AKEY["${what#act:}"]=$list ;;
	*) DT_KEYS["$what"]=$list ;;
	esac
	dt_save
}

# Give an action one more chord beside those it has (ADR 0057).
fn dt_keyadd(what, key) {
	local cur n

	n := dt_keynorm "$key"
	cur := dt_keyof "$what"
	dt_keyin "$cur" "$n" && return 0
	dt_keyput "$what" "${cur:+$cur }$n"
}

# Take one chord away from an action, leaving its others.
fn dt_keydrop(what, key) {
	local cur c n out=
	local -a cs

	n := dt_keynorm "$key"
	cur := dt_keyof "$what"
	read -ra cs <<< "$cur"
	for c in "${cs[@]}"; do
		dt_keyin "$c" "$n" || out="$out $c"
	done
	dt_keyput "$what" "${out# }"
}

# Which other action already holds key among its chords, if any.
fn dt_keyowner(key, except = "") {
	local knorm a e

	[ -n "$key" ] || return 1
	knorm := dt_keynorm "$key"
	for a in "${DT_KEYORDER[@]}"; do
		[ "$a" = "$except" ] && continue
		dt_keyin "${DT_KEYS["$a"]-}" "$knorm" && ret "$a"
	done
	for a in "${!DT_APPKEY[@]}"; do
		[ "app:$a" = "$except" ] && continue
		dt_keyin "${DT_APPKEY["$a"]}" "$knorm" && ret "app:$a"
	done
	# Two apps' own actions may share a key, since only the focused app's
	# acts; one app's two may not.
	for a in "${DT_AKEYORDER[@]}"; do
		[ "act:$a" = "$except" ] && continue
		case $except in act:*) e=${except#act:}; [ "${e%%:*}" = "${a%%:*}" ] || continue ;; esac
		dt_keyin "${DT_AKEY["$a"]}" "$knorm" && ret "act:$a"
	done
	return 1
}

# Whether any of what's chords is held by another action as well -- which
# only a settings file edited by hand can arrange, since taking a key
# moves it.
fn dt_keyshared(what) {
	local k c
	local -a cs

	k := dt_keyof "$what"
	read -ra cs <<< "$k"
	for c in "${cs[@]}"; do
		dt_keyowner "$c" "$what" && return 0
	done
	return 1
}

# Whether Blit keeps a chord for itself (`KEYBOARD reserved`, DT_KBRES):
# its console switch and its stop chord reach no program and no desktop.
fn dt_keyblit(key) {
	local n

	[ -n "${DT_KBRES-}" ] || return 1
	n := dt_keynorm "$key"
	dt_keyin "$DT_KBRES" "$n"
}

# Start capturing the next key as an action's shortcut -- Shortcuts calls
# this when a row is activated, with add when its + was: the key then joins
# the row's others rather than replacing them. dt_event's own DT_KEYCAP
# check takes the very next key, of any kind, and hands it to dt_keytake.
DT_KEYCAPADD=
fn dt_keycap(what, add = "") {
	local l

	DT_KEYCAP=$what
	DT_KEYCAPADD=$add
	l := dt_keylabel "$what"
	if [ -n "$add" ]; then
		dt_notep low "Press another key for %s…" "$l"
	else
		dt_notep low "Press a key for %s…" "$l"
	fi
}

# The key captured for what: asked about if another action holds it --
# answering yes moves it, so a key never has two owners -- and otherwise
# taken, as what's only key or, after +, one more. Refused: a key that moves
# around the panel, and one Blit keeps for itself.
fn dt_keytake(what, key) {
	local owner l ol

	l := dt_keylabel "$what"
	if dt_keynav "$key"; then
		dt_notep low "%s moves around the Control Panel, so it cannot be a shortcut" "$key"
		return 0
	fi
	if dt_keyblit "$key"; then
		dt_notep low "Blit keeps %s for itself, so it cannot be a shortcut" "$key"
		return 0
	fi
	if owner := dt_keyowner "$key" "$what"; then
		ol := dt_keylabel "$owner"
		DT_KEYPEND_WHAT=$what
		DT_KEYPEND_KEY=$key
		DT_KEYPEND_FROM=$owner
		DT_KEYPEND_ADD=$DT_KEYCAPADD
		DT_T := dt_tr "%s is %s's: give it to %s?" "$key" "$ol" "$l"
		dt_confirm "$DT_T" dt_keymove
		return 0
	fi
	if [ -n "$DT_KEYCAPADD" ]; then
		dt_keyadd "$what" "$key"
	else
		dt_keyset "$what" "$key"
	fi
	DT_T := dt_tr "%s is now %s" "$l" "$key"
	dt_notify "$DT_T" dt_launch panel
}

# Yes to dt_keytake's question: the key leaves the action that had it, and
# that action keeps its other chords.
DT_KEYPEND_ADD=
dt_keymove() {
	local l

	dt_keydrop "$DT_KEYPEND_FROM" "$DT_KEYPEND_KEY"
	if [ -n "$DT_KEYPEND_ADD" ]; then
		dt_keyadd "$DT_KEYPEND_WHAT" "$DT_KEYPEND_KEY"
	else
		dt_keyset "$DT_KEYPEND_WHAT" "$DT_KEYPEND_KEY"
	fi
	l := dt_keylabel "$DT_KEYPEND_WHAT"
	DT_T := dt_tr "%s is now %s" "$l" "$DT_KEYPEND_KEY"
	dt_notify "$DT_T" dt_launch panel
}

# Use Super Instead of Alt, and back (ADR 0057): once, every chord whose
# modifier is the one alone -- shift aside, no ctrl, not both -- is
# rewritten with the other, in the desktop's own shortcuts, the apps'
# launches and their actions. An action, not a setting: what it did is in
# the list afterwards, and a key changed by hand later is the person's.
fn dt_keyswap(from, to) {
	local a v n=0

	for a in "${DT_KEYORDER[@]}"; do
		v := dt_keyswap1 "${DT_KEYS["$a"]-}" "$from" "$to"
		[ "$v" = "${DT_KEYS["$a"]-}" ] && continue
		DT_KEYS["$a"]=$v
		n=$((n + 1))
	done
	for a in "${!DT_APPKEY[@]}"; do
		v := dt_keyswap1 "${DT_APPKEY["$a"]}" "$from" "$to"
		[ "$v" = "${DT_APPKEY["$a"]}" ] && continue
		DT_APPKEY["$a"]=$v
		n=$((n + 1))
	done
	for a in "${DT_AKEYORDER[@]}"; do
		v := dt_keyswap1 "${DT_AKEY["$a"]}" "$from" "$to"
		[ "$v" = "${DT_AKEY["$a"]}" ] && continue
		DT_AKEY["$a"]=$v
		n=$((n + 1))
	done
	[ "$n" -gt 0 ] && dt_save
	dt_notep low "%d shortcuts changed" "$n"
}

# One shortcut's chords with from swapped for to, where from is the only
# modifier besides shift.
fn dt_keyswap1(list, from, to) {
	local c n m out=
	local -a cs

	read -ra cs <<< "$list"
	for c in "${cs[@]}"; do
		n := dt_keynorm "$c"
		m=${n%-*}
		case $n in *--) m=${n%--} ;; esac
		case $m in
		"$from" | "$from-shift" | "shift-$from") n := dt_keynorm "${n/"$from-"/"$to-"}" ;;
		esac
		case " $out " in *" $n "*) ;; *) out="$out $n" ;; esac
	done
	ret "${out# }"
}

# Take an action's shortcut away: the Keyboard pane's clear button, and
# delete or backspace on its row.
fn dt_keyclear(what) {
	local l

	l := dt_keylabel "$what"
	dt_keyset "$what" ""
	dt_notep low "%s has no shortcut now" "$l"
}
