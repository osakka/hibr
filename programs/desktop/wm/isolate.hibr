# wm/isolate -- an app in a process of its own (ADR 0050's prototype, owner's
# go-ahead 2026-11-17: "nothing should be able to ever affect the stability
# of the desktop").
#
# The app runs in a desktop of its own, lib/apphost.hibr, started on a pty
# like any terminal window's program, and is shown here through the
# terminal emulator: its cells come back as a program's output does, and
# its keys, clicks and wheel go to it down the pty. Nothing here ever waits
# on it -- a pty is read when it is ready, and written without blocking --
# so an app that sleeps, spins or blocks in a call stops its own window and
# nothing else.
#
# What stands in for an answer: the hosted desktop stamps a file with the
# time each pass goes idle (DT_HOSTACK). Input sent here and not answered
# by a stamp within DT_HOLDMS marks the window "not responding" and writes
# a held: line naming the app -- the desktop's own log, never a wait. Keys
# go on being sent: a window is never paused and its keys never withheld.
#
# The prototype's limits, said plainly: the app's menus are its own desktop's
# (drawn in its window, not on this bar); its settings are read at start and
# not saved; the clipboard, drops and pictures do not cross yet.

strict

# Open a hosted app's window: prefix is the app's, file the script that
# defines it. Answers the window's id.
fn dt_isonew(prefix, file, title, int h, int w, int r = 2, int c = 4) {
	local ack id

	# Shown through the terminal window, which a session that loads no
	# apps does not have yet.
	dt_has term_draw || . "$DT_HERE/apps/term.hibr"
	ack="${XDG_RUNTIME_DIR:-/tmp}/hibr-host-$$-$prefix-$RANDOM"
	: > "$ack" || return 1
	if [ "$DT_ISOFORK" = 1 ]; then
		dt_isozygote || return 1
		DT_OPENCMD=("$HIBR" "$DT_HERE/lib/appstub.hibr" "$DT_ISOSOCK" "$file" "$prefix" "$title" "$ack")
	else
		DT_OPENCMD=("$HIBR" "$DT_HERE/lib/apphost.hibr" "$file" "$prefix" "$title" "$ack")
	fi
	DT_OPENSELF=1
	id := dt_new "$title" "$h" "$w" "$r" "$c" term
	TW[$id]["iso"]=$ack
	TW[$id]["isoapp"]=$prefix
	TW[$id]["isotitle"]=$title
	TW[$id]["isoin"]=
	TW[$id]["isomark"]=
	TW[$id]["isoclose"]=
	# The settings it may keep: the names its own file gives dt_keep,
	# read, never run (what the desktop runs is the app, elsewhere).
	local l k keeps=""
	local -a ws
	while IFS= read -r l; do
		case $l in *dt_keep\ *) ;; *) continue ;; esac
		# A strict file does not split: the words are read apart.
		read -ra ws <<< "${l#*dt_keep }"
		for k in "${ws[@]}"; do
			[[ $k =~ ^[A-Z][A-Z0-9_]*$ ]] && keeps+=" $k"
		done
	done < "$file"
	TW[$id]["isokeeps"]=$keeps
	dt_log "isolated: $prefix opened as window $id, a process of its own"
	ret "$id"
}

# Whether hosted apps are forks of one prepared host (1, the default), which
# shares the parsed window manager between them, or each a desktop started
# afresh (0), which parses it again: 14 MB each, measured.
DT_ISOFORK=${DT_ISOFORK-1}
declare -g DT_ISOSOCK="" DT_ISOZPID=""

# The prepared host, started the first time an app is hosted: the window
# manager parsed once, waiting on a socket for apps to fork for. It ends by
# itself when this desktop has gone.
# Asked by its pid, not by its socket: the socket appears only once the
# window manager is parsed, and a second window opened before then started a
# second host, which took the socket from the first (measured: 14 MB more).
#
# A Restart Desktop keeps this process's pid and loses its variables, so the
# host is found again by the pid it wrote beside its socket: starting a
# second would leave the first waiting for ever on a desktop that is still
# there.
dt_isozygote() {
	local zp=

	DT_ISOSOCK="${XDG_RUNTIME_DIR:-/tmp}/hibr-apphost-$$.sock"
	if [ -z "$DT_ISOZPID" ] && [ -r "$DT_ISOSOCK.pid" ]; then
		read -r zp 2> /dev/null < "$DT_ISOSOCK.pid"
		[ -n "$zp" ] && kill -0 "$zp" 2> /dev/null && DT_ISOZPID=$zp
	fi
	[ -n "$DT_ISOZPID" ] && kill -0 "$DT_ISOZPID" 2> /dev/null && return 0
	"$HIBR" "$DT_HERE/lib/apphost.hibr" --zygote "$DT_ISOSOCK" "$$" < /dev/null > /dev/null &
	DT_ISOZPID=$!
	dt_log "isolated: app host started, pid $!"
	return 0
}

# Input just went to a hosted app: the moment it went is kept until a stamp
# newer than it says the app has answered.
fn dt_isosent(int id) {
	[ -n "${TW[$id]["isoin"]-}" ] || TW[$id]["isoin"]=${EPOCHREALTIME/./}
	dt_want 50
	return 0
}

# For each hosted app with input outstanding: answered, late, or not yet
# late. Reads one small file a window, and only while something is owed.
# And what it has said is taken here too, drawn or not: a minimised app's
# menus and settings would otherwise wait until it was shown.
dt_isotick() {
	local id a in now ms t note ttl

	for id in "${DT_WINS[@]}"; do
		[ -n "${TW[$id]["iso"]-}" ] || continue
		t=${TW[$id]["t"]-}
		if [ -n "$t" ]; then
			while note := term note "$t"; do
				ttl=${note%%$'\t'*}
				[ "$ttl" = "$DT_HOSTMARK" ] && dt_isomsg "$id" "${note#*$'\t'}"
			done
		fi
		in=${TW[$id]["isoin"]-}
		[ -n "$in" ] || continue
		a=
		read -r a 2> /dev/null < "${TW[$id]["iso"]}"
		a=${a/./}
		if [ -n "$a" ] && [ "$a" -ge "$in" ]; then
			TW[$id]["isoin"]=
			if [ -n "${TW[$id]["isomark"]}" ]; then
				TW[$id]["isomark"]=
				dt_retitle "$id" "${TW[$id]["isotitle"]}"
				dt_log "isolated: ${TW[$id]["isoapp"]} answered after $(((a - in) / 1000)) ms"
			fi
			continue
		fi
		now=${EPOCHREALTIME/./}
		ms=$(((now - in) / 1000))
		if [ "$ms" -ge "${DT_HOLDMS:-150}" ] && [ -z "${TW[$id]["isomark"]}" ]; then
			TW[$id]["isomark"]=1
			dt_retitle "$id" "${TW[$id]["isotitle"]} (not responding)"
			dt_log "held: isolated:${TW[$id]["isoapp"]} $ms ms: its input is not answered; the desktop goes on"
		fi
		dt_want 100
	done
	return 0
}
command -v dt_ticker > /dev/null && dt_ticker dt_isotick

# A hosted desktop's own start: dt_open's, less everything that belongs to
# the desktop showing it -- the supervisor, hold, the control socket, the
# crash snapshot, the log's rotation, programs' windows and the saver.
dt_hostopen() {
	export XDG_CURRENT_DESKTOP=hibr XDG_SESSION_DESKTOP=hibr
	shopt -s keepgoing
	dt_load
	DT_SAVERIDLE=0
	DT_SAVERSECS=
	console open || return 1
	console darkdefault "$DT_INK" "$DT_FACE"
	console signals off
	dt_mouseset drag
	console cursor off
	if [ -d "${DT_LOG%/*}" ]; then
		exec 2>> "$DT_LOG"
		shopt -s logtime
	fi
	dt_langapply
	dt_size
	return 0
}

# ---- The word between the two desktops -------------------------------------
#
# In-band both ways, so each arrives in order with the keys and the cells
# around it and nothing is polled. Up, the hosted desktop sends an OSC 777
# note titled DT_HOSTMARK, which the terminal emulator keeps for the window
# (term note); down, the showing desktop writes a bracketed paste that
# begins with DT_HOSTMARK and the window's own token (its stamp file's
# name, which only these two know), which the hosted desktop's input takes
# for a command and never for a paste. Everything is printable -- the
# emulator's parser drops a control byte inside an OSC string, which lost
# the first version's separators and its mark -- so a field is
# percent-encoded for %, | and ~, fields are split by | and records by ~.
DT_HOSTMARK=hibr-host
declare -g DT_HOSTWIN="" DT_HOSTMAT="" DT_HOSTMSENT="" DT_HOSTSER="" DT_HOSTTOK=""
declare -ga DT_HOSTKEEPS
declare -gA DT_HOSTKSENT

# A field made safe to carry, and back.
fn dt_henc(v) {
	v=${v//%/%25}
	v=${v//|/%7C}
	v=${v//\~/%7E}
	ret "$v"
}
fn dt_hdec(v) {
	v=${v//%7C/|}
	v=${v//%7E/\~}
	v=${v//%25/%}
	ret "$v"
}

# Up: one message to the desktop showing this one.
fn dt_hostsay(msg) {
	msg=${msg//[$'\a\e\n\r']/ }
	printf '\e]777;notify;%s;%s\a' "$DT_HOSTMARK" "$msg"
	return 0
}

# Down: one command to a hosted app, in among its keys.
fn dt_isosend(int id, cmd) {
	local t=${TW[$id]["t"]-} tok=${TW[$id]["iso"]##*/}

	[ -n "$t" ] || return 1
	term write "$t" $'\e[200~'"$DT_HOSTMARK:$tok $cmd"$'\e[201~' 2> /dev/null
	dt_isosent "$id"
	return 0
}

# One menu of the hosted desktop's, item by item, into DT_HOSTSER: a row is
# its tick, dimness, label, key, shortcut text and where it lives there; a
# submenu opens and closes around its own rows.
fn dt_hostser(int m) {
	local i n=${MB[$m]["n"]:-0} lb k tk ac

	for ((i = 0; i < n; i++)); do
		if [ "${MI[$m][$i]["sep"]}" = 1 ]; then
			DT_HOSTSER+="~S"
			continue
		fi
		lb := dt_henc "${MI[$m][$i]["label"]}"
		k := dt_henc "${MI[$m][$i]["key"]}"
		if [ -n "${MI[$m][$i]["sub"]}" ]; then
			DT_HOSTSER+="~U|$lb|$k"
			dt_hostser "${MI[$m][$i]["sub"]}"
			DT_HOSTSER+="~E"
		else
			tk := dt_henc "${MI[$m][$i]["tick"]}"
			ac := dt_henc "${MI[$m][$i]["accel"]}"
			DT_HOSTSER+="~I|$tk|${MI[$m][$i]["dim"]:-0}|$lb|$k|$ac|$m|$i"
		fi
	done
	return 0
}

# The hosted app's menus, sent up each time they are built again and say
# something new -- the bar showing them is the other desktop's.
dt_hostmenus() {
	local m t

	[ -n "$DT_HOSTED" ] && [ -n "$DT_HOSTWIN" ] || return 0
	[ "${DT_MENUAT-}" != "$DT_HOSTMAT" ] || return 0
	DT_HOSTMAT=${DT_MENUAT-}
	DT_HOSTSER=
	for ((m = 0; m < MB_N; m++)); do
		[ "${MB[$m]["own"]}" = "$DT_HOSTWIN" ] && [ "${MB[$m]["bar"]}" = 1 ] || continue
		t := dt_henc "${MB[$m]["title"]}"
		DT_HOSTSER+="~M|$t"
		dt_hostser "$m"
	done
	[ "$DT_HOSTSER" != "$DT_HOSTMSENT" ] || return 0
	DT_HOSTMSENT=$DT_HOSTSER
	dt_hostsay "menus$DT_HOSTSER"
	return 0
}

# The app's own settings, sent up when it saves: the desktop showing it owns
# desktop.json, so it keeps them and writes the file; this desktop read them
# from there when it started. Only what changed is sent.
dt_hostkeep() {
	local v e


	for v in "${DT_HOSTKEEPS[@]}"; do
		[ -n "${!v+x}" ] || continue
		[ -n "${DT_HOSTKSENT["$v"]+x}" ] && [ "${DT_HOSTKSENT["$v"]}" = "${!v}" ] && continue
		DT_HOSTKSENT["$v"]=${!v}
		e := dt_henc "${!v}"
		dt_hostsay "keep|$v|$e"
	done
	return 0
}

# Its window gone, a hosted desktop has nothing left to do -- nor when the
# stub on its terminal has gone, which is how the desktop showing it ending
# it, or ending itself, reaches it: the connection the stub held is closed.
declare -g DT_HOSTCONN=""
dt_hostgone() {
	local l

	[ -n "$DT_HOSTED" ] && [ -n "$DT_HOSTWIN" ] || return 0
	if ! dt_iswin "$DT_HOSTWIN"; then
		DT_QUIT=1
		return 0
	fi
	if [ -n "$DT_HOSTCONN" ] && read -t 0 -u "$DT_HOSTCONN" 2> /dev/null; then
		read -r -t 0.01 -u "$DT_HOSTCONN" l 2> /dev/null
		[ "$?" = 1 ] && DT_QUIT=1
	fi
	return 0
}
command -v dt_ticker > /dev/null && dt_ticker dt_hostmenus && dt_ticker dt_hostgone

# A command from the desktop showing this one: a menu item chosen there, an
# Edit operation, or files let go on the window.
fn dt_hostcmd(cmd) {
	local verb rest m i mods="" p
	local -a a

	verb=${cmd%% *}
	rest=${cmd#* }
	case $verb in
	menu)
		read -r m i <<< "$rest"
		[ -n "${MI[$m][$i]["label"]+x}" ] || return 0
		MB_OPEN=$m
		MB_SEL=$i
		dt_mdo
		;;
	close)
		# Its window's close, asked here, so the app's own _canclose
		# answers: a document with changes asks first.
		dt_closereq "$DT_HOSTWIN"
		;;
	edit)
		# The desktop's own Edit, done here, to the app.
		dt_edit "$rest"
		;;
	drop)
		IFS='|' read -ra a <<< "$rest"
		[ "${a[2]-}" = copy ] && mods=ctrl
		DT_DNDS=()
		for p in "${a[@]:3}"; do
			p := dt_hdec "$p"
			DT_DNDS+=("$p")
		done
		dt_ondrop "${a[0]}" "${a[1]}" "$mods"
		;;
	esac
	dt_want 30
	return 0
}

# A message from a hosted app's desktop.
fn dt_isomsg(int id, msg) {
	local -a f
	local name v


	case $msg in
	menus*)
		TW[$id]["isomenus"]=${msg#menus}
		DT_MENUIN=
		dt_want 30
		;;
	keep\|*)
		IFS='|' read -ra f <<< "$msg"
		name=${f[1]-}
		v := dt_hdec "${f[2]-}"
		# A hosted app may keep its own settings and nothing of the
		# desktop's: no DT_ or CS_ name, nothing the shell itself reads.
		case $name in
		DT_* | CS_* | HIBR* | BASH* | PATH | HOME | IFS | PS[0-9] | LD_* | XDG_*) name= ;;
		esac
		# And only a name its own file keeps with dt_keep, read from
		# the file when its window opened -- not merely any name the
		# desktop happens not to use (TW, MB_N, RET, TZ, LANG...).
		if ! [[ $name =~ ^[A-Z][A-Z0-9_]*$ ]] ||
		   [[ " ${TW[$id]["isokeeps"]-} " != *" $name "* ]]; then
			dt_log "isolated: ${TW[$id]["isoapp"]} asked to keep a setting it may not: ${f[1]-}"
			return 0
		fi
		# Kept first, then set: dt_keep loads a saved value, which
		# must not put back the one this replaces.
		dt_keep "$name"
		declare -g "$name=$v"
		dt_save
		;;
	esac
	return 0
}

# A hosted app's menus on this desktop's bar, built from what it last sent:
# each row runs back there.
fn dt_isomenus(int id) {
	local -a recs f
	local r a b c d e

	IFS='~' read -ra recs <<< "${TW[$id]["isomenus"]-}"
	for r in "${recs[@]}"; do
		[ -n "$r" ] || continue
		IFS='|' read -ra f <<< "$r"
		case ${f[0]} in
		M) a := dt_hdec "${f[1]-}"; dt_menu "$a" ;;
		S) dt_sep ;;
		U) a := dt_hdec "${f[1]-}"; b := dt_hdec "${f[2]-}"; dt_sub "$a" "$b" ;;
		E) dt_end ;;
		I)
			a := dt_hdec "${f[1]-}"
			c := dt_hdec "${f[3]-}"
			d := dt_hdec "${f[4]-}"
			e := dt_hdec "${f[5]-}"
			dt_row "$a" "${f[2]:-0}" "$c" "$d" dt_isomenu "$id" "${f[6]}" "${f[7]}"
			[ -z "$e" ] || dt_rowaccel "$e"
			;;
		esac
	done
	MB_EDITED=1
	return 0
}

# Whether a window is a hosted app's.
fn dt_isowin(id) {
	[ -n "$id" ] && [ -n "${TW[$id]["iso"]-}" ]
}

fn dt_isomenu(int id, int m, int i) {
	dt_isosend "$id" "menu $m $i"
	return 0
}

# Files let go on a hosted app's window, handed on at the same place in its
# own screen: the window's border is this desktop's, not the app's.
fn dt_isodrop(int id, int r, int c, op, ...paths) {
	local p e s="$((r - 1))|$((c - 1))|$op"

	for p in "${paths[@]}"; do
		e := dt_henc "$p"
		s+="|$e"
	done
	dt_isosend "$id" "drop $s"
	return 0
}
