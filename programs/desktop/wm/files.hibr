# wm/files -- files between windows: dragging, dropping, moving, copying,
# the trash, and the clipboard.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_WHY=

# An app starts a drag with dt_dnd from inside its _mouse, naming the paths
# it carries; the desktop draws it under the pointer and hands it on release
# to the _drop of the window it lands on -- or to the desktop itself.  A drop
# moves, and copies with ctrl held; escape cancels.  The moving and copying
# is here, once, so every app refuses the same things and says so the same
# way.

# Start dragging: a label and a picture to show under the pointer, then the
# paths carried.  Icons dragged about the desktop may carry none.
dt_dnd() {
	DT_DNDN=$1
	DT_DNDG=${2:-${GL[file]}}
	shift 2
	DT_DNDS=("$@")
	DT_DND=1
	DT_DNDICON=
}

dt_dnddraw() {
	console pen "$DT_FACE" "$DT_ACTIVE" bold
	console put "$DT_DNDR" $((DT_DNDC + 1)) " $DT_DNDG $DT_DNDN "
}

# Hand what was dropped to whatever is under the pointer.  Not dt_drop,
# which already draws the open menu.
fn dt_ondrop(int mr, int mc, mods) {
	local op=move id ap wr wc
	local -a src

	src=("${DT_DNDS[@]}")
	DT_DND=
	DT_DNDS=()
	case $mods in *ctrl*) op=copy ;; esac
	dt_onbar "$mr" "$mc" && return 0
	id := console hit "$mr" "$mc"
	if [ -n "$id" ]; then
		id=${id#w}
		DT_DNDICON=
		ap=${DT[$id]["drop"]}
		if [ "${#src[@]}" = 0 ]; then
			dt_notep low "Only files can be dropped on a window"
			return 0
		fi
		if [ -z "$ap" ]; then
			dt_notep low "%s does not take files" "${DT[$id]["title"]}"
			return 0
		fi
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		DT_NOTEWIN=$id
		$ap "$id" $((mr - wr)) $((mc - wc)) "$op" "${src[@]}"
		return 0
	fi
	dt_has dt_deskdrop && dt_deskdrop "$mr" "$mc" "$op" "${src[@]}"
	return 0
}

# Move or copy one path into a folder: 0 done, 1 refused with the reason in
# DT_WHY, 2 nothing to do.  Nothing is ever put over something already
# there, and a folder cannot go inside itself.
fn dt_fileop1(op, src, dst) {
	local base dir

	base=${src##*/}
	if ! [ -e "$src" ] && ! [ -L "$src" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$dst" ]; then
		DT_WHY="${dst##*/} is not a folder"
		return 1
	fi
	dir=${src%/*}
	[ -z "$dir" ] && dir=/
	[ "$op" = move ] && [ "$dir" = "$dst" ] && return 2
	case "$dst/" in
	"$src/"*)
		DT_WHY="$base cannot go inside itself"
		return 1
		;;
	esac
	if [ -e "$dst/$base" ] || [ -L "$dst/$base" ]; then
		DT_WHY="${dst##*/} already has a $base"
		return 1
	fi
	if [ "$op" = copy ]; then
		command cp -R -- "$src" "$dst/" 2>> "$DT_LOG"
	else
		command mv -- "$src" "$dst/" 2>> "$DT_LOG"
	fi
	if [ $? != 0 ]; then
		DT_WHY="Could not $op $base"
		return 1
	fi
	return 0
}

# Say how a batch went: what was done, and the first thing refused. detail
# (optional) is appended to the done>1 note only -- "to $dst" or "to the
# trash" -- so the caller has one note to fire for that case, not two: a
# second dt_note right after this used to silently replace the first one's
# still-single DT_NOTE, which the queue would otherwise show as both.
fn dt_tally(int done, int bad, what, last, why, detail = "") {
	case $DT_LANG in ?*) what := dt_tr "$what" ;; esac
	if [ "$bad" = 0 ]; then
		[ "$done" = 1 ] && dt_notep low "$what $last"
		[ "$done" -gt 1 ] && dt_notep low "%s %s items%s" "$what" "$done" "${detail:+ $detail}"
	elif [ "$done" = 0 ]; then
		if [ "$bad" = 1 ]; then
			dt_notep high "$why"
		else
			dt_notep high "%s, and %s more could not go" "$why" "$((bad - 1))"
		fi
	else
		dt_notep high "%s %s; %s" "$what" "$done" "$why"
	fi
}

# Move or copy paths into a folder, and say once how it went.
fn dt_fileop(op, dst, ...rest) {
	local src n=0 bad=0 why= last= what
	local -a okp

	shift 2
	if dt_has dt_davop; then
		for src in "$dst" "$@"; do
			if dt_isremote "$src"; then
				dt_davop "$op" "$dst" "$@"
				return
			fi
		done
	fi
	for src in "$@"; do
		dt_fileop1 "$op" "$src" "$dst"
		case $? in
		0) n=$((n + 1)); last=${src##*/}; okp+=("$src" "$dst/${src##*/}") ;;
		1) bad=$((bad + 1)); [ -z "$why" ] && why=$DT_WHY ;;
		esac
	done
	[ "${#okp[@]}" -gt 0 ] && dt_fopsave "$op" "${okp[@]}"
	what := dt_tr "Moved"
	[ "$op" = copy ] && what := dt_tr "Copied"
	if [ "$n" = 1 ]; then
		dt_tally 1 "$bad" "$what" "$last to ${dst##*/}" "$why"
	else
		dt_tally "$n" "$bad" "$what" "" "$why" "to ${dst##*/}"
	fi
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# What was moved, copied, renamed or thrown away, so Undo in a Files window
# can put it back and Redo do it again (Gitea #372). One log for the whole
# desktop, as there is one clipboard: a move made by a drop on an icon, a
# paste or Get Info is undone from whichever Files window has the focus.
# One entry a batch -- "Moved 3 items" is one Undo -- holding its kind and,
# for each item, where it was (aN) and where it went (bN), under "uK" for
# the undo list and "rK" for the redo list. Nothing on a server is logged:
# nothing done there can be put back.
declare -gA DT_FOP
DT_FOPN=0
DT_FOPLO=0
DT_FOPRN=0
DT_FOPMAX=${DT_FOPMAX:-20}
DT_FOPB=
DT_TRASHED=

# Add a batch to one list: kind, then where each item was and where it went.
fn dt_foppush(st, kind, ...rest) {
	local k i n=$((${#rest[@]} / 2))

	if [ "$st" = u ]; then
		k=$DT_FOPN
		DT_FOPN=$((k + 1))
	else
		k=$DT_FOPRN
		DT_FOPRN=$((k + 1))
	fi
	DT_FOP["$st$k"]["kind"]=$kind
	DT_FOP["$st$k"]["n"]=$n
	for ((i = 0; i < n; i++)); do
		DT_FOP["$st$k"]["a$i"]=${rest[$((2 * i))]}
		DT_FOP["$st$k"]["b$i"]=${rest[$((2 * i + 1))]}
	done
	if [ "$st" = u ] && [ $((DT_FOPN - DT_FOPLO)) -gt "$DT_FOPMAX" ]; then
		unset DT_FOP["u$DT_FOPLO"]
		DT_FOPLO=$((DT_FOPLO + 1))
	fi
	return 0
}

# Log a batch just done, which is something new: what was undone can no
# longer be done again.
fn dt_fopsave(kind, ...rest) {
	local i

	for ((i = 0; i < DT_FOPRN; i++)); do unset DT_FOP["r$i"]; done
	DT_FOPRN=0
	dt_foppush u "$kind" "${rest[@]}"
}

# Whether there is a batch to undo or to do again.
fn dt_fopcan(op) {
	if [ "$op" = redo ]; then
		[ "$DT_FOPRN" -gt 0 ]
	else
		[ "$DT_FOPN" -gt "$DT_FOPLO" ]
	fi
}

# Undo or redo one item of a batch: 0 done, with where it is now in
# DT_FOPB; 1 refused with the reason in DT_WHY. Nothing is ever put over
# something already there.
fn dt_fopone(op, kind, a, b) {
	local from=$a to=$b

	DT_FOPB=$b
	if [ "$op" = undo ]; then
		from=$b
		to=$a
		if [ "$kind" = copy ]; then
			dt_trash1 "$b"
			return
		fi
	elif [ "$kind" = trash ]; then
		dt_trash1 "$a" || return 1
		DT_FOPB=$DT_TRASHED
		return 0
	fi
	if ! [ -e "$from" ] && ! [ -L "$from" ]; then
		DT_WHY="${from##*/} is not there any more"
		return 1
	fi
	if [ -e "$to" ] || [ -L "$to" ]; then
		DT_WHY="${to%/*}"
		DT_WHY="${DT_WHY##*/} already has a ${to##*/}"
		return 1
	fi
	if [ "$kind" = copy ]; then
		command cp -R -- "$from" "$to" 2>> "$DT_LOG"
	else
		command mv -- "$from" "$to" 2>> "$DT_LOG"
	fi
	if [ $? != 0 ]; then
		DT_WHY="Could not put ${from##*/} back"
		return 1
	fi
	[ "$op" = undo ] && [ "$kind" = trash ] && rm -f -- "$DT_TRASH/info/${b##*/}.trashinfo"
	return 0
}

# Undo the last batch, or do again the last one undone, and say how it went;
# status 1 when there is none.
fn dt_fopundo(op) {
	local st=u to=r k kind n i a b c=0 bad=0 why= last=
	local -a moved

	dt_fopcan "$op" || return 1
	if [ "$op" = redo ]; then
		st=r
		to=u
		k=$((DT_FOPRN - 1))
		DT_FOPRN=$k
	else
		k=$((DT_FOPN - 1))
		DT_FOPN=$k
	fi
	kind=${DT_FOP["$st$k"]["kind"]}
	n=${DT_FOP["$st$k"]["n"]:-0}
	for ((i = n - 1; i >= 0; i--)); do
		a=${DT_FOP["$st$k"]["a$i"]}
		b=${DT_FOP["$st$k"]["b$i"]}
		if dt_fopone "$op" "$kind" "$a" "$b"; then
			c=$((c + 1))
			last=${a##*/}
			moved+=("$a" "$DT_FOPB")
		else
			bad=$((bad + 1))
			[ -z "$why" ] && why=$DT_WHY
		fi
	done
	unset DT_FOP["$st$k"]
	[ "${#moved[@]}" -gt 0 ] && dt_foppush "$to" "$kind" "${moved[@]}"
	if [ "$op" = redo ]; then
		dt_tally "$c" "$bad" "Did again" "$last" "$why"
	else
		dt_tally "$c" "$bad" "Put back" "$last" "$why"
	fi
	[ "$c" -gt 0 ] && dt_changed
	return 0
}

# Tell every window that shows files that something on disk has changed.
dt_changed() {
	local id cb

	for id in "${!DT[@]}"; do
		cb=${DT[$id]["refresh"]}
		[ -n "$cb" ] && DT_NOTEWIN=$id && $cb "$id"
	done
	DT_NOTEWIN=
	dt_has dt_deskscan && dt_deskscan
	return 0
}

# The trash, where the freedesktop specification puts it, so a file thrown
# away here can be found by any other desktop on the machine and the other
# way round.
DT_TRASH="${DT_TRASH-${XDG_DATA_HOME:-$HOME/.local/share}/Trash}"

# A path as the trash's info file writes it: percent-escaped, UTF-8 left be.
fn dt_urlpath(p) {
	local out= ch i=0 x

	while [ "$i" -lt "${#p}" ]; do
		ch=${p:i:1}
		case $ch in
		[A-Za-z0-9/._~-]) out="$out$ch" ;;
		*)
			printf -v x '%d' "'$ch"
			if [ "$x" -gt 0 ] && [ "$x" -lt 128 ]; then
				printf -v x '%%%02X' "$x"
				out="$out$x"
			else
				out="$out$ch"
			fi
			;;
		esac
		i=$((i + 1))
	done
	ret "$out"
}

# Move one file or folder to the trash, with the note that says where it
# was: 0 done, 1 refused with the reason in DT_WHY.
fn dt_trash1(p) {
	local base n i=1 when enc

	base=${p##*/}
	if ! [ -e "$p" ] && ! [ -L "$p" ]; then
		DT_WHY="$base is not there any more"
		return 1
	fi
	if ! [ -d "$DT_TRASH/info" ] || ! [ -d "$DT_TRASH/files" ]; then
		if ! mkdir -p "$DT_TRASH/files" "$DT_TRASH/info" 2> /dev/null; then
			DT_WHY="There is no trash to put $base in"
			return 1
		fi
	fi
	n=$base
	while [ -e "$DT_TRASH/files/$n" ] || [ -L "$DT_TRASH/files/$n" ] ||
	      [ -e "$DT_TRASH/info/$n.trashinfo" ]; do
		n="$base.$i"
		i=$((i + 1))
	done
	printf -v when '%(%Y-%m-%dT%H:%M:%S)T' -1
	enc := dt_urlpath "$p"
	if ! printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$enc" "$when" \
		> "$DT_TRASH/info/$n.trashinfo"; then
		DT_WHY="Could not write the trash's note for $base"
		return 1
	fi
	if ! command mv -- "$p" "$DT_TRASH/files/$n" 2>> "$DT_LOG"; then
		rm -f "$DT_TRASH/info/$n.trashinfo"
		DT_WHY="Could not move $base to the trash"
		return 1
	fi
	DT_TRASHED="$DT_TRASH/files/$n"
	return 0
}

# Move paths to the trash, and say once how it went. A fully successful
# run gets a clickable note straight to the trash's own folder -- dt_tally
# only ever fires a plain dt_note, and that folder is specific to trash,
# not something dt_fileop's own move/copy shares.
dt_trash() {
	local p n=0 bad=0 why= last=
	local -a okp

	for p in "$@"; do
		if dt_trash1 "$p"; then
			n=$((n + 1))
			last=${p##*/}
			okp+=("$p" "$DT_TRASHED")
		else
			bad=$((bad + 1))
			[ -z "$why" ] && why=$DT_WHY
		fi
	done
	if [ "$n" -gt 0 ] && [ "$bad" = 0 ]; then
		local tnote
		if [ "$n" = 1 ]; then
			tnote := dt_tr "Moved %s to the trash" "$last"
		else
			# dt_trn rather than one message: Arabic has a dual as
			# well as a plural, and this branch is every count
			# above one.
			tnote := dt_trn "$n" "Moved %s item to the trash" \
				"Moved %s items to the trash" "$n"
		fi
		dt_notify "$tnote" dt_launch files "$DT_TRASH/files"
	else
		dt_tally "$n" "$bad" "Moved" "$last to the trash" "$why"
	fi
	[ "${#okp[@]}" -gt 0 ] && dt_fopsave trash "${okp[@]}"
	[ "$n" -gt 0 ] && dt_changed
	[ "$bad" = 0 ]
}

# Copy, cut or paste in the focused one-line field, for a window whose app
# offers no clipboard of its own. Status 1 when there is no field to act
# on, so dt_edit goes on to say the window cannot do it.
#
# Twenty files draw a field with dt_textdraw; eleven had ever called
# dt_textpaste, none could copy or cut, and the Control Panel -- which
# hosts more fields than anything else in the desktop -- offered none of
# the three, so whether a text box had a clipboard depended on which
# window happened to host it (Gitea #214). This cannot live in dt_textkey:
# dt_event takes those three keys before any app's own _key is called, so
# nothing would ever reach it.
#
# There is deliberately no write path to an app's own value -- a field's
# value belongs to its app, the same as a checkbox's does -- so the write
# is done by **typing**. Every one of those twenty routes keys through
# dt_textkey, so handing the app's own _key the characters of the
# clipboard is exactly what a person pasting by hand does, and a cut is
# ctrl-u then ctrl-k, which dt_textkey already means as "to the start" and
# "to the end". Nothing per app to implement, and no second rule to keep
# in step.
#
# Copy and Cut take what is selected in the field, the same as every other
# Copy in the desktop, and say so when nothing is (Gitea #295, which also
# chose that over the whole field): a field had no selection until then,
# and its Copy and Cut were the whole of it. Cut is backspace typed over
# the selection, which dt_textkey takes as "remove what is selected", and
# Select All is end typed and the far end put at the start.
fn dt_fieldedit(op) {
	local cb=${DT[$DT_FOCUS]["key"]} t i c n
	local -a part

	[ -n "$cb" ] || return 1
	dt_fieldlive || return 1
	case $op in
	copy | cut)
		if ! t := dt_fieldsel || [ -z "$t" ]; then
			dt_notep low "Nothing is selected"
			return 0
		fi
		dt_clipset "$t" "$op" text
		if [ "$op" = cut ]; then
			$cb "$DT_FOCUS" backspace || true
			dt_notep low "Cut %s characters" "${#t}"
		else
			dt_notep low "Copied %s characters" "${#t}"
		fi
		return 0
		;;
	selall)
		$cb "$DT_FOCUS" end || true
		[ -n "${DT_FIELD["text"]}" ] && DT_FIELD["anc"]=0
		dt_want 10
		return 0
		;;
	paste)
		t=$DT_CLIP
		[ -n "$t" ] || return 0
		# One line: what was copied across several becomes one, the
		# same normalisation dt_textpaste makes.
		t=${t//$'\r'/}
		t=${t//$'\n'/ }
		t=${t//$'\t'/ }
		n=${#t}
		if [ "$n" -gt "$DT_FIELDMAX" ]; then
			t=${t:0:$DT_FIELDMAX}
			dt_notep low "Pasted the first %s characters of %s" \
				"$DT_FIELDMAX" "$n"
		fi
		i=0
		while [ "$i" -lt "${#t}" ]; do
			c=${t:$i:1}
			$cb "$DT_FOCUS" "$c" || true
			i=$((i + 1))
		done
		return 0
		;;
	esac
	return 1
}

# Undo or redo in the focused field (Gitea #372). The field's value is its
# app's, so what it held is put back the way a paste puts text in: by
# typing -- everything selected, the old text typed over it, or deleted
# when it was empty, and the cursor walked back to where it was. The
# history marks the replay as its own, so it is not recorded as an edit.
fn dt_fieldundo(op) {
	local cb=${DT[$DT_FOCUS]["key"]} e t i n

	[ -n "$cb" ] || return 1
	dt_fieldlive || return 1
	if ! dt_fieldcan "$op"; then
		dt_notep low "Nothing to %s" "$op"
		return 0
	fi
	if [ "$op" = undo ]; then
		n=$((${#DT_FUNDO[@]} - 1))
		e=${DT_FUNDO[$n]}
		unset DT_FUNDO["$n"]
		DT_FUNDO=("${DT_FUNDO[@]}")
		DT_FREDO+=("$DT_FLASTC"$'\t'"$DT_FLAST")
	else
		n=$((${#DT_FREDO[@]} - 1))
		e=${DT_FREDO[$n]}
		unset DT_FREDO["$n"]
		DT_FREDO=("${DT_FREDO[@]}")
		DT_FUNDO+=("$DT_FLASTC"$'\t'"$DT_FLAST")
	fi
	t=${e#*$'\t'}
	n=${e%%$'\t'*}
	DT_FWANT=1
	$cb "$DT_FOCUS" end || true
	[ -n "${DT_FIELD["text"]}" ] && DT_FIELD["anc"]=0
	if [ -z "$t" ]; then
		$cb "$DT_FOCUS" backspace || true
	else
		i=0
		while [ "$i" -lt "${#t}" ]; do
			$cb "$DT_FOCUS" "${t:$i:1}" || true
			i=$((i + 1))
		done
	fi
	$cb "$DT_FOCUS" home || true
	i=0
	while [ "$i" -lt "$n" ]; do
		$cb "$DT_FOCUS" right || true
		i=$((i + 1))
	done
	dt_want 10
	return 0
}

# Copy or cut from the focused window, or paste into it.
#
# An app offers <app>_copy and, if it can move rather than only duplicate
# what is selected, <app>_cut -- both hand back the same kind of text with
# ret and fail when nothing is selected.  <app>_paste is given the text and,
# third, cut or copy, so a paste after Cut can move what it receives instead
# of copying it.  The desktop keeps one clipboard for every window, and also
# sends a copy to the clipboard of the terminal it runs on, where that
# terminal allows it -- so what is copied or cut here pastes into anything
# else on the machine, and, through hold, on every machine joined to it.
#
# DT_CLIPKIND says what the text is: "text", or "paths" -- files, one to a
# line, which Files pastes as the files themselves and anything else pastes
# as their names. An app's _copy that hands back paths sets it to paths;
# dt_edit has already set it to text before asking.
fn dt_edit(op) {
	local cb t

	if [ -z "$DT_FOCUS" ]; then
		[ "$op" = copy ] || return 0
		if t := dt_iconcopy && [ -n "$t" ]; then
			dt_clipset "$t" copy paths
			dt_notep low "Copied the paths of what is selected"
		else
			dt_notep low "No file is selected"
		fi
		return 0
	fi
	# A field with the focus takes Copy, Cut and Paste itself, whatever
	# the window's own callbacks would do with the rest of it (#357): one
	# rule for every field, so no app writes its own.
	dt_fieldedit "$op" && return 0
	cb=${DT[$DT_FOCUS]["$op"]}
	if [ -z "$cb" ]; then
		dt_notep low "%s cannot %s" "${DT[$DT_FOCUS]["title"]}" "$op"
		return 0
	fi
	if [ "$op" = paste ]; then
		[ -n "$DT_CLIP" ] && $cb "$DT_FOCUS" "$DT_CLIP" "${DT_CLIPOP:-copy}"
		return 0
	fi
	DT_CLIPKIND=text
	if ! t := $cb "$DT_FOCUS" || [ -z "$t" ]; then
		dt_notep low "Nothing is selected"
		return 0
	fi
	dt_clipset "$t" "$op" "$DT_CLIPKIND"
	if [ "$op" = cut ]; then
		dt_notep low "Cut %s characters" "${#t}"
	else
		dt_notep low "Copied %s characters" "${#t}"
	fi
}
