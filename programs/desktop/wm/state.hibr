# wm/state -- the state every part of the window manager shares: what has
# focus, what is being dragged, sized, grabbed or dropped, and the title-bar
# buttons being drawn.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Where an administrator's catalogue installed something for every user
# of this machine, for one kind: `apps`, `control-panel`, `savers` and
# the rest (ADR 0045). Empty when this hibr has no system scope, which
# is every shell before 0.99.197 and is why every caller appends rather
# than assigns -- an empty entry in a scan list is a folder that does
# not exist, and the scans already skip those.
#
# `$HIBR_SYSDIR` is the shell's own compiled-in value, the same one the
# module search uses, so the place a thing is installed to and the place
# it is looked for in cannot drift apart. The eight scan lists ask this
# rather than each writing the path out, which is the difference between
# one rule and eight copies of it.
fn dt_sysdir(kind) {
	[ -n "${HIBR_SYSDIR-}" ] || { ret ""; return 0 ; }
	ret "$HIBR_SYSDIR/$kind"
}

# The session's own arguments, captured here at the top level where $@ is
# still theirs: a function sees its own, and dt_autohold needs to hand these
# back to a fresh copy of itself.  $0 needs no such capture -- it is one
# value on the shell itself, the same in a function as at the top. Left
# alone if a caller already set it -- session.hibr's own opt/args consumes
# its "$@" into named variables before sourcing this file, so capturing
# again here would silently overwrite session.hibr's own, earlier and
# correct capture with the empty leftover args does not use flags for.
[ "${#DT_SELFARGS[@]}" -eq 0 ] && DT_SELFARGS=("$@")

DT_NEXT=1
DT_FOCUS=
DT_DRAG=
DT_DR=0
DT_DC=0
DT_QUIT=0
DT_SIZE=

# Which corner is being dragged, and the opposite corner's own row/col,
# captured once at the press that started the drag and held fixed for the
# rest of it -- the window's own row and col start changing the moment a
# top or left edge does, so the anchor cannot be re-read from DT[$id].
DT_SIZECORNER=
DT_SIZE_AR=0
DT_SIZE_AC=0

# A title-bar button pressed but not yet released -- close, min or max --
# shown inverted while held, and only acted on if the release lands back
# on the same one, the same press-then-release convention every other
# clickable thing in a real GUI already uses. Dragging off before letting
# go cancels it, the same as any other button; nothing here fires early.
DT_BTNID=
DT_BTNKIND=
DT_BTNOVER=0

# Scratch, filled by dt_btnspec for whichever button style is current and
# read straight back by dt_win: which kind sits at each of dt_btn's own
# fixed offsets (1, 3, 5 movable; 1, 3 fixed), its glyph, its colour, and
# what wraps the two ends of the cluster.
BTN_K=()
BTN_G=()
BTN_C=()
BTN_DL=
BTN_DR=
DT_GRAB=
DT_MOUSE=
DT_DRAGR0=0
DT_SIZENOTE=
DT_MENUEND=0
DT_MENUSTART=0
DT_DRAGC0=0
DT_CLIP=
DT_CLIPOP=
DT_CLIPKIND=
DT_DND=
DT_DNDN=
DT_DNDG=
DT_DNDR=0
DT_DNDC=0
DT_DNDICON=
DT_DNDS=()
DT_PATHS=()

# The primary display's own rectangle within the union -- read from `hold
# clients`'s own primary-flagged row when this desktop is held, so the
# bar, wallpaper and icon grid stay confined to that display instead of
# spreading across every one a terminal has joined beside it with `hold
# attach -m`. Not held (or hold not loaded): the whole screen, at the
# origin, same as always.
#
# The row and height were read off that same line and thrown away until
# 0.99.205 (Gitea #240): a union could only be horizontal in practice,
# because every placement here began at row 1 and ran to DT_ROWS however
# far down the union the primary actually started. A display server that
# stacks two panes -- the primary **below** a join -- had no way to say
# so, and had to project its physical coordinates horizontally, which
# puts every window and context menu somewhere that is not where the
# pointer is.
#
# `dt_ptop` and `dt_pbot` are the two anybody placing something should
# reach for: the first content row of the primary (below its bar) and
# the row after its last. Reading DT_PRIMARY_ROW directly is right only
# where the bar itself is meant.
DT_PRIMARY_W=
DT_PRIMARY_COL=0
DT_PRIMARY_H=
DT_PRIMARY_ROW=0

# Every attached display's own rectangle, one "row col rows cols" to an
# entry, filled by dt_size from `hold clients` and falling back to the
# whole screen when this desktop is not held. The wallpaper places one
# picture per entry rather than one across the union: hold forwards a
# picture only to a client whose rectangle *contains* it, because a
# bitmap cannot be clipped -- so a wallpaper spanning two stacked panes
# reached neither of them (Gitea #238). A picture per display is
# contained by construction, which keeps that rule true instead of
# reversing it.
DT_DISPLAYS=()

# What `hold shift` answered when dt_size last asked -- "row col",
# empty until the first read, and only ever read when held.
#
# A display put above or to the left of the others needs a negative
# corner to say so, and hold answers by moving every display together
# so the arrangement's own top-left is the union's own 0,0 (Gitea
# #257). That is what gives the new display rows that exist; what it
# also does is move the primary out from under everything already
# placed on it. Whatever is recomputed from DT_PRIMARY_ROW/COL every
# frame -- the bar, the menus, the icon layout, the Control Strip's
# own default, dialogs, dt_place, dt_tile -- follows on its own. A
# window a person put somewhere is stored in the union's coordinates
# and does not, so it is moved by the same amount or it ends up
# straddling the join.
#
# The amount is **asked for** rather than worked out here, and both
# ways of working it out were tried and were wrong. The primary's own
# corner moves by a whole display's width when somebody merely picks a
# different primary, with nothing having moved at all -- which slid
# every window eighty columns sideways and failed two checks that had
# nothing to do with this. And one display's own movement cannot tell
# a shift from that display having been the one dragged, which is the
# case that causes the shift in the first place.
DT_SHIFTWAS=

# The first content row of the primary display: its own top, plus the bar
# that sits on it. Everything that used to start at a literal 1 starts
# here, which is the whole of making a stacked union work -- 1 is only
# right while the primary begins at the top of the union.
fn dt_ptop() {
	ret "$((DT_PRIMARY_ROW + 1))"
}

# Whether a screen row and column is on the menu bar: the primary's own top
# row, inside its own columns. Clicks asked `row = 0`, which is the bar only
# while the primary is the top display -- with a joined display stacked
# above it, the bar was drawn on the primary and answered on the display
# above, in the same place (Gitea #240).
fn dt_onbar(int r, int c) {
	[ "$r" = "$DT_PRIMARY_ROW" ] && [ "$c" -ge "$DT_PRIMARY_COL" ] &&
		[ "$c" -lt $((DT_PRIMARY_COL + ${DT_PRIMARY_W:-$DT_COLS})) ]
}

# One past the primary's last row, so a bound is `< dt_pbot` exactly as it
# used to be `< DT_ROWS`.
fn dt_pbot() {
	ret "$((DT_PRIMARY_ROW + ${DT_PRIMARY_H:-$DT_ROWS}))"
}

# Whether the event dt_event just handled was a drag report -- dt_run's
# own signal for whether this is a turn it may skip drawing, set there
# rather than passed back some other way since dt_run already calls
# dt_event for its only side effect and reads no return value from it.
DT_LASTDRAG=0
# Whether the next wait should ignore the descriptors the desktop watches:
# set when the output cap has just held a frame back, so a program writing
# cannot wake it for a frame it is already waiting to draw.
DT_QWAIT=
# And whether it was a drag or a wheel, either of which dt_run will not draw
# while the next report is already waiting.
DT_LASTMOVE=0
