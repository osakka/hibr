# wm/notify -- notifications: the corner-stacked notes, their clickable
# actions, and the history behind them.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# A queue of notes -- Growl's own corner-stacked, several-at-once look,
# not one box replaced by whatever calls dt_note next. Each is a real id
# (monotonic, never reused, so a stale click on a note already gone can
# never act on or dismiss whatever now holds that same array slot), its
# own text and creation time, and -- dt_notify's own addition -- an
# action, kept as argv words (arg0..argN-1, argvn) the same shape
# term_open's own DT_OPENCMD already is, not a joined string handed back
# for the shell to re-split later; a path with a space in it does not
# survive that, and this should not depend on one never having one.
declare -gA DT_NOTEQ
DT_NOTEQ_ORDER=()
DT_NOTE_NEXT=0
declare -gA DT_NOTERECT

# Once a note's own time is up it moves here instead of vanishing -- the
# "center" a notification center needs, capped and in memory only:
# dt_save reruns and rewrites the whole settings file on every setting
# change, so a growing log through it would make each one slower and
# turn the settings file into a log. Gone at quit, on purpose -- this
# session's own history, not a permanent record.
declare -gA DT_NOTEHIST
DT_NOTEHIST_ORDER=()
DT_NOTEHIST_NEXT=0
DT_NOTEHISTMAX=50

# How long a note stays before it moves to history on its own, and which
# corner new ones stack from -- both env-overridable before a saved
# setting replaces them, the same as DT_TICK and the rest of DT_KEEP.
DT_NOTEMS="${DT_NOTEMS-2500}"
DT_NOTEPOS="${DT_NOTEPOS-top-right}"
# Which display the stack is on: the primary, where the bar and the icons
# are, or every display, each with the same stack in its own corner
# (Gitea #280). Notes were placed against the whole of every display put
# together until then, so "top right" was the corner of whichever display
# was right-most, primary or not.
DT_NOTEWHERE="${DT_NOTEWHERE-primary}"

# How small and how large a note's box may be, border included, in columns
# and rows (Gitea #227). A note had no maximum but the screen, so a
# one-line message from a program was a note two hundred columns wide.
# Past the largest it is cut, says so with GL[sdown] on its bottom edge,
# and stays until it is clicked rather than vanishing before anybody could
# open it. Each is a Control Panel > Notifications row.
DT_NOTEWMIN="${DT_NOTEWMIN-24}"
DT_NOTEWMAX="${DT_NOTEWMAX-52}"
DT_NOTEHMIN="${DT_NOTEHMIN-3}"
DT_NOTEHMAX="${DT_NOTEHMAX-8}"

# Notes that have arrived since the history was last looked at: the bar's
# dot is filled while this is above zero, hollow once it has been read.
DT_NOTEUNSEEN=0
# Every note has a priority. Feedback on what you just did -- "Workspace
# 2", "Record 4 added", "Not a valid name" -- is low, since you were looking
# at it; something you were not watching -- a program's own notification --
# is normal; a failure is high, and urgent is for what cannot wait. Only notes at DT_NOTECOUNT or above raise the bar's count, so the
# count means something; every note still pops up, and still goes to the
# history, which shows each one's priority and clears them by it.
DT_NOTELEVELS=(low normal high urgent)

# Who a note is from. The window manager marks the window whose app it is
# handling -- a key, a click, a menu item, a frame, an idle tick -- in
# DT_NOTEWIN, and a note made meanwhile is from that app; one made with no
# window marked is the desktop's own. DT_NOTEFROM names a sender outright,
# for the next note only.
DT_NOTEWIN=
DT_NOTEFROM=

# The name a note made now is from.
dt_notefrom() {
	local w=$DT_NOTEWIN ap

	if [ -n "$DT_NOTEFROM" ]; then
		ret "$DT_NOTEFROM"
		return 0
	fi
	if [ -n "$w" ] && [ -n "${DT[$w]["title"]}" ]; then
		ap=${DT[$w]["app"]}
		if [ -n "$ap" ] && [ -n "${DT_APPS[$ap]["title"]}" ]; then
			ret "${DT_APPS[$ap]["title"]}"
		else
			ret "${DT[$w]["title"]}"
		fi
		return 0
	fi
	ret Desktop
}
DT_NOTECOUNT="${DT_NOTECOUNT-normal}"
# Which notes go to the history: those at DT_NOTELIST or above. Feedback on
# what you just did -- "Workspace 2", "Volume 40%" -- is low and still pops
# up where you are looking, and is not kept: a list of every volume step is
# a list nobody can find anything in. normal by default; low lists them all.
DT_NOTELIST="${DT_NOTELIST-normal}"
# What each sender's notes do, overriding the priorities: "pop list count",
# each 1 for always, 0 for never and - for as its priority says. Keyed by
# the name a note is from (dt_notefrom), which is an app's own title or
# Desktop; set from Control Panel > Notifications and from a note's own
# menu in the panel under the bell.
declare -gA DT_NOTEAPP

# Whether a note from a sender at a priority does one of three things: pop
# (shows in the corner), list (goes to the history) or count (raises the
# bar's number, which only a listed note can).
fn dt_noteok(what, from, prio) {
	local v=${DT_NOTEAPP["$from"]-} f lv m

	case $what in
	pop) f=${v%% *} ;;
	list) f=${v#* }; f=${f%% *} ;;
	*) f=${v##* } ;;
	esac
	[ "$f" = 1 ] && return 0
	[ "$f" = 0 ] && return 1
	case $what in
	pop) return 0 ;;
	list) m=$DT_NOTELIST ;;
	*) m=$DT_NOTECOUNT ;;
	esac
	lv := dt_notelevel "$prio"
	m := dt_notelevel "$m"
	[ "$lv" -ge "$m" ]
}

# Set one of a sender's three: pop, list or count, to 1, 0 or - (its
# priority decides), and save. A sender whose three are all - is forgotten.
fn dt_noteset(from, what, v) {
	local cur=${DT_NOTEAPP["$from"]:-- - -} p l c

	read -r p l c <<< "$cur"
	case $what in
	pop) p=$v ;;
	list) l=$v ;;
	*) c=$v ;;
	esac
	if [ "$p $l $c" = "- - -" ]; then
		unset DT_NOTEAPP["$from"]
	else
		DT_NOTEAPP["$from"]="$p $l $c"
	fi
	dt_has dt_save && dt_save
	return 0
}

# A priority's place, 1 for low to 4 for urgent; anything else is normal.
fn dt_notelevel(p) {
	case $p in
	low) ret 1 ;;
	high) ret 3 ;;
	urgent) ret 4 ;;
	*) ret 2 ;;
	esac
}

# Append a note's own fields to the queue, shared by dt_note and
# dt_notify -- the only difference between them is whether there is
# anything past the message to keep as an action.
dt_noteq() {
	local id=$DT_NOTE_NEXT n=0 a

	DT_NOTE_NEXT=$((DT_NOTE_NEXT + 1))
	DT_NOTEQ[$id]["prio"]="$1"
	shift
	DT_NOTEQ[$id]["text"]="$1"
	DT_NOTEQ[$id]["from"] := dt_notefrom
	DT_NOTEFROM=
	DT_NOTEQ[$id]["created"] := dt_ms
	shift
	for a in "$@"; do
		DT_NOTEQ[$id]["arg$n"]="$a"
		n=$((n + 1))
	done
	DT_NOTEQ[$id]["argvn"]=$n
	if dt_noteok list "${DT_NOTEQ[$id]["from"]}" "${DT_NOTEQ[$id]["prio"]}"; then
		dt_notehist_add "$id"
	fi
	dt_noteok count "${DT_NOTEQ[$id]["from"]}" "${DT_NOTEQ[$id]["prio"]}" &&
		DT_NOTEUNSEEN=$((DT_NOTEUNSEEN + 1))
	if dt_noteok pop "${DT_NOTEQ[$id]["from"]}" "${DT_NOTEQ[$id]["prio"]}"; then
		DT_NOTEQ_ORDER+=("$id")
	else
		unset DT_NOTEQ["$id"]
	fi
}

# A note, stacked with whatever others are already showing, gone on its
# own after DT_NOTEMS -- inert, the same as this always worked, every
# existing call site untouched by anything dt_notify adds.
fn dt_note(text, ...rest) {
	case "$DT_LANG${#rest[@]}" in 0) ;; *) text := dt_tr "$text" "${rest[@]}" ;; esac
	dt_noteq normal "$text"
}

# A note at a priority of its own: low, normal, high or urgent. Like
# dt_note, a template's %s are filled from what follows the text.
fn dt_notep(prio, text, ...rest) {
	case "$DT_LANG${#rest[@]}" in 0) ;; *) text := dt_tr "$text" "${rest[@]}" ;; esac
	dt_noteq "$prio" "$text"
}

# The clickable form: args after the message are an action -- clicking
# this note, specifically, runs it (and dismisses the note); clicking a
# plain dt_note only dismisses it. Kept as words, not a string handed
# back for the shell to re-split: see DT_OPENCMD's own reasoning, the
# same one word-split "gfeh -g" back to front once building the File
# Types pane.
fn dt_notify(text, ...rest) {
	case $DT_LANG in ?*) text := dt_tr "$text" ;; esac
	dt_noteq normal "$text" "${rest[@]}"
}

# The clickable form at a priority: dt_notifyp prio text action...
fn dt_notifyp(prio, text, ...rest) {
	case $DT_LANG in ?*) text := dt_tr "$text" ;; esac
	dt_noteq "$prio" "$text" "${rest[@]}"
}

# Dismiss every note on screen at once -- what a single DT_NOTE= used to do
# before the queue, and still the right thing when a modal dialog is about
# to take over the screen (dt_confirm) or a keyboard grab hint is done
# with (dt_gkey): there is no one note left to point at by id, so all of
# them go. History is untouched -- this only clears what is showing.
dt_note_clear() {
	local id

	for id in "${DT_NOTEQ_ORDER[@]}"; do
		unset "DT_NOTEQ[$id]"
	done
	DT_NOTEQ_ORDER=()
}

# Copy a note's own text into the history log once it is created, capped
# -- the oldest dropped once it is full -- so "what did I miss" has an
# answer even for one that came and went stacked behind others, not only
# whichever is on screen right now.
fn dt_notehist_add(int id) {
	local hid=$DT_NOTEHIST_NEXT lv min

	DT_NOTEHIST_NEXT=$((DT_NOTEHIST_NEXT + 1))
	DT_NOTEHIST[$hid]["text"]=${DT_NOTEQ[$id]["text"]}
	DT_NOTEHIST[$hid]["prio"]=${DT_NOTEQ[$id]["prio"]:-normal}
	DT_NOTEHIST[$hid]["from"]=${DT_NOTEQ[$id]["from"]:-Desktop}
	DT_NOTEHIST[$hid]["at"] := dt_ms
	DT_NOTEQ[$id]["hid"]=$hid
	dt_notehist_act "$hid" "$id"
	DT_NOTEHIST_ORDER+=("$hid")
	if [ "${#DT_NOTEHIST_ORDER[@]}" -gt "$DT_NOTEHISTMAX" ]; then
		unset "DT_NOTEHIST[${DT_NOTEHIST_ORDER[0]}]"
		DT_NOTEHIST_ORDER=("${DT_NOTEHIST_ORDER[@]:1}")
	fi
}

# A brief toast, not a small window of its own like dt_confirm's: a
# border so it reads as something floating rather than as whatever
# happened to be under it looking wrong, and a timeout so it goes away
# on its own -- it used to have neither, which is what made applying a
# wallpaper from the Wallpaper pane (a window filling most of the
# screen) look like the screen itself had come out wrong rather than
# like a notification, until the next click or key. Several stack at
# once now, DT_NOTEPOS's own corner, newest closest to the corner --
# Growl's own look. Each drawn box's own row/col/h/w goes into
# DT_NOTERECT in the same pass that draws it, so dt_note_hit's own
# point-in-rect test can never drift from what is actually on screen --
# the same discipline dt_confirm_hit/dt_confirm_geom already follow.
# A note's box is laid out by the textfit widget between DT_NOTEWMIN by
# DT_NOTEHMIN and DT_NOTEWMAX by DT_NOTEHMAX, each held to the screen, and
# one that was opened (its mark clicked) may grow to the screen's height.
# A note that was cut, or opened, does not time out: it waits to be
# clicked, or its mark would be gone before anybody could use it.
dt_note_draw() {
	local id now age w h r c t n=0 top bar f used i k ar ac arows acols gx
	local wmin wmax hmin hmax hopen
	local -a keep areas

	now := dt_ms
	for id in "${DT_NOTEQ_ORDER[@]}"; do
		age=$((now - ${DT_NOTEQ[$id]["created"]}))
		if [ -z "${DT_NOTEQ[$id]["cut"]}${DT_NOTEQ[$id]["open"]}" ] &&
		   [ "$age" -ge "$DT_NOTEMS" ]; then
			unset "DT_NOTEQ[$id]"
			continue
		fi
		keep+=("$id")
		[ "$age" -lt "$DT_NOTEMS" ] && dt_want $((DT_NOTEMS - age))
	done
	DT_NOTEQ_ORDER=("${keep[@]}")
	for id in "${!DT_NOTERECT[@]}"; do unset DT_NOTERECT["$id"]; done
	[ "${#DT_NOTEQ_ORDER[@]}" = 0 ] && return 0

	# Where the stack goes: the primary display's rectangle, or every
	# display's, the primary first so the note's cut and open marks are
	# the ones laid out where the bar is.
	areas=("${DT_PRIMARY_ROW:-0} ${DT_PRIMARY_COL:-0} ${DT_PRIMARY_H:-$DT_ROWS} ${DT_PRIMARY_W:-$DT_COLS} 1")
	if [ "$DT_NOTEWHERE" = every ]; then
		for t in "${DT_DISPLAYS[@]}"; do
			read -r ar ac arows acols gx <<< "$t"
			[ "$ar $ac $arows $acols" = "${areas[0]% *}" ] && continue
			areas+=("$ar $ac $arows $acols 0")
		done
	fi
	case $DT_NOTEPOSX in
	*bottom*) top=0 ;;
	*) top=1 ;;
	esac
	k=0
	for t in "${areas[@]}"; do
		read -r ar ac arows acols bar <<< "$t"
		# The primary's first row is the bar's; another display has
		# no bar, so its stack starts at its own top.
		[ "$bar" = 1 ] && bar=1 || bar=0
		wmax=$DT_NOTEWMAX
		[ "$wmax" -gt $((acols - 2)) ] && wmax=$((acols - 2))
		wmin=$DT_NOTEWMIN
		[ "$wmin" -gt "$wmax" ] && wmin=$wmax
		hmax=$DT_NOTEHMAX
		[ "$hmax" -gt $((arows - 2)) ] && hmax=$((arows - 2))
		hmin=$DT_NOTEHMIN
		[ "$hmin" -gt "$hmax" ] && hmin=$hmax
		hopen=$((arows - 2))
		used=0
		for id in "${DT_NOTEQ_ORDER[@]}"; do
			t=${DT_NOTEQ[$id]["text"]}
			f=${DT_NOTEQ[$id]["from"]}
			if [ -n "${DT_NOTEQ[$id]["open"]}" ]; then
				dt_textfit "$t" $((wmin - 4)) $((wmax - 4)) $((hmin - 2)) $((hopen - 2))
			else
				dt_textfit "$t" $((wmin - 4)) $((wmax - 4)) $((hmin - 2)) $((hmax - 2))
			fi
			if [ "$k" = 0 ]; then
				DT_NOTEQ[$id]["cut"]=
				[ "$DT_FITCUT" -gt 0 ] && DT_NOTEQ[$id]["cut"]=1
			fi
			w=$((DT_FITW + 4))
			[ ${#f} -gt $((w - 6)) ] && f="${f:0:$((w - 6))}"
			h=$((2 + DT_FITH))
			case $DT_NOTEPOSX in
			*left*) c=$((ac + 1)) ;;
			*) c=$((ac + acols - w - 1)) ;;
			esac
			# Each note is as tall as its own text, so the next
			# one starts below this one.
			if [ "$top" = 1 ]; then
				r=$((ar + bar + used))
			else
				r=$((ar + arows - used - h))
			fi
			used=$((used + h + 1))
			DT_NOTERECT[$id]["r$k"]=$r
			DT_NOTERECT[$id]["c$k"]=$c
			DT_NOTERECT[$id]["w$k"]=$w
			DT_NOTERECT[$id]["h$k"]=$h
			DT_NOTERECT[$id]["n"]=$((k + 1))
			case ${DT_NOTEQ[$id]["prio"]} in
			urgent) console pen "$DT_BAD" "$DT_FACE" bold ;;
			high) console pen "$DT_WARN" "$DT_FACE" bold ;;
			low) console pen "$DT_DIM" "$DT_FACE" ;;
			*) console pen "$DT_ACTIVE" "$DT_FACE" bold ;;
			esac
			i := dt_rep $((w - 2)) "${GL[hline]}"
			console put "$r" "$c" "${GL[tl]}$i${GL[tr]}"
			console put $((r + h - 1)) "$c" "${GL[bl]}$i${GL[br]}"
			if [ -n "${DT_NOTEQ[$id]["cut"]}" ]; then
				dt_fitmark $((r + h - 1)) "$c" "$w"
			elif [ -n "${DT_NOTEQ[$id]["open"]}" ]; then
				dt_fitmark $((r + h - 1)) "$c" "$w" open
			fi
			console pen "$DT_INK" "$DT_FACE" bold
			[ -n "$f" ] && console put "$r" $((c + 2)) " $f "
			console pen "$DT_INK" "$DT_FACE" bold
			i=0
			while [ "$i" -lt "$DT_FITH" ]; do
				t := str pad "${DT_FITLINES[$i]-}" $((w - 4))
				console put $((r + 1 + i)) "$c" "${GL[vline]} $t ${GL[vline]}"
				i=$((i + 1))
			done
			n=$((n + 1))
		done
		k=$((k + 1))
	done
}

# A point against the currently drawn notification stack -- the id whose
# rectangle contains it, or a miss. Reads DT_NOTERECT, filled by the same
# dt_note_draw pass that drew them.
fn dt_note_hit(int mr, int mc) {
	local id r c w h k

	for id in "${DT_NOTEQ_ORDER[@]}"; do
		k=0
		while [ "$k" -lt "${DT_NOTERECT[$id]["n"]:-0}" ]; do
			r=${DT_NOTERECT[$id]["r$k"]}
			c=${DT_NOTERECT[$id]["c$k"]}
			w=${DT_NOTERECT[$id]["w$k"]}
			h=${DT_NOTERECT[$id]["h$k"]}
			if [ "$mr" -ge "$r" ] && [ "$mr" -lt $((r + h)) ] &&
			   [ "$mc" -ge "$c" ] && [ "$mc" -lt $((c + w)) ]; then
				ret "$id"
				return 0
			fi
			k=$((k + 1))
		done
	done
	return 1
}

# Whether screen row r is the bottom edge of any copy of a note: where
# its cut or open mark is.
fn dt_note_edge(int id, int r) {
	local k=0

	while [ "$k" -lt "${DT_NOTERECT[$id]["n"]:-0}" ]; do
		[ "$r" = $((${DT_NOTERECT[$id]["r$k"]} + ${DT_NOTERECT[$id]["h$k"]} - 1)) ] &&
			return 0
		k=$((k + 1))
	done
	return 1
}

# A press on a note, from dt_mouse once dt_note_hit has named which, at
# screen row r. On the bottom edge of a note that was cut or opened it
# opens or shuts it. Otherwise it waits DT_DBLMS before it acts, because a
# second press in that time is a double click, which opens the note in a
# window of its own (Gitea #227); a single click then does what a click on
# a note always did, from dt_notetick -- after the frame, not inside it.
DT_NOTEDBLID=
DT_NOTEDBLT=0
fn dt_note_click(int id, int? r = "") {
	local now hid

	if [ -n "$r" ] && dt_note_edge "$id" "$r" &&
	   [ -n "${DT_NOTEQ[$id]["cut"]}${DT_NOTEQ[$id]["open"]}" ]; then
		if [ -n "${DT_NOTEQ[$id]["open"]}" ]; then
			DT_NOTEQ[$id]["open"]=
		else
			DT_NOTEQ[$id]["open"]=1
		fi
		DT_NOTEQ[$id]["clicked"]=
		DT_NOTEDBLID=
		return 0
	fi
	now := dt_ms
	if [ "$DT_NOTEDBLID" = "$id" ] && [ $((now - DT_NOTEDBLT)) -lt "$DT_DBLMS" ]; then
		DT_NOTEDBLID=
		hid=${DT_NOTEQ[$id]["hid"]}
		dt_note_drop "$id"
		[ -n "$hid" ] && dt_has notedetail_draw && dt_launch notedetail "$hid"
		return 0
	fi
	DT_NOTEDBLID=$id
	DT_NOTEDBLT=$now
	DT_NOTEQ[$id]["clicked"]=$now
	dt_want "$DT_DBLMS"
}

# Take a note off the screen. Its record in the history stays.
fn dt_note_drop(int id) {
	local o
	local -a keep

	unset "DT_NOTEQ[$id]"
	for o in "${DT_NOTEQ_ORDER[@]}"; do
		[ "$o" != "$id" ] && keep+=("$o")
	done
	DT_NOTEQ_ORDER=("${keep[@]}")
}

# After each frame: a note clicked once, DT_DBLMS ago, with no second click
# since, does what a click on a note does -- runs its action, if it has
# one, and goes either way.
dt_notetick() {
	local id now
	local -a due

	[ "${#DT_NOTEQ_ORDER[@]}" = 0 ] && return 0
	now := dt_ms
	for id in "${DT_NOTEQ_ORDER[@]}"; do
		[ -n "${DT_NOTEQ[$id]["clicked"]-}" ] || continue
		if [ $((now - ${DT_NOTEQ[$id]["clicked"]})) -ge "$DT_DBLMS" ]; then
			due+=("$id")
		else
			dt_want $((DT_DBLMS - (now - ${DT_NOTEQ[$id]["clicked"]})))
		fi
	done
	for id in "${due[@]}"; do
		dt_note_act "$id"
		dt_want 30
	done
	return 0
}
command -v dt_ticker > /dev/null && dt_ticker dt_notetick

# Run a note's own action, if it has one, and take it off the screen
# either way.
fn dt_note_act(int id) {
	local n=${DT_NOTEQ[$id]["argvn"]:-0} i=0 o
	local -a args keep

	while [ "$i" -lt "$n" ]; do
		args+=("${DT_NOTEQ[$id]["arg$i"]}")
		i=$((i + 1))
	done
	unset "DT_NOTEQ[$id]"
	for o in "${DT_NOTEQ_ORDER[@]}"; do
		[ "$o" != "$id" ] && keep+=("$o")
	done
	DT_NOTEQ_ORDER=("${keep[@]}")
	[ "$n" -gt 0 ] && "${args[@]}"
}

# Copy a note's action into its history record. Clicking the *live* note has
# run it since dt_notify was written, and the history kept the words and
# the sender and threw the action away -- so a note that came and went
# behind something else lost the one thing it was for, which is exactly the
# case a history exists for (Gitea #195).
fn dt_notehist_act(int hid, int id) {
	local n=${DT_NOTEQ[$id]["argvn"]:-0}
	local i=0

	DT_NOTEHIST[$hid]["argvn"]=$n
	while [ "$i" -lt "$n" ]; do
		DT_NOTEHIST[$hid]["arg$i"]=${DT_NOTEQ[$id]["arg$i"]}
		i=$((i + 1))
	done
	return 0
}

# What a note's action is called, for a window offering it as a button --
# the first word, which is the command, rather than the whole line.
fn dt_notehist_what(int hid) {
	[ "${DT_NOTEHIST[$hid]["argvn"]:-0}" -gt 0 ] || return 1
	ret "${DT_NOTEHIST[$hid]["arg0"]}"
}

# Run the action a history record kept. Nothing is dismissed: a record is a
# record, where a live note's click takes the note away with it.
fn dt_notehist_run(int hid) {
	local n=${DT_NOTEHIST[$hid]["argvn"]:-0}
	local i=0
	local -a args

	[ "$n" -gt 0 ] || return 1
	while [ "$i" -lt "$n" ]; do
		args+=("${DT_NOTEHIST[$hid]["arg$i"]}")
		i=$((i + 1))
	done
	"${args[@]}"
	return 0
}

# Forget one note from the history.
fn dt_notehist_del(int hid) {
	local o
	local -a keep

	unset "DT_NOTEHIST[$hid]"
	for o in "${DT_NOTEHIST_ORDER[@]}"; do
		[ "$o" != "$hid" ] && keep+=("$o")
	done
	DT_NOTEHIST_ORDER=("${keep[@]}")
}

# Forget every note in the history at a priority up to and including prio
# -- low clears only the low ones, urgent clears them all.
fn dt_notehist_clear(prio) {
	local hid lv max
	local -a keep

	max := dt_notelevel "$prio"
	for hid in "${DT_NOTEHIST_ORDER[@]}"; do
		lv := dt_notelevel "${DT_NOTEHIST[$hid]["prio"]}"
		if [ "$lv" -le "$max" ]; then
			unset "DT_NOTEHIST[$hid]"
		else
			keep+=("$hid")
		fi
	done
	DT_NOTEHIST_ORDER=("${keep[@]}")
	[ "${#keep[@]}" = 0 ] && DT_NOTEUNSEEN=0
	return 0
}

# --- the panel under the bell ------------------------------------------------
#
# A click on the notification icon opens the latest notes in a panel under
# the bar, as the speaker's slider is, rather than a window to move out of
# the way: each row the note's time, who it is from and what it said, newest
# first; a click on one runs what it was for, or opens it to read in full;
# a right click is that sender's own menu -- whether its notes pop up, are
# listed and are counted. The row above them clears the list, the row below
# opens the whole history or Control Panel > Notifications. A right click on
# the icon itself is the same choices as a menu.

# The history ids the panel's rows show, top first, and how far it is
# scrolled.
declare -gA NHP_ROW
NHP_TOP=0

# Open the panel, or close it when it is open.
dt_bellpop() {
	local n=${#DT_NOTEHIST_ORDER[@]} h w=56 c

	h=$n
	[ "$h" -gt 10 ] && h=10
	[ "$h" -lt 1 ] && h=1
	h=$((h + 5))
	c=$((${DT_BARI["bell"]["c"]:-0} + ${DT_BARI["bell"]["w"]:-1} - w))
	NHP_TOP=0
	DT_NOTEUNSEEN=0
	[ "$DT_POP" = nhpop ] || dt_note_clear
	dt_popat bell nhpop "$c" "$h" "$w"
}

fn nhpop_popdraw(int r, int c, int h, int w) {
	local n=${#DT_NOTEHIST_ORDER[@]} vis i hid t f line at

	# The last row is the blank margin dt_popdraw has already filled.
	h=$((h - 1))
	vis=$((h - 4))
	for i in "${!NHP_ROW[@]}"; do unset NHP_ROW["$i"]; done
	console pen "$DT_INK" "$DT_FACE" bold
	t := dt_tr "Notifications"
	console put "$r" $((c + 1)) "$t"
	if [ "$n" -gt 0 ]; then
		console pen "$DT_INK" "$DT_FACE"
		t := dt_tr "Clear All"
		console put "$r" $((c + w - 1 - ${#t})) "$t"
	fi
	console pen "$DT_IDLE" "$DT_FACE"
	t := dt_rep "$w" "${GL[hline]}"
	console put $((r + 1)) "$c" "$t"
	console put $((r + h - 2)) "$c" "$t"
	if [ "$n" = 0 ]; then
		console pen "$DT_DIM" "$DT_FACE"
		t := dt_tr "No notifications"
		console put $((r + 2)) $((c + 2)) "$t"
	fi
	[ "$NHP_TOP" -gt $((n - vis)) ] && NHP_TOP=$((n - vis))
	[ "$NHP_TOP" -lt 0 ] && NHP_TOP=0
	i=0
	while [ "$i" -lt "$vis" ]; do
		hid := dt_nhat $((NHP_TOP + i)) || break
		NHP_ROW[$i]=$hid
		at=${DT_NOTEHIST[$hid]["at"]:-0}
		printf -v t "%(%H:%M)T" $((at / 1000))
		f=${DT_NOTEHIST[$hid]["from"]:-Desktop}
		f := dt_cut "$f" 12
		line="$t $f  ${DT_NOTEHIST[$hid]["text"]}"
		line=${line//$'\n'/ }
		line := dt_cut "$line" $((w - 2))
		case ${DT_NOTEHIST[$hid]["prio"]} in
		low) console pen "$DT_DIM" "$DT_FACE" ;;
		high | urgent) console pen "$DT_WARN" "$DT_FACE" ;;
		*) console pen "$DT_INK" "$DT_FACE" ;;
		esac
		console put $((r + 2 + i)) $((c + 1)) "$line"
		i=$((i + 1))
	done
	console pen "$DT_INK" "$DT_FACE"
	t := dt_tr "Show All%s" "${GL[ellipsis]}"
	console put $((r + h - 1)) $((c + 1)) "$t"
	t := dt_tr "Settings%s" "${GL[ellipsis]}"
	console put $((r + h - 1)) $((c + w - 1 - ${#t})) "$t"
}

# The history id at list position i, newest first -- the Notifications
# app's own nh_at, for a desktop that does not have that app.
fn dt_nhat(int i) {
	local n=${#DT_NOTEHIST_ORDER[@]}

	[ "$i" -ge 0 ] && [ "$i" -lt "$n" ] || return 1
	ret "${DT_NOTEHIST_ORDER[$((n - 1 - i))]}"
}

fn nhpop_popmouse(act, int r, int c) {
	local hid=${NHP_ROW[$((r - 2))]-} n=${#DT_NOTEHIST_ORDER[@]}

	case $act in
	up) [ "$NHP_TOP" -gt 0 ] && NHP_TOP=$((NHP_TOP - 1)); return 0 ;;
	down) NHP_TOP=$((NHP_TOP + 1)); return 0 ;;
	rpress)
		[ -n "$hid" ] || return 0
		dt_popclose
		dt_context_open nhrow "$hid" $((DT_POPR + r)) $((DT_POPC + c))
		return 0
		;;
	press) ;;
	*) return 0 ;;
	esac
	if [ "$r" = 0 ]; then
		[ "$c" -ge $((DT_POPW / 2)) ] && [ "$n" -gt 0 ] &&
			dt_notehist_clear urgent
		return 0
	fi
	if [ "$r" = $((DT_POPH - 2)) ]; then
		dt_popclose
		if [ "$c" -lt $((DT_POPW / 2)) ]; then
			dt_has notifications_draw && dt_launch notifications
		else
			dt_panelpane notify
		fi
		return 0
	fi
	[ -n "$hid" ] || return 0
	dt_popclose
	if [ "${DT_NOTEHIST[$hid]["argvn"]:-0}" -gt 0 ]; then
		dt_notehist_run "$hid"
	elif dt_has notedetail_draw; then
		dt_launch notedetail "$hid"
	fi
	return 0
}

fn nhpop_popkey(key) {
	case $key in
	escape) dt_popclose ;;
	*) return 1 ;;
	esac
	return 0
}

# One sender's three choices as ticked rows: each turns its own on or off
# outright, and Reset gives them back to the priorities.
fn dt_notemenu(from, prio = "normal") {
	local v=${DT_NOTEAPP["$from"]:-- - -} p l c on

	read -r p l c <<< "$v"
	on=0
	if [ "$p" = 1 ] || { [ "$p" = - ] && dt_noteok pop "$from" "$prio"; }; then on=1; fi
	dt_mark "Pop Up" p "$on" dt_noteset "$from" pop $((1 - on))
	on=0
	if [ "$l" = 1 ] || { [ "$l" = - ] && dt_noteok list "$from" "$prio"; }; then on=1; fi
	dt_mark "Keep in the List" k "$on" dt_noteset "$from" list $((1 - on))
	on=0
	if [ "$c" = 1 ] || { [ "$c" = - ] && dt_noteok count "$from" "$prio"; }; then on=1; fi
	dt_mark "Count on the Bar" c "$on" dt_noteset "$from" count $((1 - on))
	if [ "$v" != "- - -" ]; then
		dt_item "As Its Priority Says" r dt_notereset "$from"
	fi
}

fn dt_notereset(from) {
	unset DT_NOTEAPP["$from"]
	dt_has dt_save && dt_save
	return 0
}

# The menu on a note's row in the panel: what its sender's notes do.
fn nhrow_context(int hid) {
	local f=${DT_NOTEHIST[$hid]["from"]:-Desktop}

	dt_menu "$f"
	dt_notemenu "$f" "${DT_NOTEHIST[$hid]["prio"]:-normal}"
	dt_sep
	dt_item "Remove This Note" d dt_notehist_del "$hid"
}

# The menu on the notification icon.
fn nhbell_context(id = "") {
	dt_menu "Notifications"
	dt_item "Show Notifications" s dt_bellpop
	dt_item "Clear All" c dt_notehist_clear urgent
	dt_sep
	dt_item "Notification Settings${GL[ellipsis]}" n dt_panelpane notify
}
