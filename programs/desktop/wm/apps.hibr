# wm/apps -- applications: registering them, finding them in their folders,
# listing them and launching them.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Globals the functions below share, declared here so strict vars knows
# they are meant to be.
DT_APPDIR_CUR=
# The file being sourced by one of the loaders, so whatever it registers
# -- an app, a pane, a strip module -- remembers which file it came from,
# and a rescan can take back everything a file registered once the file
# has gone. One file may register several: Mail its compose window, the
# Date & Time pane two dialogs.
DT_LOADING=

# What runs once when the desktop starts, after any restart has put its
# windows back: an app registers a function of its own with dt_atstart
# (Stickies opens its notes), and dt_run calls each one before its first
# frame.
DT_ATSTART=()
fn dt_atstart(f) {
	DT_ATSTART+=("$f")
}

dt_runatstart() {
	local f

	for f in "${DT_ATSTART[@]}"; do
		dt_has "$f" && "$f"
	done
	DT_ATSTART=()
}

# Register an app the hibr menu can open: name, title, height, width.
fn dt_app(name, title, int h, int w, once = "", icon = "", fixed = "", hidden = "", bare = "") {
	# The plan and the built menus both describe the app list, so both go
	# when the registry changes. Apps register before the first frame, so
	# this costs nothing at run time; it is here so that one registering
	# later cannot be missing from a shut bar.
	DT_APPPLANK=
	DT_MENUIN=
	DT_APPS[$name]["title"]="$title"
	DT_APPS[$name]["h"]="$h"
	DT_APPS[$name]["w"]="$w"
	DT_APPS[$name]["once"]=
	[ "$once" = once ] && DT_APPS[$name]["once"]=1
	DT_APPS[$name]["icon"]="${icon:-◆}"
	DT_APPS[$name]["fixed"]=
	[ "$fixed" = fixed ] && DT_APPS[$name]["fixed"]=1
	# hidden is for an app dt_launch has to find by name -- About This
	# Computer,
	# or a window like Rename/Get Info that only ever opens on a specific
	# file, never generically -- but that must never appear as a choice
	# of its own on the hibr menu or in App Shortcuts' list of apps to
	# give a global key. dt_appmenu and dt_appnames both read it; neither
	# hardcodes a name the way dt_appmenu once hardcoded "about".
	DT_APPS[$name]["hidden"]=
	[ "$hidden" = hidden ] && DT_APPS[$name]["hidden"]=1
	# bare: no frame, no shadow, no title bar -- a strip across the top in
	# a darker shade of the window's own colour (DT[$id]["bg"], which the
	# app sets), with a close box on it, and a grow mark in the corner. A
	# sticky note is one.
	DT_APPS[$name]["bare"]=
	[ "$bare" = bare ] && DT_APPS[$name]["bare"]=1
	# Set by dt_apps while it sources this file, from where it found it --
	# empty for one sourced any other way, which stays a flat item.
	DT_APPS[$name]["dir"]="$DT_APPDIR_CUR"
	DT_APPS[$name]["src"]="$DT_LOADING"
}

# An entry on the hibr menu that opens another app with an argument (Gitea
# #291): each program X Screen keeps is one, in its folder, opening an X
# Screen window for that program. It takes the size, icon and fixedness of
# the app it opens, is never `once`, and its source is that app's file, so
# a rescan takes it off and puts it back with that file. The app that
# registers these registers them again whenever its list changes, since
# they come from data rather than from a file of their own.
fn dt_appvia(name, title, via, arg = "", dir = "") {
	[ -n "${DT_APPS[$via]["title"]}" ] || return 1
	DT_APPPLANK=
	DT_MENUIN=
	DT_APPS[$name]["title"]="$title"
	DT_APPS[$name]["h"]=${DT_APPS[$via]["h"]}
	DT_APPS[$name]["w"]=${DT_APPS[$via]["w"]}
	DT_APPS[$name]["once"]=
	DT_APPS[$name]["icon"]=${DT_APPS[$via]["icon"]}
	DT_APPS[$name]["fixed"]=${DT_APPS[$via]["fixed"]}
	DT_APPS[$name]["hidden"]=
	DT_APPS[$name]["bare"]=
	DT_APPS[$name]["dir"]="$dir"
	DT_APPS[$name]["src"]=${DT_APPS[$via]["src"]}
	DT_APPS[$name]["via"]="$via"
	DT_APPS[$name]["arg"]="$arg"
	return 0
}

# Take every such entry that opens via off the menu.
fn dt_appunvia(via) {
	local n

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["via"]}" = "$via" ] && unset DT_APPS["$n"]
	done
	DT_APPPLANK=
	DT_MENUIN=
	return 0
}

# Where apps are found: every .hibr in each of these, at any depth, in this
# order.  The user's own folder comes first, so a file there replaces a
# bundled app of the same name; a session adds its own folders after.
# Config first, then data, and the order is the whole point (ADR 0041): the
# first list entry to claim a name wins, by the DT_SRC check below. Config is
# what a person wrote and would back up; data is what `catalogue install` placed
# and can fetch again. So ~/.config/hibr/apps/calc.hibr shadows a fetched
# calc, which is how patching an installed app works -- copy it to your own
# folder and edit it there -- and why an update cannot overwrite your copy.
dt_appsys=
command -v dt_sysdir > /dev/null && dt_appsys := dt_sysdir apps
# The machine's scope sits **above** the person's own: an app an
# administrator installed for everybody is authoritative and a user
# does not override it (ADR 0045). Only ~/.config, which is a file
# somebody wrote by hand rather than anything a catalogue placed,
# is read before it. Empty on a hibr with no system scope, and a
# scan already skips a folder that is not there.
DT_APPDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps"
	${dt_appsys:+"$dt_appsys"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/apps")
declare -gA DT_SRC

# Load every app in the folders.  Each file declares itself with dt_app, so
# the folder is the whole configuration: drop a script in, in a subfolder of
# your own if you like, and it is on the menu at the next start or the next
# rescan (dt_rescan, below) -- globstar
# is always on, which is what makes ** reach into them. A file whose name
# was already loaded from an earlier folder is skipped. An app in a
# subfolder gets a submenu of its own on the hibr menu, named after it --
# DT_APPDIR_CUR is the folder dt_app reads to know where an app is listed,
# and it is **data rather than a path**: dt_appplan turns a folder into a
# submenu and recurses on `prefix/child`, so what an app says here is the
# whole of where it appears. Everything under DT_APPDIRS is an application
# and lives under one submenu of that name -- a file at the top of the root
# says `Applications`, one in `Office/` says `Applications/Office` -- which
# is why the menu needed no new mechanism for the split, only a different
# answer to this one question.
# The libraries several apps share, loaded by the desktop rather than by
# the apps, and only ever from the shipped desktop's own lib/.
#
# An app used to find its own: `. "${BASH_SOURCE%/*}/../lib/pim.hibr"`,
# right in the shipped tree, where apps/ and lib/ are siblings, and wrong
# in all three other scopes (ADR 0045). A catalogue install puts the app
# in `$XDG_DATA_HOME/hibr/apps/` with no lib/ beside it, and the user scope
# is read *before* the shipped copy -- so installing Calendar replaced a
# working app with one that could not load, and the desktop came up on
# `source: .../apps/../lib/pim.hibr: No such file or directory`
# (Gitea #262).
#
# A library is not a kind and has one home. Searching the scopes for it
# would let a stray copy in a person's own folder shadow the package's,
# which is the drift this exists to prevent. Loading it here also repairs
# every install already out there without touching a file: each app's own
# source is guarded on the library's *_LIBDONE, so once it is set here
# that line -- the wrong path in an old copy -- is never reached.
#
# Which files are libraries is read from the files, not from a list kept
# here: a library sets its own *_LIBDONE=1 on a line of its own. lib/
# also holds programs the apps run as jobs -- mailsync, pimsync, mailtest,
# ctl -- which act the moment they are read and must never be sourced, and
# carry no such line.
#
# Read in the shell rather than with grep, which would be a fork per file
# on every start; and the source happens after the read loop, never inside
# it, or the library would run with its own file as standard input.
dt_libs() {
	local f l lib

	for f in "$DT_HERE"/lib/*.hibr; do
		[ -r "$f" ] || continue
		lib=
		while IFS= read -r l; do
			case $l in [A-Z]*_LIBDONE=1) lib=1; break ;; esac
		done < "$f"
		[ -n "$lib" ] && . "$f"
	done
	return 0
}

dt_apps() {
	dt_libs
	dt_scanstamp
	dt_appscan
}

# The scan itself, which a rescan runs again without the libraries: a
# file already in DT_SRC is skipped, so a second pass sources only what
# has arrived since.
dt_appscan() {
	local d f b rel

	for d in "${DT_APPDIRS[@]}"; do
		for f in "$d"/**/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			rel=${f#"$d"/}
			case $rel in
			*/*) DT_APPDIR_CUR="Applications/${rel%/*}" ;;
			*) DT_APPDIR_CUR="Applications" ;;
			esac
			DT_LOADING=$f
			. "$f"
			DT_LOADING=
		done
	done
	DT_APPDIR_CUR=
}

# A system app is one that manages or reports on the desktop, the machine
# or the session -- it would make no sense without this desktop. Those are
# ordinary apps, registered with dt_app exactly like any other, and the
# only thing that makes them the desktop's own is that they say **no
# folder** at all: an app with an empty DT_APPDIR_CUR is listed on the hibr
# menu itself, beside About This Computer, rather than inside Applications.
# That is the whole of the demarcation, and it is one line per app rather
# than a mechanism each has to know about.
#
# A flat scan, not dt_apps' recursive one: the desktop's own menu is one
# list, and a folder of system apps would be a category inside a category.
dt_syssys=
command -v dt_sysdir > /dev/null && dt_syssys := dt_sysdir system
# The machine's scope sits **above** the person's own: an app an
# administrator installed for everybody is authoritative and a user
# does not override it (ADR 0045). Only ~/.config, which is a file
# somebody wrote by hand rather than anything a catalogue placed,
# is read before it. Empty on a hibr with no system scope, and a
# scan already skips a folder that is not there.
DT_SYSDIRS=("${XDG_CONFIG_HOME:-$HOME/.config}/hibr/system"
	${dt_syssys:+"$dt_syssys"}
	"${XDG_DATA_HOME:-$HOME/.local/share}/hibr/system")

dt_sysapps() {
	local d f b

	for d in "${DT_SYSDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${DT_SRC["$b"]}" ] && continue
			DT_SRC["$b"]=$f
			DT_APPDIR_CUR=
			DT_LOADING=$f
			. "$f"
			DT_LOADING=
		done
	done
	DT_APPDIR_CUR=
	# Someone's own accessories used to be scanned from a folder that no
	# longer is, and a file quietly missing from a menu is worse than a
	# line in the log saying where it went -- once, not on every rescan.
	d="${XDG_CONFIG_HOME:-$HOME/.config}/hibr/desk-accessories"
	if [ -z "$DT_RESCANS" ] && [ -d "$d" ]; then
		dt_log "$d is no longer scanned -- move its files to ${XDG_CONFIG_HOME:-$HOME/.config}/hibr/apps/Accessories"
	fi
	return 0
}

# --- what is installed while the desktop runs (Gitea #267) ----------------
#
# The loaders above read their folders once, at the start, so something the
# catalogue placed afterwards was not on any menu until Restart Desktop --
# and the tour had to say so. dt_rescan reads the folders again, and is
# told to rather than looking: the control socket's `rescan`, which
# `catalogue` sends after any verb that changed a file; the Catalogue
# window, after its own job; and Refresh Desktop, which is what covers a
# file somebody put in a folder by hand. Nothing polls, because an idle
# desktop's budget is a hundredth of a core and a rescan is a few hundred
# globs. The Catalogue window and the command it runs both ask, for one
# install: the second finds nothing new and costs a scan, which is cheaper
# than either of them having to know about the other.
#
# What a rescan does with each name:
#
# - **New**: sourced, by the loaders themselves, which already skip every
#   file they have loaded.
# - **Gone**, with no copy left in any scope: everything its file
#   registered is taken off the menus, and kept. Its functions stay
#   defined, so a window that is open keeps working; launching it again
#   says it is not installed.
# - **Changed** -- a newer file at the same path, a copy in another scope
#   now winning the name, or a name that went and has come back: **not
#   sourced again.** Apps run code at the top of their file that resets
#   their state (`PE_N=0`, `PE_HITS=()`, `SNAKE_BEST=0`) and register hooks
#   (`pe_onsync pe_reload`), so swapping one under its open windows, its
#   tickers or a sync in flight is not safe -- and a desktop file is
#   `strict`, which refuses a second definition of a function from the same
#   file outright. It is a state instead: the bar's reload mark, which
#   Restart Desktop clears by construction, and a note naming what changed.
#   A name that comes back gets the registration it went with, so it is on
#   the menu again at once, running what was loaded.
#
# "Newer" is against a stamp file rotated by each rescan -- `-nt` compares
# to the nanosecond and costs no fork. It is per session, in the state
# folder, so two desktops never move each other's.
DT_SCANSTAMP=
DT_SCANPREV=
DT_RESCANS=
DT_UPAPPS=
DT_STALENEW=()
declare -gA DT_STALE
# What a gone file had registered, by app name, and the path each name's
# file was loaded from, so a file of that name coming back is given its
# registration again rather than sourced a second time.
declare -gA DT_GONE
declare -gA DT_GONEB

# Note when the desktop read its folders, the first time it does.
dt_scanstamp() {
	local d

	[ -n "$DT_SCANSTAMP" ] && return 0
	d=${DT_LOG%/*}
	DT_SCANSTAMP="$d/scan-${HIBR_HOLD##*/}"
	[ -n "${HIBR_HOLD-}" ] || DT_SCANSTAMP="$d/scan-desktop"
	mkdir -p "$d" 2> /dev/null
	: > "$DT_SCANSTAMP" 2> /dev/null || DT_SCANSTAMP=-
	return 0
}

# Whether a file loaded at the last scan has been written since.
fn dt_scanold(f) {
	[ -n "$DT_SCANPREV" ] && [ "$f" -nt "$DT_SCANPREV" ]
}

# A loaded file that changed: shown, never sourced again (see above).
fn dt_stale(f, title = "") {
	[ -n "${DT_STALE["$f"]+x}" ] && return 0
	DT_STALE["$f"]=$title
	DT_UPAPPS=1
	DT_MENUIN=
	[ -n "$title" ] && DT_STALENEW+=("$title")
	return 0
}

# The titles of what a file registered, for a note.
fn dt_srctitles(f) {
	local n t=

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["src"]}" = "$f" ] || continue
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		t="$t${t:+, }${DT_APPS[$n]["title"]}"
	done
	ret "$t"
}

# Take off the menus every app a file registered, keeping what each said.
# A pane or a strip module it registered is the panel's and the strip's to
# take back.
fn dt_unload(f) {
	local n k

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["src"]}" = "$f" ] || continue
		for k in "${!DT_APPS[$n][@]}"; do
			DT_GONE[$n]["$k"]=${DT_APPS[$n]["$k"]}
		done
		unset DT_APPS["$n"]
	done
	DT_APPPLANK=
	DT_MENUIN=
	return 0
}

# Put back what dt_unload kept for a file, the reverse of it.
fn dt_reinstate(f) {
	local n k

	for n in "${!DT_GONE[@]}"; do
		[ "${DT_GONE[$n]["src"]}" = "$f" ] || continue
		for k in "${!DT_GONE[$n][@]}"; do
			DT_APPS[$n]["$k"]=${DT_GONE[$n]["$k"]}
		done
		unset DT_GONE["$n"]
	done
	DT_APPPLANK=
	DT_MENUIN=
	return 0
}

# Read every folder again. Answers how many names arrived, went and
# changed, as "added removed changed", for the control socket to report.
dt_rescan() {
	local d f b w before added gone=0 changed=0 t
	local -A win

	DT_RESCANS=$((DT_RESCANS + 1))
	DT_STALENEW=()
	dt_scanstamp
	DT_SCANPREV=
	if [ "$DT_SCANSTAMP" != - ]; then
		if [ -e "$DT_SCANSTAMP" ] && mv -f "$DT_SCANSTAMP" "$DT_SCANSTAMP.prev" 2> /dev/null; then
			DT_SCANPREV=$DT_SCANSTAMP.prev
		fi
		: > "$DT_SCANSTAMP" 2> /dev/null
	fi
	# Who wins each name now, in the order the loaders claim them:
	# applications, at any depth, then the desktop's own, flat.
	for d in "${DT_APPDIRS[@]}"; do
		for f in "$d"/**/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${win["$b"]}" ] || win["$b"]=$f
		done
	done
	for d in "${DT_SYSDIRS[@]}"; do
		for f in "$d"/*.hibr; do
			[ -r "$f" ] || continue
			b=${f##*/}
			b=${b%.hibr}
			[ -n "${win["$b"]}" ] || win["$b"]=$f
		done
	done
	for b in "${!DT_SRC[@]}"; do
		f=${DT_SRC["$b"]}
		w=${win["$b"]}
		if [ -z "$w" ]; then
			dt_unload "$f"
			DT_GONEB["$b"]=$f
			unset DT_SRC["$b"]
			gone=$((gone + 1))
		elif [ "$w" != "$f" ] || dt_scanold "$f"; then
			if [ -z "${DT_STALE["$f"]+x}" ]; then
				t := dt_srctitles "$f"
				dt_stale "$f" "${t:-$b}"
				changed=$((changed + 1))
			fi
		fi
	done
	# A name that went and is back: its registration again, and the mark,
	# rather than the loaders sourcing it a second time.
	for b in "${!win[@]}"; do
		[ -z "${DT_SRC["$b"]}" ] && [ -n "${DT_GONEB["$b"]}" ] || continue
		f=${DT_GONEB["$b"]}
		unset DT_GONEB["$b"]
		DT_SRC["$b"]=$f
		dt_reinstate "$f"
		t := dt_srctitles "$f"
		dt_stale "$f" "${t:-$b}"
		changed=$((changed + 1))
	done
	before=${#DT_SRC[@]}
	dt_appscan
	dt_sysapps
	added=$((${#DT_SRC[@]} - before))
	# The Control Panel's panes and the Control Strip's modules, each read
	# by its own owner, which answers the same three counts.
	if dt_has cp_rescan; then
		cp_rescan
		read -r d f w <<< "$RET"
		added=$((added + d)); gone=$((gone + f)); changed=$((changed + w))
	fi
	if dt_has cs_rescan; then
		cs_rescan
		read -r d f w <<< "$RET"
		added=$((added + d)); gone=$((gone + f)); changed=$((changed + w))
	fi
	# Savers are read when one is first wanted, so the next one wanted
	# reads them again; themes and colour schemes are lists Appearance
	# keeps, and languages are read each time the list is shown.
	[ -z "$DT_SAVING" ] && DT_SAVERREADY=
	dt_has cp_themes && cp_themes
	dt_has cp_colourlist && cp_colourlist
	DT_APPPLANK=
	DT_MENUIN=
	if [ "${#DT_STALENEW[@]}" -gt 0 ]; then
		t=
		for w in "${DT_STALENEW[@]}"; do t="$t${t:+, }$w"; done
		dt_notep normal "%s was updated: Restart Desktop to use the new version" "$t"
	fi
	dt_changed
	ret "$added $gone $changed"
}

# Every registered app, sorted by title without regard to case, as names --
# for anything that wants every app in one flat list rather than the hibr
# menu's own folder-grouped one below (Settings' App Shortcuts rows do).
dt_appnames() {
	local n l out=
	local -a all

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		l := str lower "${DT_APPS[$n]["title"]}"
		all+=("$l	$n")
	done
	arr sort all
	for l in "${all[@]}"; do out="$out ${l#*	}"; done
	ret "${out# }"
}

# Add one folder level's worth of the hibr menu: apps stored directly in
# it as items, each immediate child folder as a submenu built the same way,
# recursing to any depth -- prefix is that folder's own path, "" for the
# top. reserved is letters the *caller's* menu has already used, since a
# submenu is its own menu with its own letters otherwise: About This
# Computer, Quit
# and the rest only need keeping clear of at the top.
# The flattened hibr-menu app list, and what it was built for: the plan is
# a list of tab-separated operations -- "sub NAME", "end", "item PATH TITLE
# KEY" -- replayed onto the menu being built.
DT_APPPLAN=()
DT_APPPLANK=

# Work out that plan: walk the registry, lowercase each name to sort by,
# sort, and give each app the first free accelerator letter. All of which
# depends on nothing that changes while a desktop runs -- which is the point
# of keeping it, since dt_menus rebuilds every menu whenever anything at all
# is typed, and for twenty-six apps this was 2.9 ms of every keystroke, a
# quarter of the whole frame, to produce the same list again (Gitea #109).
# An empty accelerator is last in each row: a tab is IFS whitespace, so an
# empty field anywhere before the end would collapse and shift the rest.
fn dt_appplan(prefix, used = "") {
	local n d l child path kind discard k
	local -a all seen

	for n in "${!DT_APPS[@]}"; do
		[ "${DT_APPS[$n]["hidden"]}" = 1 ] && continue
		d=${DT_APPS[$n]["dir"]}
		if [ "$d" = "$prefix" ]; then
			l := str lower "${DT_APPS[$n]["title"]}"
			all+=("$l	a	$n")
			continue
		fi
		if [ -n "$prefix" ]; then
			case $d in "$prefix"/*) ;; *) continue ;; esac
			child=${d#"$prefix"/}
		else
			[ -z "$d" ] && continue
			child=$d
		fi
		child=${child%%/*}
		case " ${seen[*]-} " in *" $child "*) continue ;; esac
		seen+=("$child")
		l := str lower "$child"
		if [ -n "$prefix" ]; then
			all+=("$l	f	$prefix/$child")
		else
			all+=("$l	f	$child")
		fi
	done
	[ "${#all[@]}" -eq 0 ] && return 0
	arr sort all
	for l in "${all[@]}"; do
		IFS=$'\t' read -r discard kind path <<< "$l"
		if [ "$kind" = f ]; then
			k := dt_akey "${path##*/}" "$used"
			used="$used$k"
			DT_APPPLAN+=("sub	${path##*/}	$k")
			dt_appplan "$path"
			DT_APPPLAN+=("end")
		else
			k := dt_akey "${DT_APPS[$path]["title"]}" "$used"
			used="$used$k"
			DT_APPPLAN+=("item	$path	${DT_APPS[$path]["title"]}	$k")
		fi
	done
	return 0
}

fn dt_appmenu(prefix, used = "") {
	local op
	local -a f

	if [ "$DT_APPPLANK" != "$prefix|$used" ]; then
		DT_APPPLAN=()
		dt_appplan "$prefix" "$used"
		DT_APPPLANK="$prefix|$used"
	fi
	for op in "${DT_APPPLAN[@]}"; do
		IFS=$'\t' read -ra f <<< "$op"
		case ${f[0]} in
		sub) dt_sub "${f[1]}" "${f[2]-}" ;;
		end) dt_end ;;
		item) dt_item "${f[2]}" "${f[3]-}" dt_launch "${f[1]}" ;;
		esac
	done
	return 0
}

# The window already showing an app, if there is one.
fn dt_appwin(app) {
	local id

	for id in "${!DT[@]}"; do
		if [ "${DT[$id]["app"]}" = "$app" ]; then
			ret "$id"
			return 0
		fi
	done
	return 1
}

# Open a registered app in a fresh window, where dt_place puts it -- in the
# first free spot, by default. An app may say how big it wants to be at
# the moment it opens with <app>_size, answering "h w" (the terminal's
# depends on a setting); otherwise its dt_app size. An app declared `once`
# has one window at most: launching it again brings that one forward,
# shown if it was hidden.  Anything after the name goes to its _open.
# Whether another installed thing is here, for a caller about to use one
# of its functions -- and when it is not, the same message dt_launch
# gives, so a person learns what to fetch rather than seeing nothing.
#
# An installable may call the platform freely and another installable
# only behind a check like this one, in the same function (Gitea #262):
# that is what keeps every link between two apps an optional integration
# rather than a dependency nothing resolves, and tests/deps.py fails a
# call that has none. `dt_has` is the quiet form, for an integration
# that simply does less when the other side is absent.
fn dt_needs(app, f) {
	dt_has "$f" && return 0
	dt_notep high "%s is not installed. Find it in the Catalogue." "$app"
	return 1
}

fn dt_launch(n, arg = "") {
	local h w sz id pl r c

	# An app that is not here. Since 0.99.194 the package ships none,
	# so this is the ordinary state of a fresh desktop rather than a
	# corner -- and the window manager itself names **ten** apps by
	# `dt_launch`, four of which are fetched: `term` at nine call
	# sites, `files` at seven, `vault` and `imgview` at one each. A
	# bare desktop therefore had a Home icon that did nothing when
	# double-clicked, a trash that did nothing, a New Terminal on the
	# wallpaper's own menu that did nothing, and a file that opened
	# nowhere -- no window, no message, nothing in the log, because
	# this returned 1 and every one of those callers ignores it
	# (Gitea #233).
	#
	# Saying so here rather than at each of them is the point: the
	# list of places that launch something is exactly the list nobody
	# can be relied on to keep. A caller that has already checked
	# (`dt_has <app>_draw && dt_launch ...`, which the clipboard, the
	# notifications and the clock all do) never reaches this.
	if [ -z "${DT_APPS[$n]["title"]}" ]; then
		dt_notep high "%s is not installed. Find it in the Catalogue." "$n"
		return 1
	fi
	# An entry that opens another app with an argument (dt_appvia): a
	# window of that app, titled for the entry.
	if [ -n "${DT_APPS[$n]["via"]}" ]; then
		h=${DT_APPS[$n]["h"]}
		w=${DT_APPS[$n]["w"]}
		pl := dt_place "$h" "$w"
		read -r r c h w <<< "$pl"
		dt_new "${DT_APPS[$n]["title"]}" "$h" "$w" "$r" "$c" \
			"${DT_APPS[$n]["via"]}" "${arg:-${DT_APPS[$n]["arg"]}}"
		return
	fi
	# An app that does something rather than showing a window -- the
	# Screenshot desk accessory -- gives <app>_launch, and that is all.
	if dt_has "${n}_launch"; then
		"${n}_launch" "$arg"
		return 0
	fi
	if [ -n "${DT_APPS[$n]["once"]}" ] && id := dt_appwin "$n"; then
		dt_raise "$id"
		ret "$id"
		return 0
	fi
	h=${DT_APPS[$n]["h"]}
	w=${DT_APPS[$n]["w"]}
	if dt_has "${n}_size" && sz := "${n}_size"; then
		h=${sz% *}
		w=${sz#* }
	fi
	pl := dt_place "$h" "$w"
	read -r r c h w <<< "$pl"
	dt_new "${DT_APPS[$n]["title"]}" "$h" "$w" "$r" "$c" "$n" "$arg"
}

# The about app shows the machine's own numbers, live; without it (a session
# that never called dt_apps, or one that dropped the file) a note still says
# what this is, since About This Computer must never be a dead menu item.
dt_about() {
	dt_has about_draw && { dt_launch about; return 0; }
	dt_notep low "hibr %s — a desktop written in the shell it runs on" "$HIBR_VERSION"
}
