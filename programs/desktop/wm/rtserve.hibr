# wm/rtserve -- the desktop's end of the app runtime's socket (ADR 0050):
# where an app's own process connects, says hello, and sends what it asks
# of the desktop. Listening starts when the first app process is about to
# be started, never at load: an idle desktop with none pays nothing, which
# tests/999-idle-tickers.t holds. A process speaking another protocol or
# another hibr version is refused and the person told hibr was updated,
# with Restart Desktop one click away (owner, 2026-11-18): nothing runs half
# old and half new. Only a told request named in interface.tsv is carried;
# anything else is refused by name in the log. Every answer goes out through
# dt_rtsay, send -p, which writes what the app takes now and keeps the rest
# for it, offered again every pass: a plain send to an app that had stopped
# reading waited until the app went (7.7 s, measured), the whole desktop
# stopped behind it; and an app that never reads again is let go once
# DT_RTQMAX waits for it. The guards are
# against an app's bugs and against blaming the wrong app, not a sandbox -- containment
# is not a goal (ADR 0050): only the desktop's own user connects, a hello
# names an installed app, an app makes only the requests its own file
# makes, and a request naming a window names one of the app's own.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The socket app processes reach, its descriptor, and every connection by
# descriptor: the app it said it was, or - before its hello.
DT_RTPATH=
DT_RTLFD=
declare -gA DT_RTC
# The launches the desktop has made and not yet heard from, token -> app:
# a hello names its launch by the token the process was started with, and
# the app is the launch's, never what the hello says of itself -- the point
# being blame, not a lock. Each connection's launch, both ways, so a tell
# reaches that one process and not the first of its name.
declare -gA DT_RTLAUNCH DT_RTCTOK DT_RTTOKC
# Each request connection's cells channel and back (wm/rtview.hibr), the
# one-time tokens a hello's ok gave for one, by token, and each
# connection's process, kept past its hello so one left with no window can
# be ended.
declare -gA DT_RTCELLS DT_RTCELLC DT_RTCELLTOK DT_RTCPID
# The apps with a connection, with how many: a frame asks one lookup
# whether any process is to be told of a window. And the last change the
# variable table reported (varwatch seq), so a pass with nothing changed
# costs one comparison.
declare -gA DT_RTAPPS
DT_RTSEQ=
# Each shared name's whole line, kept once made and dropped when it changes.
declare -gA DT_RTLINE
# Set once the varwatch module is loaded, so a pass asks it with no
# redirection: one opening /dev/null every pass took an idle pass from 8
# us to 17, measured.
DT_RTWATCH=
# The file each connection's launch named, as the kind folder sees it: who
# it is sent what (dt_rtwants).
declare -gA DT_RTCFILE
# The zygote (ADR 0050): the one prepared host every app process is forked
# from, its process and the desktop's end of its channel, and whether it has
# said it speaks this desktop's protocol and version. App processes are its
# children, not the desktop's, so how each ended is what it says (exit), kept
# by pid until read; and each launch's channel for its terminals' programs,
# which the desktop owns and serves (mods/pty), by descriptor, naming the app.
DT_RTZPID=
DT_RTZFD=
DT_RTZOK=
declare -gA DT_RTEXIT DT_RTPTYC
# The files whose times say when the zygote started and when each launch's
# process read its app's file (dt_rtcurrent), by launch and then by
# connection.
DT_RTZSTAMP=
declare -gA DT_RTLSTAMP DT_RTCSTAMP
# The launches a restart kept a process under (wm/restart.hibr): one that
# never joins is taken for a process that crashed (dt_rvlost).
declare -gA DT_RTLKEPT
# Set while the desktop owns any terminal's program, so a pass with none
# asks the pty module nothing; and when one may have been left held by no
# app process whose window has gone -- a process that ended, a window
# closed -- so the next pass asks which (dt_rtptytick).
DT_RTPTYN=
DT_RTPTYLONE=
# The told requests interface.tsv names, which alone are carried; those
# whose first word is a window; and, per app, the requests its own file
# makes, read once from the file (never run) and kept by its path. And the
# request each function of the app interface reaches on the app's behalf
# (interface.tsv's reaches): a file naming dt_droplist may open a list,
# which dt_context_open does, though its text never names that.
declare -gA DT_RTALLOW DT_RTWIN DT_RTMAY DT_RTMAYOF DT_RTREACH
# The asked and waited requests interface.tsv names: an app waits for each
# one's answer (dt_rtask in runtime.hibr), which the desktop sends once what
# the request changed has gone out, so a read after it sees it. `bind` for one
# that answers with a value (it calls ret), `wait` for one whose status is the
# whole answer -- the contract's own column, never decided here.
declare -gA DT_RTASK
# The connection a request being run came in on, empty for the desktop's own
# and an in-process app's calls: what a request checks before trusting
# DT_CALLER as a hosted process (dt_set's allowlist).
DT_RTFROM=

# Start listening for app processes, once: the socket beside the control
# socket's, its path exported for what the desktop starts to inherit.
dt_rtlisten() {
	local p c f n a sg x

	[ -n "$DT_RTLFD" ] && return 0
	p := dt_ctlwhere
	p=${p%.ctl}.rt
	if ! [ -d "${p%/*}" ]; then
		mkdir -p -m 700 "${p%/*}" 2> /dev/null || { dt_log "app runtime: cannot make ${p%/*}"; return 1; }
	fi
	if ! [ -O "${p%/*}" ]; then
		dt_log "app runtime: ${p%/*} belongs to someone else; not listening"
		return 1
	fi
	if ! listen -b "$p" DT_RTLFD 2> /dev/null; then
		DT_RTLFD=
		dt_log "app runtime: cannot listen at $p"
		return 1
	fi
	DT_RTPATH=$p
	export DT_RTSOCK=$p
	while IFS=$'\t' read -r c f _ _ _ a x sg _; do
		[ "$c" != local ] || [ "$x" = - ] || DT_RTREACH["$f"]=${x##* }
		[ "$c" = request ] || continue
		case $a in
		told) DT_RTALLOW["$f"]=1 ;;
		asked) DT_RTASK["$f"]=bind ;;
		waited) DT_RTASK["$f"]=wait ;;
		*) continue ;;
		esac
		[[ $sg == "$f"\(id* || $sg == "$f(int id"* ]] && DT_RTWIN["$f"]=1
	done < "$DT_HERE/interface.tsv"
	# Every shared name watched from now on (wm/rtwire.hibr, dt_share);
	# what was true before the first app connected is what its hello sends.
	if ! need varwatch 2> /dev/null; then
		dt_log "app runtime: no varwatch module, so nothing is shared"
	else
		DT_RTWATCH=1
		for x in "${!DT_SHARED[@]}"; do
			varwatch add "$x" 2> /dev/null || dt_log "app runtime: $x is shared and does not exist"
		done
		x := varwatch moved
		DT_RTSEQ := varwatch seq
		DT_RTLINE=()
	fi
	n=${#DT_RTALLOW[@]}
	command -v console > /dev/null && console watch "$DT_RTLFD" 2> /dev/null
	dt_ticker dt_rttick
	dt_log "app runtime: listening at $p, $n told requests carried"
	return 0
}

# How much of what the desktop says to one app may wait for the app to read
# it before the app is taken to have stopped reading and is let go, and the
# connections with something still waiting: each is offered it again every
# pass (a frame asked for while any is), so nothing said is left behind and
# a hung app cannot grow the desktop's memory past this.
DT_RTQMAX="${DT_RTQMAX-1048576}"
DT_RTQSECS="${DT_RTQSECS-2}"
declare -gA DT_RTPENDB DT_RTPENDT
declare -gA DT_RTPEND

# Whose an entry of a name shared by owner is: the values its owner fields
# hold (dt_share -o, one or more), the empty ones left out, each between
# tabs -- an owner may be an installable's file, whose path may hold a
# blank. Empty for none. This file is strict, where a bare expansion is
# one word, so the fields are walked one at a time -- without the
# here-string read -ra would need, which costs twice the walk.
fn dt_rtownof(name, key) {
	local f o= r=${DT_SHAREOWN["$name"]-}
	local -n m=$name

	while [ -n "$r" ]; do
		f=${r%% *}
		r=${r:${#f}+1}
		[ -z "${m["$key"]["$f"]-}" ] || o+=$'\t'"${m["$key"]["$f"]}"
	done
	[ -z "$o" ] || o+=$'\t'
	ret "$o"
}

# A shared name as JSON, the whole of it; for one shared by owner (dt_share
# -o) only the entries that belong to app: one of its owner fields names it.
fn dt_rtwhole(name, app = "") {
	local j k o f=${DT_SHAREOWN["$name"]-}
	local -A cp

	if [ -n "$f" ]; then
		local -n m=$name
		for k in "${!m[@]}"; do
			o := dt_rtownof "$name" "$k"
			[[ $o == *$'\t'"$app"$'\t'* ]] || continue
			j := dt_rtentry "$name" "$k"
			json parse cp["$k"] "$j"
		done
		j := json emit cp
		ret "$j"
		return 0
	fi
	j := json emit "$name" 2> /dev/null || j='""'
	ret "$j"
}

# A shared name's whole line: `json NAME KIND TEXT`, the kind its own (A a
# map declared -A, a a list or a plain map, s a scalar), so the app declares
# it as the desktop does and a key with a dash still reads back literally.
fn dt_rtcode(name, app = "") {
	local j k x

	# Kept once made, for a name not shared by owner, and dropped the moment
	# the variable table reports it changed: a hello encodes every name its
	# file reads, 237 of them for a file the inventory never read, which was
	# 31 ms each launch made afresh, measured.
	if [ -z "${DT_SHAREOWN["$name"]-}" ] && [ -n "${DT_RTLINE["$name"]+x}" ]; then
		ret "${DT_RTLINE["$name"]}"
		return 0
	fi
	k=${!name@a}
	case $k in *A*) k=A ;; *a*) k=a ;; *) k=s ;; esac
	j := dt_rtwhole "$name" "$app"
	x := dt_rtline json "$name" "$k" "$j"
	[ -n "${DT_SHAREOWN["$name"]-}" ] || DT_RTLINE["$name"]=$x
	ret "$x"
}

# One entry of a map as JSON: a record's fields, or a value. A record is
# told by its keys, since through a nameref an entry at key 0 holding only
# fields once read as the name the nameref holds (Gitea #595).
fn dt_rtentry(name, key) {
	local f v
	local -a ks
	local -A e
	local -n m=$name

	ks=("${!m["$key"][@]}")
	if [ "${#ks[@]}" -gt 0 ]; then
		for f in "${ks[@]}"; do
			e["$f"]=${m["$key"]["$f"]}
		done
		v := json emit e
	else
		v=${m["$key"]}
		v := json emit v
	fi
	ret "$v"
}

# Whether connection c is sent shared name n: when the app interface reads
# it, or the file that connected (or one of its parts) does; a file the
# inventory never read is sent every name but a secret, so it is never
# silently empty.
fn dt_rtwants(int c, name) {
	local a=${DT_RTAUD["$name"]-} f=${DT_RTCFILE["$c"]-}

	[ "$a" = "*" ] && return 0
	if [ -z "$f" ] || [ -z "${DT_RTKNOWN["$f"]+x}" ]; then
		[ -z "${DT_SHARED["$name"]-}" ]
		return
	fi
	case " $a " in *" $f "*) return 0 ;; esac
	return 1
}

# The pass: what the variable table says changed since the last one, sent to
# every connection that reads it -- a whole name as its whole line, a key of
# a map as that entry (`jsonk NAME KEY JSON`, or `unsetk NAME KEY` when it
# has gone), and an entry of a name shared by owner to its owner's
# connections alone. Nothing marks anything: a write that changes nothing is
# not reported, so an idle pass is one comparison. An entry that changed on
# the pass before as well is moving -- a window dragged, a bar item resized
# -- and is held until it settles, or DT_RTSETTLE ms have passed, then sent
# once: a drag sends its start and its end, never a line a step (a window's
# record is 137 us to encode, measured). With force -- before a tell -- what
# is held goes too, so a call never reads a place the app has not been sent.
declare -gA DT_RTSTIR DT_RTHELD
DT_RTSETTLE="${DT_RTSETTLE-250}"
dt_rtpass() {
	local s

	[ -n "$DT_RTWATCH" ] || return 0
	s := varwatch seq
	if [ "$s" = "$DT_RTSEQ" ] && [ "${#DT_RTHELD[@]}" = 0 ] && [ -z "${1-}" ]; then
		[ "${#DT_RTSTIR[@]}" = 0 ] || DT_RTSTIR=()
		return 0
	fi
	dt_rtmoved "$s" "${1-}"
}

# The pass's work, when the variable table reports a change or something is
# held: seq is what it reports now, force set before a tell or a hello.
fn dt_rtmoved(s, force = "") {
	local e now
	local -a m
	local -A stir

	now=$((${EPOCHREALTIME/./} / 1000))
	if [ "$s" != "$DT_RTSEQ" ]; then
		DT_RTSEQ=$s
		m := varwatch moved
		m=("${m[@]}")
		for e in "${m[@]}"; do
			[ -n "$e" ] || continue
			[ -n "${DT_SHARED["${e%%$'\t'*}"]+x}" ] || continue
			unset DT_RTLINE["${e%%$'\t'*}"]
			if [ -n "${e#*$'\t'}" ] && [ -z "$force" ] && [ -n "${DT_RTSTIR["$e"]+x}" ]; then
				[ -n "${DT_RTHELD["$e"]+x}" ] || DT_RTHELD["$e"]=$now
				stir["$e"]=1
				continue
			fi
			stir["$e"]=1
			unset DT_RTHELD["$e"]
			dt_rtsend1 "$e"
		done
	fi
	for e in "${!DT_RTHELD[@]}"; do
		[ -n "$force" ] || [ -z "${stir["$e"]+x}" ] ||
			[ $((now - DT_RTHELD["$e"])) -ge "$DT_RTSETTLE" ] || continue
		unset DT_RTHELD["$e"]
		dt_rtsend1 "$e"
	done
	DT_RTSTIR=()
	for e in "${!stir[@]}"; do
		DT_RTSTIR["$e"]=1
	done
	[ "${#DT_RTHELD[@]}" = 0 ] || dt_want "$DT_RTSETTLE"
	return 0
}

# Send one change, "NAME<TAB>KEY" (KEY empty: the whole of it), to every
# connection that reads it.
fn dt_rtsend1(e) {
	local n=${e%%$'\t'*} k=${e#*$'\t'} c x own
	local f=${DT_SHAREOWN["$n"]-}

	x=
	if [ -n "$k" ]; then
		local -n mp=$n
		own=
		[ -z "$f" ] || own := dt_rtownof "$n" "$k"
		if [ -n "${mp["$k"]+x}" ] || [ "${#mp["$k"][@]}" -gt 0 ]; then
			x := dt_rtentry "$n" "$k"
			x := dt_rtline jsonk "$n" "$k" "$x"
		else
			x := dt_rtline unsetk "$n" "$k"
		fi
	elif [ -z "$f" ]; then
		x := dt_rtcode "$n"
	fi
	for c in "${!DT_RTC[@]}"; do
		[ "${DT_RTC["$c"]}" = - ] && continue
		dt_rtwants "$c" "$n" || continue
		if [ -n "$f" ]; then
			# By owner: an entry to its owner's connections, a gone one
			# to every reader (unsetting a key it never had is nothing),
			# and the whole to each, filtered.
			if [ -n "$k" ]; then
				[ -z "$own" ] || [[ $own == *$'\t'"${DT_RTC["$c"]}"$'\t'* ]] || continue
			else
				x := dt_rtcode "$n" "${DT_RTC["$c"]}"
			fi
		fi
		dt_rtsay "$c" "$x"
	done
	return 0
}

# Every pass while listening: what woke the display is asked of it, so a
# connection with nothing to say costs nothing; each that did is read with
# dt_rtlines (wm/rtwire.hibr), which never waits, and its whole lines are
# carried, at most DT_RTLINES a pass.
dt_rttick() {
	local c x w st
	local -a ready got

	[ -n "$DT_RTLFD" ] || return 0
	[ "${#DT_RTLAUNCH[@]}" = 0 ] || dt_rtlaunches
	[ "${#DT_RTC[@]}" = 0 ] || dt_rtpass
	for c in "${!DT_RTPEND[@]}"; do
		dt_rtsay "$c" ""
	done
	[ "${#DT_RVASK[@]}${#DT_RTENDPID[@]}${#DT_RVLATE[@]}" = 000 ] || dt_rvtick
	[ "${#DT_RTCELLC[@]}" = 0 ] || dt_rvtakes
	[ -z "$DT_RTPTYN" ] || dt_rtptytick
	[ "${#DT_RVKEEP[@]}" = 0 ] || dt_rvkeeptick
	if command -v console > /dev/null; then
		w := console woke "$DT_RTLFD" "${!DT_RTC[@]}" ${DT_RTZFD:+"$DT_RTZFD"} "${!DT_RTPTYC[@]}"
		read -ra ready <<< "$w"
	else
		ready=("$DT_RTLFD" "${!DT_RTC[@]}" ${DT_RTZFD:+"$DT_RTZFD"} "${!DT_RTPTYC[@]}")
	fi
	for c in "${ready[@]}" "${!DT_RTMORE[@]}"; do
		if [ "$c" = "$DT_RTZFD" ]; then
			dt_rtzread
			continue
		fi
		if [ -n "${DT_RTPTYC["$c"]+x}" ]; then
			dt_rtptyserve "$c"
			continue
		fi
		if [ "$c" = "$DT_RTLFD" ]; then
			while accept -t 0 "$DT_RTLFD" x 2> /dev/null; do
				if [ "$REMOTE" != "uid:$UID" ]; then
					send -p "$x" "refused not%20this%20desktop's%20user" 2> /dev/null
					send -c "$x"
					exec {x}>&-
					dt_log "app runtime: refused a connection from $REMOTE"
					continue
				fi
				DT_RTC["$x"]=-
				DT_RTBUF["$x"]=
				# As input: an app waiting on an asked request must not wait
				# out a frame the desktop is holding back (console key -q),
				# which cost 70 ms an ask (ADR 0050, measured).
				command -v console > /dev/null && console watch -i "$x" 2> /dev/null
			done
			continue
		fi
		[ -n "${DT_RTC["$c"]+x}" ] || continue
		dt_rtlines "$c"
		st=$?
		if [ "$st" = 1 ]; then
			dt_rtdrop "$c"
			continue
		fi
		[ -n "${DT_RTMORE["$c"]+x}" ] && dt_want "${DT_TERMMS:-70}"
		got=("${DT_RTGOT[@]}")
		for x in "${got[@]}"; do
			dt_rtmsg "$c" "$x" || continue 2
		done
		if [ "$st" = 2 ]; then
			dt_log "app runtime: ${DT_RTC["$c"]} sent ${#DT_RTBUF["$c"]} bytes with no end of line; let go"
			dt_rtdrop "$c" "it sent a line with no end"
		fi
	done
	return 0
}

# A launch: a token no one can guess from outside, recorded as app's until
# a hello spends it. Answered with ret.
# A one-time token: sixteen random bytes as hex, for a launch or a cells
# channel. Answered with ret.
fn dt_rttoken() {
	local t

	read -r t < <(od -An -tx1 -N16 /dev/urandom) # fork: once an app process starts or connects, never a frame
	ret "${t// /}"
}

fn dt_rtissue(app, file = "") {
	local t

	t := dt_rttoken
	DT_RTLAUNCH["$t"]=$app
	DT_RTLFILE["$t"]=$file
	DT_RTLTIME["$t"]=$EPOCHSECONDS
	ret "$t"
}

# A file as the kind folder it is in sees it, apps/files.hibr, wherever the
# scope holding it is -- what DT_RTAUD and DT_RTKNOWN name it by.
fn dt_rtkindrel(f) {
	local k r=$f t

	for k in apps system control-panel control-strip menubar savers; do
		case $f in
		*/"$k"/*)
			t="$k/${f##*/"$k"/}"
			[ "${#t}" -lt "${#r}" ] && r=$t
			;;
		esac
	done
	ret "$r"
}
# When each launch was issued, and the process a spawn started for it: a
# token is good for DT_RTLAUNCHSECS, and a launch whose process has gone
# before its hello is reported at once (dt_rtlaunches).
declare -gA DT_RTLFILE DT_RTLTIME DT_RTLPID
DT_RTLAUNCHSECS="${DT_RTLAUNCHSECS-15}"

# Launches not yet spent: one whose process has exited, or whose time is up,
# is void -- its token refused from then on -- and said once, in the log and
# to the person, since an app that never came is otherwise only an absence.
# Asked only while a launch is pending, so a pass with none costs one test.
dt_rtlaunches() {
	local t p why

	for t in "${!DT_RTLAUNCH[@]}"; do
		p=${DT_RTLPID["$t"]-}
		why=
		if [ -n "$p" ] && ! dt_rtpidup "$p"; then
			why="exited before it said hello"
		elif [ $((EPOCHSECONDS - ${DT_RTLTIME["$t"]:-0})) -ge "$DT_RTLAUNCHSECS" ]; then
			why="did not say hello within $DT_RTLAUNCHSECS seconds"
		fi
		[ -n "$why" ] || continue
		dt_log "app runtime: ${DT_RTLAUNCH["$t"]} started from ${DT_RTLFILE["$t"]:-nothing} $why; its launch is void"
		[ "${#DT_RVP[@]}${#DT_RVB[@]}" = 00 ] || dt_rvxvoid "${DT_RTLAUNCH["$t"]}"
		# A process a restart kept that never joined has gone as far as
		# its windows are concerned: an app that crashed (Decision 7) --
		# they are kept, Reopen offered, its terminals' programs kept.
		if [ -n "${DT_RTLKEPT["$t"]-}" ]; then
			dt_rvlost "${DT_RTLAUNCH["$t"]}" "$p" "it was kept across the restart and $why"
		# A note from a ticker asks for the frame that shows it, or it
		# expires before anything draws.
		elif [ -n "${DT_RTLFILE["$t"]-}" ]; then
			dt_notep normal "%s did not start" "${DT_RTLAUNCH["$t"]}"
			dt_want 30
		fi
		[ -z "${DT_RTLSTAMP["$t"]-}" ] || command rm -f -- "${DT_RTLSTAMP["$t"]}"
		unset DT_RTLAUNCH["$t"] DT_RTLFILE["$t"] DT_RTLTIME["$t"] DT_RTLPID["$t"] DT_RTLSTAMP["$t"] DT_RTLKEPT["$t"]
	done
	return 0
}

# Start the zygote, once a desktop (ADR 0050): the runtime run as the one
# prepared host its app processes are forked from, with three descriptors
# and its channel and no more -- standard input and output /dev/null, never
# the desktop's terminal, so nothing it starts can read the person's keys or
# write over the screen; standard error the desktop's own, its log. Every
# other descriptor the desktop holds -- the terminal under another number,
# its listening socket, other apps' connections -- is closed before it
# starts, so no app process holds them past the desktop's own close. Read
# from disk when the first app process is asked for; a zygote of another
# version says so in its first message and is refused, as an app's hello is.
dt_rtzstart() {
	local f x d z

	[ -n "$DT_RTZFD" ] && return 0
	need zygote 2> /dev/null || { dt_log "app runtime: no zygote module, so no app process can start"; return 1; }
	need pty 2> /dev/null || dt_log "app runtime: no pty module, so no terminal's program is the desktop's"
	x := zygote pair || { dt_log "app runtime: no channel for the zygote"; return 1; }
	read -r d z <<< "$x"
	# /dev/fd is this process's own descriptors on Linux and macOS alike,
	# where /proc/self/fd is Linux's alone; a name that is not a number is
	# the pattern left unexpanded, and skipped. The channel crosses the exec
	# as descriptor 3, a copy made after the others are gone, since the pair
	# is made close-on-exec.
	(
		for f in /dev/fd/*; do
			f=${f##*/}
			case $f in "" | *[!0-9]*) continue ;; esac
			[ "$f" -gt 2 ] && [ "$f" != "$z" ] && [ -e "/dev/fd/$f" ] && exec {f}>&-
		done
		# A copy onto itself would keep it close-on-exec.
		if [ "$z" = 3 ]; then
			exec {f}<&3
			z=$f
		fi
		exec 3<&"$z"
		exec {z}>&-
		exec "$HIBR" "$DT_HERE/runtime.hibr" --zygote 3 < /dev/null > /dev/null
	) &
	DT_RTZPID=$!
	exec {z}>&-
	DT_RTZFD=$d
	DT_RTZOK=
	# When it started, as a file's time: what it read of the desktop's
	# own files is current while none is newer (dt_rtcurrent).
	DT_RTZSTAMP=${DT_RTPATH%.rt}.zygote
	: > "$DT_RTZSTAMP"
	command -v console > /dev/null && console watch -i "$d" 2> /dev/null
	dt_log "app runtime: started the zygote as $DT_RTZPID"
	return 0
}

# Start an app's own process: forked by the zygote, its launch's token given
# with the request, never in any environment the desktop's own children
# see. Handed with it, its end of a channel for its terminals' programs,
# which the desktop starts and owns (mods/pty), so a program outlives the
# process showing it however often that process is replaced. With no words
# the fresh process runs the app from its file; with words, it execs hibr on
# them, for a file that is its own runtime (a test's). The launch is the
# file's either way, which is what the app is sent by (dt_rtwants); its
# process's pid comes when the zygote says it has forked it.
fn dt_rtspawn(app, file, ...run) {
	local t x d a l

	dt_rtzstart || return 1
	t := dt_rtissue "$app" "$file"
	# When its process read its file: current while none of its files is
	# newer (dt_rtappcurrent). Named by its launch, kept by its connection.
	DT_RTLSTAMP["$t"]=${DT_RTPATH%.rt}.l-$t
	: > "${DT_RTLSTAMP["$t"]}"
	x := zygote pair || { dt_log "app runtime: no channel for $app's terminals"; return 1; }
	read -r d a <<< "$x"
	l := dt_rtline fork "$t" "$app" "$file" "${run[@]}"
	if ! zygote send "$DT_RTZFD" "$l" "$a"; then
		exec {a}>&-
		exec {d}>&-
		dt_log "app runtime: the zygote took no request to start $app"
		return 1
	fi
	exec {a}>&-
	DT_RTPTYC["$d"]=$app
	command -v console > /dev/null && console watch -i "$d" 2> /dev/null
	dt_log "app runtime: asked the zygote to start $app from $file"
	ret "$t"
}

# What the zygote said: that it speaks this desktop's protocol, that it has
# forked a launch's process, that one has ended. Read whenever its channel
# wakes the desktop, never waiting; one that has gone is said once, and its
# app processes, no longer anyone's to report, end as unknown.
dt_rtzread() {
	local l st t p x
	local -a w

	while :; do
		l := zygote recv "$DT_RTZFD" -t 0
		st=$?
		[ "$st" = 0 ] || break
		read -ra w <<< "$l"
		for x in "${!w[@]}"; do
			w[$x] := dt_rtdec "${w[$x]}"
		done
		case ${w[0]-} in
		zygote)
			if [ "${w[1]-}" != "$DT_RTPROTO" ] || [ "${w[2]-}" != "$HIBR_VERSION" ]; then
				dt_log "app runtime: the zygote is hibr ${w[2]-?} protocol ${w[1]-?}, this desktop $HIBR_VERSION protocol $DT_RTPROTO; ended"
				# Nothing runs half old and half new: each app waiting
				# for it is said once, as a refused hello is, and void.
				for t in "${!DT_RTLAUNCH[@]}"; do
					x := dt_tr "hibr was updated: click to restart the desktop and open %s" "${DT_RTLAUNCH["$t"]}"
					dt_notifyp high "$x" dt_restart
					unset DT_RTLAUNCH["$t"] DT_RTLFILE["$t"] DT_RTLTIME["$t"] DT_RTLPID["$t"]
				done
				kill "$DT_RTZPID" 2> /dev/null
				st=1
				break
			fi
			DT_RTZOK=1
			;;
		forked)
			t=${w[1]-}
			p=${w[2]-}
			[[ $p =~ ^[0-9]+$ ]] || continue
			if [ -n "${DT_RTLAUNCH["$t"]+x}" ]; then
				DT_RTLPID["$t"]=$p
			elif [ -n "${DT_RTTOKC["$t"]-}" ]; then
				DT_RTCPID["${DT_RTTOKC["$t"]}"]=$p
			fi
			dt_log "app runtime: the zygote started a process as $p"
			;;
		exit)
			p=${w[1]-}
			[[ $p =~ ^[0-9]+$ ]] || continue
			DT_RTEXIT["$p"]=${w[2]-}
			dt_log "app runtime: process $p ended with status ${w[2]-?}, its zygote says"
			dt_want 0
			;;
		*) dt_log "app runtime: the zygote said ${w[0]:-nothing}, which the desktop does not know" ;;
		esac
	done
	[ "$st" = 1 ] || return 0
	dt_log "app runtime: the zygote's channel has ended"
	command -v console > /dev/null && console unwatch "$DT_RTZFD" 2> /dev/null
	zygote close "$DT_RTZFD"
	DT_RTZFD=
	DT_RTZOK=
	return 0
}

# Whether the code an app process runs is what is on disk now (ADR 0050, the
# owner, 2026-11-22), which decides whether Restart Desktop keeps it or
# replaces it with a fresh one: hibr itself, the same file the zygote it was
# forked from runs -- the question DT_UPNEW asks of the desktop -- and every
# library it mapped, a module above all, still the file at its path (one
# replaced there, as apt and `make` replace them, the kernel names
# ` (deleted)` in its maps); and the desktop's own files that zygote read,
# none newer than its start; then, for the process on connection c, each
# file of its app's own (its file and its parts), none newer than its
# launch. Status 0 when current. Where /proc is not, nothing is known
# current, and every process is replaced.
dt_rtcurrent() {
	local f line

	[ -n "$DT_RTZFD" ] && [ -n "$DT_RTZPID" ] && [ -e "$DT_RTZSTAMP" ] || return 1
	[ "/proc/$DT_RTZPID/exe" -ef "$HIBR" ] || return 1
	[ -r "/proc/$DT_RTZPID/maps" ] || return 1
	while read -r line; do
		case $line in
		*.so" (deleted)" | *.so.[0-9]*" (deleted)") return 1 ;;
		esac
	done < "/proc/$DT_RTZPID/maps"
	for f in "$DT_HERE"/*.hibr "$DT_HERE"/wm/*.hibr "$DT_HERE"/widgets/*.hibr "$DT_HERE"/lib/*.hibr; do
		[ "$f" -nt "$DT_RTZSTAMP" ] && return 1
	done
	return 0
}
fn dt_rtappcurrent(int c) {
	local s=${DT_RTCSTAMP["$c"]-} ap=${DT_RTC["$c"]-} src p
	local -a fs

	[ -n "$s" ] && [ -e "$s" ] && [ -n "$ap" ] && [ "$ap" != - ] || return 1
	src=${DT_APPS["$ap"]["src"]-$ap}
	[ -e "$src" ] || return 1
	[ "$src" -nt "$s" ] && return 1
	p := dt_rtpartfiles "$src" || return 0
	mapfile -t fs <<< "$p"
	for p in "${fs[@]}"; do
		[ -z "$p" ] || ! [ "$p" -nt "$s" ] || return 1
	done
	return 0
}

# Whether an app process the zygote started is still there: not said to
# have ended -- or, its zygote gone, still a process at all.
fn dt_rtpidup(int p) {
	[ -z "${DT_RTEXIT["$p"]+x}" ] || return 1
	[ -n "$DT_RTZFD" ] && return 0
	kill -0 "$p" 2> /dev/null
}

# Signal an app process: through the zygote, its parent, which signals only
# a child it has not yet seen end; with no zygote, directly.
fn dt_rtpidsig(int p, int sig) {
	local l

	if [ -n "$DT_RTZFD" ]; then
		l := dt_rtline end "$p" "$sig"
		zygote send "$DT_RTZFD" "$l"
		return
	fi
	kill -"$sig" "$p" 2> /dev/null
}

# An app process's channel for its terminals' programs: what it asks is
# done -- a program started, as the desktop's child; one taken back by its
# pid; a signal; a close -- and once it has ended, what it held is held by no
# process, kept while a window names it (dt_rtptytick). Timed and blamed as
# a request is.
fn dt_rtptyserve(int fd) {
	local ap=${DT_RTPTYC["$fd"]-} l st t0

	t0=${EPOCHREALTIME/./}
	l := pty serve "$fd" "$ap"
	st=$?
	dt_spent "pty serve" "$((${EPOCHREALTIME/./} - t0))" "$ap"
	[ -z "$l" ] || dt_log "app runtime: $ap's terminals: ${l//$'\n'/; }"
	[[ $l == *spawned* || $l == *adopted* ]] && DT_RTPTYN=1
	[ "$st" = 1 ] || return 0
	command -v console > /dev/null && console unwatch "$fd" 2> /dev/null
	unset DT_RTPTYC["$fd"]
	DT_RTPTYLONE=1
	return 0
}

# Every pass while the desktop owns a terminal's program: those that have
# ended are waited for and their app told. One no app process holds is kept
# for as long as a window names it (DT[ID]["prog"], dt_winprog) -- a window
# kept after its app crashed, until Reopen takes it back or the window is
# closed; one restored by a restart, until its process asks for it -- and
# hung up once none does, asked only after something may have let one go,
# and never while an app process is starting or a window is being taken up,
# either of which may be about to ask for one. A pass with none left stops
# asking.
dt_rtptytick() {
	local l i p o id keep

	l := pty reap || DT_RTPTYN=
	[ -z "$l" ] || dt_log "app runtime: terminals' programs: ${l//$'\n'/; }"
	[ -n "$DT_RTPTYLONE" ] && [ "${#DT_RTLAUNCH[@]}${#DT_RVKEEP[@]}" = 00 ] || return 0
	DT_RTPTYLONE=
	l := pty lone
	while read -r i p o; do
		[ -n "$p" ] || continue
		keep=
		dt_wins
		for id in "${DT_WINS[@]}"; do
			[ "${DT[$id]["prog"]-}" = "$p" ] && { keep=$id; break; }
		done
		[ -z "$keep" ] || continue
		pty close "$i"
		dt_log "app runtime: $o's terminal program $p, held by no process and named by no window, hung up"
	done <<< "$l"
	return 0
}

# Tell the process of one launch to run one of its own functions, by name
# (`call 0 - NAME WORDS`, ADR 0050): sent, never waited for. Status 1 when
# that launch has no connection.
fn dt_rttell(launch, name, ...args) {
	local c=${DT_RTTOKC["$launch"]-} x

	[ -n "$c" ] || return 1
	# What changed goes out before a call that may read it, held or not.
	dt_rtpass force
	x := dt_rtline call 0 - "$name" "${args[@]}"
	dt_rtsay "$c" "$x"
}

# Let a connection go: why, when it is the desktop that lets it go rather
# than the app that went, said to its windows (dt_rvdrop), which carry on as
# the person chose (ADR 0050, Decision 7). Its app and its process are
# taken before the records go, since the drop below forgets both.
fn dt_rtdrop(int c, why = "") {
	local x pid

	[ -n "${DT_RTC["$c"]+x}" ] || return 0
	pid=${DT_RTCPID["$c"]-}
	command -v console > /dev/null && console unwatch "$c" 2> /dev/null
	send -c "$c"
	exec {c}>&-
	[ -z "${DT_RTCTOK["$c"]-}" ] || unset DT_RTTOKC["${DT_RTCTOK["$c"]}"]
	x=${DT_RTC["$c"]}
	if [ "$x" != - ] && [ -n "${DT_RTAPPS["$x"]-}" ]; then
		DT_RTAPPS["$x"]=$((DT_RTAPPS["$x"] - 1))
		[ "${DT_RTAPPS["$x"]}" -gt 0 ] || unset DT_RTAPPS["$x"]
	fi
	# Its stamp goes with it, unless a restart keeps its process, whose
	# stamp the desktop after the exec takes over.
	[ -z "${DT_RTCSTAMP["$c"]-}" ] || [ -n "${DT_RSKEEPC["$c"]+x}" ] || command rm -f -- "${DT_RTCSTAMP["$c"]}"
	unset DT_RTCSTAMP["$c"]
	unset DT_RTC["$c"] DT_RTBUF["$c"] DT_RTMORE["$c"] DT_RTPEND["$c"] DT_RTCTOK["$c"] DT_RTCFILE["$c"]
	unset DT_RTPENDB["$c"] DT_RTPENDT["$c"] DT_RTCPID["$c"]
	# Gone first, so nothing below says anything more to it: then its
	# cells channel and its windows.
	dt_rvdrop "$c" "$x" "$pid" "$why"
	return 0
}

# Say a line to a connection, or with an empty line offer it what is still
# waiting: send -p writes what the app takes now and keeps the rest, never
# waiting. Status 1 when the connection was let go -- it had gone, or what
# waits for it passed DT_RTQMAX, which an app still reading never reaches.
fn dt_rtsay(int c, line) {
	local st

	send -p "$c" "$line" 2> /dev/null
	st=$?
	case $st in
	0)
		unset DT_RTPEND["$c"] DT_RTPENDB["$c"] DT_RTPENDT["$c"]
		return 0
		;;
	3)
		# Shrinking since it was last looked at is reading: the time is
		# kept, and only a backlog past DT_RTQMAX that has not shrunk for
		# DT_RTQSECS is an app that stopped -- one line longer than the
		# limit, the clipboard's history at a hello, is not.
		if [ "$RET" -lt "${DT_RTPENDB["$c"]:-0}" ] || [ -z "${DT_RTPENDT["$c"]-}" ] ||
			[ "${DT_RTPENDB["$c"]:-0}" -le "$DT_RTQMAX" ]; then
			DT_RTPENDT["$c"]=$EPOCHSECONDS
		fi
		DT_RTPENDB["$c"]=$RET
		if [ "$RET" -gt "$DT_RTQMAX" ] && [ $((EPOCHSECONDS - DT_RTPENDT["$c"])) -ge "$DT_RTQSECS" ]; then
			dt_log "app runtime: ${DT_RTC["$c"]-a connection} stopped reading ($RET bytes waiting for it); let go"
			dt_rtdrop "$c" "it stopped reading"
			return 1
		fi
		DT_RTPEND["$c"]=1
		dt_want "${DT_TERMMS:-70}"
		return 0
		;;
	esac
	dt_rtdrop "$c"
	return 1
}

# Stop listening, let every app process go, and take the socket away: at
# Quit and before Restart Desktop's exec, as the control socket is. An app
# process sees its connection end.
dt_rtclose() {
	local c

	[ -n "$DT_RTLFD" ] || return 0
	for c in "${!DT_RTC[@]}"; do
		dt_rtdrop "$c" closing
	done
	command -v console > /dev/null && console unwatch "$DT_RTLFD" 2> /dev/null
	exec {DT_RTLFD}>&-
	DT_RTLFD=
	[ -n "$DT_RTPATH" ] && command rm -f -- "$DT_RTPATH"
	DT_RTPATH=
	return 0
}

# Whether name is an installed app, and if so what its own file may ask:
# the told requests the file's text names, read once per file and kept.
# Read, never run, as everything an app declares is (ADR 0050, 3).
# Whether a file is the calling app's own -- its file or one of its parts --
# when an app's process asks; the desktop's own calls always are. What a
# request that names another installable's thing checks before acting.
fn dt_rtmine(f) {
	[ -n "${DT_RTFROM-}" ] || return 0
	dt_rvmine "$DT_CALLER" "$f"
}

# The text of every part a file declares, joined, for dt_rtmay.
fn dt_rtparts(src) {
	local p fs out=

	fs := dt_rtpartfiles "$src" || return 1
	while IFS= read -r p; do
		[ -n "$p" ] && out+=$'\n'$(< "$p")
	done <<< "$fs"
	ret "$out"
}

fn dt_rtmay(name) {
	local src t f

	[ -n "$name" ] || return 1
	if [[ $name == */* ]]; then
		dt_rvinst "$name" || return 1
	else
		[ -n "${DT_APPS["$name"]["title"]+x}" ] || return 1
	fi
	src := dt_rvsrc "$name"
	[ -n "$src" ] && [ -r "$src" ] || return 1
	[ "${DT_RTMAYOF["$name"]-}" = "$src" ] && return 0
	t=$(< "$src")
	# A bundle is one process, so what its parts name counts as its own: each
	# `# part:` line of its file, found from the folder above the file's kind,
	# as the catalogue places them.
	dt_rtparts "$src" && t+=$'\n'$RET
	for f in "${!DT_RTALLOW[@]}" "${!DT_RTASK[@]}"; do
		[[ $t == *"$f"* ]] && DT_RTMAY["$name $f"]=1
	done
	for f in "${!DT_RTREACH[@]}"; do
		[[ $t == *"$f"* ]] && DT_RTMAY["$name ${DT_RTREACH["$f"]}"]=1
	done
	# A pane of rows asks what the panel's rows ask for it (wm/rtkinds.hibr).
	if [[ $t == *_rows\(* ]]; then
		for f in "${DT_RVROWSASK[@]}"; do
			DT_RTMAY["$name $f"]=1
		done
	fi
	# The settings it may change through dt_set: a kept one its own file
	# names as a word (ADR 0050: accepted only for a setting it declares).
	for f in "${DT_KEEP[@]}"; do
		[[ $t =~ (^|[^A-Za-z0-9_])$f([^A-Za-z0-9_]|$) ]] && DT_RTMAY["$name set:$f"]=1
	done
	DT_RTMAYOF["$name"]=$src
	return 0
}

# Whether a window is the app's own: one of its windows, one its process
# asked for (rtown), or a dialog the desktop opened for one of them (a file
# picker).
fn dt_rtowns(who, id) {
	local f

	[[ $id =~ ^[0-9]+$ ]] || return 1
	dt_iswin "$id" || return 1
	dt_rvappof "$who" "${DT[$id]["app"]-}" && return 0
	[ "${DT[$id]["rtown"]-}" = "$who" ] && return 0
	f=${FP[$id]["for"]-}
	[ -n "$f" ] && dt_iswin "$f" && dt_rvappof "$who" "${DT[$f]["app"]-}"
}

# One message from a connection; status 1 when it was let go.
fn dt_rtmsg(int c, line) {
	local i x who=${DT_RTC["$c"]-} t t0
	local -a w a

	read -ra w <<< "$line"
	for i in "${!w[@]}"; do
		x := dt_rtdec "${w[$i]}"
		a+=("$x")
	done
	if [ "$who" = - ]; then
		if [ "${a[0]-}" = cells ]; then
			dt_rvcells_in "$c" "${a[1]-}"
			return 1
		fi
		if [ "${a[0]-}" != hello ]; then
			dt_rtsay "$c" "refused said%20nothing%20first"
			dt_rtdrop "$c"
			return 1
		fi
		if [ "${a[1]-}" != "$DT_RTPROTO" ] || [ "${a[2]-}" != "$HIBR_VERSION" ]; then
			x := dt_rtline refused "hibr $HIBR_VERSION protocol $DT_RTPROTO here, ${a[2]-?} protocol ${a[1]-?} there"
			dt_rtsay "$c" "$x"
			dt_log "app runtime: refused ${a[3]-an app}: hibr ${a[2]-?} protocol ${a[1]-?}, this desktop runs $HIBR_VERSION protocol $DT_RTPROTO"
			t := dt_tr "hibr was updated: click to restart the desktop and open %s" "${a[3]-the app}"
			dt_notifyp high "$t" dt_restart
			# The launch is spent: the note above says why it did not
			# start, so it is not said a second time when its process goes.
			x=${a[4]-}
			[ -z "$x" ] || unset DT_RTLAUNCH["$x"] DT_RTLFILE["$x"] DT_RTLTIME["$x"] DT_RTLPID["$x"]
			dt_rtdrop "$c"
			return 1
		fi
		# Whose it is comes from the launch, by its token, and each token
		# is good for one hello.
		x=${a[4]-}
		if [ -z "$x" ] || [ -z "${DT_RTLAUNCH["$x"]+x}" ]; then
			# "not kept" only from a desktop whose restart failed after it
			# asked its processes to stay (dt_rsuncarry): that one is final.
			# "no launch" may be a desktop that has not taken the launch yet
			# -- the old one, still serving before its exec -- and is tried
			# again until the rejoin's deadline.
			if [ -n "${DT_RSNOTKEPT-}" ]; then
				dt_rtsay "$c" "refused not%20kept"
			else
				dt_rtsay "$c" "refused no%20launch%20of%20this%20desktop's"
			fi
			dt_log "app runtime: refused a hello from ${a[3]:-nothing} with no launch of this desktop's behind it"
			dt_rtdrop "$c"
			return 1
		fi
		who=${DT_RTLAUNCH["$x"]}
		DT_RTCPID["$c"]=${DT_RTLPID["$x"]-}
		DT_RTCSTAMP["$c"]=${DT_RTLSTAMP["$x"]-}
		unset DT_RTLSTAMP["$x"] DT_RTLKEPT["$x"]
		DT_RTCFILE["$c"]=
		[ -z "${DT_RTLFILE["$x"]-}" ] || DT_RTCFILE["$c"] := dt_rtkindrel "${DT_RTLFILE["$x"]}"
		unset DT_RTLAUNCH["$x"] DT_RTLFILE["$x"] DT_RTLTIME["$x"] DT_RTLPID["$x"]
		[ "${a[3]-}" = "$who" ] ||
			dt_log "app runtime: a hello said it was ${a[3]:-nothing}; it is $who, by its launch"
		if ! dt_rtmay "$who"; then
			x="an installed app"
			[[ $who == */* ]] && x="a file an installable was registered from"
			dt_log "app runtime: refused a hello from $who, which is not $x"
			x := dt_rtline refused "$who is not $x"
			dt_rtsay "$c" "$x"
			[ "${#DT_RVP[@]}${#DT_RVB[@]}" = 00 ] || dt_rvxvoid "$who"
			dt_rtdrop "$c"
			return 1
		fi
		# What changed goes out first, before this connection is one of
		# its readers: it must never be sent an entry of a name it has not
		# yet been sent whole.
		dt_rtpass force
		DT_RTC["$c"]=$who
		DT_RTCTOK["$c"]=${a[4]}
		DT_RTTOKC["${a[4]}"]=$c
		DT_RTAPPS["$who"]=$((${DT_RTAPPS["$who"]:-0} + 1))
		# Every shared name this file reads, whole, in one write, before
		# its ok: what every other reader has, since the pass above.
		t=
		for x in "${!DT_SHARED[@]}"; do
			dt_rtwants "$c" "$x" || continue
			x := dt_rtcode "$x" "$who"
			t+=${t:+$'\n'}$x
		done
		dt_rtsay "$c" "$t" || return 1
		# And a one-time token for its cells channel, should it draw: given
		# here, on a connection already proved this launch's, never in any
		# environment (wm/rtview.hibr).
		t := dt_rttoken
		DT_RTCELLTOK["$t"]=$c
		dt_rtsay "$c" "ok $DT_RTPROTO $t" || return 1
		return 0
	fi
	case ${a[0]-} in
	tell)
		if [ -z "${DT_RTALLOW["${a[1]-}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]-nothing}, which is not a told request in interface.tsv"
			return 0
		fi
		if [ -z "${DT_RTMAY["$who ${a[1]}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]}, which its own file never asks for"
			return 0
		fi
		if [ -n "${DT_RTWIN["${a[1]}"]+x}" ] && ! dt_rtowns "$who" "${a[2]-}"; then
			dt_log "app runtime: $who asked for ${a[1]} of window ${a[2]-none}, which is not its own"
			return 0
		fi
		t0=${EPOCHREALTIME/./}
		DT_CALLER=$who DT_RTFROM=$c "${a[1]}" "${a[@]:2}" || dt_log "app runtime: $who's ${a[1]} failed"
		dt_spent "${a[1]}" "$((${EPOCHREALTIME/./} - t0))" "$who"
		;;
	ask)
		dt_rtanswer "$c" "$who" "${a[@]:1}"
		;;
	has)
		dt_rvhas_in "$c" "${a[@]:1}"
		;;
	took)
		dt_rvtook "$c" "${a[1]-}" "${a[2]-}" "${a[3]-}" "${a[4]-}"
		;;
	menus | context)
		dt_rvpush_in "$c" "${a[@]}"
		;;
	*)
		dt_log "app runtime: $who sent ${a[0]-nothing}, which is not carried yet"
		;;
	esac
	return 0
}

# An app's asked request: `ask SEQ UNTIL NAME WORDS...`, answered `answer SEQ
# STATUS KIND VALUE` -- KIND s a scalar, j a map as JSON, - nothing handed
# back -- once the pass has sent every change the request made, so the app
# reads what it asked for and what followed from it alike. UNTIL is the
# moment, in milliseconds, past which the app has stopped waiting: a request
# read after it is answered 125 and not run, or the desktop would make a
# window, say, that the app had already given up on. Guarded as a tell
# is; a refusal is answered (126) and logged, never left to the app's
# timeout. The desktop never waits on an app, so an app asking from inside
# a call the desktop made to it cannot hold either side.
fn dt_rtanswer(int c, who, seq, until, name = "", ...args) {
	local x k t0 st
	local -a r

	if [[ $until != +([0-9]) ]] || [ "$((${EPOCHREALTIME/./} / 1000))" -gt "$until" ]; then
		dt_log "app runtime: $who asked for ${name:-nothing} after it had stopped waiting; not run"
		dt_rtsay "$c" "answer $seq 125 - %"
		return 0
	fi
	if [ -z "${DT_RTASK["$name"]+x}" ]; then
		dt_log "app runtime: $who asked for ${name:-nothing}, which is not an asked request in interface.tsv"
		dt_rtsay "$c" "answer $seq 126 - %"
		return 0
	fi
	if [ -z "${DT_RTMAY["$who $name"]+x}" ]; then
		dt_log "app runtime: $who asked for $name, which its own file never asks for"
		dt_rtsay "$c" "answer $seq 126 - %"
		return 0
	fi
	if [ -n "${DT_RTWIN["$name"]+x}" ] && ! dt_rtowns "$who" "${args[0]-}"; then
		dt_log "app runtime: $who asked for $name of window ${args[0]-none}, which is not its own"
		dt_rtsay "$c" "answer $seq 126 - %"
		return 0
	fi
	t0=${EPOCHREALTIME/./}
	DT_CALLER=$who
	DT_RTFROM=$c
	if [ "${DT_RTASK["$name"]}" = bind ]; then
		x := "$name" "${args[@]}"
		st=$?
	else
		"$name" "${args[@]}"
		st=$?
	fi
	DT_CALLER=
	DT_RTFROM=
	dt_spent "$name" "$((${EPOCHREALTIME/./} - t0))" "$who"
	# What the request changed goes first, held or not.
	dt_rtpass force
	k=${x@a}
	if [[ $k == *[aA]* ]]; then
		x := json emit x
		k := dt_rtline answer "$seq" "$st" j "$x"
	elif [ -n "$x" ]; then
		k := dt_rtline answer "$seq" "$st" s "$x"
	else
		k := dt_rtline answer "$seq" "$st" - ""
	fi
	dt_rtsay "$c" "$k"
}
