# wm/rtserve -- the desktop's end of the app runtime's socket (ADR 0050):
# where an app's own process connects, says hello, and sends what it asks
# of the desktop. Listening starts when the first app process is about to
# be started, never at load: an idle desktop with none pays nothing, which
# tests/999-idle-tickers.t holds. A process speaking another protocol or
# another hibr version is refused and the person told hibr was updated,
# with Restart Desktop one click away (owner, 2026-11-18): nothing runs half
# old and half new. Only a told request named in interface.tsv is carried;
# anything else is refused by name in the log. Every answer goes out through
# dt_rtsay, send -p, which writes what the app takes now and keeps the rest
# for it, offered again every pass: a plain send to an app that had stopped
# reading waited until the app went (7.7 s, measured), the whole desktop
# stopped behind it; and an app that never reads again is let go once
# DT_RTQMAX waits for it. The guards are
# against an app's bugs and against blaming the wrong app, not a sandbox -- containment
# is not a goal (ADR 0050): only the desktop's own user connects, a hello
# names an installed app, an app makes only the requests its own file
# makes, and a request naming a window names one of the app's own.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The socket app processes reach, its descriptor, and every connection by
# descriptor: the app it said it was, or - before its hello.
DT_RTPATH=
DT_RTLFD=
declare -gA DT_RTC
# The launches the desktop has made and not yet heard from, token -> app:
# a hello names its launch by the token the process was started with, and
# the app is the launch's, never what the hello says of itself -- the point
# being blame, not a lock. Each connection's launch, both ways, so a tell
# reaches that one process and not the first of its name.
declare -gA DT_RTLAUNCH DT_RTCTOK DT_RTTOKC
# What each mirrored name was when it was last sent to every app process,
# so only a change goes out; and the names of the hot door, compared as one
# string each pass while an app is connected.
declare -gA DT_RTSENT
DT_RTHOT=()
DT_RTHOTSIG=
# The told requests interface.tsv names, which alone are carried; those
# whose first word is a window; and, per app, the requests its own file
# makes, read once from the file (never run) and kept by its path.
declare -gA DT_RTALLOW DT_RTWIN DT_RTMAY DT_RTMAYOF

# Start listening for app processes, once: the socket beside the control
# socket's, its path exported for what the desktop starts to inherit.
dt_rtlisten() {
	local p c f n a sg x

	[ -n "$DT_RTLFD" ] && return 0
	p := dt_ctlwhere
	p=${p%.ctl}.rt
	if ! [ -d "${p%/*}" ]; then
		mkdir -p -m 700 "${p%/*}" 2> /dev/null || { dt_log "app runtime: cannot make ${p%/*}"; return 1; }
	fi
	if ! [ -O "${p%/*}" ]; then
		dt_log "app runtime: ${p%/*} belongs to someone else; not listening"
		return 1
	fi
	if ! listen -b "$p" DT_RTLFD 2> /dev/null; then
		DT_RTLFD=
		dt_log "app runtime: cannot listen at $p"
		return 1
	fi
	DT_RTPATH=$p
	export DT_RTSOCK=$p
	while IFS=$'\t' read -r c f _ _ _ a _ sg _; do
		[ "$c" = request ] && [ "$a" = told ] || continue
		DT_RTALLOW["$f"]=1
		[[ $sg == "$f"\(id* || $sg == "$f(int id"* ]] && DT_RTWIN["$f"]=1
	done < "$DT_HERE/interface.tsv"
	# What every app has been sent is what is true now: a later change
	# is what goes out.
	for x in "${!DT_RTDOOR[@]}"; do
		case ${DT_RTDOOR["$x"]} in
		save | hello) DT_RTSENT["$x"] := dt_rtsig "$x" ;;
		hot) DT_RTHOT+=("$x"); DT_RTSENT["$x"] := dt_rtsig "$x" ;;
		esac
	done
	n=${#DT_RTALLOW[@]}
	command -v console > /dev/null && console watch "$DT_RTLFD" 2> /dev/null
	dt_ticker dt_rttick
	dt_log "app runtime: listening at $p, $n told requests carried"
	return 0
}

# How much of what the desktop says to one app may wait for the app to read
# it before the app is taken to have stopped reading and is let go, and the
# connections with something still waiting: each is offered it again every
# pass (a frame asked for while any is), so nothing said is left behind and
# a hung app cannot grow the desktop's memory past this.
DT_RTQMAX="${DT_RTQMAX-1048576}"
declare -gA DT_RTPEND

# A mirrored name's value, as one string to compare: a scalar's value, or a
# map's entries in their order.
fn dt_rtsig(name) {
	local k o=

	if [ "${DT_RTMAP["$name"]-}" = 1 ]; then
		local -n m=$name
		for k in "${!m[@]}"; do
			o+="$k=${m[$k]}"$'\n'
		done
		ret "$o"
		return 0
	fi
	ret "${!name-}"
}

# Send connection c what name holds now: `set NAME VALUE`, or for a map
# `clear NAME` and then `setk NAME KEY VALUE` for each entry.
fn dt_rtmirror(int c, name) {
	local k x

	if [ "${DT_RTMAP["$name"]-}" = 1 ]; then
		local -n m=$name
		x := dt_rtline clear "$name"
		dt_rtsay "$c" "$x" || return 1
		for k in "${!m[@]}"; do
			x := dt_rtline setk "$name" "$k" "${m[$k]}"
			dt_rtsay "$c" "$x" || return 1
		done
		return 0
	fi
	x := dt_rtline set "$name" "${!name-}"
	dt_rtsay "$c" "$x"
}

# Send every app process each name in names whose value has moved since it
# was last sent to them all.
fn dt_rtsendmoved(...names) {
	local n s c

	for n in "${names[@]}"; do
		s := dt_rtsig "$n"
		[ "$s" = "${DT_RTSENT["$n"]-}" ] && continue
		DT_RTSENT["$n"]=$s
		for c in "${!DT_RTC[@]}"; do
			[ "${DT_RTC["$c"]}" = - ] && continue
			dt_rtmirror "$c" "$n"
		done
	done
	return 0
}

# The settings' door: dt_save calls this on every change, and what moved
# goes to every app process.
dt_rtsettings() {
	local x
	local -a names

	[ "${#DT_RTC[@]}" = 0 ] && return 0
	for x in "${!DT_RTDOOR[@]}"; do
		[ "${DT_RTDOOR["$x"]}" = save ] && names+=("$x")
	done
	dt_rtsendmoved "${names[@]}"
}

# The hot door: the few scalars that change often, compared as one string,
# so a pass with nothing moved costs one comparison; and only while an app
# is connected.
dt_rthot() {
	local x s=

	[ "${#DT_RTC[@]}" = 0 ] && return 0
	for x in "${DT_RTHOT[@]}"; do
		s+="${!x-}"$'\t'
	done
	[ "$s" = "$DT_RTHOTSIG" ] && return 0
	DT_RTHOTSIG=$s
	dt_rtsendmoved "${DT_RTHOT[@]}"
}

# Every pass while listening: what woke the display is asked of it, so a
# connection with nothing to say costs nothing; each that did is read with
# dt_rtlines (wm/rtwire.hibr), which never waits, and its whole lines are
# carried, at most DT_RTLINES a pass.
dt_rttick() {
	local c x w st
	local -a ready got

	[ -n "$DT_RTLFD" ] || return 0
	dt_rthot
	for c in "${!DT_RTPEND[@]}"; do
		dt_rtsay "$c" ""
	done
	if command -v console > /dev/null; then
		w := console woke "$DT_RTLFD" "${!DT_RTC[@]}"
		read -ra ready <<< "$w"
	else
		ready=("$DT_RTLFD" "${!DT_RTC[@]}")
	fi
	for c in "${ready[@]}" "${!DT_RTMORE[@]}"; do
		if [ "$c" = "$DT_RTLFD" ]; then
			while accept -t 0 "$DT_RTLFD" x 2> /dev/null; do
				if [ "$REMOTE" != "uid:$UID" ]; then
					send -p "$x" "refused not%20this%20desktop's%20user" 2> /dev/null
					send -c "$x"
					exec {x}>&-
					dt_log "app runtime: refused a connection from $REMOTE"
					continue
				fi
				DT_RTC["$x"]=-
				DT_RTBUF["$x"]=
				command -v console > /dev/null && console watch "$x" 2> /dev/null
			done
			continue
		fi
		[ -n "${DT_RTC["$c"]+x}" ] || continue
		dt_rtlines "$c"
		st=$?
		if [ "$st" = 1 ]; then
			dt_rtdrop "$c"
			continue
		fi
		[ -n "${DT_RTMORE["$c"]+x}" ] && dt_want "${DT_TERMMS:-70}"
		got=("${DT_RTGOT[@]}")
		for x in "${got[@]}"; do
			dt_rtmsg "$c" "$x" || continue 2
		done
		if [ "$st" = 2 ]; then
			dt_log "app runtime: ${DT_RTC["$c"]} sent ${#DT_RTBUF["$c"]} bytes with no end of line; let go"
			dt_rtdrop "$c"
		fi
	done
	return 0
}

# A launch: a token no one can guess from outside, recorded as app's until
# a hello spends it. Answered with ret.
fn dt_rtissue(app) {
	local t

	read -r t < <(od -An -tx1 -N16 /dev/urandom)
	t=${t// /}
	DT_RTLAUNCH["$t"]=$app
	ret "$t"
}

# Start an app's own process from its file with three descriptors and no
# more: standard input and output /dev/null, never the desktop's terminal,
# so it can neither read the person's keys nor write over the screen;
# standard error the desktop's own, its log. Everything else the desktop
# holds -- the terminal under another number, its listening socket, other
# apps' connections -- is closed in the child before the program starts,
# since an app holding them would keep them open past the desktop's own
# close.
fn dt_rtspawn(app, file) {
	local f t

	t := dt_rtissue "$app"

	# /dev/fd is this process's own descriptors on Linux and macOS alike,
	# where /proc/self/fd is Linux's alone; a name that is not a number is
	# the pattern left unexpanded, and skipped.
	(
		for f in /dev/fd/*; do
			f=${f##*/}
			case $f in "" | *[!0-9]*) continue ;; esac
			[ "$f" -gt 2 ] && [ -e "/dev/fd/$f" ] && exec {f}>&-
		done
		DT_RTTOKEN=$t exec "$HIBR" "$file" < /dev/null > /dev/null
	) &
	dt_log "app runtime: started $app from $file as $!"
	ret "$t"
}

# Tell the process of one launch to run one of its own functions -- the
# one verb the desktop says today (ADR 0050): sent, never waited for.
# Status 1 when that launch has no connection.
fn dt_rttell(launch, name, ...args) {
	local c=${DT_RTTOKC["$launch"]-} x

	[ -n "$c" ] || return 1
	# A changed mirror goes out before a call that may read it.
	dt_rthot
	x := dt_rtline tell "$name" "${args[@]}"
	dt_rtsay "$c" "$x"
}

# Let a connection go.
fn dt_rtdrop(int c) {
	[ -n "${DT_RTC["$c"]+x}" ] || return 0
	command -v console > /dev/null && console unwatch "$c" 2> /dev/null
	send -c "$c"
	exec {c}>&-
	[ -z "${DT_RTCTOK["$c"]-}" ] || unset DT_RTTOKC["${DT_RTCTOK["$c"]}"]
	unset DT_RTC["$c"] DT_RTBUF["$c"] DT_RTMORE["$c"] DT_RTPEND["$c"] DT_RTCTOK["$c"]
	return 0
}

# Say a line to a connection, or with an empty line offer it what is still
# waiting: send -p writes what the app takes now and keeps the rest, never
# waiting. Status 1 when the connection was let go -- it had gone, or what
# waits for it passed DT_RTQMAX, which an app still reading never reaches.
fn dt_rtsay(int c, line) {
	local st

	send -p "$c" "$line" 2> /dev/null
	st=$?
	case $st in
	0)
		unset DT_RTPEND["$c"]
		return 0
		;;
	3)
		if [ "$RET" -gt "$DT_RTQMAX" ]; then
			dt_log "app runtime: ${DT_RTC["$c"]-a connection} stopped reading ($RET bytes waiting for it); let go"
			dt_rtdrop "$c"
			return 1
		fi
		DT_RTPEND["$c"]=1
		dt_want "${DT_TERMMS:-70}"
		return 0
		;;
	esac
	dt_rtdrop "$c"
	return 1
}

# Stop listening, let every app process go, and take the socket away: at
# Quit and before Restart Desktop's exec, as the control socket is. An app
# process sees its connection end.
dt_rtclose() {
	local c

	[ -n "$DT_RTLFD" ] || return 0
	for c in "${!DT_RTC[@]}"; do
		dt_rtdrop "$c"
	done
	command -v console > /dev/null && console unwatch "$DT_RTLFD" 2> /dev/null
	exec {DT_RTLFD}>&-
	DT_RTLFD=
	[ -n "$DT_RTPATH" ] && command rm -f -- "$DT_RTPATH"
	DT_RTPATH=
	return 0
}

# Whether name is an installed app, and if so what its own file may ask:
# the told requests the file's text names, read once per file and kept.
# Read, never run, as everything an app declares is (ADR 0050, 3).
fn dt_rtmay(name) {
	local src t f

	[ -n "$name" ] && [ -n "${DT_APPS["$name"]["title"]+x}" ] || return 1
	src=${DT_APPS["$name"]["src"]-}
	[ -n "$src" ] && [ -r "$src" ] || return 1
	[ "${DT_RTMAYOF["$name"]-}" = "$src" ] && return 0
	t=$(< "$src")
	for f in "${!DT_RTALLOW[@]}"; do
		[[ $t == *"$f"* ]] && DT_RTMAY["$name $f"]=1
	done
	DT_RTMAYOF["$name"]=$src
	return 0
}

# Whether a window is the app's own: one of its windows, or a dialog the
# desktop opened for one of them (a file picker).
fn dt_rtowns(who, id) {
	local f

	[[ $id =~ ^[0-9]+$ ]] || return 1
	dt_iswin "$id" || return 1
	[ "${DT[$id]["app"]-}" = "$who" ] && return 0
	f=${FP[$id]["for"]-}
	[ -n "$f" ] && dt_iswin "$f" && [ "${DT[$f]["app"]-}" = "$who" ]
}

# One message from a connection; status 1 when it was let go.
fn dt_rtmsg(int c, line) {
	local i x who=${DT_RTC["$c"]-} t t0
	local -a w a

	read -ra w <<< "$line"
	for i in "${!w[@]}"; do
		x := dt_rtdec "${w[$i]}"
		a+=("$x")
	done
	if [ "$who" = - ]; then
		if [ "${a[0]-}" != hello ]; then
			dt_rtsay "$c" "refused said%20nothing%20first"
			dt_rtdrop "$c"
			return 1
		fi
		if [ "${a[1]-}" != "$DT_RTPROTO" ] || [ "${a[2]-}" != "$HIBR_VERSION" ]; then
			x := dt_rtline refused "hibr $HIBR_VERSION protocol $DT_RTPROTO here, ${a[2]-?} protocol ${a[1]-?} there"
			dt_rtsay "$c" "$x"
			dt_log "app runtime: refused ${a[3]-an app}: hibr ${a[2]-?} protocol ${a[1]-?}, this desktop runs $HIBR_VERSION protocol $DT_RTPROTO"
			t := dt_tr "hibr was updated: click to restart the desktop and open %s" "${a[3]-the app}"
			dt_notifyp high "$t" dt_restart
			dt_rtdrop "$c"
			return 1
		fi
		# Whose it is comes from the launch, by its token, and each token
		# is good for one hello.
		x=${a[4]-}
		if [ -z "$x" ] || [ -z "${DT_RTLAUNCH["$x"]+x}" ]; then
			dt_rtsay "$c" "refused no%20launch%20of%20this%20desktop's"
			dt_log "app runtime: refused a hello from ${a[3]:-nothing} with no launch of this desktop's behind it"
			dt_rtdrop "$c"
			return 1
		fi
		who=${DT_RTLAUNCH["$x"]}
		unset DT_RTLAUNCH["$x"]
		[ "${a[3]-}" = "$who" ] ||
			dt_log "app runtime: a hello said it was ${a[3]:-nothing}; it is $who, by its launch"
		if ! dt_rtmay "$who"; then
			x := dt_rtline refused "$who is not an installed app"
			dt_rtsay "$c" "$x"
			dt_log "app runtime: refused a hello from $who, which is not an installed app"
			dt_rtdrop "$c"
			return 1
		fi
		DT_RTC["$c"]=$who
		DT_RTCTOK["$c"]=${a[4]}
		DT_RTTOKC["${a[4]}"]=$c
		# What it is sent, before its ok, so the app's first line after the
		# hello sees all of it.
		for x in "${!DT_RTDOOR[@]}"; do
			case ${DT_RTDOOR["$x"]} in
			save | hello | hot) dt_rtmirror "$c" "$x" || return 1 ;;
			esac
		done
		dt_rtsay "$c" "ok $DT_RTPROTO" || return 1
		return 0
	fi
	case ${a[0]-} in
	tell)
		if [ -z "${DT_RTALLOW["${a[1]-}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]-nothing}, which is not a told request in interface.tsv"
			return 0
		fi
		if [ -z "${DT_RTMAY["$who ${a[1]}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]}, which its own file never asks for"
			return 0
		fi
		if [ -n "${DT_RTWIN["${a[1]}"]+x}" ] && ! dt_rtowns "$who" "${a[2]-}"; then
			dt_log "app runtime: $who asked for ${a[1]} of window ${a[2]-none}, which is not its own"
			return 0
		fi
		t0=${EPOCHREALTIME/./}
		DT_CALLER=$who "${a[1]}" "${a[@]:2}" || dt_log "app runtime: $who's ${a[1]} failed"
		dt_spent "${a[1]}" "$((${EPOCHREALTIME/./} - t0))" "$who"
		;;
	*)
		dt_log "app runtime: $who sent ${a[0]-nothing}, which is not carried yet"
		;;
	esac
	return 0
}
