# wm/rtserve -- the desktop's end of the app runtime's socket (ADR 0050):
# where an app's own process connects, says hello, and sends what it asks
# of the desktop. Listening starts when the first app process is about to
# be started, never at load: an idle desktop with none pays nothing, which
# tests/999-idle-tickers.t holds. A process speaking another protocol or
# another hibr version is refused and the person told hibr was updated,
# with Restart Desktop one click away (owner, 2026-11-18): nothing runs half
# old and half new. Only a told request named in interface.tsv is carried;
# anything else is refused by name in the log. Every answer goes out through
# dt_rtsay, send -p, which writes what the app takes now and keeps the rest
# for it, offered again every pass: a plain send to an app that had stopped
# reading waited until the app went (7.7 s, measured), the whole desktop
# stopped behind it; and an app that never reads again is let go once
# DT_RTQMAX waits for it. The guards are
# against an app's bugs and against blaming the wrong app, not a sandbox -- containment
# is not a goal (ADR 0050): only the desktop's own user connects, a hello
# names an installed app, an app makes only the requests its own file
# makes, and a request naming a window names one of the app's own.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The socket app processes reach, its descriptor, and every connection by
# descriptor: the app it said it was, or - before its hello.
DT_RTPATH=
DT_RTLFD=
declare -gA DT_RTC
# The launches the desktop has made and not yet heard from, token -> app:
# a hello names its launch by the token the process was started with, and
# the app is the launch's, never what the hello says of itself -- the point
# being blame, not a lock. Each connection's launch, both ways, so a tell
# reaches that one process and not the first of its name.
declare -gA DT_RTLAUNCH DT_RTCTOK DT_RTTOKC
# What each mirrored name was when it was last sent to every app process,
# so only a change goes out; and the names of the hot door, compared as one
# string each pass while an app is connected.
declare -gA DT_RTSENT
# Each mirrored name's lines as they cross, kept encoded and made again only
# when the name moves, so a hello joins what is kept and sends it at once:
# encoding about two hundred names and sending them a line at a time took
# 20 ms of one pass, measured.
declare -gA DT_RTLINE
DT_RTHOT=()
DT_RTHOTSIG=
# What each connection was last sent of each of its app's windows, "C ID"
# -> the fields joined: the window door. And the apps with a connection,
# with how many, so a frame drawing a window asks one lookup whether any
# process is to be told of it.
declare -gA DT_RTWSIG DT_RTAPPS
# The told requests interface.tsv names, which alone are carried; those
# whose first word is a window; and, per app, the requests its own file
# makes, read once from the file (never run) and kept by its path.
declare -gA DT_RTALLOW DT_RTWIN DT_RTMAY DT_RTMAYOF

# Start listening for app processes, once: the socket beside the control
# socket's, its path exported for what the desktop starts to inherit.
dt_rtlisten() {
	local p c f n a sg x

	[ -n "$DT_RTLFD" ] && return 0
	p := dt_ctlwhere
	p=${p%.ctl}.rt
	if ! [ -d "${p%/*}" ]; then
		mkdir -p -m 700 "${p%/*}" 2> /dev/null || { dt_log "app runtime: cannot make ${p%/*}"; return 1; }
	fi
	if ! [ -O "${p%/*}" ]; then
		dt_log "app runtime: ${p%/*} belongs to someone else; not listening"
		return 1
	fi
	if ! listen -b "$p" DT_RTLFD 2> /dev/null; then
		DT_RTLFD=
		dt_log "app runtime: cannot listen at $p"
		return 1
	fi
	DT_RTPATH=$p
	export DT_RTSOCK=$p
	while IFS=$'\t' read -r c f _ _ _ a _ sg _; do
		[ "$c" = request ] && [ "$a" = told ] || continue
		DT_RTALLOW["$f"]=1
		[[ $sg == "$f"\(id* || $sg == "$f(int id"* ]] && DT_RTWIN["$f"]=1
	done < "$DT_HERE/interface.tsv"
	# What every app has been sent is what is true now: a later change
	# is what goes out. A second listen starts the hot list afresh.
	DT_RTHOT=()
	DT_RTHOTSIG=
	for x in "${!DT_RTDOOR[@]}"; do
		case ${DT_RTDOOR["$x"]} in
		save | hello) DT_RTSENT["$x"] := dt_rtsig "$x" ;;
		hot) DT_RTHOT+=("$x"); DT_RTSENT["$x"] := dt_rtsig "$x" ;;
		esac
	done
	n=${#DT_RTALLOW[@]}
	command -v console > /dev/null && console watch "$DT_RTLFD" 2> /dev/null
	dt_ticker dt_rttick
	dt_log "app runtime: listening at $p, $n told requests carried"
	return 0
}

# How much of what the desktop says to one app may wait for the app to read
# it before the app is taken to have stopped reading and is let go, and the
# connections with something still waiting: each is offered it again every
# pass (a frame asked for while any is), so nothing said is left behind and
# a hung app cannot grow the desktop's memory past this.
DT_RTQMAX="${DT_RTQMAX-1048576}"
DT_RTQSECS="${DT_RTQSECS-2}"
declare -gA DT_RTPENDB DT_RTPENDT
declare -gA DT_RTPEND

# A mirrored name's value, as one string to compare: a scalar's value, or a
# map's entries in their order.
fn dt_rtsig(name) {
	local o

	if [ "${DT_RTMAP["$name"]-}" = 1 ]; then
		o := json emit "$name"
		ret "$o"
		return 0
	fi
	ret "${!name-}"
}

# What name holds now as the line that carries it, kept in DT_RTLINE: `set
# NAME VALUE`, or for a map or a list `json NAME TEXT`, the whole of it --
# nested entries, a list's every element and the order -- where a line per
# key carried a list's first element and a nested map's scalars alone.
fn dt_rtencode(name) {
	local o j

	if [ "${DT_RTMAP["$name"]-}" = 1 ]; then
		j := dt_rtwhole "$name"
		o := dt_rtline json "$name" "$j"
	else
		o := dt_rtline set "$name" "${!name-}"
	fi
	DT_RTLINE["$name"]=$o
	return 0
}

# A map or a list as JSON, the whole of it, less the fields of its records
# whose door is the call (DT_RTSKIP): those move with a frame or input, and
# travel in the call that uses them.
fn dt_rtwhole(name) {
	local j k f
	local -a sk

	j := json emit "$name" 2> /dev/null || j="{}"
	if [ -n "${DT_RTSKIP["$name"]-}" ]; then
		local -A cp
		read -ra sk <<< "${DT_RTSKIP["$name"]}"
		json parse cp <<< "$j"
		for k in "${!cp[@]}"; do
			for f in "${sk[@]}"; do
				unset cp["$k"]["$f"]
			done
		done
		j := json emit cp
	fi
	ret "$j"
}

# Whether connection c is sent registry name: when the app interface reads
# it, or the file that connected does; a file the survey never read is sent
# every registry but a secret, so it is never silently empty.
fn dt_rtwants(int c, name) {
	local a=${DT_RTAUD["$name"]-} f=${DT_RTCFILE["$c"]-}

	[ "$a" = "*" ] && return 0
	if [ -z "$f" ] || [ -z "${DT_RTKNOWN["$f"]+x}" ]; then
		[ -z "${DT_RTSECRET["$name"]+x}" ]
		return
	fi
	case " $a " in *" $f "*) return 0 ;; esac
	return 1
}

# The registries marked since the last pass. One marked whole is encoded
# again, and when what it holds moved its generation goes up; every
# connection that reads it and holds an older generation is sent it, so a
# mark with nothing moved sends nothing. One marked by entry is sent those
# entries -- `jsonk NAME KEY JSON`, or `unsetk NAME KEY` for one gone -- and
# every reader is then current at a new generation, with the whole encoding
# made again only when somebody needs it. What each connection holds is a
# number, never a copy.
dt_rtregflush() {
	local n c s g
	local -a keys out

	for n in "${!DT_RTREGQ[@]}"; do
		unset DT_RTREGQ["$n"] DT_RTREGK["$n"]
		[ "${DT_RTDOOR["$n"]-}" = registry ] || continue
		s := dt_rtcode "$n"
		if [ "$s" != "${DT_RTLINE["$n"]-}" ]; then
			DT_RTLINE["$n"]=$s
			DT_RTGEN["$n"]=$((${DT_RTGEN["$n"]:-0} + 1))
		fi
		g=${DT_RTGEN["$n"]:-0}
		for c in "${!DT_RTC[@]}"; do
			[ "${DT_RTC["$c"]}" = - ] && continue
			dt_rtwants "$c" "$n" || continue
			[ "${DT_RTREGS["$c $n"]-}" = "$g" ] && continue
			DT_RTREGS["$c $n"]=$g
			dt_rtsay "$c" "$s"
		done
	done
	for n in "${!DT_RTREGK[@]}"; do
		mapfile -t keys <<< "${DT_RTREGK["$n"]%$'\n'}"
		unset DT_RTREGK["$n"]
		[ "${DT_RTDOOR["$n"]-}" = registry ] || continue
		dt_rtentlines "$n" "${keys[@]}"
		out=("${DT_RTOUT[@]}")
		unset DT_RTLINE["$n"]
		g=$((${DT_RTGEN["$n"]:-0} + 1))
		DT_RTGEN["$n"]=$g
		for c in "${!DT_RTC[@]}"; do
			[ "${DT_RTC["$c"]}" = - ] && continue
			dt_rtwants "$c" "$n" || continue
			DT_RTREGS["$c $n"]=$g
			for s in "${out[@]}"; do
				dt_rtsay "$c" "$s" || break
			done
		done
	done
	return 0
}

# A registry's line as it would cross now: `set NAME VALUE` or `json NAME
# TEXT`.
fn dt_rtcode(name) {
	local j x

	if [ "${DT_RTMAP["$name"]-}" = 1 ]; then
		j := dt_rtwhole "$name"
		x := dt_rtline json "$name" "$j"
	else
		x := dt_rtline set "$name" "${!name-}"
	fi
	ret "$x"
}

# The lines that carry these entries of a map as it holds them now, into
# DT_RTOUT: `jsonk NAME KEY JSON` for each still there, `unsetk NAME KEY`
# for each gone. A key marked twice is sent once.
DT_RTOUT=()
fn dt_rtentlines(name, ...keys) {
	local k j s
	local -A seen
	local -n m=$name

	DT_RTOUT=()
	for k in "${keys[@]}"; do
		[ -n "${seen["$k"]+x}" ] && continue
		seen["$k"]=1
		if [ -n "${m["$k"]+x}" ] || [ "${#m["$k"][@]}" -gt 0 ]; then
			j := dt_rtentry "$name" "$k"
			s := dt_rtline jsonk "$name" "$k" "$j"
		else
			s := dt_rtline unsetk "$name" "$k"
		fi
		DT_RTOUT+=("$s")
	done
	return 0
}

# One entry of a map as JSON: a record's fields, or a value.
fn dt_rtentry(name, key) {
	local f v
	local -a ks
	local -A e
	local -n m=$name

	# A record is an entry with fields; asked by its keys, since through a
	# nameref an entry at key 0 holding only fields reads as the name the
	# nameref holds (Gitea #595).
	ks=("${!m["$key"][@]}")
	if [ "${#ks[@]}" -gt 0 ]; then
		for f in "${ks[@]}"; do
			e["$f"]=${m["$key"]["$f"]}
		done
		v := json emit e
	else
		v=${m["$key"]}
		v := json emit v
	fi
	ret "$v"
}

# Under the harness, once a second: every registry that moved since the last
# look with no mark is named, as a late: line is, so a writer the survey
# cannot read -- a form of write it does not know -- fails a suite rather
# than leaving an app with an old table.
dt_rtregcheck() {
	local n s x

	[ "$EPOCHSECONDS" != "$DT_RTREGT" ] || return 0
	DT_RTREGT=$EPOCHSECONDS
	for n in "${!DT_RTDOOR[@]}"; do
		[ "${DT_RTDOOR["$n"]}" = registry ] || continue
		if [ "${DT_RTMAP["$n"]-}" = 1 ]; then
			s := dt_rtwhole "$n"
		else
			s=${!n-}
		fi
		if [ -n "${DT_RTREGC["$n"]+x}" ] && [ "$s" != "${DT_RTREGC["$n"]}" ] &&
			[ -z "${DT_RTREGM["$n"]+x}" ]; then
			x := dt_rtdiffat "${DT_RTREGC["$n"]}" "$s"
			if [ -n "${DT_RTSECRET["$n"]+x}" ]; then
				dt_log "unmarked: the registry $n moved with no dt_rtreg $n (a secret: not shown)"
			else
				dt_log "unmarked: the registry $n moved with no dt_rtreg $n (now ...${s:x:80}...)"
			fi
		fi
		DT_RTREGC["$n"]=$s
	done
	DT_RTREGM=()
	return 0
}
# Where two texts first differ, a little before it: what an unmarked line
# shows of the table, so it names the entry that moved.
fn dt_rtdiffat(a, b) {
	local lo=0 hi=${#a} m

	[ "${#b}" -lt "$hi" ] && hi=${#b}
	while [ "$lo" -lt "$hi" ]; do
		m=$(((lo + hi + 1) / 2))
		if [ "${a:0:m}" = "${b:0:m}" ]; then lo=$m; else hi=$((m - 1)); fi
	done
	m=$((lo - 30))
	[ "$m" -ge 0 ] || m=0
	ret "$m"
}
# Each registry's generation, and the generation of it each connection holds.
declare -gA DT_RTREGC DT_RTCFILE DT_RTREGS DT_RTGEN
DT_RTREGT=
[ -z "${DT_TESTIDLE-}" ] || dt_ticker dt_rtregcheck

# Send connection c what name holds now, from the lines kept for it.
fn dt_rtmirror(int c, name) {
	[ -n "${DT_RTLINE["$name"]+x}" ] || dt_rtencode "$name"
	dt_rtsay "$c" "${DT_RTLINE["$name"]}"
}

# Send every app process each name in names whose value has moved since it
# was last sent to them all.
fn dt_rtsendmoved(...names) {
	local n s c

	for n in "${names[@]}"; do
		s := dt_rtsig "$n"
		[ "$s" = "${DT_RTSENT["$n"]-}" ] && continue
		DT_RTSENT["$n"]=$s
		dt_rtencode "$n"
		for c in "${!DT_RTC[@]}"; do
			[ "${DT_RTC["$c"]}" = - ] && continue
			dt_rtmirror "$c" "$n"
		done
	done
	return 0
}

# The settings' door: dt_save calls this on every change, and what moved
# goes to every app process.
dt_rtsettings() {
	local x
	local -a names

	[ -n "$DT_RTLFD" ] || return 0
	for x in "${!DT_RTDOOR[@]}"; do
		[ "${DT_RTDOOR["$x"]}" = save ] && names+=("$x")
	done
	dt_rtsendmoved "${names[@]}"
}

# The window door: each app process is sent its own app's windows' records
# -- the fields installables read (DT_RTWINF), as one `win ID FIELD VALUE
# ...` line when any moved -- and `wingone ID` when one has gone. A window
# is the app's when its record names it; other apps' windows are not sent.
# A record that changes in any way an app reads is drawn again, and one
# that has not is left alone, so the frame is the door: dt_rtwin1 after a
# window of a connected app is drawn (wm/draw.hibr), about 15 us, and
# nothing on a pass that draws none; dt_rtwinsc, every window of one
# connection's app, at its hello and before every tell, so a call never
# arrives ahead of its window. A window being moved or sized waits until
# it stops: a solid drag would be a line a step. Walking every window every
# pass cost 244 us with five apps of two windows each, measured.

# Send connection c window id's record, when it moved since c was last sent it.
fn dt_rtwinto(int c, int id) {
	local f s= x
	local -a w=(win "$id")

	[ "$id" = "${DT_DRAG-}" ] || [ "$id" = "${DT_SIZE-}" ] && return 0
	for f in "${DT_RTWINF[@]}"; do
		s+="${DT[$id]["$f"]-}"$'\t'
		w+=("$f" "${DT[$id]["$f"]-}")
	done
	[ "$s" = "${DT_RTWSIG["$c $id"]-}" ] && return 0
	DT_RTWSIG["$c $id"]=$s
	x := dt_rtline "${w[@]}"
	dt_rtsay "$c" "$x"
}

# A window of a connected app was drawn: every connection of its app is sent
# it, if it moved.
fn dt_rtwin1(int id) {
	local c ap=${DT[$id]["app"]-}

	for c in "${!DT_RTC[@]}"; do
		[ "${DT_RTC["$c"]}" = "$ap" ] && dt_rtwinto "$c" "$id"
	done
	return 0
}

# Every window of connection c's app, and those it was sent that have gone.
fn dt_rtwinsc(int c) {
	local ap=${DT_RTC["$c"]-} id k x

	[ -n "$ap" ] && [ "$ap" != - ] || return 0
	for id in "${DT_WINS[@]}"; do
		[ "${DT[$id]["app"]-}" = "$ap" ] && dt_rtwinto "$c" "$id"
	done
	for k in "${!DT_RTWSIG[@]}"; do
		[ "${k%% *}" = "$c" ] || continue
		id=${k#* }
		dt_iswin "$id" && [ "${DT[$id]["app"]-}" = "$ap" ] && continue
		unset DT_RTWSIG["$k"]
		x := dt_rtline wingone "$id"
		dt_rtsay "$c" "$x"
	done
	return 0
}

# Forget what connection c was sent of its windows, as it goes.
fn dt_rtwforget(int c) {
	local k

	for k in "${!DT_RTWSIG[@]}"; do
		[ "${k%% *}" = "$c" ] && unset DT_RTWSIG["$k"]
	done
	return 0
}

# The hot door: the few scalars that change often, compared as one string,
# so a pass with nothing moved costs one comparison; and only while an app
# is connected.
dt_rthot() {
	local x s=

	[ "${#DT_RTC[@]}" = 0 ] && return 0
	[ "${#DT_RTREGQ[@]}${#DT_RTREGK[@]}" = 00 ] || dt_rtregflush
	for x in "${DT_RTHOT[@]}"; do
		s+="${!x-}"$'\t'
	done
	[ "$s" = "$DT_RTHOTSIG" ] && return 0
	DT_RTHOTSIG=$s
	dt_rtsendmoved "${DT_RTHOT[@]}"
}

# Every pass while listening: what woke the display is asked of it, so a
# connection with nothing to say costs nothing; each that did is read with
# dt_rtlines (wm/rtwire.hibr), which never waits, and its whole lines are
# carried, at most DT_RTLINES a pass.
dt_rttick() {
	local c x w st
	local -a ready got

	[ -n "$DT_RTLFD" ] || return 0
	[ "${#DT_RTLAUNCH[@]}" = 0 ] || dt_rtlaunches
	dt_rthot
	for c in "${!DT_RTPEND[@]}"; do
		dt_rtsay "$c" ""
	done
	if command -v console > /dev/null; then
		w := console woke "$DT_RTLFD" "${!DT_RTC[@]}"
		read -ra ready <<< "$w"
	else
		ready=("$DT_RTLFD" "${!DT_RTC[@]}")
	fi
	for c in "${ready[@]}" "${!DT_RTMORE[@]}"; do
		if [ "$c" = "$DT_RTLFD" ]; then
			while accept -t 0 "$DT_RTLFD" x 2> /dev/null; do
				if [ "$REMOTE" != "uid:$UID" ]; then
					send -p "$x" "refused not%20this%20desktop's%20user" 2> /dev/null
					send -c "$x"
					exec {x}>&-
					dt_log "app runtime: refused a connection from $REMOTE"
					continue
				fi
				DT_RTC["$x"]=-
				DT_RTBUF["$x"]=
				command -v console > /dev/null && console watch "$x" 2> /dev/null
			done
			continue
		fi
		[ -n "${DT_RTC["$c"]+x}" ] || continue
		dt_rtlines "$c"
		st=$?
		if [ "$st" = 1 ]; then
			dt_rtdrop "$c"
			continue
		fi
		[ -n "${DT_RTMORE["$c"]+x}" ] && dt_want "${DT_TERMMS:-70}"
		got=("${DT_RTGOT[@]}")
		for x in "${got[@]}"; do
			dt_rtmsg "$c" "$x" || continue 2
		done
		if [ "$st" = 2 ]; then
			dt_log "app runtime: ${DT_RTC["$c"]} sent ${#DT_RTBUF["$c"]} bytes with no end of line; let go"
			dt_rtdrop "$c"
		fi
	done
	return 0
}

# A launch: a token no one can guess from outside, recorded as app's until
# a hello spends it. Answered with ret.
fn dt_rtissue(app, file = "") {
	local t

	read -r t < <(od -An -tx1 -N16 /dev/urandom)
	t=${t// /}
	DT_RTLAUNCH["$t"]=$app
	DT_RTLFILE["$t"]=$file
	DT_RTLTIME["$t"]=$EPOCHSECONDS
	ret "$t"
}

# A file as the kind folder it is in sees it, apps/files.hibr, wherever the
# scope holding it is -- what DT_RTAUD and DT_RTKNOWN name it by.
fn dt_rtkindrel(f) {
	local k r=$f t

	for k in apps system control-panel control-strip menubar savers; do
		case $f in
		*/"$k"/*)
			t="$k/${f##*/"$k"/}"
			[ "${#t}" -lt "${#r}" ] && r=$t
			;;
		esac
	done
	ret "$r"
}
# When each launch was issued, and the process a spawn started for it: a
# token is good for DT_RTLAUNCHSECS, and a launch whose process has gone
# before its hello is reported at once (dt_rtlaunches).
declare -gA DT_RTLFILE DT_RTLTIME DT_RTLPID
DT_RTLAUNCHSECS="${DT_RTLAUNCHSECS-15}"

# Launches not yet spent: one whose process has exited, or whose time is up,
# is void -- its token refused from then on -- and said once, in the log and
# to the person, since an app that never came is otherwise only an absence.
# Asked only while a launch is pending, so a pass with none costs one test.
dt_rtlaunches() {
	local t p why

	for t in "${!DT_RTLAUNCH[@]}"; do
		p=${DT_RTLPID["$t"]-}
		why=
		if [ -n "$p" ] && ! kill -0 "$p" 2> /dev/null; then
			why="exited before it said hello"
		elif [ $((EPOCHSECONDS - ${DT_RTLTIME["$t"]:-0})) -ge "$DT_RTLAUNCHSECS" ]; then
			why="did not say hello within $DT_RTLAUNCHSECS seconds"
		fi
		[ -n "$why" ] || continue
		dt_log "app runtime: ${DT_RTLAUNCH["$t"]} started from ${DT_RTLFILE["$t"]:-nothing} $why; its launch is void"
		# A note from a ticker asks for the frame that shows it, or it
		# expires before anything draws.
		if [ -n "${DT_RTLFILE["$t"]-}" ]; then
			dt_notep normal "%s did not start" "${DT_RTLAUNCH["$t"]}"
			dt_want 30
		fi
		unset DT_RTLAUNCH["$t"] DT_RTLFILE["$t"] DT_RTLTIME["$t"] DT_RTLPID["$t"]
	done
	return 0
}

# Start an app's own process from its file with three descriptors and no
# more: standard input and output /dev/null, never the desktop's terminal,
# so it can neither read the person's keys nor write over the screen;
# standard error the desktop's own, its log. Everything else the desktop
# holds -- the terminal under another number, its listening socket, other
# apps' connections -- is closed in the child before the program starts,
# since an app holding them would keep them open past the desktop's own
# close.
fn dt_rtspawn(app, file) {
	local f t

	t := dt_rtissue "$app" "$file"

	# /dev/fd is this process's own descriptors on Linux and macOS alike,
	# where /proc/self/fd is Linux's alone; a name that is not a number is
	# the pattern left unexpanded, and skipped.
	(
		for f in /dev/fd/*; do
			f=${f##*/}
			case $f in "" | *[!0-9]*) continue ;; esac
			[ "$f" -gt 2 ] && [ -e "/dev/fd/$f" ] && exec {f}>&-
		done
		DT_RTTOKEN=$t exec "$HIBR" "$file" < /dev/null > /dev/null
	) &
	DT_RTLPID["$t"]=$!
	dt_log "app runtime: started $app from $file as $!"
	ret "$t"
}

# Tell the process of one launch to run one of its own functions -- the
# one verb the desktop says today (ADR 0050): sent, never waited for.
# Status 1 when that launch has no connection.
fn dt_rttell(launch, name, ...args) {
	local c=${DT_RTTOKC["$launch"]-} x

	[ -n "$c" ] || return 1
	# A changed mirror, or a window of its own, goes out before a call
	# that may read it.
	dt_rthot
	dt_rtwinsc "$c"
	x := dt_rtline tell "$name" "${args[@]}"
	dt_rtsay "$c" "$x"
}

# Let a connection go.
fn dt_rtdrop(int c) {
	local x k

	[ -n "${DT_RTC["$c"]+x}" ] || return 0
	command -v console > /dev/null && console unwatch "$c" 2> /dev/null
	send -c "$c"
	exec {c}>&-
	[ -z "${DT_RTCTOK["$c"]-}" ] || unset DT_RTTOKC["${DT_RTCTOK["$c"]}"]
	x=${DT_RTC["$c"]}
	if [ "$x" != - ] && [ -n "${DT_RTAPPS["$x"]-}" ]; then
		DT_RTAPPS["$x"]=$((DT_RTAPPS["$x"] - 1))
		[ "${DT_RTAPPS["$x"]}" -gt 0 ] || unset DT_RTAPPS["$x"]
	fi
	unset DT_RTC["$c"] DT_RTBUF["$c"] DT_RTMORE["$c"] DT_RTPEND["$c"] DT_RTCTOK["$c"] DT_RTCFILE["$c"]
	unset DT_RTPENDB["$c"] DT_RTPENDT["$c"]
	for k in "${!DT_RTREGS[@]}"; do
		[ "${k%% *}" = "$c" ] && unset DT_RTREGS["$k"]
	done
	dt_rtwforget "$c"
	return 0
}

# Say a line to a connection, or with an empty line offer it what is still
# waiting: send -p writes what the app takes now and keeps the rest, never
# waiting. Status 1 when the connection was let go -- it had gone, or what
# waits for it passed DT_RTQMAX, which an app still reading never reaches.
fn dt_rtsay(int c, line) {
	local st

	send -p "$c" "$line" 2> /dev/null
	st=$?
	case $st in
	0)
		unset DT_RTPEND["$c"] DT_RTPENDB["$c"] DT_RTPENDT["$c"]
		return 0
		;;
	3)
		# Shrinking since it was last looked at is reading: the time is
		# kept, and only a backlog past DT_RTQMAX that has not shrunk for
		# DT_RTQSECS is an app that stopped -- one line longer than the
		# limit, the clipboard's history at a hello, is not.
		if [ "$RET" -lt "${DT_RTPENDB["$c"]:-0}" ] || [ -z "${DT_RTPENDT["$c"]-}" ] ||
			[ "${DT_RTPENDB["$c"]:-0}" -le "$DT_RTQMAX" ]; then
			DT_RTPENDT["$c"]=$EPOCHSECONDS
		fi
		DT_RTPENDB["$c"]=$RET
		if [ "$RET" -gt "$DT_RTQMAX" ] && [ $((EPOCHSECONDS - DT_RTPENDT["$c"])) -ge "$DT_RTQSECS" ]; then
			dt_log "app runtime: ${DT_RTC["$c"]-a connection} stopped reading ($RET bytes waiting for it); let go"
			dt_rtdrop "$c"
			return 1
		fi
		DT_RTPEND["$c"]=1
		dt_want "${DT_TERMMS:-70}"
		return 0
		;;
	esac
	dt_rtdrop "$c"
	return 1
}

# Stop listening, let every app process go, and take the socket away: at
# Quit and before Restart Desktop's exec, as the control socket is. An app
# process sees its connection end.
dt_rtclose() {
	local c

	[ -n "$DT_RTLFD" ] || return 0
	for c in "${!DT_RTC[@]}"; do
		dt_rtdrop "$c"
	done
	command -v console > /dev/null && console unwatch "$DT_RTLFD" 2> /dev/null
	exec {DT_RTLFD}>&-
	DT_RTLFD=
	[ -n "$DT_RTPATH" ] && command rm -f -- "$DT_RTPATH"
	DT_RTPATH=
	return 0
}

# Whether name is an installed app, and if so what its own file may ask:
# the told requests the file's text names, read once per file and kept.
# Read, never run, as everything an app declares is (ADR 0050, 3).
fn dt_rtmay(name) {
	local src t f

	[ -n "$name" ] && [ -n "${DT_APPS["$name"]["title"]+x}" ] || return 1
	src=${DT_APPS["$name"]["src"]-}
	[ -n "$src" ] && [ -r "$src" ] || return 1
	[ "${DT_RTMAYOF["$name"]-}" = "$src" ] && return 0
	t=$(< "$src")
	for f in "${!DT_RTALLOW[@]}"; do
		[[ $t == *"$f"* ]] && DT_RTMAY["$name $f"]=1
	done
	DT_RTMAYOF["$name"]=$src
	return 0
}

# Whether a window is the app's own: one of its windows, or a dialog the
# desktop opened for one of them (a file picker).
fn dt_rtowns(who, id) {
	local f

	[[ $id =~ ^[0-9]+$ ]] || return 1
	dt_iswin "$id" || return 1
	[ "${DT[$id]["app"]-}" = "$who" ] && return 0
	f=${FP[$id]["for"]-}
	[ -n "$f" ] && dt_iswin "$f" && [ "${DT[$f]["app"]-}" = "$who" ]
}

# One message from a connection; status 1 when it was let go.
fn dt_rtmsg(int c, line) {
	local i x who=${DT_RTC["$c"]-} t t0
	local -a w a

	read -ra w <<< "$line"
	for i in "${!w[@]}"; do
		x := dt_rtdec "${w[$i]}"
		a+=("$x")
	done
	if [ "$who" = - ]; then
		if [ "${a[0]-}" != hello ]; then
			dt_rtsay "$c" "refused said%20nothing%20first"
			dt_rtdrop "$c"
			return 1
		fi
		if [ "${a[1]-}" != "$DT_RTPROTO" ] || [ "${a[2]-}" != "$HIBR_VERSION" ]; then
			x := dt_rtline refused "hibr $HIBR_VERSION protocol $DT_RTPROTO here, ${a[2]-?} protocol ${a[1]-?} there"
			dt_rtsay "$c" "$x"
			dt_log "app runtime: refused ${a[3]-an app}: hibr ${a[2]-?} protocol ${a[1]-?}, this desktop runs $HIBR_VERSION protocol $DT_RTPROTO"
			t := dt_tr "hibr was updated: click to restart the desktop and open %s" "${a[3]-the app}"
			dt_notifyp high "$t" dt_restart
			# The launch is spent: the note above says why it did not
			# start, so it is not said a second time when its process goes.
			x=${a[4]-}
			[ -z "$x" ] || unset DT_RTLAUNCH["$x"] DT_RTLFILE["$x"] DT_RTLTIME["$x"] DT_RTLPID["$x"]
			dt_rtdrop "$c"
			return 1
		fi
		# Whose it is comes from the launch, by its token, and each token
		# is good for one hello.
		x=${a[4]-}
		if [ -z "$x" ] || [ -z "${DT_RTLAUNCH["$x"]+x}" ]; then
			dt_rtsay "$c" "refused no%20launch%20of%20this%20desktop's"
			dt_log "app runtime: refused a hello from ${a[3]:-nothing} with no launch of this desktop's behind it"
			dt_rtdrop "$c"
			return 1
		fi
		who=${DT_RTLAUNCH["$x"]}
		DT_RTCFILE["$c"]=
		[ -z "${DT_RTLFILE["$x"]-}" ] || DT_RTCFILE["$c"] := dt_rtkindrel "${DT_RTLFILE["$x"]}"
		unset DT_RTLAUNCH["$x"] DT_RTLFILE["$x"] DT_RTLTIME["$x"] DT_RTLPID["$x"]
		[ "${a[3]-}" = "$who" ] ||
			dt_log "app runtime: a hello said it was ${a[3]:-nothing}; it is $who, by its launch"
		if ! dt_rtmay "$who"; then
			x := dt_rtline refused "$who is not an installed app"
			dt_rtsay "$c" "$x"
			dt_log "app runtime: refused a hello from $who, which is not an installed app"
			dt_rtdrop "$c"
			return 1
		fi
		DT_RTC["$c"]=$who
		DT_RTCTOK["$c"]=${a[4]}
		DT_RTTOKC["${a[4]}"]=$c
		DT_RTAPPS["$who"]=$((${DT_RTAPPS["$who"]:-0} + 1))
		# Whatever was marked goes out first, so a registry's kept line is
		# what it holds now and the generation recorded below is true.
		[ "${#DT_RTREGQ[@]}${#DT_RTREGK[@]}" = 00 ] || dt_rtregflush
		# What it is sent, before its ok, so the app's first line after the
		# hello sees all of it: the kept lines joined, in one write.
		t=
		for x in "${!DT_RTDOOR[@]}"; do
			case ${DT_RTDOOR["$x"]} in
			save | hello | hot) ;;
			registry) dt_rtwants "$c" "$x" || continue ;;
			*) continue ;;
			esac
			[ -n "${DT_RTLINE["$x"]+x}" ] || dt_rtencode "$x"
			t+=${t:+$'\n'}${DT_RTLINE["$x"]}
			[ "${DT_RTDOOR["$x"]}" = registry ] && DT_RTREGS["$c $x"]=${DT_RTGEN["$x"]:-0}
		done
		dt_rtsay "$c" "$t" || return 1
		dt_rtwinsc "$c"
		dt_rtsay "$c" "ok $DT_RTPROTO" || return 1
		return 0
	fi
	case ${a[0]-} in
	tell)
		if [ -z "${DT_RTALLOW["${a[1]-}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]-nothing}, which is not a told request in interface.tsv"
			return 0
		fi
		if [ -z "${DT_RTMAY["$who ${a[1]}"]+x}" ]; then
			dt_log "app runtime: $who asked for ${a[1]}, which its own file never asks for"
			return 0
		fi
		if [ -n "${DT_RTWIN["${a[1]}"]+x}" ] && ! dt_rtowns "$who" "${a[2]-}"; then
			dt_log "app runtime: $who asked for ${a[1]} of window ${a[2]-none}, which is not its own"
			return 0
		fi
		t0=${EPOCHREALTIME/./}
		DT_CALLER=$who "${a[1]}" "${a[@]:2}" || dt_log "app runtime: $who's ${a[1]} failed"
		dt_spent "${a[1]}" "$((${EPOCHREALTIME/./} - t0))" "$who"
		;;
	*)
		dt_log "app runtime: $who sent ${a[0]-nothing}, which is not carried yet"
		;;
	esac
	return 0
}
