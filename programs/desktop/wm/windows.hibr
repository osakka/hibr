# wm/windows -- windows themselves: creating and closing them, what an app
# may ask about them, moving, sizing, zooming, minimising and the keyboard
# grab.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Which of an app's five functions actually exist, asked once.
fn dt_has(name) {
	command -v "$name" > /dev/null
}

# Make a window and put it on top.  Its id lands in $RET.
#
# The app argument is a prefix, not a command: an app called clock provides
# any of clock_draw, clock_key, clock_click, clock_open and clock_close, and
# the ones it does not write are never called.  That is the whole reason it
# is a prefix -- an app with no clock_key cannot swallow a key by accident,
# which a single function answering a verb in a case statement does, because
# a case that matches nothing succeeds.
fn dt_new(title, int h, int w, int row, int col, ap = "", arg = "") {
	local id=$DT_NEXT

	DT[$id]["title"]="$title"
	DT[$id]["h"]="$h"
	DT[$id]["w"]="$w"
	DT[$id]["ws"]=$DT_WS
	DT[$id]["row"]="$row"
	DT[$id]["col"]="$col"
	DT[$id]["app"]="$ap"
	DT[$id]["min"]=0
	DT[$id]["autoclose"]=
	dt_hooks "$id" "$ap"
	DT_NEXT=$((DT_NEXT + 1))
	console pane "w$id" "$row" "$col" "$h" "$w"
	DT_FOCUS=$id
	local nw=$DT_NOTEWIN
	DT_NOTEWIN=$id
	[ -n "${DT[$id]["open"]}" ] && ${DT[$id]["open"]} "$id" "$arg"
	DT_NOTEWIN=$nw
	dt_tile
	ret "$id"
}

# Which of an app's callbacks a window calls, asked once: a restored window
# asks again, since the hibr it was saved by may have had other ones.
fn dt_hooks(int id, ap = "") {
	local f

	for f in draw key click mouse wheel open close copy cut paste drop \
		refresh idle undo redo selall canclose savefile find; do
		if [ -n "$ap" ] && dt_has "${ap}_$f"; then
			DT[$id]["$f"]="${ap}_$f"
		else
			DT[$id]["$f"]=
		fi
	done
}

# Close a window and forget it.
fn dt_del(int id) {
	local ws=${DT[$id]["ws"]:-1}

	# Whatever the search widget was holding for this window, centrally
	# rather than in each app's own `_close`: an app that has no
	# `_close` at all -- Files has none -- would otherwise leak its
	# query for the life of the desktop.
	command -v dt_searchfree > /dev/null && dt_searchfree "$id"

	DT_NOTEWIN=$id
	[ -n "${DT[$id]["close"]}" ] && ${DT[$id]["close"]} "$id"
	DT_NOTEWIN=
	console pane drop "w$id"
	unset "DT[$id]"
	if [ "$DT_FOCUS" = "$id" ]; then
		local l
		l := dt_wpanes
		l=${l##* }
		DT_FOCUS=${l#w}
	fi
	dt_tile "$ws"
}

# An app calls this from its own _draw to ask that its window be closed --
# the terminal does, once the program inside has ended cleanly -- rather
# than calling dt_del there itself, which would pull the pane out from under
# the border dt_win still has left to draw over it.
fn dt_wantclose(int id) {
	DT[$id]["autoclose"]=1
}

# Close whatever asked to be, once the frame it asked in is fully drawn,
# and ask for one more frame without it -- nothing else may be coming to
# wake the desktop, and the closed window would stay on the screen.
dt_autoclose() {
	local id

	for id in "${!DT[@]}"; do
		if [ -n "${DT[$id]["autoclose"]}" ]; then
			dt_del "$id"
			dt_want 1
		fi
	done
}

# Show or hide a window without destroying it.  A minimised window has no
# pane, so nothing draws it and nothing can hit it; its only remaining handle
# is the label dt_wall puts on the bar, which is why that label exists.
fn dt_min(int id) {
	local l

	if [ "${DT[$id]["min"]}" = 1 ]; then
		DT[$id]["min"]=0
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}"
		console pane raise "w$id"
		DT_FOCUS=$id
	else
		DT[$id]["min"]=1
		console pane drop "w$id"
		if [ "$DT_FOCUS" = "$id" ]; then
			l := dt_wpanes
			l=${l##* }
			DT_FOCUS=${l#w}
		fi
	fi
	dt_tile "${DT[$id]["ws"]:-1}"
}

#
# An app draws with `console put -p "w$id"` and otherwise minds its own
# business. The few that manage *other* windows -- a control panel, a task
# switcher -- go through these rather than reading DT, which is the window
# manager's own table and not an interface.

# The panes that are windows, bottom of the stack upwards, as one word each.
#
# `console pane list` is every pane there is, and since 0.99.129 that is not
# the same thing: the menu bar has a pane of its own (Gitea #161). Three
# places read that list and every one of them meant windows -- the frame's
# own draw loop, a workspace switch, and the restart's saved stacking order
# -- so they ask this instead. A desktop that grows a second non-window
# pane therefore needs no fourth change.
dt_wpanes() {
	local p out=
	local -a ps

	p := console pane list
	read -ra ps <<< "$p"
	for p in "${ps[@]}"; do
		case $p in w[0-9]*) out="$out $p" ;; esac
	done
	ret "${out# }"
}

# Every window, hidden ones included, in the order they were opened.
#
# Not in stacking order: a list that reshuffles every time something is
# raised is unusable as a list, and raising things is exactly what a window
# list is for. Anything that wants the stack can ask console pane list.
dt_ids() {
	local id out=

	for id in "${!DT[@]}"; do out="$out $id"; done
	ret "${out# }"
}

# What a window is called.
fn dt_title(int id) {
	ret "${DT[$id]["title"]}"
}

# Is it minimised?
fn dt_hidden(int id) {
	[ "${DT[$id]["min"]}" = 1 ]
}

# Put a window on top and give it the keyboard.
fn dt_raise(int id) {
	dt_away "$id" && dt_wsgo "${DT[$id]["ws"]}"
	dt_hidden "$id" && { dt_min "$id"; return 0; }
	console pane raise "w$id"
	DT_FOCUS=$id
}

# The smallest a window can be and still have a usable title bar: the
# buttons alone take eight columns, and a body with no rows is not a window.
DT_MINW=16
DT_MINH=4

# A size for a window at (r, c), clamped to what is sensible and what fits,
# as "h w" -- or status 1 when even that is too small. Asked by an outline
# drag on every step without changing anything, and by dt_resize.
fn dt_fitsize(int r, int c, int h, int w) {
	[ "$h" -lt "$DT_MINH" ] && h=$DT_MINH
	[ "$w" -lt "$DT_MINW" ] && w=$DT_MINW
	[ $((r + h)) -gt "$DT_ROWS" ] && h=$((DT_ROWS - r))
	[ $((c + w)) -gt "$DT_COLS" ] && w=$((DT_COLS - c))
	[ "$h" -lt "$DT_MINH" ] && return 1
	[ "$w" -lt "$DT_MINW" ] && return 1
	ret "$h $w"
}

# Put a window at a size, clamped to what is sensible and what fits.
fn dt_resize(int id, int h, int w) {
	local s

	s := dt_fitsize "${DT[$id]["row"]}" "${DT[$id]["col"]}" "$h" "$w" ||
		return 1
	DT[$id]["h"]=${s% *}
	DT[$id]["w"]=${s#* }
	DT[$id]["oh"]=
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Resize by dragging any of the window's four corners, the opposite one
# held at (ar, ac) for the whole drag -- captured once, at the press that
# started it, since the window's own row and col start changing the
# moment a top or left edge does. br is dt_resize alone, unchanged from
# what a single grow box always did: the near corner is already the
# anchor, so only height and width change. tl moves both row and col, so
# it clamps both itself against the screen's near edge and against the
# minimum size the far corner still needs. tr and bl each move one of the
# two, clamped the same way, and hand the other edge (already free of any
# row/col change) to dt_resize, which clamps it against the screen's own
# far edge exactly as it always has.
fn dt_cornerwhere(int id, corner, int ar, int ac, int mr, int mc) {
	local r=${DT[$id]["row"]} c=${DT[$id]["col"]} h=${DT[$id]["h"]} w=${DT[$id]["w"]} s=

	case $corner in
	tl)
		r=$mr; c=$mc
		[ "$c" -lt 0 ] && c=0
		r := dt_toprow "$r" "$c" $((ar - r + 1)) $((ac - c + 1))
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		h=$((ar - r + 1))
		w=$((ac - c + 1))
		;;
	tr)
		# r is already clamped so ar-r+1 cannot be under DT_MINH, and ar
		# itself was always a valid row for a window that already fit the
		# screen -- the size's own early return, for a height still too
		# small once it clamps against the screen's far edge, can never
		# actually fire here; only its far-edge clamp on the width does.
		r=$mr
		r := dt_toprow "$r" "$c" $((ar - r + 1)) $((mc - c + 1))
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		s := dt_fitsize "$r" "$c" $((ar - r + 1)) $((mc - ac + 1))
		;;
	bl)
		# Same reasoning as tr, mirrored: c is already clamped so
		# ac-c+1 cannot be under DT_MINW.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) $((ac - c + 1))
		;;
	l)
		# One dimension only: the left edge moves, height and the right
		# edge (ac) do not, the same clamp as tl's own column half.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		s := dt_fitsize "$r" "$c" "$h" $((ac - c + 1))
		;;
	r)
		# The mirror of l: the right edge moves, the left one (ac) does
		# not, so the size's own clamp on the width is all this needs.
		s := dt_fitsize "$r" "$c" "$h" $((mc - ac + 1))
		;;
	b)
		# The mirror of r, the other axis: the bottom edge moves, the
		# top one (ar) does not.
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) "$w"
		;;
	*)
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) $((mc - ac + 1))
		;;
	esac
	# A size too small to fit keeps the one it had, as dt_resize always
	# did, the edge that moved having moved.
	[ -n "$s" ] && { h=${s% *}; w=${s#* }; }
	ret "$r $c $h $w"
}

# Resize to where dt_cornerwhere says the corner puts it.
fn dt_cornersize(int id, corner, int ar, int ac, int mr, int mc) {
	local g
	local -a v

	g := dt_cornerwhere "$id" "$corner" "$ar" "$ac" "$mr" "$mc"
	read -ra v <<< "$g"
	dt_setgeom "$id" "${v[0]}" "${v[1]}" "${v[2]}" "${v[3]}"
}

# Put a window at a place and a size already worked out, which is what
# the end of an outline drag does once.
fn dt_setgeom(int id, int r, int c, int h, int w) {
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	DT[$id]["oh"]=
	console pane "w$id" "$r" "$c" "$h" "$w"
}

# Move a window, clamped to the screen below the menu bar. The far edge
# holds only a window that fits: one larger than the screen -- zoomed on
# a display that has since gone, or on a screen since made smaller -- got
# the same place from every drag and could not be moved at all (Gitea
# #297), so it keeps its corner on the screen instead.
# The highest row a window of h rows and w columns at column c may stand
# at. The menu bar's row is the primary display's own, so a window over the
# primary's columns is kept below it; one beside it, on a display with no
# bar, may go to that display's top -- every clamp said row 1 for every
# display, which left a second display's top row out of reach.
fn dt_toprow(int r, int c, int h, int w) {
	local pr=${DT_PRIMARY_ROW:-0} pc=${DT_PRIMARY_COL:-0} pw=${DT_PRIMARY_W:-$DT_COLS}

	[ "$r" -lt 0 ] && r=0
	if [ "$r" -le "$pr" ] && [ $((r + h)) -gt "$pr" ] &&
	   [ $((c + w)) -gt "$pc" ] && [ "$c" -lt $((pc + pw)) ]; then
		r=$((pr + 1))
	fi
	ret "$r"
}

fn dt_movewhere(int id, int r, int c) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]}

	if [ "$h" -le "$DT_ROWS" ]; then
		[ $((r + h)) -gt "$DT_ROWS" ] && r=$((DT_ROWS - h))
	elif [ "$r" -gt $((DT_ROWS - 2)) ]; then
		r=$((DT_ROWS - 2))
	fi
	if [ "$w" -le "$DT_COLS" ]; then
		[ $((c + w)) -gt "$DT_COLS" ] && c=$((DT_COLS - w))
	elif [ "$c" -gt $((DT_COLS - 4)) ]; then
		c=$((DT_COLS - 4))
	fi
	[ "$c" -lt 0 ] && c=0
	r := dt_toprow "$r" "$c" "$h" "$w"
	ret "$r $c"
}

# Move a window to where dt_movewhere says it may stand.
fn dt_move(int id, int r, int c) {
	local p

	p := dt_movewhere "$id" "$r" "$c"
	DT[$id]["row"]=${p% *}
	DT[$id]["col"]=${p#* }
	console pane "w$id" "${p% *}" "${p#* }" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
	# The console sent the move as a rectangle copy, so the window's cells
	# are already where it is (Gitea #337) -- unless it is a translucent
	# terminal, whose cells are its picture blended through and are wrong
	# anywhere else, so it is drawn again like any moved window.
	if console copied "w$id" &&
	   ! { [ "${DT[$id]["app"]}" = term ] && [ "${DT_TERMTRANS:-0}" != 0 ]; }; then
		DT_MOVECOPY["$id"]=1
	fi
}

# Dragging by an outline (Control Panel > Mouse > Drag Windows): while the
# mouse is held the window stays where it was and only its outline follows,
# composited by the console over the screen at flush and never drawn into
# it. So a step costs the outline's own edge on the wire and no frame at
# all -- a solid drag redraws the desktop and sends the window's whole area
# at every step, which was 18 ms and 7.8 kB a step on the owner's desktop --
# and on release the window goes there and draws once. DT_OLON is the
# window, DT_OLG where it would go, and DT_OLONLY says this pass of the
# loop changed nothing but the outline, so dt_run flushes and draws nothing.
DT_OLON=
DT_OLG=
DT_OLONLY=

fn dt_outlined() {
	[ "$DT_MOVEMODE" != solid ]
}

# Show where a window would go, its title in the edge where its own is.
fn dt_olshow(int id, int r, int c, int h, int w) {
	DT_OLON=$id
	DT_OLG="$r $c $h $w"
	console outline "$r" "$c" "$h" "$w" "$DT_ACTIVE" "${GL[tl]}" \
		"${GL[hline]}" "${GL[tr]}" "${GL[vline]}" "${GL[bl]}" \
		"${GL[br]}" "${DT[$id]["title"]}"
	DT_OLONLY=1
	return 0
}

# Put the window where its outline is, once, and take the outline away.
fn dt_olapply() {
	local -a g

	[ -n "$DT_OLON" ] || return 1
	read -ra g <<< "$DT_OLG"
	console outline off
	[ "${#g[@]}" = 4 ] && dt_setgeom "$DT_OLON" "${g[0]}" "${g[1]}" "${g[2]}" "${g[3]}"
	DT_OLON=
	DT_OLG=
	return 0
}

# Take the outline away and leave the window where it was: escape, or a
# drag that ends some other way.
dt_oloff() {
	[ -n "$DT_OLON" ] && console outline off
	DT_OLON=
	DT_OLG=
	return 0
}

# Put a window on a half of the primary display -- left, right, top or
# bottom, below the menu bar -- or in its middle, keeping its size, for
# center. Snapping the same way again puts it back where it was. A fixed
# window can only be centred: its size is not the desktop's to change.
#
# On the display the window is on, not the primary (Gitea #286): it was the
# primary's rectangle whatever display the window stood on.
fn dt_snap(int id, dir) {
	local top left pw ph r c h w

	dt_windisp "$id"
	top=$DTW_R
	left=$DTW_C
	ph=$DTW_H
	pw=$DTW_W

	if [ "${DT[$id]["snap"]}" = "$dir" ] && [ -n "${DT[$id]["sh"]}" ]; then
		r=${DT[$id]["sr"]}
		c=${DT[$id]["sc"]}
		h=${DT[$id]["sh"]}
		w=${DT[$id]["sw"]}
		DT[$id]["snap"]=
	else
		if [ "$dir" != center ] &&
		   [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" = 1 ]; then
			dt_notep low "%s keeps its size; it can only be centred" "${DT[$id]["title"]}"
			return 0
		fi
		if [ -z "${DT[$id]["snap"]}" ]; then
			DT[$id]["sr"]=${DT[$id]["row"]}
			DT[$id]["sc"]=${DT[$id]["col"]}
			DT[$id]["sh"]=${DT[$id]["h"]}
			DT[$id]["sw"]=${DT[$id]["w"]}
		fi
		r=$top
		c=$left
		h=$ph
		w=$pw
		case $dir in
		left) w=$((pw / 2)) ;;
		right) c=$((left + pw / 2)); w=$((pw - pw / 2)) ;;
		top) h=$((ph / 2)) ;;
		bottom) r=$((top + ph / 2)); h=$((ph - ph / 2)) ;;
		center)
			h=${DT[$id]["h"]}
			w=${DT[$id]["w"]}
			r=$((top + (ph - h) / 2))
			c=$((left + (pw - w) / 2))
			;;
		*) return 1 ;;
		esac
		DT[$id]["snap"]=$dir
	fi
	DT[$id]["oh"]=
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	console pane "w$id" "$r" "$c" "$h" "$w"
}

dt_snap_focused() { [ -n "$DT_FOCUS" ] && dt_snap "$DT_FOCUS" "$1"; }

# The rectangle a window's own display gives it, in DTW_R, DTW_C, DTW_H
# and DTW_W (Gitea #286): the display holding the window's centre -- the
# primary when none does, which a window between two displays of different
# heights can manage -- less the bar's row when that display is the
# primary, the only one with a bar. One display, held or not, is the
# screen less the bar, which is what Zoom and the snaps always gave.
DTW_R=0
DTW_C=0
DTW_H=0
DTW_W=0
fn dt_windisp(int id) {
	local r=${DT[$id]["row"]} c=${DT[$id]["col"]}

	dt_dispat $((r + ${DT[$id]["h"]} / 2)) $((c + ${DT[$id]["w"]} / 2))
}

# The same rectangle for the display holding a point, row cr and column cc
# -- what a menu opening there is kept inside (Gitea #287).
fn dt_dispat(int cr, int cc) {
	local dsp dr dc drows dcols dgx hit= pr=${DT_PRIMARY_ROW:-0}
	local pc=${DT_PRIMARY_COL:-0}

	for dsp in "${DT_DISPLAYS[@]}"; do
		IFS=' ' read -r dr dc drows dcols dgx <<< "$dsp"
		[ "$cr" -ge "$dr" ] && [ "$cr" -lt $((dr + drows)) ] &&
			[ "$cc" -ge "$dc" ] && [ "$cc" -lt $((dc + dcols)) ] &&
			{ hit=1; break; }
	done
	if [ -z "$hit" ]; then
		dr=$pr
		dc=$pc
		drows=${DT_PRIMARY_H:-$DT_ROWS}
		dcols=${DT_PRIMARY_W:-$DT_COLS}
	fi
	if [ "$dr" = "$pr" ] && [ "$dc" = "$pc" ]; then
		dr=$((dr + 1))
		drows=$((drows - 1))
	fi
	DTW_R=$dr
	DTW_C=$dc
	DTW_H=$drows
	DTW_W=$dcols
	return 0
}

# Where a dialog h by w opens, in DT_DLGR, DT_DLGC, DT_DLGH and DT_DLGW:
# centred over the window being worked in -- the focused one -- and kept
# inside that window's display, or in the middle of the primary when no
# window has focus. It is made smaller to fit that display, less m columns
# and m - 1 rows (2 by default): the rows the old screen-wide clamp kept
# back were the bar's and a shadow's, and a primary's own rectangle has
# the bar taken out already. Centred on the whole screen instead, a dialog
# opened from a window on one of several displays landed on another, or
# between two (Gitea #293).
DT_DLGR=1
DT_DLGC=0
DT_DLGH=1
DT_DLGW=1
fn dt_dlgat(int h, int w, int? m = "") {
	local f=$DT_FOCUS cr cc r c

	[ -n "$m" ] || m=2
	if [ -n "$f" ] && [ -n "${DT[$f]["row"]+x}" ] &&
		[ "${DT[$f]["min"]}" != 1 ] && ! dt_away "$f"; then
		dt_windisp "$f"
		cr=$((DT[$f]["row"] + DT[$f]["h"] / 2))
		cc=$((DT[$f]["col"] + DT[$f]["w"] / 2))
	else
		dt_dispat "${DT_PRIMARY_ROW:-0}" "${DT_PRIMARY_COL:-0}"
		cr=$((DTW_R + DTW_H / 2))
		cc=$((DTW_C + DTW_W / 2))
	fi
	[ "$h" -gt $((DTW_H - m + 1)) ] && h=$((DTW_H - m + 1))
	[ "$w" -gt $((DTW_W - m)) ] && w=$((DTW_W - m))
	[ "$h" -lt 1 ] && h=1
	[ "$w" -lt 1 ] && w=1
	r=$((cr - h / 2))
	c=$((cc - w / 2))
	[ $((r + h)) -gt $((DTW_R + DTW_H)) ] && r=$((DTW_R + DTW_H - h))
	[ $((c + w)) -gt $((DTW_C + DTW_W)) ] && c=$((DTW_C + DTW_W - w))
	[ "$r" -lt "$DTW_R" ] && r=$DTW_R
	[ "$c" -lt "$DTW_C" ] && c=$DTW_C
	DT_DLGR=$r
	DT_DLGC=$c
	DT_DLGH=$h
	DT_DLGW=$w
	return 0
}

# Fill the window's own display, or every display when Control Panel >
# Windows > Zoom Fills says so (Gitea #286) -- or go back to where the
# window was.
fn dt_zoom(int id) {
	if [ -n "${DT[$id]["oh"]}" ]; then
		DT[$id]["row"]=${DT[$id]["or"]}
		DT[$id]["col"]=${DT[$id]["oc"]}
		DT[$id]["h"]=${DT[$id]["oh"]}
		DT[$id]["w"]=${DT[$id]["ow"]}
		DT[$id]["oh"]=
	else
		DT[$id]["or"]=${DT[$id]["row"]}
		DT[$id]["oc"]=${DT[$id]["col"]}
		DT[$id]["oh"]=${DT[$id]["h"]}
		DT[$id]["ow"]=${DT[$id]["w"]}
		if [ "$DT_ZOOMFILL" = every ]; then
			DT[$id]["row"]=1
			DT[$id]["col"]=0
			DT[$id]["h"]=$((DT_ROWS - 1))
			DT[$id]["w"]=$DT_COLS
		else
			dt_windisp "$id"
			DT[$id]["row"]=$DTW_R
			DT[$id]["col"]=$DTW_C
			DT[$id]["h"]=$DTW_H
			DT[$id]["w"]=$DTW_W
		fi
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Give a window a new title; an app knows what it is showing better than
# the menu that opened it does.
fn dt_retitle(int id, title) {
	DT[$id]["title"]="$title"
}

# A title that says which app and what it holds: `Mail [Home Email]`,
# `Terminal [bash]`, `Files [~]`. Eight apps built that string themselves
# with the detail interpolated into it -- `dt_retitle "$id" "Mail [$acct]"`
# -- which no catalogue can hold, since the key would carry the person's
# own account name, so every window frame in a translated desktop read
# English (Gitea #202). Here the app's own name is a key it already has
# from its `dt_app` line, the brackets are one key of punctuation, and a
# detail with no words in it is never looked up at all. An empty detail is
# the app's name alone, which is what a browser with no page open wants.
fn dt_wintitle(app, detail = "") {
	local a=$app t

	case $DT_LANG in ?*) a := dt_tr "$app" ;; esac
	if [ -z "$detail" ]; then
		ret "$a"
		return 0
	fi
	# The brackets are punctuation and not a key: 993-lang-ar refuses a
	# translation identical to its English, and rightly -- a frame with
	# no words in it has nothing to translate, where the app's own name
	# above does.
	ret "$a [$detail]"
}

dt_close_focused() { [ -n "$DT_FOCUS" ] && dt_closereq "$DT_FOCUS"; }

# Quit the focused window's app: every window it has, not only the one in
# front, which is what Quit means on a desktop where one app may have
# several. Each goes through dt_closereq, so an app that asks before closing
# -- an editor with unsaved text, a terminal with a program still running --
# asks once per window rather than being overruled. The ids are taken before
# any of them closes, since dt_del removes them as it goes.
fn dt_quitapp() {
	local ap id
	local -a ids=()

	[ -n "$DT_FOCUS" ] || return 0
	ap=${DT[$DT_FOCUS]["app"]}
	[ -n "$ap" ] || return 0
	for id in "${!DT[@]}"; do
		[ "${DT[$id]["app"]}" = "$ap" ] && ids+=("$id")
	done
	for id in "${ids[@]}"; do
		dt_closereq "$id"
	done
	return 0
}

# Close a window someone asked to close -- the close button, Close on a
# menu, the Close Window key -- unless its app's _canclose says not yet: an
# editor with unsaved changes asks first, and closes it itself if told to.
fn dt_closereq(int id) {
	local cb=${DT[$id]["canclose"]}

	DT_NOTEWIN=$id
	if [ -n "$cb" ] && ! $cb "$id"; then
		return 0
	fi
	dt_del "$id"
}

dt_hide_focused() { [ -n "$DT_FOCUS" ] && dt_min "$DT_FOCUS"; }

dt_zoom_focused() { [ -n "$DT_FOCUS" ] && dt_zoom "$DT_FOCUS"; }

# Bring the bottom window to the top.
dt_cycle() {
	local l id i=0 f=-1 n ws
	local -a ids

	if [ "$DT_CYCLE" != all ] || [ "$DT_WSN" -le 1 ]; then
		l := dt_wpanes
		l=${l%% *}
		[ -n "$l" ] && dt_raise "${l#w}"
		return 0
	fi
	# Every workspace, from this one on and round, each one's windows in
	# the order they were opened; a minimised window is skipped, as it is
	# on this workspace alone.
	while [ "$i" -lt "$DT_WSN" ]; do
		ws=$(((DT_WS - 1 + i) % DT_WSN + 1))
		for id in "${!DT[@]}"; do
			[ "${DT[$id]["ws"]:-1}" = "$ws" ] || continue
			dt_hidden "$id" && continue
			[ "$id" = "$DT_FOCUS" ] && f=${#ids[@]}
			ids+=("$id")
		done
		i=$((i + 1))
	done
	n=${#ids[@]}
	[ "$n" -gt 0 ] || return 0
	dt_raise "${ids[$(((f + 1) % n))]}"
}

# Move a window onto a specific display's own rectangle -- the titlebar
# menu's "Move to" submenu. Placed at that display's own top-left corner,
# clamped to still fit within it, the same shape dt_move already clamps a
# drag to the whole screen with, just against one display's box instead of
# the whole union.
fn dt_movewin(int id, int drow, int dcol, int drows, int dcols) {
	local r c

	r=$drow
	c=$dcol
	[ $((r + DT[$id]["h"])) -gt $((drow + drows)) ] &&
		r=$((drow + drows - DT[$id]["h"]))
	[ $((c + DT[$id]["w"])) -gt $((dcol + dcols)) ] &&
		c=$((dcol + dcols - DT[$id]["w"]))
	[ "$r" -lt "$drow" ] && r=$drow
	[ "$c" -lt "$dcol" ] && c=$dcol
	r := dt_toprow "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	console pane "w$id" "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Take the arrows for moving or resizing the focused window, until enter or
# escape gives them back.  This is the keyboard's answer to dragging a title
# bar, and the only one there is: a desktop that can only be arranged with a
# mouse is a desktop half its users cannot arrange.
fn dt_grab(mode) {
	[ -z "$DT_FOCUS" ] && return 1
	DT_GRAB=$mode
	if [ "$mode" = move ]; then
		dt_notep low "moving — arrows, then enter"
	else
		dt_notep low "resizing — arrows, then enter"
	fi
}

# One key while the arrows are taken.  Returns 1 for a key it does not want.
fn dt_gkey(key) {
	local id=$DT_FOCUS dr=0 dc=0

	case $key in
	up) dr=-1 ;;
	down) dr=1 ;;
	left) dc=-1 ;;
	right) dc=1 ;;
	enter | escape | " ")
		DT_GRAB=
		dt_note_clear
		return 0
		;;
	*) return 1 ;;
	esac
	if [ -z "$id" ]; then
		DT_GRAB=
		return 0
	fi
	if [ "$DT_GRAB" = move ]; then
		dt_move "$id" $((DT[$id]["row"] + dr)) \
			$((DT[$id]["col"] + dc))
	else
		dt_resize "$id" $((DT[$id]["h"] + dr)) \
			$((DT[$id]["w"] + dc))
	fi
	return 0
}
