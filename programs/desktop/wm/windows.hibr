# wm/windows -- windows themselves: creating and closing them, what an app
# may ask about them, moving, sizing, zooming, minimising and the keyboard
# grab.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Make a window and put it on top.  Its id lands in $RET.
#
# The app argument is a prefix, not a command: an app called clock provides
# any of clock_draw, clock_key, clock_click, clock_open and clock_close, and
# the ones it does not write are never called.  That is the whole reason it
# is a prefix -- an app with no clock_key cannot swallow a key by accident,
# which a single function answering a verb in a case statement does, because
# a case that matches nothing succeeds.
fn dt_new(title, int h, int w, int row, int col, ap = "", arg = "") {
	local id=$DT_NEXT

	DT[$id]["title"]="$title"
	DT[$id]["h"]="$h"
	DT[$id]["w"]="$w"
	DT[$id]["ws"]=$DT_WS
	DT[$id]["row"]="$row"
	DT[$id]["col"]="$col"
	DT[$id]["app"]="$ap"
	DT[$id]["min"]=0
	DT[$id]["autoclose"]=
	# Drawn by its app's own process, or not, decided once (wm/rtview.hibr).
	dt_rvnew "$id" "$ap"
	dt_hooks "$id" "$ap"
	DT_NEXT=$((DT_NEXT + 1))
	console pane "w$id" "$row" "$col" "$h" "$w"
	DT_FOCUS=$id
	local nw=$DT_NOTEWIN
	DT_NOTEWIN=$id
	if [ -n "${DT_RVC[$id]+x}" ]; then
		dt_rvopen "$id" "$arg"
	elif [ -n "${DT[$id]["open"]}" ]; then
		dt_appfn "${DT[$id]["app"]-}" ${DT[$id]["open"]} "$id" "$arg"
	fi
	DT_NOTEWIN=$nw
	dt_tile
	ret "$id"
}

# Which of an app's callbacks a window calls, asked once: a restored window
# asks again, since the hibr it was saved by may have had other ones.
fn dt_hooks(int id, ap = "") {
	local f has
	local hv=${DT_RVC[$id]+1}

	for f in draw key click mouse wheel hover open close copy cut paste drop \
		refresh idle undo redo selall canclose savefile find signin signfill \
		focus; do
		# A window its app's own process draws has what that process said
		# (wm/rtview.hibr); any other, what this one defines.
		has=1
		if [ -n "$hv" ]; then
			dt_rvhas "$ap" "$f" && has=0
		elif [ -n "$ap" ] && dt_has "${ap}_$f"; then
			has=0
		fi
		if [ "$has" = 0 ]; then
			DT[$id]["$f"]="${ap}_$f"
			[ "$f" = focus ] && DT_FOCUSUSED=1
		else
			DT[$id]["$f"]=
		fi
	done
}

# Whether a window's app has callback kind -- its menus, a context menu, a
# title menu -- that the window manager asks for by name: what its own
# process said it has when it draws there (wm/rtview.hibr), what this one
# defines otherwise, as dt_hooks decides for the rest.
fn dt_winhas(id, kind) {
	local ap=${DT[$id]["app"]-}

	[ -n "$ap" ] || return 1
	if [ -n "${DT_RVC[$id]+x}" ]; then
		dt_rvhas "$ap" "$kind"
		return
	fi
	dt_has "${ap}_$kind"
}

# Whether id is a window: a record with a size, which dt_new and a restart
# give every window and nothing else may (Gitea #552). The one question --
# a title, an app or a row each answered it somewhere once, and a record a
# late write had brought back with a column and nothing else passed some of
# them and was drawn as a window every frame, through two restarts.
fn dt_iswin(id = "") {
	[ -n "$id" ] && [ -n "${DT[$id]["h"]-}" ] && [ -n "${DT[$id]["w"]-}" ]
}

# The same, for something about to place or size a window: one that has
# gone is refused, and said once in the log with what asked, since the
# asking is a reference somebody kept past the close.
declare -gA DT_WINGONE
fn dt_winok(id, who) {
	dt_iswin "$id" && return 0
	if [ -z "${DT_WINGONE["$id $who"]-}" ]; then
		DT_WINGONE["$id $who"]=1
		dt_log "window $id: $who asked for it, and it has gone"
	fi
	return 1
}

# Every reference the desktop keeps to a window, let go when it closes, so
# nothing goes on moving, sizing or hovering a window that is not there: a
# drag still holding a closed window wrote its column back into a record
# that had gone (Gitea #552).
fn dt_winforget(id) {
	[ "${DT_DRAG-}" = "$id" ] && { DT_DRAG=; dt_oloff; }
	[ "${DT_OLON-}" = "$id" ] && dt_oloff
	[ "${DT_SIZE-}" = "$id" ] && DT_SIZE=
	[ "${DT_ALTPRESS%% *}" = "$id" ] && DT_ALTPRESS=
	[ "${DT_HOVERWIN-}" = "$id" ] && DT_HOVERWIN=
	[ "${DT_HOTWIN-}" = "$id" ] && { DT_HOTWIN=; DT_HOTTAG=; }
	[ -n "${DT_GRAB-}" ] && [ "${DT_FOCUS-}" = "$id" ] && DT_GRAB=
	dt_has dt_fulltake && dt_fulltake "$id"
	unset DT_WKEEP["$id"] DT_WKEEP["$id o"] DT_WKEEP["$id s"] DT_WKEEP["$id fs"]
	return 0
}

# Close a window and forget it.
fn dt_del(int id) {
	local ws=${DT[$id]["ws"]:-1}
	local hv=${DT_RVC[$id]+1}

	# Asked from inside a frame -- an app's _draw, _dirty or _idle -- the
	# window is marked and closed once the frame is drawn, as dt_wantclose does: taken away now, the frame went on
	# drawing from a record that had gone (Gitea #408).
	if [ -n "$DT_INDRAW" ]; then
		[ -n "${DT[$id]["row"]+x}" ] && dt_wantclose "$id"
		return 0
	fi
	# One its app's own process draws is held until the app has answered its
	# close, or DT_HOLDMS has passed, never waited on (wm/rtview.hibr).
	[ -z "$hv" ] || dt_rvclose "$id" || return 0
	# Whatever the search widget was holding for this window, centrally
	# rather than in each app's own `_close`: an app that has no
	# `_close` at all -- Files has none -- would otherwise leak its
	# query for the life of the desktop.
	command -v dt_searchfree > /dev/null && dt_searchfree "$id"
	[ -n "$DT_PHASEUSED" ] && dt_keyletgo "$id"
	unset DT_LIVE["$id"]

	DT_NOTEWIN=$id
	[ -n "$hv" ] || [ -z "${DT[$id]["close"]}" ] || dt_appfn "${DT[$id]["app"]-}" ${DT[$id]["close"]} "$id"
	DT_NOTEWIN=
	# A Control Panel pane its own process draws in this window goes with it
	# (wm/rtkinds.hibr): one lookup for every other window.
	[ -z "${DT_RVX["p$id"]+x}" ] || dt_rvxforget "p$id"
	console pane drop "w$id"
	dt_winforget "$id"
	unset "DT[$id]"
	if [ "$DT_FOCUS" = "$id" ]; then
		local l
		l := dt_wpanes
		l=${l##* }
		DT_FOCUS=${l#w}
	fi
	dt_tile "$ws"
}

# An app calls this from its own _draw to ask that its window be closed --
# the terminal does, once the program inside has ended cleanly -- rather
# than calling dt_del there itself, which would pull the pane out from under
# the border dt_win still has left to draw over it.
fn dt_wantclose(int id) {
	dt_winok "$id" dt_wantclose || return 1
	DT[$id]["autoclose"]=1
}

# Close whatever asked to be, once the frame it asked in is fully drawn,
# and ask for one more frame without it -- nothing else may be coming to
# wake the desktop, and the closed window would stay on the screen.
dt_autoclose() {
	local id

	dt_wins
	for id in "${DT_WINS[@]}"; do
		if [ -n "${DT[$id]["autoclose"]}" ]; then
			dt_del "$id"
			dt_want 1
		fi
	done
}

# Show or hide a window without destroying it.  A minimised window has no
# pane, so nothing draws it and nothing can hit it; its only remaining handle
# is the label dt_wall puts on the bar, which is why that label exists.
fn dt_min(int id) {
	dt_winok "$id" dt_min || return 1
	local l

	if [ "${DT[$id]["min"]}" = 1 ]; then
		DT[$id]["min"]=0
		console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
			"${DT[$id]["h"]}" "${DT[$id]["w"]}"
		console pane raise "w$id"
		DT_FOCUS=$id
	else
		DT[$id]["min"]=1
		console pane drop "w$id"
		if [ "$DT_FOCUS" = "$id" ]; then
			l := dt_wpanes
			l=${l##* }
			DT_FOCUS=${l#w}
		fi
	fi
	dt_tile "${DT[$id]["ws"]:-1}"
}

#
# An app draws with `console put -p "w$id"` and otherwise minds its own
# business. The few that manage *other* windows -- a control panel, a task
# switcher -- go through these rather than reading DT, which is the window
# manager's own table and not an interface.

# The panes that are windows, bottom of the stack upwards, as one word each.
#
# `console pane list` is every pane there is, and since 0.99.129 that is not
# the same thing: the menu bar has a pane of its own (Gitea #161). Three
# places read that list and every one of them meant windows -- the frame's
# own draw loop, a workspace switch, and the restart's saved stacking order
# -- so they ask this instead. A desktop that grows a second non-window
# pane therefore needs no fourth change.
dt_wpanes() {
	local p out=
	local -a ps

	p := console pane list
	read -ra ps <<< "$p"
	for p in "${ps[@]}"; do
		case $p in w[0-9]*) out="$out $p" ;; esac
	done
	ret "${out# }"
}

# Every window, hidden ones included, in the order they were opened.
#
# Not in stacking order: a list that reshuffles every time something is
# raised is unusable as a list, and raising things is exactly what a window
# list is for. Anything that wants the stack can ask console pane list.
dt_ids() {
	local IFS=' '

	dt_wins
	ret "${DT_WINS[*]}"
}

# Every window into DT_WINS, in the order they were opened: the one list of
# them everything walks. A record that is not a window -- written after its
# window closed, by something still holding the id -- is taken away here,
# with its pane, and said once, so it is never drawn, moved, saved or
# brought back by a restart (Gitea #552).
declare -ga DT_WINS
dt_wins() {
	local id

	DT_WINS=()
	for id in "${!DT[@]}"; do
		if dt_iswin "$id"; then
			DT_WINS+=("$id")
			continue
		fi
		dt_ghostgone "$id"
	done
	return 0
}

# Take away what is left of a window that is not one -- its record and its
# pane, either of which may be all there is -- and say so once.
fn dt_ghostgone(id) {
	dt_log "window $id: a record or pane with no window behind it, kept by something after the window closed, taken away"
	console pane drop "w$id" 2> /dev/null
	unset "DT[$id]"
	return 0
}

# Put a window on top and give it the keyboard.
fn dt_raise(int id) {
	dt_winok "$id" dt_raise || return 1
	dt_away "$id" && dt_wsgo "${DT[$id]["ws"]}"
	dt_hidden "$id" && { dt_min "$id"; return 0; }
	console pane raise "w$id"
	DT_FOCUS=$id
}

# The smallest a window can be and still have a usable title bar: the
# buttons alone take eight columns, and a body with no rows is not a window.
DT_MINW=16
DT_MINH=4

# A size for a window at (r, c), clamped to what is sensible and what fits,
# as "h w" -- or status 1 when even that is too small. Asked by an outline
# drag on every step without changing anything, and by dt_resize.
fn dt_fitsize(int r, int c, int h, int w) {
	[ "$h" -lt "$DT_MINH" ] && h=$DT_MINH
	[ "$w" -lt "$DT_MINW" ] && w=$DT_MINW
	[ $((r + h)) -gt "$DT_ROWS" ] && h=$((DT_ROWS - r))
	[ $((c + w)) -gt "$DT_COLS" ] && w=$((DT_COLS - c))
	[ "$h" -lt "$DT_MINH" ] && return 1
	[ "$w" -lt "$DT_MINW" ] && return 1
	ret "$h $w"
}

# Put a window at a size, clamped to what is sensible and what fits.
fn dt_resize(int id, int h, int w) {
	dt_winok "$id" dt_resize || return 1
	local s

	[ -n "${DT[$id]["shaded"]-}" ] && dt_shade "$id"

	s := dt_fitsize "${DT[$id]["row"]}" "${DT[$id]["col"]}" "$h" "$w" ||
		return 1
	DT[$id]["h"]=${s% *}
	DT[$id]["w"]=${s#* }
	DT[$id]["oh"]=
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Resize by dragging any of the window's four corners, the opposite one
# held at (ar, ac) for the whole drag -- captured once, at the press that
# started it, since the window's own row and col start changing the
# moment a top or left edge does. br is dt_resize alone, unchanged from
# what a single grow box always did: the near corner is already the
# anchor, so only height and width change. tl moves both row and col, so
# it clamps both itself against the screen's near edge and against the
# minimum size the far corner still needs. tr and bl each move one of the
# two, clamped the same way, and hand the other edge (already free of any
# row/col change) to dt_resize, which clamps it against the screen's own
# far edge exactly as it always has.
fn dt_cornerwhere(int id, corner, int ar, int ac, int mr, int mc) {
	dt_winok "$id" dt_cornerwhere || return 1
	local r=${DT[$id]["row"]} c=${DT[$id]["col"]} h=${DT[$id]["h"]} w=${DT[$id]["w"]} s=

	case $corner in
	tl)
		r=$mr; c=$mc
		[ "$c" -lt 0 ] && c=0
		r := dt_toprow "$r" "$c" $((ar - r + 1)) $((ac - c + 1))
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		h=$((ar - r + 1))
		w=$((ac - c + 1))
		;;
	tr)
		# r is already clamped so ar-r+1 cannot be under DT_MINH, and ar
		# itself was always a valid row for a window that already fit the
		# screen -- the size's own early return, for a height still too
		# small once it clamps against the screen's far edge, can never
		# actually fire here; only its far-edge clamp on the width does.
		r=$mr
		r := dt_toprow "$r" "$c" $((ar - r + 1)) $((mc - c + 1))
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		s := dt_fitsize "$r" "$c" $((ar - r + 1)) $((mc - ac + 1))
		;;
	bl)
		# Same reasoning as tr, mirrored: c is already clamped so
		# ac-c+1 cannot be under DT_MINW.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) $((ac - c + 1))
		;;
	l)
		# One dimension only: the left edge moves, height and the right
		# edge (ac) do not, the same clamp as tl's own column half.
		c=$mc
		[ "$c" -lt 0 ] && c=0
		[ "$c" -gt $((ac - DT_MINW + 1)) ] && c=$((ac - DT_MINW + 1))
		s := dt_fitsize "$r" "$c" "$h" $((ac - c + 1))
		;;
	r)
		# The mirror of l: the right edge moves, the left one (ac) does
		# not, so the size's own clamp on the width is all this needs.
		s := dt_fitsize "$r" "$c" "$h" $((mc - ac + 1))
		;;
	b)
		# The mirror of r, the other axis: the bottom edge moves, the
		# top one (ar) does not.
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) "$w"
		;;
	t)
		# The top edge moves and the bottom one (ar) does not: no grip
		# asks it of a framed window, whose top row is its title bar, and
		# a program drawing its own frame does (Gitea #496).
		r := dt_toprow "$mr" "$c" $((ar - mr + 1)) "$w"
		[ "$r" -gt $((ar - DT_MINH + 1)) ] && r=$((ar - DT_MINH + 1))
		h=$((ar - r + 1))
		;;
	*)
		s := dt_fitsize "$r" "$c" $((mr - ar + 1)) $((mc - ac + 1))
		;;
	esac
	# A size too small to fit keeps the one it had, as dt_resize always
	# did, the edge that moved having moved.
	[ -n "$s" ] && { h=${s% *}; w=${s#* }; }
	ret "$r $c $h $w"
}

# Resize to where dt_cornerwhere says the corner puts it.
fn dt_cornersize(int id, corner, int ar, int ac, int mr, int mc) {
	local g
	local -a v

	g := dt_cornerwhere "$id" "$corner" "$ar" "$ac" "$mr" "$mc"
	read -ra v <<< "$g"
	dt_setgeom "$id" "${v[0]}" "${v[1]}" "${v[2]}" "${v[3]}"
}

# Put a window at a place and a size already worked out, which is what
# the end of an outline drag does once.
fn dt_setgeom(int id, int r, int c, int h, int w) {
	dt_winok "$id" dt_setgeom || return 1
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	DT[$id]["oh"]=
	console pane "w$id" "$r" "$c" "$h" "$w"
}

# Move a window, clamped to the screen below the menu bar. The far edge
# holds only a window that fits: one larger than the screen -- zoomed on
# a display that has since gone, or on a screen since made smaller -- got
# the same place from every drag and could not be moved at all (Gitea
# #297), so it keeps its corner on the screen instead.
# The highest row a window of h rows and w columns at column c may stand
# at. The menu bar's row is the primary display's own, so a window over the
# primary's columns is kept below it; one beside it, on a display with no
# bar, may go to that display's top -- every clamp said row 1 for every
# display, which left a second display's top row out of reach.
fn dt_toprow(int r, int c, int h, int w) {
	local pr=${DT_PRIMARY_ROW:-0} pc=${DT_PRIMARY_COL:-0} pw=${DT_PRIMARY_W:-$DT_COLS}

	[ "$r" -lt 0 ] && r=0
	if [ "$r" -le "$pr" ] && [ $((r + h)) -gt "$pr" ] &&
	   [ $((c + w)) -gt "$pc" ] && [ "$c" -lt $((pc + pw)) ]; then
		r=$((pr + 1))
	fi
	ret "$r"
}

fn dt_movewhere(int id, int r, int c) {
	dt_winok "$id" dt_movewhere || return 1
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]}

	if [ "$h" -le "$DT_ROWS" ]; then
		[ $((r + h)) -gt "$DT_ROWS" ] && r=$((DT_ROWS - h))
	elif [ "$r" -gt $((DT_ROWS - 2)) ]; then
		r=$((DT_ROWS - 2))
	fi
	if [ "$w" -le "$DT_COLS" ]; then
		[ $((c + w)) -gt "$DT_COLS" ] && c=$((DT_COLS - w))
	elif [ "$c" -gt $((DT_COLS - 4)) ]; then
		c=$((DT_COLS - 4))
	fi
	[ "$c" -lt 0 ] && c=0
	r := dt_toprow "$r" "$c" "$h" "$w"
	ret "$r $c"
}

# Move a window to where dt_movewhere says it may stand.
fn dt_move(int id, int r, int c) {
	dt_winok "$id" dt_move || return 1
	local p

	p := dt_movewhere "$id" "$r" "$c"
	DT[$id]["row"]=${p% *}
	DT[$id]["col"]=${p#* }
	console pane "w$id" "${p% *}" "${p#* }" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
	# The console sent the move as a rectangle copy, so the window's cells
	# are already where it is (Gitea #337) -- unless it is see-through, by
	# See Through or a terminal's own setting: its cells are the picture
	# blended in and are wrong anywhere else, so it is drawn again like any
	# moved window.
	if console copied "w$id" && [ "${DT_WINTRANS:-0}" = 0 ] &&
	   ! { [ "${DT[$id]["app"]}" = term ] && [ "${DT_TERMTRANS:-0}" != 0 ]; }; then
		DT_MOVECOPY["$id"]=1
	fi
}

# Dragging by an outline (Control Panel > Mouse > Drag Windows): while the
# mouse is held the window stays where it was and only its outline follows,
# composited by the console over the screen at flush and never drawn into
# it. So a step costs the outline's own edge on the wire and no frame at
# all -- a solid drag redraws the desktop and sends the window's whole area
# at every step, which was 18 ms and 7.8 kB a step on the owner's desktop --
# and on release the window goes there and draws once. DT_OLON is the
# window, DT_OLG where it would go, and DT_OLONLY says this pass of the
# loop changed nothing but the outline, so dt_run flushes and draws nothing.
DT_OLON=
DT_OLG=
DT_OLONLY=

fn dt_outlined() {
	[ "$DT_MOVEMODE" != solid ]
}

# Show where a window would go, its title in the edge where its own is.
fn dt_olshow(int id, int r, int c, int h, int w) {
	DT_OLON=$id
	DT_OLG="$r $c $h $w"
	console outline "$r" "$c" "$h" "$w" "$DT_ACTIVE" "${GL[tl]}" \
		"${GL[hline]}" "${GL[tr]}" "${GL[vline]}" "${GL[bl]}" \
		"${GL[br]}" "${DT[$id]["title"]}"
	DT_OLONLY=1
	return 0
}

# Put the window where its outline is, once, and take the outline away.
fn dt_olapply() {
	local -a g

	[ -n "$DT_OLON" ] || return 1
	read -ra g <<< "$DT_OLG"
	console outline off
	[ "${#g[@]}" = 4 ] && dt_setgeom "$DT_OLON" "${g[0]}" "${g[1]}" "${g[2]}" "${g[3]}"
	DT_OLON=
	DT_OLG=
	return 0
}

# Take the outline away and leave the window where it was: escape, or a
# drag that ends some other way.
dt_oloff() {
	[ -n "$DT_OLON" ] && console outline off
	DT_OLON=
	DT_OLG=
	return 0
}

# Put a window on a half of the primary display -- left, right, top or
# bottom, below the menu bar -- or in its middle, keeping its size, for
# center. Snapping the same way again puts it back where it was. A fixed
# window can only be centred: its size is not the desktop's to change.
#
# On the display the window is on, not the primary (Gitea #286): it was the
# primary's rectangle whatever display the window stood on.
fn dt_snap(int id, dir) {
	dt_winok "$id" dt_snap || return 1
	local top left pw ph r c h w

	dt_windisp "$id"
	top=$DTW_R
	left=$DTW_C
	ph=$DTW_H
	pw=$DTW_W

	if [ "${DT[$id]["snap"]}" = "$dir" ] && [ -n "${DT[$id]["sh"]}" ]; then
		r=${DT[$id]["sr"]}
		c=${DT[$id]["sc"]}
		h=${DT[$id]["sh"]}
		w=${DT[$id]["sw"]}
		DT[$id]["snap"]=
	else
		if [ "$dir" != center ] &&
		   [ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" = 1 ]; then
			dt_notep low "%s keeps its size; it can only be centred" "${DT[$id]["title"]}"
			return 0
		fi
		if [ -z "${DT[$id]["snap"]}" ]; then
			DT[$id]["sr"]=${DT[$id]["row"]}
			DT[$id]["sc"]=${DT[$id]["col"]}
			DT[$id]["sh"]=${DT[$id]["h"]}
			DT[$id]["sw"]=${DT[$id]["w"]}
		fi
		dt_snapat "$dir" "$top" "$left" "$ph" "$pw" "${DT[$id]["h"]}" \
			"${DT[$id]["w"]}" || return 1
		r=$DTF_R
		c=$DTF_C
		h=$DTF_H
		w=$DTF_W
		DT[$id]["snap"]=$dir
	fi
	DT[$id]["oh"]=
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	DT[$id]["h"]=$h
	DT[$id]["w"]=$w
	console pane "w$id" "$r" "$c" "$h" "$w"
}

dt_snap_focused() { [ -n "$DT_FOCUS" ] && dt_snap "$DT_FOCUS" "$1"; }

# Where a window h by w snapped dir goes in a display's rectangle below its
# bar, top and left its corner, ph by pw its size: into DTF_R, DTF_C, DTF_H
# and DTF_W, or status 1 for a direction there is none of. One rule for a
# snap and for a snapped window following its display's new size.
DTF_R=0
DTF_C=0
DTF_H=0
DTF_W=0
fn dt_snapat(dir, int top, int left, int ph, int pw, int h, int w) {
	local r=$top c=$left

	case $dir in
	left) h=$ph; w=$((pw / 2)) ;;
	right) h=$ph; c=$((left + pw / 2)); w=$((pw - pw / 2)) ;;
	top) w=$pw; h=$((ph / 2)) ;;
	bottom) w=$pw; r=$((top + ph / 2)); h=$((ph - ph / 2)) ;;
	center) r=$((top + (ph - h) / 2)); c=$((left + (pw - w) / 2)) ;;
	*) return 1 ;;
	esac
	DTF_R=$r
	DTF_C=$c
	DTF_H=$h
	DTF_W=$w
	return 0
}

# A rectangle kept inside a display's own, into DTF_R, DTF_C, DTF_H and
# DTF_W: top the first row a window may stand at there (one below the bar
# on the primary), bot the row past its last, dc and dw its columns. Its
# place is kept where it fits and pulled back from the right and the
# bottom where it does not; it is made smaller only where it cannot fit at
# all, and never when fx says its size is not the desktop's to change -- a
# fixed window keeps its top left on the display instead, its title there.
fn dt_rectfit(int r, int c, int h, int w, int top, int bot, int dc, int dw, fx = "") {
	if [ -z "$fx" ]; then
		[ "$h" -gt $((bot - top)) ] && h=$((bot - top))
		[ "$w" -gt "$dw" ] && w=$dw
	fi
	[ $((r + h)) -gt "$bot" ] && r=$((bot - h))
	[ $((c + w)) -gt $((dc + dw)) ] && c=$((dc + dw - w))
	[ "$r" -lt "$top" ] && r=$top
	[ "$c" -lt "$dc" ] && c=$dc
	DTF_R=$r
	DTF_C=$c
	DTF_H=$h
	DTF_W=$w
	return 0
}

# The displays as windows were last kept inside them: each one's rectangle
# by key -- "d" and its name, which is empty for a desktop nothing holds --
# in DT_WFR, DT_WFC, DT_WFH and DT_WFW; their keys in DT_WFITORD, those
# attached then first in the order hold gave them and after them up to
# DT_WFITKEEP that had left, newest first; and hold's shift and the
# primary's corner as they were then. DT_WFITSIG is all of what they were
# read from, so a resize that changed no display costs one comparison.
declare -gA DT_WFR DT_WFC DT_WFH DT_WFW
declare -ga DT_WFITORD=()
DT_WFITSHIFT=
DT_WFITPRI=
DT_WFITSIG=
DT_WFITKEEP=8
# Each window a display's change of size moved or made smaller, by id:
# where it was before the first such change and where the last one put it,
# "r c h w|r c h w". It goes back to the first when its display can hold
# it again and it is still where the last put it; anything else that moved
# or sized it since makes the place the person's, and the record goes.
# Where a zoomed, snapped or full-screen window goes back to is kept the
# same way, under "id o", "id s" and "id fs" (dt_wsavedfit).
declare -gA DT_WKEEP
# The display dt_wfithome found, by its key, or empty.
DTF_HOME=

# Keep every window inside the display it was on, after a resize changed
# that display's rectangle -- a display's mode changing (Blit #60) reaches
# the desktop as nothing more than its terminal resizing, and a window
# wider than the new size kept its place with its buttons off the screen,
# one past the new edge ended up on no display at all. dt_size calls this
# on every resize, as it calls dt_iconlay for the icons.
#
# A display is known by its name. One that has left is remembered, so it
# coming back at another size or place is a change like any other; and one
# under a name never seen, at the corner of one that has left, is that one
# again, a client that replaced another. A
# window's display is the one its middle was on before (its top left when
# its middle was on none, as a window over a seam can be), and only a
# window whose display changed is touched: one on a display that did not
# change is left where the person put it, and one on a display that has
# left, or that was on none, is not this function's -- nothing here knows
# which display to give it. A display that moved carries its windows with
# it before they are fitted. What each kind of window gets is dt_winfit1's;
# a window zoomed over every display (Zoom Fills) covers the whole screen
# again after any change.
#
# A window this moved or made smaller goes back where it was once its
# display can hold it again (DT_WKEEP): a display mode tried and taken
# back -- Blit applies one provisionally and reverts it unless it is
# confirmed -- or one attach from a smaller machine leaves every window as
# it was. Several smaller sizes in a row keep the place from before the
# first. A window moved or sized by anything else since -- the person, a
# snap, a zoom -- is the person's, and stays.
fn dt_winsfit() {
	local i k n dr dc drows dcols dgx sdr=0 sdc=0 id pr pc o moved=0 sig
	local otop ntop zh
	local -a ord=() gone=() keep=() kq
	local -A qr qc qh qw map chg taken

	# Held with nothing attached, the screen hold keeps is no display
	# anybody sees -- the union's whole size, at its corner -- and taking
	# it for one would fit every window into it, or match it to whichever
	# display had left from that corner. Nothing is kept or remembered
	# until a display attaches.
	[ -n "${HIBR_HOLD-}" ] && [ -z "${DT_DISPNAMES[0]-}" ] && return 0
	pr=${DT_PRIMARY_ROW:-0}
	pc=${DT_PRIMARY_COL:-0}
	sig="${DT_DISPNAMES[*]}|${DT_DISPLAYS[*]}|${DT_SHIFTWAS-}|$pr $pc"
	[ "$sig" = "$DT_WFITSIG" ] && return 0
	DT_WFITSIG=$sig
	for i in "${!DT_DISPLAYS[@]}"; do
		IFS=' ' read -r dr dc drows dcols dgx <<< "${DT_DISPLAYS[$i]}"
		k="d${DT_DISPNAMES[$i]-}"
		qr["$k"]=$dr
		qc["$k"]=$dc
		qh["$k"]=$drows
		qw["$k"]=$dcols
		ord+=("$k")
	done
	# What hold has moved every display by since, which dt_shiftorigin
	# has already moved the windows by: the old rectangles move with
	# them, so a display that only moved with the rest is no change.
	if [ -n "$DT_WFITSHIFT" ] && [ -n "${DT_SHIFTWAS-}" ]; then
		sdr=$((${DT_SHIFTWAS%% *} - ${DT_WFITSHIFT%% *}))
		sdc=$((${DT_SHIFTWAS##* } - ${DT_WFITSHIFT##* }))
	fi
	# And what is kept to put windows back, which dt_shiftorigin did not
	# move -- but not where a snap goes back to, which it does not move
	# either.
	if [ "$sdr $sdc" != "0 0" ]; then
		for id in "${!DT_WKEEP[@]}"; do
			[ "${id% s}" = "$id" ] || continue
			read -ra kq <<< "${DT_WKEEP["$id"]/|/ }"
			DT_WKEEP["$id"]="$((kq[0] + sdr)) $((kq[1] + sdc)) ${kq[2]} ${kq[3]}|$((kq[4] + sdr)) $((kq[5] + sdc)) ${kq[6]} ${kq[7]}"
		done
	fi
	for k in "${DT_WFITORD[@]}"; do
		DT_WFR["$k"]=$((DT_WFR["$k"] + sdr))
		DT_WFC["$k"]=$((DT_WFC["$k"] + sdc))
		if [ -n "${qr["$k"]+x}" ]; then
			map["$k"]=$k
			taken["$k"]=1
		else
			gone+=("$k")
		fi
	done
	for k in "${gone[@]}"; do
		for n in "${ord[@]}"; do
			[ -z "${taken["$n"]-}" ] && [ -z "${DT_WFR["$n"]+x}" ] || continue
			[ "${qr["$n"]} ${qc["$n"]}" = "${DT_WFR["$k"]} ${DT_WFC["$k"]}" ] || continue
			map["$k"]=$n
			taken["$n"]=1
			break
		done
	done
	for k in "${!map[@]}"; do
		n=${map["$k"]}
		[ "${qr["$n"]} ${qc["$n"]} ${qh["$n"]} ${qw["$n"]}" = \
		  "${DT_WFR["$k"]} ${DT_WFC["$k"]} ${DT_WFH["$k"]} ${DT_WFW["$k"]}" ] || chg["$k"]=1
	done
	# The primary's corner then, in the same terms, for the row its bar
	# took from a snapped window's display.
	o=$DT_WFITPRI
	[ -n "$o" ] && o="$((${o% *} + sdr)) $((${o#* } + sdc))"
	if [ "${#chg[@]}" != 0 ]; then
		zh=$((DT_ROWS - 1))
		dt_wins
		for id in "${DT_WINS[@]}"; do
			[ -n "${DT_TILED["${DT[$id]["ws"]:-1}"]-}" ] && dt_intile "$id" && continue
			[ -n "${DT[$id]["row"]-}" ] && [ -n "${DT[$id]["col"]-}" ] || continue
			if [ -n "${DT[$id]["oh"]-}" ] && [ "$DT_ZOOMFILL" = every ] &&
			   ! { [ "${#DT_FULLS[@]}" != 0 ] && dt_isfull "$id"; }; then
				# Where it goes back to, kept inside its own display
				# when that is one that changed.
				dt_wfithome "${DT[$id]["or"]:-0}" "${DT[$id]["oc"]:-0}" \
					"${DT[$id]["oh"]}" "${DT[$id]["ow"]:-1}"
				if [ -n "$DTF_HOME" ] && [ -n "${chg["$DTF_HOME"]-}" ]; then
					n=${map["$DTF_HOME"]}
					ntop=${qr["$n"]}
					[ "${qr["$n"]} ${qc["$n"]}" = "$pr $pc" ] && ntop=$((ntop + 1))
					dt_wsavedfit "$id" o $((qr["$n"] - DT_WFR["$DTF_HOME"])) \
						$((qc["$n"] - DT_WFC["$DTF_HOME"])) "$ntop" \
						$((qr["$n"] + qh["$n"])) "${qc["$n"]}" "${qw["$n"]}"
				fi
				[ "1 0 $zh $DT_COLS" = "${DT[$id]["row"]} ${DT[$id]["col"]} ${DT[$id]["h"]} ${DT[$id]["w"]}" ] &&
					continue
				DT[$id]["row"]=1
				DT[$id]["col"]=0
				DT[$id]["h"]=$zh
				DT[$id]["w"]=$DT_COLS
				dt_away "$id" || dt_hidden "$id" || console pane "w$id" 1 0 "$zh" "$DT_COLS"
				moved=$((moved + 1))
				continue
			fi
			dt_wfithome "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
				"${DT[$id]["shaded"]:-${DT[$id]["h"]}}" "${DT[$id]["w"]}"
			[ -n "$DTF_HOME" ] && [ -n "${chg["$DTF_HOME"]-}" ] || continue
			k=$DTF_HOME
			n=${map["$k"]}
			ntop=${qr["$n"]}
			[ "${qr["$n"]} ${qc["$n"]}" = "$pr $pc" ] && ntop=$((ntop + 1))
			# The common case, asked here rather than in a call: a plain
			# window on a display that grew, or shrank somewhere else, and
			# did not move, still inside it as it is.
			if [ "${DT_WFR["$k"]} ${DT_WFC["$k"]}" = "${qr["$n"]} ${qc["$n"]}" ] &&
			   [ -z "${DT[$id]["oh"]-}${DT[$id]["snap"]-}${DT_WKEEP["$id"]-}" ] &&
			   [ "${DT[$id]["row"]}" -ge "$ntop" ] && [ "${DT[$id]["col"]}" -ge "${qc["$n"]}" ] &&
			   [ $((DT[$id]["row"] + ${DT[$id]["shaded"]:-${DT[$id]["h"]}})) -le $((qr["$n"] + qh["$n"])) ] &&
			   [ $((DT[$id]["col"] + DT[$id]["w"])) -le $((qc["$n"] + qw["$n"])) ] &&
			   ! { [ "${#DT_FULLS[@]}" != 0 ] && dt_isfull "$id"; }; then
				continue
			fi
			otop=${DT_WFR["$k"]}
			[ "${DT_WFR["$k"]} ${DT_WFC["$k"]}" = "$o" ] && otop=$((otop + 1))
			dt_winfit1 "$id" "${DT_WFR["$k"]}" "${DT_WFC["$k"]}" "${DT_WFH["$k"]}" \
				"${DT_WFW["$k"]}" "$otop" "${qr["$n"]}" "${qc["$n"]}" "${qh["$n"]}" \
				"${qw["$n"]}" "$ntop" && moved=$((moved + 1))
		done
	fi
	# Those attached now, then those that have left and were not seen
	# again under another name, the newest leaving first.
	for k in "${DT_WFITORD[@]}"; do
		[ -n "${map["$k"]+x}" ] && continue
		[ "${#keep[@]}" -lt "$DT_WFITKEEP" ] || break
		keep+=("$k ${DT_WFR["$k"]} ${DT_WFC["$k"]} ${DT_WFH["$k"]} ${DT_WFW["$k"]}")
	done
	DT_WFR=()
	DT_WFC=()
	DT_WFH=()
	DT_WFW=()
	for k in "${ord[@]}"; do
		DT_WFR["$k"]=${qr["$k"]}
		DT_WFC["$k"]=${qc["$k"]}
		DT_WFH["$k"]=${qh["$k"]}
		DT_WFW["$k"]=${qw["$k"]}
	done
	DT_WFITORD=("${ord[@]}")
	for i in "${keep[@]}"; do
		read -r k dr dc drows dcols <<< "$i"
		DT_WFR["$k"]=$dr
		DT_WFC["$k"]=$dc
		DT_WFH["$k"]=$drows
		DT_WFW["$k"]=$dcols
		DT_WFITORD+=("$k")
	done
	DT_WFITSHIFT=${DT_SHIFTWAS-}
	DT_WFITPRI="$pr $pc"
	if [ "$moved" != 0 ]; then
		DT_FORCEONCE=1
		o=
		for k in "${!chg[@]}"; do
			k=${k#d}
			o="$o ${k:-(the screen)}"
		done
		dt_log "a display changed size:$o; $moved windows kept inside it"
	fi
	return 0
}

# Which remembered display a rectangle was on, into DTF_HOME: the one its
# middle is on, else the one its top left is on, else none.
fn dt_wfithome(int r, int c, int h, int w) {
	local k cr=$((r + h / 2)) cc=$((c + w / 2))

	DTF_HOME=
	for k in "${DT_WFITORD[@]}"; do
		if [ "$cr" -ge "${DT_WFR["$k"]}" ] && [ "$cr" -lt $((DT_WFR["$k"] + DT_WFH["$k"])) ] &&
		   [ "$cc" -ge "${DT_WFC["$k"]}" ] && [ "$cc" -lt $((DT_WFC["$k"] + DT_WFW["$k"])) ]; then
			DTF_HOME=$k
			return 0
		fi
	done
	for k in "${DT_WFITORD[@]}"; do
		if [ "$r" -ge "${DT_WFR["$k"]}" ] && [ "$r" -lt $((DT_WFR["$k"] + DT_WFH["$k"])) ] &&
		   [ "$c" -ge "${DT_WFC["$k"]}" ] && [ "$c" -lt $((DT_WFC["$k"] + DT_WFW["$k"])) ]; then
			DTF_HOME=$k
			return 0
		fi
	done
	return 0
}

# A rectangle a window goes back to -- pre o for where Zoom put it from, s
# for its snap, fs for full screen -- moved by ddr and ddc with its display
# and kept inside it as dt_rectfit says. One the window does not have is
# left alone. As for the window itself, what it was before the first fit is
# kept (DT_WKEEP, under "id pre") and put back once the display holds it
# again, unless something else has changed it since.
fn dt_wsavedfit(int id, pre, int ddr, int ddc, int top, int bot, int dc, int dw, fx = "") {
	local kr kc kh kw cur k="$id $pre" kept= keep
	local -a kq

	case $pre in
	o) kr=or kc=oc kh=oh kw=ow ;;
	s) kr=sr kc=sc kh=sh kw=sw ;;
	fs) kr=fsr kc=fsc kh=fsh kw=fsw ;;
	*) return 1 ;;
	esac
	[ -n "${DT[$id]["$kr"]-}" ] && [ -n "${DT[$id]["$kc"]-}" ] &&
		[ -n "${DT[$id]["$kh"]-}" ] && [ -n "${DT[$id]["$kw"]-}" ] || return 0
	cur="${DT[$id]["$kr"]} ${DT[$id]["$kc"]} ${DT[$id]["$kh"]} ${DT[$id]["$kw"]}"
	if [ -n "${DT_WKEEP["$k"]+x}" ]; then
		if [ "${DT_WKEEP["$k"]#*|}" = "$cur" ]; then
			read -ra kq <<< "${DT_WKEEP["$k"]%|*}"
			kept="$((kq[0] + ddr)) $((kq[1] + ddc)) ${kq[2]} ${kq[3]}"
		else
			unset DT_WKEEP["$k"]
		fi
	fi
	keep=${kept:-$((DT[$id]["$kr"] + ddr)) $((DT[$id]["$kc"] + ddc)) ${DT[$id]["$kh"]} ${DT[$id]["$kw"]}}
	read -ra kq <<< "$keep"
	if [ -n "$kept" ] && [ "${kq[0]}" -ge "$top" ] && [ "${kq[1]}" -ge "$dc" ] &&
	   [ $((kq[0] + kq[2])) -le "$bot" ] && [ $((kq[1] + kq[3])) -le $((dc + dw)) ]; then
		DTF_R=${kq[0]}
		DTF_C=${kq[1]}
		DTF_H=${kq[2]}
		DTF_W=${kq[3]}
		unset DT_WKEEP["$k"]
	else
		dt_rectfit $((DT[$id]["$kr"] + ddr)) $((DT[$id]["$kc"] + ddc)) \
			"${DT[$id]["$kh"]}" "${DT[$id]["$kw"]}" "$top" "$bot" "$dc" "$dw" "$fx" ||
			return 0
		if [ -n "$kept" ] || [ "$DTF_R $DTF_C $DTF_H $DTF_W" != "$cur" ]; then
			DT_WKEEP["$k"]="$keep|$DTF_R $DTF_C $DTF_H $DTF_W"
		fi
	fi
	DT[$id]["$kr"]=$DTF_R
	DT[$id]["$kc"]=$DTF_C
	DT[$id]["$kh"]=$DTF_H
	DT[$id]["$kw"]=$DTF_W
	return 0
}

# Keep one window inside its display, which was at odr, odc, odh by odw
# (its first row for a window otop, below the bar on the primary) and is at
# nr, nc, nh by nw now (ntop). Status 1 when the window did not move.
#
#   - An ordinary window moves with its display, keeps its place where it
#     still fits, is pulled back from the right and the bottom where it
#     does not, and is made smaller only where it cannot fit at all
#     (dt_rectfit); a fixed one never is, and keeps its top left and its
#     title on the display. A shaded one is fitted by the height it unrolls
#     to. Where it was before is kept (DT_WKEEP) and it goes back there
#     once the display holds that again, unless it was moved or sized
#     since by anything but this.
#   - A zoomed window fills its display at the new size, as Zoom would;
#     where it goes back to is kept inside the display too.
#   - A snapped one still where its snap put it is snapped again on the new
#     size; one moved since keeps the snap's name and is fitted as an
#     ordinary window. Where it goes back to is kept inside either way.
#   - A full-screen one covers its display at the new size at once
#     (dt_fullfit). dt_fullcheck follows a display by the window's middle,
#     which a display shrinking by more than half takes with it; where it
#     goes back to is kept inside.
#   - A minimised one, or one on another workspace, has its record kept
#     inside and no pane until it is shown.
#   - A program's window (wm/native.hibr) is told its new size by its own
#     next draw, which sees the size change, and its fitted place moves
#     with it so dt_natkeep does not remember the desktop's doing as the
#     person's. A program's own least size cannot outweigh the display, as
#     in dt_natclamp: a window is made smaller only to the display's own
#     size, never past it.
#
# A tiled window never comes here: the layout is redone after this by
# dt_size, or when its workspace is shown.
fn dt_winfit1(int id, int odr, int odc, int odh, int odw, int otop, int nr, int nc, int nh, int nw, int ntop) {
	local r=${DT[$id]["row"]} c=${DT[$id]["col"]} h=${DT[$id]["h"]} w=${DT[$id]["w"]}
	local hh fx= sn ddr=$((nr - odr)) ddc=$((nc - odc)) bot=$((nr + nh)) kept= keep=
	local -a kq

	hh=${DT[$id]["shaded"]:-$h}
	[ "${DT_APPS["${DT[$id]["app"]:-none}"]["fixed"]-}" = 1 ] && fx=1
	# Where it was before a change of size moved it, still worth going
	# back to only while it is where that change put it.
	if [ -n "${DT_WKEEP["$id"]+x}" ]; then
		if [ "${DT_WKEEP["$id"]#*|}" = "$r $c $hh $w" ]; then
			read -ra kq <<< "${DT_WKEEP["$id"]%|*}"
			kept="$((kq[0] + ddr)) $((kq[1] + ddc)) ${kq[2]} ${kq[3]}"
		else
			unset DT_WKEEP["$id"]
		fi
	fi
	if [ "${#DT_FULLS[@]}" != 0 ] && dt_isfull "$id"; then
		dt_wsavedfit "$id" fs "$ddr" "$ddc" "$ntop" "$bot" "$nc" "$nw" "$fx"
		DT[$id]["row"]=$nr
		DT[$id]["col"]=$nc
		DT[$id]["h"]=$nh
		DT[$id]["w"]=$nw
		dt_fullfit "$id"
		return 0
	fi
	if [ -n "${DT[$id]["oh"]-}" ]; then
		dt_wsavedfit "$id" o "$ddr" "$ddc" "$ntop" "$bot" "$nc" "$nw" "$fx"
		DTF_R=$ntop
		DTF_C=$nc
		DTF_H=$((bot - ntop))
		DTF_W=$nw
	else
		sn=${DT[$id]["snap"]-}
		if [ -n "$sn" ]; then
			dt_snapat "$sn" "$otop" "$odc" $((odr + odh - otop)) "$odw" "$h" "$w" &&
				[ "$DTF_R $DTF_C $DTF_H $DTF_W" = "$r $c $h $w" ] || sn=
			dt_wsavedfit "$id" s "$ddr" "$ddc" "$ntop" "$bot" "$nc" "$nw" "$fx"
		fi
		if [ -n "$sn" ]; then
			dt_snapat "$sn" "$ntop" "$nc" $((bot - ntop)) "$nw" "$h" "$w"
			dt_rectfit "$DTF_R" "$DTF_C" "$DTF_H" "$DTF_W" "$ntop" "$bot" "$nc" "$nw" "$fx"
		else
			# Back where it was when its display holds that again;
			# else fitted from where it is, the first place kept.
			keep=${kept:-$((r + ddr)) $((c + ddc)) $hh $w}
			if [ -n "$kept" ]; then
				read -ra kq <<< "$kept"
				if [ "${kq[0]}" -ge "$ntop" ] && [ "${kq[1]}" -ge "$nc" ] &&
				   [ $((kq[0] + kq[2])) -le "$bot" ] && [ $((kq[1] + kq[3])) -le $((nc + nw)) ]; then
					DTF_R=${kq[0]}
					DTF_C=${kq[1]}
					DTF_H=${kq[2]}
					DTF_W=${kq[3]}
					keep=
					unset DT_WKEEP["$id"]
				fi
			fi
			[ -n "$keep" ] &&
				dt_rectfit $((r + ddr)) $((c + ddc)) "$hh" "$w" "$ntop" "$bot" "$nc" "$nw" "$fx"
		fi
	fi
	# What is kept moves with the display even when the window does not.
	[ -n "$keep" ] && DT_WKEEP["$id"]="$keep|$DTF_R $DTF_C $DTF_H $DTF_W"
	[ "$DTF_R $DTF_C $DTF_H $DTF_W" = "$r $c $hh $w" ] && {
		[ -n "$kept" ] || unset DT_WKEEP["$id"]
		return 1
	}
	DT[$id]["row"]=$DTF_R
	DT[$id]["col"]=$DTF_C
	DT[$id]["w"]=$DTF_W
	if [ -n "${DT[$id]["shaded"]-}" ]; then
		DT[$id]["shaded"]=$DTF_H
	else
		DT[$id]["h"]=$DTF_H
	fi
	[ "${DT[$id]["app"]}" = native ] && dt_has dt_natmoved &&
		dt_natmoved "$id" "$r $c $h $w" "$DTF_R $DTF_C ${DT[$id]["h"]} $DTF_W"
	dt_away "$id" || dt_hidden "$id" ||
		console pane "w$id" "$DTF_R" "$DTF_C" "${DT[$id]["h"]}" "$DTF_W"
	return 0
}

# Where a dialog h by w opens, in DT_DLGR, DT_DLGC, DT_DLGH and DT_DLGW:
# centred over the window being worked in -- the focused one -- and kept
# inside that window's display, or in the middle of the primary when no
# window has focus. It is made smaller to fit that display, less m columns
# and m - 1 rows (2 by default): the rows the old screen-wide clamp kept
# back were the bar's and a shadow's, and a primary's own rectangle has
# the bar taken out already. Centred on the whole screen instead, a dialog
# opened from a window on one of several displays landed on another, or
# between two (Gitea #293).
DT_DLGR=1
DT_DLGC=0
DT_DLGH=1
DT_DLGW=1
fn dt_dlgat(int h, int w, int? m = "") {
	dt_dlgfor "$DT_FOCUS" "$h" "$w" "$m"
}

# The same, for a dialog that belongs to window f rather than to whatever
# has focus now -- a confirm remembers who asked (Gitea #390) -- and on the
# primary for f empty, or a window that has gone, is minimised or away.
fn dt_dlgfor(f, int h, int w, int? m = "") {
	local cr cc r c

	[ -n "$m" ] || m=2
	if [ -n "$f" ] && [ -n "${DT[$f]["row"]+x}" ] &&
		[ "${DT[$f]["min"]}" != 1 ] && ! dt_away "$f"; then
		dt_windisp "$f"
		cr=$((DT[$f]["row"] + DT[$f]["h"] / 2))
		cc=$((DT[$f]["col"] + DT[$f]["w"] / 2))
	else
		dt_dispat "${DT_PRIMARY_ROW:-0}" "${DT_PRIMARY_COL:-0}"
		cr=$((DTW_R + DTW_H / 2))
		cc=$((DTW_C + DTW_W / 2))
	fi
	[ "$h" -gt $((DTW_H - m + 1)) ] && h=$((DTW_H - m + 1))
	[ "$w" -gt $((DTW_W - m)) ] && w=$((DTW_W - m))
	[ "$h" -lt 1 ] && h=1
	[ "$w" -lt 1 ] && w=1
	r=$((cr - h / 2))
	c=$((cc - w / 2))
	[ $((r + h)) -gt $((DTW_R + DTW_H)) ] && r=$((DTW_R + DTW_H - h))
	[ $((c + w)) -gt $((DTW_C + DTW_W)) ] && c=$((DTW_C + DTW_W - w))
	[ "$r" -lt "$DTW_R" ] && r=$DTW_R
	[ "$c" -lt "$DTW_C" ] && c=$DTW_C
	DT_DLGR=$r
	DT_DLGC=$c
	DT_DLGH=$h
	DT_DLGW=$w
	return 0
}

# Fill the window's own display, or every display when Control Panel >
# Windows > Zoom Fills says so (Gitea #286) -- or go back to where the
# window was.
fn dt_zoom(int id) {
	dt_winok "$id" dt_zoom || return 1
	[ -n "${DT[$id]["shaded"]-}" ] && dt_shade "$id"
	if [ -n "${DT[$id]["oh"]}" ]; then
		DT[$id]["row"]=${DT[$id]["or"]}
		DT[$id]["col"]=${DT[$id]["oc"]}
		DT[$id]["h"]=${DT[$id]["oh"]}
		DT[$id]["w"]=${DT[$id]["ow"]}
		DT[$id]["oh"]=
	else
		DT[$id]["or"]=${DT[$id]["row"]}
		DT[$id]["oc"]=${DT[$id]["col"]}
		DT[$id]["oh"]=${DT[$id]["h"]}
		DT[$id]["ow"]=${DT[$id]["w"]}
		if [ "$DT_ZOOMFILL" = every ]; then
			DT[$id]["row"]=1
			DT[$id]["col"]=0
			DT[$id]["h"]=$((DT_ROWS - 1))
			DT[$id]["w"]=$DT_COLS
		else
			dt_windisp "$id"
			DT[$id]["row"]=$DTW_R
			DT[$id]["col"]=$DTW_C
			DT[$id]["h"]=$DTW_H
			DT[$id]["w"]=$DTW_W
		fi
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Give a window a new title; an app knows what it is showing better than
# the menu that opened it does.
fn dt_retitle(int id, title) {
	dt_winok "$id" dt_retitle || return 1
	DT[$id]["title"]="$title"
}

# A window's own colours, its face and its ink, for an app whose window is
# a thing with colours of its own -- a sticky note -- rather than the
# theme's: what the frame and a bare window's strip are drawn in. Each is
# #rrggbb, or empty for the theme's. Asked where the app chooses them, never
# from its _draw; a change makes the next frame whole, since the frame
# around the window changes with them.
fn dt_wincolours(int id, bg, fg) {
	local c

	dt_winok "$id" dt_wincolours || return 1
	for c in "$bg" "$fg"; do
		[ -z "$c" ] || [[ $c =~ ^#[0-9a-fA-F]{6}$ ]] ||
			{ dt_log "refused: dt_wincolours: $c is not a colour"; return 1; }
	done
	[ "${DT[$id]["bg"]-}" = "$bg" ] && [ "${DT[$id]["fg"]-}" = "$fg" ] && return 0
	DT[$id]["bg"]=$bg
	DT[$id]["fg"]=$fg
	DT_FORCEONCE=1
}

dt_close_focused() { [ -n "$DT_FOCUS" ] && dt_closereq "$DT_FOCUS"; }

# Quit the focused window's app: every window it has, not only the one in
# front, which is what Quit means on a desktop where one app may have
# several. Each goes through dt_closereq, so an app that asks before closing
# -- an editor with unsaved text, a terminal with a program still running --
# asks once per window rather than being overruled. The ids are taken before
# any of them closes, since dt_del removes them as it goes.
fn dt_quitapp() {
	local ap id
	local -a ids=()

	[ -n "$DT_FOCUS" ] || return 0
	ap=${DT[$DT_FOCUS]["app"]}
	[ -n "$ap" ] || return 0
	dt_wins
	for id in "${DT_WINS[@]}"; do
		[ "${DT[$id]["app"]}" = "$ap" ] && ids+=("$id")
	done
	for id in "${ids[@]}"; do
		dt_closereq "$id"
	done
	return 0
}

# Close a window someone asked to close -- the close button, Close on a
# menu, the Close Window key -- unless its app's _canclose says not yet: an
# editor with unsaved changes asks first, and closes it itself if told to.
fn dt_closereq(int id) {
	local cb=${DT[$id]["canclose"]}

	DT_NOTEWIN=$id
	if [ -n "$cb" ] && ! dt_wincall "$id" "$cb"; then
		return 0
	fi
	dt_del "$id"
}

dt_hide_focused() { [ -n "$DT_FOCUS" ] && dt_min "$DT_FOCUS"; }

dt_zoom_focused() { [ -n "$DT_FOCUS" ] && dt_zoom "$DT_FOCUS"; }

# Roll window id up to its title bar, or down again: the shade box of a
# Chalk or Slate title bar (Blit ADR 0210), the Window menu's Shade and its
# shortcut. Rolled up it is its title bar and its frame's bottom edge --
# the title bar alone with no border -- below the window manager's own
# least height, so the full height is kept in its own field, never in the
# one zoom keeps. Its app is not drawn while it is, and is still given its
# _idle, so a terminal's program is read and cannot leave the desktop
# spinning on it.
fn dt_shade(int id) {
	dt_winok "$id" dt_shade || return 1
	local rows=2

	if [ -n "${DT[$id]["shaded"]-}" ]; then
		DT[$id]["h"]=${DT[$id]["shaded"]}
		DT[$id]["shaded"]=
	else
		dt_capped "$id" && rows=1
		DT[$id]["shaded"]=${DT[$id]["h"]}
		DT[$id]["h"]=$rows
	fi
	console pane "w$id" "${DT[$id]["row"]}" "${DT[$id]["col"]}" \
		"${DT[$id]["h"]}" "${DT[$id]["w"]}"
	DT_FORCEONCE=1
}

dt_shade_focused() { [ -n "$DT_FOCUS" ] && dt_shade "$DT_FOCUS"; }

# Bring the bottom window to the top.
dt_cycle() {
	local l id i=0 f=-1 n ws
	local -a ids

	if [ "$DT_CYCLE" != all ] || [ "$DT_WSN" -le 1 ]; then
		l := dt_wpanes
		l=${l%% *}
		[ -n "$l" ] && dt_raise "${l#w}"
		return 0
	fi
	# Every workspace, from this one on and round, each one's windows in
	# the order they were opened; a minimised window is skipped, as it is
	# on this workspace alone.
	while [ "$i" -lt "$DT_WSN" ]; do
		ws=$(((DT_WS - 1 + i) % DT_WSN + 1))
		dt_wins
		for id in "${DT_WINS[@]}"; do
			[ "${DT[$id]["ws"]:-1}" = "$ws" ] || continue
			dt_hidden "$id" && continue
			[ "$id" = "$DT_FOCUS" ] && f=${#ids[@]}
			ids+=("$id")
		done
		i=$((i + 1))
	done
	n=${#ids[@]}
	[ "$n" -gt 0 ] || return 0
	dt_raise "${ids[$(((f + 1) % n))]}"
}

# The window switcher (Gitea #391): the bar's window list, opened by Cycle
# and stepped by Cycle and Cycle Back, choosing where it stands once the
# keys pause. A terminal tells the desktop a key was pressed and not that
# alt was let go, so the pause stands in for the release; any other key
# chooses too, and then goes where it would have, and escape puts it away
# with nothing chosen. DT_SW is set while it is open.
DT_SW=
DT_SWAT=0

# Whether the switcher stops on a window: not one hidden, not one on
# another workspace unless Cycle goes through every workspace, and not an
# app on the list it passes over.
fn dt_swok(int id) {
	dt_hidden "$id" && return 1
	[ "$DT_CYCLE" = all ] || ! dt_away "$id" || return 1
	case " $DT_SWSKIP " in *" ${DT[$id]["app"]} "*) return 1 ;; esac
	return 0
}

# Cycle (d 1) or Cycle Back (d -1): open the switcher on the window that
# has the focus, and step from it.
fn dt_swstart(int d) {
	local ids id i=0
	local -a il

	if [ "${DT_SWITCHER:-1}" != 1 ]; then
		dt_cycle
		return 0
	fi
	ids := dt_ids
	read -ra il <<< "$ids"
	[ "${#il[@]}" -gt 0 ] || return 0
	dt_mopen app
	MB_SEL=0
	for id in "${il[@]}"; do
		[ "$id" = "$DT_FOCUS" ] && MB_SEL=$i
		i=$((i + 1))
	done
	DT_SW=1
	dt_swstep "$d"
}

# Step the switcher to the next window it stops on, d rows on, round the
# list; the pause starts again.
fn dt_swstep(int d) {
	local ids n k=0 i=$MB_SEL
	local -a il

	ids := dt_ids
	read -ra il <<< "$ids"
	n=${#il[@]}
	[ "$n" -gt 0 ] || { dt_swend; return 0; }
	while [ "$k" -lt "$n" ]; do
		i=$(((i + d + n) % n))
		dt_swok "${il[$i]}" && break
		k=$((k + 1))
	done
	MB_SEL=$i
	DT_SWAT := dt_ms
	dt_want "${DT_SWMS:-700}"
}

# Go to the window the switcher stands on.
dt_swcommit() {
	DT_SW=
	[ "$MB_OPEN" = app ] && dt_mdo
	return 0
}

# Put the switcher away with nothing chosen.
dt_swend() {
	DT_SW=
	[ "$MB_OPEN" = app ] && dt_mclose
	return 0
}

# After each frame: once the keys have paused long enough, choose; and a
# switcher whose list was closed some other way -- a click on a row, a
# click outside it -- is over.
dt_swtick() {
	local now left

	[ -n "$DT_SW" ] || return 0
	if [ "$MB_OPEN" != app ]; then
		DT_SW=
		return 0
	fi
	now := dt_ms
	left=$((DT_SWAT + ${DT_SWMS:-700} - now))
	if [ "$left" -le 0 ]; then
		dt_swcommit
		dt_want 1
	else
		dt_want "$left"
	fi
}
dt_ticker dt_swtick

# Move a window onto a specific display's own rectangle -- the titlebar
# menu's "Move to" submenu. Placed at that display's own top-left corner,
# clamped to still fit within it, the same shape dt_move already clamps a
# drag to the whole screen with, just against one display's box instead of
# the whole union.
fn dt_movewin(int id, int drow, int dcol, int drows, int dcols) {
	dt_winok "$id" dt_movewin || return 1
	local r c

	r=$drow
	c=$dcol
	[ $((r + DT[$id]["h"])) -gt $((drow + drows)) ] &&
		r=$((drow + drows - DT[$id]["h"]))
	[ $((c + DT[$id]["w"])) -gt $((dcol + dcols)) ] &&
		c=$((dcol + dcols - DT[$id]["w"]))
	[ "$r" -lt "$drow" ] && r=$drow
	[ "$c" -lt "$dcol" ] && c=$dcol
	r := dt_toprow "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
	DT[$id]["row"]=$r
	DT[$id]["col"]=$c
	console pane "w$id" "$r" "$c" "${DT[$id]["h"]}" "${DT[$id]["w"]}"
}

# Take the arrows for moving or resizing the focused window, until enter or
# escape gives them back.  This is the keyboard's answer to dragging a title
# bar, and the only one there is: a desktop that can only be arranged with a
# mouse is a desktop half its users cannot arrange.
fn dt_grab(mode) {
	[ -z "$DT_FOCUS" ] && return 1
	DT_GRAB=$mode
	if [ "$mode" = move ]; then
		dt_notep low "moving — arrows, then enter"
	else
		dt_notep low "resizing — arrows, then enter"
	fi
}

# One key while the arrows are taken.  Returns 1 for a key it does not want.
fn dt_gkey(key) {
	local id=$DT_FOCUS dr=0 dc=0

	case $key in
	up) dr=-1 ;;
	down) dr=1 ;;
	left) dc=-1 ;;
	right) dc=1 ;;
	enter | escape | " ")
		DT_GRAB=
		dt_note_clear
		return 0
		;;
	*) return 1 ;;
	esac
	if [ -z "$id" ]; then
		DT_GRAB=
		return 0
	fi
	if [ "$DT_GRAB" = move ]; then
		dt_move "$id" $((DT[$id]["row"] + dr)) \
			$((DT[$id]["col"] + dc))
	else
		dt_resize "$id" $((DT[$id]["h"] + dr)) \
			$((DT[$id]["w"] + dc))
	fi
	return 0
}
