# wm/input -- keys and the mouse: where each one goes, and the shortcuts the
# desktop keeps for itself.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Handle one mouse report.
#
# An app is told a click in *pane* coordinates -- the same ones it draws in,
# where row 0 is the top border -- and not in some separate body coordinate
# system. Two systems is one too many: an app that draws at row 4 and is told
# a click at row 3 has to hold both in its head, and the first two apps each
# got the conversion wrong. The window manager handles row 0 itself, so an
# app only ever sees a click at row 1 or below.
#
# A report is `<action> <button> <row> <col>` for a press, a release or a
# drag, and `<action> <row> <col>` for the wheel, which has no button -- so
# the position cannot be read from a fixed argument. The action may carry a
# modifier, `ctrl-press`, which is stripped: a modified click is still a
# click here.
#
# Window fields are read into locals first: a subscript is only literal when
# it is quoted, and arithmetic never sees the quotes, so DT[$id][col] inside
# $(( )) would mean DT[$id][5] here.

dt_mouse() {
	local act=${1##*-} mr mc mods
	local id b bi wr wc wa wh ww ap mo now dr dc wsn p g
	local -a gv

	mods=${1%"$act"}
	mods=${mods%-}
	shift
	case $act in
	wheelup | wheeldown | wheelleft | wheelright) mr=$1; mc=$2 ;;
	*) mr=$2; mc=$3 ;;
	esac
	# A wheel with shift held scrolls sideways, which is the convention
	# everywhere else and the only way to reach a horizontal bar on a
	# mouse with no sideways wheel of its own.
	case $mods-$act in
	*shift*-wheelup) act=wheelleft ;;
	*shift*-wheeldown) act=wheelright ;;
	esac

	case $act in
	press)
		# A bar item's own panel takes a press inside it, and goes on a
		# press anywhere else, like a menu (Gitea #310): a left one on its
		# own item only closes it, one elsewhere on the bar goes on to what
		# it was aimed at, and one anywhere else is taken by the close.
		if [ -n "$DT_POP" ]; then
			if dt_pophit "$mr" "$mc"; then
				if [ "$1" = left ]; then
					DT_POPHELD=1
					dt_popmouse press "$mr" "$mc"
				elif [ "$1" = right ]; then
					dt_popmouse rpress "$mr" "$mc"
				fi
				return 0
			fi
			b=$DT_POPITEM
			dt_popclose
			dt_onbar "$mr" "$mc" || return 0
			[ "$1" != right ] && bi := dt_barihit "$mc" &&
				[ "$bi" = "$b" ] && return 0
			[ "$1" != right ] && [ "$b" = bell ] &&
				[ "$mc" -ge "$DT_BELLC" ] &&
				[ "$mc" -lt $((DT_BELLC + DT_BELLW)) ] && return 0
		fi
		if dt_onbar "$mr" "$mc"; then
			if [ "$1" != right ] && wsn := dt_wshit "$mc"; then
				dt_mclose
				dt_wsgo "$wsn"
				return 0
			fi
			if [ "$mc" -ge "$DT_BELLC" ] &&
			   [ "$mc" -lt $((DT_BELLC + DT_BELLW)) ]; then
				# The notes are a panel under the icon, and a
				# right click is the icon's own menu.
				if [ "$1" = right ]; then
					dt_context_open nhbell "" "$mr" "$mc"
				else
					dt_bellpop
				fi
				return 0
			fi
			if [ "$mc" -ge "$DT_CLOCKC" ] &&
			   [ "$mc" -lt $((DT_CLOCKC + DT_CLOCKW)) ]; then
				dt_mclose
				dt_has clock_draw && dt_launch clock
				return 0
			fi
			# An item an app put on the bar (Gitea #160). After
			# the icon and the clock, which are the desktop's own
			# and keep their places.
			if bi := dt_barihit "$mc"; then
				dt_mclose
				dt_barido "$bi" "$1"
				return 0
			fi
			if [ "$1" = right ]; then
				dt_context_open bar "" "$mr" "$mc"
				return 0
			fi
			b := dt_mhit "$mc" || { dt_mclose; return 0; }
			if [ "$b" = "$MB_OPEN" ]; then
				dt_mclose
			else
				dt_mopen "$b"
			fi
			return 0
		fi
		if [ "$MB_OPEN" != -1 ]; then
			dt_mfoot "$mr" "$mc" && return 0
			if dt_mpick "$mr" "$mc"; then
				dt_mdo
			else
				dt_mclose
			fi
			return 0
		fi
		id := dt_note_hit "$mr" "$mc" && { dt_note_click "$id" "$mr"; return 0; }
		cs_press "$mr" "$mc" && return 0
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			if [ "$1" = right ]; then
				dt_context_open desktop "" "$mr" "$mc"
				return 0
			fi
			DT_FOCUS=
			dt_iconpress "$mr" "$mc" "$mods"
			return 0
		fi
		id=${id#w}
		console pane raise "w$id"
		DT_FOCUS=$id
		wr=${DT[$id]["row"]}
		wc=${DT[$id]["col"]}
		# The column the app's own coordinates count from: one left of
		# the window when it has no border, so its column 1 is the edge.
		wa=$wc
		dt_capped "$id" && wa=$((wc - 1))
		ww=${DT[$id]["w"]}
		wh=${DT[$id]["h"]}
		ap=${DT[$id]["click"]}
		DT_NOTEWIN=$id
		# A grip -- a corner, or a side with Edge Resize on -- starts a
		# resize, the opposite edge anchored: captured once, here, since
		# the window's own row and col start changing the moment a top or
		# left edge does. dt_grip is what decides, and the pointer's shape
		# over a window asks it too, so the two cannot disagree.
		if g := dt_grip "$id" "$mr" "$mc"; then
			DT_SIZE=$id
			DT_SIZECORNER=$g
			case $g in
			br) DT_SIZE_AR=$wr; DT_SIZE_AC=$wc ;;
			tl) DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$((wc + ww - 1)) ;;
			tr) DT_SIZE_AR=$((wr + wh - 1)); DT_SIZE_AC=$wc ;;
			bl) DT_SIZE_AR=$wr; DT_SIZE_AC=$((wc + ww - 1)) ;;
			l) DT_SIZE_AC=$((wc + ww - 1)) ;;
			r) DT_SIZE_AC=$wc ;;
			b) DT_SIZE_AR=$wr ;;
			esac
			return 0
		fi
		# No chrome: a right press is the app's context menu, a second
		# press soon after the first is told to the app as a double click,
		# and any other press moves the window.
		if [ "${DT[$id]["chrome"]}" = none ]; then
			if [ "$1" = right ]; then
				dt_has "${DT[$id]["app"]}_context" &&
					dt_context_open "${DT[$id]["app"]}" "$id" "$mr" "$mc"
				return 0
			fi
			if dt_isdbl "$id"; then
				[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wa)) double
				return 0
			fi
			DT_DRAG=$id
			DT_DRAGR0=$wr
			DT_DRAGC0=$wc
			DT_DR=$((mr - wr))
			DT_DC=$((mc - wc))
			return 0
		fi
		if [ "$mr" -ne "$wr" ]; then
			if [ "$DT_DRAGMOD" = 1 ] && [ "$1" != right ]; then
				case "-$mods-" in
				*"-$DT_DRAGKEY-"*)
					DT_DRAG=$id
					DT_DR=$((mr - wr))
					DT_DC=$((mc - wc))
					return 0
					;;
				esac
			fi
			if [ "$1" = left ] &&
			   dt_sbpress "$id" $((mr - wr)) $((mc - wa)); then
				return 0
			fi
			if [ "$1" = left ] &&
			   dt_fdpress "$id" $((mr - wr)) $((mc - wa)) "$mods"; then
				return 0
			fi
			mo=${DT[$id]["mouse"]}
			if [ -n "$mo" ]; then
				DT_MOUSE=$id
				$mo "$id" press "$1" $((mr - wr)) $((mc - wa)) \
					"$mods"
				return 0
			fi
			if [ "$1" = right ] &&
			   dt_has "${DT[$id]["app"]}_context"; then
				dt_context_open "${DT[$id]["app"]}" "$id" \
					"$mr" "$mc"
				return 0
			fi
			[ -n "$ap" ] && $ap "$id" $((mr - wr)) $((mc - wa)) "$1"
			return 0
		fi
		b := dt_btnat "$id" $((mc - wc))
		if [ "$1" = right ] && [ -z "$b" ]; then
			dt_context_open titlebar "$id" "$mr" "$mc"
			return 0
		fi
		if [ -n "$b" ]; then
			DT_BTNID=$id
			DT_BTNKIND=$b
			DT_BTNOVER=1
			return 0
		fi
		now := dt_ms
		if [ "$DT_DBLACTION" != none ] &&
		   [ "$DT_DBLID" = "$id" ] &&
		   [ $((now - DT_DBLT)) -lt "$DT_DBLMS" ]; then
			DT_DBLID=
			case $DT_DBLACTION in
			zoom)
				[ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" \
					!= 1 ] && dt_zoom "$id"
				;;
			min) dt_min "$id" ;;
			close) dt_closereq "$id" ;;
			esac
			return 0
		fi
		DT_DBLID=$id
		DT_DBLT=$now
		DT_DRAG=$id
		DT_DRAGR0=$wr
		DT_DRAGC0=$wc
		DT_DR=$((mr - wr))
		DT_DC=$((mc - wc))
		;;
	drag | release)
		# A press that began inside a bar item's panel is its own until
		# the button comes up, wherever the pointer goes.
		if [ -n "$DT_POPHELD" ]; then
			[ "$act" = release ] && DT_POPHELD=
			[ -n "$DT_POP" ] && dt_popmouse "$act" "$mr" "$mc"
			return 0
		fi
		# A title-bar button held down: while dragging, just track whether
		# the pointer is still over the one that was pressed, for dt_win's
		# own highlight; the action itself only ever fires from release,
		# and only if it landed back on the same button.
		if [ -n "$DT_BTNID" ]; then
			id=$DT_BTNID
			wr=${DT[$id]["row"]}
			wc=${DT[$id]["col"]}
			ww=${DT[$id]["w"]}
			b := dt_btnat "$id" $((mc - wc))
			if [ "$b" = "$DT_BTNKIND" ] && [ "$mr" = "$wr" ]; then
				DT_BTNOVER=1
			else
				DT_BTNOVER=0
			fi
			if [ "$act" = release ]; then
				if [ "$DT_BTNOVER" = 1 ]; then
					case $DT_BTNKIND in
					close) dt_closereq "$id" ;;
					min) dt_min "$id" ;;
					max) dt_zoom "$id" ;;
					esac
				fi
				DT_BTNID=
				DT_BTNKIND=
				DT_BTNOVER=0
			fi
			return 0
		fi
		# Something being dragged between windows belongs to the desktop
		# until it is dropped, whoever started it.
		if [ -n "$DT_DND" ]; then
			DT_DNDR=$mr
			DT_DNDC=$mc
			if [ "$act" = release ]; then
				DT_MOUSE=
				dt_ondrop "$mr" "$mc" "$mods"
			fi
			return 0
		fi
		# A band being drawn across the empty desktop.
		if [ -n "$DI_BAND" ]; then
			dt_iconband "$act" "$mr" "$mc"
			return 0
		fi
		# A press on an icon that moves becomes a drag of the selection.
		if [ -n "$DI_PRESS" ]; then
			dt_iconmove "$act" "$mr" "$mc"
			return 0
		fi
		# A scrollbar being held, whoever's window it is in.
		if [ -n "$DT_SBDRAG" ]; then
			dt_sbdrag "$act" "$mr" "$mc"
			return 0
		fi
		# A selection being drawn out in a field.
		if [ -n "$DT_FDRAG" ]; then
			dt_fddrag "$act" "$mr" "$mc"
			return 0
		fi
		# A window that took the press with _mouse is told the rest of it,
		# wherever the pointer goes, until the button comes up.
		if [ -n "$DT_MOUSE" ]; then
			id=$DT_MOUSE
			DT_NOTEWIN=$id
			mo=${DT[$id]["mouse"]}
			wr=${DT[$id]["row"]}
			wa=${DT[$id]["col"]}
			dt_capped "$id" && wa=$((wa - 1))
			[ "$act" = release ] && DT_MOUSE=
			[ -n "$mo" ] &&
				$mo "$id" "$act" "$1" $((mr - wr)) $((mc - wa)) \
					"$mods"
			DT_DNDR=$mr
			DT_DNDC=$mc
			return 0
		fi
		;;
	esac

	case $act in
	drag)
		if [ -n "$CS_DRAG" ]; then
			if [ -z "$CS_DRAGKIND" ]; then
				dr=$((mr - CS_PRESSR)); [ "$dr" -lt 0 ] && dr=$((0 - dr))
				dc=$((mc - CS_PRESSC)); [ "$dc" -lt 0 ] && dc=$((0 - dc))
				if [ "$dc" -gt "$dr" ] && [ "$dc" -gt 0 ]; then
					CS_DRAGKIND=resize
				elif [ "$dr" -gt 0 ]; then
					CS_DRAGKIND=move
				fi
			fi
			case $CS_DRAGKIND in
			resize) cs_resize "$mc" ;;
			move)
				CS_Y=$mr
				[ "$CS_Y" -lt 1 ] && CS_Y=1
				[ "$CS_Y" -ge "$DT_ROWS" ] && CS_Y=$((DT_ROWS - 1))
				;;
			esac
			return 0
		fi
		if [ -n "$DT_SIZE" ]; then
			# A tiled window's size is the layout's; say so once.
			if dt_intile "$DT_SIZE"; then
				[ "$DT_SIZENOTE" = "$DT_SIZE" ] ||
					dt_notep low "Tiled: the layout sizes this window"
				DT_SIZENOTE=$DT_SIZE
				return 0
			fi
			# By its outline, the window untouched until let go: a
			# terminal resized at every step reflowed its program at
			# every step too.
			if dt_outlined; then
				p := dt_cornerwhere "$DT_SIZE" "$DT_SIZECORNER" \
					"$DT_SIZE_AR" "$DT_SIZE_AC" "$mr" "$mc"
				read -ra gv <<< "$p"
				dt_olshow "$DT_SIZE" "${gv[0]}" "${gv[1]}" "${gv[2]}" "${gv[3]}"
				return 0
			fi
			dt_cornersize "$DT_SIZE" "$DT_SIZECORNER" "$DT_SIZE_AR" \
				"$DT_SIZE_AC" "$mr" "$mc"
			return 0
		fi
		[ -z "$DT_DRAG" ] && return 0
		if dt_outlined; then
			p := dt_movewhere "$DT_DRAG" $((mr - DT_DR)) $((mc - DT_DC))
			dt_olshow "$DT_DRAG" "${p% *}" "${p#* }" \
				"${DT[$DT_DRAG]["h"]}" "${DT[$DT_DRAG]["w"]}"
			return 0
		fi
		dt_move "$DT_DRAG" $((mr - DT_DR)) $((mc - DT_DC))
		;;
	release)
		# An outline drag ends here: the window goes where its outline is
		# and draws once -- unless it was let go over a workspace's
		# number or is tiled, which the branches below decide from where
		# it was, and it has not moved.
		if [ -n "$DT_OLON" ]; then
			if [ -n "$DT_DRAG" ] && { dt_intile "$DT_DRAG" ||
			   { dt_onbar "$mr" "$mc" && dt_wshit "$mc"; }; }; then
				dt_oloff
			else
				dt_olapply
			fi
		fi
		# Let go over a workspace's number on the bar: the window goes to
		# that workspace, where it was before the drag began.
		if [ -n "$DT_DRAG" ] && dt_onbar "$mr" "$mc" && wsn := dt_wshit "$mc"; then
			dt_move "$DT_DRAG" "$DT_DRAGR0" "$DT_DRAGC0"
			dt_wsmove "$DT_DRAG" "$wsn"
			DT_DRAG=
			return 0
		fi
		# A tiled window let go over another swaps places with it, and
		# anywhere else goes back to its own.
		if [ -n "$DT_DRAG" ] && dt_intile "$DT_DRAG"; then
			if wsn := dt_tileat "$mr" "$mc" "$DT_DRAG"; then
				dt_tileswap "$DT_DRAG" "$wsn"
			else
				dt_tile
			fi
			DT_DRAG=
			return 0
		fi
		DT_SIZENOTE=
		if [ -n "$CS_DRAG" ]; then
			case $CS_DRAGKIND in
			"")
				if [ "$CS_COLLAPSED" = 1 ]; then
					CS_COLLAPSED=0
				else
					CS_COLLAPSED=1
				fi
				;;
			move)
				if [ "$mc" -lt $((DT_COLS / 2)) ]; then
					CS_SIDE=left
				else
					CS_SIDE=right
				fi
				case $DT_MIRRORON in
				1) case $CS_SIDE in left) CS_SIDE=right ;; *) CS_SIDE=left ;; esac ;;
				esac
				;;
			esac
			CS_DRAG=
			CS_DRAGKIND=
			dt_save
			return 0
		fi
		DT_DRAG=
		DT_SIZE=
		DT_SIZECORNER=
		;;
	wheelup | wheeldown | wheelleft | wheelright)
		if dt_pophit "$mr" "$mc"; then
			case $act in
			wheelup | wheeldown) dt_popmouse "${act#wheel}" "$mr" "$mc" ;;
			esac
			return 0
		fi
		# An item an app put on the bar may take the wheel too -- the
		# speaker does, for the volume (Gitea #306).
		if dt_onbar "$mr" "$mc" && bi := dt_barihit "$mc"; then
			if [ -n "${DT_BARI["$bi"]["wheel"]-}" ]; then
				"${DT_BARI["$bi"]["wheel"]}" "${act#wheel}"
				return 0
			fi
		fi
		if cs_hit "$mr" "$mc"; then
			case $act in
			wheelup) cs_scroll -1 ;;
			wheeldown) cs_scroll 1 ;;
			esac
			return 0
		fi
		id := console hit "$mr" "$mc"
		if [ -z "$id" ]; then
			dt_wswheel "$act"
			return 0
		fi
		id=${id#w}
		ap=${DT[$id]["wheel"]}
		[ -z "$ap" ] && return 0
		DT_NOTEWIN=$id
		wr=${DT[$id]["row"]}
		wa=${DT[$id]["col"]}
		dt_capped "$id" && wa=$((wa - 1))
		$ap "$id" "${act#wheel}" $((mr - wr)) $((mc - wa))
		;;
	esac
}

# What the pointer was last over, as dt_hover names it, and the window whose
# _hover was last told it was over it.
DT_HOVERT=
DT_HOVERWIN=
DT_HOVERQUIET=

# The window and the region -- what dt_wreg registered and dt_hit answers
# for a click there -- the pointer is over, for a widget or a list row that
# lights while it is (Gitea #370). Empty with nothing registered under the
# pointer, with hovering off, and for a window whose app has a _hover of its
# own, which is told the cell instead. It is last frame's regions that are
# asked, exactly as a click asks them.
DT_HOTWIN=
DT_HOTTAG=
# The Control Strip module the pointer is over, by its place in the strip,
# whose brackets light while it is; empty when it is over none.
DT_HOTSTRIP=
# The tooltip for what the pointer is over, when it started resting there,
# and where, so a frame DT_TIPMS later can draw it (Gitea #370).
DT_TIPTXT=
DT_TIPAT=0
DT_TIPR=0
DT_TIPC=0
# What is lit because the pointer is over it: a window's title-bar button
# ("id kind"), a menu title's index, a bar item's name -- each drawn in a
# lighter or a well colour by frame.hibr and bar.hibr.
DT_HOVERBTN=
DT_HOVERMT=
DT_HOVERBI=

# The pointer shape in force (Gitea #373): empty for the terminal's own, or
# what the window under the pointer asked for with dt_pointer.
DT_PTRNOW=

# Ask for a pointer shape over a window's content: `none` hides the
# terminal's pointer there -- a game drawing a cursor of its own -- and empty
# gives it back. The terminal is asked only where hovering is on, since
# without movement reports nothing would say the pointer had left; and a
# display that cannot hide is given its own pointer by hold, so asking is
# harmless anywhere. dt_ptrcan says whether any display can.
fn dt_pointer(int id, shape = "") {
	DT[$id]["ptr"]=$shape
	return 0
}

# Whether a display of this desktop can hide its pointer: one of the held
# session's said so at attach, or, unheld, the terminal the console asked.
fn dt_ptrcan() {
	local p

	if [ -n "$HIBR_HOLD" ]; then
		[ "$DT_PTRNAT" = 1 ]
		return
	fi
	p := console pointer can 2> /dev/null || return 1
	[ "$p" = yes ]
}

# What the thing the pointer has just moved onto would say as a tooltip
# (Gitea #370), kept with where and when the pointer got there, and a frame
# asked for once it has rested DT_TIPMS. Only what shows a glyph with no
# word beside it speaks for itself -- a title bar's buttons, the Control
# Strip's modules, the bar's items -- and a region an app gave a tip to with
# dt_tip; a menu row or a labelled button already says what it does.
fn dt_tipfor(t, int r, int c) {
	local x= id b m

	DT_TIPTXT=
	[ "$DT_TIPS" = 1 ] || return 0
	case $t in
	btn:*)
		case ${t##*:} in
		close) x=Close ;;
		min) x=Hide ;;
		max) x=Zoom ;;
		esac
		;;
	cs:*)
		m=${CS_MOD_LIST[${t#cs:}]-}
		[ -n "$m" ] && x=${CS_MODS[$m]["title"]-}
		;;
	bar:*)
		[ -n "$DT_HOVERBI" ] && x=${DT_BARI["$DT_HOVERBI"]["label"]-}
		;;
	hot:*)
		id=${t#hot:}
		b=${id#*:}
		id=${id%%:*}
		x=${WT[$id]["$b"]-}
		;;
	esac
	[ -n "$x" ] || return 0
	DT_TIPTXT := dt_tr "$x"
	DT_TIPAT=$((${EPOCHREALTIME/./} / 1000))
	DT_TIPR=$r
	DT_TIPC=$c
	dt_want "$DT_TIPMS"
}

# Draw the tooltip, once the pointer has rested long enough: on the row
# below the pointer, or above it at the screen's foot, kept on the screen.
# Drawn over the finished frame, so the frame after it is gone repaints
# what it covered by itself.
dt_tip_draw() {
	local left r c t
	local -i w

	[ -n "$DT_TIPTXT" ] && [ "$DT_TIPS" = 1 ] || return 0
	left=$((DT_TIPAT + DT_TIPMS - ${EPOCHREALTIME/./} / 1000))
	if [ "$left" -gt 0 ]; then
		dt_want "$left"
		return 0
	fi
	t=" $DT_TIPTXT "
	w := str width "$t"
	r=$((DT_TIPR + 1))
	[ "$r" -ge "$DT_ROWS" ] && r=$((DT_TIPR - 1))
	c=$DT_TIPC
	[ $((c + w)) -gt "$DT_COLS" ] && c=$((DT_COLS - w))
	[ "$c" -lt 0 ] && c=0
	console pen "$DT_INK" "$DT_WELL"
	console put "$r" "$c" "$t"
	return 0
}

# Which grip of window id is at r,c on the screen, if any: a corner --
# tl tr bl br -- or, with Edge Resize on, a side -- l r b. There is no top
# side: row 0 is the title bar over its whole width, so the top corners are
# the only way to resize from above. Under the bar frame the bottom
# corners and the sides are the app's own cells, its scrollbar among them,
# so only the title bar's two ends are grips there. A fixed-size window
# has none.
fn dt_grip(int id, int r, int c) {
	local wr=${DT[$id]["row"]} wc=${DT[$id]["col"]} ww=${DT[$id]["w"]} wh=${DT[$id]["h"]} wa

	[ "${DT_APPS[${DT[$id]["app"]}]["fixed"]}" != 1 ] || return 1
	wa=$wc
	dt_capped "$id" && wa=$((wc - 1))
	if [ "$wa" = "$wc" ] && [ "$r" = $((wr + wh - 1)) ] && [ "$c" = $((wc + ww - 1)) ]; then
		ret br
	fi
	[ "$r" = "$wr" ] && [ "$c" = "$wc" ] && ret tl
	[ "$r" = "$wr" ] && [ "$c" = $((wc + ww - 1)) ] && ret tr
	if [ "$wa" = "$wc" ] && [ "$r" = $((wr + wh - 1)) ] && [ "$c" = "$wc" ]; then
		ret bl
	fi
	[ "$DT_EDGERESIZE" = 1 ] && [ "$wa" = "$wc" ] || return 1
	if [ "$r" -gt "$wr" ] && [ "$r" -lt $((wr + wh - 1)) ]; then
		[ "$c" = "$wc" ] && ret l
		[ "$c" = $((wc + ww - 1)) ] && ret r
	fi
	if [ "$r" = $((wr + wh - 1)) ] && [ "$c" -gt "$wc" ] && [ "$c" -lt $((wc + ww - 1)) ]; then
		ret b
	fi
	return 1
}

# Put a shape in force, once.
fn dt_ptrput(shape = "") {
	[ "$shape" = "$DT_PTRNOW" ] && return 0
	DT_PTRNOW=$shape
	console pointer "${shape:-show}" 2> /dev/null || :
	return 0
}

# The shape the pointer at r,c wants, while no menu is open and hovering is
# on. Over any window's frame it says what a press there does (Gitea #370):
# a resize arrow on a grip, the one dt_grip finds, a hand on a title bar's
# button, and a move on the rest of the title bar. Over a window's content
# it is the window's own while it has focus. Anything else, the terminal's
# own -- so a menu opening, focus moving or the pointer leaving gives it
# back. A terminal that draws no pointer shapes ignores all of it.
fn dt_ptrfor(r = "", c = "") {
	local id= rr cc g

	if [ -n "$r" ] && [ "$MB_OPEN" = -1 ] && dt_hoveron; then
		id := console hit "$r" "$c"
		id=${id#w}
	fi
	case $id in
	"" | *[!0-9]*) ret "" ;;
	esac
	if g := dt_grip "$id" "$r" "$c"; then
		case $g in
		tl | br) ret nwse-resize ;;
		tr | bl) ret nesw-resize ;;
		l | r) ret ew-resize ;;
		b) ret ns-resize ;;
		esac
	fi
	if [ "$r" = "${DT[$id]["row"]}" ] && [ "${DT[$id]["chrome"]}" != none ]; then
		if g := dt_btnat "$id" $((c - ${DT[$id]["col"]})) && [ -n "$g" ]; then
			ret pointer
		fi
		ret move
	fi
	if [ "$id" != "$DT_FOCUS" ] || [ -z "${DT[$id]["ptr"]-}" ]; then
		ret ""
	fi
	rr=$((r - DT[$id]["row"]))
	cc=$((c - DT[$id]["col"]))
	if [ "$rr" -lt 1 ] || [ "$rr" -gt $((DT[$id]["h"] - 2)) ] ||
	   [ "$cc" -lt 1 ] || [ "$cc" -gt $((DT[$id]["w"] - 2)) ]; then
		ret ""
	fi
	ret "${DT[$id]["ptr"]}"
}

# Where the pointer last was, so a frame can ask again whether its shape
# still holds when nothing has moved -- focus taken by a key, a menu opened.
DT_PTRR=
DT_PTRC=

# The pointer moved with no button held (Gitea #370). An open menu follows
# it, and moving onto another title on the bar opens that menu instead, as
# every menu bar does; a window whose app has a _hover is told where it is,
# in the coordinates it draws in, and told -1 -1 when it leaves. Anything
# else is only remembered. A hover that leaves what is under the pointer
# unchanged draws no frame (DT_HOVERQUIET), which is what keeps a moving
# pointer from costing a frame per report.
fn dt_hover(int r, int c) {
	local t= id= ap b wr wc wa was=$DT_HOVERT

	DT_HOVERBTN=
	DT_HOVERMT=
	DT_HOVERBI=
	DT_HOTWIN=
	DT_HOTTAG=
	DT_HOTSTRIP=
	if [ "$MB_OPEN" != -1 ]; then
		if dt_onbar "$r" "$c"; then
			if [ -z "$MB_CX" ] && b := dt_mhit "$c" &&
			   [ "$b" != "$MB_OPEN" ]; then
				dt_mopen "$b"
			fi
		else
			dt_mpick "$r" "$c" || :
		fi
		t="m:$MB_OPEN:$MB_SEL"
	elif dt_onbar "$r" "$c"; then
		if b := dt_mhit "$c"; then
			DT_HOVERMT=$b
		elif b := dt_barihit "$c"; then
			DT_HOVERBI=$b
		fi
		t="bar:$DT_HOVERMT:$DT_HOVERBI"
	elif [ "$CS_COLLAPSED" != 1 ] && dt_has cs_hit && cs_hit "$r" "$c" &&
	     b := cs_at "$c"; then
		# The strip is drawn over the windows, so it is asked first.
		DT_HOTSTRIP=$b
		t="cs:$b"
	else
		id := console hit "$r" "$c"
		# A window's pane is w and its id; the bar's own pane is not one.
		case $id in
		w[0-9]*) id=${id#w} ;;
		*) id= ;;
		esac
		t="w:$id"
		# Focus Follows Mouse: the window under the pointer takes the
		# keyboard and is not raised; the desktop under it changes
		# nothing, so the last window keeps the focus (Gitea #370).
		if [ "$DT_FOCUSHOVER" = 1 ] && [ -n "$id" ] && [ "$id" != "$DT_FOCUS" ]; then
			DT_FOCUS=$id
			DT_MENUIN=
			DT_FORCEONCE=1
		fi
		if [ -n "$id" ] && [ "$r" = "${DT[$id]["row"]}" ] &&
		   b := dt_btnat "$id" $((c - ${DT[$id]["col"]})); then
			[ -n "$b" ] && DT_HOVERBTN="$id $b" && t="btn:$id:$b"
		fi
		if [ "${t#btn:}" = "$t" ] && [ -n "$id" ]; then
			wr=${DT[$id]["row"]}
			wa=${DT[$id]["col"]}
			dt_capped "$id" && wa=$((wa - 1))
			if [ -n "${DT[$id]["hover"]+x}" ] && [ -n "${DT[$id]["hover"]}" ]; then
				t="w:$id:$r:$c"
			elif b := dt_hit "$id" $((r - wr)) $((c - wa)) ||
			     b := dt_hothit "$id" $((r - wr)) $((c - wa)); then
				DT_HOTWIN=$id
				DT_HOTTAG=$b
				t="hot:$id:$b"
			fi
		fi
	fi
	if [ -n "$DT_HOVERWIN" ] && [ "$DT_HOVERWIN" != "$id" ]; then
		ap=${DT[$DT_HOVERWIN]["hover"]}
		[ -n "$ap" ] && $ap "$DT_HOVERWIN" -1 -1
		DT_HOVERWIN=
	fi
	if [ "${t#w:*:}" != "$t" ]; then
		DT_HOVERWIN=$id
		${DT[$id]["hover"]} "$id" $((r - wr)) $((c - wa))
	fi
	[ "$t" != "$was" ] && dt_tipfor "$t" "$r" "$c"
	DT_PTRR=$r
	DT_PTRC=$c
	b := dt_ptrfor "$r" "$c"
	dt_ptrput "$b"
	[ "$t" = "$was" ] && DT_HOVERQUIET=1
	DT_HOVERT=$t
	# A highlight that came or went is chrome a window left alone would not
	# redraw, and a bar kept from the last frame would not either.
	if [ "$t" != "$was" ]; then
		case "$was $t" in
		*btn:*) DT_FORCEONCE=1 ;;
		esac
		case "$was $t" in
		*bar:*) DT_BARWAS= ;;
		esac
	fi
	return 0
}

# Where the pointer was in pixels of the screen at the last mouse report,
# counted from zero, or empty when the terminal reports cells only (Gitea
# #370). An app that draws pixels reads it beside the cell it is told; no
# callback is handed it, since every one declares what it takes.
DT_PX=
DT_PY=

# Where in cell r c of a window the pointer was at the last mouse report,
# as `x y` in a cell of cw by ch -- the caller's own measure, so an app that
# counts 8 by 16 cells while the terminal's are 10 by 20 still gets a place
# inside its cell. The middle of the cell when the terminal reports cells
# only, or the pixel is not in that cell. For an app that turns a click into
# a point on what it draws: a page, an X screen (Gitea #370).
fn dt_cellpx(int id, int r, int c, int cw, int ch) {
	local x=$((cw / 2)) y=$((ch / 2)) g gk tw th ox oy wa

	if [ -n "$DT_PX" ] && [ -n "${DT[$id]["col"]}" ] && g := console gfx 2> /dev/null; then
		read -r gk tw th <<< "$g"
		# A window with no frame counts its columns from one left of
		# itself, as a click on it does.
		wa=${DT[$id]["col"]}
		dt_capped "$id" && wa=$((wa - 1))
		if [ "${tw:-0}" -gt 1 ] && [ "${th:-0}" -gt 1 ]; then
			ox=$((DT_PX - (wa + c) * tw))
			oy=$((DT_PY - (${DT[$id]["row"]} + r) * th))
			[ "$ox" -ge 0 ] && [ "$ox" -lt "$tw" ] && x=$((ox * cw / tw))
			[ "$oy" -ge 0 ] && [ "$oy" -lt "$th" ] && y=$((oy * ch / th))
		fi
	fi
	ret "$x $y"
}

# Handle one decoded key or mouse line.
#
# The wheel goes to the window under the pointer rather than to the focused
# one, which is what every other desktop does and what anyone expects when
# they scroll a list they have not clicked on yet.
#
# A mouse line carries the pixel last, `x,y` or `-`, since the desktop asks
# for pixels; it is taken off here, so everything after reads the four or
# five fields it always has.
fn dt_event(k) {
	local an knorm qn cn cln qan dn sn ev px

	case $k in
	"mouse "*" -")
		DT_PX=
		DT_PY=
		k=${k% -}
		;;
	"mouse "*,*)
		px=${k##* }
		DT_PX=${px%,*}
		DT_PY=${px#*,}
		k=${k% *}
		;;
	esac
	# The pointer moving with no button held is a hover, never a drag:
	# nothing a press started is in progress, and it is not input in the
	# sense a key is, so it reaches no shortcut, capture or dialog.
	case $k in
	"mouse "*"drag none "*)
		read -ra ev <<< "$k"
		DT_LASTDRAG=0
		DT_LASTMOVE=1
		dt_hover "${ev[3]}" "${ev[4]}"
		return 0
		;;
	esac
	# Anything else done puts a tooltip away until the pointer moves on.
	DT_TIPTXT=
	DT_NOTEWIN=
	case $k in
	"mouse drag "*) DT_LASTDRAG=1; DT_LASTMOVE=1 ;;
	"mouse wheel"*) DT_LASTDRAG=0; DT_LASTMOVE=1 ;;
	*) DT_LASTDRAG=0; DT_LASTMOVE=0 ;;
	esac
	if [ -n "$DT_KEYCAP" ]; then
		case $k in
		# A mouse event does not cancel: a shortcut row already selected
		# from an earlier attempt arms capture on the very first click
		# of the next one (panel_click's own "a second click on an
		# already-selected row activates it"), so the click that
		# arrives right after -- the other half of an ordinary
		# double-click, or just a habitual re-click -- would otherwise
		# be read as this event and cancel the capture it had itself
		# just armed, before the intended key was ever pressed. Only
		# escape cancels; a stray click while capturing is absorbed.
		"mouse "*) ;;
		escape) DT_KEYCAP=; dt_notep low "Cancelled" ;;
		*)
			an=$DT_KEYCAP
			DT_KEYCAP=
			# A key that moves around the panel ends the capture
			# unchanged and then moves, as it would have: the arrow
			# pressed to go on to the next row goes on to it.
			if dt_keynav "$k"; then
				dt_notep low "Not changed"
			else
				dt_keytake "$an" "$k"
				return 0
			fi
			;;
		esac
		[ "$k" = escape ] || [ "${k#mouse }" != "$k" ] && return 0
	fi
	if [ -n "$DT_SHOT" ]; then
		dt_shot_event "$k"
		return 0
	fi
	if [ -n "$DT_CONFIRM" ]; then
		case $k in
		"mouse press "*)
			read -ra ev <<< "$k"
			local yn
			yn := dt_confirm_hit "${ev[3]}" "${ev[4]}"
			if [ -n "$yn" ]; then
				dt_confirm_key "$yn"
			else
				DT_CONFIRM=
			fi
			;;
		"mouse "*) ;;
		*) dt_confirm_key "$k" ;;
		esac
		return 0
	fi
	# A mode that takes the keyboard over -- moving or resizing a window
	# from the keyboard, the Control Strip's arrows -- ends on a click, and
	# on any key it has no use for, which then goes where it would have:
	# a mode nobody can see must not swallow what is typed.
	case $k in
	"mouse press "*)
		if [ -n "$DT_GRAB" ]; then
			DT_GRAB=
			dt_note_clear
		fi
		CS_ATTN=0
		# A press with an outline still up means its release never
		# came -- a terminal that dropped it -- so the drag ends there,
		# where the outline was, rather than leaving it on the screen.
		[ -n "$DT_OLON" ] && { dt_olapply; DT_DRAG=; DT_SIZE=; DT_SIZECORNER=; }
		;;
	escape)
		# Escape during an outline drag puts it down where it started.
		if [ -n "$DT_OLON" ]; then
			dt_oloff
			DT_DRAG=
			DT_SIZE=
			DT_SIZECORNER=
			return 0
		fi
		;;
	esac
	case $k in
	"mouse "*)
		read -ra ev <<< "$k"
		dt_mouse "${ev[@]:1}"
		return 0
		;;
	esac
	if [ -n "$DT_GRAB" ]; then
		dt_gkey "$k" && return 0
		DT_GRAB=
		dt_note_clear
	fi
	if [ -n "$DT_DND" ]; then
		DT_DND=
		DT_MOUSE=
		[ "$k" = escape ] && return 0
	fi
	# The window switcher (Gitea #391) takes Cycle, Cycle Back and
	# escape; any other key chooses where it stands, and then goes where
	# it would have.
	if [ -n "$DT_SW" ]; then
		if dt_keyis cycle "$k"; then
			dt_swstep 1
			return 0
		fi
		if dt_keyis cycleback "$k"; then
			dt_swstep -1
			return 0
		fi
		if [ "$k" = escape ]; then
			dt_swend
			return 0
		fi
		dt_swcommit
	fi
	if [ "$MB_OPEN" != -1 ]; then
		dt_mkey "$k" && return 0
		return 0
	fi
	# A bar item's panel takes the keys it has a use for; escape closes
	# it, and any other key closes it and then goes where it would have.
	if [ -n "$DT_POP" ]; then
		if [ "$k" = escape ]; then
			dt_popclose
			return 0
		fi
		if dt_has "${DT_POP}_popkey" && "${DT_POP}_popkey" "$k"; then
			dt_want 10
			return 0
		fi
		dt_popclose
	fi
	# The strip takes left/right ahead of the focused window once CS_ATTN
	# has been given to it explicitly by its own shortcut -- there is no
	# mouse involved here at all; the wheel scrolls it separately, from
	# wherever the pointer actually is when it turns.
	if [ "$CS_ATTN" = 1 ]; then
		case $k in
		left) cs_scroll -1; return 0 ;;
		right) cs_scroll 1; return 0 ;;
		escape) CS_ATTN=0; dt_notep low "Control Strip: released"; return 0 ;;
		*) CS_ATTN=0 ;;
		esac
	fi
	# Copy, Cut and Paste belong to the desktop, the same keys in every
	# window, whatever they are set to; and so does a paste arriving from
	# the terminal the desktop runs on: it goes to the app's _paste when it
	# has one, and becomes the desktop's clipboard too, so Paste pastes it
	# again in any window and on any display joined to this one.
	# Save goes only to a window that saves -- anywhere else the key is the
	# window's, so a terminal still gets ctrl-s.
	if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["savefile"]}" ] &&
	   dt_keyis save "$k"; then
		DT_NOTEWIN=$DT_FOCUS
		${DT[$DT_FOCUS]["savefile"]} "$DT_FOCUS"
		return 0
	fi
	if dt_keyis undo "$k"; then dt_editdo undo; return 0; fi
	if dt_keyis redo "$k"; then dt_editdo redo; return 0; fi
	if dt_keyis copy "$k"; then dt_edit copy; return 0; fi
	if dt_keyis cut "$k"; then dt_edit cut; return 0; fi
	if dt_keyis paste "$k"; then dt_edit paste; return 0; fi
	case $k in
	"paste "*)
		# The host terminal's own paste is the Paste key's, through the
		# one path: a focused field first, then the window's _paste with
		# the text and "copy" (Gitea #250, #295, #357).
		dt_clipset "${k#paste }" copy text 0
		[ -n "$DT_FOCUS" ] && DT_NOTEWIN=$DT_FOCUS
		dt_edit paste
		return 0
		;;
	esac
	# The Menu Bar key (f10 unless changed) is looked at before any window
	# sees the key, because it has to be the way back to the menu bar from
	# a window that wants everything else. Its second key (escape) comes
	# after, so a terminal running vi still gets escape.
	if dt_keyis menu "$k"; then
		CS_ATTN=0
		dt_mopen 0
		return 0
	fi
	if [ -n "$DT_FOCUS" ] && [ -n "${DT[$DT_FOCUS]["key"]}" ]; then
		DT_NOTEWIN=$DT_FOCUS
		if ${DT[$DT_FOCUS]["key"]} "$DT_FOCUS" "$k"; then
			return 0
		fi
		DT_NOTEWIN=
	fi
	if [ -z "$DT_FOCUS" ] && [ "$DT_ICONS" = 1 ] && dt_iconkey "$k"; then
		return 0
	fi
	if dt_keyis menu2 "$k"; then
		CS_ATTN=0
		dt_mopen 0
		return 0
	fi
	# Compared by dt_keynorm, not as the literal string: a rebound
	# DT_KEYS entry combining ctrl and alt would have exactly the same
	# either-order ambiguity dt_appkeyed's own shortcuts do.
	knorm := dt_keynorm "$k"
	qn := dt_keynorm "${DT_KEYS[quit]}"
	cn := dt_keynorm "${DT_KEYS[cycle]}"
	cln := dt_keynorm "${DT_KEYS[close]}"
	qan := dt_keynorm "${DT_KEYS[quitapp]}"
	dn := dt_keynorm "${DT_KEYS[detach]}"
	sn := dt_keynorm "${DT_KEYS[strip]}"
	if [ "$knorm" = "$qn" ]; then
		dt_quitconfirm
	elif [ "$knorm" = "$cn" ]; then
		dt_swstart 1
	elif dt_keyis cycleback "$k"; then
		dt_swstart -1
	elif [ "$knorm" = "$cln" ]; then
		dt_close_focused
	elif [ -n "$qan" ] && [ "$knorm" = "$qan" ]; then
		dt_quitapp
	elif [ "$knorm" = "$dn" ]; then
		dt_detach
	elif dt_wskey "$k"; then
		:
	elif dt_keyis shot "$k"; then
		dt_shot
	elif dt_keyis refresh "$k"; then
		dt_refresh
	elif dt_keyis lock "$k"; then
		dt_lock
	elif dt_keyis tile "$k"; then
		dt_tiletoggle
	elif dt_keyis tilemain "$k"; then
		dt_tilemain
	elif dt_keyis zoom "$k"; then
		[ -n "$DT_FOCUS" ] &&
			[ "${DT_APPS[${DT[$DT_FOCUS]["app"]}]["fixed"]}" != 1 ] &&
			dt_zoom_focused
	elif dt_keyis hide "$k"; then
		dt_hide_focused
	elif dt_keyis snapleft "$k"; then
		dt_snap_focused left
	elif dt_keyis snapright "$k"; then
		dt_snap_focused right
	elif dt_keyis snaptop "$k"; then
		dt_snap_focused top
	elif dt_keyis snapbottom "$k"; then
		dt_snap_focused bottom
	elif dt_keyis snapcenter "$k"; then
		dt_snap_focused center
	# The sound keys reach the Sound entry only where it is installed
	# (Gitea #388): without it there is no volume to change.
	elif dt_keyis volup "$k"; then
		dt_has dt_sndstep && dt_sndstep 1
	elif dt_keyis voldown "$k"; then
		dt_has dt_sndstep && dt_sndstep -1
	elif dt_keyis mute "$k"; then
		dt_has dt_sndmutekey && dt_sndmutekey
	elif [ "$knorm" = "$sn" ]; then
		if [ "$CS_ATTN" = 1 ]; then
			CS_ATTN=0
			dt_notep low "Control Strip: released"
		else
			CS_ATTN=1
			dt_notep low "Control Strip: arrows scroll it, until escape"
		fi
	else
		dt_appkeyed "$k"
	fi
}

# Whether this press in a window is the second of a double click: another
# press in the same window within DT_DBLMS. An app's _click asks it for
# itself; the window manager asks it for a window with no chrome.
DT_DBLWIN=
DT_DBLWT=0
fn dt_isdbl(int id) {
	local now

	now := dt_ms
	if [ "$DT_DBLWIN" = "$id" ] && [ $((now - DT_DBLWT)) -lt "$DT_DBLMS" ]; then
		DT_DBLWIN=
		return 0
	fi
	DT_DBLWIN=$id
	DT_DBLWT=$now
	return 1
}

# Milliseconds, for telling a double click from two.
dt_ms() {
	local t=${EPOCHREALTIME/./}

	ret $((t / 1000))
}
