# wm/confirm -- the confirm dialog: a question with a yes and a no.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Ask before doing something that cannot be taken back by pressing the key
# again: Yes runs cmd, No forgets it, and so does a click anywhere else,
# which cancels rather than reaching whatever it landed on. cmd is a single
# word, a function of no arguments, since the message can hold a space and
# a command built from stored, later-unquoted menu text cannot.
#
# It opens over the window that asked -- the one with focus when it is
# asked -- on that window's display, as every other dialog does (dt_dlgat).
# The desktop's own questions (Quit, Restart, Shut Down, Empty Trash from
# the menu) say whose they are with "desktop" and open on the primary,
# whatever window happens to have focus (Gitea #390).
DT_CONFIRM_OWNER=
fn dt_confirm(msg, cmd, owner = "") {
	case $DT_LANG in ?*) msg := dt_tr "$msg" ;; esac
	dt_note_clear
	DT_CONFIRM="$msg"
	DT_CONFIRM_CMD=$cmd
	DT_CONFIRM_FOCUS=y
	DT_CONFIRM_OWNER=$DT_FOCUS
	[ "$owner" = desktop ] && DT_CONFIRM_OWNER=
	return 0
}

# A small window of its own, not just a coloured box: the windows' own
# chrome (dt_chrome), at an absolute position rather than a pane's, since
# this has no pane and takes no drag or resize. The question is wrapped to
# at most DT_CONFIRMW columns, or the display's width less a margin, and
# the box grows a row for each line, so a long one is read rather than cut
# off at the screen's edge. Its buttons are drawn onto the screen
# (widgets/button.hibr's "root") and found again by dt_hit under the same
# name, so the box a click is tested against is the one that was drawn.
# The lines are left in DT_FITLINES for dt_confirm_draw.
DT_CONFIRMW=60
dt_confirm_geom() {
	local msg=$DT_CONFIRM w h y0 x0 bw tw=$DT_CONFIRMW
	local o=$DT_CONFIRM_OWNER

	bw := dt_btnw Yes No
	# The display it opens on decides how wide it may be.
	if [ -n "$o" ] && [ -n "${DT[$o]["row"]+x}" ]; then
		dt_windisp "$o"
	else
		dt_dispat "${DT_PRIMARY_ROW:-0}" "${DT_PRIMARY_COL:-0}"
	fi
	[ "$tw" -gt $((DTW_W - 8)) ] && tw=$((DTW_W - 8))
	dt_textfit "$msg" "$bw" "$tw" 1 $((DTW_H - 8))
	w=$((DT_FITW + 6))
	h=$((DT_FITH + 6))
	# Over the window that asked, on its display; the desktop's own on
	# the primary, centred there in both directions -- DT_ROWS is the
	# whole union, so half of it is the middle of somebody else's
	# display when the primary is a stacked pane (Gitea #240, #390).
	if [ -n "$o" ]; then
		dt_dlgfor "$o" "$h" "$w" 0
		ret "$DT_DLGR $DT_DLGC $DT_DLGW $DT_DLGH"
		return 0
	fi
	y0=$((DT_PRIMARY_ROW + (${DT_PRIMARY_H:-$DT_ROWS} - h) / 2))
	x0=$((DT_PRIMARY_COL + (${DT_PRIMARY_W:-$DT_COLS} - w) / 2))
	ret "$y0 $x0 $w $h"
}

# y, n, or nothing for a point on neither button.
fn dt_confirm_hit(int mr, int mc) {
	[ -z "$DT_CONFIRM" ] && return 1
	dt_hit root "$mr" "$mc" && ret -k
}

dt_confirm_draw() {
	local msg=$DT_CONFIRM w h y0 x0 g bw t l i=0 lw cap=0

	[ -z "$msg" ] && return 0
	g := dt_confirm_geom
	read -r y0 x0 w h <<< "$g"
	# The windows' own chrome, as a focused window's (#102): their shadow,
	# their see-through face, their frame or none and their title bar --
	# the one drawer every window goes through, whatever they are set to.
	[ "$DT_SHADOW" = 1 ] && ! dt_frameshadows && dt_castshadow "$y0" "$x0" "$h" "$w"
	dt_chromeface "$y0" "$x0" "$h" "$w"
	[ "$DT_FRAME" = none ] && cap=1
	t := dt_tr "Confirm"
	dt_chrome "" "$y0" "$x0" "$h" "$w" "$t" "${DT_TITLE:-$DT_ACTIVE}" "$cap"
	dt_chromein on
	console pen "$DT_INK" "$DT_FACE" bold
	for l in "${DT_FITLINES[@]}"; do
		lw := str width "$l"
		console put $((y0 + 2 + i)) $((x0 + (w - lw) / 2)) "$l"
		i=$((i + 1))
	done
	dt_chromein off
	dt_wclear root
	bw := dt_btnw Yes No
	dt_buttons root $((y0 + h - 3)) $((x0 + (w - bw) / 2)) \
		"$DT_CONFIRM_FOCUS" y Yes n No
}

# y and n answer at once, as they always have; enter answers with the
# button that has focus, and tab or the arrows move it. Any other key
# cancels, the same as No.
fn dt_confirm_key(key) {
	local cmd=$DT_CONFIRM_CMD d

	if d := dt_focuskey "$key" 1; then
		DT_CONFIRM_FOCUS := dt_focus "$DT_CONFIRM_FOCUS" "$d" y n
		return 0
	fi
	[ "$key" = enter ] && key=$DT_CONFIRM_FOCUS
	DT_CONFIRM=
	DT_CONFIRM_CMD=
	case $key in
	y | Y)
		# cmd may end the loop (dt_quit) with no redraw of its own after
		# it, same as every other quit path -- draw once here, box
		# already cleared above, so that is what a pty test's last
		# frame shows rather than the box still up.
		dt_draw
		$cmd
		;;
	esac
	return 0
}

# The bare key asks first: q used to end the desktop on the spot, and one
# key too many landed on it more than once. Quit on the hibr menu does not
# go through this -- reaching it is already two keys (f10, then q), so
# asking a third time is the annoyance this exists to remove, not add back.
dt_quitconfirm() {
	dt_confirm "Quit hibr?" dt_quit desktop
}
