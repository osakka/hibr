#!/usr/bin/env hibr
#
# saver -- the screen saver: after DT_SAVERIDLE minutes with no key and
# no click, the screen is given to a saver (programs/desktop/savers/) --
# DT_SAVER by name, or one at random -- until the next key or click, which
# ends it and goes nowhere else. Waiting costs nothing: the loop is told
# to wake when the idle time is up, the same as any other dt_want.

strict

DT_SAVER="${DT_SAVER-random}"
DT_SAVERIDLE="${DT_SAVERIDLE-10}"
command -v dt_keep > /dev/null && dt_keep DT_SAVER DT_SAVERIDLE

# The idle time in seconds instead, for a script or a test that cannot
# wait whole minutes; when set it wins.
DT_SAVERSECS="${DT_SAVERSECS-}"
DT_SAVING=
DT_SAVERREADY=
DT_IDLEFROM=$EPOCHSECONDS
# The saver running, which savers/saver.hibr also sets -- declared here as
# well because the branch below that finds no saver to run clears it, and
# when the framework itself could not be read nothing else had declared it:
# a strict desktop refused the assignment, every time the idle time came
# round (`saver.hibr:41: SV_NAME is not declared`).
SV_NAME="${SV_NAME-}"

# The savers, loaded the first time one is wanted rather than with the
# desktop, so a desktop that never idles that long pays nothing for them.
# The framework is part of the desktop, but a desktop is still expected to
# start without it -- and then simply has no saver, rather than calling
# sv_load and sv_begin, which do not exist, on every idle (Gitea #262).
dt_saverload() {
	[ -n "$DT_SAVERREADY" ] && return 0
	[ -r "$DT_HERE/savers/saver.hibr" ] || return 1
	. "$DT_HERE/savers/saver.hibr"
	dt_has sv_load || return 1
	sv_load
	DT_SAVERREADY=1
}

# Give the screen to a saver now -- "preview" for a look that never locks.
fn dt_saverstart(how = "") {
	local have=0

	dt_saverload && have=1
	dt_mclose
	DT_SAVERFROM=$EPOCHSECONDS
	DT_SAVERPREVIEW=
	[ "$how" = preview ] && DT_SAVERPREVIEW=1
	if [ "$have" = 1 ] && sv_begin "$DT_SAVER"; then
		DT_SAVING=1
	else
		SV_NAME=
		console pen white black
		console clear
		# No saver to run, and every cell on the screen has just gone:
		# DT_SAVING stays empty, so the next frame is an ordinary one,
		# which would put back only whatever happened to be dirty.
		DT_FORCEONCE=1
		# And the idle clock starts again here, or dt_saverwait finds
		# the time up on the very next frame and clears the screen
		# again -- every frame, for as long as the desktop runs. Only
		# this path needs it: a saver that did start leaves through
		# dt_saverstop, which resets it (Gitea #118).
		DT_IDLEFROM=$EPOCHSECONDS
	fi
	return 0
}

# Draw the saver's next frame, and the lock's box over it while it asks;
# the time until the one after is the result.
dt_saverdraw() {
	local ms=1000

	dt_lockdue && dt_lock
	if [ -n "$DT_LOCKASK" ] && [ $((EPOCHSECONDS - DT_LOCKSEEN)) -ge 30 ]; then
		dt_lockhide
	fi
	if [ -n "$SV_NAME" ] && [ -n "$DT_SAVING" ]; then
		ms := sv_frame
	fi
	if [ -n "$DT_LOCKASK" ]; then
		dt_lockbox
		[ "$ms" -gt 500 ] && ms=500
	fi
	console flush
	ret "$ms"
}

# Wait for a key until the next frame is due. A terminal's program goes on
# writing behind the saver, and its pty, watched, ends every wait at once:
# so each window's idle callback reads it, as dt_idle does for a hidden
# window, and the wait goes on for what is left.
fn dt_saverkey(int ms) {
	local now due k id

	now := dt_ms
	due=$((now + ms))
	while :; do
		k := console key $((due - now))
		[ -n "$k" ] && break
		for id in "${!DT[@]}"; do
			[ -n "${DT[$id]["idle"]}" ] && ${DT[$id]["idle"]} "$id"
		done
		now := dt_ms
		[ "$now" -lt "$due" ] || break
	done
	ret "$k"
}

# A key or a click while the saver runs: it ends the saver, or, locked,
# goes to the lock.
fn dt_saverinput(k) {
	[ -n "$k" ] && [ "$k" != resize ] || return 0
	if [ -n "$DT_LOCKED" ]; then
		dt_lockkey "$k"
	else
		dt_saverstop
	fi
	return 0
}

# Take the screen back: the desktop is drawn whole again on the next frame,
# and the idle time starts from now.
dt_saverstop() {
	DT_SAVING=
	DT_SAVERPREVIEW=
	console cursor off
	DT_IDLEFROM=$EPOCHSECONDS
	console pen "$DT_INK" "$DT_WALL"
	console clear
	# Every cell on the screen has just gone, and a frame that leaves a
	# window alone or the wallpaper unpainted would put only part of it
	# back -- the saver would be followed by a half-drawn desktop.
	DT_FORCEONCE=1
	return 0
}

# Note that someone is here.
dt_saverseen() {
	DT_IDLEFROM=$EPOCHSECONDS
}

# After each frame: start the saver once the idle time is up, or ask to be
# woken when it will be.
dt_saverwait() {
	local left secs=$DT_SAVERSECS

	[ -z "$DT_SAVING" ] && [ -z "$DT_LOCKED" ] || return 0
	[ -n "$secs" ] || secs=$(( ${DT_SAVERIDLE:-0} * 60 ))
	[ "$secs" -gt 0 ] 2> /dev/null || return 0
	left=$(( secs - (EPOCHSECONDS - DT_IDLEFROM) ))
	if [ "$left" -le 0 ]; then
		dt_saverstart
		dt_want 10
		return 0
	fi
	dt_want $(( left * 1000 ))
	return 0
}
