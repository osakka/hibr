# wm/rtview -- a window drawn by its app's own process (ADR 0050, the cell
# record): the window manager draws its face and frame, and its app's cells
# come from the app's process on a channel of their own, which the console
# keeps for the window (`console cells`) and shows where the app's _draw
# would have run. A window is hosted when its app is hosted or being started
# as it is made, and is then never drawn in-process: until its view is
# bound it shows its face and frame and nothing else. The desktop never
# waits on the app: a call into it is a line on its socket, an asked one
# (a close) holds the window until the app's `took` or DT_HOLDMS, and the
# person's input is numbered so an app that leaves it unanswered is seen
# (what then happens, and what happens when the app ends, is
# wm/rtfail.hibr's). The wire is scratchpad's wire-spine.md, protocol 7.
# Only a test session listens (dt_rtlisten), so in a real session every
# branch on DT_RVC is one empty lookup.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# Each hosted window's view: its generation, the size and the draw words it
# was last bound with ("H W DH DW OR OC"), whether its kept cells changed or
# were uncovered since it was last shown, the argument its _open waits to
# be told with, and its close asked and not yet answered (the ask's number,
# or done). DT_RVC itself is the seam's (wm/seam.hibr).
declare -gA DT_RVGEN DT_RVARGS DT_RVDIRTY DT_RVUNC DT_RVOPEN DT_RVCLOSE
# What a hosted app's process said it has, by prefix (`has`) -- the request
# connection that draws for it is the seam's DT_RTHOST; the asks waiting for
# a `took`, by number ("KIND ID DEADLINE", and for the person's input its
# time and its app's processor time too: dt_rvinput; "handed FN DEADLINE"
# for a callback handed back to its app: dt_rvappfn); what has been said
# once; and an app process with no window left, by pid, with when it is
# ended if still there (in milliseconds, so DT_RTENDSECS is that long and not
# up to a second less).
declare -gA DT_RTHAS DT_RVASK DT_RVSAID DT_RTENDPID
DT_RVSEQ=0
DT_RTENDSECS="${DT_RTENDSECS-5}"
# What a hosted app's process last built of its menus (menus:APP), of a
# window's context menu (context:APP) and of a list of choices it opened
# (list:CONNECTION), parsed once as it arrives and kept beside the line it
# came in, so a push that says nothing new is one comparison; the row a
# list opens on, taken by its first build; when a context menu asked of a
# hosted window and not yet built is given up on; and what each handed
# callback asked of an app's process runs once it answers yes, by ask, with
# the connection it was asked on -- kept past DT_HOLDMS, since a late yes is
# still the app's answer and the dialog waits for it, never the desktop.
declare -gA DT_RVMENU DT_RVMTEXT DT_RVLSEL DT_RVTHENQ DT_RVTHENC
DT_RVCTXT=
# The window whose menus, and whose context menu, a push has just brought:
# the rebuild that push causes builds what came and does not ask again, or
# a menu that differs on every build -- a clock in a label -- would be asked
# for and pushed at the round trip's own speed for as long as it is shown.
DT_RVQUIETM=
DT_RVQUIETC=

# Start an installed app in a process of its own: the runtime, run with the
# app and its file (runtime.hibr, run rather than sourced). A test session's
# only; the launch is answered with ret, as dt_rtspawn answers.
fn dt_rthost(app) {
	local src=${DT_APPS["$app"]["src"]-} t

	[ -n "$src" ] || { dt_log "app runtime: $app has no file to start"; return 1; }
	dt_rtlisten || return 1
	t := dt_rtspawn "$app" "$src" "$DT_HERE/runtime.hibr" "$app" "$src"
	ret "$t"
}

# Whether an app's windows are its own process's to draw: it said what it
# has, it is connected, or a launch of it is under way.
fn dt_rvhosted(ap = "") {
	local t

	[ -n "$ap" ] || return 1
	[ -n "${DT_RTHOST["$ap"]-}" ] || [ -n "${DT_RTAPPS["$ap"]-}" ] && return 0
	for t in "${!DT_RTLAUNCH[@]}"; do
		[ "${DT_RTLAUNCH["$t"]}" = "$ap" ] && return 0
	done
	return 1
}

# A new window: hosted or not, decided once, as it is made.
fn dt_rvnew(int id, ap = "") {
	[ -n "$DT_RTLFD" ] && dt_rvhosted "$ap" || return 1
	DT_RVC[$id]=
	DT_RVGEN[$id]=0
	DT_RVDIRTY[$id]=1
	return 0
}

# Whether a hosted window's app has callback kind f, as the window manager
# asks dt_has in-process: from what its process said. The kinds the wire
# does not carry yet (an ask whose answer the desktop takes) are left out,
# said once each; and _idle, which its own process runs beside its draw
# (runtime.hibr), so the desktop never calls it.
fn dt_rvhas(ap, f) {
	[[ ${DT_RTHAS["$ap"]-} == *" $f "* ]] || return 1
	[ "$f" != idle ] || return 1
	case $f in
	canclose | signin)
		dt_rvonce "has:$ap:$f" "app runtime: ${ap}_$f is not carried yet (ADR 0050); the window has none"
		return 1
		;;
	esac
	return 0
}

# Say something once a session.
fn dt_rvonce(key, text) {
	[ -n "${DT_RVSAID["$key"]+x}" ] && return 0
	DT_RVSAID["$key"]=1
	dt_log "$text"
}

# What a window's view is bound with: "H W DH DW OR OC", the window's size
# and how its _draw is called -- the words dt_win gives an in-process draw.
fn dt_rvargs(int id) {
	local h=${DT[$id]["h"]} w=${DT[$id]["w"]}

	if [ "${DT[$id]["chrome"]-}" = none ]; then
		ret "$h $w $h $w 0 0"
	elif dt_capped "$id"; then
		ret "$h $w $((h - 1)) $w 0 1"
	else
		ret "$h $w $((h - 2)) $((w - 2)) 0 0"
	fi
}

# Bind a hosted window's view, or bind it again when its size or draw words
# changed, telling its process `view`; and tell it the _open that waited for
# it. Status 1 while its app has no cells channel yet.
fn dt_rvbind(int id) {
	local ap=${DT[$id]["app"]-} c fd a h w dh dw or oc x new=

	# One whose app has gone keeps its last picture, never bound again.
	[ "${DT_RVC[$id]}" != - ] || return 0
	c=${DT_RTHOST["$ap"]-}
	[ -n "$c" ] || return 1
	fd=${DT_RTCELLS["$c"]-}
	[ -n "$fd" ] || return 1
	a := dt_rvargs "$id"
	[ "${DT_RVC[$id]}" = "$c" ] && [ "${DT_RVARGS[$id]-}" = "$a" ] && return 0
	[ "${DT_RVC[$id]}" = "$c" ] || new=1
	read -r h w dh dw or oc <<< "$a"
	DT_RVGEN[$id]=$((DT_RVGEN[$id] + 1))
	if ! console cells own "$fd" "w$id" "${DT_RVGEN[$id]}" "w$id" 0 0 "$h" "$w"; then
		dt_log "app runtime: window $id of $ap could not be bound"
		return 1
	fi
	# Bound to a process for the first time -- a new window, or one whose
	# app was started again -- its _open is told there, with nothing for
	# one that was not just made: that process holds nothing of it yet, as
	# a window a restart could not carry is opened fresh in-process.
	[ -z "$new" ] || [ -n "${DT_RVOPEN[$id]+x}" ] || DT_RVOPEN[$id]=
	DT_RVC[$id]=$c
	DT_RVARGS[$id]=$a
	DT_RVDIRTY[$id]=1
	DT_RVUNC[$id]=1
	[ -z "$new" ] || dt_hooks "$id" "$ap"
	# Its menus are built in its process once it can be asked: a window
	# focused before that is built again now (dt_rvmenus).
	[ -z "$new" ] || [ "$DT_FOCUS" != "$id" ] || DT_MENUIN=
	dt_rtpass force
	x := dt_rtline view "w$id" "${DT_RVGEN[$id]}" "$h" "$w" win "$id" "$dh" "$dw" "$or" "$oc"
	dt_rtsay "$c" "$x"
	if [ -n "${DT_RVOPEN[$id]+x}" ]; then
		[ -z "${DT[$id]["open"]-}" ] || dt_rvsend "$id" 0 open "${DT_RVOPEN[$id]}"
		unset DT_RVOPEN[$id]
	fi
	return 0
}

# A hosted window's _open: told once its view is bound, so the app draws it
# from the first frame it has.
fn dt_rvopen(int id, arg = "") {
	DT_RVOPEN[$id]=$arg
	dt_rvbind "$id" ||
		dt_log "app runtime: window $id of ${DT[$id]["app"]-?} waits for its app's cells; its face and frame meanwhile"
	return 0
}

# Put a hosted window's kept cells in: those that changed since it was last
# shown, or all of them (-a) over a face just drawn.
fn dt_rvshow(int id, all = "") {
	[ -n "${DT_RVC[$id]-}" ] || return 0
	console cells show "w$id" $all
	unset DT_RVDIRTY[$id] DT_RVUNC[$id]
	return 0
}

# One call into a hosted window's app: `call SEQ ID KIND WORDS...`, what
# changed sent first, so the app reads the window as it stands.
fn dt_rvsend(int id, int seq, kind, ...words) {
	local x

	dt_rtpass force
	x := dt_rtline call "$seq" "$id" "$kind" "${words[@]}"
	dt_rtsay "${DT_RVC[$id]}" "$x"
}

# Whether a key is one the desktop also acts on once a window declines it:
# any chord of a shortcut or an app launcher's key, plain ones included
# (dt_keyassigned answers no for every plain key, the harness's q and Menu
# Bar's Escape among them). An input method's keys are taken before the
# window while it holds a word, and never after it, as dt_keyassigned says.
fn dt_rvwithheld(key) {
	local knorm an

	knorm := dt_keynorm "$key"
	for an in "${!DT_KEYS[@]}"; do
		case $an in ime*) continue ;; esac
		dt_keyin "${DT_KEYS["$an"]}" "$knorm" && return 0
	done
	for an in "${!DT_APPKEY[@]}"; do
		dt_keyin "${DT_APPKEY["$an"]}" "$knorm" && return 0
	done
	return 1
}

# The person's input to a hosted window, numbered as an ask so its answer
# can be told from a late one and its time kept (ADR 0050, the
# not-responding mark): "KIND ID DEADLINE T0 ON WAIT FLAGS", the deadline
# DT_HOLDMS on, T0 the clock in microseconds, ON and WAIT the app process's
# processor and run-queue time then (schedstat), by which a wait past the
# deadline is judged a stall as dt_slow judges one. Answered with ret.
fn dt_rvinput(int id, kind) {
	local p on=0 wt=0 now=${EPOCHREALTIME/./}

	DT_RVSEQ=$((DT_RVSEQ + 1))
	p=${DT_RTCPID["${DT_RVC[$id]}"]-}
	[ -z "$p" ] || read -r on wt _ 2> /dev/null < "/proc/$p/schedstat" || { on=0; wt=0; }
	DT_RVASK[$DT_RVSEQ]="$kind $id $((now / 1000 + DT_HOLDMS)) $now $on $wt -"
	ret "$DT_RVSEQ"
}

# A hosted window's input handler (dt_wincall): sent and never waited for.
# The person's own input -- a key, a click, a press or a release, the
# wheel, a paste, a drop, never the pointer moving -- is numbered
# (dt_rvinput), so the window is marked not responding when its app leaves
# it unanswered; one key the desktop also acts on is withheld and declined at
# once, so the desktop's own action runs and it is never done twice (ADR
# 0050, B). The person's own input marks the window's cells channel as
# input, so the echo is drawn when it comes.
fn dt_rvcall(int id, cb, ...args) {
	local ap=${DT[$id]["app"]-} kind seq=0

	kind=${cb#"${ap}_"}
	if [ -z "${DT_RVC[$id]}" ]; then
		dt_rvonce "early:$id" "app runtime: window $id of $ap was given $kind before its view was bound; not sent"
		return 1
	fi
	# Its app has gone: nothing to send to, and a key is declined, so the
	# desktop's own action on it -- Close among them -- still runs.
	if [ "${DT_RVC[$id]}" = - ]; then
		dt_rvonce "gone:$id" "app runtime: window $id's app $ap has gone; its $kind is not sent"
		return 1
	fi
	case $kind in
	key)
		seq := dt_rvinput "$id" key
		# One the desktop also acts on once a window declines it, from
		# the one call whose decline does that (DT_RVFALL, wm/input.hibr):
		# the desktop's action and everything the person does after it
		# wait for the app's answer, or DT_HOLDMS, never longer -- then
		# the action runs and, if no answer came, the key is revoked, so
		# it is never done twice (dt_rvunhold). Answered "taken" here,
		# since nothing more may be done with it now. A key from anywhere
		# else -- a paste typed in, an input method's word, a repeat -- has
		# no action to hold and is sent as any input is.
		if [ -n "$DT_RVFALL" ] && [ "$DT_RVFALL" = "${args[0]-}" ] && dt_rvwithheld "${args[0]-}"; then
			DT_RVFALL=
			DT_RVHOLD=$seq
			DT_RVHOLDK=${args[0]-}
			dt_want "$DT_HOLDMS"
		fi
		console cells input "w$id"
		dt_rvsend "$id" "$seq" key "${args[@]}"
		;;
	click | mouse | wheel | paste | drop)
		if [ "$kind" != mouse ]; then
			seq := dt_rvinput "$id" "$kind"
		else
			case ${args[0]##*-} in press | release) seq := dt_rvinput "$id" "$kind" ;; esac
		fi
		console cells input "w$id"
		dt_rvsend "$id" "$seq" "$kind" "${args[@]}"
		;;
	*) dt_rvsend "$id" 0 "$kind" "${args[@]}" ;;
	esac
	return 0
}

# A hosted window's handler that answers with ret (dt_winget): the desktop
# never waits on an app, so such an answer cannot be had here -- its caller
# sends the whole of what it does instead (Copy and Cut: dt_rvedit, in
# wm/rtcarry.hibr). One that reaches here is not carried yet: nothing is
# answered, as when no answer comes, and said once.
fn dt_rvget(int id, cb, ...args) {
	dt_rvonce "get:$id:$cb" "app runtime: $cb of window $id is asked, which is not carried yet (ADR 0050); nothing answered"
	return 1
}

# A hosted window closing: its app is asked (`call SEQ ID close`) and the
# window held -- drawn from its kept cells, never waited on -- until the app
# answers or DT_HOLDMS passes, and then it goes either way, since nobody
# reads _close's status in-process either. Status 0 when the window may go
# now (its view forgotten), 1 while it is held.
fn dt_rvclose(int id) {
	local c=${DT_RVC[$id]-} seq

	if [ "$c" = - ]; then
		dt_rvforget "$id"
		return 0
	fi
	if [ -n "$c" ] && [ -z "${DT_RVCLOSE[$id]-}" ] && [ -n "${DT[$id]["close"]-}" ]; then
		DT_RVSEQ=$((DT_RVSEQ + 1))
		seq=$DT_RVSEQ
		DT_RVCLOSE[$id]=$seq
		DT_RVASK[$seq]="close $id $((${EPOCHREALTIME/./} / 1000 + DT_HOLDMS))"
		dt_rvsend "$id" "$seq" close
		dt_want "$DT_HOLDMS"
		return 1
	fi
	[ -z "$c" ] || [ -z "${DT_RVCLOSE[$id]-}" ] || [ "${DT_RVCLOSE[$id]}" = done ] || return 1
	dt_rvforget "$id"
	return 0
}

# Let a hosted window's view go, at both ends; an app process left with no
# window is ended DT_RTENDSECS later if it has not gone by itself.
fn dt_rvforget(int id) {
	local c=${DT_RVC[$id]-} fd i p x

	unset DT_RVC[$id] DT_RVGEN[$id] DT_RVARGS[$id] DT_RVDIRTY[$id] DT_RVUNC[$id] DT_RVOPEN[$id] DT_RVCLOSE[$id]
	unset DT_RVLATE[$id] DT_RVBUSY[$id] DT_RVMARK[$id]
	if [ "$c" = - ]; then
		dt_rvletgo "$id"
		return 0
	fi
	[ -n "$c" ] || return 0
	fd=${DT_RTCELLS["$c"]-}
	[ -z "$fd" ] || console cells drop "$fd" "w$id"
	if [ -n "${DT_RTC["$c"]+x}" ]; then
		x := dt_rtline forget "w$id"
		dt_rtsay "$c" "$x"
	fi
	for i in "${!DT_RVC[@]}"; do
		[ "${DT_RVC[$i]}" = "$c" ] && return 0
	done
	# Nor while it still draws a pane, a module, a saver or a bar item
	# (wm/rtkinds.hibr).
	for i in "${!DT_RVX[@]}"; do
		[ "${DT_RVX["$i"]}" = "$c" ] && return 0
	done
	p=${DT_RTCPID["$c"]-}
	[ -z "$p" ] || DT_RTENDPID["$p"]=$((${EPOCHREALTIME/./} / 1000 + DT_RTENDSECS * 1000))
	return 0
}

# An app's answer to an ask: a close answered lets its window go; an
# input's is the app answering, which takes back the not-responding mark
# once nothing older of that window's is left unanswered; a handed
# callback's yes runs what waits on it, however late (dt_rvappfn); an
# edit's answer is said (dt_rvedited); one not awaited is dropped and said.
fn dt_rvtook(int c, seq, st = "", t = "", v = "") {
	local kind id end x
	local -a w

	[ -z "${DT_RVEDIT["$seq"]+x}" ] || dt_rvedited "$c" "$seq" "$st" "$t" "$v"
	if [ -n "${DT_RVTHENQ["$seq"]+x}" ] && [ "${DT_RVTHENC["$seq"]-}" = "$c" ]; then
		kind=handed
		unset DT_RVASK["$seq"]
	elif [ -z "${DT_RVASK["$seq"]+x}" ]; then
		dt_log "app runtime: ${DT_RTC["$c"]-an app} answered ask $seq, which was not awaited; dropped"
		return 0
	else
		read -r kind id end _ <<< "${DT_RVASK["$seq"]}"
		unset DT_RVASK["$seq"]
	fi
	if [ "$kind" = handed ]; then
		x=${DT_RVTHENQ["$seq"]-}
		unset DT_RVTHENQ["$seq"] DT_RVTHENC["$seq"]
		[ "$st" = 0 ] && [ -n "$x" ] || return 0
		read -ra w <<< "$x"
		"${w[@]}"
		return 0
	fi
	# A press a hosted pane declined (wm/rtkinds.hibr).
	if [ "$kind" = pmouse ]; then
		dt_rvxpress "$id" "$st"
		return 0
	fi
	# A press a hosted bar item declined (wm/rtkinds.hibr).
	if [ "$kind" = bpress ]; then
		dt_rvbpress "$id" "$st"
		return 0
	fi
	[ "${DT_RVC[$id]-}" = "$c" ] || return 0
	if [ "$kind" != close ]; then
		[ "$DT_RVHOLD" != "$seq" ] || dt_rvunhold "$seq" "$st"
		[ "${DT_RVLATE[$id]-}" != "$seq" ] || dt_rvrelate "$id"
		return 0
	fi
	DT_RVCLOSE[$id]=done
	dt_del "$id"
}

# `has PREFIX KIND...` from connection c: what an app of its file has, which
# is how the desktop calls a window of it; and the windows of that app
# waiting for their view are bound now. Only an app its own file registers.
fn dt_rvhas_in(int c, ap = "", ...kinds) {
	local who=${DT_RTC["$c"]} id src

	src := dt_rvsrc "$who"
	if [ -z "${DT_RTCELLS["$c"]-}" ]; then
		dt_log "app runtime: $who said what ${ap:-nothing} has with no cells channel; refused"
		return 0
	fi
	# A pane, a strip module or a saver of its file: drawn in a view of its
	# own kind (wm/rtkinds.hibr). One prefix is never both in one file.
	if [ -n "$ap" ] && [ -n "$src" ] && [ "${DT_APPS["$ap"]["src"]-}" != "$src" ]; then
		dt_rvkinds_in "$c" "$src" "$ap" "${kinds[@]}" && return 0
	fi
	if [ -z "$ap" ] || [ -z "${DT_APPS["$ap"]["src"]-}" ] ||
		[ "${DT_APPS["$ap"]["src"]}" != "$src" ]; then
		dt_log "app runtime: $who said what ${ap:-nothing} has, which its file does not register; refused"
		return 0
	fi
	DT_RTHAS["$ap"]=" ${kinds[*]} "
	DT_RTHOST["$ap"]=$c
	for id in "${!DT_RVC[@]}"; do
		[ -z "${DT_RVC[$id]}" ] && [ "${DT[$id]["app"]-}" = "$ap" ] && dt_rvbind "$id"
	done
	return 0
}

# A cells channel arriving: a new connection whose first line is `cells
# TOKEN`, the token the hello's ok gave connection rc. Spent at once; the
# connection is no request connection from here on, and nothing more is
# said on it once its ok has gone.
fn dt_rvcells_in(int x, tok = "") {
	local rc=${DT_RTCELLTOK["$tok"]-}

	[ -z "$tok" ] || unset DT_RTCELLTOK["$tok"]
	if [ -z "$rc" ] || [ "${DT_RTC["$rc"]-}" = - ] || [ -z "${DT_RTC["$rc"]+x}" ] ||
		[ -n "${DT_RTCELLS["$rc"]-}" ]; then
		dt_rtsay "$x" "refused no%20such%20cells%20token"
		dt_log "app runtime: refused a cells channel with no token of this desktop's"
		dt_rtdrop "$x"
		return 0
	fi
	dt_rtsay "$x" ok
	console unwatch "$x" 2> /dev/null
	unset DT_RTC["$x"] DT_RTBUF["$x"] DT_RTMORE["$x"]
	console watch "$x"
	DT_RTCELLS["$rc"]=$x
	DT_RTCELLC["$x"]=$rc
	# A bar item that draws itself waited for this to be bound, and the
	# bar is drawn again only when something says so (wm/rtkinds.hibr).
	if [ "${#DT_RVB[@]}" != 0 ]; then
		DT_BARWAS=
		dt_want 0
	fi
	return 0
}

# Read what a cells channel has sent, never waiting: its changed views are
# drawn at the next frame (asked for at once), an uncovered one whole, and
# one the console wants again is asked of the app. What it cost is charged
# to its app. A channel that has gone or broken lets its app go.
fn dt_rvtake(int fd) {
	local c=${DT_RTCELLC["$fd"]} r st=0 t0 l n any=
	local -a w

	t0=${EPOCHREALTIME/./}
	r := console cells take "$fd" || st=$?
	dt_spent "cells" "$((${EPOCHREALTIME/./} - t0))" "${DT_RTC["$c"]-}"
	if [ "$st" != 0 ]; then
		l=broke
		[ "$st" = 1 ] && l=ended
		dt_log "app runtime: ${DT_RTC["$c"]-an app}'s cells channel $l; let go"
		if [ "$l" = broke ]; then
			dt_rtdrop "$c" "its cells channel broke"
		else
			dt_rtdrop "$c"
		fi
		return 0
	fi
	while read -ra w; do
		case ${w[0]-} in
		changed)
			for n in "${w[@]:1}"; do
				if [ -n "${DT_RVX["$n"]+x}" ]; then
					DT_RVXDIRTY["$n"]=1
					[[ $n == b* ]] && DT_BARWAS=
				else
					DT_RVDIRTY[${n#w}]=1
				fi
				any=1
			done
			;;
		uncovered)
			for n in "${w[@]:1}"; do
				if [ -n "${DT_RVX["$n"]+x}" ]; then
					DT_RVXDIRTY["$n"]=1
					[[ $n == b* ]] && DT_BARWAS=
				else
					DT_RVDIRTY[${n#w}]=1
					DT_RVUNC[${n#w}]=1
				fi
				any=1
			done
			;;
		again)
			for n in "${w[@]:1}"; do
				l := dt_rtline again "$n"
				dt_rtsay "$c" "$l"
			done
			;;
		esac
	done <<< "$r"
	[ -z "$any" ] || dt_want 0
	return 0
}

# Every cells channel the last wait says has something, taken.
dt_rvtakes() {
	local w fd
	local -a ready

	w := console woke "${!DT_RTCELLC[@]}"
	read -ra ready <<< "$w"
	for fd in "${ready[@]}"; do
		[ -z "${DT_RTCELLC["$fd"]+x}" ] || dt_rvtake "$fd"
	done
	return 0
}

# Every pass while listening: asks and closes past their time, and app
# processes left with no window and not gone by themselves.
dt_rvtick() {
	local s kind id end now p fl

	now=$((${EPOCHREALTIME/./} / 1000))
	for s in "${!DT_RVASK[@]}"; do
		read -r kind id end _ _ _ fl <<< "${DT_RVASK["$s"]}"
		[ "$now" -ge "$end" ] || continue
		# A callback handed back to its app (dt_rvappfn) names a function,
		# not a window: past its time it is said once, and its answer still
		# runs what waits on it when it comes (DT_RVTHENQ).
		if [ "$kind" = handed ]; then
			unset DT_RVASK["$s"]
			dt_log "app runtime: $id did not answer in $DT_HOLDMS ms; what asked it waits for its answer"
			continue
		fi
		if [ -z "${DT_RVC[$id]+x}" ]; then
			unset DT_RVASK["$s"]
			[ "$DT_RVHOLD" != "$s" ] || dt_rvunhold "$s" 1
			continue
		fi
		# The person's input past its time is kept until it is answered:
		# the oldest such is what the window waits on (dt_rvlate). A key
		# whose answer the desktop's action waited on is declined now and
		# revoked, so the app does not act on it as well when it wakes.
		if [ "$kind" != close ]; then
			[ "$fl" = - ] || continue
			DT_RVASK["$s"]=${DT_RVASK["$s"]%-}x
			[ -n "${DT_RVLATE[$id]-}" ] && [ "${DT_RVLATE[$id]}" -lt "$s" ] || DT_RVLATE[$id]=$s
			if [ "$DT_RVHOLD" = "$s" ]; then
				dt_rvrevoke "$id" "$s"
				dt_rvunhold "$s" 1
			fi
			continue
		fi
		unset DT_RVASK["$s"]
		dt_log "app runtime: ${DT[$id]["app"]-?} did not answer the close of window $id in $DT_HOLDMS ms; it goes"
		DT_RVCLOSE[$id]=done
		dt_del "$id"
	done
	for p in "${!DT_RTENDPID[@]}"; do
		if ! kill -0 "$p" 2> /dev/null; then
			# Gone and reaped: what it ended with is its job's kept
			# status, read without waiting, and said once for an app
			# that went with windows open.
			if [ -n "${DT_RTENDOWE["$p"]-}" ]; then
				wait "$p" 2> /dev/null
				dt_rvended "$p" "$?"
			fi
			unset DT_RTENDPID["$p"] DT_RTENDAPP["$p"] DT_RTENDWHY["$p"] DT_RTENDOWE["$p"] DT_RTENDHIT["$p"]
			unset DT_RVRESON["$p"] DT_RVRESAT["$p"] DT_RVRESHELD["$p"]
		elif [ "$now" -ge "${DT_RTENDPID["$p"]}" ]; then
			# Still running a program of its own with no window: left.
			dt_rvbusy "$p" "$now" && continue
			# Still there: ended, then watched until it has gone, and
			# killed outright once more time has passed.
			if [ -z "${DT_RTENDHIT["$p"]-}" ]; then
				if [ -n "${DT_RTENDOWE["$p"]-}" ]; then
					dt_log "app runtime: process $p (${DT_RTENDAPP["$p"]}) had not gone $DT_RTENDSECS s after its connection ended; ended"
				else
					dt_log "app runtime: process $p had no window left and had not gone in $DT_RTENDSECS s; ended"
				fi
				kill "$p" 2> /dev/null
				DT_RTENDHIT["$p"]=1
			else
				dt_log "app runtime: process $p did not end when asked; killed"
				kill -9 "$p" 2> /dev/null
			fi
			DT_RTENDPID["$p"]=$((now + DT_RTENDSECS * 1000))
		fi
	done
	for id in "${!DT_RVLATE[@]}"; do
		dt_rvlate "$id" "$now"
	done
	# Watched closely while an ask is waiting, an input is late or an app
	# that went with windows open is still to be said; a process with no
	# window left only when its time to end comes, so one left at its work
	# for minutes costs the desktop a wake every DT_RTENDSECS, not ten a
	# second (wm/rtcarry.hibr).
	if [ "${#DT_RVASK[@]}${#DT_RVLATE[@]}${#DT_RTENDOWE[@]}" != 000 ]; then
		dt_want 100
	else
		for p in "${!DT_RTENDPID[@]}"; do
			dt_want $((DT_RTENDPID["$p"] - now))
		done
	fi
	if [ -n "$DT_RVHOLD" ]; then
		read -r _ _ end _ <<< "${DT_RVASK["$DT_RVHOLD"]}"
		dt_want $((end > now ? end - now : 0))
	fi
	return 0
}

# A call through the seam (dt_appfn) whose owner, DT_CALLER as the seam
# set it, is an app its own process draws for: a function of the desktop's
# -- File > Close on its menu, a
# request a dialog's callback names, the seam's own dt_appcall -- runs here
# as that app's, guarded as the same request from its process would be;
# any other is the app's own, and goes to its process by name (`call SEQ -
# FN WORDS`), never waited for. A caller that reads the answer (dt_askok)
# keeps what then follows in a local DT_RVTHEN: taken here, the call goes
# as an ask and that runs when the app's `took` says yes. Status 0 once
# sent, whatever the app will answer, as a told request's is.
fn dt_rvappfn(f = "", ...args) {
	local own=$DT_CALLER c seq x

	c=${DT_RTHOST["$own"]}
	if [ -z "$f" ] || dt_has "$f"; then
		# What the app's own file may ask, read once per file: one file may
		# register several apps (Mail's compose window), each its own owner.
		if { [ -n "${DT_RTALLOW["$f"]+x}" ] || [ -n "${DT_RTASK["$f"]+x}" ]; } &&
			{ ! dt_rtmay "$own" || [ -z "${DT_RTMAY["$own $f"]+x}" ]; }; then
			dt_log "app runtime: $own asked for $f, which its own file never asks for; refused"
			return 1
		fi
		# A request runs as one from that app's process, which is what it
		# checks before trusting DT_CALLER (dt_rtmine, dt_set's allowlist).
		local DT_RTFROM=
		[ -z "${DT_RTALLOW["$f"]+x}${DT_RTASK["$f"]+x}" ] || DT_RTFROM=$c
		"$f" "${args[@]}" && ret -k
		return
	fi
	seq=0
	if [ -n "${DT_RVTHEN-}" ]; then
		DT_RVSEQ=$((DT_RVSEQ + 1))
		seq=$DT_RVSEQ
		DT_RVASK[$seq]="handed $f $((${EPOCHREALTIME/./} / 1000 + DT_HOLDMS))"
		DT_RVTHENQ[$seq]=$DT_RVTHEN
		DT_RVTHENC[$seq]=$c
		DT_RVTHEN=
		dt_want "$DT_HOLDMS"
	fi
	dt_rtpass force
	x := dt_rtline call "$seq" - "$f" "${args[@]}"
	dt_rtsay "$c" "$x"
}

# `menus APP JSON` or `context APP JSON` from connection c: what an app of
# its file built with the same builders the desktop has (wm/menubuild.hibr)
# -- its menus or a window's context menu, or, marked "list", a list of
# choices it is about to open -- kept until it says something different,
# and the menus built again on the next frame. Only an app its own file
# registers.
fn dt_rvpush_in(int c, verb, ap = "", j = "") {
	local who=${DT_RTC["$c"]} key
	local -A g

	if [ -z "$ap" ] || [ -z "${DT_APPS["$ap"]["src"]-}" ] ||
		[ "${DT_APPS["$ap"]["src"]}" != "${DT_APPS["$who"]["src"]-}" ]; then
		dt_log "app runtime: $who sent $verb of ${ap:-nothing}, which its file does not register; refused"
		return 0
	fi
	if ! json parse g <<< "$j" 2> /dev/null; then
		dt_log "app runtime: $who sent $verb of $ap as JSON the desktop could not read"
		return 0
	fi
	key="$verb:$ap"
	if [ -n "${g["list"]-}" ]; then
		key="list:$c"
		DT_RVLSEL["$c"]=${g["sel"]-}
	elif [ "${DT_RVMTEXT["$key"]-}" = "$j" ]; then
		return 0
	fi
	DT_RVMTEXT["$key"]=$j
	unset DT_RVMENU["$key"]
	json parse DT_RVMENU["$key"] "$j"
	DT_RVMENU["$key"]["from"]=$c
	DT_RVMENU["$key"]["app"]=$ap
	if [ "$verb" = menus ]; then
		DT_MENUIN=
		DT_RVQUIETM=${g["id"]-}
	elif [ -z "${g["list"]-}" ]; then
		DT_RVQUIETC=${g["id"]-}
	fi
	DT_MENUEV=1
	dt_want 0
	return 0
}

# Build what an app's process pushed under key, through the builders, as
# that app's: its rows' commands, its submenus where they hang, its tick
# marks, a row's shortcut. Its words are already translated, so nothing is
# looked up twice; where it called dt_editmenu the desktop's own Edit goes,
# built here as the desktop's, as in every bar. Only what was built for
# window id, when one is given. Status 1 when there is nothing to build.
fn dt_rvreplay(key, ap, id = "") {
	local n i t lang=$DT_LANG

	n=${DT_RVMENU["$key"]["n"]-}
	[ -n "$n" ] || return 1
	[ -z "$id" ] || [ "${DT_RVMENU["$key"]["id"]-}" = "$id" ] || return 1
	local DT_CALLER=$ap DT_LANG=
	for ((i = 0; i < n; i++)); do
		[ -z "${DT_RVMENU["$key"]["mb"]["$i"]["par"]-}" ] || continue
		if [ -n "${DT_RVMENU["$key"]["mb"]["$i"]["edit"]-}" ]; then
			DT_LANG=$lang
			DT_CALLER=
			dt_editmenu
			DT_LANG=
			DT_CALLER=$ap
			continue
		fi
		t=${DT_RVMENU["$key"]["mb"]["$i"]["title"]-}
		dt_menu "$t"
		dt_rvrows "$key" "$i"
	done
	return 0
}

# The rows of menu m of what key holds, a submenu's built where its row is.
fn dt_rvrows(key, int m) {
	local r=0 n j argc s lb k tick dim acc
	local -a a

	n=${DT_RVMENU["$key"]["mb"]["$m"]["n"]:-0}
	while [ "$r" -lt "$n" ]; do
		s=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["sub"]-}
		lb=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["label"]-}
		k=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["key"]-}
		if [ "${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["sep"]-}" = 1 ]; then
			dt_sep
		elif [ -n "$s" ]; then
			dt_sub "$lb" "$k"
			dt_rvrows "$key" "$s"
			dt_end
		else
			a=()
			argc=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["argc"]:-0}
			for ((j = 0; j < argc; j++)); do
				a+=("${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["a$j"]-}")
			done
			tick=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["tick"]-}
			dim=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["dim"]:-0}
			acc=${DT_RVMENU["$key"]["mi"]["$m"]["$r"]["accel"]-}
			dt_row "$tick" "$dim" "$lb" "$k" "${a[@]}"
			[ -z "$acc" ] || dt_rowaccel "$acc"
		fi
		r=$((r + 1))
	done
	return 0
}

# A hosted window's menus, for dt_menus: the last its app's process built
# for this window, built again here, and the process asked to build them
# afresh (`call 0 ID menus`), so a change comes back pushed and the bar is
# built again with it. Status 1 while it has none for this window -- its
# app has no _menus, or nothing has come yet -- so the bar keeps File >
# Close meanwhile, which every window has.
fn dt_rvmenus(int id) {
	local ap=${DT[$id]["app"]-} q=$DT_RVQUIETM

	dt_rvhas "$ap" menus || return 1
	DT_RVQUIETM=
	# Not while its view is not yet bound, nor once its app has gone (-),
	# when the last it pushed was let go with it and File > Close stands.
	case ${DT_RVC[$id]} in "" | -) ;; *) [ "$q" = "$id" ] || dt_rvsend "$id" 0 menus ;; esac
	dt_rvreplay "menus:$ap" "$ap" "$id"
}

# A hosted window's context menu, for dt_ctxbuild: the same, from its
# app's _context. Status 2 while it is asked for and not yet built --
# nothing is drawn and the menu stays open for it -- and 1 once DT_HOLDMS
# has passed with nothing, said in the log, so dt_ctxbuild closes it.
fn dt_rvcontext(ap, int id) {
	local now q=$DT_RVQUIETC

	DT_RVQUIETC=
	# Its app has gone: there is nobody to build it.
	[ "${DT_RVC[$id]}" != - ] || return 1
	case ${DT_RVC[$id]} in "") ;; *) [ "$q" = "$id" ] || dt_rvsend "$id" 0 context ;; esac
	if dt_rvreplay "context:$ap" "$ap" "$id"; then
		DT_RVCTXT=
		return 0
	fi
	now=$((${EPOCHREALTIME/./} / 1000))
	[ -n "$DT_RVCTXT" ] || DT_RVCTXT=$((now + DT_HOLDMS))
	if [ "$now" -ge "$DT_RVCTXT" ]; then
		dt_log "app runtime: $ap did not build the context menu of window $id in $DT_HOLDMS ms; it does not open"
		DT_RVCTXT=
		return 1
	fi
	dt_want $((DT_RVCTXT - now))
	return 2
}

# A list of choices an app's process opened (dt_context_open widget, which
# its own dt_dropat sends): the rows it pushed just before, with the words
# its namer gave each value, built here as its own, starting on the row it
# chose the first time. Status 1 when it pushed none.
fn dt_rvlist(int c) {
	local key="list:$c"

	dt_rvreplay "$key" "${DT_RVMENU["$key"]["app"]-}" || return 1
	if [ -n "${DT_RVLSEL["$c"]-}" ]; then
		MB_SEL=${DT_RVLSEL["$c"]}
		unset DT_RVLSEL["$c"]
	fi
	return 0
}
