# wm/session -- the life of a session: opening the display, the event loop
# that sleeps until something needs a frame, and closing it again.
#
# Part of the window manager; desktop.hibr sources it. It only defines
# functions and sets state, so it can be read on its own and is never run.

strict

# The longest the desktop sleeps when nothing has asked for a frame. Not a
# refresh rate: everything that changes on its own -- the bar clock, a
# blinking cursor, a game, a meter -- asks with dt_want, and input, resize
# and a terminal's output wake it at once. This is only a net under
# anything that forgot to ask. There used to be a DT_TICK here, a fixed
# redraw rate; a saved settings file kept the old 200ms default alive for
# anyone who had ever saved a setting, and cost 5 full redraws a second
# with nothing on screen changing.
DT_IDLEMS="${DT_IDLEMS-60000}"

# What each stage of starting cost, in ms, for the one line the log gets.
DT_TSTART=
DT_TLAST=

# One stage of starting done: its cost since the one before, kept for dt_tdone.
fn dt_tstamp(what) {
	local now=$EPOCHREALTIME

	[ -n "$DT_T0" ] || return 0
	now=${now/./}
	[ -n "$DT_TLAST" ] || DT_TLAST=${DT_T0/./}
	DT_TSTART+="${DT_TSTART:+, }$what $(( (now - DT_TLAST) / 1000 ))"
	DT_TLAST=$now
}

# The first frame is up: say in the log how long starting took, and stop timing.
dt_tdone() {
	local now=$EPOCHREALTIME

	[ -n "$DT_T0" ] || return 0
	dt_tstamp "first frame"
	now=${now/./}
	dt_rslog "started in $(( (now - ${DT_T0/./}) / 1000 )) ms: $DT_TSTART"
	export -n DT_T0
	DT_T0=
	DT_TSTART=
	DT_TLAST=
}

# Open the display, take the mouse, and note how big the screen is.
#
# ctrl-c, ctrl-\ and ctrl-z become keys rather than signals: the desktop is
# left by Quit, never by a stray interrupt, and the key goes to the focused
# window -- which is how a program in a terminal window gets its ctrl-c.
dt_open() {
	local sess

	dt_tstamp "apps"
	dt_supervise
	# One app's arithmetic slip, or one function nesting too deep, fails
	# that command and is written to the log -- it does not end the
	# desktop and every window in it, as it would end another script.
	shopt -s keepgoing
	# Which desktop this is, in ps: three processes with three jobs --
	# hold's server, this, and the supervisor -- all read some variation
	# of `hibr [desktop]` before 0.99.110, and a terminal window's own
	# shell read a bare `hibr` (Gitea #111). The name is the session's,
	# which is what `hold list` and `desktop --resume` call it.
	# Two names, because the two places a person looks hold different
	# numbers of bytes (Gitea #168): the sentence for `ps`, and a short
	# one for `top`, `htop` and `pgrep`, which read the kernel's own name
	# and get 15 bytes. Role first, no brackets -- `ps` wraps a defunct
	# process's name in brackets of its own, so a name with brackets in
	# it reads as `[desktop [x]] <defunct>`.
	#
	# The session is named whatever it is called, the default included:
	# a process called plain `desktop` beside its own supervisor, its
	# windows' shells and its jobs is the one thing in the tree that does
	# not say which session it belongs to, which is what was reported
	# (Gitea #213). `desktop:desktop` is fifteen bytes exactly, so even
	# the stutter fits -- and a stutter that says something beats a word
	# that says nothing twice over, now that there is more than one
	# session on a machine.
	sess := dt_holdsess
	local pn pf
	pn := dt_shortname desktop "$sess"
	pf := dt_procfull desktop "$sess"
	title -s "$pn" "$pf"
	dt_load
	console open || return 1
	dt_tstamp "console"
	trap 'dt_onstop HUP' HUP
	trap 'dt_onstop TERM' TERM
	# What a cell left at the terminal's own default colour should darken
	# toward, for a window's shadow: the desktop's own idea of plain
	# ink-on-face, the same colours everything undecorated already reads
	# as. Without this, a shadow over a terminal's own plain, uncoloured
	# output -- a shell prompt, ls of regular files, most of what
	# actually appears on screen -- showed no visible darkening at all.
	console darkdefault "$DT_INK" "$DT_FACE"
	console imgdetail "$DT_IMGDETAIL"
	console imgcomp "$DT_IMGCOMP"
	console signals off
	# Click and drag only, not motion: reporting every movement with no
	# button held (XTerm mode 1003) was tried for the strip's own hover
	# highlight, and cost far more than that was worth -- a continuous
	# stream of escape sequences on every mouse movement anywhere on
	# screen, whether or not anything in hibr cared, which broke a real
	# terminal's own copy-and-paste convention (holding shift to bypass
	# app mouse reporting only ever had to suppress clicks and drags, not
	# a flood of plain movement) and made the desktop's own selection
	# band lag well behind the pointer, queued behind stale hover reports
	# from a moment earlier. The strip still scrolls by wheel (the wheel
	# event carries its own position) and by keyboard once given
	# attention with its own shortcut; only hovering it with the mouse
	# and getting no click at all is gone.
	dt_mouseset drag
	console cursor off
	# mkdir is a process, and startup should not pay for one per folder
	# every time: only when the folder is not there yet.
	if [ -d "${DT_LOG%/*}" ] || mkdir -p "${DT_LOG%/*}" 2> /dev/null; then
		exec {DT_ERR}>&2 2>> "$DT_LOG"
	fi
	dt_langapply
	dt_has cs_relist && cs_relist
	dt_size
	dt_deskscan
	dt_clipload
	dt_snaptake
	dt_restore
	dt_ctlopen
	dt_tstamp "open"
}

# Move everything a person has arranged by however far hold has moved
# the session's own origin, and remember where it stands now.
#
# hold keeps the arrangement's top-left corner at the union's 0,0, so a
# display joined *above* or to the *left* of the others shifts every
# display -- the primary with them (Gitea #257). That is what gives the
# new display rows that exist, and it is also what moves the ground out
# from under every window already placed: a window's row and column are
# the union's, stored, so without this each one would keep its old row
# and end up straddling the join. Whatever is recomputed from the
# primary's rectangle each frame needs none of this; it is only for
# what is remembered.
#
# Nothing happens on the first call -- there is no previous reading to
# have moved from -- nor when the reading is unchanged, which is every
# ordinary resize and every change of which display is primary.
fn dt_shiftorigin(shift) {
	local was dr dc id r c k

	was=$DT_SHIFTWAS
	DT_SHIFTWAS=$shift
	[ -z "$was" ] && return 0
	[ "$was" = "$shift" ] && return 0
	dr=$((${shift%% *} - ${was%% *}))
	dc=$((${shift##* } - ${was##* }))
	[ "$dr" = 0 ] && [ "$dc" = 0 ] && return 0
	for id in "${!DT[@]}"; do
		r=${DT["$id"]["row"]}
		c=${DT["$id"]["col"]}
		[ -n "$r" ] && DT["$id"]["row"]=$((r + dr))
		[ -n "$c" ] && DT["$id"]["col"]=$((c + dc))
	done
	# An icon's own saved place is the union's too, and dt_iconlay
	# clamps rather than moves -- so without this every icon would be
	# squashed against whichever edge the primary now begins at.
	for k in "${!DT_ICONPOS[@]}"; do
		r=${DT_ICONPOS["$k"]%% *}
		c=${DT_ICONPOS["$k"]##* }
		DT_ICONPOS["$k"]="$((r + dr)) $((c + dc))"
	done
	# The Control Strip keeps one absolute row. Left alone it would be
	# clamped to the primary's new top, which is not where it was. A
	# never-set one is left alone, the same as cs_clamp leaves it: its
	# default is computed from the primary and so follows already.
	[ -n "${CS_Y-}" ] && CS_Y=$((CS_Y + dr))
	printf 'desktop: displays moved by %s,%s; windows, icons and the strip with them\n' \
		"$dr" "$dc" >&2
	return 0
}

# Re-read the screen size after a resize, and this desktop's own primary
# viewport from hold's own per-client data. Not held, or hold not loaded,
# or nobody has attached yet (the moment right after `hold new -d` starts
# this script, before the first `hold attach` lands): primary is the whole
# screen, at column 0, the same fallback as a lone terminal always was.
dt_size() {
	local sz lst nm row col rows cols pri sft gl gnm gv
	local -A dgfx

	sz := console size
	DT_ROWS=${sz% *}
	DT_COLS=${sz#* }
	DT_MENUIN=
	DT_PRIMARY_W=$DT_COLS
	DT_PRIMARY_COL=0
	DT_PRIMARY_H=$DT_ROWS
	DT_PRIMARY_ROW=0
	# One entry per attached display, for whoever has to place
	# something on each of them rather than once across the union --
	# the wallpaper, today (Gitea #238). Read here, with the primary,
	# because `hold clients` is a round trip to the server and a frame
	# must not pay for one: dt_size runs on open and on every resize,
	# and a client attaching or leaving is a resize.
	#
	# Each entry ends in what that display's own terminal draws (Gitea
	# #258): kitty, sixel, none, unknown or unasked, from `hold gfx`, or `self`
	# when nothing is held and the console's own answer is the display's.
	# A server too old to answer `hold gfx` still sends every display every
	# picture, as it always did, so every display is then `unasked` and is
	# drawn as before rather than in half blocks (Gitea #274) -- which is
	# what 0.99.235 did, and a kitty display lost its picture for it.
	DT_DISPLAYS=("0 0 $DT_ROWS $DT_COLS self")
	DT_DISPNAMES=("")
	if [ -n "$HIBR_HOLD" ] && need hold; then
		lst := hold clients
		if gl := hold gfx 2> /dev/null; then
			while IFS=' ' read -r gnm gv _; do
				[ -n "$gnm" ] && dgfx["$gnm"]=$gv
			done <<< "$gl"
			gv=unknown
		else
			gv=unasked
		fi
		DT_DISPLAYS=()
		DT_DISPNAMES=()
		# No `break` on finding the primary: every display is wanted,
		# and the primary is not always the first line. Breaking there
		# is what the version before this did, when the primary was
		# all anybody read.
		while IFS=' ' read -r nm row col rows cols pri; do
			[ -n "$nm" ] || continue
			DT_DISPLAYS+=("$row $col $rows $cols ${dgfx["$nm"]:-$gv}")
			DT_DISPNAMES+=("$nm")
			if [ "$pri" = 1 ]; then
				DT_PRIMARY_COL=$col
				DT_PRIMARY_W=$cols
				# The row and height were read here and
				# dropped until 0.99.205 (Gitea #240), which
				# is what made a union horizontal-only in
				# practice however hold described it.
				DT_PRIMARY_ROW=$row
				DT_PRIMARY_H=$rows
			fi
		done <<< "$lst"
		# Held but nothing attached: the screen is still a screen.
		if [ "${#DT_DISPLAYS[@]}" = 0 ]; then
			DT_DISPLAYS=("0 0 $DT_ROWS $DT_COLS unknown")
			DT_DISPNAMES=("")
		fi
		# A second round trip, and only here: dt_size runs on open
		# and on every resize, and a client attaching, leaving or
		# being moved is a resize, so this is asked exactly when the
		# answer can have changed.
		sft := hold shift
		dt_shiftorigin "${sft:-0 0}"
	fi
	dt_has dt_blankregions && dt_blankregions
	dt_iconlay
	cs_clamp
	dt_has dt_tile && dt_tile
	return 0
}

# Give the terminal back.
dt_close() {
	dt_ctlclose
	dt_sndstop
	dt_snapdrop
	if [ -n "$DT_ERR" ]; then
		exec 2>&$DT_ERR {DT_ERR}>&-
		DT_ERR=
	fi
	dt_mouseset off
	console signals on
	console close
}

# What runs after every frame whether or not any window is drawn --
# Calendar's reminders, which must go off with no Calendar open. An app
# registers a function with dt_ticker; it runs once a frame, must be cheap
# when there is nothing to do, and asks for the frame it next needs with
# dt_want, so an idle desktop still sleeps.
DT_TICKERS=()
fn dt_ticker(name) {
	case " ${DT_TICKERS[*]} " in *" $name "*) return 0 ;; esac
	DT_TICKERS+=("$name")
}
# Every frame. A ticker whose function is not there -- registered by a
# file whose library failed to load, or by an app since removed -- is
# taken off the list with one line in the log saying so, rather than
# called on every frame for as long as the desktop runs: that is how one
# missing library put 1.78 million `pe_servers: command not found` lines
# into the owner's desktop.log (Gitea #262). The check costs one lookup
# per ticker per frame, and there are a handful.
dt_tickers() {
	local f
	local -a keep=()

	for f in "${DT_TICKERS[@]}"; do
		if ! dt_has "$f"; then
			printf 'desktop: ticker %s is not defined; taken off the list\n' \
				"$f" >&2
			continue
		fi
		keep+=("$f")
		"$f"
	done
	[ "${#keep[@]}" = "${#DT_TICKERS[@]}" ] || DT_TICKERS=("${keep[@]}")
	return 0
}

# Ask for the next frame within ms, from inside an app's _draw.
#
# The request lasts one frame: a game that is paused, hidden or not focused
# simply stops asking, and the desktop goes back to sleeping until input.
# An idle desktop must not pay for an animation nobody is watching. The
# soonest of every ask in a frame wins; anything that shows the time has
# to ask for its next change, or it stops changing.
DT_WANT=

fn dt_want(int ms) {
	if [ -z "$DT_WANT" ] || [ "$ms" -lt "$DT_WANT" ]; then
		DT_WANT=$ms
	fi
}

# A live redraw on every SIGWINCH of a drag makes the screen scramble once
# per pixel the terminal moves through, which is what dragging a real GUI
# window's edge does not do -- it freezes the content and snaps it once at
# the end.  console resizing is a cheap peek at the same flag console
# resized consumes, with none of its clear-and-repaint side effects, so a
# burst of them costs nothing extra: this waits for DT_RSTILL ms of quiet
# before it calls console reassert and redraws, once, at the settled size.
DT_RSTILL=150

# The event loop.  Draw, wait, dispatch, repeat.
#
# A drag or a wheel is drawn only when it has caught up with the mouse:
# while the next report is already waiting, drawing this one would only be
# overwritten, and a frame slower than the reports arrive left a window
# crawling after the hand had stopped. DT_DRAWSKIP thins a drag's frames on
# top of that.
#
# A key read while rsz is waiting out the quiet period is still consumed
# from the pty whether this looks at it or not, so it has to be kept in pk
# rather than just skipped -- skipping it reads the byte and throws the
# value away, which is a key silently lost, not a key left for later.
#
# A startup self-heal was tried twice here and removed both times: first
# a re-check gated on the size actually differing, then an unconditional
# `console reassert` on the first idle tick regardless. Neither fixed a
# real Mac's black-screen-until-resize, and the reason turned out to be
# that `console flush` already re-fits the grid to the real size on
# *every* call (`cn_fit`, inside `cn_flush` itself) -- so this was never
# a stale-size problem for anything here to re-check. The real cause and
# fix are in `cn_open` (mods/console/term.c): some Mac terminal apps do
# not render the alternate screen until they have had a moment to finish
# their own window setup, confirmed with a plain `sleep 1` before
# `console open` fixing it with nothing else different.
#
# A suspected flake was chased into this dead end too ("an app with no
# key handler cannot swallow one", tests/desktop.py): confirmed
# pre-existing and unrelated to any of this, a matched 100-run baseline
# on unmodified code still failed about 4% of the time. See CLAUDE.md.
# A test harness sets HIBR_TESTIDLE to be told, with an escape sequence a
# terminal ignores, each time a frame is on screen and the loop is about to
# wait -- and how many bytes of input have been read by then, so a frame a
# timer asked for is never taken for the one after its key. It can send the
# next key the moment the last one has been drawn, rather than sleeping for
# a time long enough on a slow day.
DT_TESTIDLE=${HIBR_TESTIDLE-}

# What the desktop wants mouse reporting to be, and how many components
# have borrowed it. The mode is the window manager's, not whoever touched
# it last: a saver, a dialog or an app cannot know what it should be when
# they are done, only what it was when they started, and one that is killed
# -- or that simply forgets -- never puts it back at all (Gitea #197). So
# the desktop keeps its own answer and puts it back.
#
# Not DT_MOUSE, which wm/state.hibr already owns for the window the mouse
# is down on: a global declared without grepping the desktop for the name
# first is this file's own recorded trap, and it cost a run of the suite
# here -- every drag broke, because input.hibr's "a window has the mouse"
# test was suddenly true for ever.
DT_MOUSEWANT=off
DT_MOUSEHELD=0

# Set the mode the desktop wants, which is what dt_mousecheck restores to.
fn dt_mouseset(mode) {
	DT_MOUSEWANT=$mode
	console mouse "$mode"
	return 0
}

# Nothing in this process borrows the mode today: About only reads it to say
# what it is, and the saver, standby and the login screen each own the
# console of a process of their own. DT_MOUSEHELD is the seam for the
# component that one day wants its own mode for its own duration -- raise it
# around the borrow, or the check below puts the desktop's answer back
# within a frame. The pair of helpers for that is not written until
# something needs one: an interface with no user is designed from a guess.

# Once a frame, put the mode back when it is not what the desktop asked for
# and nobody is holding it. A read costs 2 us against a frame budget of
# about 700, measured before this was written -- which is what makes the
# backstop affordable, and a backstop is the only version that survives a
# component which never reaches a restore line.
fn dt_mousecheck() {
	local m

	[ "$DT_MOUSEHELD" = 0 ] || return 0
	m := console mouse 2> /dev/null || return 0
	[ "$m" = "$DT_MOUSEWANT" ] && return 0
	console mouse "$DT_MOUSEWANT"
	return 0
}

dt_run() {
	local k rsz=0 last now pk= skipn=0 frames=0 lastdraw=0

	dt_runatstart
	while [ "$DT_QUIT" = 0 ]; do
		if [ -n "$DT_SAVING" ] || [ -n "$DT_LOCKED" ]; then
			# A resize while the saver or the lock is up is still a
			# resize. This branch continued before the check at the
			# foot of the loop ever ran, and dt_saverinput throws a
			# `resize` key away on purpose so neither is dismissed
			# by one -- so nothing recorded that the screen had
			# changed size, and when the lock cleared the desktop
			# carried on drawing for the old one: the bar composed
			# too wide with the clock off the end, the wallpaper
			# sized for the old screen, the Control Strip off the
			# bottom. Which is the ordinary way of it rather than a
			# corner: you detach from one machine, it locks while
			# you are away, and you attach from another with a
			# different screen (Gitea #126). No debounce here --
			# the saver redraws from scratch every pass anyway, and
			# dt_size is idempotent.
			if console resizing; then
				console reassert
				dt_size
			fi
			k := dt_saverdraw
			frames=$((frames + 1))
			if [ -n "$DT_TESTIDLE" ]; then
				now := console consumed
				printf '\e]7777;idle;%s;%s\a' "$((now + DT_INBASE))" "$frames"
			fi
			k := dt_saverkey "$k"
			dt_saverinput "$k"
			continue
		fi
		dt_mousecheck
		if [ "$rsz" = 0 ]; then
			if [ "$DT_LASTMOVE" = 1 ] && console waiting; then
				:
			elif [ "$DT_LASTDRAG" = 1 ] &&
			   [ "$skipn" -lt "$DT_DRAWSKIP" ]; then
				skipn=$((skipn + 1))
			else
				now := dt_ms
				# A wake with no key behind it is a program
				# writing in a window, or a timer: those are
				# held to DT_TERMMS apart, because a frame
				# redraws the whole screen and a program
				# writing in small bursts -- a spinner, a
				# streaming session -- otherwise asks for one
				# per burst. A key or a mouse report always
				# draws at once, so nothing a person does
				# waits for this.
				if [ -z "$k" ] && [ "$frames" -gt 0 ] &&
				   [ "$DT_TERMMS" -gt 0 ] &&
				   [ $((now - lastdraw)) -lt "$DT_TERMMS" ]; then
					dt_drain
					dt_want $((DT_TERMMS - now + lastdraw))
					# Drained, so wait out the rest of the
					# window without listening to them: a
					# program writing a hundred times a
					# second would otherwise wake the
					# desktop a hundred times for a frame
					# it has already decided to hold. Its
					# bytes keep in the pty's own buffer
					# and the next drain takes the lot. A
					# key, a click or a resize still ends
					# the wait at once.
					DT_QWAIT=1
				else
					dt_draw
					dt_autoclose
					skipn=0
					frames=$((frames + 1))
					[ "$frames" = 1 ] && dt_tdone
					lastdraw=$now
				fi
			fi
		fi
		dt_updcheck
		dt_remotepoll
		dt_snapcheck
		dt_tickers
		dt_saverwait
		if [ -n "$DT_TESTIDLE" ]; then
			k := console consumed
			k=$((k + DT_INBASE))
			printf '\e]7777;idle;%s;%s\a' "$k" "$frames"
		fi
		if [ "$rsz" = 1 ]; then
			k := console key 80
		elif [ -n "$DT_QWAIT" ]; then
			k := console key -q "${DT_WANT:-$DT_IDLEMS}"
		else
			k := console key "${DT_WANT:-$DT_IDLEMS}"
		fi
		DT_QWAIT=
		[ -n "$k" ] && pk=$k
		if console resizing; then
			rsz=1
			last := dt_ms
			continue
		fi
		if [ "$rsz" = 1 ]; then
			now := dt_ms
			if [ $((now - last)) -ge "$DT_RSTILL" ]; then
				console reassert
				dt_size
				rsz=0
				k=$pk
			else
				continue
			fi
		fi
		pk=
		[ -n "$k" ] && dt_saverseen && dt_event "$k"
	done
}

dt_quit() { DT_QUIT=1; }
