# wm/names -- names: whether a function is there, a window's title, a file's
# extension, an integration that needs another installable.
#
# Part of the app interface (ADR 0050): interface.hibr sources it, in the
# desktop and in every app's own process, so it acts on nothing the
# desktop alone owns. It only defines functions and sets state.
# interface: shared

strict

# Which of an app's five functions actually exist, asked once.
fn dt_has(name) {
	command -v "$name" > /dev/null
}

# A title that says which app and what it holds: `Mail [Home Email]`,
# `Terminal [bash]`, `Files [~]`. Eight apps built that string themselves
# with the detail interpolated into it -- `dt_retitle "$id" "Mail [$acct]"`
# -- which no catalogue can hold, since the key would carry the person's
# own account name, so every window frame in a translated desktop read
# English (Gitea #202). Here the app's own name is a key it already has
# from its `dt_app` line, the brackets are one key of punctuation, and a
# detail with no words in it is never looked up at all. An empty detail is
# the app's name alone, which is what a browser with no page open wants.
fn dt_wintitle(app, detail = "") {
	local a=$app t

	case $DT_LANG in ?*) a := dt_tr "$app" ;; esac
	if [ -z "$detail" ]; then
		ret "$a"
		return 0
	fi
	# The brackets are punctuation and not a key: 993-lang-ar refuses a
	# translation identical to its English, and rightly -- a frame with
	# no words in it has nothing to translate, where the app's own name
	# above does.
	ret "$a [$detail]"
}

# Open a registered app in a fresh window, where dt_place puts it -- in the
# first free spot, by default. An app may say how big it wants to be at
# the moment it opens with <app>_size, answering "h w" (the terminal's
# depends on a setting); otherwise its dt_app size. An app declared `once`
# has one window at most: launching it again brings that one forward,
# shown if it was hidden.  Anything after the name goes to its _open.
# Whether another installed thing is here, for a caller about to use one
# of its functions -- and when it is not, the same message dt_launch
# gives, so a person learns what to fetch rather than seeing nothing.
#
# An installable may call the platform freely and another installable
# only behind a check like this one, in the same function (Gitea #262):
# that is what keeps every link between two apps an optional integration
# rather than a dependency nothing resolves, and tests/deps.py fails a
# call that has none. `dt_has` is the quiet form, for an integration
# that simply does less when the other side is absent.
fn dt_needs(app, f) {
	dt_has "$f" && return 0
	dt_notep high "%s is not installed. Find it in the Catalogue." "$app"
	return 1
}

# The extension a name is opened by: everything after the last dot, or
# empty for one with none -- "Makefile" and ".bashrc" both have none, since
# a leading dot is the name, not a separator.
fn dt_ext(path) {
	local nm=${path##*/}

	case $nm in
	*.*) ret "${nm##*.}" ;;
	*) ret "" ;;
	esac
}
